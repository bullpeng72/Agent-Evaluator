{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-evaluator.dev/schemas/insights.v1.schema.json",
  "title": "Agent-Evaluator insights v1.0",
  "description": "extra_metrics.insights 출력 계약 (SPEC-041 P9~P20). reporting/insights.py::build_insights()의 반환 dict가 이 스키마를 위반해서는 안 된다. 필드를 추가할 때는 새 키를 optional로 두고 이 파일을 함께 수정한다 — 기존 키를 deprecation 없이 rename/삭제하지 않는다. 모든 object는 additionalProperties:true (전방 호환). nullable 섹션은 해당 신호가 없으면 null이다.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "detection_mode", "verdict", "metric_confidence"],
  "properties": {
    "schema_version": { "type": "string" },
    "detection_mode": { "enum": ["absolute_threshold", "regression_vs_baseline"] },
    "narrative": { "type": "string" },
    "narrative_audit": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "claims_checked": { "type": "boolean" },
        "clean": { "type": "boolean" },
        "adjustments": { "type": "array", "items": { "type": "string" } }
      }
    },
    "briefs": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "pm": { "type": "string" },
        "qa": { "type": "string" },
        "engineer": { "type": "array", "items": { "type": "string" } }
      }
    },

    "verdict": {
      "type": "object",
      "additionalProperties": true,
      "required": ["level", "headline"],
      "properties": {
        "level": { "enum": ["not_ready", "caution", "ready", "unknown"] },
        "headline": { "type": "string" },
        "failing_gates": { "type": "array", "items": { "type": "string" } },
        "warning_gates": { "type": "array", "items": { "type": "string" } },
        "passing_gates": { "type": "array", "items": { "type": "string" } },
        "below_user_target_gates": { "type": "array", "items": { "type": "string" } },
        "targets_source": { "enum": ["user", "builtin"] },
        "targets": { "type": ["object", "null"] },
        "confidence": { "type": ["string", "null"], "enum": ["high", "medium", "low", null] },
        "confidence_reasons": { "type": "array", "items": { "type": "string" } },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "gate": { "type": ["string", "null"] },
              "field": { "type": ["string", "null"] },
              "health": { "type": ["number", "null"] },
              "action": { "type": "string" }
            }
          }
        }
      }
    },

    "readiness": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "target_gate_score": { "type": "number" },
        "targets_source": { "enum": ["user", "builtin"] },
        "per_gate_targets": { "type": ["object", "null"] },
        "current_tcr_pct": { "type": ["number", "null"] },
        "current_accuracy_pct": { "type": ["number", "null"] },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["gate"],
            "properties": {
              "gate": { "type": "string" },
              "gate_name": { "type": "string" },
              "score": { "type": ["number", "null"] },
              "target": { "type": "number" },
              "gap": { "type": ["number", "null"] },
              "blocking": { "type": "boolean" },
              "projected_score_after_plan": { "type": "number" },
              "estimate": { "type": "boolean" }
            }
          }
        },
        "fix_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["rank", "signature", "count"],
            "properties": {
              "rank": { "type": "integer" },
              "signature": { "type": "string" },
              "task_type": { "type": ["string", "null"] },
              "task_types": { "type": "array", "items": { "type": "string" } },
              "count": { "type": "integer" },
              "impact_pct": { "type": "number" },
              "example_task_ids": { "type": "array", "items": { "type": "string" } },
              "effort_hint": { "type": "string" },
              "targets_gates": { "type": "array", "items": { "type": "string" } },
              "projected_tcr_after_pct": { "type": "number" },
              "projected_accuracy_after_pct": { "type": "number" },
              "cumulative_tcr_gain_pp": { "type": "number" },
              "effort_weight": { "type": "number" },
              "projected_gate_scores": { "type": "object" },
              "projected_gate_scores_ci": { "type": "object" },
              "gate_moves": { "type": "object" },
              "roi": { "type": "number" }
            }
          }
        },
        "projected_ready_after": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "ready_after_n_items": { "type": ["integer", "null"] },
            "plan_fixes_projected": { "type": "integer" },
            "projected_gate_scores": { "type": "object" },
            "remaining_structural_blockers": { "type": "array", "items": { "type": "string" } },
            "p_ready": { "type": ["number", "null"] },
            "likely_fix_count": { "type": ["integer", "null"] },
            "note": { "type": "string" }
          }
        }
      }
    },

    "insight_changes": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "new_clusters": { "type": "array", "items": { "type": "string" } },
        "resolved_clusters": { "type": "array", "items": { "type": "string" } },
        "trust_change": { "type": ["object", "null"] },
        "new_security_findings": { "type": "array" },
        "verdict_change": { "type": ["object", "null"] },
        "newly_failing_gates": { "type": "array", "items": { "type": "string" } },
        "newly_passing_gates": { "type": "array", "items": { "type": "string" } }
      }
    },

    "freshness": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "baseline_age_days": { "type": ["integer", "null"] },
        "eval_set_identical_to_baseline": { "type": ["boolean", "null"] },
        "n_tasks": { "type": "integer" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },

    "threshold_sensitivity": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "current_line": { "type": "number" },
        "swept_verdict_at_current_line": { "type": "string" },
        "knife_edge": { "type": "boolean" },
        "knife_edge_detail": { "type": "string" },
        "gate_line_sweep": { "type": "array" },
        "accuracy_threshold_sweep": { "type": "array" },
        "n_gates_measured": { "type": "integer" },
        "n_tasks_with_accuracy": { "type": "integer" }
      }
    },

    "metric_confidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["n_tasks"],
      "properties": {
        "n_tasks": { "type": "integer", "minimum": 0 },
        "tcr_pct": { "type": "number" },
        "accuracy_pct": { "type": "number" },
        "tcr_ci_pct": { "$ref": "#/$defs/pair" },
        "accuracy_ci_pct": { "$ref": "#/$defs/pair" },
        "tcr_ci_halfwidth": { "type": "number" }
      }
    },

    "metric_signal": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "metrics_analysed": { "type": "array", "items": { "type": "string" } },
        "n_tasks": { "type": "integer" },
        "correlations": { "type": "array" },
        "redundant_pairs": { "type": "array" },
        "outcome_correlation": { "type": ["array", "null"] },
        "note": { "type": "string" }
      }
    },

    "evaluator_trust": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "trust_level": { "enum": ["high", "medium", "low"] },
        "trust_reasons": { "type": "array", "items": { "type": "string" } },
        "judge_vs_heuristic": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "properties": {
            "n_comparable": { "type": "integer" },
            "agreement_rate": { "type": "number" },
            "mean_abs_diff": { "type": "number" },
            "disagreements": { "type": "array" }
          }
        },
        "judge_calibration": { "type": ["object", "null"] },
        "judge_self_consistency": { "type": ["object", "null"] }
      }
    },

    "review_queue": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "n_items": { "type": "integer", "minimum": 0 },
        "by_priority": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "high": { "type": "integer" },
            "medium": { "type": "integer" },
            "low": { "type": "integer" }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["task_id", "priority", "reasons"],
            "properties": {
              "task_id": { "type": "string" },
              "priority": { "enum": ["high", "medium", "low"] },
              "reasons": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },

    "gate_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "gate": { "type": "string" },
          "score": { "type": ["number", "null"] },
          "baseline_score": { "type": ["number", "null"] },
          "component_shortfalls": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "field": { "type": "string" },
                "value": { "type": ["number", "null"] },
                "health": { "type": ["number", "null"] },
                "guidance": { "type": "string" },
                "config_hint": { "type": ["object", "null"] }
              }
            }
          },
          "top_detail_deltas": { "type": "array" }
        }
      }
    },

    "failure_clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "signature": { "type": "string" },
          "task_type": { "type": "string" },
          "count": { "type": "integer" },
          "impact_pct": { "type": "number" },
          "example_task_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "failure_segments": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["label", "task_ids", "n"],
        "properties": {
          "label": { "type": "string" },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "task_ids": { "type": "array", "items": { "type": "string" } },
          "n": { "type": "integer" },
          "share_of_failures_pct": { "type": "number" },
          "impact_pct": { "type": "number" },
          "dominant_reason": { "type": "string" },
          "example_question": { "type": "string" },
          "catch_all": { "type": "boolean" }
        }
      }
    },

    "failure_explanations": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["task_id", "claims"],
        "properties": {
          "task_id": { "type": "string" },
          "question": { "type": "string" },
          "ground_truth": { "type": "string" },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "text": { "type": "string" },
                "verdict": { "type": "string" },
                "source": { "type": "string" }
              }
            }
          },
          "wrong_claim": { "type": ["string", "null"] },
          "wrong_claim_verdict": { "type": ["string", "null"] },
          "wrong_claim_source": { "type": ["string", "null"] },
          "explained_by": { "enum": ["template", "explainer"] }
        }
      }
    },

    "failure_triggers": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["task_id", "kind"],
        "properties": {
          "task_id": { "type": "string" },
          "kind": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },

    "failure_lineage": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "regressed": { "type": "array", "items": { "type": "string" } },
        "persistent": { "type": "array", "items": { "type": "string" } },
        "new": { "type": "array", "items": { "type": "string" } },
        "fixed": { "type": "array", "items": { "type": "string" } }
      }
    },

    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "gate": { "type": "string" },
          "status": { "enum": ["fail", "warn"] },
          "label": { "type": "string" },
          "guidance": { "type": "string" },
          "shortfalls": { "type": "array" },
          "code_snippet": { "type": ["string", "null"] },
          "experiment": { "type": ["object", "null"] },
          "past_outcomes": { "type": ["object", "null"] },
          "baseline_verdict": { "type": ["object", "null"] },
          "proposal": {
            "type": ["object", "null"],
            "additionalProperties": true,
            "properties": {
              "kind": { "enum": ["prompt_edit", "config_change", "data_fix"] },
              "before": { "type": "string" },
              "after": { "type": "string" },
              "rationale": { "type": "string" },
              "evidence_task_ids": { "type": "array", "items": { "type": "string" } },
              "authored_by": { "enum": ["template", "fixer"] }
            }
          }
        }
      }
    },

    "latency_budget": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "n_tasks": { "type": "integer" },
        "tool_ms": { "type": "number" },
        "model_ms": { "type": "number" },
        "network_ms": { "type": "number" },
        "unattributed_ms": { "type": "number" },
        "bottleneck": { "type": "string" },
        "bottleneck_share": { "type": "number" }
      }
    },

    "rag_localization": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "n_rag_tasks": { "type": "integer" },
        "n_borderline": { "type": "integer" },
        "borderline_task_ids": { "type": "array", "items": { "type": "string" } },
        "by_class": { "type": "object", "additionalProperties": { "type": "integer" } },
        "dominant_failure": { "type": ["string", "null"] },
        "remediation_by_class": { "type": "object", "additionalProperties": { "type": "string" } },
        "unsupported_claim_examples": { "type": "array" }
      }
    },

    "slice_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["task_type", "n"],
        "properties": {
          "task_type": { "type": "string" },
          "n": { "type": "integer" },
          "tcr_pct": { "type": "number" },
          "tcr_ci_pct": { "$ref": "#/$defs/pair" },
          "accuracy_pct": { "type": "number" },
          "baseline_tcr_pct": { "type": "number" },
          "tcr_delta_pp": { "type": "number" },
          "tcr_delta_ci_pp": { "$ref": "#/$defs/pair" },
          "significant": { "type": "boolean" }
        }
      }
    },

    "metadata_slices": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["dimension", "slices"],
        "properties": {
          "dimension": { "type": "string" },
          "slices": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["value", "n"],
              "properties": {
                "value": { "type": "string" },
                "n": { "type": "integer" },
                "tcr_pct": { "type": "number" },
                "tcr_ci_pct": { "$ref": "#/$defs/pair" },
                "accuracy_pct": { "type": "number" },
                "baseline_tcr_pct": { "type": "number" },
                "tcr_delta_pp": { "type": "number" },
                "tcr_delta_ci_pp": { "$ref": "#/$defs/pair" },
                "significant": { "type": "boolean" }
              }
            }
          }
        }
      }
    },

    "sample_guidance": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "n_tasks": { "type": "integer" },
        "tcr_ci_halfwidth_pp": { "type": "number" },
        "target_halfwidth_pp": { "type": "number" },
        "recommended_n": { "type": "integer" },
        "additional_tasks": { "type": "integer" },
        "message": { "type": "string" }
      }
    },

    "reproducibility_manifest": {
      "type": ["object", "null"],
      "additionalProperties": true
    },

    "cost_economics": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "total_cost_usd": { "type": "number" },
        "cost_source": { "enum": ["per_task_tokens", "aggregate_uniform_split"] },
        "n_tasks": { "type": "integer" },
        "n_successful": { "type": "integer" },
        "cost_per_task_usd": { "type": "number" },
        "cost_per_successful_task_usd": { "type": ["number", "null"] },
        "wasted_cost_usd": { "type": "number" },
        "wasted_cost_pct": { "type": "number" },
        "retry_cost_usd": { "type": "number" },
        "retry_cost_pct": { "type": "number" },
        "projection": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "calls": { "type": "integer" },
            "total_usd": { "type": "number" },
            "wasted_usd": { "type": "number" }
          }
        }
      }
    },

    "security_findings": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["task_id", "tracker", "threat_type", "severity"],
        "properties": {
          "task_id": { "type": "string" },
          "tracker": { "type": "string" },
          "threat_type": { "type": "string" },
          "severity": { "type": "string" },
          "cwe": { "type": ["string", "array", "null"] },
          "detail": { "type": "string" },
          "succeeded": { "enum": ["yes", "likely", "no", "unknown"] },
          "kind": { "type": "string" },
          "components": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "score_breakdowns": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["task_id"],
        "properties": {
          "task_id": { "type": "string" },
          "task_type": { "type": "string" },
          "accuracy": { "type": ["number", "null"] },
          "completion": { "type": ["number", "null"] },
          "accuracy_components": { "type": "object" },
          "accuracy_weakest": { "type": ["string", "null"] },
          "accuracy_note": { "type": "string" },
          "judge_overall": { "type": ["number", "null"] },
          "judge_reasoning": { "type": ["string", "null"] },
          "judge_dimensions": { "type": "object" },
          "weakest_signal": { "type": ["string", "null"] }
        }
      }
    },

    "trajectories": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["task_id"],
        "properties": {
          "task_id": { "type": "string" },
          "source": { "type": "string" },
          "n_spans": { "type": "integer" },
          "total_ms": { "type": "number" },
          "critical_path": { "type": "array", "items": { "type": "string" } },
          "bottleneck": { "type": ["object", "null"] },
          "total_cost_usd": { "type": ["number", "null"] },
          "total_tokens": { "type": ["integer", "null"] }
        }
      }
    },

    "experiments": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["hypothesis", "verdict"],
        "properties": {
          "experiment_id": { "type": ["string", "null"] },
          "hypothesis": { "type": "string" },
          "target_gate": { "type": ["string", "null"] },
          "target_field": { "type": ["string", "null"] },
          "predicted": { "type": ["number", "null"] },
          "actual": { "type": ["number", "null"] },
          "verdict": { "type": "string" },
          "status": { "type": "string" },
          "note": { "type": ["string", "null"] }
        }
      }
    },

    "trace_diffs": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["task_id", "verdict"],
        "properties": {
          "task_id": { "type": "string" },
          "question": { "type": "string" },
          "compared": { "type": "array", "items": { "type": "string" } },
          "verdict": { "type": "string" },
          "score_delta": { "type": "object" },
          "response_diff": { "type": "object" },
          "trajectory_diff": { "type": "object" },
          "per_version": { "type": "array" }
        }
      }
    },

    "nondeterminism": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["task_id", "reproducibility_score", "run_count"],
        "properties": {
          "task_id": { "type": "string" },
          "reproducibility_score": { "type": "number" },
          "run_count": { "type": "integer" },
          "variance": { "type": "number" },
          "sample_responses": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "conversation": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "n_sessions": { "type": "integer" },
        "avg_overall_score": { "type": ["number", "null"] },
        "avg_context_retention": { "type": ["number", "null"] },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "session_id": { "type": ["string", "null"] },
              "turns": { "type": "integer" },
              "overall_score": { "type": ["number", "null"] },
              "context_retention": { "type": ["number", "null"] },
              "topic_coherence": { "type": ["number", "null"] },
