  document.getElementById('gF-native-bars').innerHTML = buildBars([
    ['협력 성공률',   coordSR, '#8b5cf6'],
    ['워크플로우 SR', wfSR,    '#22d3ee'],
    ['재시도 성공',   retrySR, '#facc15'],
    ['Tool F1',       ag.tool_selection_summary?.avg_f1_score||0, '#4ade80'],
  ]);

  document.getElementById('gF-harness').innerHTML = harnessGroupHtml('F', hg);

  document.getElementById('gF-bottom').innerHTML =
    `<strong>Gate F:</strong> 협력 성공 ${fmtPct(coordSR)} · 워크플로우 ${fmtPct(wfSR)} · 재시도 성공 ${fmtPct(retrySR)}`;
}

/* ── Gate G ── */
function renderGateG(d, qual) {
  const hg    = d.harness_groups || {};
  const judge = d.llm_judge || {};
  const ns    = deriveNativeGateScores(d);
  const gScore = hg['G']?.score ?? hg['G']?.overall_score ?? ns.G;
  updateGatePill('gG-pill', gScore);
  const qualAvg  = qual.avg_score;
  const judgeAvg = judge.avg_overall;
  const faithful = judge.avg_faithfulness;

  setKpi('gG-score', gScore != null ? Math.round(gScore) + '%' : '—',
    gScore >= 80 ? 'c-green' : gScore >= 60 ? 'c-yellow' : 'c-red');
  setKpi('gG-qual-avg', qualAvg != null ? qualAvg.toFixed(2) : '—',
    qualAvg >= 4 ? 'c-green' : qualAvg >= 3 ? 'c-yellow' : 'c-red');
  set('gG-judge',  judgeAvg  != null ? judgeAvg.toFixed(2)  + ' / 5' : '—');
  set('gG-faith',  faithful  != null ? faithful.toFixed(2)  + ' / 5' : '—');

  // Quality dims
  const dims = [
    ['정확성 (Accuracy)',     qual.accuracy_score],
    ['완결성 (Completeness)', qual.completeness_score],
    ['명확성 (Clarity)',      qual.clarity_score],
    ['관련성 (Relevance)',    qual.relevance_score],
    ['창의성 (Creativity)',   qual.creativity_score],
  ];
  const hasQual = dims.some(([,v]) => v != null && v > 0);
  if (hasQual) {
    document.getElementById('gG-quality-dims').innerHTML = dims.map(([lbl,v]) => {
      const pct = v != null ? Math.round(v/5*100) : 0;
      const col = pct>=70?'#4ade80':pct>=50?'#06b6d4':'#f87171';
      return `<div class="qdim-row">
        <div class="qdim-lbl">${lbl.split(' ')[0]}</div>
        <div class="qdim-track"><div class="qdim-fill" style="width:${pct}%;background:${col}"></div></div>
        <div class="qdim-val">${v!=null?v.toFixed(1):'—'}</div>
      </div>`;
    }).join('');
    document.getElementById('gG-quality-gauge-wrap').style.display = '';
    document.getElementById('gG-quality-gauge-fill').style.width = `${Math.round((qualAvg||0)/5*100)}%`;
    document.getElementById('gG-quality-avg-val').textContent = `${(qualAvg||0).toFixed(2)} / 5.0`;
    document.getElementById('gG-quality-nodata').style.display = 'none';
  } else {
    document.getElementById('gG-quality-nodata').style.display = 'flex';
    document.getElementById('gG-quality-gauge-wrap').style.display = 'none';
  }

  document.getElementById('gG-harness').innerHTML = harnessGroupHtml('G', hg);

  document.getElementById('gG-bottom').innerHTML =
    `<strong>Gate G:</strong> 품질 평균 ${qualAvg != null ? qualAvg.toFixed(2)+'/5.0' : '—'}` +
    (judgeAvg != null ? ` · LLM Judge ${judgeAvg.toFixed(2)}/5` : '') +
    (faithful != null ? ` · Faithfulness ${faithful.toFixed(2)}/5` : '');
}

/* ═══════════════════════════════════════════════════
   HELPER BUILDERS
═══════════════════════════════════════════════════ */
function buildFindings(tcr_v, acc_v, hall_v, p95_v, halluHas, lat, tok, tasks, data){
  const items = [];

  if (tcr_v < 90) {
    items.push({ ok:false, title:`Gate A — TCR ${fmtPct(tcr_v)} (목표 90% 미달)`,
      detail:`${tcr_v>=70?'부분적':'전체적'} 개선 필요. Gate A 실패 태스크 패턴 분석이 우선과제입니다.`,
      badge:tcr_v>=70?'⚠️ 개선필요':'❌ 긴급개선', badgeCls:tcr_v>=70?'#facc15':'#f87171' });
  } else {
    items.push({ ok:true, title:`Gate A — TCR ${fmtPct(tcr_v)} (목표 달성)`,
      detail:`태스크 완료율이 우수합니다. 부분성공 태스크의 완전성공 전환이 다음 목표입니다.`,
      badge:'✅ PASS', badgeCls:'#4ade80' });
  }

  if (p95_v > 2 && p95_v > 0) {
    items.push({ ok:false, title:`Gate D — P95 ${fmtSec(p95_v)} (SLA 2s 초과)`,
      detail:`Gate D 성능 계약 위반. 캐싱·모델 경량화·청크 조정을 검토하세요.`,
      badge:'⚠️ SLA 위반', badgeCls:'#f87171' });
  } else if (halluHas && hall_v > 5) {
    items.push({ ok:false, title:`Gate C — 환각 ${fmtPct(hall_v)} (기준 5% 초과)`,
      detail:`Gate C 신뢰성 저하. RAG 검증 파이프라인 도입을 검토하세요.`,
      badge:'⚠️ WARN', badgeCls:'#facc15' });
  } else {
    items.push({ ok:true, title:`Gate D — P95 ${fmtSec(p95_v)} (SLA 달성)`,
      detail:`P95 지연이 목표 이내입니다. 현재 성능을 유지하면서 비용 최적화를 검토하세요.`,
      badge:'✅ PASS', badgeCls:'#4ade80' });
  }

  if (acc_v < 70) {
    items.push({ ok:false, title:`Gate A — 정확도 ${fmtPct(acc_v)} (목표 70% 미달)`,
      detail:`Gate A 목표 달성 저하. Golden Dataset 품질 점검 및 프롬프트 개선이 필요합니다.`,
      badge:'⚠️ 개선필요', badgeCls:'#facc15' });
  } else {
    items.push({ ok:true, title:`Gate A — 정확도 ${fmtPct(acc_v)} (목표 달성)`,
      detail:`정확도 수준이 양호합니다. 중앙값과 분포 확인으로 일관성을 검증하세요.`,
      badge:'✅ PASS', badgeCls:'#4ade80' });
  }

  const passCount = items.filter(i=>i.ok).length;
  const verdictCls = passCount===3?'vb-pass':passCount>=1?'vb-cond':'vb-fail';
  const verdictIcon = passCount===3?'🏆':passCount>=1?'⚠️':'❌';
  const verdictColor = passCount===3?'#4ade80':passCount>=1?'#facc15':'#f87171';
  const verdictLabel = passCount===3?'PASS — 핵심 Gate 달성':passCount>=1?'CONDITIONAL — 일부 Gate 미달':'FAIL — 핵심 Gate 미달성';
  const verdictSub = `${passCount}/3개 핵심 Gate 달성 · ${items.filter(i=>!i.ok).map(i=>i.title.split('—')[0].trim()).join(', ')||'없음'} 개선 필요`;

  const cards = items.map((item, i) =>
    `<div class="finding-card">
       <div class="finding-num" style="background:${item.ok?'rgba(74,222,128,.15)':'rgba(248,113,113,.15)'};color:${item.ok?'#4ade80':'#f87171'}">${i+1}</div>
       <div class="finding-body">
         <div class="finding-title">
           ${item.title}
           <span class="finding-badge" style="background:${item.badgeCls}22;color:${item.badgeCls}">${item.badge}</span>
         </div>
         <div class="finding-detail">${item.detail}</div>
       </div>
     </div>`).join('');

  return { cards, verdictCls, verdictIcon, verdictColor, verdictLabel, verdictSub };
}

function buildActionPlan(tcr_v, acc_v, hall_v, p95_v, halluHas, costPerTask, data){
  const actions = [];
  if (tcr_v < 90)
    actions.push({ p:'P1', icon:'🔧', title:'Gate A — TCR 향상 (현재 '+fmtPct(tcr_v)+'→목표 90%)',
      steps:['실패 태스크 에러 로그 분석 (Gate A 슬라이드 참조)', '실패 집중 Task Type 프롬프트 개선', '부분성공 태스크 재실행 조건 완화'],
      impact:'TCR +5~10%p 예상', file:'01_layer1_all_metrics.py' });
  if (acc_v < 70)
    actions.push({ p:'P1', icon:'📚', title:'Gate A — 정확도 개선 (현재 '+fmtPct(acc_v)+'→목표 70%)',
      steps:['타입별 정확도 격차 분석 (Gate A 슬라이드 참조)', '낮은 타입 대상 Few-shot 예시 추가', 'Golden Dataset 품질 검수 및 확장'],
      impact:'Accuracy +5~15%p 예상', file:'06_operational.py' });
  if (halluHas && hall_v > 5)
    actions.push({ p:'P1', icon:'🧠', title:'Gate C — 환각 억제 (현재 '+fmtPct(hall_v)+'→목표 5%↓)',
      steps:['환각 다발 유형 집중 분석', 'RAG 기반 Fact 검증 레이어 도입', '응답 생성 온도(temperature) 조정'],
      impact:'Hallucination -3~8%p 예상', file:'01_layer1_all_metrics.py' });
  if (p95_v > 2)
    actions.push({ p:'P2', icon:'⚡', title:'Gate D — 응답속도 최적화 (P95 '+fmtSec(p95_v)+'→목표 2s↓)',
      steps:['느린 Task Type 식별 (Gate D 슬라이드 참조)', '결과 캐싱 / 병렬 처리 도입', '경량 모델 또는 청크 크기 조정 검토'],
      impact:'P95 -30~50% 예상', file:'01_layer1_all_metrics.py' });
  if (costPerTask > 0.05)
    actions.push({ p:'P2', icon:'💰', title:'Gate D — 비용 최적화 (Task당 '+fmtCost(costPerTask)+')',
      steps:['불필요한 Output 토큰 단축 (프롬프트 간결화)', 'AdaptivePolicy 샘플링 도입 (06_operational.py)', '고비용 타입 식별 및 모델 티어 분리'],
      impact:'비용 20~40% 절감 예상', file:'06_operational.py' });
  if (actions.length === 0)
    actions.push({ p:'P3', icon:'✅', title:'모든 Gate 달성 — 지속 모니터링',
      steps:['실시간 대시보드 모니터링 유지 (--watch 모드)', 'Golden Dataset 주기적 확장', 'Anomaly Detection 임계값 점검'],
      impact:'현재 품질 유지', file:'agent-eval dashboard --watch' });
  actions.push({ p:'P3', icon:'📊', title:'Gate 기반 CI/CD 파이프라인 구축',
    steps:['agent-eval gate 품질 게이팅 도입 (모든 Gate 기준)', 'GoldenSetBuilder 자동 케이스 추출 주간 실행', 'Harness Config 전 Gate 활성화 (08_harness_eval.py)'],
    impact:'Gate 회귀 사전 방지', file:'agent-eval gate result.json --tcr 85' });

  return `<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;flex:1;align-content:start">
    ${actions.slice(0,4).map(a =>
