{% if offline %}<script src="/static/reveal.js"></script>{% else %}<script src="https://cdn.jsdelivr.net/npm/reveal.js@5.1.0/dist/reveal.js"></script>{% endif %}
<script>
/* ── Theme ── */
{% if offline %}
const DARK_THEME='/static/reveal-night.css', LIGHT_THEME='/static/reveal-white.css';
{% else %}
const DARK_THEME='https://cdn.jsdelivr.net/npm/reveal.js@5.1.0/dist/theme/night.css';
const LIGHT_THEME='https://cdn.jsdelivr.net/npm/reveal.js@5.1.0/dist/theme/white.css';
{% endif %}
function applyTheme(light){
  document.getElementById('reveal-theme').href = light ? LIGHT_THEME : DARK_THEME;
  document.body.classList.toggle('light', light);
  document.getElementById('theme-toggle').textContent = light ? '🌙' : '☀️';
  localStorage.setItem('sl-theme', light ? 'light' : 'dark');
  if (window._slideData) renderCharts(window._slideData);
}
function toggleTheme(){ applyTheme(!document.body.classList.contains('light')); }
(function(){
  const s = localStorage.getItem('sl-theme'), d = localStorage.getItem('ae-dark');
  if ((s ? s==='light' : d==='false')) applyTheme(true);
})();

/* ── Init: Reveal.on MUST be registered before Reveal.initialize ── */
Reveal.on('ready', function(){
  initFileSelect();
  const qrUrl = window.location.origin + '/dashboard';
  const qrEl  = document.getElementById('sl-qr');
  const qrLbl = document.getElementById('sl-qr-url');
  if (qrEl && window.QRCode) {
    QRCode.toCanvas(qrEl, qrUrl, { width:96, margin:1, color:{ dark:'#000', light:'#fff' } });
    if (qrLbl) qrLbl.textContent = qrUrl;
  }
});

Reveal.initialize({
  hash:true, center:false, slideNumber:'c/t',
  transition:'fade', transitionSpeed:'fast',
  width:1280, height:720, margin:0, plugins:[],
});

/* ── File switcher ── */
let _allFiles = [];
async function initFileSelect(){
  try { const _r = await (await fetch('/api/results')).json(); _allFiles = Array.isArray(_r) ? _r : (_r.files||[]); } catch(e){ return; }
  if (!_allFiles?.length) return;
  const sel = document.getElementById('file-select');
  sel.innerHTML = _allFiles.map(f =>
    `<option value="${f.id}">${f.name||f.id} (${(f.timestamp||'').substring(0,10)})</option>`
  ).join('');
  const pid = new URLSearchParams(window.location.search).get('id');
  const tid = (pid && _allFiles.some(f=>f.id===pid)) ? pid : _allFiles[0].id;
  sel.value = tid;
  loadFile(tid);
}
function switchFile(id){
  if (!id) return;
  const u = new URL(window.location);
  u.searchParams.set('id', id);
  window.history.replaceState({}, '', u);
  loadFile(id);
}
async function loadFile(id){
  let data;
  try { data = await (await fetch(`/api/results/${id}`)).json(); } catch(e){ return; }
  window._slideData = data;
  populateSlides(data);
  renderCharts(data);
}

/* ═══════════════════════════════════════════════════
   POPULATE SLIDES
═══════════════════════════════════════════════════ */
function populateSlides(data){
  try { _populateSlides(data); } catch(e){ console.error('[slides] populateSlides error:', e); }
}
function _populateSlides(data){
  const tcr   = data.accuracy_metrics?.tcr || {};
  const acc   = data.accuracy_metrics?.accuracy_scores || {};
  const hallu = data.accuracy_metrics?.hallucination || {};
  const lat   = data.efficiency_metrics?.latency || {};
  const tok   = data.efficiency_metrics?.tokens || {};
  const qual  = data.quality_detail || {};
  const tasks = data.tasks || [];

  const tcr_v  = tcr.tcr || 0;
  const acc_v  = acc.overall_accuracy || 0;
  const hall_v = hallu.overall_rate || 0;
  const p95_v  = lat.p95 || 0;
  const halluHas = (hallu.total_evaluated||0) > 0;

  // ── per-task-type stats ──────────────────────────────────────────────────────
  const typeStats = {};
  tasks.forEach(t => {
    const tp = t.task_type || 'unknown';
    if (!typeStats[tp]) typeStats[tp] = { n:0, ok:0, acc:[], lat:[], errors:[] };
    typeStats[tp].n++;
    if (t.success) typeStats[tp].ok++;
    typeStats[tp].acc.push((t.accuracy_score||0)*100);
    typeStats[tp].lat.push(t.execution_time||0);
    if (Array.isArray(t.errors)) typeStats[tp].errors.push(...t.errors);
    else if (t.errors) typeStats[tp].errors.push(t.errors);
  });

  const { l1sc, perfSc, secSc, agSc } = calcHealthParts(tcr, acc, hallu, lat, data);
  const health = calcHealth(tcr, acc, hallu, lat, data);

  /* ── Slide 1: Title ── */
  document.getElementById('slide-title').textContent = data.name || '';
  document.getElementById('slide-meta').textContent =
    `${(data.timestamp||'').substring(0,10)} · ${data.total_tasks||0} tasks`;

  /* ── Slide 3: 평가 개요 ── */
  const typeKeys = Object.keys(typeStats);
  set('ov-tasks', data.total_tasks||0);
  set('ov-types', typeKeys.length);
  set('ov-avgtime', fmtSec(lat.mean));
  set('ov-tokens', ((tok.total_tokens||0) > 0) ? (tok.total_tokens).toLocaleString() : '—');

  const layerFlags = [
    ['Layer 1 기초', true, '#6c8ef5'],
    ['Layer 2 에이전틱', !!data.has_agentic, '#22d3ee'],
    ['보안 (L1/L2)', !!data.has_security, '#f87171'],
    ['RAG / 하이브리드', !!data.has_rag || !!data.has_advanced, '#34d399'],
    ['환각 감지', halluHas, '#facc15'],
    ['응답품질', Object.values(qual).some(v=>v>0), '#a78bfa'],
  ];
  document.getElementById('ov-layers').innerHTML = layerFlags.map(([lbl, on, c]) =>
    `<div style="display:flex;align-items:center;gap:8px;margin-bottom:5px">
       <div style="width:8px;height:8px;border-radius:50%;background:${on?c:'var(--bar-bg)'}"></div>
       <span style="font-size:12px;color:${on?'var(--tc)':'var(--tc2)'}${on?'':';opacity:.5'}">${lbl}${on?'':' — 비활성'}</span>
     </div>`
  ).join('');

  /* ── Slide 4: Harness Scorecard ── */
  renderHarnessScorecard(data);

  /* ── Slide 5-11: Gate slides ── */
  renderGateA(data, typeStats, tcr_v, acc_v);
  renderGateB(data);
  renderGateC(data, halluHas, hall_v);
  renderGateD(data, lat, tok, p95_v);
  renderGateE(data);
  renderGateF(data);
  renderGateG(data, qual);

  /* ── Slide 12: Key Findings ── */
  const costPerTask = tok.avg_cost_per_task || ((data.total_tasks||1) ? (tok.total_cost||0)/(data.total_tasks||1) : 0);
  const findings = buildFindings(tcr_v, acc_v, hall_v, p95_v, halluHas, lat, tok, tasks, data);
  document.getElementById('kf-cards').innerHTML = findings.cards;
  document.getElementById('kf-verdict').className = 'verdict-banner ' + findings.verdictCls;
  document.getElementById('kf-verdict').innerHTML =
    `<div class="vb-icon">${findings.verdictIcon}</div>
     <div>
       <div class="vb-label" style="color:${findings.verdictColor}">${findings.verdictLabel}</div>
       <div class="vb-sub">${findings.verdictSub}</div>
     </div>`;

  /* ── Slide 13: Action Plan ── */
  const actions = buildActionPlan(tcr_v, acc_v, hall_v, p95_v, halluHas, costPerTask, data);
  document.getElementById('ap-content').innerHTML = actions;
}

/* ═══════════════════════════════════════════════════
   HARNESS SCORECARD
═══════════════════════════════════════════════════ */
function renderHarnessScorecard(d) {
  const hg = d.harness_groups || {};
  const gates = ['A','B','C','D','E','F','G'];
  const names = {A:'목표 달성',B:'행동 무결성',C:'신뢰성',D:'성능 계약',
                 E:'보안 경계',F:'멀티에이전트',G:'관측가능성'};
  const colors = {A:'#10b981',B:'#3b82f6',C:'#f59e0b',D:'#0ea5e9',
                  E:'#ef4444',F:'#8b5cf6',G:'#06b6d4'};

  // Derive scores for gates without harness data from native metrics
  const nativeScores = deriveNativeGateScores(d);
  const hasAnyHarness = Object.keys(hg).length > 0;

  let passC = 0, warnC = 0, failC = 0, activeC = 0;
  const gateResults = {};

  gates.forEach(gk => {
    const hgData = hg[gk];
    let score = null, status = 'na';

    if (hgData) {
      score = hgData.score ?? hgData.overall_score ?? null;
      status = hgData.status || gateStatus(score);
      activeC++;
      if (status === 'pass') passC++;
      else if (status === 'warn') warnC++;
      else if (status === 'fail') failC++;
    } else if (nativeScores[gk] != null) {
      score = nativeScores[gk];
      status = gateStatus(score);
      activeC++;
      if (status === 'pass') passC++;
      else if (status === 'warn') warnC++;
      else if (status === 'fail') failC++;
    }
    gateResults[gk] = { score, status };
  });

  // Gate card grid
  document.getElementById('hs-gate-grid').innerHTML = gates.map(gk => {
    const { score, status } = gateResults[gk];
    const c = colors[gk];
    const scoreStr = score != null ? Math.round(score) + '%' : 'N/A';
    const statusIcon = status === 'pass' ? '✅' : status === 'warn' ? '⚠️' : status === 'fail' ? '❌' : '—';
    const alpha = status === 'na' ? '0.08' : '0.13';
    return `<div class="gate-card" style="background:${c}${status==='na'?'11':'1a'};border-color:${c}${status==='na'?'33':'55'}">
      <div class="gate-letter" style="color:${c}">${gk}</div>
      <div class="gate-score" style="color:${status==='na'?'var(--tc2)':c}">${scoreStr}</div>
      <div style="font-size:16px">${statusIcon}</div>
      <div class="gate-name">${names[gk]}</div>
    </div>`;
  }).join('');

  // Overall gauge
  const overallScore = activeC > 0
    ? Math.round(gates.reduce((s, gk) => s + (gateResults[gk].score ?? 0), 0) / activeC)
    : 0;
  const gaugeColor = overallScore >= 80 ? '#10b981' : overallScore >= 60 ? '#f59e0b' : '#ef4444';
  document.getElementById('hs-overall-gauge-fill').style.width = overallScore + '%';
  document.getElementById('hs-overall-gauge-fill').style.background = gaugeColor;
  document.getElementById('hs-overall-val').textContent = overallScore + '%';
  document.getElementById('hs-overall-val').style.color = gaugeColor;

  set('hs-active', activeC);
  setKpi('hs-pass', passC, 'c-green');
  setKpi('hs-warn', warnC, 'c-yellow');
  setKpi('hs-fail', failC, 'c-red');

  // Harness notice
  document.getElementById('hs-harness-notice').style.display = hasAnyHarness ? 'none' : '';

  const worstGate = gates.filter(gk => gateResults[gk].status === 'fail')[0];
  document.getElementById('hs-bottom').innerHTML =
    `<strong>Bottom Line:</strong> ${activeC}개 Gate 평가 · PASS ${passC} / WARN ${warnC} / FAIL ${failC}` +
    (worstGate ? ` · 가장 낮은 Gate: <strong>${worstGate}(${names[worstGate]})</strong>` : ' · 모든 Gate 양호');
}

/* ── Native score derivation for gates without Harness Config ── */
function deriveNativeGateScores(d) {
  const tcr   = d.accuracy_metrics?.tcr || {};
  const acc   = d.accuracy_metrics?.accuracy_scores || {};
  const hallu = d.accuracy_metrics?.hallucination || {};
  const lat   = d.efficiency_metrics?.latency || {};
  const tok   = d.efficiency_metrics?.tokens || {};
  const qual  = d.quality_detail || {};
  const ag    = d.agentic || {};
  const sl1   = d.security_l1 || {};
  const sl2   = d.security_l2 || {};

  const tcr_v = tcr.tcr || 0;
  const acc_v = acc.overall_accuracy || 0;
  const p95_v = lat.p95;

  // Gate A: avg of TCR + accuracy
  const gA = (tcr_v + acc_v) / 2;

  // Gate B: tool + workflow (agentic only)
  const toolF1  = ag.tool_selection_summary?.avg_f1_score;
  const wfSR    = ag.workflow_summary?.step_success_rate;
  const gBVals  = [toolF1, wfSR].filter(v => v != null && v >= 0);
  const gB      = d.has_agentic && gBVals.length ? gBVals.reduce((a,b)=>a+b,0)/gBVals.length : null;

  // Gate C: retry success + (1 - hallucination penalty)
  const retrySR = ag.retry_summary?.eventual_success_rate;
  const halluRate = hallu.overall_rate || 0;
  const halluPenalty = (hallu.total_evaluated||0) > 0 ? Math.max(0, 100 - halluRate * 5) : null;
  const gCVals = [retrySR, halluPenalty].filter(v => v != null);
  const gC     = gCVals.length ? gCVals.reduce((a,b)=>a+b,0)/gCVals.length : Math.max(0, 100 - halluRate * 5);

  // Gate D: latency score + cost score
  const latScore = (p95_v == null || (p95_v === 0 && !(d.total_tasks))) ? null
    : p95_v === 0 ? 100 : Math.max(5, Math.round(100 * Math.exp(-0.2 * p95_v)));
  const costPerTask = tok.avg_cost_per_task || 0;
  const costScore = costPerTask <= 0 ? null
    : costPerTask < 0.001 ? 100 : costPerTask < 0.005 ? 85 : costPerTask < 0.02 ? 70 : costPerTask < 0.05 ? 55 : 35;
  const gDVals = [latScore, costScore].filter(v => v != null);
  const gD     = gDVals.length ? gDVals.reduce((a,b)=>a+b,0)/gDVals.length : latScore;

  // Gate E: security rates (active only)
  let gE = null;
  if (d.has_security) {
    const thr  = sl1.input_security?.threat_rate || 0;
    const leak = sl1.output_leakage?.leakage_rate || 0;
    const auth = sl1.authorization?.compliance_rate ?? 100;
    const esc  = sl2.privilege_escalation?.escalation_rate || 0;
    gE = ((100-thr) + (100-leak) + auth + (100-esc)) / 4;
  }

  // Gate F: coordination + workflow (agentic only)
  const coordSR = ag.coordination_summary?.success_rate;
  const gFVals  = [coordSR, wfSR].filter(v => v != null && v >= 0);
  const gF      = d.has_agentic && gFVals.length ? gFVals.reduce((a,b)=>a+b,0)/gFVals.length : null;

  // Gate G: quality avg
  const qualAvg = qual.avg_score;
  const judgeAvg = d.llm_judge?.avg_overall;
  const gGVals = [qualAvg != null ? qualAvg/5*100 : null, judgeAvg != null ? judgeAvg/5*100 : null].filter(v=>v!=null);
  const gG = gGVals.length ? gGVals.reduce((a,b)=>a+b,0)/gGVals.length : (qualAvg != null ? qualAvg/5*100 : 50);

  return { A: gA, B: gB, C: gC, D: gD, E: gE, F: gF, G: gG };
}

function gateStatus(score) {
  if (score == null) return 'na';
  if (score >= 80) return 'pass';
  if (score >= 60) return 'warn';
  return 'fail';
}

function updateGatePill(id, score) {
  const el = document.getElementById(id);
  if (!el) return;
  const s = gateStatus(score);
  el.className = 'gate-pill ' + (s === 'pass' ? 'gate-pill-pass' : s === 'warn' ? 'gate-pill-warn' : s === 'fail' ? 'gate-pill-fail' : 'gate-pill-na');
  const label = s === 'pass' ? '✅ PASS' : s === 'warn' ? '⚠️ WARN' : s === 'fail' ? '❌ FAIL' : '— N/A';
  el.textContent = label + (score != null ? ' ' + Math.round(score) + '%' : '');
}

function harnessGroupHtml(gk, hg) {
  const g = hg[gk];
  if (!g) {
    return `<div class="harness-inactive">⚙️ Harness Config 미활성 — <code>@agent_eval</code> 데코레이터에서 활성화</div>`;
  }
  const metrics = g.metrics || g.scores || {};
  if (!Object.keys(metrics).length) {
    return `<div class="harness-inactive">Harness ${gk} 지표 없음</div>`;
  }
  const entries = Object.entries(metrics).slice(0, 7);
  const maxV = Math.max(...entries.map(([,v]) => +v||0), 1);
  return entries.map(([k, v]) => {
    const pct = Math.min(+(v||0), 100);
    const c = pct >= 80 ? '#10b981' : pct >= 60 ? '#f59e0b' : '#ef4444';
    return `<div class="bar-row">
      <div class="bar-lbl"><span style="font-size:11px">${k.replace(/_/g,' ')}</span><span style="color:${c}">${pct.toFixed(1)}%</span></div>
      <div class="bar-track"><div class="bar-fill" style="width:${pct}%;background:${c}"></div></div>
    </div>`;
  }).join('');
}

