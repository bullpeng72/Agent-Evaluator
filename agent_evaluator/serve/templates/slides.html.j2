<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} — Slides</title>
{% if offline %}
<link rel="stylesheet" href="/static/reveal-reset.css">
<link rel="stylesheet" href="/static/reveal.css">
<link id="reveal-theme" rel="stylesheet" href="/static/reveal-night.css">
<script src="/static/chart.min.js"></script>
<script src="/static/qrcode.min.js"></script>
{% else %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@5.1.0/dist/reset.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@5.1.0/dist/reveal.css">
<link id="reveal-theme" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@5.1.0/dist/theme/night.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js"></script>
{% endif %}
<style>
:root {
  --accent:#6c8ef5;--green:#4ade80;--red:#f87171;--yellow:#facc15;--orange:#fb923c;
  --tc:#d0d4e8;--tc2:#8890b0;--gc:rgba(255,255,255,.07);
  --kpi-bg:rgba(255,255,255,.06);--kpi-bd:rgba(255,255,255,.12);
  --bar-bg:rgba(255,255,255,.1);--card-bg:rgba(255,255,255,.05);
  --divider:rgba(255,255,255,.12);
}
body.light {
  --tc:#1e2030;--tc2:#5a6080;--gc:rgba(0,0,0,.08);
  --kpi-bg:rgba(0,0,0,.04);--kpi-bd:rgba(0,0,0,.1);
  --bar-bg:rgba(0,0,0,.08);--card-bg:rgba(0,0,0,.03);
  --divider:rgba(0,0,0,.1);
}
.reveal,.reveal h1,.reveal h2,.reveal h3,.reveal p,.reveal ul,.reveal li{
  font-family:'Segoe UI',system-ui,sans-serif!important;
}
.reveal{font-size:16px!important;}
.reveal .slides section{
  text-align:left!important;padding:26px 42px 18px!important;
  box-sizing:border-box!important;display:flex!important;flex-direction:column!important;
  overflow:hidden!important;top:0!important;
}
.reveal .slides section h2{
  font-size:21px!important;font-weight:700!important;text-transform:none!important;
  letter-spacing:0!important;margin:0 0 10px!important;padding-bottom:9px!important;
  border-bottom:1px solid var(--divider)!important;color:var(--tc)!important;
  line-height:1.2!important;flex-shrink:0!important;
}
.reveal .slides section h1{
  font-size:50px!important;font-weight:800!important;letter-spacing:-1px!important;
  margin:0!important;color:var(--tc)!important;line-height:1.1!important;
}
/* ── Top bar ── */
#ctrl-bar{
  position:fixed;top:8px;left:50%;transform:translateX(-50%);z-index:9999;
  display:flex;align-items:center;gap:8px;
  background:rgba(20,22,40,.88);border:1px solid rgba(108,142,245,.25);
  border-radius:20px;padding:4px 14px;backdrop-filter:blur(8px);
}
#file-select{
  background:transparent;border:none;color:var(--tc);
  font-size:12px;cursor:pointer;outline:none;max-width:240px;
}
#file-select option{background:#1a1d30;color:#d0d4e8;}
body.light #ctrl-bar{background:rgba(240,242,255,.92);}
body.light #file-select{color:#1e2030;}
body.light #file-select option{background:#f0f2ff;}
#theme-toggle{background:transparent;border:none;color:var(--tc2);font-size:12px;cursor:pointer;padding:0 4px;}
#theme-toggle:hover{color:var(--accent);}
/* ── KPI ── */
.kpi-row{display:grid;gap:9px;margin-bottom:10px;flex-shrink:0;}
.kpi-row   {grid-template-columns:repeat(3,1fr);}
.kpi-row-2 {grid-template-columns:repeat(2,1fr);}
.kpi-row-4 {grid-template-columns:repeat(4,1fr);}
.kpi-row-5 {grid-template-columns:repeat(5,1fr);}
.kpi-box{background:var(--kpi-bg);border:1px solid var(--kpi-bd);border-radius:10px;padding:10px 14px;overflow:hidden;}
.kpi-lbl{font-size:10px!important;color:var(--tc2)!important;text-transform:uppercase!important;
  letter-spacing:.06em!important;margin-bottom:3px!important;white-space:nowrap!important;}
.kpi-val{font-size:26px!important;font-weight:800!important;color:var(--tc)!important;
  line-height:1.1!important;margin:0!important;white-space:nowrap!important;
  overflow:hidden!important;text-overflow:ellipsis!important;}
.kpi-sub{font-size:10px!important;color:var(--tc2)!important;margin-top:2px!important;}
/* ── Colors ── */
.c-green{color:var(--green)!important;} .c-red{color:var(--red)!important;}
.c-yellow{color:var(--yellow)!important;} .c-accent{color:var(--accent)!important;}
/* ── Two-col ── */
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:22px;align-items:start;flex:1;min-height:0;}
/* ── Charts ── */
.chart-wrap{position:relative;height:210px;flex-shrink:0;}
.chart-label{font-size:11px!important;color:var(--tc2)!important;margin-top:4px!important;text-align:center!important;}
/* ── Bars ── */
.bar-row{margin-bottom:9px;}
.bar-lbl{display:flex;justify-content:space-between;font-size:12px!important;color:var(--tc2)!important;margin-bottom:3px!important;}
.bar-lbl span:last-child{font-weight:700!important;}
.bar-track{background:var(--bar-bg);border-radius:99px;height:8px;overflow:hidden;}
.bar-fill{height:100%;border-radius:99px;}
.bar-title{font-size:13px!important;font-weight:600!important;color:var(--tc)!important;margin-bottom:8px!important;}
/* ── Pills ── */
.pill{display:inline-flex;align-items:center;gap:4px;border-radius:99px;padding:4px 12px;font-size:12px!important;font-weight:600;}
.p-ok{background:rgba(74,222,128,.15);color:var(--green);}
.p-warn{background:rgba(250,204,21,.15);color:var(--yellow);}
.p-fail{background:rgba(248,113,113,.15);color:var(--red);}
/* ── Cards ── */
.card{background:var(--card-bg);border:1px solid var(--kpi-bd);border-radius:8px;padding:10px 14px;margin-bottom:7px;flex-shrink:0;}
.card-row{display:flex;align-items:flex-start;gap:11px;}
.card-icon{font-size:17px;flex-shrink:0;margin-top:1px;}
.card-body{flex:1;min-width:0;}
.card-title{font-size:13px!important;font-weight:700!important;color:var(--tc)!important;margin-bottom:2px!important;}
.card-sub{font-size:11px!important;color:var(--tc2)!important;line-height:1.5!important;}
/* ── Verdict banner ── */
.verdict-banner{
  border-radius:10px;padding:12px 18px;
  display:flex;align-items:center;gap:12px;flex-shrink:0;margin-top:10px;
}
.vb-pass  {background:rgba(74,222,128,.12);border:1px solid rgba(74,222,128,.3);}
.vb-cond  {background:rgba(250,204,21,.12); border:1px solid rgba(250,204,21,.3);}
.vb-fail  {background:rgba(248,113,113,.12);border:1px solid rgba(248,113,113,.3);}
.vb-icon  {font-size:28px;flex-shrink:0;}
.vb-label {font-size:22px!important;font-weight:800!important;}
.vb-sub   {font-size:12px!important;color:var(--tc2)!important;margin-top:2px!important;}
/* ── Gauge ── */
.gauge-track{background:var(--bar-bg);border-radius:99px;height:13px;overflow:hidden;}
.gauge-fill{height:100%;border-radius:99px;transition:width .4s;}
.gauge-lbls{display:flex;justify-content:space-between;font-size:11px!important;color:var(--tc2)!important;margin-top:4px!important;}
/* ── Health ── */
.health-big{font-size:80px!important;font-weight:800!important;line-height:1!important;margin:0!important;}
.grade-badge{
  display:inline-block;width:56px;height:56px;line-height:56px;text-align:center;
  border-radius:12px;font-size:32px!important;font-weight:900!important;flex-shrink:0;
}
/* ── Agenda items ── */
.agenda-item{
  display:flex;align-items:center;gap:14px;
  padding:10px 14px;border-radius:8px;margin-bottom:6px;
  background:var(--kpi-bg);border:1px solid var(--kpi-bd);
}
.agenda-num{
  width:28px;height:28px;border-radius:50%;background:rgba(108,142,245,.2);
  color:var(--accent);font-size:13px!important;font-weight:700!important;
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.agenda-text{font-size:13px!important;color:var(--tc)!important;font-weight:600!important;}
.agenda-sub {font-size:11px!important;color:var(--tc2)!important;}
/* ── Priority tags ── */
.tag-p1{display:inline-block;background:rgba(248,113,113,.2);color:#f87171;border-radius:4px;padding:1px 7px;font-size:10px!important;font-weight:700!important;}
.tag-p2{display:inline-block;background:rgba(250,204,21,.2);color:#facc15;border-radius:4px;padding:1px 7px;font-size:10px!important;font-weight:700!important;}
.tag-p3{display:inline-block;background:rgba(108,142,245,.2);color:#818cf8;border-radius:4px;padding:1px 7px;font-size:10px!important;font-weight:700!important;}
/* ── Title slide ── */
.title-inner{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;text-align:center;gap:11px;}
.title-sub{font-size:13px!important;color:var(--tc2)!important;}
.title-name{font-size:14px!important;color:var(--accent)!important;font-weight:600;}
.title-meta{font-size:12px!important;color:var(--tc2)!important;}
.title-hint{font-size:11px!important;color:var(--tc2)!important;margin-top:6px;}
.title-hint kbd{background:var(--kpi-bg);border:1px solid var(--kpi-bd);border-radius:4px;padding:1px 6px;font-family:monospace;font-size:11px;color:var(--tc);}
/* ── Misc ── */
.slide-content{flex:1;display:flex;flex-direction:column;min-height:0;overflow:hidden;}
.no-data{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:1;gap:7px;color:var(--tc2);font-size:12px;opacity:.7;}
.no-data-icon{font-size:30px;opacity:.4;}
.bottom-line{
  margin-top:auto;padding:7px 12px;border-radius:7px;
  background:rgba(108,142,245,.08);border-left:3px solid var(--accent);
  font-size:11px!important;color:var(--tc2)!important;flex-shrink:0;
}
.bottom-line strong{color:var(--tc)!important;}
.reveal .slide-number{font-size:10px;}
.qdim-row{display:flex;align-items:center;gap:9px;margin-bottom:9px;}
.qdim-lbl{font-size:11px;color:var(--tc2);width:70px;flex-shrink:0;}
.qdim-track{flex:1;background:var(--bar-bg);border-radius:99px;height:9px;overflow:hidden;}
.qdim-fill{height:100%;border-radius:99px;}
.qdim-val{font-size:12px;font-weight:700;color:var(--tc);width:32px;text-align:right;flex-shrink:0;}
/* ── Finding cards ── */
.finding-card{
  display:flex;gap:14px;align-items:flex-start;
  background:var(--kpi-bg);border:1px solid var(--kpi-bd);
  border-radius:10px;padding:12px 16px;margin-bottom:8px;flex-shrink:0;
}
.finding-num{
  width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;
  font-size:14px!important;font-weight:800!important;flex-shrink:0;
}
.finding-body{flex:1;min-width:0;}
.finding-title{font-size:14px!important;font-weight:700!important;color:var(--tc)!important;margin-bottom:3px!important;}
.finding-detail{font-size:12px!important;color:var(--tc2)!important;line-height:1.5!important;}
.finding-badge{float:right;padding:2px 10px;border-radius:99px;font-size:11px!important;font-weight:700!important;}
</style>
</head>
<body>
<div id="ctrl-bar">
  <span style="font-size:11px;color:var(--tc2)">📊</span>
  <select id="file-select" onchange="switchFile(this.value)" title="평가 파일 선택"></select>
  <span style="width:1px;height:14px;background:var(--divider);flex-shrink:0"></span>
  <button id="theme-toggle" onclick="toggleTheme()">☀️</button>
</div>

<div class="reveal"><div class="slides">

<!-- ═══ 1. TITLE ═══ -->
<section style="padding:0!important">
  <div class="title-inner">
    <div style="font-size:2.5em">🤖</div>
    <h1>Agent Evaluator</h1>
    <div class="title-sub">AI 에이전트 성능 평가 리포트</div>
    <div style="height:1px;width:56px;background:var(--divider)"></div>
    <div class="title-name" id="slide-title">—</div>
    <div class="title-meta" id="slide-meta">—</div>
    <div class="title-hint">Press <kbd>→</kbd> advance &nbsp;|&nbsp; <kbd>F</kbd> fullscreen &nbsp;|&nbsp; <kbd>Esc</kbd> overview</div>
  </div>
</section>

<!-- ═══ 2. AGENDA ═══ -->
<section>
  <h2>📋 발표 순서</h2>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:9px;flex:1;align-content:start">
    <div class="agenda-item"><div class="agenda-num">1</div><div><div class="agenda-text">평가 개요</div><div class="agenda-sub">대상 · 방법 · 데이터셋</div></div></div>
    <div class="agenda-item"><div class="agenda-num">2</div><div><div class="agenda-text">핵심 발견 (Key Findings)</div><div class="agenda-sub">3가지 주요 결과 요약</div></div></div>
    <div class="agenda-item"><div class="agenda-num">3</div><div><div class="agenda-text">태스크 완료율 (TCR)</div><div class="agenda-sub">성공 · 부분성공 · 실패 분석</div></div></div>
    <div class="agenda-item"><div class="agenda-num">4</div><div><div class="agenda-text">실패 원인 분석</div><div class="agenda-sub">에러 패턴 · 취약 구간 파악</div></div></div>
    <div class="agenda-item"><div class="agenda-num">5</div><div><div class="agenda-text">정확도 · 응답품질</div><div class="agenda-sub">Accuracy · 5차원 Quality</div></div></div>
    <div class="agenda-item"><div class="agenda-num">6</div><div><div class="agenda-text">성능 · 비용 효율</div><div class="agenda-sub">Latency · Token · Cost</div></div></div>
    <div class="agenda-item"><div class="agenda-num">7</div><div><div class="agenda-text">보안 · 에이전틱 지표</div><div class="agenda-sub">Security L1/L2 · Tool · Workflow</div></div></div>
    <div class="agenda-item"><div class="agenda-num">8</div><div><div class="agenda-text">종합 점수 · 액션 플랜</div><div class="agenda-sub">Health Score · 우선순위 개선과제</div></div></div>
  </div>
</section>

<!-- ═══ 3. 평가 개요 ═══ -->
<section>
  <h2>🔬 평가 개요</h2>
  <div class="two-col" style="flex:1;align-items:start">
    <div>
      <div class="bar-title" style="margin-bottom:10px">평가 구성</div>
      <div class="kpi-row kpi-row-2" style="margin-bottom:10px">
        <div class="kpi-box"><div class="kpi-lbl">총 태스크</div><div class="kpi-val c-accent" id="ov-tasks">—</div></div>
        <div class="kpi-box"><div class="kpi-lbl">Task Type 수</div><div class="kpi-val" id="ov-types">—</div></div>
      </div>
      <div class="kpi-row kpi-row-2">
        <div class="kpi-box"><div class="kpi-lbl">평균 실행시간</div><div class="kpi-val" id="ov-avgtime">—</div></div>
        <div class="kpi-box"><div class="kpi-lbl">총 토큰</div><div class="kpi-val" id="ov-tokens">—</div></div>
      </div>
      <div style="margin-top:12px">
        <div class="bar-title">활성화된 평가 레이어</div>
        <div id="ov-layers"></div>
      </div>
    </div>
    <div>
      <div class="bar-title" style="margin-bottom:10px">Task Type 분포</div>
      <div class="chart-wrap" style="height:240px"><canvas id="ov-type-pie"></canvas></div>
    </div>
  </div>
</section>

<!-- ═══ 4. KEY FINDINGS ═══ -->
<section>
  <h2>🔑 핵심 발견 (Key Findings)</h2>
  <div id="kf-cards" class="slide-content" style="gap:0"></div>
  <div id="kf-verdict" class="verdict-banner" style="margin-top:8px"></div>
</section>

<!-- ═══ 5. TASK COMPLETION RATE ═══ -->
<section>
  <h2>📋 태스크 완료율 (TCR)</h2>
  <div class="two-col" style="flex:1;align-items:start">
    <div>
      <div class="chart-wrap" style="height:230px"><canvas id="sl-donut"></canvas></div>
      <div class="chart-label">완전성공 · 부분성공 · 실패 비율</div>
      <div class="kpi-row kpi-row-4" style="margin-top:10px">
        <div class="kpi-box"><div class="kpi-lbl">TCR</div><div class="kpi-val" id="tcr-val">—</div></div>
        <div class="kpi-box"><div class="kpi-lbl">완전성공</div><div class="kpi-val c-green" id="tcr-full">—</div></div>
        <div class="kpi-box"><div class="kpi-lbl">부분성공</div><div class="kpi-val c-yellow" id="tcr-partial">—</div></div>
        <div class="kpi-box"><div class="kpi-lbl">실패</div><div class="kpi-val c-red" id="tcr-fail">—</div></div>
      </div>
    </div>
    <div>
      <div class="bar-title">Task Type별 완료율</div>
      <div id="sl-type-bars" style="flex:1;overflow:hidden"></div>
    </div>
  </div>
  <div class="bottom-line" id="tcr-bottom"></div>
</section>

<!-- ═══ 6. FAILURE ANALYSIS ═══ -->
<section>
  <h2>🔍 실패 원인 분석</h2>
  <div id="fa-nodata" class="no-data" style="display:none;flex:1">
    <div class="no-data-icon">✅</div>
    <div>실패한 태스크가 없습니다</div>
  </div>
  <div id="fa-content" class="two-col" style="flex:1;align-items:start">
    <div>
      <div class="bar-title">실패 집중 Task Type (성공률 낮은 순)</div>
      <div id="fa-type-bars"></div>
      <div style="margin-top:12px">
        <div class="bar-title">완전실패 vs 부분성공</div>
        <div id="fa-ratio"></div>
      </div>
    </div>
    <div>
      <div class="bar-title">에러 유형 분포</div>
      <div id="fa-error-bars"></div>
      <div style="margin-top:12px">
        <div class="bar-title">실패 태스크 정확도 분포</div>
        <div class="chart-wrap" style="height:130px"><canvas id="fa-fail-hist"></canvas></div>
      </div>
    </div>
  </div>
  <div class="bottom-line" id="fa-bottom"></div>
</section>

<!-- ═══ 7. ACCURACY & QUALITY ═══ -->
<section>
  <h2>🎯 정확도 &amp; 응답품질</h2>
  <div class="two-col" style="flex:1;align-items:start">
    <div>
      <div class="kpi-row kpi-row-2" style="margin-bottom:10px">
        <div class="kpi-box"><div class="kpi-lbl">Overall Accuracy</div><div class="kpi-val" id="sl-acc-overall">—</div></div>
        <div class="kpi-box"><div class="kpi-lbl">중앙값</div><div class="kpi-val" id="sl-acc-med">—</div><div class="kpi-sub" id="sl-acc-std"></div></div>
      </div>
      <div class="bar-title">Task Type별 정확도</div>
      <div id="acc-type-bars"></div>
    </div>
    <div>
      <div class="bar-title">응답품질 5차원</div>
      <div id="sl-quality-dims"></div>
      <div id="sl-quality-avg-wrap" style="display:none;margin-top:10px">
        <div style="font-size:11px;color:var(--tc2);margin-bottom:6px;font-weight:600">종합 품질 점수 (/ 5.0)</div>
        <div class="gauge-track"><div class="gauge-fill" id="sl-quality-gauge-fill" style="width:0%;background:#6c8ef5"></div></div>
        <div class="gauge-lbls"><span>0</span><span id="sl-quality-avg-val" style="color:var(--accent);font-weight:700"></span><span>5.0</span></div>
      </div>
      <div id="sl-quality-nodata" class="no-data" style="display:none">
        <div class="no-data-icon">📊</div>
        <div style="font-size:11px">ResponseQualityEvaluator 미활성</div>
      </div>
    </div>
  </div>
  <div class="bottom-line" id="acc-bottom"></div>
</section>

<!-- ═══ 8. HALLUCINATION ═══ -->
<section>
  <h2>🧠 환각 감지 (Hallucination Detection)</h2>
  <div id="sl-hallu-active" class="slide-content">
    <div class="kpi-row kpi-row-4" style="margin-bottom:10px">
      <div class="kpi-box"><div class="kpi-lbl">환각 발생률</div><div class="kpi-val" id="sl-hallu-rate">—</div><div class="kpi-sub" id="sl-hallu-rate-sub"></div></div>
      <div class="kpi-box"><div class="kpi-lbl">평가 건수</div><div class="kpi-val" id="sl-hallu-total">—</div></div>
