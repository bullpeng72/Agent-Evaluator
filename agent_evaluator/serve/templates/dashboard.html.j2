  // ── Data helpers ───────────────────────────────────────────────────────
  tcr()  { return this.data?.accuracy_metrics?.tcr?.tcr || 0; },
  acc()  { return this.data?.accuracy_metrics?.accuracy_scores?.overall_accuracy || 0; },
  hall() { return this.data?.accuracy_metrics?.hallucination?.overall_rate || 0; },
  lat_mean() { return this.data?.efficiency_metrics?.latency?.mean || 0; },

  typeBreakdown() {
    const d = this.data; if (!d) return [];
    const suc={},tot={};
    (d.tasks||[]).forEach(t=>{
      tot[t.task_type]=(tot[t.task_type]||0)+1;
      if(t.success) suc[t.task_type]=(suc[t.task_type]||0)+1;
    });
    return Object.keys(tot).map(tp=>({ type:tp, n:tot[tp], rate:tot[tp]?(suc[tp]||0)/tot[tp]*100:0 }));
  },

  lowAccTasks() {
    return (this.data?.tasks||[]).filter(t=>t.accuracy_score<0.7 && t.accuracy_score>0);
  },

  ragAvg(key) {
    const arr = this.data?.advanced?.rag_metrics?.[key] || [];
    if (!arr.length) return '—';
    return (arr.reduce((a,b)=>a+b,0)/arr.length).toFixed(3);
  },

  // ── Health scoring ─────────────────────────────────────────────────────
  get l1s() {
    const d=this.data; if(!d) return 0;
    const tcr=d.accuracy_metrics?.tcr?.tcr||0;
    const acc=d.accuracy_metrics?.accuracy_scores?.overall_accuracy||0;
    const h=Math.max(0,100-(d.accuracy_metrics?.hallucination?.overall_rate||0)*10);
    return Math.round((tcr+acc+h)/3);
  },
  get l2s() {
    const d=this.data; if(!d||!d.has_agentic) return 50;
    const toolAcc=d.agentic?.tool_selection_summary?.avg_f1_score||0;
    const coord=d.agentic?.coordination_summary?.success_rate||0;
    const wf=d.agentic?.workflow_summary?.step_success_rate||0;
    const cnt=[toolAcc,coord,wf].filter(v=>v>0);
    return cnt.length?Math.round(cnt.reduce((a,b)=>a+b,0)/cnt.length):50;
  },
  get ps() {
    const p95=this.data?.efficiency_metrics?.latency?.p95||0;
    return Math.max(0,Math.min(100,Math.round(100-p95*15)));
  },
  get ss() {
    const d=this.data; if(!d||!d.has_security) return 50;
    const thr=100-(d.security_l1?.input_security?.threat_rate||0);
    const leak=100-(d.security_l1?.output_leakage?.leakage_rate||0);
    const auth=d.security_l1?.authorization?.compliance_rate||100;
    return Math.round((thr+leak+auth)/3);
  },
  get hs() { return Math.round((this.l1s+this.l2s+this.ps+this.ss)/4); },
  get hl() { const s=this.hs; return s>=90?'EXCELLENT':s>=80?'GOOD':s>=70?'FAIR':'NEEDS WORK'; },

  secScore(type) {
    const d=this.data;
    if (type==='input')  return Math.max(0,Math.round(100-(d?.security_l1?.input_security?.threat_rate||0)));
    if (type==='output') return Math.max(0,Math.round(100-(d?.security_l1?.output_leakage?.leakage_rate||0)));
    if (type==='auth')   return Math.round(d?.security_l1?.authorization?.compliance_rate||100);
    return 50;
  },

  // Anomaly detection (rule-based)
  autoAnomalies() {
    const d=this.data; if(!d) return [];
    const a=[];
    const tTCR=this.thresholds.tcr, tACC=this.thresholds.acc, tHALL=this.thresholds.hall, tP95=this.thresholds.p95;
    if (this.tcr()<tTCR*0.78) a.push({sev:'critical', title:'TCR 위험 수준', desc:`TCR ${this.pct(this.tcr())} (목표 ≥${tTCR}%). 즉시 실패 태스크 원인 분석 필요.`});
    else if (this.tcr()<tTCR) a.push({sev:'medium', title:'TCR 목표 미달', desc:`TCR ${this.pct(this.tcr())} (목표 ≥${tTCR}%).`});
    if (this.acc()<tACC*0.71) a.push({sev:'critical', title:'Accuracy 매우 낮음', desc:`Accuracy ${this.pct(this.acc())} — 응답 검증 로직 점검 필요.`});
    if (this.hall()>tHALL*3) a.push({sev:'critical', title:'환각 발생률 위험', desc:`${this.pct(this.hall())} (허용 ≤${tHALL}%). RAG 파이프라인 검증 필요.`});
    else if (this.hall()>tHALL) a.push({sev:'medium', title:'환각 발생률 주의', desc:`${this.pct(this.hall())} (허용 ≤${tHALL}%).`});
    const p95=d.efficiency_metrics?.latency?.p95||0;
    if (p95>tP95*2.5) a.push({sev:'high', title:'P95 Latency 심각', desc:`${p95.toFixed(2)}s (목표 ≤${tP95}s). 모델 경량화 또는 캐싱 검토.`});
    else if (p95>tP95) a.push({sev:'medium', title:'P95 Latency 초과', desc:`${p95.toFixed(2)}s (목표 ≤${tP95}s).`});
    const txR=d.security_l1?.input_security?.threat_rate||0;
    if (txR>20) a.push({sev:'high', title:'입력 위협률 높음', desc:`${txR.toFixed(1)}% 입력에서 보안 위협 탐지.`});
    const lkR=d.security_l1?.output_leakage?.leakage_rate||0;
    if (lkR>0) a.push({sev:'critical', title:'민감 정보 유출 탐지', desc:`출력에서 ${lkR.toFixed(1)}% 유출률 — 즉시 확인 필요.`});
    return a;
  },

  metricStatus() {
    const d=this.data; if(!d) return [];
    const tTCR=this.thresholds.tcr, tACC=this.thresholds.acc, tHALL=this.thresholds.hall, tP95=this.thresholds.p95;
    return [
      { name:'TCR',           value:this.pct(this.tcr()),  cls:this.tcr()>=tTCR?'pg':this.tcr()>=(tTCR*0.78)?'py':'pr', status:this.tcr()>=tTCR?'✅ 목표달성':'⚠️ 개선필요' },
      { name:'Accuracy',      value:this.pct(this.acc()),  cls:this.acc()>=tACC?'pg':'pr', status:this.acc()>=tACC?'✅':'❌' },
      { name:'Hallucination', value:this.pct(this.hall()), cls:this.hall()<=tHALL?'pg':this.hall()<=tHALL*3?'py':'pr', status:this.hall()<=tHALL?'✅ SAFE':this.hall()<=tHALL*3?'⚠️ WARNING':'🚨 DANGER' },
      { name:'P95 Latency',   value:this.sec_(d.efficiency_metrics?.latency?.p95), cls:this.ps>=80?'pg':this.ps>=60?'py':'pr', status:(d.efficiency_metrics?.latency?.p95||0)<=tP95?'✅':'⚠️' },
    ];
  },

  // ── Benchmark grade ────────────────────────────────────────────────────
  benchGrade(tcr) {
    if (tcr >= 95) return { letter:'A', label:'Excellent' };
    if (tcr >= 85) return { letter:'B', label:'Good' };
    if (tcr >= 70) return { letter:'C', label:'Fair' };
    if (tcr >= 55) return { letter:'D', label:'Poor' };
    return { letter:'F', label:'Fail' };
  },

  // ── Framework distribution ─────────────────────────────────────────────
  frameworkDist() {
    const tasks = this.data?.tasks||[];
    const cnt={}, suc={};
    tasks.forEach(t=>{
      const fw = t.framework||'unknown';
      cnt[fw]=(cnt[fw]||0)+1;
      if (t.success) suc[fw]=(suc[fw]||0)+1;
    });
    return Object.entries(cnt).map(([name,count])=>({ name, count, rate:count?(suc[name]||0)/count*100:0 })).sort((a,b)=>b.count-a.count);
  },

  // ── Statistical anomaly detection (Z-score) ───────────────────────────
  statAnomalies() {
    const tasks = this.data?.tasks||[];
    if (tasks.length < 3) return [];
    const results = [];
    const fields = [
      { key:'accuracy_score', label:'Accuracy', scale:100 },
      { key:'execution_time', label:'Latency', scale:1 },
    ];
    fields.forEach(({key,label,scale})=>{
      const vals = tasks.map(t=>+(t[key]||0)*scale).filter(v=>v>0);
      if (vals.length<3) return;
      const mean = vals.reduce((a,b)=>a+b,0)/vals.length;
      const std  = Math.sqrt(vals.map(v=>(v-mean)**2).reduce((a,b)=>a+b,0)/vals.length);
      if (std===0) return;
      tasks.forEach(t=>{
        const v = +(t[key]||0)*scale;
        if (v<=0) return;
        const z = Math.abs((v-mean)/std);
        if (z>=2.0) {
          const dir = v>mean?'높음':'낮음';
          results.push({ sev:z>=3?'high':'medium', title:`[${label}] 이상치: ${t.task_id}`, desc:`Z-score ${z.toFixed(2)} — 값 ${v.toFixed(2)}, 평균 ${mean.toFixed(2)} (${dir})` });
        }
      });
    });
    return results.slice(0,10);
  },

  // ── Metric correlation (Pearson) ───────────────────────────────────────
  metricCorr() {
    const tasks = this.data?.tasks||[];
    if (tasks.length < 3) return [];
    function pearson(xs, ys) {
      const n=xs.length; if(!n) return 0;
      const mx=xs.reduce((a,b)=>a+b,0)/n, my=ys.reduce((a,b)=>a+b,0)/n;
      const num=xs.reduce((s,x,i)=>s+(x-mx)*(ys[i]-my),0);
      const dx=Math.sqrt(xs.reduce((s,x)=>s+(x-mx)**2,0));
      const dy=Math.sqrt(ys.reduce((s,y)=>s+(y-my)**2,0));
      return (dx&&dy)?num/(dx*dy):0;
    }
    const acc   = tasks.map(t=>t.accuracy_score*100);
    const lat   = tasks.map(t=>t.execution_time||0);
    const tok   = tasks.map(t=>(t.tokens_used?.total||0));
    const comp  = tasks.map(t=>t.completion_score*100);
    return [
      { label:'Accuracy ↔ Latency',    r:pearson(acc,lat)  },
      { label:'Accuracy ↔ Tokens',     r:pearson(acc,tok)  },
      { label:'Accuracy ↔ Completion', r:pearson(acc,comp) },
      { label:'Latency ↔ Tokens',      r:pearson(lat,tok)  },
    ];
  },

  // ── Correlation matrix (4×4 for heatmap) ─────────────────────────────
  metricCorrMatrix() {
    const tasks = this.data?.tasks||[];
    if (tasks.length < 3) return {labels:[], z:[]};
    function pearson(xs, ys) {
      const n=xs.length; if(!n) return 0;
      const mx=xs.reduce((a,b)=>a+b,0)/n, my=ys.reduce((a,b)=>a+b,0)/n;
      const num=xs.reduce((s,x,i)=>s+(x-mx)*(ys[i]-my),0);
      const dx=Math.sqrt(xs.reduce((s,x)=>s+(x-mx)**2,0));
      const dy=Math.sqrt(ys.reduce((s,y)=>s+(y-my)**2,0));
      return (dx&&dy)?+(num/(dx*dy)).toFixed(3):0;
    }
    const labels = ['정확도','지연시간','토큰수','완료율'];
    const vecs = [
      tasks.map(t=>t.accuracy_score*100),
      tasks.map(t=>t.execution_time||0),
      tasks.map(t=>(t.tokens_used?.total||0)),
      tasks.map(t=>t.completion_score*100),
    ];
    const z = vecs.map(a=>vecs.map(b=>pearson(a,b)));
    return {labels, z};
  },

  // ── Security Event Timeline ────────────────────────────────────────────
  secEventTimeline() {
    const d = this.data; if (!d) return [];
    const evts = [];
    let idx = 0;
    // L1 input threats
    for (const e of (d.security_l1?.input_evals||[])) {
      const cats = [];
      if (e.sql_injection)       cats.push('SQL Injection');
      if (e.prompt_injection)    cats.push('Prompt Injection');
      if (e.xss)                 cats.push('XSS');
      if (e.command_injection)   cats.push('Command Injection');
      if (e.path_traversal)      cats.push('Path Traversal');
      const risk = e.threat_level==='critical'?3:e.threat_level==='high'?2:1;
      for (const cat of cats) {
        evts.push({idx:idx++, taskId:e.task_id||'?', category:cat, layer:'L1 입력위협', risk});
      }
    }
    // L1 output leakage
    for (const e of (d.security_l1?.output_detections||[])) {
      if (!e.has_leakage) continue;
      const cats = [];
      if (e.api_key_detected)   cats.push('API Key');
      if (e.password_detected)  cats.push('Password');
      if (e.email_detected)     cats.push('Email');
      if (e.phone_detected)     cats.push('Phone');
      if (!cats.length)         cats.push('Leakage');
      for (const cat of cats) {
        evts.push({idx:idx++, taskId:e.task_id||'?', category:cat, layer:'L1 출력유출', risk:2});
      }
    }
    // L2 escalation events
    for (const e of (d.security_l2?.escalation_events||[])) {
      evts.push({idx:idx++, taskId:e.task_id||'?', category:'Privilege Escalation', layer:'L2 고급위협', risk:3});
    }
    // L2 attack detections
    for (const e of (d.security_l2?.attack_detections||[])) {
      evts.push({idx:idx++, taskId:e.task_id||'?', category:e.attack_type||'Attack Chain', layer:'L2 고급위협', risk:3});
    }
    return evts;
  },

  // ── Agent Network Graph ────────────────────────────────────────────────
  agentNetworkData() {
    const d = this.data; if (!d) return {nodes:[], edges:[]};
    const interactions = d.agentic?.agent_interactions||[];
    if (interactions.length < 2) return {nodes:[], edges:[]};
    const nodeSet = new Set();
    const edgeMap = {};
    for (const intr of interactions) {
      const fa = intr.from_agent||'?', ta = intr.to_agent||'?';
      nodeSet.add(fa); nodeSet.add(ta);
      const key = `${fa}→${ta}`;
      if (!edgeMap[key]) edgeMap[key] = {from:fa, to:ta, count:0, success:0};
      edgeMap[key].count++;
      if (intr.success) edgeMap[key].success++;
    }
    const names = [...nodeSet];
    const n = names.length;
    const pos = {};
    names.forEach((name,i)=>{
      const a = (2*Math.PI*i/n) - Math.PI/2;
      pos[name] = {x:+Math.cos(a).toFixed(4), y:+Math.sin(a).toFixed(4)};
    });
    // Degree = total interactions per node
    const degree = {};
    names.forEach(name=>{ degree[name]=0; });
    Object.values(edgeMap).forEach(e=>{ degree[e.from]+=e.count; degree[e.to]+=e.count; });
    const nodes = names.map(name=>({name, ...pos[name], degree:degree[name]||0}));
    const edges = Object.values(edgeMap).map(e=>({
      ...e,
      fx:pos[e.from]?.x||0, fy:pos[e.from]?.y||0,
      tx:pos[e.to]?.x||0,   ty:pos[e.to]?.y||0,
    }));
    return {nodes, edges};
  },

  // ── Data quality score ─────────────────────────────────────────────────
  dataQuality() {
    const tasks = this.data?.tasks||[];
    if (!tasks.length) return { overall:0, fields:[] };
    const checks = [
      { name:'task_id',         fn:t=>!!t.task_id },
      { name:'task_type',       fn:t=>!!t.task_type },
      { name:'accuracy_score',  fn:t=>t.accuracy_score!=null&&t.accuracy_score>=0 },
      { name:'execution_time',  fn:t=>t.execution_time!=null&&t.execution_time>0 },
      { name:'tokens_used',     fn:t=>!!(t.tokens_used?.total) },
      { name:'framework',       fn:t=>!!t.framework },
      { name:'expected_tools',  fn:t=>!!(t.expected_tools?.length) },
      { name:'timestamp',       fn:t=>!!t.timestamp },
    ];
    const fields = checks.map(c=>{
      const filled = tasks.filter(c.fn).length;
      return { name:c.name, filled, total:tasks.length, pct:filled/tasks.length*100 };
    });
    const overall = fields.reduce((s,f)=>s+f.pct,0)/fields.length;
    return { overall, fields };
  },

