    { id:'export',        icon:'📦', label:'Export',             group: '운영',         scope:'file'   },
    { id:'cost',          icon:'💰', label:'평가 비용',           group: '운영',         scope:'file'   },
    { id:'settings',      icon:'⚙️', label:'Settings',           group: '운영',         scope:'global' },
    { id:'glossary',      icon:'📚', label:'지표 설명',           group: '운영',         scope:'global' },
  ],

  glossary: [
    // ── 품질 ────────────────────────────────────────────────────────────
    { cat:'quality',  icon:'📋', term:'TCR (Task Completion Rate)', layer:'Layer 1 · 기본', tKey:'tcr',
      purpose:'에이전트가 주어진 작업을 얼마나 완수했는지 나타내는 핵심 성과 지표.',
      desc:'모든 작업의 Completion Score 합계 ÷ 전체 작업 수 × 100. task_type 인식 자동 판정(v0.8.0+): code_generation/coding은 AST 파싱 성공 여부, tool_use는 tool_calls 존재 여부, 기타는 응답 길이 기반.',
      range:'0~100%', target:'≥ 90%' },
    { cat:'quality',  icon:'🎯', term:'Accuracy', layer:'Layer 1 · 기본', tKey:'acc',
      purpose:'에이전트 답변이 정답(ground truth)과 얼마나 일치하는지 측정.',
      desc:'TokenOverlapF1(40%) · Jaccard(30%) · LCS(20%) · CharSimilarity/Levenshtein(10%) 가중 평균. TokenOverlapF1은 Precision×Recall 조화평균으로 긴 응답 패딩 방지. Char Similarity는 Levenshtein 거리 기반(문자 순서 반영). 코드 태스크는 AST 비교 → 정규화 비교 순 fallback.',
      range:'0~100%', target:'≥ 70%' },
    { cat:'quality',  icon:'⭐', term:'Response Quality', layer:'Layer 1 · 기본',
      purpose:'정답 일치와 무관하게 응답 자체의 실용적 품질을 다차원으로 평가.',
      desc:'관련성(Relevance) · 완전성(Completeness) · 명확성(Clarity) · 정확성(Accuracy) · 유용성(Usefulness) 5개 차원을 각 0~5점으로 평가. 총점 0~5점 (가중 평균). 규칙 기반이므로 외부 API 불필요.',
      range:'0~5', target:'≥ 3.5' },
    { cat:'quality',  icon:'🧠', term:'Hallucination Rate', layer:'Layer 1 · 기본', tKey:'hall',
