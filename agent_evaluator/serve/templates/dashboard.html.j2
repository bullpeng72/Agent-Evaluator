        </div>
        <div class="kpi">
          <div class="kpi-lbl">출력 유출률</div>
          <div class="kpi-val" style="color:var(--red)" x-text="pct(data.security_l1?.output_leakage?.leakage_rate)"></div>
        </div>
      </div>
    </div>

    <!-- Radar + bars side by side -->
    <div class="cg">
      <div class="cbox"><div class="ct">보안 위협 분포 (레이더)</div><div id="intsec-radar" class="plt-chart" style="height:240px"></div></div>
      <div>
        <div class="sec" style="margin-bottom:8px">
