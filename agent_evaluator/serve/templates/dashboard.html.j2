  async init() {
    this.dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    await this.refresh();
    if (WATCH) this.startSSE();
    await this.loadGoldenList();
    // Load persisted thresholds from server
    try {
      const r = await fetch('/api/thresholds');
      if (r.ok) { const d = await r.json(); this.thresholds = {...this.thresholds, ...d}; }
    } catch(e) { /* ignore — keep defaults */ }
    // Plotly charts rendered in hidden divs (x-show) get 0 dimensions.
    // Re-dispatch resize whenever any tab variable changes so Plotly relayouts.
    // Re-render all charts when any tab changes (resize alone can't fix corrupted categorical axes)
    const _rerender = () => this.$nextTick(() => this.renderAll());
    ['sec','t1','t2','tp','tsec','ti','ttr','tl3','tq','tperf','tag','tsec2'].forEach(k => this.$watch(k, _rerender));
  },

  async refresh() {
    try {
      const r = await fetch('/api/results');
      this.files = await r.json();
      this.lastUpd = new Date().toLocaleTimeString('ko-KR');
      // Invalidate transparency list cache so new files are picked up
      this.trData = { traces:[], annotations:[], audit:[], auditItems:[] };
      this.trDetail = {};
      this.annDetail = {};
      if (this.files.length > 0 && !this.selId) {
        this.selId = this.files[0].id;
        await this.loadFile(this.selId);
      }
    } catch(e) { console.error(e); }
  },

  async loadFile(id) {
    if (!id) { this.data = null; return; }
    this.loading = true;
    // Invalidate transparency caches — they are global, not per-file
    this.trData = { traces:[], annotations:[], audit:[], auditItems:[] };
    this.trDetail = {};
    this.annDetail = {};
    try {
      const r = await fetch(`/api/results/${id}`);
      this.data = await r.json();
      this.lastUpd = new Date().toLocaleTimeString('ko-KR');
      await this.$nextTick();
      this.renderAll();
      this.renderTable();
    } catch(e) { console.error(e); }
    finally { this.loading = false; }
  },

  // ── Phase 1: Deployment Gate & Trend ──

  prevFile() {
    if (!this.selId || this.files.length < 2) return null;
    const idx = this.files.findIndex(f => f.id === this.selId);
    return (idx >= 0 && idx + 1 < this.files.length) ? this.files[idx + 1] : null;
  },

  deltaFmt(curr, prev, higherBetter = true, unit = '%') {
    if (prev == null || curr == null || isNaN(prev) || isNaN(curr)) return null;
    const d = curr - prev;
    if (Math.abs(d) < 0.005) return { txt: '─ 변화없음', cls: 'neu' };
    const up = d > 0;
    const good = higherBetter ? up : !up;
    let fmtVal;
    if (unit === '$') fmtVal = '$' + parseFloat(Math.abs(d).toFixed(4));
    else if (unit === 's') fmtVal = Math.abs(d).toFixed(3) + 's';
    else fmtVal = Math.abs(d).toFixed(1) + '%';
    return { txt: `${up ? '▲' : '▼'} ${fmtVal}`, cls: good ? 'up' : 'dn' };
  },

  deployGates() {
    if (!this.data) return [];
    const tcr  = this.tcr()  || 0;
    const acc  = this.acc()  || 0;
    const hall = this.hall() || 0;
    const p95  = this.data.efficiency_metrics?.latency?.p95 || 0;
    const cost = this.data.efficiency_metrics?.tokens?.avg_cost_per_task || 0;
    // Derive gate thresholds from user settings (dev = relaxed, staging = target, prod = strict)
    const t = this.thresholds;
    const devTCR  = Math.max(50, t.tcr  - 10);
    const devACC  = Math.max(30, t.acc  - 15);
    const devHALL = t.hall * 2;
    const stgTCR  = t.tcr;
    const stgACC  = Math.min(100, t.acc + 5);
    const stgHALL = t.hall;
    const stgP95  = t.p95;
    const prdTCR  = Math.min(100, t.tcr  + 5);
    const prdACC  = Math.min(100, t.acc  + 10);
    const prdHALL = +(t.hall * 0.6).toFixed(1);
    const prdP95  = +(t.p95  * 0.75).toFixed(1);
    const prdCOST = t.cost;
    const gates = [
      {
        label: '🔬 개발', key: 'dev',
        criteria: [
          { name: `TCR ≥ ${devTCR}%`,      pass: tcr  >= devTCR,  val: `${tcr.toFixed(1)}%`  },
          { name: `Accuracy ≥ ${devACC}%`, pass: acc  >= devACC,  val: `${acc.toFixed(1)}%`  },
          { name: `Hall ≤ ${devHALL}%`,    pass: hall <= devHALL, val: `${hall.toFixed(1)}%` },
        ]
      },
      {
        label: '🚀 스테이징', key: 'staging',
        criteria: [
          { name: `TCR ≥ ${stgTCR}%`,      pass: tcr  >= stgTCR,  val: `${tcr.toFixed(1)}%`  },
          { name: `Accuracy ≥ ${stgACC}%`, pass: acc  >= stgACC,  val: `${acc.toFixed(1)}%`  },
          { name: `Hall ≤ ${stgHALL}%`,    pass: hall <= stgHALL, val: `${hall.toFixed(1)}%` },
          { name: `P95 ≤ ${stgP95}s`,      pass: p95  <= stgP95,  val: `${p95.toFixed(2)}s`  },
        ]
      },
      {
        label: '🏭 프로덕션', key: 'prod',
        criteria: [
          { name: `TCR ≥ ${prdTCR}%`,           pass: tcr  >= prdTCR,  val: `${tcr.toFixed(1)}%`  },
          { name: `Accuracy ≥ ${prdACC}%`,      pass: acc  >= prdACC,  val: `${acc.toFixed(1)}%`  },
          { name: `Hall ≤ ${prdHALL}%`,         pass: hall <= prdHALL, val: `${hall.toFixed(1)}%` },
          { name: `P95 ≤ ${prdP95}s`,           pass: p95  <= prdP95,  val: `${p95.toFixed(2)}s`  },
          { name: `Cost ≤ $${parseFloat(prdCOST.toFixed(3))}/task`, pass: cost <= prdCOST, val: `$${parseFloat(cost.toFixed(4))}`  },
        ]
      },
    ];
    return gates.map(g => ({
      ...g,
      passed: g.criteria.filter(c => c.pass).length,
      total:  g.criteria.length,
      cls:    g.criteria.every(c => c.pass)  ? 'pass'
            : g.criteria.every(c => !c.pass) ? 'fail'
            : 'partial',
    }));
  },

  renderTrend() {
    if (this.files.length < 2) return;
    const TC = this.dark ? '#8890b0' : '#5a6080';
    const GC = this.dark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.07)';
    const sorted = [...this.files].reverse(); // oldest first
    const names  = sorted.map(f => f.name.substring(0, 18));
    const curIdx = sorted.findIndex(f => f.id === this.selId);
    const mkMarker = (arr) => ({
      size: arr.map((_,i) => i === curIdx ? 10 : 6),
      opacity: arr.map((_,i) => i === curIdx ? 1 : 0.6),
    });
    const tcrY  = sorted.map(f => +(f.tcr || 0));
    const accY  = sorted.map(f => +(f.accuracy || 0));
    const latY  = sorted.map(f => +(f.avg_latency || 0));
    const traces = [
      { name:'TCR %',      x:names, y:tcrY, mode:'lines+markers', line:{color:'#6c8ef5',width:2}, marker:{...mkMarker(tcrY), color:'#6c8ef5'}, yaxis:'y' },
      { name:'Accuracy %', x:names, y:accY, mode:'lines+markers', line:{color:'#4ade80',width:2}, marker:{...mkMarker(accY), color:'#4ade80'}, yaxis:'y' },
      { name:'Latency s',  x:names, y:latY, mode:'lines+markers', line:{color:'#facc15',width:1.5,dash:'dot'}, marker:{...mkMarker(latY), color:'#facc15'}, yaxis:'y2' },
    ];
    const layout = {
      height:200, margin:{t:10,b:40,l:40,r:50},
      xaxis:  {tickfont:{color:TC,size:9}, gridcolor:GC, automargin:true},
      yaxis:  {tickfont:{color:TC}, gridcolor:GC, range:[0,105], ticksuffix:'%', title:{text:'%', font:{color:TC,size:10}}},
      yaxis2: {tickfont:{color:TC}, gridcolor:GC, overlaying:'y', side:'right', title:{text:'s', font:{color:TC,size:10}}},
      legend: {font:{color:TC,size:10}, orientation:'h', y:1.15},
      paper_bgcolor:'transparent', plot_bgcolor:'transparent', autosize:true,
      shapes: [
        {type:'line', x0:0, x1:1, xref:'paper', y0:this.thresholds.tcr, y1:this.thresholds.tcr, yref:'y', line:{color:'#6c8ef560',dash:'dash',width:1}},
        {type:'line', x0:0, x1:1, xref:'paper', y0:this.thresholds.acc, y1:this.thresholds.acc, yref:'y', line:{color:'#4ade8060',dash:'dash',width:1}},
      ],
    };
    if (window.Plotly && document.getElementById('ov-trend')) {
      Plotly.react('ov-trend', traces, layout, {responsive:true, displayModeBar:false});
    }
  },

  startSSE() {
    const es = new EventSource('/api/stream');
    es.onopen = () => { this.connected = true; };
    es.onerror = () => { this.connected = false; };
    es.onmessage = async e => {
      const m = JSON.parse(e.data);
      if (m.type === 'update') { await this.refresh(); if (this.selId) await this.loadFile(this.selId); }
    };
  },

  // ── Chart helpers ──────────────────────────────────────────────────────
  _plt(id, traces, layout, cfg) {
    const el = document.getElementById(id);
    if (!el || el.clientWidth === 0) return; // skip hidden x-show divs (avoids 0×0 Plotly corruption)
    const TC = this.dark ? '#8890b0' : '#5a6080';
    const GC = this.dark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.07)';
    const PBG = 'transparent';
    const base = {
      margin: {t:10, b:40, l:50, r:16, pad:2},
      paper_bgcolor: PBG, plot_bgcolor: PBG,
      font: {color: TC, size: 11, family: "'Segoe UI',system-ui,sans-serif"},
      xaxis: {tickfont:{color:TC,size:10}, gridcolor:GC, zerolinecolor:GC, automargin:true},
      yaxis: {tickfont:{color:TC,size:10}, gridcolor:GC, zerolinecolor:GC, automargin:true},
      showlegend: false,
      height: 200,
      autosize: true,
      modebar: {remove: ['all']},
    };
    Plotly.react(el, traces, Object.assign({}, base, layout), Object.assign({responsive:true, displayModeBar:false, scrollZoom:false}, cfg||{}));
  },

  renderAll() {
    const d = this.data; if (!d) return;
    this.renderTrend();
    const TC = this.dark ? '#8890b0' : '#5a6080';
    const GC = this.dark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.07)';
    const scX = {tickfont:{color:TC}, gridcolor:GC, zerolinecolor:GC};
    const scY = {tickfont:{color:TC}, gridcolor:GC, zerolinecolor:GC};
    const noLeg = {showlegend:false};

    // ── Overview donut (success/fail) ──
    const tcr = d.accuracy_metrics?.tcr||{};
    const full=tcr.full_success||0, part=tcr.partial_success||0;
    const fail=tcr.failures||(d.total_tasks-(full+part));
    const donutTrace = [{
      type:'pie', hole:0.7,
      values:[full,part,fail],
      labels:['완전성공','부분성공','실패'],
      marker:{colors:['#4ade80','#facc15','#f87171']},
      textinfo:'none',
    }];
    const donutLayout = {height:200, showlegend:true, legend:{font:{color:TC,size:10}}, margin:{t:10,b:10,l:10,r:10}};
    this._plt('ov-donut', donutTrace, donutLayout);
    this._plt('l1-donut', donutTrace, donutLayout);

    // ── Overview type bar ──
    const typeCnt={};
    (d.tasks||[]).forEach(t=>{ typeCnt[t.task_type]=(typeCnt[t.task_type]||0)+1; });
    this._plt('ov-type', [{type:'bar', x:Object.keys(typeCnt), y:Object.values(typeCnt), marker:{color:'#6c8ef580', line:{color:'#6c8ef5',width:1}}}],
      {xaxis:scX, yaxis:scY, ...noLeg});

    // ── Layer1 type success rates (horizontal) ──
    const tSuc={},tTot={};
    (d.tasks||[]).forEach(t=>{
      tTot[t.task_type]=(tTot[t.task_type]||0)+1;
      if(t.success) tSuc[t.task_type]=(tSuc[t.task_type]||0)+1;
    });
    const types=Object.keys(tTot);
    const rates=types.map(tp=>tTot[tp]?(tSuc[tp]||0)/tTot[tp]*100:0);
    this._plt('l1-type', [{type:'bar', orientation:'h', y:types, x:rates,
      text:rates.map(v=>v.toFixed(1)+'%'), textposition:'inside', insidetextanchor:'middle',
      textfont:{color:'#444',size:12,family:'system-ui'},
      marker:{color:rates.map(v=>v>=90?'#4ade8080':v>=70?'#facc1580':'#f8717180'), line:{color:rates.map(v=>v>=90?'#4ade80':v>=70?'#facc15':'#f87171'), width:1}}}],
      {xaxis:{...scX,range:[0,100],showticklabels:false,showgrid:false,zeroline:false},
       yaxis:{...scY,automargin:true}, ...noLeg, margin:{t:10,b:10,l:100,r:10}});

    // ── Failure reason pie ──
    const errTypes = {};
    (d.tasks||[]).filter(t=>!t.success).forEach(t=>{
      (t.errors||[]).forEach(e=>{
        const et = (typeof e==='string'?e:(e.type||e.error_type||String(e))).split(':')[0].trim().substring(0,20)||'Unknown';
        errTypes[et]=(errTypes[et]||0)+1;
      });
      if(!(t.errors||[]).length) errTypes['Unknown']=(errTypes['Unknown']||0)+1;
    });
    if(Object.keys(errTypes).length>0){
      this._plt('l1-fail-reason',[{type:'pie',values:Object.values(errTypes),labels:Object.keys(errTypes),
        marker:{colors:['#f87171','#fb923c','#facc15','#a78bfa','#60a5fa']},
        textinfo:'percent',textfont:{color:'#fff',size:12},
        domain:{x:[0.15,0.5]},
        hovertemplate:'%{label}<br>%{value}건 (%{percent})<extra></extra>'}],
        {height:240,showlegend:true,
         legend:{font:{color:TC,size:12},orientation:'v',x:0.55,xanchor:'left',y:0.5,yanchor:'middle'},
         margin:{t:10,b:10,l:10,r:10}});
    }

    // ── Health gauge ──
    const hs = this.hs;
    const gc = hs>=80?'#4ade80':hs>=60?'#facc15':'#f87171';
    const hl = this.hl;
    Plotly.react('gauge-c', [{
      type:'indicator', mode:'gauge+number',
      value: hs,
      number: {font:{size:26, color: this.dark?'#e2e4f0':'#1a1d2e'}},
      title: {text:hl, font:{size:9, color:TC}},
      gauge: {
        axis:{range:[0,100], tickcolor:TC, tickfont:{color:TC,size:8}},
        bar:{color:gc},
        bgcolor:'rgba(255,255,255,0.04)',
        borderwidth:0,
        steps:[{range:[0,60],color:'rgba(248,113,113,0.12)'},{range:[60,80],color:'rgba(250,204,21,0.12)'},{range:[80,100],color:'rgba(74,222,128,0.12)'}],
      },
    }], {
      paper_bgcolor:'transparent', margin:{t:20,b:10,l:20,r:20}, height:140, width:140,
      font:{color:TC, family:"'Segoe UI',system-ui,sans-serif"},
    }, {responsive:false, displayModeBar:false, staticPlot:true});

    // ── Accuracy strip chart (TaskType별) ──
    {
      const atasks=(d.tasks||[]).filter(t=>t.accuracy_score>0);
      if(atasks.length){
        const typeOrder=[...new Set(atasks.map(t=>t.task_type))].sort();
        const byType={};
        atasks.forEach(t=>{(byType[t.task_type]=byType[t.task_type]||[]).push(t);});
        const jitter=(i,n)=>n>1?(i/(n-1)-0.5)*0.55:0;
        const traces=typeOrder.map(typ=>{
          const tl=byType[typ]||[];
          return{type:'scatter',mode:'markers',name:typ,
            x:tl.map(t=>+(t.accuracy_score*100).toFixed(1)),
            y:tl.map((t,i)=>typ+(tl.length>1?(jitter(i,tl.length)*0.7).toFixed(3):'')),
            text:tl.map(t=>`${t.task_id}<br>정확도: ${(t.accuracy_score*100).toFixed(1)}%<br>타입: ${t.task_type}<br>${t.success?'✅ 성공':'❌ 실패'}`),
            hovertemplate:'%{text}<extra></extra>',
            marker:{size:9,color:tl.map(t=>t.success?'#4ade80':'#f87171'),line:{color:'rgba(0,0,0,0.15)',width:1},opacity:0.85}};
        });
        const rowH=Math.max(44,Math.min(64,280/Math.max(typeOrder.length,1)));
        const chartH=Math.max(180,typeOrder.length*rowH+60);
        this._plt('acc-hist',traces,{
          xaxis:{...scX,range:[-2,102],title:{text:'정확도 %',font:{color:TC,size:10}},
                 tickvals:[0,20,40,60,80,100],ticktext:['0%','20%','40%','60%','80%','100%']},
          yaxis:{...scY,automargin:true,categoryorder:'array',categoryarray:typeOrder},
          showlegend:false,height:chartH,margin:{t:28,b:36,l:90,r:16},
          shapes:[{type:'line',x0:this.thresholds.acc,x1:this.thresholds.acc,yref:'paper',y0:0,y1:1,line:{color:'#facc15',dash:'dash',width:1.5}}],
          annotations:[{x:this.thresholds.acc,yref:'paper',y:1.02,text:`목표 ${this.thresholds.acc}%`,showarrow:false,font:{color:'#facc15',size:10},yanchor:'bottom'}]});
      }
    }

    // ── Accuracy weights ──
    const _awDesc=['문자 수준 편집 유사도 (SequenceMatcher)','최장 공통 부분 수열 비율 (LCS/max_len)','집합 교집합 ÷ 합집합 (Jaccard Index)','공통 토큰 F1 스코어 (Precision × Recall 조화평균)'];
    this._plt('acc-weights',[{
      type:'bar',orientation:'h',
      y:['Char Sim','LCS Ratio','Jaccard','Token Overlap'],
      x:[10,20,30,40],
      text:['10%','20%','30%','40%'],
      textposition:'inside',
      customdata:_awDesc,
      hovertemplate:'<b>%{y}</b> — 가중치 %{x}%<br><span style="color:#555555">%{customdata}</span><extra></extra>',
      marker:{color:['#6c8ef580','#6c8ef5a0','#6c8ef5c0','#6c8ef5']}
    }],{height:80,margin:{t:5,b:5,l:90,r:40},xaxis:{...scX,range:[0,50],showticklabels:false},yaxis:{...scY,automargin:true},...noLeg});

    // ── Quality radar ──
    const qd=d.quality_detail?.dimension_summary||{};
    if (Object.keys(qd).length) {
      const dims=Object.keys(qd), vals=Object.values(qd);
      this._plt('qual-radar', [{type:'scatterpolar', r:[...vals,vals[0]], theta:[...dims,dims[0]],
        fill:'toself', fillcolor:'#6c8ef530', line:{color:'#6c8ef5'}, marker:{color:'#6c8ef5'}}],
        {polar:{radialaxis:{range:[0,5],tickfont:{color:TC},gridcolor:GC},angularaxis:{tickfont:{color:TC}},bgcolor:'transparent'},
         paper_bgcolor:'transparent', ...noLeg, height:240, margin:{t:20,b:20,l:40,r:40}});
    }

    // ── Quality heatmap ──
    const dimSumm = d.quality_detail?.dimension_summary||{};
    const dims = Object.keys(dimSumm);
    if(dims.length>0){
      const typeMap={};
      (d.tasks||[]).forEach(t=>{
        if(!typeMap[t.task_type]) typeMap[t.task_type]={};
        dims.forEach(dim=>{
          if(!typeMap[t.task_type][dim]) typeMap[t.task_type][dim]=[];
        });
      });
      // Build per-type dimension averages from quality_detail evaluations
      // task_id → task_type 매핑 (evaluations에 task_type 필드 없음)
      const taskTypeMap={};
      (d.tasks||[]).forEach(t=>{taskTypeMap[t.task_id]=t.task_type;});
      const evals=d.quality_detail?.evaluations||[];
      evals.forEach(ev=>{
        const tp=taskTypeMap[ev.task_id]||ev.task_type||'Unknown';
        if(!typeMap[tp]) typeMap[tp]={};
        dims.forEach(dim=>{
          const val=(ev.dimension_scores!=null?ev.dimension_scores[dim]:undefined)??ev[dim];
          if(val!=null){
            if(!typeMap[tp][dim]) typeMap[tp][dim]=[];
            typeMap[tp][dim].push(+val);
          }
        });
      });
      const qualTypes=Object.keys(typeMap).filter(tp=>dims.some(dd=>typeMap[tp][dd]?.length>0));
      if(qualTypes.length>0){
        const z=qualTypes.map(tp=>dims.map(dim=>{
          const arr=typeMap[tp][dim]||[];
          return arr.length?+(arr.reduce((s,v)=>s+v,0)/arr.length).toFixed(2):null;
        }));
        const qHmH=Math.max(220,qualTypes.length*72+80);const qHmEl=document.getElementById('qual-heatmap');if(qHmEl)qHmEl.style.height=qHmH+'px';
        this._plt('qual-heatmap',[{type:'heatmap',z,x:dims,y:qualTypes,
          colorscale:[[0,'#f87171'],[0.5,'#facc15'],[1,'#4ade80']],
          zmin:0,zmax:5,text:z,texttemplate:'%{text:.2f}',showscale:true,
          colorbar:{tickfont:{color:TC},len:0.8}}],
          {height:qHmH,margin:{t:10,b:50,l:120,r:60},xaxis:{...scX,automargin:true},yaxis:{...scY,automargin:true}});
      } else {
        // Fallback: use dimension_summary global averages as single-row heatmap
        const vals=dims.map(dim=>+(dimSumm[dim]||0));
        this._plt('qual-heatmap',[{type:'bar',x:dims,y:vals,marker:{color:vals.map(v=>v>=8?'#4ade80':v>=6?'#facc15':'#f87171')}}],
          {xaxis:{...scX,automargin:true},yaxis:{...scY,range:[0,10]},...noLeg,margin:{t:10,b:60,l:40,r:10}});
      }
    }

    // ── RAG bar ──
    const rk=['faithfulness','answer_relevancy','context_recall','context_precision'];
    const rvs=rk.map(k=>{ const arr=d.advanced?.rag_metrics?.[k]||[]; return arr.length?arr.reduce((a,b)=>a+b,0)/arr.length:0; });
    const _ragOverall=d.advanced?.summary?.ragas_overall_score?.mean||0;
    const rkAll=_ragOverall>0?[...rk,'overall']:rk;
    const rvsAll=_ragOverall>0?[...rvs,_ragOverall]:rvs;
    if (rvsAll.some(v=>v>0)) {
      this._plt('rag-bar', [{type:'bar', x:rkAll.map(k=>k.replace(/_/g,'<br>')), y:rvsAll, hovertemplate:'%{x}: %{y:.3f}<extra></extra>', marker:{color:'#6c8ef580',line:{color:'#6c8ef5',width:1}}}],
        {xaxis:scX, yaxis:{...scY,range:[0,1]}, ...noLeg,
         shapes:[{type:'line',x0:-0.5,x1:rkAll.length-0.5,xref:'x',y0:0.8,y1:0.8,line:{color:'#4ade80',dash:'dot',width:1.5}}],
         annotations:[{x:rkAll.length-0.5,y:0.8,text:'목표 0.8',showarrow:false,font:{color:'#4ade80',size:9},xanchor:'right',yanchor:'bottom'}]});
    }

    // ── Tool efficiency bar ──
    const te=d.agentic?.tool_efficiency||{};
    if (te.total_calls) {
      this._plt('teff-bar', [{type:'bar',
        x:['성공률','효율성','중복률','실패률'],
        y:[te.success_rate,te.avg_efficiency_score,te.redundancy_rate,te.failure_rate].map(v=>v||0),
        marker:{color:['#4ade8080','#6c8ef580','#facc1580','#f8717180'], line:{color:['#4ade80','#6c8ef5','#facc15','#f87171'],width:1}}}],
        {xaxis:scX, yaxis:{...scY,ticksuffix:'%',range:[0,100]}, ...noLeg});
    }

    // ── Retry distribution ──
    const atmCnt={};
    (d.tasks||[]).forEach(t=>{ const a=t.attempts||1; atmCnt[a]=(atmCnt[a]||0)+1; });
    const atmKeys=Object.keys(atmCnt).map(Number).sort((a,b)=>a-b);
    this._plt('l2-retry-dist',[{type:'bar',x:atmKeys.map(k=>`${k}회`),y:atmKeys.map(k=>atmCnt[k]),
      marker:{color:atmKeys.map(k=>k===1?'#4ade80':k<=2?'#facc15':'#f87171')}}],
      {xaxis:{...scX},yaxis:{...scY,title:{text:'태스크 수',font:{color:TC,size:10}}},...noLeg});

    // ── Retry by task type ──
    const typeAtm={};
    (d.tasks||[]).forEach(t=>{
      if(!typeAtm[t.task_type]) typeAtm[t.task_type]=[];
      typeAtm[t.task_type].push(t.attempts||1);
    });
    const taTypes=Object.keys(typeAtm);
    const taAvg=taTypes.map(tp=>+(typeAtm[tp].reduce((s,v)=>s+v,0)/typeAtm[tp].length).toFixed(2));
    this._plt('l2-retry-type',[{type:'bar',orientation:'h',y:taTypes,x:taAvg,
      marker:{color:taAvg.map(v=>v<=1.2?'#4ade80':v<=1.5?'#facc15':'#f87171')}}],
      {xaxis:{...scX,title:{text:'평균 시도 횟수',font:{color:TC,size:10}}},yaxis:{...scY,automargin:true},...noLeg,margin:{t:10,b:30,l:120,r:16}});

    // ── Latency percentile bar ──
    const lat=d.efficiency_metrics?.latency||{};
    this._plt('lat-bar', [{type:'bar', x:['P50','P95','P99','Max'],
      y:[lat.p50,lat.p95,lat.p99,lat.max].map(v=>+(v||0).toFixed(3)),
      marker:{color:['#4ade8080','#facc1580','#f8717180','#f8717180'], line:{color:['#4ade80','#facc15','#f87171','#f87171'],width:1}}}],
      {xaxis:scX, yaxis:{...scY,ticksuffix:'s'}, ...noLeg});

    // ── 태스크별 응답시간 bar (per-task) ──
    const latTasks=(d.tasks||[]).filter(t=>t.execution_time>0);
    const lats=latTasks.map(t=>t.execution_time);
    if (latTasks.length) {
      const latIds=latTasks.map((t,i)=>t.task_id||'#'+(i+1));
      const latVals=latTasks.map(t=>+t.execution_time.toFixed(3));
      const thr=this.thresholds.p95;
      const latColors=latVals.map(v=>v<=thr?'#6c8ef580':'#f8717180');
      const latBorder=latVals.map(v=>v<=thr?'#6c8ef5':'#f87171');
      this._plt('lat-hist',[{
        type:'bar',x:latIds,y:latVals,
        marker:{color:latColors,line:{color:latBorder,width:1}},
        hovertemplate:'%{x}<br>%{y:.3f}s<extra></extra>'
      }],{
        xaxis:{...scX,tickangle:-45,automargin:true},
        yaxis:{...scY,ticksuffix:'s'},
        ...noLeg,
        margin:{t:10,b:80,l:50,r:10},
        shapes:[{type:'line',x0:-0.5,x1:latTasks.length-0.5,xref:'x',y0:thr,y1:thr,line:{color:'#facc15',dash:'dash',width:1.5}}],
        annotations:[{x:latTasks.length-1,y:thr,xref:'x',yref:'y',text:'P95 목표: '+thr+'s',showarrow:false,font:{color:'#facc15',size:10},xanchor:'right',yanchor:'bottom'}]
      });
    }

    // ── Latency box plot ──
    if (lats.length) {
      this._plt('lat-box', [{type:'box', y:lats, name:'Latency',
        marker:{color:'#6c8ef5'}, fillcolor:'#6c8ef520', line:{color:'#6c8ef5'},
        boxmean:'sd',
        hovertemplate:'%{y:.3f}s<extra></extra>'}],
        {yaxis:{...scY,ticksuffix:'s'}, ...noLeg,
         shapes:[{type:'line',x0:-0.5,x1:0.5,xref:'x',y0:this.thresholds.p95,y1:this.thresholds.p95,
           line:{color:'#facc15',dash:'dash',width:1.5}},
         ],
         annotations:[{x:0.5,y:this.thresholds.p95,xref:'x',yref:'y',text:`목표 P95: ${this.thresholds.p95}s`,
           showarrow:false,font:{color:'#facc15',size:10},xanchor:'left'}],
        });
    }
    // ── TaskType별 latency grouped box ──
    const typeMap={};
    (d.tasks||[]).forEach(t=>{ const k=t.task_type||'unknown'; (typeMap[k]=typeMap[k]||[]).push(t.execution_time||0); });
    if (Object.keys(typeMap).length>0) {
      const boxTraces = Object.entries(typeMap).map(([name,vals])=>({
        type:'box', y:vals, name, boxmean:true,
        hovertemplate:`${name}<br>%{y:.3f}s<extra></extra>`,
      }));
      this._plt('lat-type-box', boxTraces, {yaxis:{...scY,ticksuffix:'s'}, showlegend:false, margin:{t:10,b:50,l:46,r:10}});
    }

    // ── TaskType별 평균 레이턴시 bar (이전 scatter 대체) ──
    // accuracy_score가 개별 태스크에서 0인 경우가 많아 scatter 대신
    // TaskType별 평균·최대·최소 레이턴시를 bar+error bar로 표시
    const scPts = (d.tasks||[]).filter(t=>t.execution_time>0);
    if(scPts.length>0){
      const byType={};
      scPts.forEach(t=>{byType[t.task_type]=byType[t.task_type]||[];byType[t.task_type].push(t.execution_time);});
      const tpKeys=Object.keys(byType);
      const means=tpKeys.map(tp=>{const vs=byType[tp];return +(vs.reduce((s,v)=>s+v,0)/vs.length).toFixed(3);});
      const errHi=tpKeys.map((tp,i)=>+(Math.max(...byType[tp])-means[i]).toFixed(3));
      const errLo=tpKeys.map((tp,i)=>+(means[i]-Math.min(...byType[tp])).toFixed(3));
      const palette=['#6c8ef5','#4ade80','#facc15','#f87171','#a78bfa','#60a5fa','#fb923c','#34d399'];
      this._plt('perf-scatter',[{
        type:'bar', x:tpKeys, y:means, name:'평균 레이턴시',
        error_y:{type:'data',symmetric:false,array:errHi,arrayminus:errLo,color:TC,thickness:1.5,width:6},
        marker:{color:tpKeys.map((_,i)=>palette[i%palette.length]+'99'),
                line:{color:tpKeys.map((_,i)=>palette[i%palette.length]),width:1}},
        hovertemplate:'%{x}<br>평균: %{y:.2f}s<extra></extra>',
      }],{
        xaxis:{...scX,tickangle:-20,automargin:true},
        yaxis:{...scY,title:{text:'레이턴시 (s)',font:{color:TC,size:10}},tickformat:'.2f',ticksuffix:'s'},
        ...noLeg, margin:{t:10,b:40,l:60,r:16}, height:220
      });
    }

    // ── Token pie ──
    const tok=d.efficiency_metrics?.tokens||{};
    this._plt('tok-pie', [{type:'pie', hole:0.6,
      values:[tok.total_input_tokens||0, tok.total_output_tokens||0],
      labels:['Input','Output'],
      marker:{colors:['#6c8ef5','#4ade80']},
      textinfo:'none'}],
      {height:200, showlegend:true, legend:{font:{color:TC,size:10}}, margin:{t:10,b:10,l:10,r:10}});

    // ── Token histogram ──
    const tkLst=(d.tasks||[]).map(t=>((t.tokens_used?.total)||(t.tokens_used?.input||0)+(t.tokens_used?.output||0))).filter(v=>v>0);
    if (tkLst.length) {
      this._plt('tok-hist', [{type:'histogram', x:tkLst, nbinsx:8, marker:{color:'#6c8ef580',line:{color:'#6c8ef5',width:1}}}],
        {xaxis:scX, yaxis:scY, ...noLeg});
    }

    // ── Security radar ──
    const sl1=d.security_l1||{};
    const threatR=sl1.input_security?.threat_rate||0;
    const leakR=sl1.output_leakage?.leakage_rate||0;
    const vioR=sl1.authorization?.violation_rate||0;
    const escR=d.security_l2?.privilege_escalation?.escalation_rate||0;
    const atkR=d.security_l2?.attack_detection?.detection_rate||0;
    if (d.has_security) {
      const dims2=['입력위협','출력유출','권한위반','권한상승','공격탐지'];
      const vals2=[threatR,leakR,vioR,escR,atkR];
      this._plt('sec-radar', [{type:'scatterpolar', r:[...vals2,vals2[0]], theta:[...dims2,dims2[0]],
        fill:'toself', fillcolor:'#f8717130', line:{color:'#f87171'}, marker:{color:'#f87171'}}],
        {polar:{radialaxis:{range:[0,100],tickfont:{color:TC},gridcolor:GC},angularaxis:{tickfont:{color:TC}},bgcolor:'transparent'},
         paper_bgcolor:'transparent', ...noLeg, height:220, margin:{t:20,b:20,l:40,r:40}});
    }

    // ── Framework bar ──
    const fwDist=this.frameworkDist();
    if (fwDist.length) {
      this._plt('fw-bar', [{type:'bar', x:fwDist.map(f=>f.name||'unknown'), y:fwDist.map(f=>f.count),
        marker:{color:'#6c8ef580',line:{color:'#6c8ef5',width:1}}}],
        {xaxis:scX, yaxis:scY, ...noLeg});
    }

    // ── Correlation scatter ──
    const tasks2=d.tasks||[];
    if (tasks2.length>=3) {
      const pts=tasks2.filter(t=>t.execution_time>0&&t.accuracy_score>=0).map(t=>({x:t.execution_time, y:t.accuracy_score*100}));
      this._plt('corr-scatter', [{type:'scatter', mode:'markers',
        x:pts.map(p=>p.x), y:pts.map(p=>p.y),
        text:tasks2.filter(t=>t.execution_time>0&&t.accuracy_score>=0).map(t=>t.task_id),
        hovertemplate:'%{text}<br>Latency: %{x:.2f}s<br>Accuracy: %{y:.1f}%<extra></extra>',
        marker:{color:'#6c8ef560',line:{color:'#6c8ef5',width:1},size:8}}],
        {xaxis:{...scX,title:{text:'Latency (s)',font:{color:TC,size:10}}},
         yaxis:{...scY,title:{text:'Accuracy (%)',font:{color:TC,size:10}}},
         ...noLeg, height:220});
    }

    // ── DeepEval G-Eval histogram ──
    const gEvals=(d.advanced?.per_task||[]).map(t=>t.g_eval_score||t.metrics?.g_eval||0).filter(v=>v>0);
    if (gEvals.length) {
      this._plt('deepeval-hist', [{type:'histogram', x:gEvals, nbinsx:10, marker:{color:'#6c8ef580',line:{color:'#6c8ef5',width:1}}}],
        {xaxis:{...scX,title:{text:'G-Eval Score',font:{color:TC,size:10}}}, yaxis:scY, ...noLeg, height:220});
    }

    // ── Layer 3 charts (same data as layer1 deepeval/rag but for layer3 nav) ──
    if (gEvals.length) {
      this._plt('l3-geval-hist', [{type:'histogram', x:gEvals, nbinsx:10, marker:{color:'#6c8ef580',line:{color:'#6c8ef5',width:1}}}],
        {xaxis:{...scX,title:{text:'G-Eval Score',font:{color:TC,size:10}}}, yaxis:scY, ...noLeg, height:220});
    }
    if (rvsAll.some(v=>v>0)) {
      this._plt('l3-rag-bar', [{type:'bar', x:rkAll.map(k=>k.replace(/_/g,'<br>')), y:rvsAll, hovertemplate:'%{x}: %{y:.3f}<extra></extra>', marker:{color:'#6c8ef580',line:{color:'#6c8ef5',width:1}}}],
        {xaxis:scX, yaxis:{...scY,range:[0,1]}, ...noLeg,
         shapes:[{type:'line',x0:-0.5,x1:rkAll.length-0.5,xref:'x',y0:0.8,y1:0.8,line:{color:'#4ade80',dash:'dot',width:1.5}}],
         annotations:[{x:rkAll.length-0.5,y:0.8,text:'목표 0.8',showarrow:false,font:{color:'#4ade80',size:9},xanchor:'right',yanchor:'bottom'}]});
    }

    // ── Correlation Heatmap (Insights + Transparency) ──
    const cm = this.metricCorrMatrix();
    if (cm.labels.length) {
      const hmTrace = [{
        type:'heatmap', z:cm.z, x:cm.labels, y:cm.labels,
        colorscale:'RdBu', zmid:0, zmin:-1, zmax:1,
        text:cm.z.map(row=>row.map(v=>v.toFixed(2))),
        texttemplate:'%{text}', showscale:true,
        colorbar:{thickness:14, len:0.9, tickfont:{color:TC,size:9}, outlinecolor:GC},
        hovertemplate:'%{y} × %{x}: %{z:.3f}<extra></extra>',
      }];
      const hmLayout = {xaxis:{...scX,tickangle:-20,automargin:true}, yaxis:{...scY,automargin:true}, height:300, margin:{t:10,b:70,l:90,r:60}};
      this._plt('corr-heatmap',    hmTrace, hmLayout);
      this._plt('tr-corr-heatmap', hmTrace, hmLayout);
    }

    // ── Security Event Timeline ──
    const secEvts = this.secEventTimeline();
    if (secEvts.length) {
      const layerColors = {'L1 입력위협':'#f87171','L1 출력유출':'#fb923c','L2 고급위협':'#facc15'};
      const layers = Object.keys(layerColors);
      const timelineTraces = layers.map(layer=>{
        const pts = secEvts.filter(e=>e.layer===layer);
        if (!pts.length) return null;
        return {
          type:'scatter', mode:'markers', name:layer,
          x:pts.map(e=>e.idx), y:pts.map(e=>e.category),
          text:pts.map(e=>`[${e.layer}] ${e.taskId}<br>위협: ${e.category}<br>위험도: ${e.risk}`),
          hovertemplate:'%{text}<extra></extra>',
          marker:{color:layerColors[layer]||'#6c8ef5', size:pts.map(e=>e.risk*5+8), symbol:'circle', opacity:0.85, line:{color:'#ffffff40',width:1}},
        };
      }).filter(Boolean);
      if (timelineTraces.length) {
        const tlLayout = {
          xaxis:{...scX, title:{text:'이벤트 순서',font:{color:TC,size:10}}, automargin:true},
          yaxis:{...scY, automargin:true},
          showlegend:true, legend:{font:{color:TC,size:10},bgcolor:'transparent'},
          height:280, margin:{t:10,b:50,l:130,r:10}
        };
        this._plt('sec-timeline', timelineTraces, tlLayout);
        this._plt('sec-timeline-adv', timelineTraces, tlLayout);
      }
    }

    // ── Agent Network Graph ──
    const net = this.agentNetworkData();
    if (net.nodes.length>=2) {
      const maxCnt = Math.max(...net.edges.map(e=>e.count),1);
      const edgeTraces = net.edges.map(e=>{
        const alpha = 0.2 + 0.7*(e.count/maxCnt);
        const rate = e.count?e.success/e.count:0;
        const col = rate>=0.8?`rgba(74,222,128,${alpha})`:rate>=0.5?`rgba(250,204,21,${alpha})`:`rgba(248,113,113,${alpha})`;
        return {type:'scatter',mode:'lines',
          x:[e.fx,e.tx,null], y:[e.fy,e.ty,null],
          line:{color:col, width:1+3*(e.count/maxCnt)},
          hoverinfo:'skip', showlegend:false};
      });
      const nodeTrace = {
        type:'scatter', mode:'markers+text',
        x:net.nodes.map(n=>n.x), y:net.nodes.map(n=>n.y),
        text:net.nodes.map(n=>n.name),
        textposition:'top center',
        textfont:{color:TC,size:10},
        hovertext:net.nodes.map(n=>`${n.name}<br>연결수: ${n.degree}`),
        hovertemplate:'%{hovertext}<extra></extra>',
        marker:{color:'#6c8ef5', size:net.nodes.map(n=>14+n.degree*3), line:{color:'#ffffff80',width:2}},
        showlegend:false,
      };
      // Dynamic height: 260 + 12px per interaction (capped 380–560)
      const netH = Math.max(380, Math.min(560, (d.agentic?.agent_interactions?.length||0)*12+260));
      this._plt('agent-network', [...edgeTraces, nodeTrace], {
        xaxis:{visible:false, range:[-1.7,1.7]},
        yaxis:{visible:false, range:[-1.7,1.7]},
        paper_bgcolor:'transparent', plot_bgcolor:'transparent',
        dragmode:'pan',
        showlegend:false, height:netH, margin:{t:30,b:30,l:30,r:30},
      }, {
        responsive:true,
        scrollZoom:true,
        displayModeBar:true,
        displaylogo:false,
        modeBarButtonsToRemove:['select2d','lasso2d','toggleSpikelines','hoverClosestCartesian','hoverCompareCartesian'],
      });
    }

    // ── Workflow funnel (horizontal bar — step-level counts, not task-level) ──
    const wfSum=d.agentic?.workflow_summary||{};
    const totalTasks=d.total_tasks||0;
    const wfExecs=d.agentic?.workflow_executions||[];
    const wfTaskCount=wfSum.total_tasks||new Set(wfExecs.map(w=>w.task_id)).size||totalTasks;
    const totalSteps=wfExecs.length;
    const successSteps=wfExecs.filter(w=>w.success).length;
    const failSteps=totalSteps-successSteps;
    // Use task_success_rate if available (task-level), else approximate from step-level
    const wfSuccTasks=wfSum.fully_successful_tasks!=null
      ? wfSum.fully_successful_tasks
      : Math.round(wfTaskCount*((wfSum.task_success_rate||wfSum.step_success_rate||0)/100));
    const wfFailTasks=wfTaskCount-wfSuccTasks;
    if(totalSteps>0){
      // Use percentage of steps/tasks so bars are always comparable
      const stepsTotal=totalSteps||1;
      const tasksTotal=wfTaskCount||1;
      const funnelLabels=['태스크 수','단계 수','성공 단계','실패 단계','완료 태스크','미완료 태스크'];
      const funnelVals=[wfTaskCount, totalSteps, successSteps, failSteps, wfSuccTasks, wfFailTasks];
      const funnelText=funnelVals.map((v,i)=>{
        if(i===0) return `${v}개`;
        if(i===1) return `${v}개 (태스크당 ${totalSteps&&wfTaskCount?(totalSteps/wfTaskCount).toFixed(1):'-'}단계)`;
        if(i===2) return `${v}개 (${totalSteps?(v/totalSteps*100).toFixed(1):0}%)`;
        if(i===3) return `${v}개 (${totalSteps?(v/totalSteps*100).toFixed(1):0}%)`;
        if(i===4) return `${v}개 (${wfTaskCount?(v/wfTaskCount*100).toFixed(1):0}%)`;
        return `${v}개 (${wfTaskCount?(v/wfTaskCount*100).toFixed(1):0}%)`;
      });
      const funnelColors=['#6c8ef5','#818cf8','#4ade80','#f87171','#22c55e','#ef4444'];
      this._plt('l2-wf-funnel',[{type:'bar',orientation:'h',
        y:funnelLabels,x:funnelVals,text:funnelText,textposition:'inside',insidetextanchor:'middle',
        textfont:{color:'#fff',size:11},
        marker:{color:funnelColors}}],
        {margin:{t:6,b:24,l:120,r:10},
         xaxis:{...scX,automargin:true},
         yaxis:{...scY,automargin:true},
         bargap:0.25});
    }

    // ── Integrated Security radar (duplicate for intsec tab) ──
    if (d.has_security) {
      const dims3=['입력위협','출력유출','권한위반','권한상승','공격탐지'];
      const vals3=[threatR,leakR,vioR,escR,atkR];
      this._plt('intsec-radar', [{type:'scatterpolar', r:[...vals3,vals3[0]], theta:[...dims3,dims3[0]],
        fill:'toself', fillcolor:'#f8717130', line:{color:'#f87171'}, marker:{color:'#f87171'}}],
        {polar:{radialaxis:{range:[0,100],tickfont:{color:TC},gridcolor:GC},angularaxis:{tickfont:{color:TC}},bgcolor:'transparent'},
         paper_bgcolor:'transparent', ...noLeg, height:240, margin:{t:20,b:20,l:40,r:40}});
    }

    // ── New perspective-based charts ──
    this.renderRadar();
    this.renderAgRadar();
    this.renderQualityCharts();
  },

  renderTable() {
    const d = this.data; if (!d || !document.getElementById('task-table')) return;
    if (this._taskTable) { this._taskTable.destroy(); this._taskTable=null; }
    const f = this.taskFilter;
    let rows = d.tasks||[];
    if (f.type !== 'all') rows = rows.filter(t=>t.task_type===f.type);
    if (f.status === 'success') rows = rows.filter(t=>t.success);
    else if (f.status === 'fail') rows = rows.filter(t=>!t.success);
    if (f.sort === 'accuracy_score') rows = [...rows].sort((a,b)=>b.accuracy_score-a.accuracy_score);
    else if (f.sort === 'execution_time') rows = [...rows].sort((a,b)=>b.execution_time-a.execution_time);
    else if (f.sort === 'completion_score') rows = [...rows].sort((a,b)=>b.completion_score-a.completion_score);
    this.filteredTaskCount = rows.length;
    this._taskTable = new Tabulator('#task-table', {
      data: rows,
      layout: 'fitDataFill',
      height: '420px',
      rowClick: (e, row) => { this.taskDetail = row.getData(); },
      columns: [
        {title:'Task ID',     field:'task_id',         width:150},
        {title:'Type',        field:'task_type',        width:110},
        {title:'✓',           field:'success',          width:50, formatter:c=>c.getValue()?'✅':'❌'},
        {title:'Completion',  field:'completion_score', width:100, formatter:c=>(c.getValue()*100).toFixed(1)+'%'},
        {title:'Accuracy',    field:'accuracy_score',   width:90,  formatter:c=>(c.getValue()*100).toFixed(1)+'%'},
        {title:'Latency',     field:'execution_time',   width:85,  formatter:c=>c.getValue().toFixed(2)+'s'},
        {title:'Tokens',      field:'tokens_used',      width:70,  formatter:c=>(c.getValue()?.total||0)},
        {title:'Attempts',    field:'attempts',          width:70},
        {title:'Framework',   field:'framework',         width:100, formatter:c=>c.getValue()||'-'},
        {title:'Timestamp',   field:'timestamp',         minWidth:150, formatter:c=>(c.getValue()||'').substring(0,19)},
      ],
    });
  },

  applyTaskFilter() {
    this.renderTable();
  },

  taskTypes() {
    const types = new Set((this.data?.tasks||[]).map(t=>t.task_type).filter(Boolean));
    return [...types];
  },

  // ── Transparency ──────────────────────────────────────────────────────
  async loadTransparency(type) {
    if (type==='traces' && !this.trData.traces.length) {
      const r = await fetch('/api/transparency/traces');
      this.trData.traces = await r.json();
    }
    if (type==='annotations' && !this.trData.annotations.length) {
      const q = this.selId ? `?file_id=${encodeURIComponent(this.selId)}` : '';
      const r = await fetch(`/api/transparency/annotations${q}`);
      this.trData.annotations = await r.json();
    }
    if (type==='audit' && !this.trData.audit.length) {
      const r = await fetch('/api/transparency/audit');
      this.trData.audit = await r.json();
      // Load all audit files for listing
      const items = [];
      for (const a of this.trData.audit) {
        try {
          const rd = await fetch(`/api/transparency/audit/${a.stem}`);
          const detail = await rd.json();
          items.push({ ...a, ...detail });
        } catch(e) { items.push(a); }
      }
      this.trData.auditItems = items;
    }
  },

  async loadTrace(stem) {
    try {
      const r = await fetch(`/api/transparency/traces/${stem}`);
      const d = await r.json();
      this.trDetail = { ...this.trDetail, [stem]: d };
    } catch(e) {}
  },

  async loadAnnotation(stem) {
    try {
      const r = await fetch(`/api/transparency/annotations/${stem}`);
      const d = await r.json();
      this.annDetail = { ...this.annDetail, [stem]: d };
    } catch(e) {}
  },

  async saveAnnotation() {
    const f = this.annForm;
    if (!f.title.trim() || !f.content.trim()) { f.error = '제목과 내용을 입력하세요.'; return; }
    f.saving = true; f.error = '';
    try {
      const r = await fetch('/api/transparency/annotations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: f.title.trim(),
          content: f.content.trim(),
          annotation_type: f.annotation_type,
          priority: f.priority,
          author: f.author.trim() || 'dashboard',
          target_type: f.target_type,
          target_id: f.target_id.trim(),
          source_file_id: this.selId,
        }),
      });
      if (!r.ok) throw new Error(await r.text());
      const ann = await r.json();
      // 목록 갱신 및 새 항목 즉시 표시 (캐시 초기화 후 재로드)
      this.trData.annotations = [];
      await this.loadTransparency('annotations');
      this.annDetail = { ...this.annDetail, [ann.annotation_id]: ann };
      f.show = false;
      f.title = ''; f.content = ''; f.target_id = ''; f.author = '';
    } catch(e) { f.error = '저장 실패: ' + e.message; }
    finally { f.saving = false; }
  },

  async saveReply(stem) {
    const f = this.replyForm;
    if (!f.content.trim()) return;
    f.saving = true;
    try {
      const r = await fetch(`/api/transparency/annotations/${stem}/reply`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: f.content.trim(), author: f.author.trim() || 'dashboard' }),
      });
      if (!r.ok) throw new Error(await r.text());
      const updated = await r.json();
      this.annDetail = { ...this.annDetail, [stem]: updated };
      f.stem = null; f.content = ''; f.author = '';
    } catch(e) {}
    finally { f.saving = false; }
  },

  // ── Data helpers ───────────────────────────────────────────────────────
  tcr()  { return this.data?.accuracy_metrics?.tcr?.tcr || 0; },
  acc()  { return this.data?.accuracy_metrics?.accuracy_scores?.overall_accuracy || 0; },
  hall() { return this.data?.accuracy_metrics?.hallucination?.overall_rate || 0; },
  lat_mean() { return this.data?.efficiency_metrics?.latency?.mean || 0; },

  typeBreakdown() {
    const d = this.data; if (!d) return [];
    const suc={},tot={};
    (d.tasks||[]).forEach(t=>{
      tot[t.task_type]=(tot[t.task_type]||0)+1;
      if(t.success) suc[t.task_type]=(suc[t.task_type]||0)+1;
    });
    return Object.keys(tot).map(tp=>({ type:tp, n:tot[tp], rate:tot[tp]?(suc[tp]||0)/tot[tp]*100:0 }));
  },

  lowAccTasks() {
    const cutoff = this.thresholds.acc / 100;
    return (this.data?.tasks||[]).filter(t=>t.accuracy_score<cutoff && t.accuracy_score>0);
  },

  partialTasks() {
    return (this.data?.tasks||[])
      .filter(t => t.completion_score >= 0.7 && t.completion_score < 1.0)
      .sort((a,b) => a.completion_score - b.completion_score);
  },

  partialRetryCount() {
    return this.partialTasks().filter(t => (t.attempts||1) > 1).length;
  },

  failedTasks() {
    return (this.data?.tasks||[])
      .filter(t => t.completion_score < 0.7)
      .sort((a,b) => a.completion_score - b.completion_score);
  },

  failRetryCount() {
    return this.failedTasks().filter(t => (t.attempts||1) > 1).length;
  },

  // 부분 성공/실패 원인 추론 (단기 방안: 기존 필드 조합 + 장기 방안: partial_reason 필드)
  diagnosisMsg(t) {
    // 장기 방안: SDK가 채운 partial_reason 필드 우선
    if (t.partial_reason) return t.partial_reason;

    const hints = [];

    // 오류 있음
    if ((t.errors||[]).length > 0) {
      hints.push('오류 발생: ' + (t.errors||[]).map(e => typeof e==='string'?e:JSON.stringify(e)).join(' / '));
    }

    // 재시도 발생
    if ((t.attempts||1) > 1) {
      hints.push(`재시도 ${t.attempts}회 발생`);
    }

    // accuracy vs completion 괴리 → ground_truth 불일치 가능성
    if (t.accuracy_score > 0 && t.completion_score > 0) {
      const gap = t.completion_score - t.accuracy_score;
      if (gap > 0.15) {
        hints.push(`정확도(${(t.accuracy_score*100).toFixed(0)}%)가 완료도보다 낮음 — ground_truth 불일치 가능성`);
      }
    } else if (t.accuracy_score === 0 && t.completion_score > 0 && t.completion_score < 1.0) {
      hints.push('accuracy 측정 없음 (ground_truth 미설정)');
    }

    // completion_score가 정확히 0.7 또는 0.5 → calculate_completion_score 특정 분기
    if (t.completion_score === 0.7) hints.push('유사도 기반 산정 (0.5≤sim<0.8 구간)');
    if (t.completion_score === 0.5) hints.push('유사도 기반 산정 (sim<0.5 구간)');
    if (t.completion_score === 0.0 && (t.errors||[]).length === 0) hints.push('응답 없음 또는 완전 실패');

    if (hints.length === 0) {
      return 'completion_score 직접 지정 또는 원인 정보 없음 — partial_reason 필드를 설정하세요';
    }
    return hints.join(' · ');
  },

  ragAvg(key) {
    const arr = this.data?.advanced?.rag_metrics?.[key] || [];
    if (!arr.length) return '—';
    return (arr.reduce((a,b)=>a+b,0)/arr.length).toFixed(3);
  },

  // ── Health scoring ─────────────────────────────────────────────────────
  get l1s() {
    const d=this.data; if(!d) return 0;
    const tcr=d.accuracy_metrics?.tcr?.tcr||0;
    const acc=d.accuracy_metrics?.accuracy_scores?.overall_accuracy||0;
    const vals=[tcr,acc];
    if ((d.accuracy_metrics?.hallucination?.total_evaluated||0)>0)
      vals.push(Math.max(0,100-(d.accuracy_metrics.hallucination.overall_rate||0)*10));
    return vals.length?Math.round(vals.reduce((a,b)=>a+b,0)/vals.length):0;
  },
  get l2s() {
    const d=this.data; if(!d||!d.has_agentic) return 0;
    const toolAcc=d.agentic?.tool_selection_summary?.avg_f1_score||0;
    const coord=d.agentic?.coordination_summary?.success_rate||0;
    const wf=d.agentic?.workflow_summary?.step_success_rate||0;
    const teff=d.agentic?.tool_efficiency?.success_rate||0;
    const cnt=[toolAcc,coord,wf,teff].filter(v=>v>0);
    return cnt.length?Math.round(cnt.reduce((a,b)=>a+b,0)/cnt.length):0;
  },
  get ps() {
    const p95=this.data?.efficiency_metrics?.latency?.p95;
    if(p95==null||(p95===0&&!(this.data?.total_tasks))) return 0;
    if(p95===0) return 100;
    return Math.max(5,Math.round(100*Math.exp(-0.25*p95)));
  },
  get ss() {
    const d=this.data; if(!d||!d.has_security) return 0;
    const thr=100-(d.security_l1?.input_security?.threat_rate||0);
    const leak=100-(d.security_l1?.output_leakage?.leakage_rate||0);
    const auth=d.security_l1?.authorization?.compliance_rate||100;
    return Math.round((thr+leak+auth)/3);
  },
  get hs() {
    // 측정된 차원만 평균 — 미측정(0) 차원은 제외해 과소평가 방지
    const scores=[this.l1s,this.l2s,this.ps,this.ss];
    const measured=scores.filter(v=>v>0);
    return measured.length?Math.round(measured.reduce((a,b)=>a+b,0)/measured.length):0;
  },
  get hl() { const s=this.hs; return s>=90?'EXCELLENT':s>=80?'GOOD':s>=70?'FAIR':'NEEDS WORK'; },

  secScore(type) {
    const d=this.data;
    if (type==='input')  return Math.max(0,Math.round(100-(d?.security_l1?.input_security?.threat_rate||0)));
    if (type==='output') return Math.max(0,Math.round(100-(d?.security_l1?.output_leakage?.leakage_rate||0)));
    if (type==='auth')   return Math.round(d?.security_l1?.authorization?.compliance_rate||100);
    return 50;
  },

  // ── Per-perspective score (0-100) ─────────────────────────────────────
  perspScore(pid, d) {
    if (!d) return 0;
    if (pid === 'quality') {
      const tcr = d.accuracy_metrics?.tcr?.tcr || 0;
      const acc = d.accuracy_metrics?.accuracy_scores?.overall_accuracy || 0;
      const qual = (d.quality_detail?.avg_score || 0) * 20;
      const vals = [tcr, acc];
      if ((d.accuracy_metrics?.hallucination?.total_evaluated||0) > 0)
        vals.push(Math.max(0, 100 - (d.accuracy_metrics.hallucination.overall_rate||0) * 10));
      if (d.has_quality) vals.push(qual);
      return vals.length ? Math.round(vals.reduce((a,b)=>a+b,0)/vals.length) : 0;
    }
    if (pid === 'performance') {
      const latency = d.efficiency_metrics?.latency || {};
      const p95 = latency.p95;
      // 데이터 없음 → 0점
      if (p95 == null || (p95 === 0 && !d.total_tasks)) return 0;
      // p95=0 (서브ms) → 100점
      if (p95 === 0) return 100;
      // 지수 감쇠: p95=1s→78점, p95=2s→61점, p95=5s→29점 — 최저 5점 (절대 0이 되지 않음)
      return Math.max(5, Math.round(100 * Math.exp(-0.25 * p95)));
    }
    if (pid === 'agentic') {
      if (!d.has_agentic) return 0;
      const toolF1 = d.agentic?.tool_selection_summary?.avg_f1_score || 0;
      const coord  = d.agentic?.coordination_summary?.success_rate || 0;
      const wf     = d.agentic?.workflow_summary?.step_success_rate || 0;
      const teff   = d.agentic?.tool_efficiency?.success_rate || 0;
      const vals = [toolF1, coord, wf, teff].filter(v=>v>0);
      return vals.length ? Math.round(vals.reduce((a,b)=>a+b,0)/vals.length) : 0;
    }
    if (pid === 'security') {
      // 트래커 비활성화 시 0 (측정값 없음 = 알 수 없음)
      if (!d.has_security) return 0;
      return this.ss;
    }
    return 0;
  },

  perspScoreDesc(id) {
    const map = {
      quality:     '📊 품질 종합 점수 (0-100)\nTCR + 정확도 + 환각 역점수 + 응답품질의 평균\n높을수록 좋음',
      performance: '⚡ 성능 종합 점수 (0-100)\nP95 레이턴시 기반 지수 감쇠 공식\n1s≈78점 · 2s≈61점 · 5s≈29점 · 데이터 없음=0',
      agentic:     '🤖 에이전틱 종합 점수 (0-100)\nTool F1 + 멀티에이전트 성공률 + 워크플로 성공률 + Tool 효율 평균\n에이전틱 트래커 비활성화 시 0',
      security:    '🔒 보안 종합 점수 (0-100)\n입력 보안 + 출력 유출 + 권한 준수 점수의 가중 평균\n보안 트래커 비활성화 시 0',
      insights:    '💡 Insights 경보 건수\n임계값을 초과한 지표 수 (높을수록 주의 필요)',
    };
    return map[id] || '';
  },

  // ── Regression items (delta vs previous file) ────────────────────────
  regressionItems() {
    const d = this.data; if (!d) return [];
    const prev = this.prevFile(); if (!prev) return [];
    const items = [
      { key:'tcr',          label:'TCR',             curr:this.tcr(),                          prev:prev.tcr||0,           unit:'%', invert:false },
      { key:'accuracy',     label:'Accuracy',         curr:this.acc(),                          prev:prev.accuracy||0,      unit:'%', invert:false },
      { key:'hallucination',label:'Hallucination',    curr:this.hall(),                         prev:prev.hallucination||0, unit:'%', invert:true  },
      { key:'quality',      label:'Response Quality', curr:(d.quality_detail?.avg_score||0)*20, prev:prev.quality_avg||0,   unit:'%', invert:false },
    ];
    return items.map(it => {
      // negative delta = regression (curr worse than prev)
      const delta = it.invert ? it.prev - it.curr : it.curr - it.prev;
      if (delta >= -5) return null;
      const severity = delta < -15 ? 'critical' : 'high';
      return { ...it, delta: `(▼ ${Math.abs(delta).toFixed(1)}${it.unit})`, severity };
    }).filter(Boolean);
  },

  // ── Agentic capability radar data ─────────────────────────────────────
  agenticRadarData() {
    const d = this.data; if (!d || !d.has_agentic) return null;
    const dims = ['Tool 선택', 'Tool 효율', '멀티에이전트', '워크플로', '재시도 정확도'];
    const vals = [
      d.agentic?.tool_selection_summary?.avg_f1_score || 0,
      d.agentic?.tool_efficiency?.avg_efficiency_score || 0,
      d.agentic?.coordination_summary?.success_rate || 0,
      d.agentic?.workflow_summary?.step_success_rate || 0,
      Math.max(0, 100 - ((d.agentic?.retry_summary?.avg_attempts_per_task||1) - 1) * 30),
    ];
    return { dims, vals };
  },

  // ── Overview perspective radar ────────────────────────────────────────
  renderRadar() {
    const d = this.data; if (!d || !window.Plotly) return;
    const TC = this.dark ? '#8890b0' : '#5a6080';
    const GC = this.dark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.07)';
    const dims = ['품질','성능','에이전틱','보안'];
    const vals = dims.map((_,i)=>this.perspScore(['quality','performance','agentic','security'][i], d));
    this._plt('ov-radar', [{
      type:'scatterpolar', r:[...vals, vals[0]], theta:[...dims, dims[0]],
      fill:'toself', fillcolor:'#6c8ef530', line:{color:'#6c8ef5'}, marker:{color:'#6c8ef5'},
    }], {
      polar:{radialaxis:{range:[0,100],tickfont:{color:TC},gridcolor:GC},angularaxis:{tickfont:{color:TC}},bgcolor:'transparent'},
      paper_bgcolor:'transparent', showlegend:false, height:220, margin:{t:20,b:20,l:40,r:40},
    });
  },

  // ── Agentic capability radar ──────────────────────────────────────────
  renderAgRadar() {
    const d = this.data; if (!d || !window.Plotly) return;
    const rd = this.agenticRadarData(); if (!rd) return;
    const TC = this.dark ? '#8890b0' : '#5a6080';
    const GC = this.dark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.07)';
    const { dims, vals } = rd;
    this._plt('ag-radar', [{
      type:'scatterpolar', r:[...vals, vals[0]], theta:[...dims, dims[0]],
      fill:'toself', fillcolor:'#6c8ef530', line:{color:'#6c8ef5'}, marker:{color:'#6c8ef5'},
    }], {
      polar:{radialaxis:{range:[0,100],tickfont:{color:TC},gridcolor:GC},angularaxis:{tickfont:{color:TC}},bgcolor:'transparent'},
      paper_bgcolor:'transparent', showlegend:false, height:260, margin:{t:20,b:20,l:40,r:40},
    });
  },

  // ── q-prefixed chart rendering (quality section) ──────────────────────
  renderQualityCharts() {
    const d = this.data; if (!d || !window.Plotly) return;
    const TC = this.dark ? '#8890b0' : '#5a6080';
    const GC = this.dark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.07)';
    const scX = {tickfont:{color:TC},gridcolor:GC,zerolinecolor:GC};
    const scY = {tickfont:{color:TC},gridcolor:GC,zerolinecolor:GC};
    const noLeg = {showlegend:false};

    // q-l1-donut
    const tcr=d.accuracy_metrics?.tcr||{};
    const full=tcr.full_success||0,part=tcr.partial_success||0;
    const fail=tcr.failures||(d.total_tasks-(full+part));
    const donutT=[{type:'pie',hole:0.7,values:[full,part,fail],labels:['완전성공','부분성공','실패'],marker:{colors:['#4ade80','#facc15','#f87171']},textinfo:'none'}];
    const donutL={height:200,showlegend:true,legend:{font:{color:TC,size:10}},margin:{t:10,b:10,l:10,r:10}};
    this._plt('q-l1-donut', donutT, donutL);

    // q-l1-type
    const tSuc={},tTot={};
    (d.tasks||[]).forEach(t=>{tTot[t.task_type]=(tTot[t.task_type]||0)+1;if(t.success)tSuc[t.task_type]=(tSuc[t.task_type]||0)+1;});
    const types2=Object.keys(tTot), rates2=types2.map(tp=>tTot[tp]?(tSuc[tp]||0)/tTot[tp]*100:0);
    this._plt('q-l1-type',[{type:'bar',orientation:'h',y:types2,x:rates2,
      text:rates2.map(v=>v.toFixed(1)+'%'), textposition:'inside', insidetextanchor:'middle',
      textfont:{color:'#444',size:12,family:'system-ui'},
      marker:{color:rates2.map(v=>v>=90?'#4ade8080':v>=70?'#facc1580':'#f8717180'),line:{color:rates2.map(v=>v>=90?'#4ade80':v>=70?'#facc15':'#f87171'),width:1}}}],
      {xaxis:{...scX,range:[0,100],showticklabels:false,showgrid:false,zeroline:false},
       yaxis:{...scY,automargin:true},...noLeg,margin:{t:10,b:10,l:100,r:10}});

    // q-l1-fail-reason
    const errT={};
    (d.tasks||[]).filter(t=>!t.success).forEach(t=>{
      (t.errors||[]).forEach(e=>{const et=(typeof e==='string'?e:(e.type||e.error_type||String(e))).split(':')[0].trim().substring(0,20)||'Unknown';errT[et]=(errT[et]||0)+1;});
      if(!(t.errors||[]).length)errT['Unknown']=(errT['Unknown']||0)+1;
    });
    if(Object.keys(errT).length>0)this._plt('q-l1-fail-reason',[{type:'pie',values:Object.values(errT),labels:Object.keys(errT),
      marker:{colors:['#f87171','#fb923c','#facc15','#a78bfa','#60a5fa']},
      textinfo:'percent',textfont:{color:'#fff',size:12},
      domain:{x:[0.15,0.5]},
      hovertemplate:'%{label}<br>%{value}건 (%{percent})<extra></extra>'}],
      {height:240,showlegend:true,
       legend:{font:{color:TC,size:12},orientation:'v',x:0.55,xanchor:'left',y:0.5,yanchor:'middle'},
       margin:{t:10,b:10,l:10,r:10}});

    // q-acc-weights
    const _qawDesc=['문자 수준 편집 유사도 (SequenceMatcher)','최장 공통 부분 수열 비율 (LCS/max_len)','집합 교집합 ÷ 합집합 (Jaccard Index)','공통 토큰 F1 스코어 (Precision × Recall 조화평균)'];
    this._plt('q-acc-weights',[{type:'bar',orientation:'h',y:['Char Sim','LCS Ratio','Jaccard','Token Overlap'],x:[10,20,30,40],text:['10%','20%','30%','40%'],textposition:'inside',customdata:_qawDesc,hovertemplate:'<b>%{y}</b> — 가중치 %{x}%<br><span style="color:#555555">%{customdata}</span><extra></extra>',marker:{color:['#6c8ef580','#6c8ef5a0','#6c8ef5c0','#6c8ef5']}}],{height:80,margin:{t:5,b:5,l:90,r:40},xaxis:{...scX,range:[0,50],showticklabels:false},yaxis:{...scY,automargin:true},...noLeg});

    // q-acc-hist — strip chart (TaskType별 정확도 분포)
    {
      const qatasks=(d.tasks||[]).filter(t=>t.accuracy_score>0);
      if(qatasks.length){
        const qtypeOrder=[...new Set(qatasks.map(t=>t.task_type))].sort();
        const qbyType={};
        qatasks.forEach(t=>{(qbyType[t.task_type]=qbyType[t.task_type]||[]).push(t);});
        const qjitter=(i,n)=>n>1?(i/(n-1)-0.5)*0.55:0;
        const qtraces=qtypeOrder.map(typ=>{
          const tl=qbyType[typ]||[];
          return{type:'scatter',mode:'markers',name:typ,
            x:tl.map(t=>+(t.accuracy_score*100).toFixed(1)),
            y:tl.map((t,i)=>typ+(tl.length>1?(qjitter(i,tl.length)*0.7).toFixed(3):'')),
            text:tl.map(t=>`${t.task_id}<br>정확도: ${(t.accuracy_score*100).toFixed(1)}%<br>타입: ${t.task_type}<br>${t.success?'✅ 성공':'❌ 실패'}`),
            hovertemplate:'%{text}<extra></extra>',
            marker:{size:9,color:tl.map(t=>t.success?'#4ade80':'#f87171'),line:{color:'rgba(0,0,0,0.15)',width:1},opacity:0.85}};
        });
        const qrowH=Math.max(44,Math.min(64,280/Math.max(qtypeOrder.length,1)));
        const qchartH=Math.max(180,qtypeOrder.length*qrowH+60);
        this._plt('q-acc-hist',qtraces,{
          xaxis:{...scX,range:[-2,102],title:{text:'정확도 %',font:{color:TC,size:10}},
                 tickvals:[0,20,40,60,80,100],ticktext:['0%','20%','40%','60%','80%','100%']},
          yaxis:{...scY,automargin:true,categoryorder:'array',categoryarray:qtypeOrder},
          showlegend:false,height:qchartH,margin:{t:28,b:36,l:90,r:16},
          shapes:[{type:'line',x0:this.thresholds.acc,x1:this.thresholds.acc,yref:'paper',y0:0,y1:1,line:{color:'#facc15',dash:'dash',width:1.5}}],
          annotations:[{x:this.thresholds.acc,yref:'paper',y:1.02,text:`목표 ${this.thresholds.acc}%`,showarrow:false,font:{color:'#facc15',size:10},yanchor:'bottom'}]});
      }
    }

    // q-qual-radar
    const qd2=d.quality_detail?.dimension_summary||{};
    if(Object.keys(qd2).length){
      const dims3=Object.keys(qd2),vals3=Object.values(qd2);
      this._plt('q-qual-radar',[{type:'scatterpolar',r:[...vals3,vals3[0]],theta:[...dims3,dims3[0]],fill:'toself',fillcolor:'#6c8ef530',line:{color:'#6c8ef5'},marker:{color:'#6c8ef5'}}],{polar:{radialaxis:{range:[0,5],tickfont:{color:TC},gridcolor:GC},angularaxis:{tickfont:{color:TC}},bgcolor:'transparent'},paper_bgcolor:'transparent',...noLeg,height:240,margin:{t:20,b:20,l:40,r:40}});
    }

    // q-qual-heatmap
    const dimSumm2=d.quality_detail?.dimension_summary||{};
    const dims4=Object.keys(dimSumm2);
    if(dims4.length>0){
      // task_id → task_type 매핑
      const taskTypeMap2={};
      (d.tasks||[]).forEach(t=>{taskTypeMap2[t.task_id]=t.task_type;});
      const typeMap2={};
      (d.tasks||[]).forEach(t=>{if(!typeMap2[t.task_type])typeMap2[t.task_type]={};dims4.forEach(dim=>{if(!typeMap2[t.task_type][dim])typeMap2[t.task_type][dim]=[];});});
      const evals2=d.quality_detail?.evaluations||[];
      evals2.forEach(ev=>{
        const tp=taskTypeMap2[ev.task_id]||ev.task_type||'Unknown';
        if(!typeMap2[tp])typeMap2[tp]={};
        dims4.forEach(dim=>{
          const val=(ev.dimension_scores!=null?ev.dimension_scores[dim]:undefined)??ev[dim];
          if(val!=null){if(!typeMap2[tp][dim])typeMap2[tp][dim]=[];typeMap2[tp][dim].push(+val);}
        });
      });
      const qTypes=Object.keys(typeMap2).filter(tp=>dims4.some(dd=>typeMap2[tp][dd]?.length>0));
      if(qTypes.length>0){
        const z2=qTypes.map(tp=>dims4.map(dim=>{const arr=typeMap2[tp][dim]||[];return arr.length?+(arr.reduce((s,v)=>s+v,0)/arr.length).toFixed(2):null;}));
        const qHmH2=Math.max(220,qTypes.length*72+80);const qHmEl2=document.getElementById('q-qual-heatmap');if(qHmEl2)qHmEl2.style.height=qHmH2+'px';
        this._plt('q-qual-heatmap',[{type:'heatmap',z:z2,x:dims4,y:qTypes,colorscale:[[0,'#f87171'],[0.5,'#facc15'],[1,'#4ade80']],zmin:0,zmax:5,text:z2,texttemplate:'%{text:.2f}',showscale:true}],{height:qHmH2,margin:{t:10,b:50,l:120,r:60},xaxis:{...scX,automargin:true},yaxis:{...scY,automargin:true}});
      }
    }

    // q-rag-bar (심화 탭)
    const rk2=['faithfulness','answer_relevancy','context_recall','context_precision'];
    const rv2=rk2.map(k=>{const arr=d.advanced?.rag_metrics?.[k]||[];return arr.length?arr.reduce((a,b)=>a+b,0)/arr.length:0;});
    const _ragOverall2=d.advanced?.summary?.ragas_overall_score?.mean||0;
    const rkAll2=_ragOverall2>0?[...rk2,'overall']:rk2;
    const rvsAll2=_ragOverall2>0?[...rv2,_ragOverall2]:rv2;
    const ragBarCfg=[{type:'bar',x:rkAll2.map(k=>k.replace(/_/g,'<br>')),y:rvsAll2,hovertemplate:'%{x}: %{y:.3f}<extra></extra>',marker:{color:'#6c8ef580',line:{color:'#6c8ef5',width:1}}}];
    const ragBarLayout={xaxis:scX,yaxis:{...scY,range:[0,1]},...noLeg,shapes:[{type:'line',x0:-0.5,x1:rkAll2.length-0.5,xref:'x',y0:0.8,y1:0.8,line:{color:'#4ade80',dash:'dot',width:1.5}}],annotations:[{x:rkAll2.length-0.5,y:0.8,text:'목표 0.8',showarrow:false,font:{color:'#4ade80',size:9},xanchor:'right',yanchor:'bottom'}]};
    if(rvsAll2.some(v=>v>0)){this._plt('q-rag-bar',ragBarCfg,ragBarLayout);}

    // q-deepeval-bar (통합 탭)
    const deKeys=['g_eval_score','hallucination_score','toxicity_score','bias_score','answer_relevancy_score'];
    const deLabels={'g_eval_score':'G-Eval','hallucination_score':'Hallucination','toxicity_score':'Toxicity','bias_score':'Bias','answer_relevancy_score':'Ans.Relevancy'};
    const deVals=deKeys.map(k=>(d.advanced?.summary?.[k]?.mean??0));
    if(deVals.some(v=>v>0)){
      this._plt('q-deepeval-bar',[{type:'bar',x:deKeys.map(k=>deLabels[k]),y:deVals,hovertemplate:'%{x}: %{y:.3f}<extra></extra>',marker:{color:'#a78bfa80',line:{color:'#a78bfa',width:1}}}],
        {xaxis:scX,yaxis:{...scY,range:[0,1]},...noLeg,shapes:[{type:'line',x0:-0.5,x1:deKeys.length-0.5,xref:'x',y0:0.8,y1:0.8,line:{color:'#4ade80',dash:'dot',width:1.5}}],annotations:[{x:deKeys.length-0.5,y:0.8,text:'목표 0.8',showarrow:false,font:{color:'#4ade80',size:9},xanchor:'right',yanchor:'bottom'}]});
    }

    // q-deepeval-hist → 태스크별 G-Eval 수평 바 차트
    const gEvalTasks=(d.advanced?.per_task||[]).filter(t=>t.g_eval_score!=null);
    if(gEvalTasks.length){
      const gIds=gEvalTasks.map(t=>t.task_id||'—');
      const gVals=gEvalTasks.map(t=>+(t.g_eval_score));
      const gColors=gVals.map(v=>v>=0.8?'#4ade8099':v>=0.5?'#facc1599':'#f8717199');
      const gBorders=gVals.map(v=>v>=0.8?'#4ade80':v>=0.5?'#facc15':'#f87171');
      const chartH=Math.max(180,gIds.length*28+50);
      this._plt('q-deepeval-hist',[{
        type:'bar',x:gIds,y:gVals,
        hovertemplate:'%{x}: %{y:.3f}<extra></extra>',
        marker:{color:gColors,line:{color:gBorders,width:1}}
      }],{
        xaxis:{...scX,tickangle:-30,automargin:true,tickfont:{size:10}},
        yaxis:{...scY,range:[0,1],title:{text:'G-Eval Score',font:{color:TC,size:10}}},
        ...noLeg,height:220,
        shapes:[{type:'line',x0:-0.5,x1:gIds.length-0.5,xref:'x',y0:0.8,y1:0.8,line:{color:'#4ade80',dash:'dot',width:1.5}}],
        annotations:[{x:gIds.length-0.5,y:0.8,text:'목표 0.8',showarrow:false,font:{color:'#4ade80',size:9},xanchor:'right',yanchor:'bottom'}]
      });
    }
  },

  // Anomaly detection (rule-based)
  autoAnomalies() {
    const d=this.data; if(!d) return [];
    const a=[];
    const tTCR=this.thresholds.tcr, tACC=this.thresholds.acc, tHALL=this.thresholds.hall, tP95=this.thresholds.p95;
    if (this.tcr()<tTCR*0.78) a.push({sev:'critical', title:'TCR 위험 수준', desc:`TCR ${this.pct(this.tcr())} (목표 ≥${tTCR}%). 즉시 실패 태스크 원인 분석 필요.`});
    else if (this.tcr()<tTCR) a.push({sev:'medium', title:'TCR 목표 미달', desc:`TCR ${this.pct(this.tcr())} (목표 ≥${tTCR}%).`});
    if (this.acc()<tACC*0.71) a.push({sev:'critical', title:'Accuracy 매우 낮음', desc:`Accuracy ${this.pct(this.acc())} — 응답 검증 로직 점검 필요.`});
    if (this.hall()>tHALL*3) a.push({sev:'critical', title:'환각 발생률 위험', desc:`${this.pct(this.hall())} (허용 ≤${tHALL}%). RAG 파이프라인 검증 필요.`});
    else if (this.hall()>tHALL) a.push({sev:'medium', title:'환각 발생률 주의', desc:`${this.pct(this.hall())} (허용 ≤${tHALL}%).`});
    const p95=d.efficiency_metrics?.latency?.p95||0;
    if (p95>tP95*2.5) a.push({sev:'high', title:'P95 Latency 심각', desc:`${p95.toFixed(2)}s (목표 ≤${tP95}s). 모델 경량화 또는 캐싱 검토.`});
    else if (p95>tP95) a.push({sev:'medium', title:'P95 Latency 초과', desc:`${p95.toFixed(2)}s (목표 ≤${tP95}s).`});
    const txR=d.security_l1?.input_security?.threat_rate||0;
    if (txR>20) a.push({sev:'high', title:'입력 위협률 높음', desc:`${txR.toFixed(1)}% 입력에서 보안 위협 탐지.`});
    const lkR=d.security_l1?.output_leakage?.leakage_rate||0;
    if (lkR>0) a.push({sev:'critical', title:'민감 정보 유출 탐지', desc:`출력에서 ${lkR.toFixed(1)}% 유출률 — 즉시 확인 필요.`});
    return a;
  },

  metricStatus() {
    const d=this.data; if(!d) return [];
    const tTCR=this.thresholds.tcr, tACC=this.thresholds.acc, tHALL=this.thresholds.hall, tP95=this.thresholds.p95;
    return [
      { name:'TCR',           value:this.pct(this.tcr()),  cls:this.tcr()>=tTCR?'pg':this.tcr()>=(tTCR*0.78)?'py':'pr', status:this.tcr()>=tTCR?'✅ 목표달성':'⚠️ 개선필요' },
      { name:'Accuracy',      value:this.pct(this.acc()),  cls:this.acc()>=tACC?'pg':'pr', status:this.acc()>=tACC?'✅':'❌' },
      { name:'Hallucination', value:this.pct(this.hall()), cls:this.hall()<=tHALL?'pg':this.hall()<=tHALL*3?'py':'pr', status:this.hall()<=tHALL?'✅ SAFE':this.hall()<=tHALL*3?'⚠️ WARNING':'🚨 DANGER' },
      { name:'P95 Latency',   value:this.sec_(d.efficiency_metrics?.latency?.p95), cls:this.ps>=80?'pg':this.ps>=60?'py':'pr', status:(d.efficiency_metrics?.latency?.p95||0)<=tP95?'✅':'⚠️' },
    ];
  },

  // ── Benchmark grade ────────────────────────────────────────────────────
  benchGrade(tcr) {
    // Grade thresholds derived from thresholds.tcr: A=+5, B=target, C=-10, D=-25
    const t = this.thresholds.tcr;
    if (tcr >= Math.min(100, t + 5))  return { letter:'A', label:'Excellent' };
    if (tcr >= t)                      return { letter:'B', label:'Good' };
    if (tcr >= Math.max(30,  t - 10)) return { letter:'C', label:'Fair' };
    if (tcr >= Math.max(10,  t - 25)) return { letter:'D', label:'Poor' };
    return { letter:'F', label:'Fail' };
  },

  // ── Framework distribution ─────────────────────────────────────────────
  frameworkDist() {
    const tasks = this.data?.tasks||[];
    const cnt={}, suc={};
    tasks.forEach(t=>{
      const fw = t.framework||'unknown';
      cnt[fw]=(cnt[fw]||0)+1;
      if (t.success) suc[fw]=(suc[fw]||0)+1;
    });
    return Object.entries(cnt).map(([name,count])=>({ name, count, rate:count?(suc[name]||0)/count*100:0 })).sort((a,b)=>b.count-a.count);
  },

  // ── Statistical anomaly detection (Z-score) ───────────────────────────
  statAnomalies() {
    const tasks = this.data?.tasks||[];
    if (tasks.length < 3) return [];
    const results = [];
    const fields = [
      { key:'accuracy_score', label:'Accuracy', scale:100 },
      { key:'execution_time', label:'Latency', scale:1 },
    ];
    fields.forEach(({key,label,scale})=>{
      const vals = tasks.map(t=>+(t[key]||0)*scale).filter(v=>v>0);
      if (vals.length<3) return;
      const mean = vals.reduce((a,b)=>a+b,0)/vals.length;
      const std  = Math.sqrt(vals.map(v=>(v-mean)**2).reduce((a,b)=>a+b,0)/vals.length);
      if (std===0) return;
      tasks.forEach(t=>{
        const v = +(t[key]||0)*scale;
        if (v<=0) return;
        const z = Math.abs((v-mean)/std);
        if (z>=2.0) {
          const dir = v>mean?'높음':'낮음';
          results.push({ sev:z>=3?'high':'medium', title:`[${label}] 이상치: ${t.task_id}`, desc:`Z-score ${z.toFixed(2)} — 값 ${v.toFixed(2)}, 평균 ${mean.toFixed(2)} (${dir})` });
        }
      });
    });
    return results.slice(0,10);
  },

  // ── Metric correlation (Pearson) ───────────────────────────────────────
  metricCorr() {
    const tasks = this.data?.tasks||[];
    if (tasks.length < 3) return [];
    function pearson(xs, ys) {
      const n=xs.length; if(!n) return 0;
      const mx=xs.reduce((a,b)=>a+b,0)/n, my=ys.reduce((a,b)=>a+b,0)/n;
      const num=xs.reduce((s,x,i)=>s+(x-mx)*(ys[i]-my),0);
      const dx=Math.sqrt(xs.reduce((s,x)=>s+(x-mx)**2,0));
      const dy=Math.sqrt(ys.reduce((s,y)=>s+(y-my)**2,0));
      return (dx&&dy)?num/(dx*dy):0;
    }
    const acc   = tasks.map(t=>t.accuracy_score*100);
    const lat   = tasks.map(t=>t.execution_time||0);
    const tok   = tasks.map(t=>((t.tokens_used?.total)||(t.tokens_used?.input||0)+(t.tokens_used?.output||0)));
    const comp  = tasks.map(t=>t.completion_score*100);
    return [
      { label:'Accuracy ↔ Latency',    r:pearson(acc,lat)  },
      { label:'Accuracy ↔ Tokens',     r:pearson(acc,tok)  },
      { label:'Accuracy ↔ Completion', r:pearson(acc,comp) },
      { label:'Latency ↔ Tokens',      r:pearson(lat,tok)  },
    ];
  },

  // ── Correlation matrix (4×4 for heatmap) ─────────────────────────────
  metricCorrMatrix() {
    const tasks = this.data?.tasks||[];
    if (tasks.length < 3) return {labels:[], z:[]};
    function pearson(xs, ys) {
      const n=xs.length; if(!n) return 0;
      const mx=xs.reduce((a,b)=>a+b,0)/n, my=ys.reduce((a,b)=>a+b,0)/n;
      const num=xs.reduce((s,x,i)=>s+(x-mx)*(ys[i]-my),0);
      const dx=Math.sqrt(xs.reduce((s,x)=>s+(x-mx)**2,0));
      const dy=Math.sqrt(ys.reduce((s,y)=>s+(y-my)**2,0));
      return (dx&&dy)?+(num/(dx*dy)).toFixed(3):0;
    }
    const labels = ['정확도','지연시간','토큰수','완료율'];
    const vecs = [
      tasks.map(t=>t.accuracy_score*100),
      tasks.map(t=>t.execution_time||0),
      tasks.map(t=>((t.tokens_used?.total)||(t.tokens_used?.input||0)+(t.tokens_used?.output||0))),
      tasks.map(t=>t.completion_score*100),
    ];
    const z = vecs.map(a=>vecs.map(b=>pearson(a,b)));
    return {labels, z};
  },

  // ── Security Event Timeline ────────────────────────────────────────────
  secEventTimeline() {
    const d = this.data; if (!d) return [];
    const evts = [];
    let idx = 0;
    // L1 input threats
    for (const e of (d.security_l1?.input_evals||[])) {
      const cats = [];
      if (e.has_sql_injection)       cats.push('SQL Injection');
      if (e.has_prompt_injection)    cats.push('Prompt Injection');
      if (e.has_xss)                 cats.push('XSS');
      if (e.has_command_injection)   cats.push('Command Injection');
      if (e.has_path_traversal)      cats.push('Path Traversal');
      const risk = e.risk_level==='critical'?3:e.risk_level==='high'?2:1;
      for (const cat of cats) {
        evts.push({idx:idx++, taskId:e.task_id||'?', category:cat, layer:'L1 입력위협', risk});
      }
    }
    // L1 output leakage
    for (const e of (d.security_l1?.output_detections||[])) {
      if (!(e.leakage_count > 0)) continue;
      const cats = [];
      if (e.contains_api_key)   cats.push('API Key');
      if (e.contains_password)  cats.push('Password');
      if (e.contains_email)     cats.push('Email');
      if (e.contains_phone)     cats.push('Phone');
      if (!cats.length)         cats.push('Leakage');
      for (const cat of cats) {
        evts.push({idx:idx++, taskId:e.task_id||'?', category:cat, layer:'L1 출력유출', risk:2});
      }
    }
    // L2 escalation events
    for (const e of (d.security_l2?.escalation_events||[])) {
      evts.push({idx:idx++, taskId:e.task_id||'?', category:'Privilege Escalation', layer:'L2 고급위협', risk:3});
    }
    // L2 attack detections
    for (const e of (d.security_l2?.attack_detections||[])) {
      evts.push({idx:idx++, taskId:e.task_id||'?', category:e.attack_type||'Attack Chain', layer:'L2 고급위협', risk:3});
    }
    return evts;
  },

  // ── Agent Network Graph ────────────────────────────────────────────────
  agentNetworkData() {
    const d = this.data; if (!d) return {nodes:[], edges:[]};
    const interactions = d.agentic?.agent_interactions||[];
    if (interactions.length < 2) return {nodes:[], edges:[]};
    const nodeSet = new Set();
    const edgeMap = {};
    for (const intr of interactions) {
      const fa = intr.from_agent||'?', ta = intr.to_agent||'?';
      nodeSet.add(fa); nodeSet.add(ta);
      const key = `${fa}→${ta}`;
      if (!edgeMap[key]) edgeMap[key] = {from:fa, to:ta, count:0, success:0};
      edgeMap[key].count++;
      if (intr.success) edgeMap[key].success++;
    }
    const names = [...nodeSet];
    const n = names.length;
    const pos = {};
    names.forEach((name,i)=>{
      const a = (2*Math.PI*i/n) - Math.PI/2;
      pos[name] = {x:+Math.cos(a).toFixed(4), y:+Math.sin(a).toFixed(4)};
    });
    // Degree = total interactions per node
    const degree = {};
    names.forEach(name=>{ degree[name]=0; });
    Object.values(edgeMap).forEach(e=>{ degree[e.from]+=e.count; degree[e.to]+=e.count; });
    const nodes = names.map(name=>({name, ...pos[name], degree:degree[name]||0}));
    const edges = Object.values(edgeMap).map(e=>({
      ...e,
      fx:pos[e.from]?.x||0, fy:pos[e.from]?.y||0,
      tx:pos[e.to]?.x||0,   ty:pos[e.to]?.y||0,
    }));
    return {nodes, edges};
  },

  // ── Data quality score ─────────────────────────────────────────────────
  dataQuality() {
    const tasks = this.data?.tasks||[];
    if (!tasks.length) return { overall:0, fields:[] };
    const checks = [
      { name:'TASK_ID',        required:true,  fn:t=>!!t.task_id,
        desc:'태스크 고유 식별자. 누락 시 결과 추적·중복 제거 불가.' },
      { name:'TASK_TYPE',      required:true,  fn:t=>!!t.task_type,
        desc:'태스크 유형(qa·code·tool_use 등). 유형별 정확도 분석에 필수.' },
      { name:'ACCURACY_SCORE', required:true,  fn:t=>t.accuracy_score!=null&&t.accuracy_score>=0,
        desc:'LCS·Token Overlap·Jaccard 가중 평균 정확도(0–1). 품질 비교의 핵심 지표.' },
      { name:'EXECUTION_TIME', required:true,  fn:t=>t.execution_time!=null&&t.execution_time>0,
        desc:'태스크 실행 소요 시간(초). 지연 시간 분석·SLA 측정에 필수.' },
      { name:'TIMESTAMP',      required:true,  fn:t=>!!t.timestamp,
        desc:'태스크 실행 시각. 시계열 분석·버전 간 성능 추이 비교에 활용.' },
      { name:'TOKENS_USED',    required:false, fn:t=>!!(t.tokens_used?.total),
        desc:'입력·출력 토큰 수. 비용 추정·Token Economy 분석에 필요. 미기록 시 비용 계산 불가.' },
      { name:'FRAMEWORK',      required:false, fn:t=>!!t.framework,
        desc:'에이전트 프레임워크(LangChain, CrewAI 등). "native"는 직접 실행을 의미. 프레임워크별 성능 비교 시 활용.' },
      { name:'EXPECTED_TOOLS', required:false, fn:t=>!!(t.expected_tools?.length),
        desc:'기대 도구 목록. Tool Selection F1 계산에 필수. 도구 선택 평가가 없는 태스크는 해당 없음.' },
    ];
    const fields = checks.map(c=>{
      const filled = tasks.filter(c.fn).length;
      return { name:c.name, filled, total:tasks.length, pct:filled/tasks.length*100, required:c.required, desc:c.desc };
    });
    // overall = required fields only (optional fields don't penalise completeness)
    const req = fields.filter(f=>f.required);
    const overall = req.reduce((s,f)=>s+f.pct,0)/req.length;
    return { overall, fields };
  },

  // ── Multi-file comparison ──────────────────────────────────────────────
  toggleCompare(id) {
    if (this.compareIds.includes(id)) {
      this.compareIds = this.compareIds.filter(i=>i!==id);
    } else if (this.compareIds.length < 5) {
      this.compareIds = [...this.compareIds, id];
    }
  },

  async loadCompare() {
    for (const id of this.compareIds) {
      if (!this.compareData[id]) {
        try {
          const r = await fetch(`/api/results/${id}`);
          const d = await r.json();
          this.compareData = { ...this.compareData, [id]: d };
        } catch(e) { console.error(e); }
      }
    }
    await this.$nextTick();
    this.renderCompareTrend();
  },

  renderCompareTrend() {
    const el = document.getElementById('compare-trend-chart');
    if (!el || !window.Plotly) return;
    const ids = this.compareIds.filter(id => this.compareData[id]);
    if (ids.length < 2) return;
    // 파일명 끝 18자(타임스탬프 포함)로 레이블 생성 — 중복 방지
    const labels = ids.map(id => {
      const n = this.compareData[id]?.name || id;
      return n.length > 18 ? '…' + n.slice(-17) : n;
    });

    // % 지표 (왼쪽 y축)
    const pctMetrics = [
      { name: 'TCR (%)',           color: '#6c8ef5', fn: d => d?.accuracy_metrics?.tcr?.tcr ?? null },
      { name: 'Accuracy (%)',      color: '#4ade80', fn: d => d?.accuracy_metrics?.accuracy_scores?.overall_accuracy ?? null },
      { name: 'Hallucination (%)', color: '#f87171', fn: d => d?.accuracy_metrics?.hallucination?.overall_rate ?? null },
    ];
    // 초 단위 지표 (오른쪽 y축)
    const secMetrics = [
      { name: 'Latency P95 (s)', color: '#facc15', fn: d => d?.efficiency_metrics?.latency?.p95 ?? null },
    ];

    const isDark = !document.body.classList.contains('light');
    const bg = 'rgba(0,0,0,0)';
    const fc = isDark ? '#ccc' : '#333';
    const gc = isDark ? 'rgba(255,255,255,.07)' : 'rgba(0,0,0,.07)';

    const traces = [
      ...pctMetrics.map(m => ({
        x: labels, y: ids.map(id => m.fn(this.compareData[id])),
        name: m.name, type: 'scatter', mode: 'lines+markers', yaxis: 'y',
        line: { color: m.color, width: 2 }, marker: { color: m.color, size: 7 },
      })),
      ...secMetrics.map(m => ({
        x: labels, y: ids.map(id => m.fn(this.compareData[id])),
        name: m.name, type: 'scatter', mode: 'lines+markers', yaxis: 'y2',
        line: { color: m.color, width: 2, dash: 'dot' }, marker: { color: m.color, size: 7 },
      })),
    ];

    const layout = {
      paper_bgcolor: bg, plot_bgcolor: bg,
      margin: { t: 44, b: 50, l: 48, r: 52 },
      legend: { orientation: 'h', y: 1.18, x: 0, xanchor: 'left', font: { color: fc, size: 11 } },
      xaxis: { tickfont: { color: fc, size: 10 }, gridcolor: gc, linecolor: gc, tickangle: -15 },
      yaxis:  { tickfont: { color: fc, size: 10 }, gridcolor: gc, linecolor: gc,
                title: { text: '%', font: { color: fc, size: 11 } }, range: [0, 100] },
      yaxis2: { tickfont: { color: fc, size: 10 }, gridcolor: gc, linecolor: gc,
                title: { text: 's', font: { color: fc, size: 11 } },
                overlaying: 'y', side: 'right', autorange: true, showgrid: false },
    };

    Plotly.purge(el);
    Plotly.newPlot('compare-trend-chart', traces, { ...layout, height: 240 }, { displayModeBar: false, responsive: false });

    // 레전드 클릭 후 y축 autorange 강제 리셋 — 숨긴 trace 복원 시 스케일 복구
    el.removeAllListeners && el.removeAllListeners('plotly_legendclick');
    el.on('plotly_legendclick', () => {
      setTimeout(() => {
        Plotly.relayout('compare-trend-chart', {
          'yaxis.range': [0, 100],
          'yaxis2.autorange': true,
        });
      }, 50);
    });
  },

  compareRows() {
    return [
      { key:'tcr',      label:'TCR',           fmt:d=>this.pct(d?.accuracy_metrics?.tcr?.tcr),                              best:ds=>this.pct(Math.max(...ds.map(d=>d?.accuracy_metrics?.tcr?.tcr||0))) },
      { key:'acc',      label:'Accuracy',       fmt:d=>this.pct(d?.accuracy_metrics?.accuracy_scores?.overall_accuracy),    best:ds=>this.pct(Math.max(...ds.map(d=>d?.accuracy_metrics?.accuracy_scores?.overall_accuracy||0))) },
      { key:'hall',     label:'Hallucination',  fmt:d=>this.pct(d?.accuracy_metrics?.hallucination?.overall_rate),          best:ds=>this.pct(Math.min(...ds.map(d=>d?.accuracy_metrics?.hallucination?.overall_rate||0))) },
      { key:'lat_mean', label:'Avg Latency',    fmt:d=>this.sec_(d?.efficiency_metrics?.latency?.mean),                     best:ds=>this.sec_(Math.min(...ds.map(d=>d?.efficiency_metrics?.latency?.mean||99))) },
      { key:'p95',      label:'P95 Latency',    fmt:d=>this.sec_(d?.efficiency_metrics?.latency?.p95),                      best:ds=>this.sec_(Math.min(...ds.map(d=>d?.efficiency_metrics?.latency?.p95||99))) },
      { key:'cost',     label:'Total Cost',     fmt:d=>this.cost(d?.efficiency_metrics?.tokens?.total_cost),                best:ds=>this.cost(Math.min(...ds.map(d=>d?.efficiency_metrics?.tokens?.total_cost||99))) },
      { key:'tasks',    label:'Total Tasks',    fmt:d=>d?.total_tasks??'—',                                                  best:null },
      { key:'grade',    label:'Benchmark Grade',fmt:d=>this.benchGrade(d?.accuracy_metrics?.tcr?.tcr||0).letter,            best:null },
    ];
  },

  // ── Threshold persistence ────────────────────────────────────────────────
  async saveThresholds() {
    try {
      const r = await fetch('/api/thresholds', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(this.thresholds),
      });
      if (r.ok) {
        this.thresholdSaved = true;
        setTimeout(() => { this.thresholdSaved = false; }, 2500);
      }
    } catch(e) { console.error('threshold save failed', e); }
  },

  // ── Golden Dataset ──────────────────────────────────────────────────────
  async generatePdfQA(evt) {
    const file = evt.target.files[0];
    if (!file) return;
    evt.target.value = '';
    const useAI = !!this.gdAiKey.trim();
    if (useAI && !this.gdAiQTypes.length) { alert('질문 유형을 하나 이상 선택하세요.'); return; }
    this.gdAiUploading = true;
    this.gdAiResult = null;
    try {
      const fd = new FormData();
      fd.append('file', file);
      let url, errPrefix;
      if (useAI) {
        // AI mode: high-quality QA via OpenAI
        fd.append('openai_api_key', this.gdAiKey);
        fd.append('model', this.gdAiModel);
        fd.append('num_questions', String(this.gdAiNumQ));
        fd.append('max_chunks', String(this.gdAiMaxChunks));
        fd.append('question_types', this.gdAiQTypes.join(','));
        url = '/api/golden/pdf-advanced';
        errPrefix = 'AI QA 생성 실패';
      } else {
        // Extraction mode: rule-based, no API key required
        fd.append('num_items', String(this.gdAiMaxChunks));
        url = '/api/golden/pdf';
        errPrefix = 'PDF 추출 실패';
      }
      const r = await fetch(url, { method: 'POST', body: fd });
      if (!r.ok) {
        const err = await r.json().catch(() => ({ detail: r.statusText }));
        alert(`${errPrefix}: ` + (err.detail || r.statusText));
      } else {
        this.gdAiResult = await r.json();
        const suffix = useAI ? '_ai' : '_extracted';
        this.gdAiSaveName = file.name.replace(/\.pdf$/i, '').replace(/\s+/g, '_') + suffix;
      }
    } catch(e) { alert('오류: ' + e.message); }
    finally { this.gdAiUploading = false; }
  },

  async saveAiResult() {
    if (!this.gdAiResult || !this.gdAiSaveName) return;
    const fname = this.gdAiSaveName.endsWith('.json') ? this.gdAiSaveName : this.gdAiSaveName + '.json';
    try {
      const r = await fetch(`/api/golden/${fname}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(this.gdAiResult.items),
      });
      if (r.ok) {
        this.gdAiResult = null;
        this.gdAiPanel = false;
        await this.loadGoldenList();
      } else {
        alert('저장 실패: ' + r.statusText);
      }
    } catch(e) { alert('저장 오류: ' + e.message); }
  },

  async loadGoldenList() {
    try {
      const r = await fetch('/api/golden');
      this.gdFiles = await r.json();
    } catch(e) { console.error(e); }
  },

  async loadGoldenFile(stem) {
    if (this.gdSelected === stem) { this.gdSelected = null; return; }
    try {
      const r = await fetch(`/api/golden/${stem}`);
      let data = await r.json();
      // Normalize: could be array or object with items/questions key
      if (Array.isArray(data)) {
        this.gdItems = { ...this.gdItems, [stem]: data };
      } else {
        const arr = data.items || data.questions || Object.values(data);
        this.gdItems = { ...this.gdItems, [stem]: Array.isArray(arr) ? arr : [] };
      }
      this.gdSelected = stem;
    } catch(e) { console.error(e); }
  },

  async saveGolden(stem) {
    try {
      const items = this.gdItems[stem] || [];
      const r = await fetch(`/api/golden/${stem}`, {
        method: 'PUT',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify(items),
      });
      const result = await r.json();
      if (result.ok) {
        alert(`✅ 저장 완료: ${result.name}`);
        await this.loadGoldenList();
      }
    } catch(e) { alert('저장 실패: ' + e.message); }
  },

  async createGolden() {
    if (!this.gdNewName) return;
    try {
      const r = await fetch('/api/golden', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({name: this.gdNewName, items: []}),
      });
      const result = await r.json();
      if (result.ok) {
        this.gdShowCreate = false;
        this.gdNewName = '';
        await this.loadGoldenList();
      }
    } catch(e) { alert('생성 실패: ' + e.message); }
  },

  addGoldenItem(stem) {
    const items = this.gdItems[stem] || [];
    this.gdItems = { ...this.gdItems, [stem]: [...items, {question:'', ground_truth:'', context:''}] };
  },

  removeGoldenItem(stem, idx) {
    const items = [...(this.gdItems[stem]||[])];
    items.splice(idx, 1);
    this.gdItems = { ...this.gdItems, [stem]: items };
  },

  // ── Performance bottleneck analysis ───────────────────────────────────
  bottleneckAnalysis() {
    const tasks = this.data?.tasks||[]; if (!tasks.length) return [];
    const results = [];
    // Top 5 slowest tasks
    const sorted = [...tasks].sort((a,b)=>(b.execution_time||0)-(a.execution_time||0));
    const slowThreshold = (this.data?.efficiency_metrics?.latency?.p95 || 2);
    const slow = sorted.filter(t=>(t.execution_time||0)>slowThreshold);
    if (slow.length) {
      results.push({type:'slow_tasks', severity:'high',
        title:`느린 태스크 ${slow.length}건 (P95 초과)`,
        desc:`P95 기준(${slowThreshold.toFixed(2)}s) 초과: ${slow.slice(0,3).map(t=>t.task_id).join(', ')}${slow.length>3?'...':''}`,
        tasks: slow.slice(0,5),
      });
    }
    // TaskType bottleneck
    const typeLatency={};
    tasks.forEach(t=>{ const k=t.task_type||'unknown'; (typeLatency[k]=typeLatency[k]||[]).push(t.execution_time||0); });
    const typeAvg = Object.entries(typeLatency).map(([k,v])=>({type:k, avg:v.reduce((a,b)=>a+b,0)/v.length, n:v.length}));
    const worstType = typeAvg.sort((a,b)=>b.avg-a.avg)[0];
    if (worstType && worstType.avg > slowThreshold*0.7) {
      results.push({type:'type_bottleneck', severity:'medium',
        title:`${worstType.type} 유형이 가장 느림`,
        desc:`평균 ${worstType.avg.toFixed(2)}s (${worstType.n}건) — 해당 유형의 프롬프트/로직 최적화 필요`,
        tasks:[]});
    }
    // High token tasks
    const _tok = t => (t.tokens_used?.total)||(t.tokens_used?.input||0)+(t.tokens_used?.output||0);
    const tokenSorted = [...tasks].sort((a,b)=>_tok(b)-_tok(a));
    const avgTok = tasks.reduce((s,t)=>s+_tok(t),0)/tasks.length;
    const heavyTok = tokenSorted.filter(t=>_tok(t)>avgTok*2);
    if (heavyTok.length) {
      results.push({type:'token_heavy', severity:'low',
        title:`토큰 과다 사용 태스크 ${heavyTok.length}건`,
        desc:`평균 대비 2배 이상 사용: ${heavyTok.slice(0,3).map(t=>t.task_id).join(', ')}`,
        tasks: heavyTok.slice(0,5)});
    }
    // Failure correlation with latency
    const failedAvgLat = tasks.filter(t=>!t.success).reduce((s,t,_,a)=>s+(t.execution_time||0)/a.length,0) || 0;
    const successAvgLat = tasks.filter(t=>t.success).reduce((s,t,_,a)=>s+(t.execution_time||0)/a.length,0) || 0;
    if (failedAvgLat>0 && successAvgLat>0 && failedAvgLat>successAvgLat*1.3) {
      results.push({type:'fail_latency', severity:'medium',
        title:'실패 태스크가 성공 태스크보다 느림',
        desc:`실패 평균 ${failedAvgLat.toFixed(2)}s vs 성공 평균 ${successAvgLat.toFixed(2)}s — 타임아웃 관련 실패 의심`,
        tasks:[]});
    }
    return results;
  },

  mergedStats() {
    const files = this.compareIds.map(id=>this.compareData[id]).filter(Boolean);
    if (!files.length) return {};
    const avg = (getter) => files.reduce((s,d)=>s+(getter(d)||0),0)/files.length;
    return {
      tcr:   avg(d=>d.accuracy_metrics?.tcr?.tcr),
      acc:   avg(d=>d.accuracy_metrics?.accuracy_scores?.overall_accuracy),
      hall:  avg(d=>d.accuracy_metrics?.hallucination?.overall_rate),
      lat:   avg(d=>d.efficiency_metrics?.latency?.mean),
      tasks: files.reduce((s,d)=>s+(d.total_tasks||0),0),
      cost:  files.reduce((s,d)=>s+(d.efficiency_metrics?.tokens?.total_cost||0),0),
    };
  },

  pearsonCorr() {
    if (!this.data) return '';
    const pts = (this.data.tasks||[]).filter(t=>t.execution_time>0&&t.accuracy_score>=0);
    if (pts.length < 3) return '';
    const n = pts.length;
    const xs = pts.map(t=>t.execution_time), ys = pts.map(t=>t.accuracy_score*100);
    const mx = xs.reduce((s,v)=>s+v,0)/n, my = ys.reduce((s,v)=>s+v,0)/n;
    const num = xs.reduce((s,v,i)=>s+(v-mx)*(ys[i]-my),0);
    const den = Math.sqrt(xs.reduce((s,v)=>s+(v-mx)**2,0)*ys.reduce((s,v)=>s+(v-my)**2,0));
    if (!den) return '';
    const r = num/den;
    const interp = Math.abs(r)>=0.7?'강한':Math.abs(r)>=0.4?'중간':'약한';
    const dir = r>0?'양의':'음의';
    return `Pearson r = ${r.toFixed(3)} — ${interp} ${dir} 상관관계 (n=${n})`;
  },

  // ── Markdown → HTML (for AI-generated suggestions) ─────────────────────
  md2html(s) {
    if (!s) return '';
    s = s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    s = s.replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>');
    s = s.replace(/\*(.+?)\*/g,'<em>$1</em>');
    // numbered list: items at line-start OR preceded by space (inline style)
    s = s.replace(/(?:^|\n)(\d+)\.\s+/g,'\n<br><b>$1.</b> ');
    // bullet points: • char
    s = s.replace(/•\s*/g,'<br>• ');
    s = s.replace(/\n/g,'<br>');
    s = s.replace(/^(<br>)+/,'');
    return s;
  },
  // ── Format helpers ─────────────────────────────────────────────────────
  pct(v)  { return v===undefined||v===null?'—':(+v).toFixed(1)+'%'; },
  sec_(v) { return v===undefined||v===null?'—':(+v).toFixed(3)+'s'; },
  cost(v) { if(v===undefined||v===null)return'—'; v=+v; if(v===0)return'$0'; const s=v<0.001?v.toFixed(6):v<0.01?v.toFixed(4):v<1?v.toFixed(4):v.toFixed(2); return '$'+s.replace(/(\.\d*?)0+$/,'$1').replace(/\.$/,''); },
  tc(v,t) { return v>=t?'kpi-sub ok':'kpi-sub warn'; },
  tlbl(v,t){ return v>=t?`✅ ≥${t}% 통과`:`⚠️ <${t}% 주의`; },
  bc(v)   { return v>=80?'var(--green)':v>=60?'var(--yellow)':'var(--red)'; },
  // Hallucination helpers — threshold-aware: SAFE ≤ hall, WARNING ≤ hall×3, DANGER > hall×3
  hr_col(v) { const t=this.thresholds.hall; return `color:${!v||v<=t?'var(--green)':v<=t*3?'var(--yellow)':'var(--red)'}`; },
  hr_col2(v){ const t=this.thresholds.hall; return !v||v<=t?'var(--green)':v<=t*3?'var(--yellow)':'var(--red)'; },
  hr_lbl(v) { const t=this.thresholds.hall; return !v||v<=t?'✅ SAFE':v<=t*3?'⚠️ WARNING':'🚨 DANGER'; },
  // Latency CSS class helper — threshold-aware: ok ≤ p95, warn > p95
  lat_cl(v) { const t=this.thresholds.p95; return !v||v<=t?'ok':'warn'; },
};}
</script>
