  taskDetail: null,
  gdFiles: [], gdSelected: null, gdItems: {}, gdNewName: '', gdShowCreate: false,
  gdAiPanel: false, gdAiKey: '', gdAiModel: 'gpt-5-nano', gdAiNumQ: 3, gdAiMaxChunks: 10,
  gdAiQTypes: ['factual','reasoning','summary'], gdAiUploading: false, gdAiResult: null, gdAiSaveName: '',
  glossSearch: '',

  nav: [
    { id:'overview',      icon:'📊', label:'Overview',           group: '평가 현황',    scope:'file'   },
