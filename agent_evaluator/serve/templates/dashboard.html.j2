  <div x-show="ttr==='improve'">
    <div x-show="!(data.insights?.recommendations?.length>0)" class="empty"><p>권고사항이 없습니다</p></div>
    <template x-for="(r,i) in data.insights?.recommendations||[]" :key="i">
      <div class="rec">
        <div class="rec-t">
          <span :class="{'pr':r.priority==='high','py':r.priority==='medium','pg':r.priority==='low'}" class="pill" x-text="r.priority?.toUpperCase()"></span>
          <span style="margin-left:6px" x-text="r.title||r.area"></span>
        </div>
        <div class="rec-b" x-show="r.issue" x-text="r.issue"></div>
        <details style="margin-top:6px">
          <summary style="cursor:pointer;font-size:11px;color:var(--accent)">개선 방안 보기</summary>
          <div style="font-size:11px;margin-top:6px;white-space:pre-wrap;color:var(--text2)" x-text="r.suggestion"></div>
        </details>
      </div>
    </template>
    <!-- Bottleneck recommendations -->
    <template x-for="(b,i) in bottleneckAnalysis()" :key="i">
      <div class="rec">
        <div class="rec-t">
          <span class="pill" :class="b.severity==='high'?'pr':b.severity==='medium'?'py':'pg'" x-text="b.severity.toUpperCase()"></span>
          <span style="margin-left:6px" x-text="b.title"></span>
        </div>
        <div class="rec-b" x-text="b.desc"></div>
      </div>
    </template>
  </div>

  <!-- Traces -->
  <div x-show="ttr==='tr'">
    <div x-show="trData.traces.length===0" class="empty"><p>Trace 파일 없음 — 투명성 예제를 실행하세요.</p></div>
    <template x-for="(tr,i) in trData.traces" :key="i">
      <div class="sec">
        <div class="sec-t">📍 <span x-text="tr.stem||tr.name"></span></div>
        <div x-show="!trDetail[tr.stem]">
          <button class="btn" @click="loadTrace(tr.stem)">상세 보기</button>
        </div>
        <div x-show="trDetail[tr.stem]">
          <div class="drow"><span class="dk">Metric</span><span x-text="trDetail[tr.stem]?.metric_name"></span></div>
          <div class="drow"><span class="dk">Status</span><span x-text="trDetail[tr.stem]?.status"></span></div>
          <div class="drow"><span class="dk">Final Value</span><span x-text="trDetail[tr.stem]?.final_value"></span></div>
          <div style="margin-top:8px">
            <template x-for="(s,si) in trDetail[tr.stem]?.steps||[]" :key="si">
              <div class="trace-step">
                <h4 x-text="`Step ${si+1}: ${s.step_name}`"></h4>
                <p x-text="s.description"></p>
                <p x-show="s.output_data?.reasoning" x-text="`추론: ${s.output_data?.reasoning}`"></p>
              </div>
            </template>
          </div>
        </div>
      </div>
    </template>
  </div>

  <!-- Annotations -->
  <div x-show="ttr==='ann'">
    <div x-show="trData.annotations.length===0" class="empty"><p>Annotation 파일 없음</p></div>
    <template x-for="(an,i) in trData.annotations" :key="i">
      <div class="sec">
        <div class="sec-t">📝 <span x-text="an.stem"></span></div>
        <button class="btn" x-show="!annDetail[an.stem]" @click="loadAnnotation(an.stem)">상세 보기</button>
        <div x-show="annDetail[an.stem]">
          <div class="drow"><span class="dk">Type</span><span x-text="annDetail[an.stem]?.annotation_type"></span></div>
          <div class="drow"><span class="dk">Priority</span><span :class="{'pr':annDetail[an.stem]?.priority==='high','py':annDetail[an.stem]?.priority==='medium','pg':annDetail[an.stem]?.priority==='low'}" class="pill" x-text="annDetail[an.stem]?.priority"></span></div>
          <div class="drow"><span class="dk">Author</span><span x-text="annDetail[an.stem]?.author"></span></div>
          <div style="margin-top:6px;font-size:11px;color:var(--text2)" x-text="annDetail[an.stem]?.content"></div>
          <div x-show="(annDetail[an.stem]?.tags||[]).length>0" style="margin-top:6px">
            <template x-for="t in annDetail[an.stem]?.tags||[]" :key="t"><span class="tag" x-text="t"></span></template>
          </div>
        </div>
      </div>
    </template>
  </div>

  <!-- Audit Log -->
  <div x-show="ttr==='aud'">
    <div x-show="trData.audit.length===0" class="empty"><p>Audit Log 없음</p></div>
    <div class="slist">
      <template x-for="(au,i) in trData.auditItems" :key="i">
        <div class="irow">
          <span :class="au.success?'pg':'pr'" class="pill" x-text="au.success?'✓':'✗'"></span>
          <span x-text="au.event_type||au.stem" style="color:var(--accent)"></span>
          <span x-text="au.action||''" style="color:var(--text2)"></span>
          <span style="margin-left:auto;font-size:10px;color:var(--text2)" x-text="(au.timestamp||'').substring(0,16)"></span>
        </div>
      </template>
    </div>
  </div>
</div>

<!-- ══ GLOSSARY ══ -->
<div x-show="data && sec==='glossary'" x-cloak>
  <input x-model="glossSearch" type="text" placeholder="지표 검색..." style="width:100%;padding:7px 10px;background:var(--bg3);border:1px solid var(--border);border-radius:var(--r);color:var(--text);font-size:12px;margin-bottom:10px">
  <template x-for="g in glossary.filter(g=>!glossSearch||g.term.toLowerCase().includes(glossSearch.toLowerCase()))" :key="g.term">
    <div class="gterm">
      <h4><span x-text="g.icon"></span> <span x-text="g.term"></span> <span class="badge" x-text="g.layer"></span></h4>
      <p x-text="g.desc"></p>
      <p style="margin-top:4px;color:var(--accent);font-size:10px" x-text="`범위: ${g.range} | 목표: ${g.target}`"></p>
    </div>
  </template>
</div>

<!-- ══ TASKS ══ -->
<div x-show="data && sec==='tasks'" x-cloak>
  <div class="sec">
    <div class="sec-t">📋 전체 태스크 <span class="badge" x-text="data.total_tasks+'건'"></span></div>
    <!-- Filter bar -->
    <div class="fbar">
      <label>Type</label>
      <select x-model="taskFilter.type" @change="applyTaskFilter()" style="max-width:140px">
        <option value="all">전체</option>
        <template x-for="tp in taskTypes()" :key="tp"><option :value="tp" x-text="tp"></option></template>
      </select>
      <label>상태</label>
      <select x-model="taskFilter.status" @change="applyTaskFilter()" style="max-width:110px">
        <option value="all">전체</option>
        <option value="success">성공</option>
        <option value="fail">실패</option>
      </select>
      <label>정렬</label>
      <select x-model="taskFilter.sort" @change="applyTaskFilter()" style="max-width:140px">
        <option value="task_id">Task ID</option>
        <option value="accuracy_score">Accuracy ↓</option>
        <option value="execution_time">Latency ↓</option>
        <option value="completion_score">Completion ↓</option>
      </select>
      <button class="btn" @click="taskFilter={type:'all',status:'all',sort:'task_id'};applyTaskFilter()">초기화</button>
      <span style="font-size:11px;color:var(--text2)" x-text="`${filteredTaskCount}건 표시`"></span>
    </div>
    <div class="tw"><div id="task-table"></div></div>
  </div>
</div>

<!-- ══ COMPARE ══ -->
<div x-show="sec==='compare'" x-cloak>
  <div class="sec">
    <div class="sec-t">⚖️ 파일 비교 <span class="badge" x-text="`${compareIds.length}개 선택`"></span></div>
    <p style="font-size:11px;color:var(--text2);margin-bottom:10px">비교할 파일을 선택하세요 (최대 5개)</p>
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px">
      <template x-for="f in files" :key="f.id">
        <label style="display:flex;align-items:center;gap:5px;cursor:pointer;font-size:12px;background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:4px 10px" :style="compareIds.includes(f.id)?'border-color:var(--accent);color:var(--accent)':''">
          <input type="checkbox" :value="f.id" :checked="compareIds.includes(f.id)" @change="toggleCompare(f.id)" style="accent-color:var(--accent)">
          <span x-text="f.name.substring(0,28)"></span>
        </label>
      </template>
    </div>
    <button class="btn" @click="loadCompare()" :disabled="compareIds.length<2" style="margin-bottom:14px">📊 비교 실행</button>
    <div x-show="Object.keys(compareData).length>0">
      <div style="overflow-x:auto">
        <table class="cmp-tbl">
          <thead>
            <tr>
              <th>지표</th>
              <template x-for="id in compareIds" :key="id">
                <th x-text="compareData[id]?.name?.substring(0,20)||id"></th>
              </template>
            </tr>
          </thead>
          <tbody>
            <template x-for="row in compareRows()" :key="row.key">
              <tr>
                <td x-text="row.label"></td>
                <template x-for="id in compareIds" :key="id">
                  <td x-text="row.fmt(compareData[id])" :style="row.best && compareData[id] ? (row.fmt(compareData[id])===row.best(compareIds.map(i=>compareData[i]).filter(Boolean)) ? 'color:var(--green);font-weight:700' : '') : ''"></td>
                </template>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </div>
    <div x-show="compareIds.length<2 && Object.keys(compareData).length===0" class="empty" style="padding:20px">
      <p>파일을 2개 이상 선택 후 비교 실행 버튼을 누르세요</p>
    </div>
    <!-- Merge analysis -->
    <div x-show="Object.keys(compareData).length>=2" style="margin-top:12px">
      <div class="sec">
        <div class="sec-t">🔀 병합 통계 (선택된 파일 합산)</div>
        <div class="kpi-grid">
          <div class="kpi">
            <div class="kpi-lbl">평균 TCR</div>
            <div class="kpi-val" x-text="pct(mergedStats().tcr)"></div>
          </div>
          <div class="kpi">
            <div class="kpi-lbl">평균 Accuracy</div>
            <div class="kpi-val" x-text="pct(mergedStats().acc)"></div>
          </div>
          <div class="kpi">
            <div class="kpi-lbl">평균 Hallucination</div>
            <div class="kpi-val" x-text="pct(mergedStats().hall)"></div>
          </div>
          <div class="kpi">
            <div class="kpi-lbl">평균 Latency</div>
            <div class="kpi-val" x-text="sec_(mergedStats().lat)"></div>
          </div>
          <div class="kpi">
            <div class="kpi-lbl">총 Tasks</div>
            <div class="kpi-val" x-text="mergedStats().tasks"></div>
          </div>
          <div class="kpi">
            <div class="kpi-lbl">총 비용</div>
            <div class="kpi-val" x-text="cost(mergedStats().cost)"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ══ GOLDEN DATASET ══ -->
<div x-show="sec==='golden'" x-cloak>
  <div class="sec">
    <div class="sec-t">📝 Golden Dataset 관리</div>
    <div style="display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap">
      <button class="btn" @click="loadGoldenList()">🔄 목록 새로고침</button>
      <button class="btn" @click="gdNewName='';gdShowCreate=true" style="color:var(--green);border-color:var(--green)">＋ 새 Dataset</button>
    </div>
    <!-- Create form -->
    <div x-show="gdShowCreate" class="sec" style="border-color:var(--accent)">
      <div class="sec-t">새 Golden Dataset 생성</div>
      <div style="display:flex;gap:8px;margin-bottom:8px;align-items:center">
        <label style="font-size:11px;color:var(--text2);white-space:nowrap">파일명</label>
        <input class="gd-input" x-model="gdNewName" placeholder="my_golden_dataset" style="flex:1">
        <button class="btn" @click="createGolden()" :disabled="!gdNewName">저장</button>
        <button class="btn" @click="gdShowCreate=false">취소</button>
      </div>
      <div style="font-size:11px;color:var(--text2)">빈 dataset이 생성됩니다. 생성 후 항목을 추가하세요.</div>
    </div>
    <!-- File list -->
    <div x-show="!gdFiles.length" class="empty"><p>Golden Dataset 없음 — golden_datasets/ 디렉토리에 JSON 파일을 추가하세요.</p></div>
    <template x-for="f in gdFiles" :key="f.name">
      <div class="sec" style="margin-bottom:8px">
        <div class="sec-t" style="margin-bottom:8px">
          <span x-text="f.name"></span>
          <span class="badge" x-text="`${f.count}건`"></span>
          <span class="badge" x-text="`${(f.size_bytes/1024).toFixed(1)}KB`"></span>
          <button class="btn" style="margin-left:auto" @click="loadGoldenFile(f.stem)">📂 편집</button>
        </div>
        <div x-show="gdSelected===f.stem">
          <div style="margin-bottom:8px;display:flex;gap:8px;align-items:center">
            <span style="font-size:11px;color:var(--text2)" x-text="`${(gdItems[f.stem]||[]).length}개 항목`"></span>
            <button class="btn" style="color:var(--green);border-color:var(--green)" @click="addGoldenItem(f.stem)">＋ 항목 추가</button>
            <button class="btn" @click="saveGolden(f.stem)">💾 저장</button>
          </div>
          <template x-for="(item,idx) in (gdItems[f.stem]||[])" :key="idx">
            <div style="background:var(--bg3);border-radius:8px;padding:10px;margin-bottom:6px">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
                <span style="font-size:11px;color:var(--text2)" x-text="`#${idx+1}`"></span>
                <button class="btn" style="color:var(--red);border-color:var(--red);padding:2px 7px;font-size:10px" @click="removeGoldenItem(f.stem,idx)">✕</button>
              </div>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
                <div>
                  <div style="font-size:10px;color:var(--text2);margin-bottom:3px">질문 (Question)</div>
                  <textarea class="gd-input" x-model="gdItems[f.stem][idx].question" placeholder="질문을 입력하세요"></textarea>
                </div>
                <div>
                  <div style="font-size:10px;color:var(--text2);margin-bottom:3px">정답 (Ground Truth)</div>
                  <textarea class="gd-input" x-model="gdItems[f.stem][idx].ground_truth" placeholder="정답을 입력하세요"></textarea>
                </div>
              </div>
              <div style="margin-top:6px">
                <div style="font-size:10px;color:var(--text2);margin-bottom:3px">컨텍스트 (Context, 선택사항)</div>
                <input class="gd-input" x-model="gdItems[f.stem][idx].context" placeholder="RAG 컨텍스트 (선택사항)">
              </div>
            </div>
          </template>
        </div>
      </div>
    </template>
  </div>
</div>

<!-- ══ EXPORT ══ -->
<div x-show="data && sec==='export'" x-cloak>
  <div class="sec">
    <div class="sec-t">📦 내보내기</div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">
      <a :href="`/api/export/json/${selId}`" class="btn">⬇️ JSON</a>
      <a :href="`/api/export/csv/${selId}`"  class="btn">⬇️ CSV</a>
      <a :href="`/api/export/html/${selId}`" class="btn">⬇️ HTML 리포트</a>
      <button class="btn" @click="window.open('/slides','_blank')">📊 Slides 열기</button>
      <button class="btn" @click="window.print()" title="현재 페이지를 PDF로 저장">🖨️ PDF 출력</button>
    </div>
    <div class="drow"><span class="dk">파일</span><span x-text="data.name"></span></div>
    <div class="drow"><span class="dk">타임스탬프</span><span x-text="data.timestamp"></span></div>
    <div class="drow"><span class="dk">총 Tasks</span><span x-text="data.total_tasks"></span></div>
    <div class="drow"><span class="dk">Agentic 지표</span><span x-text="data.has_agentic?'있음':'없음'"></span></div>
    <div class="drow"><span class="dk">보안 지표</span><span x-text="data.has_security?'있음':'없음'"></span></div>
    <div class="drow"><span class="dk">고급 지표</span><span x-text="data.has_advanced?'있음':'없음'"></span></div>
    <div class="drow"><span class="dk">RAG 지표</span><span x-text="data.has_rag?'있음':'없음'"></span></div>
  </div>
</div>

<!-- ══ SETTINGS ══ -->
<div x-show="data && sec==='settings'" x-cloak>
  <div class="sec">
    <div class="sec-t">⚙️ 임계값 설정 (실시간 pass/fail 재판정)</div>
    <div style="margin-bottom:12px">
      <span style="font-size:11px;color:var(--text2);margin-right:8px">프리셋:</span>
      <button class="btn" @click="thresholds={tcr:90,acc:70,hall:5,p95:2.0,cost:0.01}">기본값</button>
      <button class="btn" @click="thresholds={tcr:95,acc:85,hall:3,p95:1.5,cost:0.005}" style="margin-left:6px">엄격</button>
      <button class="btn" @click="thresholds={tcr:80,acc:60,hall:10,p95:3.0,cost:0.02}" style="margin-left:6px">완화</button>
    </div>
    <div class="drow" style="align-items:center">
      <span class="dk">TCR 목표</span>
      <input type="range" x-model.number="thresholds.tcr" min="50" max="100" step="1" style="flex:1;margin:0 10px;accent-color:var(--accent)">
      <span style="min-width:38px;text-align:right" x-text="thresholds.tcr+'%'"></span>
      <span class="pill" :class="tcr()>=thresholds.tcr?'pg':'pr'" x-text="tcr()>=thresholds.tcr?'✅ 통과':'❌ 실패'"></span>
    </div>
    <div class="drow" style="align-items:center">
      <span class="dk">Accuracy 목표</span>
      <input type="range" x-model.number="thresholds.acc" min="30" max="100" step="1" style="flex:1;margin:0 10px;accent-color:var(--accent)">
      <span style="min-width:38px;text-align:right" x-text="thresholds.acc+'%'"></span>
      <span class="pill" :class="acc()>=thresholds.acc?'pg':'pr'" x-text="acc()>=thresholds.acc?'✅ 통과':'❌ 실패'"></span>
    </div>
    <div class="drow" style="align-items:center">
      <span class="dk">Hallucination 허용</span>
      <input type="range" x-model.number="thresholds.hall" min="0" max="30" step="0.5" style="flex:1;margin:0 10px;accent-color:var(--accent)">
      <span style="min-width:38px;text-align:right" x-text="thresholds.hall+'%'"></span>
      <span class="pill" :class="hall()<=thresholds.hall?'pg':'pr'" x-text="hall()<=thresholds.hall?'✅ 통과':'❌ 실패'"></span>
    </div>
    <div class="drow" style="align-items:center">
      <span class="dk">P95 Latency 목표</span>
      <input type="range" x-model.number="thresholds.p95" min="0.5" max="10" step="0.1" style="flex:1;margin:0 10px;accent-color:var(--accent)">
      <span style="min-width:38px;text-align:right" x-text="thresholds.p95+'s'"></span>
      <span class="pill" :class="(data.efficiency_metrics?.latency?.p95||99)<=thresholds.p95?'pg':'pr'" x-text="(data.efficiency_metrics?.latency?.p95||99)<=thresholds.p95?'✅ 통과':'❌ 실패'"></span>
    </div>
    <div class="drow" style="align-items:center">
      <span class="dk">Task당 비용 목표</span>
      <input type="range" x-model.number="thresholds.cost" min="0.001" max="0.1" step="0.001" style="flex:1;margin:0 10px;accent-color:var(--accent)">
      <span style="min-width:60px;text-align:right" x-text="'$'+thresholds.cost.toFixed(3)"></span>
      <span class="pill" :class="(data.efficiency_metrics?.tokens?.avg_cost_per_task||99)<=thresholds.cost?'pg':'pr'" x-text="(data.efficiency_metrics?.tokens?.avg_cost_per_task||99)<=thresholds.cost?'✅ 통과':'❌ 실패'"></span>
    </div>
  </div>
</div>

<!-- ══ TASK DETAIL MODAL ══ -->
<div class="modal-backdrop" x-show="taskDetail" x-cloak @click.self="taskDetail=null">
  <div class="modal" x-show="taskDetail">
    <div class="modal-t">
      <span>📋 Task 상세: <span x-text="taskDetail?.task_id"></span></span>
      <button class="btn" @click="taskDetail=null">✕ 닫기</button>
    </div>
    <div x-show="taskDetail">
      <div class="kpi-grid" style="margin-bottom:12px">
        <div class="kpi"><div class="kpi-lbl">Type</div><div class="kpi-val" style="font-size:14px" x-text="taskDetail?.task_type||'—'"></div></div>
        <div class="kpi"><div class="kpi-lbl">성공</div><div class="kpi-val" x-text="taskDetail?.success?'✅':'❌'"></div></div>
        <div class="kpi"><div class="kpi-lbl">Completion</div><div class="kpi-val" style="font-size:16px" x-text="pct((taskDetail?.completion_score||0)*100)"></div></div>
        <div class="kpi"><div class="kpi-lbl">Accuracy</div><div class="kpi-val" style="font-size:16px" x-text="pct((taskDetail?.accuracy_score||0)*100)"></div></div>
        <div class="kpi"><div class="kpi-lbl">Latency</div><div class="kpi-val" style="font-size:16px" x-text="sec_(taskDetail?.execution_time)"></div></div>
        <div class="kpi"><div class="kpi-lbl">Tokens</div><div class="kpi-val" style="font-size:16px" x-text="(taskDetail?.tokens_used?.total||0).toLocaleString()"></div></div>
      </div>
      <div class="sec-t" style="margin-bottom:8px">상세 정보</div>
      <div class="drow"><span class="dk">Attempts</span><span x-text="taskDetail?.attempts??'—'"></span></div>
      <div class="drow"><span class="dk">Framework</span><span x-text="taskDetail?.framework||'—'"></span></div>
      <div class="drow"><span class="dk">Timestamp</span><span x-text="(taskDetail?.timestamp||'').substring(0,19)"></span></div>
      <div class="drow" x-show="(taskDetail?.expected_tools||[]).length>0">
        <span class="dk">Expected Tools</span>
        <span>
          <template x-for="t in taskDetail?.expected_tools||[]" :key="t"><span class="tag" x-text="t"></span></template>
        </span>
      </div>
      <div class="drow" x-show="(taskDetail?.tool_calls||[]).length>0">
        <span class="dk">Tool Calls</span><span x-text="(taskDetail?.tool_calls||[]).length+'건'"></span>
      </div>
      <div x-show="(taskDetail?.errors||[]).length>0" style="margin-top:8px">
        <div class="sec-t" style="color:var(--red);margin-bottom:6px">⚠️ 오류</div>
        <template x-for="(e,i) in taskDetail?.errors||[]" :key="i">
          <div style="font-size:11px;color:var(--red);background:rgba(248,113,113,.08);border-radius:6px;padding:6px 10px;margin-bottom:4px" x-text="typeof e==='string'?e:JSON.stringify(e)"></div>
        </template>
      </div>
      <div x-show="taskDetail?.advanced_metrics && Object.keys(taskDetail?.advanced_metrics||{}).length>0" style="margin-top:8px">
        <div class="sec-t" style="margin-bottom:6px">🔬 Advanced Metrics</div>
        <template x-for="[k,v] in Object.entries(taskDetail?.advanced_metrics||{})" :key="k">
          <div class="drow"><span class="dk" x-text="k.replace(/_/g,' ')"></span><span x-text="typeof v==='number'?v.toFixed(4):JSON.stringify(v)"></span></div>
        </template>
      </div>
    </div>
  </div>
</div>

</main>
</div>

<!-- ===== STATUS BAR ===== -->
<div class="sbar">
  <span>업데이트: <b x-text="lastUpd"></b></span>
  <span>|</span>
  <span><b x-text="files.length"></b>개 파일</span>
  <span x-show="data">| 총 <b x-text="data?.total_tasks??0"></b> tasks</span>
  <span x-show="data" x-text="data?.name?.substring(0,30)"></span>
  <div class="sp"></div>
  <span>Agent Evaluator v{{ version }}</span>
</div>
</div><!-- /layout -->

<script>
const WATCH = {{ "true" if watch else "false" }};

function app() { return {
  dark: true, sec: 'overview',
  t1:'tcr', t2:'tsel', tp:'lat', tsec:'l1in', ti:'alerts', ttr:'anom', tl3:'deepeval',
  files: [], selId: '', data: null, loading: false,
  connected: false, lastUpd: '—',
  trData: { traces:[], annotations:[], audit:[], auditItems:[] },
  trDetail: {}, annDetail: {},
  _taskTable: null,
  compareIds: [], compareData: {},
  taskFilter: { type:'all', status:'all', sort:'task_id' },
  filteredTaskCount: 0,
  thresholds: { tcr: 90, acc: 70, hall: 5, p95: 2.0, cost: 0.01 },
  _hallucination: null, // cached hallucination rate for delta
  taskDetail: null,
  gdFiles: [], gdSelected: null, gdItems: {}, gdNewName: '', gdShowCreate: false,
  glossSearch: '',

  nav: [
    { id:'overview',      icon:'📊', label:'Overview' },
    { id:'layer1',        icon:'📈', label:'Layer 1 기초' },
    { id:'agentic',       icon:'🤖', label:'Layer 2 에이전틱', badge: d=>d.has_agentic?'✓':'' },
    { id:'layer3',        icon:'🔬', label:'Layer 3 Advanced', badge: d=>d.has_advanced?'✓':'' },
    { id:'performance',   icon:'⚡', label:'Performance' },
    { id:'security',      icon:'🛡️', label:'Security', badge: d=>d.has_security?'✓':'' },
    { id:'intsec',        icon:'🚨', label:'통합 보안', badge: d=>d.has_security?'✓':'' },
    { id:'insights',      icon:'💡', label:'Insights', badge: d=>(d.insights?.alerts?.length||0)||'' },
    { id:'transparency',  icon:'🔍', label:'투명성' },
    { id:'glossary',      icon:'📚', label:'지표 설명' },
    { id:'tasks',         icon:'📋', label:'Tasks' },
    { id:'compare',       icon:'⚖️', label:'파일 비교' },
    { id:'golden',        icon:'📝', label:'Golden Dataset' },
    { id:'export',        icon:'📦', label:'Export' },
    { id:'settings',      icon:'⚙️', label:'Settings' },
  ],

  glossary: [
    { icon:'📋', term:'TCR (Task Completion Rate)', layer:'Layer 1', desc:'모든 작업의 Completion Score 합계 ÷ 전체 작업 수 × 100. 완전 성공(100%), 부분 성공(70~99%), 실패(<70%)로 분류.', range:'0~100%', target:'≥ 90%' },
    { icon:'🎯', term:'Accuracy', layer:'Layer 1', desc:'Token Overlap(40%), Jaccard(30%), LCS(20%), Char Similarity(10%) 가중 평균으로 계산된 응답 정확도.', range:'0~100%', target:'≥ 70%' },
    { icon:'⭐', term:'Response Quality', layer:'Layer 1', desc:'관련성(Relevance), 완전성(Completeness), 명확성(Clarity), 정확성(Accuracy), 유용성(Usefulness) 5개 차원 평가. 각 0~2점.', range:'0~10', target:'≥ 7.0' },
    { icon:'🧠', term:'Hallucination Rate', layer:'Layer 1', desc:'미지원 주장, 수치 불일치를 탐지. 낮을수록 좋음. SAFE(<5%), WARNING(5~15%), DANGER(>15%).', range:'0~100%', target:'≤ 5%' },
    { icon:'⏱️', term:'Latency P95', layer:'Layer 1', desc:'상위 5% 고지연 요청의 응답 시간. P50(중앙값)보다 사용자 경험을 더 잘 반영.', range:'>0s', target:'≤ 2s' },
    { icon:'💰', term:'Cost per Task', layer:'Layer 1', desc:'API 입출력 토큰 수 × 단가로 계산된 작업당 평균 비용.', range:'$0~', target:'< $0.01' },
    { icon:'🔧', term:'Tool Selection (F1)', layer:'Layer 2', desc:'예상 도구 집합과 실제 도구 집합의 F1-Score. Precision×Recall의 조화 평균. 오탐(불필요 도구)과 누락(필수 도구 미사용) 모두 패널티.', range:'0~100%', target:'≥ 85%' },
    { icon:'⚡', term:'Tool Efficiency', layer:'Layer 2', desc:'도구 호출 성공률, 중복 제거율, 실패율을 합산한 종합 효율성 점수.', range:'0~100%', target:'≥ 80%' },
    { icon:'🤝', term:'Agent Coordination', layer:'Layer 2', desc:'Multi-Agent 시스템에서 에이전트 간 상호작용의 성공률. 위임(delegation), 협업(collaboration) 등 인터랙션 유형 분류.', range:'0~100%', target:'≥ 80%' },
    { icon:'🔀', term:'Workflow Execution', layer:'Layer 2', desc:'LangChain/LangGraph 체인의 단계별 실행 성공률. Critical Path 분석.', range:'0~100%', target:'≥ 90%' },
    { icon:'📚', term:'Faithfulness (Ragas)', layer:'Layer 3', desc:'생성된 답변이 제공된 컨텍스트에 기반하는 정도. 높을수록 환각이 적음.', range:'0~1', target:'≥ 0.8' },
    { icon:'🔍', term:'Answer Relevancy (Ragas)', layer:'Layer 3', desc:'생성된 답변이 질문에 얼마나 관련 있는지. 완전히 관련 있으면 1.0.', range:'0~1', target:'≥ 0.8' },
    { icon:'📋', term:'Context Recall (Ragas)', layer:'Layer 3', desc:'정답 생성에 필요한 정보가 검색된 컨텍스트에 얼마나 포함되는지.', range:'0~1', target:'≥ 0.7' },
    { icon:'🎯', term:'Context Precision (Ragas)', layer:'Layer 3', desc:'검색된 컨텍스트 중 실제로 답변 생성에 유용한 비율.', range:'0~1', target:'≥ 0.7' },
    { icon:'🔍', term:'Input Sanitization', layer:'Security L1', desc:'SQL Injection, Prompt Injection, XSS, Path Traversal, Command Injection 탐지. 위협 탐지율이 낮을수록 안전.', range:'0~100%', target:'< 5%' },
    { icon:'📤', term:'Output Leakage', layer:'Security L1', desc:'API Key, Password, Email, Phone, SSN, Private IP 등 민감 정보 유출 탐지.', range:'0~100%', target:'0%' },
    { icon:'🔐', term:'Authorization Compliance', layer:'Security L1', desc:'허용된 도구만 사용하는 비율. 제한된 도구 사용 시도와 위험 파라미터 전달 탐지.', range:'0~100%', target:'≥ 95%' },
    { icon:'🚀', term:'Privilege Escalation', layer:'Security L2', desc:'정상 권한을 초과한 작업 시도 탐지. 0%가 목표.', range:'0~100%', target:'0%' },
    { icon:'⚔️', term:'Tool Chain Attack', layer:'Security L2', desc:'연속된 Tool 호출 패턴에서 공격 체인 탐지. 데이터 유출 시도 등 포함.', range:'0~100%', target:'0%' },
  ],

  async init() {
    this.dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    await this.refresh();
    if (WATCH) this.startSSE();
    await this.loadGoldenList();
  },

  async refresh() {
    try {
      const r = await fetch('/api/results');
      this.files = await r.json();
      this.lastUpd = new Date().toLocaleTimeString('ko-KR');
      // Invalidate transparency list cache so new files are picked up
      this.trData = { traces:[], annotations:[], audit:[], auditItems:[] };
      this.trDetail = {};
      this.annDetail = {};
      if (this.files.length > 0 && !this.selId) {
        this.selId = this.files[0].id;
        await this.loadFile(this.selId);
      }
    } catch(e) { console.error(e); }
  },

  async loadFile(id) {
    if (!id) { this.data = null; return; }
    this.loading = true;
    // Invalidate transparency caches — they are global, not per-file
    this.trData = { traces:[], annotations:[], audit:[], auditItems:[] };
    this.trDetail = {};
    this.annDetail = {};
    try {
      const r = await fetch(`/api/results/${id}`);
      this.data = await r.json();
      this.lastUpd = new Date().toLocaleTimeString('ko-KR');
      await this.$nextTick();
      this.renderAll();
      this.renderTable();
    } catch(e) { console.error(e); }
    finally { this.loading = false; }
  },

  // ── Phase 1: Deployment Gate & Trend ──

  prevFile() {
    if (!this.selId || this.files.length < 2) return null;
    const idx = this.files.findIndex(f => f.id === this.selId);
    return (idx >= 0 && idx + 1 < this.files.length) ? this.files[idx + 1] : null;
  },

  deltaFmt(curr, prev, higherBetter = true) {
    if (prev == null || curr == null || isNaN(prev) || isNaN(curr)) return null;
    const d = curr - prev;
    if (Math.abs(d) < 0.005) return { txt: '─ 변화없음', cls: 'neu' };
    const up = d > 0;
    const good = higherBetter ? up : !up;
    return { txt: `${up ? '▲' : '▼'} ${Math.abs(d).toFixed(1)}%`, cls: good ? 'up' : 'dn' };
  },

  deployGates() {
    if (!this.data) return [];
    const tcr  = this.tcr()  || 0;
    const acc  = this.acc()  || 0;
    const hall = this.hall() || 0;
    const p95  = this.data.efficiency_metrics?.latency?.p95 || 0;
    const cost = this.data.efficiency_metrics?.tokens?.avg_cost_per_task || 0;
    const gates = [
      {
        label: '🔬 개발', key: 'dev',
        criteria: [
          { name: 'TCR ≥ 80%',         pass: tcr  >= 80, val: `${tcr.toFixed(1)}%`  },
          { name: 'Accuracy ≥ 70%',    pass: acc  >= 70, val: `${acc.toFixed(1)}%`  },
          { name: 'Hall ≤ 10%',        pass: hall <= 10, val: `${hall.toFixed(1)}%` },
        ]
      },
      {
        label: '🚀 스테이징', key: 'staging',
        criteria: [
          { name: 'TCR ≥ 90%',         pass: tcr  >= 90, val: `${tcr.toFixed(1)}%`  },
          { name: 'Accuracy ≥ 85%',    pass: acc  >= 85, val: `${acc.toFixed(1)}%`  },
          { name: 'Hall ≤ 5%',         pass: hall <= 5,  val: `${hall.toFixed(1)}%` },
          { name: 'P95 ≤ 2s',          pass: p95  <= 2,  val: `${p95.toFixed(2)}s`  },
        ]
      },
      {
        label: '🏭 프로덕션', key: 'prod',
        criteria: [
          { name: 'TCR ≥ 95%',         pass: tcr  >= 95,   val: `${tcr.toFixed(1)}%`  },
          { name: 'Accuracy ≥ 90%',    pass: acc  >= 90,   val: `${acc.toFixed(1)}%`  },
          { name: 'Hall ≤ 3%',         pass: hall <= 3,    val: `${hall.toFixed(1)}%` },
          { name: 'P95 ≤ 2s',          pass: p95  <= 2,    val: `${p95.toFixed(2)}s`  },
          { name: 'Cost ≤ $0.01/task', pass: cost <= 0.01, val: `$${cost.toFixed(4)}`  },
        ]
      },
    ];
    return gates.map(g => ({
      ...g,
      passed: g.criteria.filter(c => c.pass).length,
      total:  g.criteria.length,
      cls:    g.criteria.every(c => c.pass)  ? 'pass'
            : g.criteria.every(c => !c.pass) ? 'fail'
            : 'partial',
    }));
  },

  renderTrend() {
    if (this.files.length < 2) return;
    const TC = this.dark ? '#8890b0' : '#5a6080';
    const GC = this.dark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.07)';
    const sorted = [...this.files].reverse(); // oldest first
    const names  = sorted.map(f => f.name.substring(0, 18));
    const curIdx = sorted.findIndex(f => f.id === this.selId);
    const mkMarker = (arr) => ({
      size: arr.map((_,i) => i === curIdx ? 10 : 6),
      opacity: arr.map((_,i) => i === curIdx ? 1 : 0.6),
    });
    const tcrY  = sorted.map(f => +(f.tcr || 0));
    const accY  = sorted.map(f => +(f.accuracy || 0));
    const latY  = sorted.map(f => +(f.avg_latency || 0));
    const traces = [
      { name:'TCR %',      x:names, y:tcrY, mode:'lines+markers', line:{color:'#6c8ef5',width:2}, marker:{...mkMarker(tcrY), color:'#6c8ef5'}, yaxis:'y' },
      { name:'Accuracy %', x:names, y:accY, mode:'lines+markers', line:{color:'#4ade80',width:2}, marker:{...mkMarker(accY), color:'#4ade80'}, yaxis:'y' },
      { name:'Latency s',  x:names, y:latY, mode:'lines+markers', line:{color:'#facc15',width:1.5,dash:'dot'}, marker:{...mkMarker(latY), color:'#facc15'}, yaxis:'y2' },
    ];
    const layout = {
      height:200, margin:{t:10,b:40,l:40,r:50},
      xaxis:  {tickfont:{color:TC,size:9}, gridcolor:GC, automargin:true},
      yaxis:  {tickfont:{color:TC}, gridcolor:GC, range:[0,105], ticksuffix:'%', title:{text:'%', font:{color:TC,size:10}}},
      yaxis2: {tickfont:{color:TC}, gridcolor:GC, overlaying:'y', side:'right', title:{text:'s', font:{color:TC,size:10}}},
      legend: {font:{color:TC,size:10}, orientation:'h', y:1.15},
      paper_bgcolor:'transparent', plot_bgcolor:'transparent', autosize:true,
      shapes: [
        {type:'line', x0:0, x1:1, xref:'paper', y0:this.thresholds.tcr, y1:this.thresholds.tcr, yref:'y', line:{color:'#6c8ef560',dash:'dash',width:1}},
        {type:'line', x0:0, x1:1, xref:'paper', y0:this.thresholds.acc, y1:this.thresholds.acc, yref:'y', line:{color:'#4ade8060',dash:'dash',width:1}},
      ],
    };
    if (window.Plotly && document.getElementById('ov-trend')) {
      Plotly.react('ov-trend', traces, layout, {responsive:true, displayModeBar:false});
    }
  },

  startSSE() {
    const es = new EventSource('/api/stream');
    es.onopen = () => { this.connected = true; };
    es.onerror = () => { this.connected = false; };
    es.onmessage = async e => {
      const m = JSON.parse(e.data);
      if (m.type === 'update') { await this.refresh(); if (this.selId) await this.loadFile(this.selId); }
    };
  },

  // ── Chart helpers ──────────────────────────────────────────────────────
  _plt(id, traces, layout, cfg) {
    const el = document.getElementById(id);
    if (!el) return;
    const TC = this.dark ? '#8890b0' : '#5a6080';
    const GC = this.dark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.07)';
    const PBG = 'transparent';
    const base = {
      margin: {t:10, b:40, l:50, r:16, pad:2},
      paper_bgcolor: PBG, plot_bgcolor: PBG,
      font: {color: TC, size: 11, family: "'Segoe UI',system-ui,sans-serif"},
      xaxis: {tickfont:{color:TC,size:10}, gridcolor:GC, zerolinecolor:GC, automargin:true},
      yaxis: {tickfont:{color:TC,size:10}, gridcolor:GC, zerolinecolor:GC, automargin:true},
      showlegend: false,
      height: 200,
      autosize: true,
      modebar: {remove: ['all']},
    };
    Plotly.react(el, traces, Object.assign({}, base, layout), Object.assign({responsive:true, displayModeBar:false, scrollZoom:false}, cfg||{}));
  },

  renderAll() {
    const d = this.data; if (!d) return;
    this.renderTrend();
    const TC = this.dark ? '#8890b0' : '#5a6080';
    const GC = this.dark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.07)';
    const scX = {tickfont:{color:TC}, gridcolor:GC, zerolinecolor:GC};
    const scY = {tickfont:{color:TC}, gridcolor:GC, zerolinecolor:GC};
    const noLeg = {showlegend:false};

    // ── Overview donut (success/fail) ──
    const tcr = d.accuracy_metrics?.tcr||{};
    const full=tcr.full_success||0, part=tcr.partial_success||0;
    const fail=tcr.failures||(d.total_tasks-(full+part));
    const donutTrace = [{
      type:'pie', hole:0.7,
      values:[full,part,fail],
      labels:['완전성공','부분성공','실패'],
      marker:{colors:['#4ade80','#facc15','#f87171']},
      textinfo:'none',
    }];
    const donutLayout = {height:200, showlegend:true, legend:{font:{color:TC,size:10}}, margin:{t:10,b:10,l:10,r:10}};
    this._plt('ov-donut', donutTrace, donutLayout);
    this._plt('l1-donut', donutTrace, donutLayout);

    // ── Overview type bar ──
    const typeCnt={};
    (d.tasks||[]).forEach(t=>{ typeCnt[t.task_type]=(typeCnt[t.task_type]||0)+1; });
    this._plt('ov-type', [{type:'bar', x:Object.keys(typeCnt), y:Object.values(typeCnt), marker:{color:'#6c8ef580', line:{color:'#6c8ef5',width:1}}}],
      {xaxis:scX, yaxis:scY, ...noLeg});

    // ── Layer1 type success rates (horizontal) ──
    const tSuc={},tTot={};
    (d.tasks||[]).forEach(t=>{
      tTot[t.task_type]=(tTot[t.task_type]||0)+1;
      if(t.success) tSuc[t.task_type]=(tSuc[t.task_type]||0)+1;
    });
    const types=Object.keys(tTot);
    const rates=types.map(tp=>tTot[tp]?(tSuc[tp]||0)/tTot[tp]*100:0);
    this._plt('l1-type', [{type:'bar', orientation:'h', y:types, x:rates,
      marker:{color:rates.map(v=>v>=90?'#4ade8080':v>=70?'#facc1580':'#f8717180'), line:{color:rates.map(v=>v>=90?'#4ade80':v>=70?'#facc15':'#f87171'), width:1}}}],
      {xaxis:{...scX,range:[0,100],ticksuffix:'%'}, yaxis:{...scY,automargin:true}, ...noLeg, margin:{t:10,b:10,l:120,r:16}});

    // ── Failure reason pie ──
    const errTypes = {};
    (d.tasks||[]).filter(t=>!t.success).forEach(t=>{
      (t.errors||[]).forEach(e=>{
        const et = (typeof e==='string'?e:(e.type||e.error_type||String(e))).split(':')[0].trim().substring(0,20)||'Unknown';
        errTypes[et]=(errTypes[et]||0)+1;
      });
      if(!(t.errors||[]).length) errTypes['Unknown']=(errTypes['Unknown']||0)+1;
    });
    if(Object.keys(errTypes).length>0){
      this._plt('l1-fail-reason',[{type:'pie',values:Object.values(errTypes),labels:Object.keys(errTypes),
        marker:{colors:['#f87171','#fb923c','#facc15','#a78bfa','#60a5fa']},textinfo:'label+percent',textfont:{color:TC,size:10}}],
        {height:200,showlegend:false,margin:{t:10,b:10,l:10,r:10}});
    }

    // ── Health gauge ──
    const hs = this.hs;
    const gc = hs>=80?'#4ade80':hs>=60?'#facc15':'#f87171';
    const hl = this.hl;
    Plotly.react('gauge-c', [{
      type:'indicator', mode:'gauge+number',
      value: hs,
      number: {font:{size:26, color: this.dark?'#e2e4f0':'#1a1d2e'}},
      title: {text:hl, font:{size:9, color:TC}},
      gauge: {
        axis:{range:[0,100], tickcolor:TC, tickfont:{color:TC,size:8}},
        bar:{color:gc},
        bgcolor:'rgba(255,255,255,0.04)',
        borderwidth:0,
        steps:[{range:[0,60],color:'rgba(248,113,113,0.12)'},{range:[60,80],color:'rgba(250,204,21,0.12)'},{range:[80,100],color:'rgba(74,222,128,0.12)'}],
      },
    }], {
      paper_bgcolor:'transparent', margin:{t:20,b:10,l:20,r:20}, height:140, width:140,
      font:{color:TC, family:"'Segoe UI',system-ui,sans-serif"},
    }, {responsive:false, displayModeBar:false, staticPlot:true});

    // ── Accuracy histogram ──
    const accs=(d.tasks||[]).map(t=>t.accuracy_score*100).filter(v=>v>0);
    if (accs.length) {
      this._plt('acc-hist', [{type:'histogram', x:accs, nbinsx:10, marker:{color:'#6c8ef580', line:{color:'#6c8ef5',width:1}}}],
        {xaxis:{...scX,title:{text:'Accuracy %',font:{color:TC,size:10}}}, yaxis:scY, ...noLeg, height:220,
         shapes:[{type:'line',x0:this.thresholds.acc,x1:this.thresholds.acc,yref:'paper',y0:0,y1:1,line:{color:'#facc15',dash:'dash',width:1.5}}],
         annotations:[{x:this.thresholds.acc,yref:'paper',y:1,text:`목표 ${this.thresholds.acc}%`,showarrow:false,font:{color:'#facc15',size:10},yanchor:'bottom'}]});
    }

    // ── Accuracy weights ──
    this._plt('acc-weights',[{
      type:'bar',orientation:'h',
      y:['Char Sim','LCS Ratio','Jaccard','Token Overlap'],
      x:[10,20,30,40],
      text:['10%','20%','30%','40%'],
      textposition:'inside',
      marker:{color:['#6c8ef580','#6c8ef5a0','#6c8ef5c0','#6c8ef5']}
    }],{height:80,margin:{t:5,b:5,l:90,r:40},xaxis:{...scX,range:[0,50],showticklabels:false},yaxis:{...scY,automargin:true},...noLeg});

    // ── Quality radar ──
    const qd=d.quality_detail?.dimension_summary||{};
    if (Object.keys(qd).length) {
      const dims=Object.keys(qd), vals=Object.values(qd);
      this._plt('qual-radar', [{type:'scatterpolar', r:[...vals,vals[0]], theta:[...dims,dims[0]],
        fill:'toself', fillcolor:'#6c8ef530', line:{color:'#6c8ef5'}, marker:{color:'#6c8ef5'}}],
        {polar:{radialaxis:{range:[0,2],tickfont:{color:TC},gridcolor:GC},angularaxis:{tickfont:{color:TC}},bgcolor:'transparent'},
         paper_bgcolor:'transparent', ...noLeg, height:240, margin:{t:20,b:20,l:40,r:40}});
    }

    // ── Quality heatmap ──
    const dimSumm = d.quality_detail?.dimension_summary||{};
    const dims = Object.keys(dimSumm);
    if(dims.length>0){
      const typeMap={};
      (d.tasks||[]).forEach(t=>{
        if(!typeMap[t.task_type]) typeMap[t.task_type]={};
        dims.forEach(dim=>{
          if(!typeMap[t.task_type][dim]) typeMap[t.task_type][dim]=[];
        });
      });
      // Build per-type dimension averages from quality_detail evaluations
      const evals=d.quality_detail?.evaluations||[];
      evals.forEach(ev=>{
        const tp=ev.task_type||'Unknown';
        if(!typeMap[tp]) typeMap[tp]={};
        dims.forEach(dim=>{
          if(ev[dim]!=null){
            if(!typeMap[tp][dim]) typeMap[tp][dim]=[];
            typeMap[tp][dim].push(+ev[dim]);
          }
        });
      });
      const qualTypes=Object.keys(typeMap).filter(tp=>dims.some(dd=>typeMap[tp][dd]?.length>0));
      if(qualTypes.length>0){
        const z=qualTypes.map(tp=>dims.map(dim=>{
          const arr=typeMap[tp][dim]||[];
          return arr.length?+(arr.reduce((s,v)=>s+v,0)/arr.length*10).toFixed(1):null;
        }));
        this._plt('qual-heatmap',[{type:'heatmap',z,x:dims,y:qualTypes,
          colorscale:[[0,'#f87171'],[0.5,'#facc15'],[1,'#4ade80']],
          zmin:0,zmax:10,text:z,texttemplate:'%{text}',showscale:true,
          colorbar:{tickfont:{color:TC},len:0.8}}],
          {margin:{t:10,b:60,l:120,r:60},xaxis:{...scX,automargin:true},yaxis:{...scY,automargin:true}});
      } else {
        // Fallback: use dimension_summary global averages as single-row heatmap
        const vals=dims.map(dim=>+(dimSumm[dim]||0));
        this._plt('qual-heatmap',[{type:'bar',x:dims,y:vals,marker:{color:vals.map(v=>v>=8?'#4ade80':v>=6?'#facc15':'#f87171')}}],
          {xaxis:{...scX,automargin:true},yaxis:{...scY,range:[0,10]},...noLeg,margin:{t:10,b:60,l:40,r:10}});
      }
    }

    // ── RAG bar ──
    const rk=['faithfulness','answer_relevancy','context_recall','context_precision'];
    const rvs=rk.map(k=>{ const arr=d.advanced?.rag_metrics?.[k]||[]; return arr.length?arr.reduce((a,b)=>a+b,0)/arr.length:0; });
    if (rvs.some(v=>v>0)) {
      this._plt('rag-bar', [{type:'bar', x:rk.map(k=>k.replace(/_/g,'<br>')), y:rvs, marker:{color:'#6c8ef580',line:{color:'#6c8ef5',width:1}}}],
        {xaxis:scX, yaxis:{...scY,range:[0,1]}, ...noLeg,
         shapes:[{type:'line',x0:-0.5,x1:rk.length-0.5,xref:'x',y0:0.8,y1:0.8,line:{color:'#4ade80',dash:'dot',width:1.5}}],
         annotations:[{x:rk.length-0.5,y:0.8,text:'목표 0.8',showarrow:false,font:{color:'#4ade80',size:9},xanchor:'right',yanchor:'bottom'}]});
    }

    // ── Tool efficiency bar ──
    const te=d.agentic?.tool_efficiency||{};
    if (te.total_calls) {
      this._plt('teff-bar', [{type:'bar',
        x:['성공률','효율성','중복률','실패률'],
        y:[te.success_rate,te.avg_efficiency_score,te.redundancy_rate,te.failure_rate].map(v=>v||0),
        marker:{color:['#4ade8080','#6c8ef580','#facc1580','#f8717180'], line:{color:['#4ade80','#6c8ef5','#facc15','#f87171'],width:1}}}],
        {xaxis:scX, yaxis:{...scY,ticksuffix:'%',range:[0,100]}, ...noLeg});
    }

    // ── Retry distribution ──
    const atmCnt={};
    (d.tasks||[]).forEach(t=>{ const a=t.attempts||1; atmCnt[a]=(atmCnt[a]||0)+1; });
    const atmKeys=Object.keys(atmCnt).map(Number).sort((a,b)=>a-b);
    this._plt('l2-retry-dist',[{type:'bar',x:atmKeys.map(k=>`${k}회`),y:atmKeys.map(k=>atmCnt[k]),
      marker:{color:atmKeys.map(k=>k===1?'#4ade80':k<=2?'#facc15':'#f87171')}}],
      {xaxis:{...scX},yaxis:{...scY,title:{text:'태스크 수',font:{color:TC,size:10}}},...noLeg});

    // ── Retry by task type ──
    const typeAtm={};
    (d.tasks||[]).forEach(t=>{
      if(!typeAtm[t.task_type]) typeAtm[t.task_type]=[];
      typeAtm[t.task_type].push(t.attempts||1);
    });
    const taTypes=Object.keys(typeAtm);
    const taAvg=taTypes.map(tp=>+(typeAtm[tp].reduce((s,v)=>s+v,0)/typeAtm[tp].length).toFixed(2));
    this._plt('l2-retry-type',[{type:'bar',orientation:'h',y:taTypes,x:taAvg,
      marker:{color:taAvg.map(v=>v<=1.2?'#4ade80':v<=1.5?'#facc15':'#f87171')}}],
      {xaxis:{...scX,title:{text:'평균 시도 횟수',font:{color:TC,size:10}}},yaxis:{...scY,automargin:true},...noLeg,margin:{t:10,b:30,l:120,r:16}});

    // ── Latency percentile bar ──
    const lat=d.efficiency_metrics?.latency||{};
    this._plt('lat-bar', [{type:'bar', x:['P50','P95','P99','Max'],
      y:[lat.p50,lat.p95,lat.p99,lat.max].map(v=>+(v||0).toFixed(3)),
      marker:{color:['#4ade8080','#facc1580','#f8717180','#f8717180'], line:{color:['#4ade80','#facc15','#f87171','#f87171'],width:1}}}],
      {xaxis:scX, yaxis:{...scY,ticksuffix:'s'}, ...noLeg});

    // ── Latency histogram ──
    const lats=(d.tasks||[]).map(t=>t.execution_time).filter(v=>v>0);
    if (lats.length) {
      this._plt('lat-hist', [{type:'histogram', x:lats, nbinsx:8, marker:{color:'#6c8ef580',line:{color:'#6c8ef5',width:1}}}],
        {xaxis:{...scX,ticksuffix:'s',tickangle:-30,nticks:6,automargin:true}, yaxis:scY, ...noLeg, margin:{t:10,b:50,l:46,r:10}});
    }

    // ── Latency box plot ──
    if (lats.length) {
      this._plt('lat-box', [{type:'box', y:lats, name:'Latency',
        marker:{color:'#6c8ef5'}, fillcolor:'#6c8ef520', line:{color:'#6c8ef5'},
        boxmean:'sd',
        hovertemplate:'%{y:.3f}s<extra></extra>'}],
        {yaxis:{...scY,ticksuffix:'s'}, ...noLeg,
         shapes:[{type:'line',x0:-0.5,x1:0.5,xref:'x',y0:this.thresholds.p95,y1:this.thresholds.p95,
           line:{color:'#facc15',dash:'dash',width:1.5}},
         ],
         annotations:[{x:0.5,y:this.thresholds.p95,xref:'x',yref:'y',text:`목표 P95: ${this.thresholds.p95}s`,
           showarrow:false,font:{color:'#facc15',size:10},xanchor:'left'}],
        });
    }
    // ── TaskType별 latency grouped box ──
    const typeMap={};
    (d.tasks||[]).forEach(t=>{ const k=t.task_type||'unknown'; (typeMap[k]=typeMap[k]||[]).push(t.execution_time||0); });
    if (Object.keys(typeMap).length>0) {
      const boxTraces = Object.entries(typeMap).map(([name,vals])=>({
        type:'box', y:vals, name, boxmean:true,
        hovertemplate:`${name}<br>%{y:.3f}s<extra></extra>`,
      }));
      this._plt('lat-type-box', boxTraces, {yaxis:{...scY,ticksuffix:'s'}, showlegend:false, margin:{t:10,b:50,l:46,r:10}});
    }

    // ── Latency vs Accuracy scatter ──
    const scPts = (d.tasks||[]).filter(t=>t.execution_time>0);
    if(scPts.length>0){
      const typeColors={'QA':'#6c8ef5','CODE_GENERATION':'#4ade80','REASONING':'#facc15','DATA_ANALYSIS':'#f87171','SUMMARIZATION':'#a78bfa','TRANSLATION':'#60a5fa'};
      const byType={};
      scPts.forEach(t=>{byType[t.task_type]=byType[t.task_type]||[];byType[t.task_type].push(t);});
      const scTraces=Object.entries(byType).map(([tp,ts])=>({
        type:'scatter',mode:'markers',name:tp,
        x:ts.map(t=>t.execution_time),y:ts.map(t=>t.accuracy_score*100),
        text:ts.map(t=>t.task_id),
        marker:{size:7,color:typeColors[tp]||'#8890b0',opacity:0.7}
      }));
      this._plt('perf-scatter',scTraces,{xaxis:{...scX,title:{text:'Latency (s)',font:{color:TC,size:10}}},yaxis:{...scY,title:{text:'Accuracy (%)',font:{color:TC,size:10}},range:[0,105]},legend:{font:{color:TC,size:10}},margin:{t:10,b:50,l:60,r:10}});
    }

    // ── Token pie ──
    const tok=d.efficiency_metrics?.tokens||{};
    this._plt('tok-pie', [{type:'pie', hole:0.6,
      values:[tok.total_input_tokens||0, tok.total_output_tokens||0],
      labels:['Input','Output'],
      marker:{colors:['#6c8ef5','#4ade80']},
      textinfo:'none'}],
      {height:200, showlegend:true, legend:{font:{color:TC,size:10}}, margin:{t:10,b:10,l:10,r:10}});

    // ── Token histogram ──
    const tkLst=(d.tasks||[]).map(t=>(t.tokens_used?.total||0)).filter(v=>v>0);
    if (tkLst.length) {
      this._plt('tok-hist', [{type:'histogram', x:tkLst, nbinsx:8, marker:{color:'#6c8ef580',line:{color:'#6c8ef5',width:1}}}],
        {xaxis:scX, yaxis:scY, ...noLeg});
    }

    // ── Security radar ──
    const sl1=d.security_l1||{};
    const threatR=sl1.input_security?.threat_rate||0;
    const leakR=sl1.output_leakage?.leakage_rate||0;
    const vioR=sl1.authorization?.violation_rate||0;
    const escR=d.security_l2?.privilege_escalation?.escalation_rate||0;
    const atkR=d.security_l2?.attack_detection?.detection_rate||0;
    if (d.has_security) {
      const dims2=['입력위협','출력유출','권한위반','권한상승','공격탐지'];
      const vals2=[threatR,leakR,vioR,escR,atkR];
      this._plt('sec-radar', [{type:'scatterpolar', r:[...vals2,vals2[0]], theta:[...dims2,dims2[0]],
        fill:'toself', fillcolor:'#f8717130', line:{color:'#f87171'}, marker:{color:'#f87171'}}],
        {polar:{radialaxis:{range:[0,100],tickfont:{color:TC},gridcolor:GC},angularaxis:{tickfont:{color:TC}},bgcolor:'transparent'},
         paper_bgcolor:'transparent', ...noLeg, height:220, margin:{t:20,b:20,l:40,r:40}});
    }

    // ── Framework bar ──
    const fwDist=this.frameworkDist();
    if (fwDist.length) {
      this._plt('fw-bar', [{type:'bar', x:fwDist.map(f=>f.name||'unknown'), y:fwDist.map(f=>f.count),
        marker:{color:'#6c8ef580',line:{color:'#6c8ef5',width:1}}}],
        {xaxis:scX, yaxis:scY, ...noLeg});
    }

    // ── Correlation scatter ──
    const tasks2=d.tasks||[];
    if (tasks2.length>=3) {
      const pts=tasks2.filter(t=>t.execution_time>0&&t.accuracy_score>=0).map(t=>({x:t.execution_time, y:t.accuracy_score*100}));
      this._plt('corr-scatter', [{type:'scatter', mode:'markers',
        x:pts.map(p=>p.x), y:pts.map(p=>p.y),
        text:tasks2.filter(t=>t.execution_time>0&&t.accuracy_score>=0).map(t=>t.task_id),
        hovertemplate:'%{text}<br>Latency: %{x:.2f}s<br>Accuracy: %{y:.1f}%<extra></extra>',
        marker:{color:'#6c8ef560',line:{color:'#6c8ef5',width:1},size:8}}],
        {xaxis:{...scX,title:{text:'Latency (s)',font:{color:TC,size:10}}},
         yaxis:{...scY,title:{text:'Accuracy (%)',font:{color:TC,size:10}}},
         ...noLeg, height:220});
    }

    // ── DeepEval G-Eval histogram ──
    const gEvals=(d.advanced?.per_task||[]).map(t=>t.g_eval_score||t.metrics?.g_eval||0).filter(v=>v>0);
    if (gEvals.length) {
      this._plt('deepeval-hist', [{type:'histogram', x:gEvals, nbinsx:10, marker:{color:'#6c8ef580',line:{color:'#6c8ef5',width:1}}}],
        {xaxis:{...scX,title:{text:'G-Eval Score',font:{color:TC,size:10}}}, yaxis:scY, ...noLeg, height:220});
    }

    // ── Layer 3 charts (same data as layer1 deepeval/rag but for layer3 nav) ──
    if (gEvals.length) {
      this._plt('l3-geval-hist', [{type:'histogram', x:gEvals, nbinsx:10, marker:{color:'#6c8ef580',line:{color:'#6c8ef5',width:1}}}],
        {xaxis:{...scX,title:{text:'G-Eval Score',font:{color:TC,size:10}}}, yaxis:scY, ...noLeg, height:220});
    }
    if (rvs.some(v=>v>0)) {
      this._plt('l3-rag-bar', [{type:'bar', x:rk.map(k=>k.replace(/_/g,'<br>')), y:rvs, marker:{color:'#6c8ef580',line:{color:'#6c8ef5',width:1}}}],
        {xaxis:scX, yaxis:{...scY,range:[0,1]}, ...noLeg,
         shapes:[{type:'line',x0:-0.5,x1:rk.length-0.5,xref:'x',y0:0.8,y1:0.8,line:{color:'#4ade80',dash:'dot',width:1.5}}],
         annotations:[{x:rk.length-0.5,y:0.8,text:'목표 0.8',showarrow:false,font:{color:'#4ade80',size:9},xanchor:'right',yanchor:'bottom'}]});
    }

    // ── Correlation Heatmap (Insights + Transparency) ──
    const cm = this.metricCorrMatrix();
    if (cm.labels.length) {
      const hmTrace = [{
        type:'heatmap', z:cm.z, x:cm.labels, y:cm.labels,
        colorscale:'RdBu', zmid:0, zmin:-1, zmax:1,
        text:cm.z.map(row=>row.map(v=>v.toFixed(2))),
        texttemplate:'%{text}', showscale:true,
        colorbar:{thickness:14, len:0.9, tickfont:{color:TC,size:9}, outlinecolor:GC},
        hovertemplate:'%{y} × %{x}: %{z:.3f}<extra></extra>',
      }];
      const hmLayout = {xaxis:{...scX,tickangle:-20,automargin:true}, yaxis:{...scY,automargin:true}, height:300, margin:{t:10,b:70,l:90,r:60}};
      this._plt('corr-heatmap',    hmTrace, hmLayout);
      this._plt('tr-corr-heatmap', hmTrace, hmLayout);
    }

    // ── Security Event Timeline ──
    const secEvts = this.secEventTimeline();
    if (secEvts.length) {
      const layerColors = {'L1 입력위협':'#f87171','L1 출력유출':'#fb923c','L2 고급위협':'#facc15'};
      const layers = Object.keys(layerColors);
      const timelineTraces = layers.map(layer=>{
        const pts = secEvts.filter(e=>e.layer===layer);
        if (!pts.length) return null;
        return {
          type:'scatter', mode:'markers', name:layer,
          x:pts.map(e=>e.idx), y:pts.map(e=>e.category),
          text:pts.map(e=>`[${e.layer}] ${e.taskId}<br>위협: ${e.category}<br>위험도: ${e.risk}`),
          hovertemplate:'%{text}<extra></extra>',
          marker:{color:layerColors[layer]||'#6c8ef5', size:pts.map(e=>e.risk*5+8), symbol:'circle', opacity:0.85, line:{color:'#ffffff40',width:1}},
        };
      }).filter(Boolean);
      if (timelineTraces.length) {
        this._plt('sec-timeline', timelineTraces, {
          xaxis:{...scX, title:{text:'이벤트 순서',font:{color:TC,size:10}}, automargin:true},
          yaxis:{...scY, automargin:true},
          showlegend:true, legend:{font:{color:TC,size:10},bgcolor:'transparent'},
          height:280, margin:{t:10,b:50,l:130,r:10}
        });
      }
    }

    // ── Agent Network Graph ──
    const net = this.agentNetworkData();
    if (net.nodes.length>=2) {
      const maxCnt = Math.max(...net.edges.map(e=>e.count),1);
      const edgeTraces = net.edges.map(e=>{
        const alpha = 0.2 + 0.7*(e.count/maxCnt);
        const rate = e.count?e.success/e.count:0;
        const col = rate>=0.8?`rgba(74,222,128,${alpha})`:rate>=0.5?`rgba(250,204,21,${alpha})`:`rgba(248,113,113,${alpha})`;
        return {type:'scatter',mode:'lines',
          x:[e.fx,e.tx,null], y:[e.fy,e.ty,null],
          line:{color:col, width:1+3*(e.count/maxCnt)},
          hoverinfo:'skip', showlegend:false};
      });
      const nodeTrace = {
        type:'scatter', mode:'markers+text',
        x:net.nodes.map(n=>n.x), y:net.nodes.map(n=>n.y),
        text:net.nodes.map(n=>n.name),
        textposition:'top center',
        textfont:{color:TC,size:10},
        hovertext:net.nodes.map(n=>`${n.name}<br>연결수: ${n.degree}`),
        hovertemplate:'%{hovertext}<extra></extra>',
        marker:{color:'#6c8ef5', size:net.nodes.map(n=>14+n.degree*3), line:{color:'#ffffff80',width:2}},
        showlegend:false,
      };
      // Dynamic height: 260 + 12px per interaction (capped 380–560)
      const netH = Math.max(380, Math.min(560, (d.agentic?.agent_interactions?.length||0)*12+260));
      this._plt('agent-network', [...edgeTraces, nodeTrace], {
        xaxis:{visible:false, range:[-1.7,1.7]},
        yaxis:{visible:false, range:[-1.7,1.7]},
        paper_bgcolor:'transparent', plot_bgcolor:'transparent',
        dragmode:'pan',
        showlegend:false, height:netH, margin:{t:30,b:30,l:30,r:30},
      }, {
        responsive:true,
        scrollZoom:true,
        displayModeBar:true,
        displaylogo:false,
        modeBarButtonsToRemove:['select2d','lasso2d','toggleSpikelines','hoverClosestCartesian','hoverCompareCartesian'],
      });
    }

    // ── Workflow funnel ──
    const wfSum=d.agentic?.workflow_summary||{};
    const totalTasks=d.total_tasks||0;
    const wfExecs=d.agentic?.workflow_executions||[];
    const wfTaskCount=new Set(wfExecs.map(w=>w.task_id)).size||totalTasks;
    const successSteps=wfExecs.filter(w=>w.success).length;
    const totalSteps=wfExecs.length;
    const wfSuccTasks=Math.round(wfTaskCount*(wfSum.step_success_rate||1));
    if(totalTasks>0){
      const funnelY=['입력 태스크','워크플로우 시작','단계 실행','단계 성공','최종 완료'];
      const funnelX=[totalTasks, wfTaskCount||totalTasks, totalSteps||totalTasks, successSteps||wfSuccTasks, wfSuccTasks||totalTasks];
      this._plt('l2-wf-funnel',[{type:'funnel',y:funnelY,x:funnelX,
        textinfo:'value+percent initial',
        marker:{color:['#6c8ef5','#818cf8','#4ade80','#34d399','#22c55e']},
        connector:{line:{color:'transparent'}}}],
        {margin:{t:10,b:10,l:130,r:60},funnelmode:'stack',
         xaxis:{...scX},yaxis:{...scY,automargin:true}});
    }

    // ── Integrated Security radar (duplicate for intsec tab) ──
    if (d.has_security) {
      const dims3=['입력위협','출력유출','권한위반','권한상승','공격탐지'];
      const vals3=[threatR,leakR,vioR,escR,atkR];
      this._plt('intsec-radar', [{type:'scatterpolar', r:[...vals3,vals3[0]], theta:[...dims3,dims3[0]],
        fill:'toself', fillcolor:'#f8717130', line:{color:'#f87171'}, marker:{color:'#f87171'}}],
        {polar:{radialaxis:{range:[0,100],tickfont:{color:TC},gridcolor:GC},angularaxis:{tickfont:{color:TC}},bgcolor:'transparent'},
         paper_bgcolor:'transparent', ...noLeg, height:240, margin:{t:20,b:20,l:40,r:40}});
    }
  },

  renderTable() {
    const d = this.data; if (!d || !document.getElementById('task-table')) return;
    if (this._taskTable) { this._taskTable.destroy(); this._taskTable=null; }
    const f = this.taskFilter;
    let rows = d.tasks||[];
    if (f.type !== 'all') rows = rows.filter(t=>t.task_type===f.type);
    if (f.status === 'success') rows = rows.filter(t=>t.success);
    else if (f.status === 'fail') rows = rows.filter(t=>!t.success);
    if (f.sort === 'accuracy_score') rows = [...rows].sort((a,b)=>b.accuracy_score-a.accuracy_score);
    else if (f.sort === 'execution_time') rows = [...rows].sort((a,b)=>b.execution_time-a.execution_time);
    else if (f.sort === 'completion_score') rows = [...rows].sort((a,b)=>b.completion_score-a.completion_score);
    this.filteredTaskCount = rows.length;
    this._taskTable = new Tabulator('#task-table', {
      data: rows,
      layout: 'fitDataFill',
      height: '420px',
      rowClick: (e, row) => { this.taskDetail = row.getData(); },
      columns: [
        {title:'Task ID',     field:'task_id',         width:150},
        {title:'Type',        field:'task_type',        width:110},
        {title:'✓',           field:'success',          width:50, formatter:c=>c.getValue()?'✅':'❌'},
        {title:'Completion',  field:'completion_score', width:100, formatter:c=>(c.getValue()*100).toFixed(1)+'%'},
        {title:'Accuracy',    field:'accuracy_score',   width:90,  formatter:c=>(c.getValue()*100).toFixed(1)+'%'},
        {title:'Latency',     field:'execution_time',   width:85,  formatter:c=>c.getValue().toFixed(2)+'s'},
        {title:'Tokens',      field:'tokens_used',      width:70,  formatter:c=>(c.getValue()?.total||0)},
        {title:'Attempts',    field:'attempts',          width:70},
        {title:'Framework',   field:'framework',         width:100, formatter:c=>c.getValue()||'-'},
        {title:'Timestamp',   field:'timestamp',         minWidth:150, formatter:c=>(c.getValue()||'').substring(0,19)},
      ],
    });
  },

  applyTaskFilter() {
    this.renderTable();
  },

  taskTypes() {
    const types = new Set((this.data?.tasks||[]).map(t=>t.task_type).filter(Boolean));
    return [...types];
  },

