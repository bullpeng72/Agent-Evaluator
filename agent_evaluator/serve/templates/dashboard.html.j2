    </div>
    <div class="cg" style="margin-top:12px">
      <div class="cbox"><div class="ct">Latency Box Plot (분포 요약)</div><div id="lat-box" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">TaskType별 Latency 비교</div><div id="lat-type-box" class="plt-chart"></div></div>
    </div>
    <div class="sec">
      <div class="sec-t">🔬 Latency vs Accuracy 상관관계</div>
      <div id="perf-scatter" style="height:260px"></div>
      <div style="font-size:11px;color:var(--text2);margin-top:6px" x-text="pearsonCorr()"></div>
    </div>
  </div>

  <!-- Token -->
  <div x-show="tp==='tok'">
    <div class="kpi-grid">
      <div class="kpi"><div class="kpi-lbl">총 토큰</div><div class="kpi-val" x-text="(data.efficiency_metrics?.tokens?.total_tokens||0).toLocaleString()"></div></div>
      <div class="kpi"><div class="kpi-lbl">Input 토큰</div><div class="kpi-val" x-text="(data.efficiency_metrics?.tokens?.total_input_tokens||0).toLocaleString()"></div></div>
      <div class="kpi"><div class="kpi-lbl">Output 토큰</div><div class="kpi-val" x-text="(data.efficiency_metrics?.tokens?.total_output_tokens||0).toLocaleString()"></div></div>
      <div class="kpi"><div class="kpi-lbl">Task당 평균</div><div class="kpi-val" x-text="Math.round(data.efficiency_metrics?.tokens?.avg_tokens_per_task||0).toLocaleString()"></div></div>
    </div>
    <div class="cg">
      <div class="cbox"><div class="ct">Input / Output 비율</div><div id="tok-pie" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">태스크별 토큰 분포</div><div id="tok-hist" class="plt-chart"></div></div>
    </div>
  </div>

  <!-- Cost -->
  <div x-show="tp==='cost'">
    <div class="kpi-grid">
      <div class="kpi"><div class="kpi-lbl">총 비용</div><div class="kpi-val" x-text="cost(data.efficiency_metrics?.tokens?.total_cost)"></div></div>
      <div class="kpi"><div class="kpi-lbl">Task당 비용</div><div class="kpi-val" x-text="cost(data.efficiency_metrics?.tokens?.avg_cost_per_task)"></div></div>
      <div class="kpi"><div class="kpi-lbl">월간 추정</div><div class="kpi-val" x-text="cost(data.efficiency_metrics?.tokens?.estimated_monthly_cost)"></div></div>
    </div>
    <div class="sec">
      <div class="drow"><span class="dk">Input 단가</span><span x-text="'$'+(data.pricing?.input||0).toFixed(4)+' / 1K tokens'"></span></div>
      <div class="drow"><span class="dk">Output 단가</span><span x-text="'$'+(data.pricing?.output||0).toFixed(4)+' / 1K tokens'"></span></div>
      <div class="drow"><span class="dk">P50 비용</span><span x-text="cost(data.efficiency_metrics?.tokens?.cost_percentiles?.p50)"></span></div>
      <div class="drow"><span class="dk">P90 비용</span><span x-text="cost(data.efficiency_metrics?.tokens?.cost_percentiles?.p90)"></span></div>
    </div>
  </div>

  <!-- Framework Distribution -->
  <div x-show="tp==='fw'">
    <div x-show="!frameworkDist().length" class="empty"><p>Framework 정보 없음 — 태스크에 framework 필드를 설정하세요.</p></div>
    <div x-show="frameworkDist().length>0">
      <div class="kpi-grid">
        <template x-for="fw in frameworkDist()" :key="fw.name">
          <div class="kpi">
            <div class="kpi-lbl" x-text="fw.name||'unknown'"></div>
            <div class="kpi-val" x-text="fw.count+'건'"></div>
            <div class="kpi-sub" style="color:var(--text2)" x-text="pct(fw.rate)+'  성공률'"></div>
          </div>
