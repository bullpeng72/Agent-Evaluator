  async init() {
    this.dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    await this.refresh();
    if (WATCH) {
      this.startSSE();
      // 폴링 백업: SSE 수신 실패 시에도 5초마다 파일 목록 자동 갱신
      setInterval(() => this.refresh(), 5000);
    }
    await this.loadGoldenList();
    // Load persisted thresholds from server
    try {
      const r = await fetch('/api/thresholds');
      if (r.ok) { const d = await r.json(); this.thresholds = {...this.thresholds, ...d}; }
    } catch(e) { /* ignore — keep defaults */ }
    // Plotly charts rendered in hidden divs (x-show) get 0 dimensions.
    // Re-dispatch resize whenever any tab variable changes so Plotly relayouts.
    // Re-render all charts when any tab changes (resize alone can't fix corrupted categorical axes)
    const _rerender = () => this.$nextTick(() => this.renderAll());
    ['sec','t1','t2','tp','tsec','ti','ttr','tl3','tq','tperf','tag','tsec2'].forEach(k => this.$watch(k, _rerender));
  },

  async refresh() {
    try {
      const r = await fetch('/api/results', {cache: 'no-store'});
      const rd = await r.json();
      // /api/results returns { total, page, files: [...] } — extract the array
      this.files = Array.isArray(rd) ? rd : (rd.files ?? []);
      this.lastUpd = new Date().toLocaleTimeString('ko-KR');
      // Invalidate transparency list cache so new files are picked up
      this.trData = { traces:[], annotations:[], audit:[], auditItems:[] };
      this.trDetail = {};
      this.annDetail = {};
      // x-for 옵션 렌더링 완료 후 selId 설정
      await this.$nextTick();
      if (this.files.length > 0 && !this.selId) {
        this.selId = this.files[0].id;
        await this.$nextTick();
        await this.loadFile(this.selId);
      }
    } catch(e) { console.error(e); }
  },

  async loadFile(id) {
    if (!id) { this.data = null; return; }
    this.loading = true;
    // Invalidate transparency caches — they are global, not per-file
    this.trData = { traces:[], annotations:[], audit:[], auditItems:[] };
    this.trDetail = {};
    this.annDetail = {};
    try {
      const [r, rConv, rFb, rAnomaly, rCost] = await Promise.all([
        fetch(`/api/results/${id}`),
        fetch(`/api/conversation/${id}`).catch(()=>null),
        fetch(`/api/feedback/${id}`).catch(()=>null),
        fetch(`/api/anomalies/${id}`).catch(()=>null),
        fetch(`/api/cost/${id}`).catch(()=>null),
      ]);
      this.data = await r.json();
      this.convData    = (rConv    && rConv.ok)    ? await rConv.json()    : null;
      this.feedbackData= (rFb      && rFb.ok)      ? await rFb.json()      : null;
      this.anomalyData = (rAnomaly && rAnomaly.ok) ? await rAnomaly.json() : null;
      this.costData    = (rCost    && rCost.ok)    ? await rCost.json()    : null;
      this.convSelected = null;
      this.lastUpd = new Date().toLocaleTimeString('ko-KR');
      await this.$nextTick();
      this.renderAll();
      this.renderTable();
    } catch(e) { console.error(e); }
    finally { this.loading = false; }
  },

  async loadAlerts() {
    try {
      const [rToday, rSummary] = await Promise.all([
        fetch('/api/alerts/today').catch(()=>null),
        fetch('/api/alerts/summary').catch(()=>null),
      ]);
      const today   = (rToday   && rToday.ok)   ? await rToday.json()   : {};
      const summary = (rSummary && rSummary.ok) ? await rSummary.json() : {};
      this.alertData = { today, summary };
    } catch(e) { console.error(e); }
  },

  async loadRealtime() {
    try {
      const r = await fetch('/api/stream/live-stats').catch(()=>null);
      if (r && r.ok) this.realtimeStats = await r.json();
    } catch(e) {}
  },

  // ── Phase 1: Deployment Gate & Trend ──

  prevFile() {
    if (!this.selId || this.files.length < 2) return null;
    const idx = this.files.findIndex(f => f.id === this.selId);
    return (idx >= 0 && idx + 1 < this.files.length) ? this.files[idx + 1] : null;
  },

  deltaFmt(curr, prev, higherBetter = true, unit = '%') {
    if (prev == null || curr == null || isNaN(prev) || isNaN(curr)) return null;
    const d = curr - prev;
    if (Math.abs(d) < 0.005) return { txt: '─ 변화없음', cls: 'neu' };
    const up = d > 0;
    const good = higherBetter ? up : !up;
    let fmtVal;
    if (unit === '$') fmtVal = '$' + parseFloat(Math.abs(d).toFixed(4));
    else if (unit === 's') fmtVal = Math.abs(d).toFixed(3) + 's';
    else fmtVal = Math.abs(d).toFixed(1) + '%';
    return { txt: `${up ? '▲' : '▼'} ${fmtVal}`, cls: good ? 'up' : 'dn' };
  },

  deployGates() {
    if (!this.data) return [];
    const tcr  = this.tcr()  || 0;
    const acc  = this.acc()  || 0;
    const hall = this.hall() || 0;
    const p95  = this.data.efficiency_metrics?.latency?.p95 || 0;
    const cost = this.data.efficiency_metrics?.tokens?.avg_cost_per_task || 0;
    // Derive gate thresholds from user settings (dev = relaxed, staging = target, prod = strict)
    const t = this.thresholds;
    const devTCR  = Math.max(50, t.tcr  - 10);
    const devACC  = Math.max(30, t.acc  - 15);
    const devHALL = t.hall * 2;
    const stgTCR  = t.tcr;
    const stgACC  = Math.min(100, t.acc + 5);
    const stgHALL = t.hall;
    const stgP95  = t.p95;
    const prdTCR  = Math.min(100, t.tcr  + 5);
    const prdACC  = Math.min(100, t.acc  + 10);
    const prdHALL = +(t.hall * 0.6).toFixed(1);
    const prdP95  = +(t.p95  * 0.75).toFixed(1);
    const prdCOST = t.cost;
    const gates = [
      {
        label: '🔬 개발', key: 'dev',
        criteria: [
          { name: `TCR ≥ ${devTCR}%`,      pass: tcr  >= devTCR,  val: `${tcr.toFixed(1)}%`  },
          { name: `Accuracy ≥ ${devACC}%`, pass: acc  >= devACC,  val: `${acc.toFixed(1)}%`  },
          { name: `Hall ≤ ${devHALL}%`,    pass: hall <= devHALL, val: `${hall.toFixed(1)}%` },
        ]
      },
      {
        label: '🚀 스테이징', key: 'staging',
        criteria: [
          { name: `TCR ≥ ${stgTCR}%`,      pass: tcr  >= stgTCR,  val: `${tcr.toFixed(1)}%`  },
          { name: `Accuracy ≥ ${stgACC}%`, pass: acc  >= stgACC,  val: `${acc.toFixed(1)}%`  },
          { name: `Hall ≤ ${stgHALL}%`,    pass: hall <= stgHALL, val: `${hall.toFixed(1)}%` },
          { name: `P95 ≤ ${stgP95}s`,      pass: p95  <= stgP95,  val: `${p95.toFixed(2)}s`  },
        ]
      },
      {
        label: '🏭 프로덕션', key: 'prod',
        criteria: [
          { name: `TCR ≥ ${prdTCR}%`,           pass: tcr  >= prdTCR,  val: `${tcr.toFixed(1)}%`  },
          { name: `Accuracy ≥ ${prdACC}%`,      pass: acc  >= prdACC,  val: `${acc.toFixed(1)}%`  },
          { name: `Hall ≤ ${prdHALL}%`,         pass: hall <= prdHALL, val: `${hall.toFixed(1)}%` },
          { name: `P95 ≤ ${prdP95}s`,           pass: p95  <= prdP95,  val: `${p95.toFixed(2)}s`  },
          { name: `Cost ≤ $${parseFloat(prdCOST.toFixed(3))}/task`, pass: cost <= prdCOST, val: `$${parseFloat(cost.toFixed(4))}`  },
        ]
      },
    ];
    return gates.map(g => ({
      ...g,
      passed: g.criteria.filter(c => c.pass).length,
      total:  g.criteria.length,
      cls:    g.criteria.every(c => c.pass)  ? 'pass'
            : g.criteria.every(c => !c.pass) ? 'fail'
            : 'partial',
    }));
  },

  renderTrend() {
    if (this.files.length < 2) return;
    const TC = this.dark ? '#8890b0' : '#5a6080';
    const GC = this.dark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.07)';
    const sorted = [...this.files].reverse(); // oldest first
    const names  = sorted.map(f => f.name.substring(0, 18));
    const curIdx = sorted.findIndex(f => f.id === this.selId);
    const mkMarker = (arr) => ({
      size: arr.map((_,i) => i === curIdx ? 10 : 6),
      opacity: arr.map((_,i) => i === curIdx ? 1 : 0.6),
    });
    const tcrY  = sorted.map(f => +(f.tcr || 0));
    const accY  = sorted.map(f => +(f.accuracy || 0));
    const latY  = sorted.map(f => +(f.avg_latency || 0));
    const traces = [
      { name:'TCR %',      x:names, y:tcrY, mode:'lines+markers', line:{color:'#6c8ef5',width:2}, marker:{...mkMarker(tcrY), color:'#6c8ef5'}, yaxis:'y' },
      { name:'Accuracy %', x:names, y:accY, mode:'lines+markers', line:{color:'#4ade80',width:2}, marker:{...mkMarker(accY), color:'#4ade80'}, yaxis:'y' },
      { name:'Latency s',  x:names, y:latY, mode:'lines+markers', line:{color:'#facc15',width:1.5,dash:'dot'}, marker:{...mkMarker(latY), color:'#facc15'}, yaxis:'y2' },
    ];
    const layout = {
      height:200, margin:{t:10,b:40,l:40,r:50},
      xaxis:  {tickfont:{color:TC,size:9}, gridcolor:GC, automargin:true},
      yaxis:  {tickfont:{color:TC}, gridcolor:GC, range:[0,105], ticksuffix:'%', title:{text:'%', font:{color:TC,size:10}}},
      yaxis2: {tickfont:{color:TC}, gridcolor:GC, overlaying:'y', side:'right', title:{text:'s', font:{color:TC,size:10}}},
      legend: {font:{color:TC,size:10}, orientation:'h', y:1.15},
      paper_bgcolor:'transparent', plot_bgcolor:'transparent', autosize:true,
      shapes: [
        {type:'line', x0:0, x1:1, xref:'paper', y0:this.thresholds.tcr, y1:this.thresholds.tcr, yref:'y', line:{color:'#6c8ef560',dash:'dash',width:1}},
        {type:'line', x0:0, x1:1, xref:'paper', y0:this.thresholds.acc, y1:this.thresholds.acc, yref:'y', line:{color:'#4ade8060',dash:'dash',width:1}},
      ],
    };
    if (window.Plotly && document.getElementById('ov-trend')) {
      Plotly.react('ov-trend', traces, layout, {responsive:true, displayModeBar:false});
    }
  },

  startSSE() {
    const es = new EventSource('/api/stream');
    es.onopen = () => { this.connected = true; };
    es.onerror = () => { this.connected = false; };
    es.onmessage = async e => {
      const m = JSON.parse(e.data);
      if (m.type === 'update') { await this.refresh(); if (this.selId) await this.loadFile(this.selId); }
    };
  },

  // ── Chart helpers ──────────────────────────────────────────────────────
  _plt(id, traces, layout, cfg) {
    const el = document.getElementById(id);
    if (!el || el.clientWidth === 0) return; // skip hidden x-show divs (avoids 0×0 Plotly corruption)
    const TC = this.dark ? '#8890b0' : '#5a6080';
    const GC = this.dark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.07)';
    const PBG = 'transparent';
    const base = {
      margin: {t:10, b:40, l:50, r:16, pad:2},
      paper_bgcolor: PBG, plot_bgcolor: PBG,
      font: {color: TC, size: 11, family: "'Segoe UI',system-ui,sans-serif"},
      xaxis: {tickfont:{color:TC,size:10}, gridcolor:GC, zerolinecolor:GC, automargin:true},
      yaxis: {tickfont:{color:TC,size:10}, gridcolor:GC, zerolinecolor:GC, automargin:true},
      showlegend: false,
      height: 200,
      autosize: true,
      modebar: {remove: ['all']},
    };
    Plotly.react(el, traces, Object.assign({}, base, layout), Object.assign({responsive:true, displayModeBar:false, scrollZoom:false}, cfg||{}));
  },

  renderAll() {
    const d = this.data; if (!d) return;
    this.renderTrend();
    const TC = this.dark ? '#8890b0' : '#5a6080';
    const GC = this.dark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.07)';
    const scX = {tickfont:{color:TC}, gridcolor:GC, zerolinecolor:GC};
    const scY = {tickfont:{color:TC}, gridcolor:GC, zerolinecolor:GC};
    const noLeg = {showlegend:false};

    // ── Overview donut (success/fail) ──
    const tcr = d.accuracy_metrics?.tcr||{};
    const full=tcr.full_success||0, part=tcr.partial_success||0;
    const fail=tcr.failures||(d.total_tasks-(full+part));
    const donutTrace = [{
      type:'pie', hole:0.7,
      values:[full,part,fail],
      labels:['완전성공','부분성공','실패'],
      marker:{colors:['#4ade80','#facc15','#f87171']},
      textinfo:'none',
    }];
    const donutLayout = {height:200, showlegend:true, legend:{font:{color:TC,size:10}}, margin:{t:10,b:10,l:10,r:10}};
    this._plt('ov-donut', donutTrace, donutLayout);
    this._plt('l1-donut', donutTrace, donutLayout);

    // ── Overview type bar ──
    const typeCnt={};
    (d.tasks||[]).forEach(t=>{ typeCnt[t.task_type]=(typeCnt[t.task_type]||0)+1; });
    this._plt('ov-type', [{type:'bar', x:Object.keys(typeCnt), y:Object.values(typeCnt), marker:{color:'#6c8ef580', line:{color:'#6c8ef5',width:1}}}],
      {xaxis:scX, yaxis:scY, ...noLeg});

    // ── Layer1 type success rates (horizontal) ──
    const tSuc={},tTot={};
    (d.tasks||[]).forEach(t=>{
      tTot[t.task_type]=(tTot[t.task_type]||0)+1;
      if(t.success) tSuc[t.task_type]=(tSuc[t.task_type]||0)+1;
    });
    const types=Object.keys(tTot);
    const rates=types.map(tp=>tTot[tp]?(tSuc[tp]||0)/tTot[tp]*100:0);
    this._plt('l1-type', [{type:'bar', orientation:'h', y:types, x:rates,
      text:rates.map(v=>v.toFixed(1)+'%'), textposition:'inside', insidetextanchor:'middle',
      textfont:{color:'#444',size:12,family:'system-ui'},
      marker:{color:rates.map(v=>v>=90?'#4ade8080':v>=70?'#facc1580':'#f8717180'), line:{color:rates.map(v=>v>=90?'#4ade80':v>=70?'#facc15':'#f87171'), width:1}}}],
      {xaxis:{...scX,range:[0,100],showticklabels:false,showgrid:false,zeroline:false},
       yaxis:{...scY,automargin:true}, ...noLeg, margin:{t:10,b:10,l:100,r:10}});

    // ── Failure reason pie ──
    const errTypes = {};
    (d.tasks||[]).filter(t=>!t.success).forEach(t=>{
      (t.errors||[]).forEach(e=>{
        const et = (typeof e==='string'?e:(e.type||e.error_type||String(e))).split(':')[0].trim().substring(0,20)||'Unknown';
        errTypes[et]=(errTypes[et]||0)+1;
      });
      if(!(t.errors||[]).length) errTypes['Unknown']=(errTypes['Unknown']||0)+1;
    });
    if(Object.keys(errTypes).length>0){
      this._plt('l1-fail-reason',[{type:'pie',values:Object.values(errTypes),labels:Object.keys(errTypes),
        marker:{colors:['#f87171','#fb923c','#facc15','#a78bfa','#60a5fa']},
        textinfo:'percent',textfont:{color:'#fff',size:12},
        domain:{x:[0.15,0.5]},
        hovertemplate:'%{label}<br>%{value}건 (%{percent})<extra></extra>'}],
        {height:240,showlegend:true,
         legend:{font:{color:TC,size:12},orientation:'v',x:0.55,xanchor:'left',y:0.5,yanchor:'middle'},
         margin:{t:10,b:10,l:10,r:10}});
    }

    // ── Health gauge ──
    const hs = this.hs();
    const gc = hs>=80?'#4ade80':hs>=60?'#facc15':'#f87171';
    const hl = this.hl();
    Plotly.react('gauge-c', [{
      type:'indicator', mode:'gauge+number',
      value: hs,
      number: {font:{size:26, color: this.dark?'#e2e4f0':'#1a1d2e'}},
      title: {text:hl, font:{size:9, color:TC}},
      gauge: {
        axis:{range:[0,100], tickcolor:TC, tickfont:{color:TC,size:8}},
        bar:{color:gc},
        bgcolor:'rgba(255,255,255,0.04)',
        borderwidth:0,
        steps:[{range:[0,60],color:'rgba(248,113,113,0.12)'},{range:[60,80],color:'rgba(250,204,21,0.12)'},{range:[80,100],color:'rgba(74,222,128,0.12)'}],
      },
    }], {
      paper_bgcolor:'transparent', margin:{t:20,b:10,l:20,r:20}, height:140, width:140,
      font:{color:TC, family:"'Segoe UI',system-ui,sans-serif"},
    }, {responsive:false, displayModeBar:false, staticPlot:true});

    // ── Accuracy strip chart (TaskType별) ──
    {
      const atasks=(d.tasks||[]).filter(t=>t.accuracy_score>0);
      if(atasks.length){
        const typeOrder=[...new Set(atasks.map(t=>t.task_type))].sort();
        const byType={};
        atasks.forEach(t=>{(byType[t.task_type]=byType[t.task_type]||[]).push(t);});
        const jitter=(i,n)=>n>1?(i/(n-1)-0.5)*0.55:0;
        const traces=typeOrder.map(typ=>{
          const tl=byType[typ]||[];
          return{type:'scatter',mode:'markers',name:typ,
            x:tl.map(t=>+(t.accuracy_score*100).toFixed(1)),
            y:tl.map((t,i)=>typ+(tl.length>1?(jitter(i,tl.length)*0.7).toFixed(3):'')),
            text:tl.map(t=>`${t.task_id}<br>정확도: ${(t.accuracy_score*100).toFixed(1)}%<br>타입: ${t.task_type}<br>${t.success?'✅ 성공':'❌ 실패'}`),
            hovertemplate:'%{text}<extra></extra>',
            marker:{size:9,color:tl.map(t=>t.success?'#4ade80':'#f87171'),line:{color:'rgba(0,0,0,0.15)',width:1},opacity:0.85}};
        });
        const rowH=Math.max(44,Math.min(64,280/Math.max(typeOrder.length,1)));
        const chartH=Math.max(180,typeOrder.length*rowH+60);
        this._plt('acc-hist',traces,{
          xaxis:{...scX,range:[-2,102],title:{text:'정확도 %',font:{color:TC,size:10}},
                 tickvals:[0,20,40,60,80,100],ticktext:['0%','20%','40%','60%','80%','100%']},
          yaxis:{...scY,automargin:true,categoryorder:'array',categoryarray:typeOrder},
          showlegend:false,height:chartH,margin:{t:28,b:36,l:90,r:16},
          shapes:[{type:'line',x0:this.thresholds.acc,x1:this.thresholds.acc,yref:'paper',y0:0,y1:1,line:{color:'#facc15',dash:'dash',width:1.5}}],
          annotations:[{x:this.thresholds.acc,yref:'paper',y:1.02,text:`목표 ${this.thresholds.acc}%`,showarrow:false,font:{color:'#facc15',size:10},yanchor:'bottom'}]});
      }
    }

    // ── Accuracy weights ──
    const _awDesc=['Levenshtein 거리 기반 (문자 순서 반영, v0.8.0+)','최장 공통 부분 수열 비율 (LCS/max_len)','집합 교집합 ÷ 합집합 (Jaccard Index)','공통 토큰 F1 (Precision × Recall 조화평균, 패딩 방지)'];
    this._plt('acc-weights',[{
      type:'bar',orientation:'h',
      y:['CharSim/Levenshtein','LCS Ratio','Jaccard','Token Overlap F1'],
      x:[10,20,30,40],
      text:['10%','20%','30%','40%'],
      textposition:'inside',
      customdata:_awDesc,
      hovertemplate:'<b>%{y}</b> — 가중치 %{x}%<br><span style="color:#555555">%{customdata}</span><extra></extra>',
      marker:{color:['#6c8ef580','#6c8ef5a0','#6c8ef5c0','#6c8ef5']}
    }],{height:80,margin:{t:5,b:5,l:90,r:40},xaxis:{...scX,range:[0,50],showticklabels:false},yaxis:{...scY,automargin:true},...noLeg});

    // ── Quality radar ──
    const qd=d.quality_detail?.dimension_summary||{};
    if (Object.keys(qd).length) {
      const dims=Object.keys(qd), vals=Object.values(qd);
      this._plt('qual-radar', [{type:'scatterpolar', r:[...vals,vals[0]], theta:[...dims,dims[0]],
        fill:'toself', fillcolor:'#6c8ef530', line:{color:'#6c8ef5'}, marker:{color:'#6c8ef5'}}],
        {polar:{radialaxis:{range:[0,5],tickfont:{color:TC},gridcolor:GC},angularaxis:{tickfont:{color:TC}},bgcolor:'transparent'},
         paper_bgcolor:'transparent', ...noLeg, height:240, margin:{t:20,b:20,l:40,r:40}});
    }

    // ── Quality heatmap ──
    const dimSumm = d.quality_detail?.dimension_summary||{};
    const dims = Object.keys(dimSumm);
    if(dims.length>0){
      const typeMap={};
      (d.tasks||[]).forEach(t=>{
        if(!typeMap[t.task_type]) typeMap[t.task_type]={};
        dims.forEach(dim=>{
          if(!typeMap[t.task_type][dim]) typeMap[t.task_type][dim]=[];
        });
      });
      // Build per-type dimension averages from quality_detail evaluations
      // task_id → task_type 매핑 (evaluations에 task_type 필드 없음)
      const taskTypeMap={};
      (d.tasks||[]).forEach(t=>{taskTypeMap[t.task_id]=t.task_type;});
      const evals=d.quality_detail?.evaluations||[];
      evals.forEach(ev=>{
        const tp=taskTypeMap[ev.task_id]||ev.task_type||'Unknown';
        if(!typeMap[tp]) typeMap[tp]={};
        dims.forEach(dim=>{
          const val=(ev.dimension_scores!=null?ev.dimension_scores[dim]:undefined)??ev[dim];
          if(val!=null){
            if(!typeMap[tp][dim]) typeMap[tp][dim]=[];
            typeMap[tp][dim].push(+val);
          }
        });
      });
      const qualTypes=Object.keys(typeMap).filter(tp=>dims.some(dd=>typeMap[tp][dd]?.length>0));
      if(qualTypes.length>0){
        const z=qualTypes.map(tp=>dims.map(dim=>{
          const arr=typeMap[tp][dim]||[];
          return arr.length?+(arr.reduce((s,v)=>s+v,0)/arr.length).toFixed(2):null;
        }));
        const qHmH=Math.max(220,qualTypes.length*72+80);const qHmEl=document.getElementById('qual-heatmap');if(qHmEl)qHmEl.style.height=qHmH+'px';
        this._plt('qual-heatmap',[{type:'heatmap',z,x:dims,y:qualTypes,
          colorscale:[[0,'#f87171'],[0.5,'#facc15'],[1,'#4ade80']],
          zmin:0,zmax:5,text:z,texttemplate:'%{text:.2f}',showscale:true,
          colorbar:{tickfont:{color:TC},len:0.8}}],
          {height:qHmH,margin:{t:10,b:50,l:120,r:60},xaxis:{...scX,automargin:true},yaxis:{...scY,automargin:true}});
      } else {
        // Fallback: use dimension_summary global averages as single-row heatmap
        const vals=dims.map(dim=>+(dimSumm[dim]||0));
        this._plt('qual-heatmap',[{type:'bar',x:dims,y:vals,marker:{color:vals.map(v=>v>=8?'#4ade80':v>=6?'#facc15':'#f87171')}}],
          {xaxis:{...scX,automargin:true},yaxis:{...scY,range:[0,10]},...noLeg,margin:{t:10,b:60,l:40,r:10}});
      }
    }

    // ── RAG bar ──
    const rk=['faithfulness','answer_relevancy','context_recall','context_precision'];
    const rvs=rk.map(k=>{ const arr=d.advanced?.rag_metrics?.[k]||[]; return arr.length?arr.reduce((a,b)=>a+b,0)/arr.length:0; });
    const _ragOverall=d.advanced?.summary?.ragas_overall_score?.mean||0;
    const rkAll=_ragOverall>0?[...rk,'overall']:rk;
    const rvsAll=_ragOverall>0?[...rvs,_ragOverall]:rvs;
    if (rvsAll.some(v=>v>0)) {
      this._plt('rag-bar', [{type:'bar', x:rkAll.map(k=>k.replace(/_/g,'<br>')), y:rvsAll, hovertemplate:'%{x}: %{y:.3f}<extra></extra>', marker:{color:'#6c8ef580',line:{color:'#6c8ef5',width:1}}}],
        {xaxis:scX, yaxis:{...scY,range:[0,1]}, ...noLeg,
         shapes:[{type:'line',x0:-0.5,x1:rkAll.length-0.5,xref:'x',y0:0.8,y1:0.8,line:{color:'#4ade80',dash:'dot',width:1.5}}],
         annotations:[{x:rkAll.length-0.5,y:0.8,text:'목표 0.8',showarrow:false,font:{color:'#4ade80',size:9},xanchor:'right',yanchor:'bottom'}]});
    }

    // ── Tool efficiency bar ──
    const te=d.agentic?.tool_efficiency||{};
    if (te.total_calls) {
      this._plt('teff-bar', [{type:'bar',
        x:['성공률','효율성','중복률','실패률'],
        y:[te.success_rate,te.avg_efficiency_score,te.redundancy_rate,te.failure_rate].map(v=>v||0),
        marker:{color:['#4ade8080','#6c8ef580','#facc1580','#f8717180'], line:{color:['#4ade80','#6c8ef5','#facc15','#f87171'],width:1}}}],
        {xaxis:scX, yaxis:{...scY,ticksuffix:'%',range:[0,100]}, ...noLeg});
    }

    // ── Retry distribution (retry_attempts 기준으로 통일) ──
    const ra = d.agentic?.retry_attempts || [];
    if (ra.length) {
      const atmCnt={};
      ra.forEach(a=>{ const n=a.total_attempts||1; atmCnt[n]=(atmCnt[n]||0)+1; });
      const atmKeys=Object.keys(atmCnt).map(Number).sort((a,b)=>a-b);
      this._plt('l2-retry-dist',[{type:'bar',x:atmKeys.map(k=>`${k}회`),y:atmKeys.map(k=>atmCnt[k]),
        marker:{color:atmKeys.map(k=>k===1?'#4ade80':k<=2?'#facc15':'#f87171')},
        hovertemplate:'%{x}: %{y}건<extra></extra>'}],
        {xaxis:{...scX},yaxis:{...scY,title:{text:'태스크 수',font:{color:TC,size:10}},dtick:1},...noLeg});
    }

    // ── Retry by task type (task_id로 tasks와 join) ──
    const taskTypeMap={};
    (d.tasks||[]).forEach(t=>{ taskTypeMap[t.task_id]=t.task_type||'unknown'; });
    const typeAtm={};
    ra.forEach(a=>{
      const tp=taskTypeMap[a.task_id]||'unknown';
      if(!typeAtm[tp]) typeAtm[tp]=[];
      typeAtm[tp].push(a.total_attempts||1);
    });
    const taTypes=Object.keys(typeAtm);
    const taAvg=taTypes.map(tp=>+(typeAtm[tp].reduce((s,v)=>s+v,0)/typeAtm[tp].length).toFixed(2));
    this._plt('l2-retry-type',[{type:'bar',orientation:'h',y:taTypes,x:taAvg,
      marker:{color:taAvg.map(v=>v<=1.2?'#4ade80':v<=1.5?'#facc15':'#f87171')},
      hovertemplate:'%{y}: 평균 %{x}회<extra></extra>'}],
      {xaxis:{...scX,title:{text:'평균 시도 횟수',font:{color:TC,size:10}}},yaxis:{...scY,automargin:true},...noLeg,margin:{t:10,b:30,l:120,r:16}});

    // ── Latency percentile bar ──
    const lat=d.efficiency_metrics?.latency||{};
    this._plt('lat-bar', [{type:'bar', x:['P50','P95','P99','Max'],
      y:[lat.p50,lat.p95,lat.p99,lat.max].map(v=>+(v||0).toFixed(3)),
      marker:{color:['#4ade8080','#facc1580','#f8717180','#f8717180'], line:{color:['#4ade80','#facc15','#f87171','#f87171'],width:1}}}],
      {xaxis:scX, yaxis:{...scY,ticksuffix:'s'}, ...noLeg});

    // ── 태스크별 응답시간 bar (per-task) ──
    const latTasks=(d.tasks||[]).filter(t=>t.execution_time>0);
    const lats=latTasks.map(t=>t.execution_time);
    if (latTasks.length) {
      const latIds=latTasks.map((t,i)=>t.task_id||'#'+(i+1));
      const latVals=latTasks.map(t=>+t.execution_time.toFixed(3));
      const thr=this.thresholds.p95;
      const latColors=latVals.map(v=>v<=thr?'#6c8ef580':'#f8717180');
      const latBorder=latVals.map(v=>v<=thr?'#6c8ef5':'#f87171');
      this._plt('lat-hist',[{
        type:'bar',x:latIds,y:latVals,
        marker:{color:latColors,line:{color:latBorder,width:1}},
        hovertemplate:'%{x}<br>%{y:.3f}s<extra></extra>'
      }],{
        xaxis:{...scX,tickangle:-45,automargin:true},
        yaxis:{...scY,ticksuffix:'s'},
        ...noLeg,
        margin:{t:10,b:80,l:50,r:10},
        shapes:[{type:'line',x0:-0.5,x1:latTasks.length-0.5,xref:'x',y0:thr,y1:thr,line:{color:'#facc15',dash:'dash',width:1.5}}],
        annotations:[{x:latTasks.length-1,y:thr,xref:'x',yref:'y',text:'P95 목표: '+thr+'s',showarrow:false,font:{color:'#facc15',size:10},xanchor:'right',yanchor:'bottom'}]
      });
    }

    // ── Latency box plot ──
    if (lats.length) {
      this._plt('lat-box', [{type:'box', y:lats, name:'Latency',
        marker:{color:'#6c8ef5'}, fillcolor:'#6c8ef520', line:{color:'#6c8ef5'},
        boxmean:'sd',
        hovertemplate:'%{y:.3f}s<extra></extra>'}],
        {yaxis:{...scY,ticksuffix:'s'}, ...noLeg,
         shapes:[{type:'line',x0:-0.5,x1:0.5,xref:'x',y0:this.thresholds.p95,y1:this.thresholds.p95,
           line:{color:'#facc15',dash:'dash',width:1.5}},
         ],
         annotations:[{x:0.5,y:this.thresholds.p95,xref:'x',yref:'y',text:`목표 P95: ${this.thresholds.p95}s`,
           showarrow:false,font:{color:'#facc15',size:10},xanchor:'left'}],
        });
    }
    // ── TaskType별 latency grouped box ──
    const typeMap={};
    (d.tasks||[]).filter(t=>t.execution_time>0).forEach(t=>{ const k=t.task_type||'unknown'; (typeMap[k]=typeMap[k]||[]).push(t.execution_time); });
    if (Object.keys(typeMap).length>0) {
      const boxTraces = Object.entries(typeMap).map(([name,vals])=>({
        type:'box', y:vals, name, boxmean:true,
        boxpoints: vals.length < 10 ? 'all' : 'outliers',
        jitter: 0.3, pointpos: 0,
        hovertemplate:`${name}<br>%{y:.3f}s<extra></extra>`,
      }));
      this._plt('lat-type-box', boxTraces, {yaxis:{...scY,ticksuffix:'s'}, showlegend:false, margin:{t:10,b:50,l:46,r:10}});
    }

    // ── TaskType별 P95 레이턴시 bar (SLA 기준선 포함) ──
    const scPts = (d.tasks||[]).filter(t=>t.execution_time>0);
    if(scPts.length>0){
      const byType={};
      scPts.forEach(t=>{byType[t.task_type]=byType[t.task_type]||[];byType[t.task_type].push(t.execution_time);});
      const pct95=(arr)=>{const s=[...arr].sort((a,b)=>a-b);const idx=0.95*(s.length-1);const lo=Math.floor(idx),hi=Math.ceil(idx);return +(s[lo]+(s[hi]-s[lo])*(idx-lo)).toFixed(3);};
      const tpKeys=Object.keys(byType);
      const p95vals=tpKeys.map(tp=>pct95(byType[tp]));
      const thr=this.thresholds.p95;
      const palette=['#6c8ef5','#4ade80','#facc15','#f87171','#a78bfa','#60a5fa','#fb923c','#34d399'];
      const barColors=p95vals.map(v=>v>thr?'#f8717199':'#6c8ef599');
      const barBorder=p95vals.map(v=>v>thr?'#f87171':'#6c8ef5');
      this._plt('perf-scatter',[{
        type:'bar', x:tpKeys, y:p95vals, name:'P95 레이턴시',
        marker:{color:barColors, line:{color:barBorder,width:1}},
        hovertemplate:'%{x}<br>P95: %{y:.3f}s<extra></extra>',
      }],{
        xaxis:{...scX,tickangle:-20,automargin:true},
        yaxis:{...scY,title:{text:'P95 레이턴시 (s)',font:{color:TC,size:10}},tickformat:'.2f',ticksuffix:'s'},
        ...noLeg, margin:{t:10,b:40,l:60,r:16}, height:220,
        shapes:[{type:'line',x0:-0.5,x1:tpKeys.length-0.5,xref:'x',y0:thr,y1:thr,
          line:{color:'#facc15',dash:'dash',width:1.5}}],
        annotations:[{x:tpKeys.length-0.5,y:thr,xref:'x',yref:'y',
          text:`SLA 목표: ${thr}s`,showarrow:false,
          font:{color:'#facc15',size:10},xanchor:'right',yanchor:'bottom'}],
      });
    }

    // ── Token pie ──
    const tok=d.efficiency_metrics?.tokens||{};
    this._plt('tok-pie', [{type:'pie', hole:0.6,
      values:[tok.total_input_tokens||0, tok.total_output_tokens||0],
      labels:['Input','Output'],
      marker:{colors:['#6c8ef5','#4ade80']},
      textinfo:'none'}],
      {height:200, showlegend:true, legend:{font:{color:TC,size:10}}, margin:{t:10,b:10,l:10,r:10}});

    // ── Token bar (task별) ──
    const tkTasks=(d.tasks||[]).map(t=>({id:t.task_id||'?', tok:(t.tokens_used?.total)||(t.tokens_used?.input||0)+(t.tokens_used?.output||0)||0})).filter(t=>t.tok>0);
    if (tkTasks.length) {
      const avg=tkTasks.reduce((s,t)=>s+t.tok,0)/tkTasks.length;
      this._plt('tok-hist',[{
        type:'bar', x:tkTasks.map(t=>t.id), y:tkTasks.map(t=>t.tok),
        marker:{color:tkTasks.map(t=>t.tok>avg*1.5?'#f8717180':t.tok<avg*0.5?'#4ade8080':'#6c8ef580'),
                line:{color:tkTasks.map(t=>t.tok>avg*1.5?'#f87171':t.tok<avg*0.5?'#4ade80':'#6c8ef5'),width:1}},
        hovertemplate:'%{x}<br>%{y:,}토큰<extra></extra>',
      },{
        type:'scatter', mode:'lines', x:tkTasks.map(t=>t.id), y:tkTasks.map(()=>Math.round(avg)),
        line:{color:'#facc15',dash:'dash',width:1.5}, name:'평균', hoverinfo:'skip',
      }],{
        xaxis:{...scX, tickangle: tkTasks.length>8?-40:0, automargin:true},
        yaxis:{...scY, title:{text:'토큰 수',font:{color:TC,size:10}}},
        showlegend:false, margin:{t:10,b:tkTasks.length>8?60:40,l:50,r:10},
        annotations:[{x:tkTasks[tkTasks.length-1]?.id,y:Math.round(avg),xref:'x',yref:'y',
          text:`평균 ${Math.round(avg)}`,showarrow:false,font:{color:'#facc15',size:10},xanchor:'right',yanchor:'bottom'}],
      });
    }

    // ── Security radar ──
    const sl1=d.security_l1||{};
    const threatR=sl1.input_security?.threat_rate||0;
    const leakR=sl1.output_leakage?.leakage_rate||0;
    const vioR=sl1.authorization?.violation_rate||0;
    const escR=d.security_l2?.privilege_escalation?.escalation_rate||0;
    const atkR=d.security_l2?.attack_detection?.detection_rate||0;
    if (d.has_security) {
      const dims2=['입력위협','출력유출','권한위반','권한상승','공격탐지'];
      const vals2=[threatR,leakR,vioR,escR,atkR];
      this._plt('sec-radar', [{type:'scatterpolar', r:[...vals2,vals2[0]], theta:[...dims2,dims2[0]],
        fill:'toself', fillcolor:'#f8717130', line:{color:'#f87171'}, marker:{color:'#f87171'}}],
        {polar:{radialaxis:{range:[0,100],tickfont:{color:TC},gridcolor:GC},angularaxis:{tickfont:{color:TC}},bgcolor:'transparent'},
         paper_bgcolor:'transparent', ...noLeg, height:220, margin:{t:20,b:20,l:40,r:40}});
    }

    // ── Framework bar ──
    const fwDist=this.frameworkDist();
    if (fwDist.length) {
      this._plt('fw-bar', [{type:'bar', x:fwDist.map(f=>f.name||'unknown'), y:fwDist.map(f=>f.count),
        marker:{color:'#6c8ef580',line:{color:'#6c8ef5',width:1}}}],
        {xaxis:scX, yaxis:scY, ...noLeg});
    }

    // ── Correlation scatter ──
    const tasks2=d.tasks||[];
    if (tasks2.length>=3) {
      const pts=tasks2.filter(t=>t.execution_time>0&&t.accuracy_score>=0).map(t=>({x:t.execution_time, y:t.accuracy_score*100}));
      this._plt('corr-scatter', [{type:'scatter', mode:'markers',
        x:pts.map(p=>p.x), y:pts.map(p=>p.y),
        text:tasks2.filter(t=>t.execution_time>0&&t.accuracy_score>=0).map(t=>t.task_id),
        hovertemplate:'%{text}<br>Latency: %{x:.2f}s<br>Accuracy: %{y:.1f}%<extra></extra>',
        marker:{color:'#6c8ef560',line:{color:'#6c8ef5',width:1},size:8}}],
        {xaxis:{...scX,title:{text:'Latency (s)',font:{color:TC,size:10}}},
         yaxis:{...scY,title:{text:'Accuracy (%)',font:{color:TC,size:10}}},
         ...noLeg, height:220});
    }

    // ── DeepEval G-Eval histogram ──
    const gEvals=(d.advanced?.per_task||[]).map(t=>t.g_eval_score||t.metrics?.g_eval||0).filter(v=>v>0);
    if (gEvals.length) {
      this._plt('deepeval-hist', [{type:'histogram', x:gEvals, nbinsx:10, marker:{color:'#6c8ef580',line:{color:'#6c8ef5',width:1}}}],
        {xaxis:{...scX,title:{text:'G-Eval Score',font:{color:TC,size:10}}}, yaxis:scY, ...noLeg, height:220});
    }


    // ── Correlation Heatmap (Insights + Transparency) ──
    const cm = this.metricCorrMatrix();
    if (cm.labels.length) {
      const hmTrace = [{
        type:'heatmap', z:cm.z, x:cm.labels, y:cm.labels,
        colorscale:'RdBu', zmid:0, zmin:-1, zmax:1,
        text:cm.z.map(row=>row.map(v=>v.toFixed(2))),
        texttemplate:'%{text}', showscale:true,
        colorbar:{thickness:14, len:0.9, tickfont:{color:TC,size:9}, outlinecolor:GC},
        hovertemplate:'%{y} × %{x}: %{z:.3f}<extra></extra>',
      }];
      const hmLayout = {xaxis:{...scX,tickangle:-20,automargin:true}, yaxis:{...scY,automargin:true}, height:300, margin:{t:10,b:70,l:90,r:60}};
      this._plt('corr-heatmap',    hmTrace, hmLayout);
      this._plt('tr-corr-heatmap', hmTrace, hmLayout);
    }

    // ── Security Event Timeline ──
    const secEvts = this.secEventTimeline();
    if (secEvts.length) {
      const layerColors = {'L1 입력위협':'#f87171','L1 출력유출':'#fb923c','L2 고급위협':'#facc15'};
      const layers = Object.keys(layerColors);
      const timelineTraces = layers.map(layer=>{
        const pts = secEvts.filter(e=>e.layer===layer);
        if (!pts.length) return null;
        return {
          type:'scatter', mode:'markers', name:layer,
          x:pts.map(e=>e.idx), y:pts.map(e=>e.category),
          text:pts.map(e=>`[${e.layer}] ${e.taskId}<br>위협: ${e.category}<br>위험도: ${e.risk}`),
          hovertemplate:'%{text}<extra></extra>',
          marker:{color:layerColors[layer]||'#6c8ef5', size:pts.map(e=>e.risk*5+8), symbol:'circle', opacity:0.85, line:{color:'#ffffff40',width:1}},
        };
      }).filter(Boolean);
      if (timelineTraces.length) {
        const tlLayout = {
          xaxis:{...scX, title:{text:'이벤트 순서',font:{color:TC,size:10}}, automargin:true},
          yaxis:{...scY, automargin:true},
          showlegend:true, legend:{font:{color:TC,size:10},bgcolor:'transparent'},
          height:280, margin:{t:10,b:50,l:130,r:10}
        };
        this._plt('sec-timeline', timelineTraces, tlLayout);
        this._plt('sec-timeline-adv', timelineTraces, tlLayout);
      }
    }

    // ── Agent Network Graph ──
    const net = this.agentNetworkData();
    if (net.nodes.length>=2) {
      const maxCnt = Math.max(...net.edges.map(e=>e.count),1);
      const edgeTraces = net.edges.map(e=>{
        const alpha = 0.2 + 0.7*(e.count/maxCnt);
        const rate = e.count?e.success/e.count:0;
        const col = rate>=0.8?`rgba(74,222,128,${alpha})`:rate>=0.5?`rgba(250,204,21,${alpha})`:`rgba(248,113,113,${alpha})`;
        return {type:'scatter',mode:'lines',
          x:[e.fx,e.tx,null], y:[e.fy,e.ty,null],
          line:{color:col, width:1+3*(e.count/maxCnt)},
          hoverinfo:'skip', showlegend:false};
      });
      const nodeTrace = {
        type:'scatter', mode:'markers+text',
        x:net.nodes.map(n=>n.x), y:net.nodes.map(n=>n.y),
        text:net.nodes.map(n=>n.name),
        textposition:'top center',
        textfont:{color:TC,size:10},
        hovertext:net.nodes.map(n=>`${n.name}<br>연결수: ${n.degree}`),
        hovertemplate:'%{hovertext}<extra></extra>',
        marker:{color:'#6c8ef5', size:net.nodes.map(n=>14+n.degree*3), line:{color:'#ffffff80',width:2}},
        showlegend:false,
      };
      // Dynamic height: 260 + 12px per interaction (capped 380–560)
      const netH = Math.max(380, Math.min(560, (d.agentic?.agent_interactions?.length||0)*12+260));
      this._plt('agent-network', [...edgeTraces, nodeTrace], {
        xaxis:{visible:false, range:[-1.7,1.7]},
        yaxis:{visible:false, range:[-1.7,1.7]},
        paper_bgcolor:'transparent', plot_bgcolor:'transparent',
        dragmode:'pan',
        showlegend:false, height:netH, margin:{t:30,b:30,l:30,r:30},
      }, {
        responsive:true,
        scrollZoom:true,
        displayModeBar:true,
        displaylogo:false,
        modeBarButtonsToRemove:['select2d','lasso2d','toggleSpikelines','hoverClosestCartesian','hoverCompareCartesian'],
      });
    }

    // ── Workflow funnel (horizontal bar — step-level counts, not task-level) ──
    const wfSum=d.agentic?.workflow_summary||{};
    const totalTasks=d.total_tasks||0;
    const wfExecs=d.agentic?.workflow_executions||[];
    const wfTaskCount=wfSum.total_tasks||new Set(wfExecs.map(w=>w.task_id)).size||totalTasks;
    const totalSteps=wfExecs.length;
    const successSteps=wfExecs.filter(w=>w.success).length;
    const failSteps=totalSteps-successSteps;
    // Use task_success_rate if available (task-level), else approximate from step-level
    const wfSuccTasks=wfSum.fully_successful_tasks!=null
      ? wfSum.fully_successful_tasks
      : Math.round(wfTaskCount*((wfSum.task_success_rate||wfSum.step_success_rate||0)/100));
    const wfFailTasks=wfTaskCount-wfSuccTasks;
    if(totalSteps>0){
      // Use percentage of steps/tasks so bars are always comparable
      const stepsTotal=totalSteps||1;
      const tasksTotal=wfTaskCount||1;
      // 순서: [태스크 그룹] 미완료→완료→태스크 수 / [단계 그룹] 실패→성공→단계 수
      const funnelLabels=['미완료 태스크','완료 태스크','태스크 수','실패 단계','성공 단계','단계 수'];
      const funnelVals=[wfFailTasks, wfSuccTasks, wfTaskCount, failSteps, successSteps, totalSteps];
      const funnelText=[
        `${wfFailTasks}개 (${wfTaskCount?(wfFailTasks/wfTaskCount*100).toFixed(1):0}%)`,
        `${wfSuccTasks}개 (${wfTaskCount?(wfSuccTasks/wfTaskCount*100).toFixed(1):0}%)`,
        `${wfTaskCount}개`,
        `${failSteps}개 (${totalSteps?(failSteps/totalSteps*100).toFixed(1):0}%)`,
        `${successSteps}개 (${totalSteps?(successSteps/totalSteps*100).toFixed(1):0}%)`,
        `${totalSteps}개 (태스크당 ${totalSteps&&wfTaskCount?(totalSteps/wfTaskCount).toFixed(1):'-'}단계)`,
      ];
      const funnelColors=['#ef4444','#22c55e','#6c8ef5','#f87171','#4ade80','#818cf8'];
      this._plt('l2-wf-funnel',[{type:'bar',orientation:'h',
        y:funnelLabels,x:funnelVals,text:funnelText,textposition:'inside',insidetextanchor:'middle',
        textfont:{color:'#fff',size:11},
        marker:{color:funnelColors}}],
        {margin:{t:6,b:24,l:120,r:10},
         xaxis:{...scX,automargin:true},
         yaxis:{...scY,automargin:true},
         bargap:0.25});
    }

    // ── Integrated Security radar (duplicate for intsec tab) ──
    if (d.has_security) {
      const dims3=['입력위협','출력유출','권한위반','권한상승','공격탐지'];
      const vals3=[threatR,leakR,vioR,escR,atkR];
      this._plt('intsec-radar', [{type:'scatterpolar', r:[...vals3,vals3[0]], theta:[...dims3,dims3[0]],
        fill:'toself', fillcolor:'#f8717130', line:{color:'#f87171'}, marker:{color:'#f87171'}}],
        {polar:{radialaxis:{range:[0,100],tickfont:{color:TC},gridcolor:GC},angularaxis:{tickfont:{color:TC}},bgcolor:'transparent'},
         paper_bgcolor:'transparent', ...noLeg, height:240, margin:{t:20,b:20,l:40,r:40}});
    }

    // ── New perspective-based charts ──
    this.renderRadar();
    this.renderAgRadar();
    this.renderQualityCharts();
  },

  renderTable() {
    const d = this.data; if (!d || !document.getElementById('task-table')) return;
    if (this._taskTable) { this._taskTable.destroy(); this._taskTable=null; }
    const f = this.taskFilter;
    let rows = d.tasks||[];
    if (f.type !== 'all') rows = rows.filter(t=>t.task_type===f.type);
    if (f.status === 'success') rows = rows.filter(t=>t.success);
    else if (f.status === 'fail') rows = rows.filter(t=>!t.success);
    if (f.sort === 'accuracy_score') rows = [...rows].sort((a,b)=>b.accuracy_score-a.accuracy_score);
    else if (f.sort === 'execution_time') rows = [...rows].sort((a,b)=>b.execution_time-a.execution_time);
    else if (f.sort === 'completion_score') rows = [...rows].sort((a,b)=>b.completion_score-a.completion_score);
    this.filteredTaskCount = rows.length;
    this._taskTable = new Tabulator('#task-table', {
      data: rows,
      layout: 'fitDataFill',
      height: '420px',
      rowClick: (e, row) => { this.taskDetail = row.getData(); },
      columns: [
        {title:'Task ID',     field:'task_id',         width:150},
        {title:'Type',        field:'task_type',        width:110},
        {title:'✓',           field:'success',          width:50, formatter:c=>c.getValue()?'✅':'❌'},
        {title:'Completion',  field:'completion_score', width:100, formatter:c=>(c.getValue()*100).toFixed(1)+'%'},
        {title:'Accuracy',    field:'accuracy_score',   width:90,  formatter:c=>(c.getValue()*100).toFixed(1)+'%'},
        {title:'Latency',     field:'execution_time',   width:85,  formatter:c=>c.getValue().toFixed(2)+'s'},
        {title:'Tokens',      field:'tokens_used',      width:70,  formatter:c=>(c.getValue()?.total||0)},
        {title:'Attempts',    field:'attempts',          width:70},
        {title:'Framework',   field:'framework',         width:100, formatter:c=>c.getValue()||'-'},
        {title:'Timestamp',   field:'timestamp',         minWidth:150, formatter:c=>(c.getValue()||'').substring(0,19)},
      ],
    });
  },

  applyTaskFilter() {
    this.renderTable();
  },

  taskTypes() {
    const types = new Set((this.data?.tasks||[]).map(t=>t.task_type).filter(Boolean));
    return [...types];
  },

  // ── Transparency ──────────────────────────────────────────────────────
  async loadTransparency(type) {
    if (type==='traces' && !this.trData.traces.length) {
      const r = await fetch('/api/transparency/traces');
      this.trData.traces = await r.json();
    }
    if (type==='annotations' && !this.trData.annotations.length) {
      const q = this.selId ? `?file_id=${encodeURIComponent(this.selId)}` : '';
      const r = await fetch(`/api/transparency/annotations${q}`);
      this.trData.annotations = await r.json();
    }
    if (type==='audit' && !this.trData.audit.length) {
      const r = await fetch('/api/transparency/audit');
      this.trData.audit = await r.json();
      // Load all audit files for listing
      const items = [];
      for (const a of this.trData.audit) {
        try {
          const rd = await fetch(`/api/transparency/audit/${a.stem}`);
          const detail = await rd.json();
          items.push({ ...a, ...detail });
        } catch(e) { items.push(a); }
      }
      this.trData.auditItems = items;
    }
  },

  async loadTrace(stem) {
    try {
      const r = await fetch(`/api/transparency/traces/${stem}`);
      const d = await r.json();
      this.trDetail = { ...this.trDetail, [stem]: d };
    } catch(e) {}
  },

  async loadAnnotation(stem) {
    try {
      const r = await fetch(`/api/transparency/annotations/${stem}`);
      const d = await r.json();
      this.annDetail = { ...this.annDetail, [stem]: d };
    } catch(e) {}
  },

  async saveAnnotation() {
    const f = this.annForm;
    if (!f.title.trim() || !f.content.trim()) { f.error = '제목과 내용을 입력하세요.'; return; }
    f.saving = true; f.error = '';
    try {
      const r = await fetch('/api/transparency/annotations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: f.title.trim(),
          content: f.content.trim(),
          annotation_type: f.annotation_type,
          priority: f.priority,
          author: f.author.trim() || 'dashboard',
          target_type: f.target_type,
          target_id: f.target_id.trim(),
          source_file_id: this.selId,
        }),
      });
      if (!r.ok) throw new Error(await r.text());
      const ann = await r.json();
      // 목록 갱신 및 새 항목 즉시 표시 (캐시 초기화 후 재로드)
      this.trData.annotations = [];
      await this.loadTransparency('annotations');
      this.annDetail = { ...this.annDetail, [ann.annotation_id]: ann };
      f.show = false;
      f.title = ''; f.content = ''; f.target_id = ''; f.author = '';
    } catch(e) { f.error = '저장 실패: ' + e.message; }
    finally { f.saving = false; }
  },

  async saveReply(stem) {
    const f = this.replyForm;
    if (!f.content.trim()) return;
    f.saving = true;
    try {
      const r = await fetch(`/api/transparency/annotations/${stem}/reply`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: f.content.trim(), author: f.author.trim() || 'dashboard' }),
      });
      if (!r.ok) throw new Error(await r.text());
      const updated = await r.json();
      this.annDetail = { ...this.annDetail, [stem]: updated };
      f.stem = null; f.content = ''; f.author = '';
    } catch(e) {}
    finally { f.saving = false; }
  },

  // ── Data helpers ───────────────────────────────────────────────────────
  tcr()  { return this.data?.accuracy_metrics?.tcr?.tcr || 0; },
  acc()  { return this.data?.accuracy_metrics?.accuracy_scores?.overall_accuracy || 0; },
  hall() {
    const ev = this.data?.accuracy_metrics?.hallucination||{};
    const tot = ev.total_evaluated||0;
    const flagged = ev.total_flagged||0;
    return tot>0 ? +(flagged/tot*100).toFixed(1) : 0;
  },
  lat_mean() { return this.data?.efficiency_metrics?.latency?.mean || 0; },

  typeBreakdown() {
    const d = this.data; if (!d) return [];
    const suc={},tot={};
    (d.tasks||[]).forEach(t=>{
      tot[t.task_type]=(tot[t.task_type]||0)+1;
      if(t.success) suc[t.task_type]=(suc[t.task_type]||0)+1;
    });
    return Object.keys(tot).map(tp=>({ type:tp, n:tot[tp], rate:tot[tp]?(suc[tp]||0)/tot[tp]*100:0 }));
  },

  lowAccTasks() {
    const cutoff = this.thresholds.acc / 100;
    return (this.data?.tasks||[]).filter(t=>t.accuracy_score<cutoff && t.accuracy_score>0);
  },

  partialTasks() {
    return (this.data?.tasks||[])
      .filter(t => t.completion_score >= 0.7 && t.completion_score < 1.0)
      .sort((a,b) => a.completion_score - b.completion_score);
  },

  partialRetryCount() {
    return this.partialTasks().filter(t => (t.attempts||1) > 1).length;
  },

  failedTasks() {
    return (this.data?.tasks||[])
      .filter(t => t.completion_score < 0.7)
      .sort((a,b) => a.completion_score - b.completion_score);
  },

  failRetryCount() {
    return this.failedTasks().filter(t => (t.attempts||1) > 1).length;
  },

  // 부분 성공/실패 원인 추론 (단기 방안: 기존 필드 조합 + 장기 방안: partial_reason 필드)
  diagnosisMsg(t) {
    // 장기 방안: SDK가 채운 partial_reason 필드 우선
    if (t.partial_reason) return t.partial_reason;

    const hints = [];

    // 오류 있음
    if ((t.errors||[]).length > 0) {
      hints.push('오류 발생: ' + (t.errors||[]).map(e => typeof e==='string'?e:JSON.stringify(e)).join(' / '));
    }

    // 재시도 발생
    if ((t.attempts||1) > 1) {
      hints.push(`재시도 ${t.attempts}회 발생`);
    }

    // accuracy vs completion 괴리 → ground_truth 불일치 가능성
    if (t.accuracy_score > 0 && t.completion_score > 0) {
      const gap = t.completion_score - t.accuracy_score;
      if (gap > 0.15) {
        hints.push(`정확도(${(t.accuracy_score*100).toFixed(0)}%)가 완료도보다 낮음 — ground_truth 불일치 가능성`);
      }
    } else if (t.accuracy_score === 0 && t.completion_score > 0 && t.completion_score < 1.0) {
      hints.push('accuracy 측정 없음 (ground_truth 미설정)');
    }

    // completion_score가 정확히 0.7 또는 0.5 → calculate_completion_score 특정 분기
    if (t.completion_score === 0.7) hints.push('유사도 기반 산정 (0.5≤sim<0.8 구간)');
    if (t.completion_score === 0.5) hints.push('유사도 기반 산정 (sim<0.5 구간)');
    if (t.completion_score === 0.0 && (t.errors||[]).length === 0) hints.push('응답 없음 또는 완전 실패');

    if (hints.length === 0) {
      return 'completion_score 직접 지정 또는 원인 정보 없음 — partial_reason 필드를 설정하세요';
    }
    return hints.join(' · ');
  },

  ragAvg(key) {
    const arr = this.data?.advanced?.rag_metrics?.[key] || [];
    if (!arr.length) return '—';
    return (arr.reduce((a,b)=>a+b,0)/arr.length).toFixed(3);
  },

  // ── Health scoring ─────────────────────────────────────────────────────
  l1s() {
    const d=this.data; if(!d) return 0;
    const tcr=d.accuracy_metrics?.tcr?.tcr||0;
    const acc=d.accuracy_metrics?.accuracy_scores?.overall_accuracy||0;
    const vals=[tcr,acc];
    if ((d.accuracy_metrics?.hallucination?.total_evaluated||0)>0)
      vals.push(Math.max(0,100-(d.accuracy_metrics.hallucination.overall_rate||0)*10));
    return vals.length?Math.round(vals.reduce((a,b)=>a+b,0)/vals.length):0;
  },
  l2s() {
    const d=this.data; if(!d||!d.has_agentic) return 0;
    const toolAcc=d.agentic?.tool_selection_summary?.avg_f1_score||0;
    const coord=d.agentic?.coordination_summary?.success_rate||0;
    const wf=d.agentic?.workflow_summary?.step_success_rate||0;
    const teff=d.agentic?.tool_efficiency?.success_rate||0;
    const cnt=[toolAcc,coord,wf,teff].filter(v=>v>0);
    return cnt.length?Math.round(cnt.reduce((a,b)=>a+b,0)/cnt.length):0;
  },
  ps() {
    const p95=this.data?.efficiency_metrics?.latency?.p95;
    if(p95==null||(p95===0&&!(this.data?.total_tasks))) return 0;
    if(p95===0) return 100;
    return Math.max(5,Math.round(100*Math.exp(-0.25*p95)));
  },
  ss() {
    const d=this.data; if(!d||!d.has_security) return 0;
    const thr=100-(d.security_l1?.input_security?.threat_rate||0);
    const leak=100-(d.security_l1?.output_leakage?.leakage_rate||0);
    const auth=d.security_l1?.authorization?.compliance_rate||100;
    return Math.round((thr+leak+auth)/3);
  },
  hs() {
    // 측정된 차원만 평균 — 미측정(0) 차원은 제외해 과소평가 방지
    const scores=[this.l1s(),this.l2s(),this.ps(),this.ss()];
    const measured=scores.filter(v=>v>0);
    return measured.length?Math.round(measured.reduce((a,b)=>a+b,0)/measured.length):0;
  },
  hl() { const s=this.hs(); return s>=90?'EXCELLENT':s>=80?'GOOD':s>=70?'FAIR':'NEEDS WORK'; },

  secScore(type) {
    const d=this.data;
    if (type==='input')  return Math.max(0,Math.round(100-(d?.security_l1?.input_security?.threat_rate||0)));
    if (type==='output') return Math.max(0,Math.round(100-(d?.security_l1?.output_leakage?.leakage_rate||0)));
    if (type==='auth')   return Math.round(d?.security_l1?.authorization?.compliance_rate||100);
    return 50;
  },

  // ── Per-perspective score (0-100) ─────────────────────────────────────
  perspScore(pid, d) {
    if (!d) return 0;
    if (pid === 'quality') {
      const tcr = d.accuracy_metrics?.tcr?.tcr || 0;
      const acc = d.accuracy_metrics?.accuracy_scores?.overall_accuracy || 0;
      const qual = (d.quality_detail?.avg_score || 0) * 20;
      const vals = [tcr, acc];
      if ((d.accuracy_metrics?.hallucination?.total_evaluated||0) > 0)
        vals.push(Math.max(0, 100 - (d.accuracy_metrics.hallucination.overall_rate||0) * 10));
      if (d.has_quality) vals.push(qual);
      return vals.length ? Math.round(vals.reduce((a,b)=>a+b,0)/vals.length) : 0;
    }
    if (pid === 'performance') {
      const latency = d.efficiency_metrics?.latency || {};
      const p95 = latency.p95;
      // 데이터 없음 → 0점
      if (p95 == null || (p95 === 0 && !d.total_tasks)) return 0;
      // p95=0 (서브ms) → 100점
      if (p95 === 0) return 100;
      // 지수 감쇠: p95=1s→78점, p95=2s→61점, p95=5s→29점 — 최저 5점 (절대 0이 되지 않음)
      return Math.max(5, Math.round(100 * Math.exp(-0.25 * p95)));
    }
    if (pid === 'agentic') {
      if (!d.has_agentic) return 0;
      const toolF1 = d.agentic?.tool_selection_summary?.avg_f1_score || 0;
      const coord  = d.agentic?.coordination_summary?.success_rate || 0;
      const wf     = d.agentic?.workflow_summary?.step_success_rate || 0;
      const teff   = d.agentic?.tool_efficiency?.success_rate || 0;
      const vals = [toolF1, coord, wf, teff].filter(v=>v>0);
      return vals.length ? Math.round(vals.reduce((a,b)=>a+b,0)/vals.length) : 0;
    }
    if (pid === 'security') {
      // 트래커 비활성화 시 0 (측정값 없음 = 알 수 없음)
      if (!d.has_security) return 0;
      return this.ss();
    }
    return 0;
  },

  perspScoreDesc(id) {
    const map = {
      quality:     '📊 품질 종합 점수 (0-100)\nTCR + 정확도 + 환각 역점수 + 응답품질의 평균\n높을수록 좋음',
      performance: '⚡ 성능 종합 점수 (0-100)\nP95 레이턴시 기반 지수 감쇠 공식\n1s≈78점 · 2s≈61점 · 5s≈29점 · 데이터 없음=0',
      agentic:     '🤖 에이전틱 종합 점수 (0-100)\nTool F1 + 멀티에이전트 성공률 + 워크플로 성공률 + Tool 효율 평균\n에이전틱 트래커 비활성화 시 0',
      security:    '🔒 보안 종합 점수 (0-100)\n입력 보안 + 출력 유출 + 권한 준수 점수의 단순 평균\n보안 트래커 비활성화 시 0',
      insights:    '💡 Insights 경보 건수\n임계값을 초과한 지표 수 (높을수록 주의 필요)',
    };
    return map[id] || '';
  },

  // ── Regression items (delta vs previous file) ────────────────────────
  regressionItems() {
    const d = this.data; if (!d) return [];
    const prev = this.prevFile(); if (!prev) return [];
    const items = [
      { key:'tcr',          label:'TCR',             curr:this.tcr(),                          prev:prev.tcr||0,           unit:'%', invert:false },
      { key:'accuracy',     label:'Accuracy',         curr:this.acc(),                          prev:prev.accuracy||0,      unit:'%', invert:false },
      { key:'hallucination',label:'Hallucination',    curr:this.hall(),                         prev:prev.hallucination||0, unit:'%', invert:true  },
      { key:'quality',      label:'Response Quality', curr:(d.quality_detail?.avg_score||0)*20, prev:prev.quality_avg||0,   unit:'%', invert:false },
    ];
    return items.map(it => {
      // negative delta = regression (curr worse than prev)
      const delta = it.invert ? it.prev - it.curr : it.curr - it.prev;
      if (delta >= -5) return null;
      const severity = delta < -15 ? 'critical' : 'high';
      return { ...it, delta: `(▼ ${Math.abs(delta).toFixed(1)}${it.unit})`, severity };
    }).filter(Boolean);
  },

  // ── Agentic capability radar data ─────────────────────────────────────
  agenticRadarData() {
    const d = this.data; if (!d || !d.has_agentic) return null;
    const dims = ['Tool 선택', 'Tool 효율', '멀티에이전트', '워크플로', '재시도 정확도'];
    const vals = [
      d.agentic?.tool_selection_summary?.avg_f1_score || 0,
      d.agentic?.tool_efficiency?.avg_efficiency_score || 0,
      d.agentic?.coordination_summary?.success_rate || 0,
      d.agentic?.workflow_summary?.step_success_rate || 0,
      Math.max(0, 100 - ((d.agentic?.retry_summary?.avg_attempts_per_task||1) - 1) * 30),
    ];
    return { dims, vals };
  },

  // ── Overview perspective radar ────────────────────────────────────────
  renderRadar() {
    const d = this.data; if (!d || !window.Plotly) return;
    const TC = this.dark ? '#8890b0' : '#5a6080';
