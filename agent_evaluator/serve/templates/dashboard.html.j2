      </div>
      <div class="cbox" style="margin-top:10px"><div class="ct">Framework별 Task 분포</div><div id="fw-bar" class="plt-chart"></div></div>
    </div>
  </div>
</div>

<!-- ══ SECURITY ══ -->
<div x-show="data && sec==='security'" x-cloak>
  <div x-show="!data.has_security" class="empty">
    <h3>보안 지표 없음</h3>
    <p>InputSanitizationTracker, OutputLeakageDetector 등 보안 트래커를 활성화하세요.</p>
  </div>
  <div x-show="data.has_security">
    <div class="tabs">
      <div class="tab" :class="{on:tsec==='l1in'}"  @click="tsec='l1in'">🔍 입력 검사</div>
      <div class="tab" :class="{on:tsec==='l1out'}" @click="tsec='l1out'">📤 출력 유출</div>
      <div class="tab" :class="{on:tsec==='l1auth'}" @click="tsec='l1auth'">🔐 권한</div>
      <div class="tab" :class="{on:tsec==='l2pe'}"  @click="tsec='l2pe'">🚀 권한 상승</div>
      <div class="tab" :class="{on:tsec==='l2atk'}" @click="tsec='l2atk'">⚔️ 공격 탐지</div>
      <div class="tab" :class="{on:tsec==='int'}"   @click="tsec='int'">🛡️ 통합</div>
    </div>

    <!-- Input Sanitization -->
    <div x-show="tsec==='l1in'">
      <div class="kpi-grid">
        <div class="kpi"><div class="kpi-lbl">평가 입력</div><div class="kpi-val" x-text="data.security_l1?.input_security?.total_inputs_evaluated||0"></div></div>
        <div class="kpi"><div class="kpi-lbl">위협 탐지</div><div class="kpi-val" style="color:var(--red)" x-text="data.security_l1?.input_security?.inputs_with_threats||0"></div></div>
        <div class="kpi"><div class="kpi-lbl">위협률</div><div class="kpi-val" :style="`color:${(data.security_l1?.input_security?.threat_rate||0)>20?'var(--red)':'var(--green)'}`" x-text="pct(data.security_l1?.input_security?.threat_rate)"></div></div>
      </div>
      <div class="sec">
        <div class="sec-t">위협 유형별</div>
        <div class="cg4">
          <div class="cbox"><div class="ct">SQL Injection</div><div style="font-size:20px;font-weight:800;color:var(--red)" x-text="data.security_l1?.input_security?.sql_injection_attempts||0"></div></div>
          <div class="cbox"><div class="ct">Command Injection</div><div style="font-size:20px;font-weight:800;color:var(--red)" x-text="data.security_l1?.input_security?.command_injection_attempts||0"></div></div>
          <div class="cbox"><div class="ct">Path Traversal</div><div style="font-size:20px;font-weight:800;color:var(--orange)" x-text="data.security_l1?.input_security?.path_traversal_attempts||0"></div></div>
          <div class="cbox"><div class="ct">XSS</div><div style="font-size:20px;font-weight:800;color:var(--orange)" x-text="data.security_l1?.input_security?.xss_attempts||0"></div></div>
          <div class="cbox"><div class="ct">Prompt Injection</div><div style="font-size:20px;font-weight:800;color:var(--red)" x-text="data.security_l1?.input_security?.prompt_injection_attempts||0"></div></div>
        </div>
      </div>
      <div class="sec" x-show="data.security_l1?.input_evals?.length>0">
        <div class="sec-t">입력 평가 상세 <span class="badge" x-text="`${(data.security_l1?.input_evals||[]).length}건`"></span></div>
        <div class="slist">
          <template x-for="e in (data.security_l1?.input_evals||[]).slice(0,30)" :key="e.task_id">
            <div class="drow">
              <span class="dk" x-text="e.task_id"></span>
              <span :class="e.sanitization_needed?'pr':'pg'" class="pill" x-text="e.sanitization_needed?'위협':'안전'"></span>
              <span class="tag" x-text="e.risk_level||'low'"></span>
              <span style="font-size:10px;color:var(--text2)" x-text="`위협${e.threat_count||0}개`"></span>
            </div>
          </template>
        </div>
      </div>
    </div>

    <!-- Output Leakage -->
    <div x-show="tsec==='l1out'">
      <div class="kpi-grid">
        <div class="kpi"><div class="kpi-lbl">평가 출력</div><div class="kpi-val" x-text="data.security_l1?.output_leakage?.total_outputs_evaluated||0"></div></div>
        <div class="kpi"><div class="kpi-lbl">유출 탐지</div><div class="kpi-val" style="color:var(--red)" x-text="data.security_l1?.output_leakage?.outputs_with_leakage||0"></div></div>
        <div class="kpi"><div class="kpi-lbl">유출률</div><div class="kpi-val" :style="`color:${(data.security_l1?.output_leakage?.leakage_rate||0)>10?'var(--red)':'var(--green)'}`" x-text="pct(data.security_l1?.output_leakage?.leakage_rate)"></div></div>
      </div>
      <div class="sec">
        <div class="sec-t">유출 유형별</div>
        <div class="cg4">
          <div class="cbox"><div class="ct">API Key</div><div style="font-size:20px;font-weight:800;color:var(--red)" x-text="data.security_l1?.output_leakage?.api_key_leaks||0"></div></div>
          <div class="cbox"><div class="ct">Password</div><div style="font-size:20px;font-weight:800;color:var(--red)" x-text="data.security_l1?.output_leakage?.password_leaks||0"></div></div>
          <div class="cbox"><div class="ct">Email</div><div style="font-size:20px;font-weight:800;color:var(--orange)" x-text="data.security_l1?.output_leakage?.email_leaks||0"></div></div>
          <div class="cbox"><div class="ct">Phone</div><div style="font-size:20px;font-weight:800;color:var(--orange)" x-text="data.security_l1?.output_leakage?.phone_leaks||0"></div></div>
          <div class="cbox"><div class="ct">Private IP</div><div style="font-size:20px;font-weight:800;color:var(--yellow)" x-text="data.security_l1?.output_leakage?.private_ip_leaks||0"></div></div>
        </div>
      </div>
      <div class="sec" x-show="data.security_l1?.output_detections?.length>0">
        <div class="sec-t">출력 탐지 상세</div>
