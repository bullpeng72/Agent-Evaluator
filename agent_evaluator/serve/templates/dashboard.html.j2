      { key:'acc',      label:'Accuracy',       fmt:d=>this.pct(d?.accuracy_metrics?.accuracy_scores?.overall_accuracy),    best:ds=>this.pct(Math.max(...ds.map(d=>d?.accuracy_metrics?.accuracy_scores?.overall_accuracy||0))) },
      { key:'hall',     label:'Hallucination',  fmt:d=>this.pct(d?.accuracy_metrics?.hallucination?.overall_rate),          best:ds=>this.pct(Math.min(...ds.map(d=>d?.accuracy_metrics?.hallucination?.overall_rate||0))) },
      { key:'lat_mean', label:'Avg Latency',    fmt:d=>this.sec_(d?.efficiency_metrics?.latency?.mean),                     best:ds=>this.sec_(Math.min(...ds.map(d=>d?.efficiency_metrics?.latency?.mean||99))) },
      { key:'p95',      label:'P95 Latency',    fmt:d=>this.sec_(d?.efficiency_metrics?.latency?.p95),                      best:ds=>this.sec_(Math.min(...ds.map(d=>d?.efficiency_metrics?.latency?.p95||99))) },
      { key:'cost',     label:'Total Cost',     fmt:d=>this.cost(d?.efficiency_metrics?.tokens?.total_cost),                best:ds=>this.cost(Math.min(...ds.map(d=>d?.efficiency_metrics?.tokens?.total_cost||99))) },
      { key:'tasks',    label:'Total Tasks',    fmt:d=>d?.total_tasks??'—',                                                  best:null },
      { key:'grade',    label:'Benchmark Grade',fmt:d=>this.benchGrade(d?.accuracy_metrics?.tcr?.tcr||0).letter,            best:null },
    ];
  },

  // ── Golden Dataset ──────────────────────────────────────────────────────
  async loadGoldenList() {
    try {
      const r = await fetch('/api/golden');
      this.gdFiles = await r.json();
    } catch(e) { console.error(e); }
  },

  async loadGoldenFile(stem) {
    if (this.gdSelected === stem) { this.gdSelected = null; return; }
    try {
      const r = await fetch(`/api/golden/${stem}`);
      let data = await r.json();
      // Normalize: could be array or object with items/questions key
      if (Array.isArray(data)) {
        this.gdItems = { ...this.gdItems, [stem]: data };
      } else {
        const arr = data.items || data.questions || Object.values(data);
        this.gdItems = { ...this.gdItems, [stem]: Array.isArray(arr) ? arr : [] };
      }
      this.gdSelected = stem;
    } catch(e) { console.error(e); }
  },

  async saveGolden(stem) {
    try {
      const items = this.gdItems[stem] || [];
      const r = await fetch(`/api/golden/${stem}`, {
        method: 'PUT',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify(items),
      });
      const result = await r.json();
      if (result.ok) {
        alert(`✅ 저장 완료: ${result.name}`);
        await this.loadGoldenList();
      }
    } catch(e) { alert('저장 실패: ' + e.message); }
  },

  async createGolden() {
    if (!this.gdNewName) return;
    try {
      const r = await fetch('/api/golden', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({name: this.gdNewName, items: []}),
      });
      const result = await r.json();
      if (result.ok) {
        this.gdShowCreate = false;
        this.gdNewName = '';
        await this.loadGoldenList();
      }
    } catch(e) { alert('생성 실패: ' + e.message); }
  },

  addGoldenItem(stem) {
    const items = this.gdItems[stem] || [];
    this.gdItems = { ...this.gdItems, [stem]: [...items, {question:'', ground_truth:'', context:''}] };
  },

  removeGoldenItem(stem, idx) {
    const items = [...(this.gdItems[stem]||[])];
    items.splice(idx, 1);
    this.gdItems = { ...this.gdItems, [stem]: items };
  },

  // ── Performance bottleneck analysis ───────────────────────────────────
  bottleneckAnalysis() {
    const tasks = this.data?.tasks||[]; if (!tasks.length) return [];
    const results = [];
    // Top 5 slowest tasks
    const sorted = [...tasks].sort((a,b)=>(b.execution_time||0)-(a.execution_time||0));
    const slowThreshold = (this.data?.efficiency_metrics?.latency?.p95 || 2);
    const slow = sorted.filter(t=>(t.execution_time||0)>slowThreshold);
    if (slow.length) {
      results.push({type:'slow_tasks', severity:'high',
        title:`느린 태스크 ${slow.length}건 (P95 초과)`,
        desc:`P95 기준(${slowThreshold.toFixed(2)}s) 초과: ${slow.slice(0,3).map(t=>t.task_id).join(', ')}${slow.length>3?'...':''}`,
        tasks: slow.slice(0,5),
      });
    }
    // TaskType bottleneck
    const typeLatency={};
    tasks.forEach(t=>{ const k=t.task_type||'unknown'; (typeLatency[k]=typeLatency[k]||[]).push(t.execution_time||0); });
    const typeAvg = Object.entries(typeLatency).map(([k,v])=>({type:k, avg:v.reduce((a,b)=>a+b,0)/v.length, n:v.length}));
    const worstType = typeAvg.sort((a,b)=>b.avg-a.avg)[0];
    if (worstType && worstType.avg > slowThreshold*0.7) {
      results.push({type:'type_bottleneck', severity:'medium',
        title:`${worstType.type} 유형이 가장 느림`,
        desc:`평균 ${worstType.avg.toFixed(2)}s (${worstType.n}건) — 해당 유형의 프롬프트/로직 최적화 필요`,
        tasks:[]});
    }
    // High token tasks
    const tokenSorted = [...tasks].sort((a,b)=>(b.tokens_used?.total||0)-(a.tokens_used?.total||0));
    const avgTok = tasks.reduce((s,t)=>s+(t.tokens_used?.total||0),0)/tasks.length;
    const heavyTok = tokenSorted.filter(t=>(t.tokens_used?.total||0)>avgTok*2);
    if (heavyTok.length) {
      results.push({type:'token_heavy', severity:'low',
        title:`토큰 과다 사용 태스크 ${heavyTok.length}건`,
        desc:`평균 대비 2배 이상 사용: ${heavyTok.slice(0,3).map(t=>t.task_id).join(', ')}`,
        tasks: heavyTok.slice(0,5)});
    }
    // Failure correlation with latency
    const failedAvgLat = tasks.filter(t=>!t.success).reduce((s,t,_,a)=>s+(t.execution_time||0)/a.length,0) || 0;
    const successAvgLat = tasks.filter(t=>t.success).reduce((s,t,_,a)=>s+(t.execution_time||0)/a.length,0) || 0;
    if (failedAvgLat>0 && successAvgLat>0 && failedAvgLat>successAvgLat*1.3) {
      results.push({type:'fail_latency', severity:'medium',
        title:'실패 태스크가 성공 태스크보다 느림',
        desc:`실패 평균 ${failedAvgLat.toFixed(2)}s vs 성공 평균 ${successAvgLat.toFixed(2)}s — 타임아웃 관련 실패 의심`,
        tasks:[]});
    }
    return results;
  },

  mergedStats() {
    const files = this.compareIds.map(id=>this.compareData[id]).filter(Boolean);
    if (!files.length) return {};
    const avg = (getter) => files.reduce((s,d)=>s+(getter(d)||0),0)/files.length;
    return {
      tcr:   avg(d=>d.accuracy_metrics?.tcr?.tcr),
      acc:   avg(d=>d.accuracy_metrics?.accuracy_scores?.overall_accuracy),
      hall:  avg(d=>d.accuracy_metrics?.hallucination?.overall_rate),
      lat:   avg(d=>d.efficiency_metrics?.latency?.mean),
      tasks: files.reduce((s,d)=>s+(d.total_tasks||0),0),
      cost:  files.reduce((s,d)=>s+(d.efficiency_metrics?.tokens?.total_cost||0),0),
    };
  },

  pearsonCorr() {
    if (!this.data) return '';
    const pts = (this.data.tasks||[]).filter(t=>t.execution_time>0&&t.accuracy_score>=0);
    if (pts.length < 3) return '';
    const n = pts.length;
    const xs = pts.map(t=>t.execution_time), ys = pts.map(t=>t.accuracy_score*100);
    const mx = xs.reduce((s,v)=>s+v,0)/n, my = ys.reduce((s,v)=>s+v,0)/n;
    const num = xs.reduce((s,v,i)=>s+(v-mx)*(ys[i]-my),0);
    const den = Math.sqrt(xs.reduce((s,v)=>s+(v-mx)**2,0)*ys.reduce((s,v)=>s+(v-my)**2,0));
    if (!den) return '';
    const r = num/den;
    const interp = Math.abs(r)>=0.7?'강한':Math.abs(r)>=0.4?'중간':'약한';
    const dir = r>0?'양의':'음의';
    return `Pearson r = ${r.toFixed(3)} — ${interp} ${dir} 상관관계 (n=${n})`;
  },

  // ── Format helpers ─────────────────────────────────────────────────────
  pct(v)  { return v===undefined||v===null?'—':(+v).toFixed(1)+'%'; },
  sec_(v) { return v===undefined||v===null?'—':(+v).toFixed(3)+'s'; },
  cost(v) { if(v===undefined||v===null)return'—'; return +v<0.01?'$'+(+v).toFixed(6):'$'+(+v).toFixed(4); },
  tc(v,t) { return v>=t?'kpi-sub ok':'kpi-sub warn'; },
  tlbl(v,t){ return v>=t?`✅ ≥${t}% 통과`:`⚠️ <${t}% 주의`; },
  bc(v)   { return v>=80?'var(--green)':v>=60?'var(--yellow)':'var(--red)'; },
  hr_col(v){ return `color:${!v||v<=5?'var(--green)':v<=15?'var(--yellow)':'var(--red)'}`; },
  hr_col2(v){ return !v||v<=5?'var(--green)':v<=15?'var(--yellow)':'var(--red)'; },
  hr_lbl(v){ return !v||v<=5?'✅ SAFE':v<=15?'⚠️ WARNING':'🚨 DANGER'; },
  lat_cl(v){ return !v||v<=2?'':v<=5?'kpi-sub warn':'kpi-sub'; },
};}
</script>
