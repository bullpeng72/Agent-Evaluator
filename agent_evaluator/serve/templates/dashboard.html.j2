        <template x-for="[k,v] in Object.entries(data.agentic?.retry_summary||{})" :key="k">
          <div class="kpi"><div class="kpi-lbl" x-text="k.replace(/_/g,' ')"></div><div class="kpi-val" x-text="typeof v==='number'?v.toFixed(1):v"></div></div>
        </template>
      </div>
      <div class="sec" x-show="(data.agentic?.retry_attempts||[]).length===0">
        <div style="font-size:12px;color:var(--text2)">재시도 기록 없음 (재시도가 발생한 태스크가 없거나 TrackerRetry가 비활성화됨)</div>
      </div>
      <div class="cg">
        <div class="cbox"><div class="ct">시도 횟수 분포</div><div id="l2-retry-dist" class="plt-chart"></div></div>
        <div class="cbox"><div class="ct">태스크 유형별 평균 시도 횟수</div><div id="l2-retry-type" class="plt-chart"></div></div>
      </div>
    </div>
  </div>
</div>

<!-- ══ LAYER 3: ADVANCED ══ -->
<div x-show="data && sec==='layer3'" x-cloak>
  <div x-show="!data.has_advanced && !data.has_rag" class="empty">
    <h3>Layer 3 Advanced 지표 없음</h3>
    <p>HybridPerformanceMonitor에서 DeepEval 또는 Ragas를 활성화하세요.</p>
  </div>
  <div x-show="data.has_advanced || data.has_rag">
    <div class="tabs">
      <div class="tab" :class="{on:tl3==='deepeval'}" @click="tl3='deepeval'">🤖 DeepEval</div>
      <div class="tab" :class="{on:tl3==='ragas'}"    @click="tl3='ragas'">📚 Ragas</div>
      <div class="tab" :class="{on:tl3==='pertask'}"  @click="tl3='pertask'">📋 태스크별</div>
    </div>

    <!-- DeepEval -->
    <div x-show="tl3==='deepeval'">
      <div x-show="!data.has_advanced" class="empty"><p>DeepEval 지표 없음</p></div>
      <div x-show="data.has_advanced">
        <div class="kpi-grid">
          <template x-for="[k,v] in Object.entries(data.advanced?.summary||{})" :key="k">
            <div class="kpi" x-show="typeof v==='object'&&v.mean!==undefined">
              <div class="kpi-lbl" x-text="k.replace(/_/g,' ')"></div>
              <div class="kpi-val" style="font-size:18px" x-text="(v.mean??0).toFixed(3)"></div>
              <div class="kpi-sub" style="color:var(--text2)" x-text="`min ${(v.min??0).toFixed(2)} · max ${(v.max??0).toFixed(2)}`"></div>
            </div>
          </template>
        </div>
        <div class="cg">
          <div class="cbox"><div class="ct">G-Eval Score 분포</div><div id="l3-geval-hist" class="plt-chart"></div></div>
          <div class="cbox">
            <div class="ct">DeepEval 지표 요약</div>
            <template x-for="[k,v] in Object.entries(data.advanced?.summary||{})" :key="k">
              <div class="brow" x-show="typeof v==='object'&&v.mean!==undefined" style="margin-bottom:7px">
                <div class="blbl"><span x-text="k.replace(/_/g,' ')"></span><span x-text="(v.mean??0).toFixed(3)"></span></div>
                <div class="btrack"><div class="bfill" :style="`width:${(v.mean??0)*100}%;background:${bc((v.mean??0)*100)}`"></div></div>
              </div>
            </template>
          </div>
        </div>
      </div>
    </div>

    <!-- Ragas -->
    <div x-show="tl3==='ragas'">
      <div x-show="!data.has_rag" class="empty"><p>Ragas 지표 없음 — RAGPipelineEvaluator를 활성화하세요.</p></div>
      <div x-show="data.has_rag">
        <div class="kpi-grid">
          <template x-for="key in ['faithfulness','answer_relevancy','context_recall','context_precision']" :key="key">
            <div class="kpi">
              <div class="kpi-lbl" x-text="key.replace(/_/g,' ')"></div>
              <div class="kpi-val" x-text="ragAvg(key)"></div>
              <div class="kpi-sub" style="color:var(--text2)" x-text="`${(data.advanced?.rag_metrics?.[key]||[]).length}건 평가`"></div>
            </div>
          </template>
        </div>
        <div class="cg">
          <div class="cbox"><div class="ct">Ragas 지표 비교</div><div id="l3-rag-bar" class="plt-chart"></div></div>
          <div class="cbox">
            <div class="ct">Advanced Metrics (DeepEval)</div>
            <template x-for="[k,v] in Object.entries(data.advanced?.summary||{})" :key="k">
              <div class="drow" x-show="typeof v==='object'&&v.mean!==undefined">
                <span class="dk" x-text="k.replace(/_/g,' ')"></span>
                <span x-text="(v.mean??0).toFixed(3)"></span>
              </div>
            </template>
          </div>
        </div>
      </div>
    </div>

    <!-- Per-task -->
    <div x-show="tl3==='pertask'">
      <div x-show="!(data.advanced?.per_task?.length>0)" class="empty"><p>태스크별 advanced 데이터 없음</p></div>
      <div x-show="data.advanced?.per_task?.length>0">
        <div class="sec-t">태스크별 DeepEval/Ragas 상세 <span class="badge" x-text="`${(data.advanced?.per_task||[]).length}건`"></span></div>
        <div class="slist">
          <template x-for="(t,i) in (data.advanced?.per_task||[]).slice(0,50)" :key="i">
            <div class="drow">
              <span class="dk" x-text="t.task_id||`#${i+1}`"></span>
              <template x-for="[mk,mv] in Object.entries(t.metrics||t)" :key="mk">
                <span x-show="typeof mv==='number'" class="tag" x-text="`${mk.replace(/_/g,' ')}: ${(+mv).toFixed(3)}`"></span>
              </template>
            </div>
          </template>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ══ PERFORMANCE ══ -->
<div x-show="data && sec==='performance'" x-cloak>
  <div class="tabs">
    <div class="tab" :class="{on:tp==='lat'}"  @click="tp='lat'">📊 Latency</div>
    <div class="tab" :class="{on:tp==='tok'}"  @click="tp='tok'">🔢 Token</div>
    <div class="tab" :class="{on:tp==='cost'}" @click="tp='cost'">💰 Cost</div>
    <div class="tab" :class="{on:tp==='fw'}"   @click="tp='fw'">🔀 Framework</div>
  </div>

  <!-- Latency -->
  <div x-show="tp==='lat'">
    <div class="kpi-grid">
      <div class="kpi"><div class="kpi-lbl">평균(Mean)</div><div class="kpi-val" x-text="sec_(data.efficiency_metrics?.latency?.mean)"></div></div>
      <div class="kpi"><div class="kpi-lbl">P50</div><div class="kpi-val" x-text="sec_(data.efficiency_metrics?.latency?.p50)"></div></div>
      <div class="kpi"><div class="kpi-lbl">P95</div><div class="kpi-val" :class="lat_cl(data.efficiency_metrics?.latency?.p95)" x-text="sec_(data.efficiency_metrics?.latency?.p95)"></div></div>
      <div class="kpi"><div class="kpi-lbl">P99</div><div class="kpi-val" x-text="sec_(data.efficiency_metrics?.latency?.p99)"></div></div>
