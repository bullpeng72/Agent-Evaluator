    <div class="kpi-grid">
      <div class="kpi"><div class="kpi-lbl">TCR</div><div class="kpi-val"><span x-text="pct(tcr())"></span><span class="grade" :class="`grade-${benchGrade(tcr()).letter}`" x-text="benchGrade(tcr()).letter"></span></div></div>
      <div class="kpi"><div class="kpi-lbl">완전 성공</div><div class="kpi-val" x-text="data.accuracy_metrics?.tcr?.full_success??'-'"></div></div>
      <div class="kpi"><div class="kpi-lbl">부분 성공</div><div class="kpi-val" x-text="data.accuracy_metrics?.tcr?.partial_success??'-'"></div></div>
      <div class="kpi"><div class="kpi-lbl">실패</div><div class="kpi-val" style="color:var(--red)" x-text="data.accuracy_metrics?.tcr?.failures??'-'"></div></div>
    </div>
    <div class="cg">
      <div class="cbox"><div class="ct">성공/실패 비율</div><div id="l1-donut" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">TaskType별 성공률</div><div id="l1-type" class="plt-chart"></div></div>
    </div>
    <div class="cbox"><div class="ct">실패 원인 분류</div><div id="l1-fail-reason" class="plt-chart"></div></div>
    <div class="sec" x-show="typeBreakdown().length>0">
      <div class="sec-t">TaskType별 상세</div>
      <template x-for="tp in typeBreakdown()" :key="tp.type">
        <div class="drow" style="display:grid;grid-template-columns:1fr 64px 72px;gap:0 16px">
          <span class="dk" x-text="tp.type"></span>
          <span x-text="`${tp.n}건`" style="color:var(--text2);text-align:right"></span>
          <span style="text-align:right" :style="`color:${tp.rate>=thresholds.tcr?'var(--green)':tp.rate>=(thresholds.tcr-15)?'var(--yellow)':'var(--red)'}`" x-text="pct(tp.rate)"></span>
        </div>
      </template>
    </div>
  </div>

  <!-- Accuracy -->
  <div x-show="t1==='acc'">
    <div class="kpi-grid">
      <div class="kpi"><div class="kpi-lbl">전체 Accuracy</div><div class="kpi-val" x-text="pct(acc())"></div></div>
      <div class="kpi"><div class="kpi-lbl">Median</div><div class="kpi-val" x-text="pct(data.accuracy_metrics?.accuracy_scores?.median_accuracy)"></div></div>
      <div class="kpi"><div class="kpi-lbl">Min</div><div class="kpi-val" x-text="pct(data.accuracy_metrics?.accuracy_scores?.min_accuracy)"></div></div>
      <div class="kpi"><div class="kpi-lbl">Max</div><div class="kpi-val" x-text="pct(data.accuracy_metrics?.accuracy_scores?.max_accuracy)"></div></div>
      <div class="kpi"><div class="kpi-lbl">Std Dev</div><div class="kpi-val" x-text="pct(data.accuracy_metrics?.accuracy_scores?.std_accuracy)"></div></div>
    </div>
    <div class="sec">
      <div class="sec-t">📐 정확도 계산 방식</div>
      <div style="font-size:13px;color:var(--text2);margin-bottom:8px">Token Overlap(40%) · Jaccard(30%) · LCS Ratio(20%) · Char Similarity(10%) 가중 평균</div>
      <div id="acc-weights" style="height:80px"></div>
    </div>
    <div class="sec"><div class="sec-t">정확도 분포</div><div id="acc-hist" class="plt-chart"></div></div>
    <div class="sec" x-show="lowAccTasks().length>0">
      <div class="sec-t">낮은 정확도 태스크 <span class="badge" x-text="`< ${thresholds.acc}% : ${lowAccTasks().length}건`"></span></div>
      <div class="slist">
        <template x-for="t in lowAccTasks()" :key="t.task_id">
          <div class="drow">
            <span class="dk" x-text="t.task_id"></span>
            <span x-text="t.task_type" style="color:var(--text2)"></span>
            <span style="color:var(--red)" x-text="pct(t.accuracy_score*100)"></span>
            <span x-text="`${t.attempts}회`" style="color:var(--text2)"></span>
          </div>
        </template>
      </div>
    </div>
  </div>

  <!-- Quality -->
  <div x-show="t1==='qual'">
    <div x-show="!data.has_quality" class="empty"><p>품질 평가 데이터 없음 — QualityEvaluator를 활성화하세요.</p></div>
    <div x-show="data.has_quality">
      <div class="kpi-grid">
        <div class="kpi"><div class="kpi-lbl">평균 품질 점수</div><div class="kpi-val" x-text="(data.quality_detail?.avg_score||0).toFixed(2)"></div></div>
        <template x-for="[g,n] in Object.entries(data.quality_detail?.grade_distribution||{})" :key="g">
          <div class="kpi"><div class="kpi-lbl">등급 <span x-text="g"></span></div><div class="kpi-val" x-text="n"></div></div>
        </template>
      </div>
      <div class="cg">
        <div class="cbox"><div class="ct">품질 레이더 (6차원)</div><div id="qual-radar" class="plt-chart"></div></div>
        <div class="cbox">
          <div class="ct">차원별 평균 점수</div>
          <template x-for="[dim,val] in Object.entries(data.quality_detail?.dimension_summary||{})" :key="dim">
            <div class="brow" style="margin-bottom:7px">
              <div class="blbl"><span x-text="dim"></span><span x-text="val.toFixed(2)"></span></div>
              <div class="btrack"><div class="bfill" :style="`width:${val*10}%;background:${bc(val*10)}`"></div></div>
            </div>
          </template>
        </div>
      </div>
      <div class="sec" x-show="data.quality_detail?.dimension_summary && Object.keys(data.quality_detail?.dimension_summary||{}).length>0">
        <div class="sec-t">🗺️ TaskType × 품질 차원 히트맵</div>
        <div id="qual-heatmap" style="height:220px"></div>
      </div>
    </div>
  </div>

  <!-- Hallucination -->
  <div x-show="t1==='hall'">
    <div class="kpi-grid">
      <div class="kpi"><div class="kpi-lbl">환각 발생률</div><div class="kpi-val" :style="hr_col(hall())" x-text="pct(hall())"></div></div>
      <div class="kpi"><div class="kpi-lbl">평가 건수</div><div class="kpi-val" x-text="data.accuracy_metrics?.hallucination?.total_evaluated??0"></div></div>
      <div class="kpi"><div class="kpi-lbl">감지 건수</div><div class="kpi-val" x-text="data.accuracy_metrics?.hallucination?.total_flagged??0"></div></div>
      <div class="kpi"><div class="kpi-lbl">미지원 주장</div><div class="kpi-val" x-text="data.accuracy_metrics?.hallucination?.unsupported_claims_count??0"></div></div>
    </div>
    <div class="sec">
      <div class="sec-t">환각 위험 수준</div>
      <div class="rg"><div class="rgt"><div class="rgf" :style="`width:${Math.min(100,(hall()/30)*100)}%;background:${hr_col2(hall())}`"></div></div>
      <div style="display:flex;justify-content:space-between;font-size:14px;color:var(--text2)"><span>0% SAFE</span><span :style="`color:${hr_col2(hall())}`" x-text="pct(hall())+' 현재'"></span><span>30% CRITICAL</span></div></div>
    </div>
    <div class="sec" x-show="Object.keys(data.hallucination_detail?.indicator_types||{}).length>0">
      <div class="sec-t">환각 유형별 분류</div>
      <template x-for="[t,n] in Object.entries(data.hallucination_detail?.indicator_types||{})" :key="t">
        <div class="drow"><span class="dk" x-text="t"></span><span x-text="`${n}건`"></span></div>
      </template>
    </div>
  </div>

  <!-- RAG -->
  <div x-show="t1==='rag'">
    <div x-show="!data.has_rag" class="empty">
      <h3>RAG 지표 없음</h3>
      <p>HybridPerformanceMonitor에서 Ragas를 활성화하거나 RAG 평가 예제를 실행하세요.</p>
    </div>
    <div x-show="data.has_rag">
      <div class="kpi-grid">
        <template x-for="key in ['faithfulness','answer_relevancy','context_recall','context_precision']" :key="key">
          <div class="kpi">
            <div class="kpi-lbl" x-text="key.replace(/_/g,' ')"></div>
            <div class="kpi-val" x-text="ragAvg(key)"></div>
            <div class="kpi-sub" style="color:var(--text2)" x-text="`${(data.advanced?.rag_metrics?.[key]||[]).length}건 평가`"></div>
          </div>
        </template>
      </div>
      <div class="cg">
        <div class="cbox"><div class="ct">RAG 지표 비교</div><div id="rag-bar" class="plt-chart"></div></div>
        <div class="cbox">
          <div class="ct">Advanced Metrics (DeepEval)</div>
          <template x-for="[k,v] in Object.entries(data.advanced?.summary||{})" :key="k">
            <div class="drow" x-show="typeof v==='object'&&v.mean!==undefined">
              <span class="dk" x-text="k.replace(/_/g,' ')"></span>
              <span x-text="(v.mean??0).toFixed(3)"></span>
            </div>
          </template>
          <div x-show="!Object.keys(data.advanced?.summary||{}).length" style="font-size:13px;color:var(--text2)">DeepEval 지표 없음</div>
        </div>
      </div>
    </div>
  </div>

  <!-- DeepEval -->
  <div x-show="t1==='deepeval'">
    <div x-show="!data.has_advanced" class="empty">
      <h3>DeepEval 지표 없음</h3>
      <p>HybridPerformanceMonitor에서 DeepEval (G-Eval, Hallucination, Answer Relevancy)을 활성화하세요.</p>
    </div>
    <div x-show="data.has_advanced">
      <div class="kpi-grid">
        <template x-for="[k,v] in Object.entries(data.advanced?.summary||{})" :key="k">
          <div class="kpi" x-show="typeof v==='object'&&v.mean!==undefined">
            <div class="kpi-lbl" x-text="k.replace(/_/g,' ')"></div>
            <div class="kpi-val" style="font-size:20px" x-text="(v.mean??0).toFixed(3)"></div>
            <div class="kpi-sub" style="color:var(--text2)" x-text="`min ${(v.min??0).toFixed(2)} / max ${(v.max??0).toFixed(2)}`"></div>
          </div>
        </template>
      </div>
      <div class="cg">
        <div class="cbox">
          <div class="ct">G-Eval Score 분포</div>
          <div id="deepeval-hist" class="plt-chart"></div>
        </div>
        <div class="cbox">
          <div class="ct">DeepEval 지표 요약</div>
          <template x-for="[k,v] in Object.entries(data.advanced?.summary||{})" :key="k">
            <div class="brow" x-show="typeof v==='object'&&v.mean!==undefined" style="margin-bottom:7px">
              <div class="blbl">
                <span x-text="k.replace(/_/g,' ')"></span>
                <span x-text="(v.mean??0).toFixed(3)"></span>
              </div>
              <div class="btrack"><div class="bfill" :style="`width:${(v.mean??0)*100}%;background:${bc((v.mean??0)*100)}`"></div></div>
            </div>
          </template>
        </div>
      </div>
      <div class="sec" x-show="(data.advanced?.per_task||[]).length>0">
        <div class="sec-t">태스크별 DeepEval 상세 <span class="badge" x-text="`${(data.advanced?.per_task||[]).length}건`"></span></div>
        <div class="slist">
          <template x-for="(t,i) in (data.advanced?.per_task||[]).slice(0,50)" :key="i">
            <div class="drow">
              <span class="dk" x-text="t.task_id||`#${i+1}`"></span>
              <template x-for="[mk,mv] in Object.entries(t.metrics||t)" :key="mk">
                <span x-show="typeof mv==='number'" class="tag" x-text="`${mk.replace(/_/g,' ')}: ${(+mv).toFixed(3)}`"></span>
              </template>
            </div>
          </template>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ══ 에이전틱 (Agentic) ══ -->
<div x-show="data && sec==='agentic'" x-cloak>

  <div class="tabs">
    <div class="tab" :class="{on:tag==='basic'}"      @click="tag='basic';t2='retry'">🔵 기본</div>
    <div class="tab" :class="{on:tag==='advanced'}"   @click="tag='advanced';t2='tsel'">🟡 심화</div>
    <div class="tab" :class="{on:tag==='integrated'}" @click="tag='integrated'">🟣 통합</div>
    <span style="margin-left:auto;font-size:14px;color:var(--text2)">
      에이전틱 Score: <b x-text="perspScore('agentic',data)"></b>/100
    </span>
  </div>

  <div x-show="!data.has_agentic" class="empty">
    <h3>Agentic 지표 없음</h3>
    <p>Tool Selection, Multi-Agent, Workflow 평가가 포함된 예제를 실행하세요.</p>
  </div>
  <div x-show="data.has_agentic">

  <!-- ── 기본 티어 ── -->
  <div x-show="tag==='basic'">
    <!-- 에이전틱 역량 레이더 차트 -->
    <div class="sec">
      <div class="sec-t">🕸️ 에이전틱 역량 레이더</div>
      <div id="ag-radar" style="height:260px"></div>
    </div>

    <div class="tabs">
      <div class="tab" :class="{on:t2==='retry'}"  @click="t2='retry'">🔁 Retry</div>
      <div class="tab" :class="{on:t2==='teff'}"   @click="t2='teff'">⚡ Tool Efficiency</div>
    </div>

    <!-- Tool Efficiency -->
    <div x-show="t2==='teff'">
      <div x-show="!data.agentic?.tool_efficiency?.total_calls" class="empty"><p>Tool Efficiency 데이터 없음</p></div>
      <div x-show="data.agentic?.tool_efficiency?.total_calls">
        <div class="kpi-grid">
          <div class="kpi"><div class="kpi-lbl">총 Tool 호출</div><div class="kpi-val" x-text="data.agentic?.tool_efficiency?.total_calls||0"></div></div>
          <div class="kpi"><div class="kpi-lbl">성공률</div><div class="kpi-val" x-text="pct(data.agentic?.tool_efficiency?.success_rate)"></div></div>
          <div class="kpi"><div class="kpi-lbl">평균 효율성</div><div class="kpi-val" x-text="pct(data.agentic?.tool_efficiency?.avg_efficiency_score)"></div></div>
          <div class="kpi"><div class="kpi-lbl">중복 호출률</div><div class="kpi-val" :style="`color:${data.agentic?.tool_efficiency?.redundancy_rate>0?'var(--yellow)':'var(--green)'}`" x-text="pct(data.agentic?.tool_efficiency?.redundancy_rate)"></div></div>
          <div class="kpi"><div class="kpi-lbl">실패률</div><div class="kpi-val" style="color:var(--red)" x-text="pct(data.agentic?.tool_efficiency?.failure_rate)"></div></div>
          <div class="kpi"><div class="kpi-lbl">Task당 평균</div><div class="kpi-val" x-text="(data.agentic?.tool_efficiency?.avg_calls_per_task||0).toFixed(1)+'회'"></div></div>
        </div>
        <div class="cbox" style="margin-top:10px"><div class="ct">Tool 효율성 지표 비교</div><div id="teff-bar" class="plt-chart"></div></div>
      </div>
    </div>

    <!-- Retry -->
    <div x-show="t2==='retry'">
      <div class="kpi-grid">
        <div class="kpi"><div class="kpi-lbl">재시도 기록</div><div class="kpi-val" x-text="(data.agentic?.retry_attempts||[]).length"></div></div>
        <template x-for="[k,v] in Object.entries(data.agentic?.retry_summary||{})" :key="k">
          <div class="kpi"><div class="kpi-lbl" x-text="k.replace(/_/g,' ')"></div><div class="kpi-val" x-text="typeof v==='number'?v.toFixed(1):v"></div></div>
        </template>
      </div>
      <div class="sec" x-show="(data.agentic?.retry_attempts||[]).length===0">
        <div style="font-size:14px;color:var(--text2)">재시도 기록 없음 (재시도가 발생한 태스크가 없거나 TrackerRetry가 비활성화됨)</div>
      </div>
      <div x-show="(data.agentic?.retry_attempts||[]).length>0" class="cg">
        <div class="cbox"><div class="ct">시도 횟수 분포</div><div id="l2-retry-dist" class="plt-chart"></div></div>
        <div class="cbox"><div class="ct">태스크 유형별 평균 시도 횟수</div><div id="l2-retry-type" class="plt-chart"></div></div>
      </div>
    </div>
  </div>

  <!-- ── 심화 티어 ── -->
  <div x-show="tag==='advanced'">
    <div class="tabs">
      <div class="tab" :class="{on:t2==='tsel'}"    @click="t2='tsel'">🎯 Tool 선택</div>
      <div class="tab" :class="{on:t2==='coord'}"   @click="t2='coord'">🤝 멀티에이전트</div>
      <div class="tab" :class="{on:t2==='wf'}"      @click="t2='wf'">🔀 워크플로우</div>
    </div>

    <!-- Tool Selection -->
    <div x-show="t2==='tsel'">
      <div x-show="!data.agentic?.tool_selections?.length" class="empty"><p>Tool Selection 데이터 없음 — expected_tools를 설정하세요.</p></div>
      <div x-show="data.agentic?.tool_selections?.length>0">
        <div class="kpi-grid">
          <div class="kpi"><div class="kpi-lbl">평균 Precision</div><div class="kpi-val" x-text="pct(data.agentic?.tool_selection_summary?.avg_precision)"></div></div>
          <div class="kpi"><div class="kpi-lbl">평균 Recall</div><div class="kpi-val" x-text="pct(data.agentic?.tool_selection_summary?.avg_recall)"></div></div>
          <div class="kpi"><div class="kpi-lbl">평균 F1</div><div class="kpi-val" x-text="pct(data.agentic?.tool_selection_summary?.avg_f1_score)"></div></div>
          <div class="kpi"><div class="kpi-lbl">평균 Accuracy</div><div class="kpi-val" x-text="pct(data.agentic?.tool_selection_summary?.avg_accuracy)"></div></div>
          <div class="kpi"><div class="kpi-lbl">평가 Tasks</div><div class="kpi-val" x-text="data.agentic?.tool_selection_summary?.total_selections??0"></div></div>
        </div>
        <div class="sec">
          <div class="sec-t">태스크별 Tool Selection 상세</div>
          <div class="slist">
            <template x-for="s in data.agentic?.tool_selections||[]" :key="s.task_id">
              <div class="drow">
                <span class="dk" x-text="s.task_id"></span>
                <span style="color:var(--text2)" x-text="(s.expected_tools||[]).join(',')||'-'"></span>
                <span :class="s.f1_score>=90?'pg':s.f1_score>=70?'py':'pr'" class="pill" x-text="`F1:${(s.f1_score||0).toFixed(0)}%`"></span>
              </div>
            </template>
          </div>
        </div>
      </div>
    </div>

    <!-- Multi-Agent Coordination -->
    <div x-show="t2==='coord'">
      <div x-show="!data.agentic?.agent_interactions?.length" class="empty"><p>Multi-Agent 데이터 없음</p></div>
      <div x-show="data.agentic?.agent_interactions?.length>0">
        <div class="kpi-grid">
          <div class="kpi"><div class="kpi-lbl">총 상호작용</div><div class="kpi-val" x-text="data.agentic?.coordination_summary?.total_interactions||0"></div></div>
          <div class="kpi"><div class="kpi-lbl">성공 상호작용</div><div class="kpi-val" x-text="data.agentic?.coordination_summary?.successful_interactions||0"></div></div>
          <div class="kpi"><div class="kpi-lbl">성공률</div><div class="kpi-val" x-text="pct(data.agentic?.coordination_summary?.success_rate)"></div></div>
          <div class="kpi"><div class="kpi-lbl">참여 에이전트</div><div class="kpi-val" x-text="data.agentic?.coordination_summary?.unique_agents||0"></div></div>
        </div>
        <div class="sec">
          <div class="sec-t">에이전트 목록</div>
          <template x-for="a in data.agentic?.coordination_summary?.agent_list||[]" :key="a">
            <span class="tag" x-text="a"></span>
          </template>
        </div>
        <div class="sec" x-show="(data.agentic?.agent_interactions||[]).length>1">
          <div class="sec-t">🕸️ 에이전트 상호작용 네트워크</div>
          <p style="font-size:13px;color:var(--text2);margin-bottom:8px">노드: 에이전트 | 엣지 두께: 상호작용 횟수 | 색상: 성공률</p>
          <div class="cbox"><div id="agent-network" class="plt-chart" :style="`height:${Math.max(380, Math.min(560, (data.agentic?.agent_interactions?.length||0)*12+260)}px`"></div></div>
        </div>
        <div class="sec">
          <div class="sec-t">상호작용 로그 <span class="badge" x-text="`${(data.agentic?.agent_interactions||[]).length}건`"></span></div>
          <div class="slist">
            <template x-for="(i,idx) in (data.agentic?.agent_interactions||[]).slice(0,50)" :key="idx">
              <div class="irow">
                <span :class="i.success?'pg':'pr'" class="pill" x-text="i.success?'✓':'✗'"></span>
                <span x-text="i.from_agent" style="color:var(--accent)"></span>
                <span style="color:var(--text2)">→</span>
                <span x-text="i.to_agent"></span>
                <span style="color:var(--text2)" x-text="i.interaction_type"></span>
                <span style="color:var(--text2);margin-left:auto;font-size:14px" x-text="i.timestamp?.substring(0,16)||''"></span>
              </div>
            </template>
          </div>
        </div>
      </div>
    </div>

    <!-- Workflow -->
    <div x-show="t2==='wf'">
      <div x-show="!data.agentic?.workflow_executions?.length" class="empty"><p>Workflow 데이터 없음</p></div>
      <div x-show="data.agentic?.workflow_executions?.length>0">
        <div class="kpi-grid">
          <div class="kpi"><div class="kpi-lbl">총 스텝</div><div class="kpi-val" x-text="data.agentic?.workflow_summary?.total_steps||0"></div></div>
          <div class="kpi"><div class="kpi-lbl">성공 스텝</div><div class="kpi-val" x-text="data.agentic?.workflow_summary?.successful_steps||0"></div></div>
          <div class="kpi"><div class="kpi-lbl">스텝 성공률</div><div class="kpi-val" x-text="pct(data.agentic?.workflow_summary?.step_success_rate)"></div></div>
        </div>
        <div class="sec" x-show="(data.agentic?.workflow_summary?.frameworks||[]).length>0">
          <div class="sec-t">사용 프레임워크</div>
          <template x-for="fw in data.agentic?.workflow_summary?.frameworks||[]" :key="fw">
            <span class="tag" x-text="fw"></span>
          </template>
        </div>
        <div class="sec" x-show="data.agentic?.workflow_summary">
          <div class="sec-t">🔀 워크플로우 실행 퍼널</div>
          <div id="l2-wf-funnel" style="height:240px"></div>
        </div>
        <div class="sec">
          <div class="sec-t">워크플로우 실행 스텝</div>
          <div class="slist">
            <template x-for="(s,idx) in (data.agentic?.workflow_executions||[]).slice(0,30)" :key="idx">
              <div class="step">
                <div class="step-t"><span :class="s.success?'pg':'pr'" class="pill" x-text="s.success?'✓':'✗'"></span> <span x-text="s.step_name||s.task_id"></span></div>
                <div style="color:var(--text2);font-size:14px" x-text="`${s.framework||''} | ${s.execution_time||0}s | ${s.step_type||''}`"></div>
              </div>
            </template>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── 통합 티어 ── -->
  <div x-show="tag==='integrated'">
    <div class="sec">
      <div class="sec-t">🔍 오케스트레이션 트레이스</div>
      <!-- tool_calls 없음 -->
      <div x-show="!(data.tasks||[]).some(t=>(t.tool_calls||[]).length>0)" class="empty" style="padding:16px 0">
        <div style="font-size:24px;margin-bottom:6px">🔌</div>
        <p style="font-weight:600;margin-bottom:4px">Tool 호출 기록이 없습니다</p>
        <p style="font-size:13px;color:var(--text2)">TaskResult의 <code style="background:var(--bg3);padding:1px 5px;border-radius:3px">tool_calls</code> 필드에 데이터가 있을 때 인라인 트레이스가 표시됩니다.</p>
      </div>
      <!-- tool_calls 있음 -->
      <div x-show="(data.tasks||[]).some(t=>(t.tool_calls||[]).length>0)">
        <div style="font-size:13px;color:var(--text2);margin-bottom:10px"
          x-text="`총 ${(data.tasks||[]).filter(t=>(t.tool_calls||[]).length>0).length}개 태스크에서 tool 호출 기록됨`"></div>
        <template x-for="t in (data.tasks||[]).filter(t=>(t.tool_calls||[]).length>0).slice(0,30)" :key="t.task_id">
          <div style="margin-bottom:10px;border:1px solid var(--border);border-radius:6px;overflow:hidden">
            <!-- 태스크 헤더 -->
            <div style="display:flex;gap:8px;align-items:center;padding:7px 10px;background:var(--bg3);border-bottom:1px solid var(--border)">
              <span :class="t.success?'pg':'pr'" class="pill" x-text="t.success?'✓':'✗'"></span>
              <span style="font-weight:600;font-size:13px" x-text="t.task_id"></span>
              <span class="tag" x-text="t.task_type"></span>
              <span style="margin-left:auto;color:var(--text2);font-size:13px;font-variant-numeric:tabular-nums" x-text="(t.execution_time||0).toFixed(2)+'s'"></span>
            </div>
            <!-- tool_calls 목록 -->
            <div style="padding:6px 10px 6px 16px;border-left:3px solid var(--accent);margin:6px 8px;border-radius:0 4px 4px 0">
              <template x-for="(tc,i) in t.tool_calls||[]" :key="i">
                <div style="display:flex;gap:8px;align-items:center;padding:3px 0;font-size:13px">
                  <span style="color:var(--text2);font-variant-numeric:tabular-nums;min-width:18px;text-align:right" x-text="(i+1)+'.'"></span>
                  <span class="tag" x-text="typeof tc==='string'?tc:(tc.tool_name||tc.name||tc.function||JSON.stringify(tc))"></span>
                  <template x-if="typeof tc==='object' && tc!=null">
                    <span :class="tc.success===false?'pr':tc.success===true?'pg':''" class="pill"
                      x-show="tc.success!=null" x-text="tc.success?'OK':'FAIL'" style="font-size:11px"></span>
                  </template>
                  <span x-show="typeof tc==='object' && tc?.execution_time"
                    style="color:var(--text2);margin-left:auto;font-variant-numeric:tabular-nums"
                    x-text="(tc?.execution_time||0).toFixed(2)+'s'"></span>
                </div>
              </template>
            </div>
          </div>
        </template>
        <div x-show="(data.tasks||[]).filter(t=>(t.tool_calls||[]).length>0).length>30"
          style="font-size:13px;color:var(--text2);text-align:center;padding:8px">
          상위 30개 태스크만 표시됩니다.
        </div>
      </div>
    </div>
    <div class="sec">
      <div class="sec-t">🏗️ 프레임워크 정보</div>
      <!-- 프레임워크 미설정 -->
      <div x-show="frameworkDist().every(f=>f.name==='unknown')" class="empty" style="padding:16px 0">
        <div style="font-size:24px;margin-bottom:6px">🔌</div>
        <p style="font-weight:600;margin-bottom:4px">프레임워크 정보가 없습니다</p>
        <p style="font-size:13px;color:var(--text2);margin-bottom:8px">TaskResult 또는 create_taskresult() 에 <code style="background:var(--bg3);padding:1px 5px;border-radius:3px">framework</code> 필드를 설정하면 여기에 표시됩니다.</p>
        <code style="display:block;background:var(--bg3);padding:8px 12px;border-radius:6px;font-size:13px;text-align:left;max-width:400px;margin:0 auto">create_taskresult(..., framework="crewai")</code>
      </div>
      <!-- 프레임워크 있음 -->
      <div x-show="frameworkDist().some(f=>f.name!=='unknown')">
        <table style="width:100%;border-collapse:collapse;font-size:13px;border:1px solid var(--border);border-radius:6px;overflow:hidden">
          <colgroup><col style="width:auto"><col style="width:72px"><col style="width:80px"><col style="width:80px"></colgroup>
          <thead>
            <tr style="background:var(--bg3);color:var(--text2);font-weight:600">
              <th style="padding:6px 10px;text-align:left;border-bottom:1px solid var(--border)">프레임워크</th>
              <th style="padding:6px 10px;text-align:right;border-bottom:1px solid var(--border)">태스크</th>
              <th style="padding:6px 10px;text-align:right;border-bottom:1px solid var(--border)">성공률</th>
              <th style="padding:6px 10px;text-align:right;border-bottom:1px solid var(--border)">비율</th>
            </tr>
          </thead>
          <tbody>
            <template x-for="fw in frameworkDist().filter(f=>f.name!=='unknown')" :key="fw.name">
              <tr>
                <td style="padding:6px 10px;border-bottom:1px solid var(--border);font-weight:500" x-text="fw.name"></td>
                <td style="padding:6px 10px;text-align:right;border-bottom:1px solid var(--border);font-variant-numeric:tabular-nums" x-text="fw.count"></td>
                <td style="padding:6px 10px;text-align:right;border-bottom:1px solid var(--border);font-variant-numeric:tabular-nums"
                  :style="fw.rate>=80?'color:var(--green)':fw.rate>=50?'color:var(--yellow)':'color:var(--red)'"
                  x-text="fw.rate.toFixed(1)+'%'"></td>
                <td style="padding:6px 10px;text-align:right;border-bottom:1px solid var(--border);color:var(--text2);font-variant-numeric:tabular-nums"
                  x-text="((fw.count/(data.total_tasks||1))*100).toFixed(1)+'%'"></td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  </div>
</div>

<!-- ══ LAYER 3: ADVANCED (legacy — hidden, content moved to quality/integrated tier) ══ -->
<div x-show="false" style="display:none!important">
  <div id="l3-geval-hist"></div>
  <div id="l3-rag-bar"></div>
</div>

<!-- ══ 성능 (Performance) ══ -->
<div x-show="data && sec==='performance'" x-cloak>

  <div class="tabs">
    <div class="tab" :class="{on:tperf==='basic'}"      @click="tperf='basic';tp='lat'">🔵 기본</div>
    <div class="tab" :class="{on:tperf==='advanced'}"   @click="tperf='advanced';tp='tok'">🟡 심화</div>
    <div class="tab" :class="{on:tperf==='integrated'}" @click="tperf='integrated'">🟣 통합</div>
    <span style="margin-left:auto;font-size:14px;color:var(--text2)">
      성능 Score: <b x-text="perspScore('performance',data)"></b>/100
    </span>
  </div>

  <div class="sec" style="padding:8px 12px;font-size:13px;color:var(--text2);border-left:3px solid var(--accent)">
    <span x-show="tperf==='basic'">🔵 기본 — 응답 지연(Latency) 및 SLA 준수 현황.</span>
    <span x-show="tperf==='advanced'">🟡 심화 — 토큰 비용, 예산 추적, 리소스 효율성 점수.</span>
    <span x-show="tperf==='integrated'">🟣 통합 — 프레임워크 분석 및 외부 APM 연동 가이드.</span>
  </div>

  <!-- ── 기본 티어 ── -->
  <div x-show="tperf==='basic'">
    <!-- SLA 준수 현황 -->
    <div class="sec">
      <div class="sec-t">📋 SLA 준수 현황</div>
      <table style="width:100%;border-collapse:collapse;font-size:14px;table-layout:fixed">
        <colgroup>
          <col style="width:auto">
          <col style="width:110px">
          <col style="width:110px">
          <col style="width:110px">
        </colgroup>
        <thead>
          <tr style="color:var(--text2);border-bottom:1px solid var(--border)">
            <th style="text-align:left;padding:6px 8px;font-weight:600">SLA 항목</th>
            <th style="text-align:right;padding:6px 8px;font-weight:600">목표</th>
            <th style="text-align:right;padding:6px 8px;font-weight:600">현재</th>
            <th style="text-align:left;padding:6px 8px;font-weight:600">상태</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom:1px solid var(--border)">
            <td style="padding:6px 8px">응답 시간 P95</td>
            <td style="padding:6px 8px;text-align:right;color:var(--text2)">≤ 2.0s</td>
            <td style="padding:6px 8px;text-align:right" x-text="(data.efficiency_metrics?.latency?.p95||0).toFixed(2)+'s'"></td>
            <td style="padding:6px 8px;text-align:left" :style="(data.efficiency_metrics?.latency?.p95||0)<=2?'color:var(--green)':'color:var(--red)'" x-text="(data.efficiency_metrics?.latency?.p95||0)<=2?'✅ PASS':'❌ FAIL'"></td>
          </tr>
          <tr style="border-bottom:1px solid var(--border)">
            <td style="padding:6px 8px">응답 시간 P99</td>
            <td style="padding:6px 8px;text-align:right;color:var(--text2)">≤ 5.0s</td>
            <td style="padding:6px 8px;text-align:right" x-text="(data.efficiency_metrics?.latency?.p99||0).toFixed(2)+'s'"></td>
            <td style="padding:6px 8px;text-align:left" :style="(data.efficiency_metrics?.latency?.p99||0)<=5?'color:var(--green)':'color:var(--red)'" x-text="(data.efficiency_metrics?.latency?.p99||0)<=5?'✅ PASS':'❌ FAIL'"></td>
          </tr>
          <tr>
            <td style="padding:6px 8px">Task당 비용</td>
            <td style="padding:6px 8px;text-align:right;color:var(--text2)">≤ $0.01</td>
            <td style="padding:6px 8px;text-align:right" x-text="'$'+(data.efficiency_metrics?.tokens?.avg_cost_per_task||0).toFixed(4)"></td>
