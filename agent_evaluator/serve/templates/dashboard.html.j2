      <!-- Slides -->
      <div class="cbox" style="display:flex;flex-direction:column;gap:8px">
        <div style="font-size:15px;font-weight:600">📊 Slides</div>
        <div style="font-size:12px;color:var(--text2);flex:1">
          프레젠테이션용 슬라이드.<br>
          Executive Summary·Cost Analysis·Latency·Accuracy·Agentic·Security 등 섹션별 차트와 인사이트 포함. Reveal.js 기반.<br>
          <span style="color:var(--accent)">팀 공유·리뷰 미팅·임원 보고에 최적.</span>
        </div>
        <button class="btn" style="text-align:center" @click="window.open('/slides'+(selId?'?id='+selId:''),'_blank')">🔗 새 탭에서 열기</button>
      </div>

    </div>

    <!-- 파일 정보 -->
    <div class="sec-t" style="margin-bottom:8px">파일 정보</div>
    <div class="drow"><span class="dk">파일</span><span x-text="data.name"></span></div>
    <div class="drow"><span class="dk">타임스탬프</span><span x-text="data.timestamp"></span></div>
    <div class="drow"><span class="dk">총 Tasks</span><span x-text="data.total_tasks"></span></div>

    <!-- 품질 지표 -->
    <div class="sec-t" style="margin:10px 0 4px;font-size:11px;letter-spacing:.04em;color:var(--text2)">품질 지표</div>
    <div class="drow"><span class="dk" style="font-size:11px">응답 품질 평가</span><span style="font-size:11px" :style="data.has_quality?'color:var(--green);font-weight:700':'color:var(--text2)'" x-text="data.has_quality?'있음':'없음'"></span></div>
    <div class="drow"><span class="dk" style="font-size:11px">환각 탐지</span><span style="font-size:11px" :style="data.has_hallucination?'color:var(--green);font-weight:700':'color:var(--text2)'" x-text="data.has_hallucination?'있음':'없음'"></span></div>

    <!-- 에이전틱 지표 -->
    <div class="sec-t" style="margin:10px 0 4px;font-size:11px;letter-spacing:.04em;color:var(--text2)">에이전틱 지표</div>
    <div class="drow"><span class="dk" style="font-size:11px">도구 선택/사용</span><span style="font-size:11px" :style="data.has_tool_use?'color:var(--green);font-weight:700':'color:var(--text2)'" x-text="data.has_tool_use?'있음':'없음'"></span></div>
    <div class="drow"><span class="dk" style="font-size:11px">에이전트 협업</span><span style="font-size:11px" :style="data.has_coordination?'color:var(--green);font-weight:700':'color:var(--text2)'" x-text="data.has_coordination?'있음':'없음'"></span></div>
    <div class="drow"><span class="dk" style="font-size:11px">워크플로우</span><span style="font-size:11px" :style="data.has_workflow?'color:var(--green);font-weight:700':'color:var(--text2)'" x-text="data.has_workflow?'있음':'없음'"></span></div>
    <div class="drow"><span class="dk" style="font-size:11px">재시도/수정</span><span style="font-size:11px" :style="data.has_retry?'color:var(--green);font-weight:700':'color:var(--text2)'" x-text="data.has_retry?'있음':'없음'"></span></div>

    <!-- 보안 지표 -->
    <div class="sec-t" style="margin:10px 0 4px;font-size:11px;letter-spacing:.04em;color:var(--text2)">보안 지표</div>
    <div class="drow"><span class="dk" style="font-size:11px">입력 보안</span><span style="font-size:11px" :style="data.has_input_security?'color:var(--green);font-weight:700':'color:var(--text2)'" x-text="data.has_input_security?'있음':'없음'"></span></div>
    <div class="drow"><span class="dk" style="font-size:11px">출력 보안</span><span style="font-size:11px" :style="data.has_output_security?'color:var(--green);font-weight:700':'color:var(--text2)'" x-text="data.has_output_security?'있음':'없음'"></span></div>
    <div class="drow"><span class="dk" style="font-size:11px">도구 권한 통제</span><span style="font-size:11px" :style="data.has_tool_auth?'color:var(--green);font-weight:700':'color:var(--text2)'" x-text="data.has_tool_auth?'있음':'없음'"></span></div>
    <div class="drow"><span class="dk" style="font-size:11px">권한 상승/공격 패턴</span><span style="font-size:11px" :style="data.has_attack_detect?'color:var(--green);font-weight:700':'color:var(--text2)'" x-text="data.has_attack_detect?'있음':'없음'"></span></div>

    <!-- 외부 평가 지표 -->
    <div class="sec-t" style="margin:10px 0 4px;font-size:11px;letter-spacing:.04em;color:var(--text2)">외부 평가 지표</div>
    <div class="drow"><span class="dk" style="font-size:11px">DeepEval / Ragas</span><span style="font-size:11px" :style="data.has_advanced?'color:var(--green);font-weight:700':'color:var(--text2)'" x-text="data.has_advanced?'있음':'없음'"></span></div>
    <div class="drow"><span class="dk" style="font-size:11px">RAG (Ragas)</span><span style="font-size:11px" :style="data.has_rag?'color:var(--green);font-weight:700':'color:var(--text2)'" x-text="data.has_rag?'있음':'없음'"></span></div>
  </div>
</div>

<!-- ══ SETTINGS ══ -->
<div x-show="sec==='settings'" x-cloak>
  <div class="sec">
    <div class="sec-t">⚙️ 임계값 설정</div>
    <!-- 영향 범위 안내 -->
    <div style="background:var(--bg3);border:1px solid var(--border);border-radius:var(--r);padding:10px 14px;margin-bottom:14px;font-size:13px;color:var(--text2)">
      <b style="color:var(--accent)">임계값 변경 시 실시간으로 반영되는 항목:</b>
      <ul style="margin:6px 0 0 14px;line-height:1.8">
        <li>Overview KPI 카드 통과/주의 뱃지 (Task Completion, Accuracy)</li>
        <li>Overview Deployment Gate — 개발 · 스테이징 · 프로덕션 기준선</li>
        <li>Overview 트렌드 차트 — TCR · Accuracy 목표 기준선</li>
        <li>Insights 이상 탐지 · Metric Status 테이블 경보 판정</li>
        <li>지표 설명(★ 목표값) — TCR · Accuracy · Hallucination · Latency · Cost</li>
        <li>품질 심화 — 벤치마크 비교 목표 값 · 목표 달성/미달 판정</li>
        <li>성능 기본 — SLA 준수 현황 P95 · P99 Latency · Task당 비용 목표 기준선 · PASS/FAIL 판정</li>
        <li>성능 심화 — 리소스 효율성 점수 기준값 · Cost 목표 대비 비교표</li>
      </ul>
    </div>
    <div style="margin-bottom:12px">
      <span style="font-size:13px;color:var(--text2);margin-right:8px">프리셋:</span>
      <button class="btn" @click="thresholds={tcr:90,acc:70,hall:5,p95:2.0,p99:5.0,cost:0.01}">기본값</button>
      <button class="btn" @click="thresholds={tcr:95,acc:85,hall:3,p95:1.5,p99:3.0,cost:0.005}" style="margin-left:6px">엄격</button>
      <button class="btn" @click="thresholds={tcr:80,acc:60,hall:10,p95:3.0,p99:8.0,cost:0.02}" style="margin-left:6px">완화</button>
    </div>
    <div class="drow" style="align-items:center">
      <span class="dk">TCR 목표</span>
      <input type="range" x-model.number="thresholds.tcr" min="50" max="100" step="1" style="flex:1;margin:0 10px;accent-color:var(--accent)">
      <span style="min-width:38px;text-align:right" x-text="thresholds.tcr+'%'"></span>
      <span class="pill" :class="tcr()>=thresholds.tcr?'pg':'pr'" x-text="tcr()>=thresholds.tcr?'✅ 통과':'❌ 실패'"></span>
    </div>
    <div class="drow" style="align-items:center">
      <span class="dk">Accuracy 목표</span>
      <input type="range" x-model.number="thresholds.acc" min="30" max="100" step="1" style="flex:1;margin:0 10px;accent-color:var(--accent)">
      <span style="min-width:38px;text-align:right" x-text="thresholds.acc+'%'"></span>
      <span class="pill" :class="acc()>=thresholds.acc?'pg':'pr'" x-text="acc()>=thresholds.acc?'✅ 통과':'❌ 실패'"></span>
    </div>
    <div class="drow" style="align-items:center">
      <span class="dk">Hallucination 허용</span>
      <input type="range" x-model.number="thresholds.hall" min="0" max="30" step="0.5" style="flex:1;margin:0 10px;accent-color:var(--accent)">
      <span style="min-width:38px;text-align:right" x-text="thresholds.hall+'%'"></span>
      <span class="pill" :class="hall()<=thresholds.hall?'pg':'pr'" x-text="hall()<=thresholds.hall?'✅ 통과':'❌ 실패'"></span>
    </div>
    <div style="font-size:14px;color:var(--text2);margin:-4px 0 6px 6px">
      SAFE ≤ <span x-text="thresholds.hall+'%'"></span> &nbsp;|&nbsp;
      WARNING ≤ <span x-text="(thresholds.hall*3).toFixed(1)+'%'"></span> &nbsp;|&nbsp;
      DANGER > <span x-text="(thresholds.hall*3).toFixed(1)+'%'"></span>
      &nbsp;(hr_col/hr_lbl 함수에 반영됨)
    </div>
    <div class="drow" style="align-items:center">
      <span class="dk">P95 Latency 목표</span>
      <input type="range" x-model.number="thresholds.p95" min="0.5" max="10" step="0.1" style="flex:1;margin:0 10px;accent-color:var(--accent)">
      <span style="min-width:38px;text-align:right" x-text="thresholds.p95+'s'"></span>
      <span class="pill" :class="(data.efficiency_metrics?.latency?.p95||99)<=thresholds.p95?'pg':'pr'" x-text="(data.efficiency_metrics?.latency?.p95||99)<=thresholds.p95?'✅ 통과':'❌ 실패'"></span>
    </div>
    <div class="drow" style="align-items:center">
      <span class="dk">P99 Latency 목표</span>
      <input type="range" x-model.number="thresholds.p99" min="1.0" max="30" step="0.5" style="flex:1;margin:0 10px;accent-color:var(--accent)">
      <span style="min-width:38px;text-align:right" x-text="thresholds.p99+'s'"></span>
      <span class="pill" :class="(data.efficiency_metrics?.latency?.p99||99)<=thresholds.p99?'pg':'pr'" x-text="(data.efficiency_metrics?.latency?.p99||99)<=thresholds.p99?'✅ 통과':'❌ 실패'"></span>
    </div>
    <div class="drow" style="align-items:center">
      <span class="dk">Task당 비용 목표</span>
      <input type="range" x-model.number="thresholds.cost" min="0.001" max="0.1" step="0.001" style="flex:1;margin:0 10px;accent-color:var(--accent)">
      <span style="min-width:60px;text-align:right" x-text="'$'+thresholds.cost.toFixed(3)"></span>
      <span class="pill" :class="(data.efficiency_metrics?.tokens?.avg_cost_per_task||99)<=thresholds.cost?'pg':'pr'" x-text="(data.efficiency_metrics?.tokens?.avg_cost_per_task||99)<=thresholds.cost?'✅ 통과':'❌ 실패'"></span>
    </div>
    <div style="display:flex;gap:8px;margin-top:14px;align-items:center">
      <button class="btn" style="color:var(--green);border-color:var(--green)" @click="saveThresholds()">💾 저장</button>
      <span x-show="thresholdSaved" x-transition style="font-size:13px;color:var(--green)">✅ 저장됨</span>
    </div>
  </div>
</div>

<!-- ══ TASK DETAIL MODAL ══ -->
<div class="modal-backdrop" x-show="taskDetail" x-cloak @click.self="taskDetail=null">
  <div class="modal" x-show="taskDetail">
    <div class="modal-t">
      <span>📋 Task 상세: <span x-text="taskDetail?.task_id"></span></span>
      <button class="btn" @click="taskDetail=null">✕ 닫기</button>
    </div>
    <div x-show="taskDetail">
      <div class="kpi-grid" style="margin-bottom:12px">
        <div class="kpi"><div class="kpi-lbl">Type</div><div class="kpi-val" style="font-size:14px" x-text="taskDetail?.task_type||'—'"></div></div>
        <div class="kpi"><div class="kpi-lbl">성공</div><div class="kpi-val" x-text="taskDetail?.success?'✅':'❌'"></div></div>
        <div class="kpi"><div class="kpi-lbl">Completion</div><div class="kpi-val" style="font-size:16px" x-text="pct((taskDetail?.completion_score||0)*100)"></div></div>
        <div class="kpi"><div class="kpi-lbl">Accuracy</div><div class="kpi-val" style="font-size:16px" x-text="pct((taskDetail?.accuracy_score||0)*100)"></div></div>
        <div class="kpi"><div class="kpi-lbl">Latency</div><div class="kpi-val" style="font-size:16px" x-text="sec_(taskDetail?.execution_time)"></div></div>
        <div class="kpi"><div class="kpi-lbl">Tokens</div><div class="kpi-val" style="font-size:16px" x-text="((taskDetail?.tokens_used?.total)||(taskDetail?.tokens_used?.input||0)+(taskDetail?.tokens_used?.output||0)).toLocaleString()"></div></div>
      </div>
      <!-- 부분 성공/실패 원인 진단 -->
      <div x-show="taskDetail && taskDetail.completion_score < 1.0" style="margin-bottom:12px;padding:10px 12px;border-radius:8px;border-left:3px solid"
           :style="taskDetail?.completion_score>=0.7?'border-color:var(--yellow);background:rgba(234,179,8,.06)':'border-color:var(--red);background:rgba(248,113,113,.06)'">
        <div style="font-size:12px;font-weight:600;margin-bottom:4px"
             :style="taskDetail?.completion_score>=0.7?'color:#ca8a04':'color:var(--red)'"
             x-text="taskDetail?.completion_score>=0.7?'🟡 부분 성공 원인 진단':'❌ 실패 원인 진단'">
        </div>
        <div style="font-size:13px;color:var(--text)" x-text="taskDetail ? diagnosisMsg(taskDetail) : ''"></div>
      </div>
      <div style="margin-top:16px;border-top:1px solid var(--border);padding-top:14px">
      <div class="sec-t" style="margin-bottom:8px">상세 정보</div>
      <div class="drow"><span class="dk">Attempts</span><span x-text="taskDetail?.attempts??'—'"></span></div>
      <div class="drow"><span class="dk">Framework</span><span x-text="taskDetail?.framework||'—'"></span></div>
      <div class="drow"><span class="dk">Timestamp</span><span x-text="(taskDetail?.timestamp||'').substring(0,19)"></span></div>
      <div class="drow" x-show="(taskDetail?.expected_tools||[]).length>0">
        <span class="dk">Expected Tools</span>
        <span>
          <template x-for="t in taskDetail?.expected_tools||[]" :key="t"><span class="tag" x-text="t"></span></template>
        </span>
      </div>
      <div class="drow" x-show="(taskDetail?.tool_calls||[]).length>0">
        <span class="dk">Tool Calls</span><span x-text="(taskDetail?.tool_calls||[]).length+'건'"></span>
      </div>
      <div x-show="(taskDetail?.errors||[]).length>0" style="margin-top:8px">
        <div class="sec-t" style="color:var(--red);margin-bottom:6px">⚠️ 오류</div>
        <template x-for="(e,i) in taskDetail?.errors||[]" :key="i">
          <div style="font-size:13px;color:var(--red);background:rgba(248,113,113,.08);border-radius:6px;padding:6px 10px;margin-bottom:4px" x-text="typeof e==='string'?e:JSON.stringify(e)"></div>
        </template>
      </div>
      <div x-show="taskDetail?.advanced_metrics && Object.keys(taskDetail?.advanced_metrics||{}).length>0" style="margin-top:8px">
        <div class="sec-t" style="margin-bottom:6px">🔬 Advanced Metrics</div>
        <template x-for="[k,v] in Object.entries(taskDetail?.advanced_metrics||{})" :key="k">
          <div class="drow"><span class="dk" x-text="k.replace(/_/g,' ')"></span><span x-text="typeof v==='number'?v.toFixed(4):JSON.stringify(v)"></span></div>
        </template>
      </div>
      </div><!-- /상세 정보 wrapper -->
    </div>
  </div>
</div>

<!-- ══ 케이스 검토 (Phase 3-A) ══ -->
<div x-show="sec==='golden'" x-cloak
     x-data="{ candidateFiles:[], candidateCases:[], reviewFile:null, reviewLoading:false,
                versions:[],
                async loadCandidates(){ this.reviewLoading=true; try{ const r=await fetch('/api/golden/candidates'); this.candidateFiles=r.ok?await r.json():[]; }catch(e){} finally{this.reviewLoading=false;} },
                async loadCandidateFile(n){ this.reviewFile=n; this.reviewLoading=true; try{ const r=await fetch('/api/golden/candidates/'+encodeURIComponent(n)); this.candidateCases=r.ok?await r.json():[]; }catch(e){} finally{this.reviewLoading=false;} },
                async approveCase(n,i){ const r=await fetch('/api/golden/candidates/'+encodeURIComponent(n)+'/approve/'+i,{method:'POST'}); if(r&&r.ok) await this.loadCandidateFile(n); },
                async rejectCase(n,i){ const r=await fetch('/api/golden/candidates/'+encodeURIComponent(n)+'/reject/'+i,{method:'POST'}); if(r&&r.ok) await this.loadCandidateFile(n); },
                async mergeApproved(n){ const r=await fetch('/api/golden/candidates/'+encodeURIComponent(n)+'/merge',{method:'POST'}); if(r&&r.ok){ const d=await r.json(); alert('✅ '+d.merged+'건이 '+d.filename+'으로 병합됐습니다.'); this.loadCandidates(); } },
                async loadVersions(){ try{ const r=await fetch('/api/golden/versions'); this.versions=r.ok?await r.json():[]; }catch(e){} } }"
     x-init="loadCandidates(); loadVersions()">
  <div class="sec" style="margin-top:16px">
    <div class="sec-t">🗂️ 케이스 검토 — 후보 케이스 승인/거부</div>
    <div style="font-size:var(--fs-sm);color:var(--text2);margin-bottom:12px"><code>agent-eval dataset build</code>로 추출한 후보 케이스를 검토하고 골든셋으로 병합합니다.</div>

    <template x-if="reviewLoading"><div style="color:var(--text2);padding:16px">⏳ 로딩 중…</div></template>

    <template x-if="!reviewLoading && !reviewFile">
      <div>
        <template x-if="!candidateFiles.length">
          <div class="es"><div class="es-icon">🗂️</div><div class="es-title">후보 케이스 파일 없음</div>
          <div class="es-desc"><code>agent-eval dataset build --source results/</code>를 실행하면 이 화면에 파일이 표시됩니다.</div></div>
        </template>
        <template x-for="f in candidateFiles" :key="f.name">
          <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;border:1px solid var(--border);border-radius:var(--r);margin-bottom:8px;cursor:pointer;background:var(--bg2)" @click="loadCandidateFile(f.name)">
            <div style="flex:1">
              <div style="font-weight:600;font-size:var(--fs-sm)" x-text="f.name"></div>
              <div style="font-size:var(--fs-xs);color:var(--text2);margin-top:2px">
                총 <span x-text="f.total"></span>건 | 대기 <span style="color:#f59e0b;font-weight:700" x-text="f.pending"></span> | 승인 <span style="color:#10b981;font-weight:700" x-text="f.approved"></span> | 거부 <span style="color:#ef4444;font-weight:700" x-text="f.rejected"></span>
              </div>
            </div>
            <button class="btn" style="color:var(--accent);border-color:var(--accent);font-size:var(--fs-xs)">검토 →</button>
          </div>
        </template>
        <!-- 버전 히스토리 -->
        <template x-if="versions.length > 0">
          <div style="margin-top:16px">
            <div style="font-weight:600;font-size:var(--fs-sm);margin-bottom:8px">골든셋 버전 히스토리</div>
            <template x-for="v in versions" :key="v.name">
              <div style="display:flex;justify-content:space-between;padding:6px 10px;border-bottom:1px solid var(--border);font-size:var(--fs-xs)">
                <span style="font-weight:600" x-text="v.name"></span>
                <span style="color:var(--text2)" x-text="v.count+'건'"></span>
              </div>
            </template>
          </div>
        </template>
      </div>
    </template>

    <template x-if="!reviewLoading && reviewFile">
      <div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px">
          <button class="btn" @click="reviewFile=null;candidateCases=[]">← 목록</button>
          <span style="font-weight:600;font-size:var(--fs-sm)" x-text="reviewFile"></span>
          <div style="flex:1"></div>
          <button class="btn" style="background:var(--green,#10b981);color:#fff;font-size:var(--fs-xs)"
                  x-show="candidateCases.some(c=>c._approved)"
                  @click="mergeApproved(reviewFile)">승인된 케이스 병합</button>
        </div>
        <template x-for="c in candidateCases" :key="c._idx">
          <div style="padding:12px;border:1px solid var(--border);border-left-width:3px;border-radius:var(--r);margin-bottom:8px;background:var(--bg2)"
               :style="c._approved?'border-left-color:#10b981':c._rejected?'border-left-color:#ef4444':'border-left-color:var(--border)'">
            <div style="display:flex;align-items:flex-start;gap:8px">
              <div style="flex:1">
                <div style="display:flex;gap:4px;margin-bottom:6px;flex-wrap:wrap">
                  <span style="font-size:var(--fs-xs);padding:2px 6px;border-radius:4px;background:var(--bg3);color:var(--text2)" x-text="c._strategy||c.strategy||'unknown'"></span>
                  <span x-show="c._approved" style="font-size:var(--fs-xs);padding:2px 6px;border-radius:4px;background:#10b98122;color:#10b981">✅ 승인됨</span>
                  <span x-show="c._rejected" style="font-size:var(--fs-xs);padding:2px 6px;border-radius:4px;background:#ef444422;color:#ef4444">❌ 거부됨</span>
                </div>
                <div style="font-size:var(--fs-sm);margin-bottom:4px">Q: <span x-text="c.question||c.task_id||'(질문 없음)'"></span></div>
                <template x-if="c.response||c.answer">
                  <div style="font-size:var(--fs-xs);color:var(--text2)">A: <span x-text="(c.response||c.answer||'').substring(0,100)+'…'"></span></div>
                </template>
              </div>
              <div style="display:flex;flex-direction:column;gap:4px;flex-shrink:0">
                <button class="btn" style="font-size:var(--fs-xs);background:#10b981;color:#fff;padding:3px 8px" x-show="!c._approved" @click="approveCase(reviewFile,c._idx)">승인</button>
                <button class="btn" style="font-size:var(--fs-xs);background:#ef4444;color:#fff;padding:3px 8px" x-show="!c._rejected" @click="rejectCase(reviewFile,c._idx)">거부</button>
              </div>
            </div>
          </div>
        </template>
      </div>
    </template>
  </div>
</div>

<!-- ══ 멀티턴 대화 (Phase 1-C) ══ -->
<div x-show="data && sec==='conversation'" x-cloak>
  <div style="margin-bottom:14px">
    <div style="font-size:var(--fs-xl);font-weight:700;margin-bottom:4px">💬 멀티턴 대화 평가</div>
    <div style="color:var(--text2);font-size:var(--fs-sm)">ConversationSession 기반 맥락 유지율 · 주제 일관성 · 점진적 심화 · 세션 완결성 측정</div>
  </div>

  <template x-if="!convData || !convData.session_count">
    <div class="es"><div class="es-icon">💬</div><div class="es-title">멀티턴 대화 데이터 없음</div>
    <div class="es-desc">SDK에서 <code>monitor.conversation("session_id")</code> 컨텍스트 매니저로 대화를 기록하세요.</div></div>
  </template>

  <template x-if="convData && convData.session_count > 0">
    <div>
      <!-- KPI -->
      <div class="kpi-grid" style="grid-template-columns:repeat(auto-fill,minmax(160px,1fr))">
        <div class="kpi">
          <div style="font-size:var(--fs-sm);color:var(--text2)">세션 수</div>
          <div style="font-size:var(--fs-xl);font-weight:700" x-text="convData.session_count"></div>
        </div>
        <div class="kpi">
          <div style="font-size:var(--fs-sm);color:var(--text2)">평균 종합점수</div>
          <div style="font-size:var(--fs-xl);font-weight:700;color:var(--accent)" x-text="(convData.summary?.avg_overall_score*100||0).toFixed(1)+'%'"></div>
        </div>
        <div class="kpi">
          <div style="font-size:var(--fs-sm);color:var(--text2)">평균 턴 수</div>
          <div style="font-size:var(--fs-xl);font-weight:700" x-text="(convData.summary?.avg_turns||0).toFixed(1)"></div>
        </div>
        <div class="kpi">
          <div style="font-size:var(--fs-sm);color:var(--text2)">맥락 유지율</div>
          <div style="font-size:var(--fs-xl);font-weight:700" x-text="(convData.summary?.avg_context_retention*100||0).toFixed(1)+'%'"></div>
        </div>
        <div class="kpi">
          <div style="font-size:var(--fs-sm);color:var(--text2)">주제 일관성</div>
          <div style="font-size:var(--fs-xl);font-weight:700" x-text="(convData.summary?.avg_topic_coherence*100||0).toFixed(1)+'%'"></div>
        </div>
        <div class="kpi">
          <div style="font-size:var(--fs-sm);color:var(--text2)">점진적 심화</div>
          <div style="font-size:var(--fs-xl);font-weight:700" x-text="(convData.summary?.avg_progressive_depth*100||0).toFixed(1)+'%'"></div>
        </div>
        <div class="kpi">
          <div style="font-size:var(--fs-sm);color:var(--text2)">세션 완결성</div>
          <div style="font-size:var(--fs-xl);font-weight:700" x-text="(convData.summary?.avg_session_completion*100||0).toFixed(1)+'%'"></div>
        </div>
        <div class="kpi">
          <div style="font-size:var(--fs-sm);color:var(--text2)">평균 응답 지연</div>
          <div style="font-size:var(--fs-xl);font-weight:700" x-text="(convData.summary?.avg_response_latency||0).toFixed(2)+'s'"></div>
        </div>
      </div>

      <!-- 세션 목록 -->
      <div style="background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);overflow:hidden">
        <div style="padding:10px 14px;font-weight:600;border-bottom:1px solid var(--border)">세션 목록</div>
        <table style="width:100%;border-collapse:collapse;font-size:var(--fs-sm)">
          <thead><tr style="background:var(--bg3);color:var(--text2)">
            <th style="padding:8px 12px;text-align:left">세션 ID</th>
            <th style="padding:8px 12px;text-align:center">턴 수</th>
            <th style="padding:8px 12px;text-align:center">종합점수</th>
            <th style="padding:8px 12px;text-align:center">맥락 유지</th>
            <th style="padding:8px 12px;text-align:center">주제 일관성</th>
            <th style="padding:8px 12px;text-align:center">심화</th>
            <th style="padding:8px 12px;text-align:center">완결성</th>
          </tr></thead>
          <tbody>
            <template x-for="s in (convData.sessions||[])" :key="s.session_id">
              <tr style="border-top:1px solid var(--border);cursor:pointer" @click="convSelected=(convSelected===s.session_id?null:s.session_id)" :style="convSelected===s.session_id?'background:var(--bg3)':''">
                <td style="padding:8px 12px;font-weight:600;color:var(--accent)" x-text="s.session_id"></td>
                <td style="padding:8px 12px;text-align:center" x-text="s.turn_count"></td>
                <td style="padding:8px 12px;text-align:center;font-weight:700" x-text="(s.metrics?.overall_score*100||0).toFixed(1)+'%'"></td>
                <td style="padding:8px 12px;text-align:center" x-text="(s.metrics?.context_retention*100||0).toFixed(1)+'%'"></td>
                <td style="padding:8px 12px;text-align:center" x-text="(s.metrics?.topic_coherence*100||0).toFixed(1)+'%'"></td>
                <td style="padding:8px 12px;text-align:center" x-text="(s.metrics?.progressive_depth*100||0).toFixed(1)+'%'"></td>
                <td style="padding:8px 12px;text-align:center" x-text="(s.metrics?.session_completion*100||0).toFixed(1)+'%'"></td>
              </tr>
              <!-- 턴 상세 -->
              <template x-if="convSelected===s.session_id">
                <tr><td colspan="7" style="padding:0;background:var(--bg3)">
                  <div style="padding:12px 16px">
                    <div style="font-weight:600;margin-bottom:8px;color:var(--accent)">턴별 상세</div>
                    <template x-for="(turn, ti) in (s.turns||[])" :key="ti">
                      <div style="background:var(--bg2);border:1px solid var(--border);border-radius:6px;padding:10px;margin-bottom:8px">
                        <div style="font-size:var(--fs-xs);color:var(--text2);margin-bottom:4px" x-text="'턴 '+(ti+1)"></div>
                        <div style="margin-bottom:6px"><span style="color:var(--text2);font-size:var(--fs-xs)">USER: </span><span style="font-size:var(--fs-sm)" x-text="turn.user"></span></div>
                        <div><span style="color:var(--accent);font-size:var(--fs-xs)">AGENT: </span><span style="font-size:var(--fs-sm)" x-text="turn.agent"></span></div>
                      </div>
                    </template>
                  </div>
                </td></tr>
              </template>
            </template>
          </tbody>
        </table>
      </div>
    </div>
  </template>
</div>

<!-- ══ 실시간 모니터링 (Phase 2-A) ══ -->
<div x-show="sec==='realtime'" x-cloak x-init="if(sec==='realtime'){loadRealtime();realtimePolling=setInterval(()=>loadRealtime(),15000)}" @sec-changed.window="if($event.detail!=='realtime'&&realtimePolling){clearInterval(realtimePolling);realtimePolling=null;}">
  <div style="margin-bottom:14px">
    <div style="font-size:var(--fs-xl);font-weight:700;margin-bottom:4px">📡 실시간 모니터링</div>
    <div style="color:var(--text2);font-size:var(--fs-sm)">StreamingEvaluator 슬라이딩 윈도우 기반 실시간 지표 — 15초 자동 갱신</div>
  </div>

  <!-- 윈도우 선택 -->
  <div style="display:flex;gap:8px;margin-bottom:14px">
    <template x-for="w in ['1m','5m','1h']" :key="w">
      <button class="btn" :class="{active:realtimeWindow===w}" @click="realtimeWindow=w" x-text="w==='1m'?'1분':w==='5m'?'5분':'1시간'"></button>
    </template>
    <button class="btn" @click="loadRealtime()">🔄 새로고침</button>
  </div>

  <template x-if="!realtimeStats[realtimeWindow]?.count">
    <div class="es"><div class="es-icon">📡</div><div class="es-title">실시간 데이터 없음</div>
    <div class="es-desc"><code>StreamingEvaluator</code>를 실행하고 <code>app.add_middleware(AgentEvalMiddleware, ...)</code>를 추가하세요.</div></div>
  </template>

  <template x-if="realtimeStats[realtimeWindow]?.count > 0">
    <div>
      <div class="kpi-grid">
        <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">요청 수</div>
          <div style="font-size:var(--fs-xl);font-weight:700" x-text="realtimeStats[realtimeWindow]?.count??0"></div></div>
        <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">TCR</div>
          <div style="font-size:var(--fs-xl);font-weight:700;color:var(--green)" x-text="(realtimeStats[realtimeWindow]?.tcr??0).toFixed(1)+'%'"></div></div>
        <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">평균 지연</div>
          <div style="font-size:var(--fs-xl);font-weight:700" x-text="(realtimeStats[realtimeWindow]?.avg_latency??0).toFixed(2)+'s'"></div></div>
        <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">P95 지연</div>
          <div style="font-size:var(--fs-xl);font-weight:700" x-text="(realtimeStats[realtimeWindow]?.p95_latency??0).toFixed(2)+'s'"></div></div>
        <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">오류율</div>
          <div style="font-size:var(--fs-xl);font-weight:700;color:var(--red)" x-text="(realtimeStats[realtimeWindow]?.error_rate??0).toFixed(1)+'%'"></div></div>
        <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">평균 토큰</div>
          <div style="font-size:var(--fs-xl);font-weight:700" x-text="(realtimeStats[realtimeWindow]?.avg_tokens??0).toFixed(0)"></div></div>
      </div>
    </div>
  </template>
</div>

<!-- ══ 알림 (Phase 2-B) ══ -->
<div x-show="sec==='alerts'" x-cloak x-init="if(sec==='alerts')loadAlerts()">
  <div style="margin-bottom:14px">
    <div style="font-size:var(--fs-xl);font-weight:700;margin-bottom:4px">🔔 알림 히스토리</div>
    <div style="color:var(--text2);font-size:var(--fs-sm)">AlertEngine 규칙 발화 이력 — results/alerts/*.jsonl 파일 기반</div>
  </div>
  <button class="btn" @click="loadAlerts()" style="margin-bottom:12px">🔄 새로고침</button>

  <div class="kpi-grid" style="margin-bottom:14px">
    <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">오늘 알림</div>
      <div style="font-size:var(--fs-xl);font-weight:700" x-text="alertData?.today?.total??0"></div></div>
    <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">Critical</div>
      <div style="font-size:var(--fs-xl);font-weight:700;color:var(--red)" x-text="alertData?.today?.critical??0"></div></div>
    <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">Warning</div>
      <div style="font-size:var(--fs-xl);font-weight:700;color:var(--yellow)" x-text="alertData?.today?.warning??0"></div></div>
    <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">7일 합계</div>
      <div style="font-size:var(--fs-xl);font-weight:700" x-text="alertData?.summary?.total_7d??0"></div></div>
  </div>

  <template x-if="!alertData?.today?.total">
    <div class="es"><div class="es-icon">🔔</div><div class="es-title">알림 없음</div>
    <div class="es-desc"><code>AlertEngine</code>을 설정하고 <code>StreamingEvaluator</code>와 연결하세요.</div></div>
  </template>

  <template x-if="alertData?.today?.events?.length > 0">
    <div style="background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);overflow:hidden">
      <div style="padding:10px 14px;font-weight:600;border-bottom:1px solid var(--border)">오늘 알림 목록</div>
      <template x-for="ev in (alertData.today.events||[])" :key="ev.triggered_at">
        <div style="padding:10px 14px;border-top:1px solid var(--border);display:flex;gap:10px;align-items:flex-start">
          <span style="font-size:18px" x-text="ev.severity==='critical'?'🚨':'⚠️'"></span>
          <div style="flex:1">
            <div style="display:flex;gap:8px;align-items:center;margin-bottom:4px">
              <span style="font-weight:600" x-text="ev.rule_name"></span>
              <span class="badge-gray" :style="ev.severity==='critical'?'background:rgba(248,113,113,.15);color:var(--red)':'background:rgba(250,204,21,.12);color:var(--yellow)'" x-text="ev.severity"></span>
            </div>
            <div style="font-size:var(--fs-sm);color:var(--text2)" x-text="ev.message?.substring(0,200)"></div>
            <div style="font-size:var(--fs-xs);color:var(--text2);margin-top:4px" x-text="ev.triggered_at"></div>
          </div>
        </div>
      </template>
    </div>
  </template>
</div>

<!-- ══ 사용자 반응 (Phase 2-C) ══ -->
<div x-show="data && sec==='feedback'" x-cloak>
  <div style="margin-bottom:14px">
    <div style="font-size:var(--fs-xl);font-weight:700;margin-bottom:4px">👍 사용자 반응</div>
    <div style="color:var(--text2);font-size:var(--fs-sm)">ImplicitFeedbackTracker — 암묵적 사용자 행동 신호 기반 품질 지표</div>
  </div>

  <template x-if="!feedbackData?.total">
    <div class="es"><div class="es-icon">👍</div><div class="es-title">피드백 데이터 없음</div>
    <div class="es-desc"><code>monitor.record_implicit_feedback(task_id, "thumbs_up")</code>로 피드백을 기록하세요.</div></div>
  </template>

  <template x-if="feedbackData?.total > 0">
    <div>
      <div class="kpi-grid">
        <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">총 피드백</div>
          <div style="font-size:var(--fs-xl);font-weight:700" x-text="feedbackData.total"></div></div>
        <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">긍정 비율</div>
          <div style="font-size:var(--fs-xl);font-weight:700;color:var(--green)" x-text="(feedbackData.positive_rate||0).toFixed(1)+'%'"></div></div>
        <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">부정 비율</div>
          <div style="font-size:var(--fs-xl);font-weight:700;color:var(--red)" x-text="(feedbackData.negative_rate||0).toFixed(1)+'%'"></div></div>
        <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">재생성율</div>
          <div style="font-size:var(--fs-xl);font-weight:700;color:var(--yellow)" x-text="(feedbackData.regenerate_rate||0).toFixed(1)+'%'"></div></div>
        <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">이탈율</div>
          <div style="font-size:var(--fs-xl);font-weight:700" x-text="(feedbackData.abandon_rate||0).toFixed(1)+'%'"></div></div>
      </div>

      <!-- 유형 분포 -->
      <div style="background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:14px;margin-top:14px">
        <div style="font-weight:600;margin-bottom:10px">피드백 유형 분포</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px">
          <template x-for="[type, count] in Object.entries(feedbackData.type_distribution||{})" :key="type">
            <div style="background:var(--bg3);border-radius:6px;padding:8px 10px">
              <div style="font-size:var(--fs-xs);color:var(--text2)" x-text="type"></div>
              <div style="font-size:var(--fs-lg);font-weight:700" x-text="count"></div>
            </div>
          </template>
        </div>
      </div>
    </div>
  </template>
</div>

<!-- ══ 이상 감지 (Phase 3-B) ══ -->
<div x-show="data && sec==='anomaly'" x-cloak>
  <div style="margin-bottom:14px">
    <div style="font-size:var(--fs-xl);font-weight:700;margin-bottom:4px">🚨 이상 감지</div>
    <div style="color:var(--text2);font-size:var(--fs-sm)">AnomalyDetector — Z-score · IQR · 선형회귀 기반 이상 패턴 탐지</div>
  </div>

  <template x-if="!anomalyData?.count">
    <div class="es"><div class="es-icon">✅</div><div class="es-title">이상 없음</div>
    <div class="es-desc">탐지된 이상이 없거나 <code>AnomalyDetector</code>가 아직 실행되지 않았습니다.</div></div>
  </template>

  <template x-if="anomalyData?.count > 0">
    <div>
      <div class="kpi-grid" style="margin-bottom:14px">
        <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">탐지된 이상</div>
          <div style="font-size:var(--fs-xl);font-weight:700" x-text="anomalyData.count"></div></div>
        <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">Critical</div>
          <div style="font-size:var(--fs-xl);font-weight:700;color:var(--red)" x-text="anomalyData.critical"></div></div>
        <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">Warning</div>
          <div style="font-size:var(--fs-xl);font-weight:700;color:var(--yellow)" x-text="anomalyData.warning"></div></div>
      </div>

      <template x-for="a in (anomalyData.anomalies||[])" :key="a.type+a.detected_at">
        <div style="background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:14px;margin-bottom:10px;border-left:3px solid" :style="a.severity==='critical'?'border-left-color:var(--red)':'border-left-color:var(--yellow)'">
          <div style="display:flex;gap:10px;align-items:center;margin-bottom:6px">
            <span style="font-size:18px" x-text="a.severity==='critical'?'🚨':'⚠️'"></span>
            <span style="font-weight:700" x-text="a.type.replaceAll('_',' ').toUpperCase()"></span>
            <span class="badge-gray" :style="a.severity==='critical'?'background:rgba(248,113,113,.15);color:var(--red)':'background:rgba(250,204,21,.12);color:var(--yellow)'" x-text="a.severity"></span>
            <span style="margin-left:auto;font-size:var(--fs-xs);color:var(--text2)" x-text="'알고리즘: '+a.algorithm"></span>
          </div>
          <div style="font-size:var(--fs-sm)" x-text="a.detail"></div>
          <div style="display:flex;gap:16px;margin-top:8px;font-size:var(--fs-xs);color:var(--text2)">
            <span>현재값: <b x-text="a.value"></b></span>
            <span>임계값: <b x-text="a.threshold"></b></span>
            <span x-text="a.detected_at?.substring(0,19)"></span>
          </div>
        </div>
      </template>
    </div>
  </template>
</div>

<!-- ══ 평가 비용 (Phase 3-C) ══ -->
<div x-show="data && sec==='cost'" x-cloak>
  <div style="margin-bottom:14px">
    <div style="font-size:var(--fs-xl);font-weight:700;margin-bottom:4px">💰 평가 비용</div>
    <div style="color:var(--text2);font-size:var(--fs-sm)">LLM Judge · DeepEval · Ragas 등 외부 평가 호출 비용 추적</div>
  </div>

  <template x-if="!costData?.total_usd">
    <div class="es"><div class="es-icon">💰</div><div class="es-title">비용 데이터 없음</div>
    <div class="es-desc"><code>enable_llm_judge=True</code>로 평가를 실행하거나 <code>CostTracker</code>를 사용하세요.</div></div>
  </template>

  <template x-if="costData?.total_usd > 0">
    <div>
      <div class="kpi-grid">
        <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">오늘 총 비용</div>
          <div style="font-size:var(--fs-xl);font-weight:700;color:var(--accent)" x-text="'$'+(costData.total_usd||0).toFixed(4)"></div></div>
        <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">예산 잔여</div>
          <div style="font-size:var(--fs-xl);font-weight:700"
               x-text="costData.budget_remaining_usd!=null ? '$'+costData.budget_remaining_usd.toFixed(4) : '한도 없음'"
               :style="costData.budget_remaining_usd!=null && costData.budget_remaining_usd < (costData.budget_per_day||0)*0.2 ? 'color:var(--danger,#ef4444)' : ''"></div></div>
        <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">예상 일 비용</div>
          <div style="font-size:var(--fs-xl);font-weight:700" x-text="'$'+(costData.projected_daily_usd||0).toFixed(4)"></div></div>
        <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">현재 샘플링률</div>
          <div style="font-size:var(--fs-xl);font-weight:700" x-text="((costData.sample_rate_current||0)*100).toFixed(0)+'%'"></div></div>
      </div>
      <div class="kpi-grid" style="grid-template-columns:repeat(2,1fr);margin-top:8px">
        <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">호출 수</div>
          <div style="font-size:var(--fs-xl);font-weight:700" x-text="costData.call_count||0"></div></div>
        <div class="kpi"><div style="font-size:var(--fs-sm);color:var(--text2)">모델</div>
          <div style="font-size:var(--fs-md);font-weight:600;margin-top:4px" x-text="costData.model||'—'"></div></div>
      </div>

      <!-- 공급자별 분포 -->
      <template x-if="Object.keys(costData.by_provider||{}).length > 0">
        <div style="background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:14px;margin-top:14px">
          <div style="font-weight:600;margin-bottom:10px">공급자별 비용</div>
          <template x-for="[provider, usd] in Object.entries(costData.by_provider||{})" :key="provider">
            <div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border)">
              <span style="font-weight:500" x-text="provider"></span>
              <span style="color:var(--accent);font-weight:700" x-text="'$'+parseFloat(usd).toFixed(4)"></span>
            </div>
          </template>
        </div>
      </template>
    </div>
  </template>
</div>

</main>
</div>

<!-- ===== STATUS BAR ===== -->
<div class="sbar">
  <span>업데이트: <b x-text="lastUpd"></b></span>
  <span>|</span>
  <span><b x-text="files.length"></b>개 파일</span>
  <span x-show="data">| 총 <b x-text="data?.total_tasks??0"></b> tasks</span>
  <span x-show="data" x-text="data?.name?.substring(0,30)"></span>
  <div class="sp"></div>
  <span>Agent Evaluator v{{ version }}</span>
</div>
</div><!-- /layout -->

<script>
const WATCH = {{ "true" if watch else "false" }};

