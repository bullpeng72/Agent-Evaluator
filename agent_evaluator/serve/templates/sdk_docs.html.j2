      <table class="mtable" style="font-size:12px">
        <thead><tr><th>파라미터명</th><th>Config 클래스</th><th>핵심 필드</th><th>기본 판정 기준</th></tr></thead>
        <tbody>
          <tr><td><code>sla</code></td><td><span class="t">SLAConfig</span></td><td><code>p95_ms</code>, <code>max_response_time</code></td><td>P95 초과 비율 → FAIL</td></tr>
          <tr><td><code>efficiency</code></td><td><span class="t">EfficiencyConfig</span></td><td><code>min_completion_per_token</code>, <code>max_tool_calls</code></td><td>토큰 효율 임계값</td></tr>
          <tr><td><code>resource_budget</code></td><td><span class="t">ResourceBudgetConfig</span></td><td><code>max_tokens</code>, <code>max_cost_usd</code></td><td>예산 초과 → FAIL</td></tr>
          <tr><td><code>ttft_variability</code><span style="color:var(--text2);font-size:10px;margin-left:4px">monitor</span></td><td><span class="t">TTFTVariabilityConfig</span></td><td><code>max_std_ms</code>, <code>p95_p50_ratio</code></td><td>monitor 수준 자동 집계</td></tr>
          <tr><td><code>cost_predictability</code><span style="color:var(--text2);font-size:10px;margin-left:4px">monitor</span></td><td><span class="t">CostPredictabilityConfig</span></td><td><code>max_token_cv</code>, <code>task_type</code></td><td>task_type별 토큰 CV</td></tr>
