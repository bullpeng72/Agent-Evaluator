          </tr>
      {% endcall %}
      <div class="ret-box" style="margin-top:10px">
        <div style="margin-bottom:4px;font-size:11px;color:var(--text2);text-transform:uppercase;letter-spacing:.05em">dimension_scores 구조</div>
        <span class="rk">relevance</span><span class="rv">: 0–5 (가중치 25%) — 질문과의 관련성</span><br>
