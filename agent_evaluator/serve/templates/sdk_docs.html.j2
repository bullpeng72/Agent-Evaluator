<!-- ── Quick Start ── -->
<section class="sec" id="quickstart">
  <div class="sec-title">⚡ Quick Start</div>
  <div class="sec-sub">데코레이터 한 줄로 시작. 실행 시간·토큰·정확도가 자동 측정됩니다. 아래 패턴 중 하나를 선택하세요.</div>

  <!-- 1. QuickEval — 가장 간단한 시작 -->
  <div class="cls-card">
    <div class="cls-head"><span class="cls-name">① QuickEval — 가장 빠른 시작</span><span class="kind cls">facade</span></div>
    <div class="cls-body">
      <div class="note tip" style="margin-bottom:10px">🚀 설정 최소화. <code>QuickEval</code> 1줄로 <code>PerformanceMonitor</code> + 데코레이터를 한번에 구성합니다.</div>
<pre><span class="kw">from</span> <span class="cn">agent_evaluator</span> <span class="kw">import</span> QuickEval

eval = <span class="fn">QuickEval</span>(<span class="st">"results/"</span>)

<span class="de">@eval.qa</span>                  <span class="cm"># QA 에이전트</span>
<span class="kw">def</span> <span class="fn">qa_agent</span>(question, ground_truth=<span class="st">""</span>): <span class="kw">return</span> llm.<span class="fn">invoke</span>(question)

<span class="de">@eval.rag</span>                 <span class="cm"># RAG — hallucination 자동 활성</span>
<span class="kw">def</span> <span class="fn">rag_agent</span>(question, context=<span class="st">""</span>, ground_truth=<span class="st">""</span>): <span class="kw">return</span> rag.<span class="fn">run</span>(question)

<span class="de">@eval.tool_use</span>            <span class="cm"># 도구 호출 에이전트</span>
<span class="kw">def</span> <span class="fn">tool_agent</span>(question, ground_truth=<span class="st">""</span>): <span class="kw">return</span> agent.<span class="fn">run</span>(question)

qa_agent(<span class="st">"한국의 수도는?"</span>, ground_truth=<span class="st">"서울"</span>)
eval.<span class="fn">save</span>()               <span class="cm"># results/*.json + *.html</span>
eval.<span class="fn">gate</span>(tcr=<span class="nm">85</span>, accuracy=<span class="nm">70</span>)  <span class="cm"># CI/CD 게이팅</span></pre>
    </div>
  </div>

  <!-- 2. @agent_eval — 단일 태스크 -->
  <div class="cls-card">
    <div class="cls-head"><span class="cls-name">② @agent_eval — 단일 태스크 / 프레임워크 통합</span><span class="kind fn">decorator</span></div>
    <div class="cls-body">
      <div class="note" style="margin-bottom:10px">🔌 <code>framework=</code>으로 응답 객체에서 <strong>tool_calls · tokens · chain_steps</strong>를 자동 추출. 21개 프레임워크 지원.</div>
<pre><span class="kw">from</span> <span class="cn">agent_evaluator</span> <span class="kw">import</span> PerformanceMonitor
<span class="kw">from</span> <span class="cn">agent_evaluator.decorators</span> <span class="kw">import</span> agent_eval

monitor = <span class="fn">PerformanceMonitor</span>(output_dir=<span class="st">"results/"</span>)

<span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"qa"</span>)             <span class="cm"># 기본</span>
<span class="kw">def</span> <span class="fn">my_agent</span>(question: str, ground_truth: str = <span class="st">""</span>) -> str:
    <span class="kw">return</span> llm.<span class="fn">invoke</span>(question)

<span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"tool_use"</span>, framework=<span class="st">"langchain"</span>)
<span class="kw">def</span> <span class="fn">lc_agent</span>(question: str, ground_truth: str = <span class="st">""</span>) -> str:
    <span class="kw">return</span> agent_executor.<span class="fn">invoke</span>({<span class="st">"input"</span>: question})

<span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"qa"</span>, framework=<span class="st">"openai"</span>)
<span class="kw">def</span> <span class="fn">oai_agent</span>(question: str, ground_truth: str = <span class="st">""</span>) -> str:
    <span class="kw">return</span> client.chat.completions.<span class="fn">create</span>(model=<span class="st">"gpt-4o-mini"</span>, messages=[{<span class="st">"role"</span>:<span class="st">"user"</span>,<span class="st">"content"</span>:question}])

monitor.<span class="fn">save_to_file</span>(<span class="st">"eval_run"</span>)  <span class="cm"># → results/eval_run.json + .html</span></pre>
    </div>
  </div>

  <!-- 3. @batch_eval — 배치 -->
  <div class="cls-card">
    <div class="cls-head"><span class="cls-name">③ @batch_eval — 배치 평가</span><span class="kind fn">decorator</span></div>
    <div class="cls-body">
<pre><span class="kw">from</span> <span class="cn">agent_evaluator.decorators</span> <span class="kw">import</span> batch_eval

<span class="de">@batch_eval</span>(monitor, task_type=<span class="st">"qa"</span>, flush_every=<span class="nm">20</span>)
<span class="kw">def</span> <span class="fn">batch_agent</span>(questions: list, ground_truths: list = <span class="kw">None</span>) -> list:
    <span class="kw">return</span> [llm.<span class="fn">invoke</span>(q) <span class="kw">for</span> q <span class="kw">in</span> questions]

batch_agent(questions=[<span class="st">"Q1"</span>, <span class="st">"Q2"</span>, <span class="st">"Q3"</span>], ground_truths=[<span class="st">"A1"</span>, <span class="st">"A2"</span>, <span class="st">"A3"</span>])</pre>
    </div>
  </div>

  <!-- 4. @conversation_eval — 멀티턴 -->
  <div class="cls-card">
    <div class="cls-head"><span class="cls-name">④ @conversation_eval — 멀티턴 대화 평가</span><span class="kind fn">decorator</span></div>
    <div class="cls-body">
<pre><span class="kw">from</span> <span class="cn">agent_evaluator.decorators</span> <span class="kw">import</span> conversation_eval

<span class="de">@conversation_eval</span>(monitor)
<span class="kw">def</span> <span class="fn">chat_agent</span>(user_input: str, session_id: str = <span class="st">""</span>) -> str:
    <span class="kw">return</span> llm.<span class="fn">invoke</span>(user_input)

<span class="cm"># 동일 session_id → 자동 멀티턴 누산 → 세션 종료 시 ConversationMetrics 기록</span>
chat_agent(<span class="st">"안녕하세요!"</span>, session_id=<span class="st">"user_001"</span>)
chat_agent(<span class="st">"오늘 날씨 어때요?"</span>, session_id=<span class="st">"user_001"</span>)
chat_agent(<span class="st">"주말 계획 추천해줘"</span>, session_id=<span class="st">"user_001"</span>)</pre>
