    <div class="cls-body">
      <div class="note tip" style="margin-bottom:8px">💡 The only framework that actually measures LLM token counts via <code>usage_metadata</code>. Consider LangChain first when accurate cost tracking is needed.</div>
<pre><span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"qa"</span>, framework=<span class="st">"langchain"</span>)
<span class="kw">def</span> <span class="fn">lc_agent</span>(question: str, ground_truth: str = <span class="st">""</span>) -> str:
    result = agent_executor.<span class="fn">invoke</span>({<span class="st">"input"</span>: question})
    <span class="kw">return</span> result[<span class="st">"output"</span>]
    <span class="cm"># Auto-extracted: tokens_used (usage_metadata), tool_calls (on_agent_action), chain_steps</span>

<span class="fn">lc_agent</span>(<span class="st">"What is the capital of France?"</span>, ground_truth=<span class="st">"Paris"</span>)
monitor.<span class="fn">save_to_file</span>(<span class="st">"langchain_eval"</span>)</pre>
