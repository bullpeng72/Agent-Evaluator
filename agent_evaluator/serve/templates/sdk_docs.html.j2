  </div>
</section>

<!-- ── ResponseQualityEvaluator ── -->
<section class="sec" id="quality">
  <div class="sec-title"><span class="badge l1">L1</span> ResponseQualityEvaluator</div>
  <div class="sec-sub">Evaluates response quality across 5 dimensions. Use the <code>expected_elements</code> list for checklist-based completeness measurement.</div>
  <div class="cls-card">
    <div class="cls-head"><span class="cls-name">ResponseQualityEvaluator</span><span class="kind cls">class</span><span class="cls-src">agent_evaluator.core.trackers.layer1</span></div>
    <div class="cls-body">
      {% call tracker_table() %}
          <tr>
            <td><span class="p">evaluate_response(task_id, response, request, expected_elements, ground_truth=None)</span></td>
            <td><span class="t">str, str, str, List[str], Optional[str]</span></td>
            <td><code class="t">dimension_scores</code> (each dimension 0–5), <code class="t">total_score</code> (weighted avg 0–5), <code class="t">grade</code> (A–F)</td>
          </tr>
          <tr>
            <td><span class="p">get_quality_metrics()</span></td><td>—</td>
            <td><code class="t">avg_total_score</code>, <code class="t">grade_distribution</code>, <code class="t">dimension_averages</code>, <code class="t">high_quality_count</code></td>
          </tr>
          <tr>
            <td><span class="p">get_quality_by_dimension()</span></td><td>—</td>
            <td><code class="t">relevance</code>, <code class="t">completeness</code>, <code class="t">accuracy</code>, <code class="t">clarity</code>, <code class="t">usefulness</code> — average value per dimension</td>
          </tr>
      {% endcall %}
      <div class="ret-box" style="margin-top:10px">
        <div style="margin-bottom:4px;font-size:11px;color:var(--text2);text-transform:uppercase;letter-spacing:.05em">dimension_scores Structure</div>
        <span class="rk">relevance</span><span class="rv">: 0–5 (weight 25%) — relevance to the question</span><br>
        <span class="rk">completeness</span><span class="rv">: 0–5 (weight 25%) — expected element inclusion rate</span><br>
        <span class="rk">accuracy</span><span class="rv">: 0–5 (weight 20%) — accuracy vs ground_truth</span><br>
        <span class="rk">clarity</span><span class="rv">: 0–5 (weight 15%) — clarity based on response length and structure</span><br>
        <span class="rk">usefulness</span><span class="rv">: 0–5 (weight 15%) — practical usefulness</span>
      </div>
    </div>
  </div>
</section>

<!-- ── LatencyTracker ── -->
<section class="sec" id="latency">
