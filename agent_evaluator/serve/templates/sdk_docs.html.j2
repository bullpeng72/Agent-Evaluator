  <!-- EvalMetadata 보완 패턴 -->
  <div class="cls-card" style="margin-top:12px">
    <div class="cls-head"><span class="cls-name">Adapter-unextracted Fields — Supplement with EvalMetadata</span><span class="kind fn">decorator</span></div>
    <div class="cls-body">
<pre><span class="kw">from</span> <span class="cn">agent_evaluator.decorators</span> <span class="kw">import</span> agent_eval, EvalMetadata

<span class="cm"># Example: manually inject CrewAI tokens, activate ToolSelection F1 via expected_tools</span>
<span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"tool_use"</span>, framework=<span class="st">"crewai"</span>)
<span class="kw">def</span> <span class="fn">run_crew</span>(question: str, ground_truth: str = <span class="st">""</span>) -> tuple:
    result = crew.<span class="fn">kickoff</span>(inputs={<span class="st">"question"</span>: question})
    <span class="kw">return</span> result.raw, <span class="fn">EvalMetadata</span>(
        tokens_used={<span class="st">"input"</span>: <span class="nm">500</span>, <span class="st">"output"</span>: <span class="nm">200</span>},   <span class="cm"># CrewAI does not expose tokens → inject directly</span>
        expected_tools=[<span class="st">"search"</span>, <span class="st">"write"</span>],          <span class="cm"># For ToolSelection F1 calculation</span>
        agent_interactions=[                           <span class="cm"># Fine-grained AgentCoordination data</span>
            {<span class="st">"from"</span>: <span class="st">"researcher"</span>, <span class="st">"to"</span>: <span class="st">"writer"</span>, <span class="st">"type"</span>: <span class="st">"delegation"</span>, <span class="st">"success"</span>: <span class="kw">True</span>}
        ],
    )

<span class="cm"># Example: Anthropic tool_use — adapter auto-extraction + EvalMetadata accuracy override</span>
<span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"tool_use"</span>, framework=<span class="st">"anthropic"</span>)
<span class="kw">def</span> <span class="fn">claude_agent</span>(question: str, ground_truth: str = <span class="st">""</span>) -> tuple:
    resp = client.messages.<span class="fn">create</span>(model=<span class="st">"claude-sonnet-4-6"</span>, ...)
    <span class="kw">return</span> resp, <span class="fn">EvalMetadata</span>(accuracy_score=<span class="nm">0.95</span>)  <span class="cm"># Inject external evaluation score</span></pre>
    </div>
  </div>

  <!-- 주요 프레임워크 빠른 시작 -->
  <div style="font-size:14px;font-weight:700;color:var(--text2);margin:20px 0 10px;text-transform:uppercase;letter-spacing:.05em">Quick Start — Key Frameworks</div>

  <!-- LangChain -->
  <div class="cls-card">
    <div class="cls-head"><span class="cls-name">🟢 LangChain</span><span class="kind fn">langchain ≥1.0 · agent-evaluator[langchain]</span></div>
    <div class="cls-body">
      <div class="note tip" style="margin-bottom:8px">💡 The only framework that actually measures LLM token counts via <code>usage_metadata</code>. Consider LangChain first when accurate cost tracking is needed.</div>
<pre><span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"qa"</span>, framework=<span class="st">"langchain"</span>)
<span class="kw">def</span> <span class="fn">lc_agent</span>(question: str, ground_truth: str = <span class="st">""</span>) -> str:
    result = agent_executor.<span class="fn">invoke</span>({<span class="st">"input"</span>: question})
    <span class="kw">return</span> result[<span class="st">"output"</span>]
    <span class="cm"># Auto-extracted: tokens_used (usage_metadata), tool_calls (on_agent_action), chain_steps</span>

<span class="fn">lc_agent</span>(<span class="st">"What is the capital of France?"</span>, ground_truth=<span class="st">"Paris"</span>)
monitor.<span class="fn">save_to_file</span>(<span class="st">"langchain_eval"</span>)</pre>
    </div>
  </div>

  <!-- LangGraph -->
  <div class="cls-card" style="margin-top:12px">
    <div class="cls-head"><span class="cls-name">🟠 LangGraph</span><span class="kind fn">langgraph ≥1.0 · agent-evaluator[langchain]</span></div>
    <div class="cls-body">
      <div class="note" style="margin-bottom:8px">⚡ Tokens are collected only from LangChain LLM nodes such as ChatOpenAI. <code>state_transitions</code>·<code>chain_steps</code> are auto-constructed from node execution order.</div>
<pre><span class="kw">from</span> <span class="cn">langchain_core.messages</span> <span class="kw">import</span> HumanMessage

<span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"information_retrieval"</span>, framework=<span class="st">"langgraph"</span>)
<span class="kw">def</span> <span class="fn">run_graph</span>(question: str, ground_truth: str = <span class="st">""</span>) -> str:
    result = compiled_graph.<span class="fn">invoke</span>({<span class="st">"messages"</span>: [<span class="fn">HumanMessage</span>(content=question)]})
    <span class="kw">return</span> result[<span class="st">"messages"</span>][-1].content
    <span class="cm"># Auto-extracted: tool_calls (ToolMessage), chain_steps (node timing), state_transitions</span>

<span class="fn">run_graph</span>(<span class="st">"question"</span>, ground_truth=<span class="st">"expected answer"</span>)
monitor.<span class="fn">save_to_file</span>(<span class="st">"langgraph_eval"</span>)</pre>
    </div>
  </div>

  <!-- CrewAI -->
  <div class="cls-card" style="margin-top:12px">
    <div class="cls-head"><span class="cls-name">🔵 CrewAI</span><span class="kind fn">crewai ≥1.0 · agent-evaluator[crewai]</span></div>
    <div class="cls-body">
      <div class="note warn" style="margin-bottom:8px">⚠️ Token counts are not exposed by the SDK. For cost tracking, inject directly via <code>EvalMetadata(tokens_used=...)</code>.</div>
<pre><span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"tool_use"</span>, framework=<span class="st">"crewai"</span>)
<span class="kw">def</span> <span class="fn">run_crew</span>(question: str, ground_truth: str = <span class="st">""</span>) -> str:
    crew = <span class="fn">Crew</span>(agents=agents, tasks=tasks)
    result = crew.<span class="fn">kickoff</span>(inputs={<span class="st">"question"</span>: question})
    <span class="kw">return</span> result.raw
    <span class="cm"># Auto-extracted: agent_interactions (Hierarchical/Sequential pattern), chain_steps (task order)</span>

<span class="fn">run_crew</span>(<span class="st">"Research AI trends"</span>, ground_truth=<span class="st">"expected answer"</span>)
monitor.<span class="fn">save_to_file</span>(<span class="st">"crewai_eval"</span>)</pre>
    </div>
  </div>

  <!-- AutoGen -->
  <div class="cls-card" style="margin-top:12px">
    <div class="cls-head"><span class="cls-name">🟣 AutoGen</span><span class="kind fn">autogen-agentchat ≥0.4 · agent-evaluator[autogen]</span></div>
    <div class="cls-body">
      <div class="note" style="margin-bottom:8px">⚡ async-first API recommended. Token estimation uses cl100k_base encoding when <strong>tiktoken</strong> is installed; otherwise falls back to a Korean/English heuristic.</div>
<pre><span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"tool_use"</span>, framework=<span class="st">"autogen"</span>)
<span class="kw">async def</span> <span class="fn">run_autogen</span>(question: str, ground_truth: str = <span class="st">""</span>) -> str:
    result = <span class="kw">await</span> team.<span class="fn">run</span>(task=question)
    <span class="kw">return</span> result.messages[-1].content
    <span class="cm"># Auto-extracted: agent_interactions (sender tracking), tool_calls (ToolCallEvent), tokens (tiktoken)</span>

<span class="kw">import</span> asyncio
asyncio.<span class="fn">run</span>(<span class="fn">run_autogen</span>(<span class="st">"question"</span>, ground_truth=<span class="st">"expected answer"</span>))
monitor.<span class="fn">save_to_file</span>(<span class="st">"autogen_eval"</span>)</pre>
    </div>
  </div>

  <!-- DSPy / PydanticAI -->
  <div class="cls-card" style="margin-top:12px">
    <div class="cls-head"><span class="cls-name">🟤 DSPy / PydanticAI</span><span class="kind fn">agent-evaluator[dspy] or [pydanticai]</span></div>
    <div class="cls-body">
<pre><span class="cm"># DSPy — auto-extracts tokens·chain steps from _completions attribute</span>
<span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"reasoning"</span>, framework=<span class="st">"dspy"</span>)
<span class="kw">def</span> <span class="fn">dspy_agent</span>(question: str, ground_truth: str = <span class="st">""</span>) -> str:
    <span class="kw">return</span> dspy_program(question=question).answer

<span class="cm"># PydanticAI — auto-extracts ToolCallPart/ToolReturnPart chain</span>
<span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"tool_use"</span>, framework=<span class="st">"pydanticai"</span>)
<span class="kw">async def</span> <span class="fn">pydantic_agent</span>(question: str, ground_truth: str = <span class="st">""</span>) -> str:
    result = <span class="kw">await</span> agent.<span class="fn">run</span>(question)
    <span class="kw">return</span> result.data</pre>
    </div>
  </div>

  <!-- LLM API 직접 연동 -->
  <div class="cls-card" style="margin-top:12px">
    <div class="cls-head"><span class="cls-name">🔌 Direct LLM API Integration (openai · anthropic · gemini · others)</span><span class="kind fn">Included in base install (openai · anthropic SDK)</span></div>
    <div class="cls-body">
<pre><span class="cm"># OpenAI — auto-extracts usage.total_tokens + message.tool_calls</span>
<span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"tool_use"</span>, framework=<span class="st">"openai"</span>)
<span class="kw">def</span> <span class="fn">openai_agent</span>(question: str, ground_truth: str = <span class="st">""</span>) -> str:
    <span class="kw">return</span> openai_client.chat.completions.<span class="fn">create</span>(
        model=<span class="st">"gpt-4o-mini"</span>, messages=[{<span class="st">"role"</span>:<span class="st">"user"</span>,<span class="st">"content"</span>:question}]
    )

<span class="cm"># Anthropic — auto-extracts input/output/cache tokens + content[].tool_use</span>
<span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"qa"</span>, framework=<span class="st">"anthropic"</span>)
<span class="kw">def</span> <span class="fn">claude_agent</span>(question: str, ground_truth: str = <span class="st">""</span>) -> str:
    <span class="kw">return</span> anthropic_client.messages.<span class="fn">create</span>(
        model=<span class="st">"claude-sonnet-4-6"</span>, max_tokens=<span class="nm">1024</span>,
        messages=[{<span class="st">"role"</span>:<span class="st">"user"</span>,<span class="st">"content"</span>:question}]
    )

<span class="cm"># Other SDKs (cohere, groq, mistral, bedrock, ollama, vllm, etc.) — same pattern</span>
<span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"qa"</span>, framework=<span class="st">"groq"</span>)
<span class="kw">def</span> <span class="fn">groq_agent</span>(question: str, ground_truth: str = <span class="st">""</span>) -> str:
    <span class="kw">return</span> groq_client.chat.completions.<span class="fn">create</span>(model=<span class="st">"llama-3.1-8b-instant"</span>, ...)</pre>
      <div class="note tip" style="margin-top:8px">💡 <strong>Return the response object as-is</strong> and the adapter automatically extracts tokens/tool_calls from the SDK-specific structure. No need to convert to a string.</div>
    </div>
  </div>
</section>

<div style="height:60px"></div>
</div></div></div>

<script>
const root=document.getElementById('root'),THEME_KEY='ae-sdk-theme';
(function(){if(localStorage.getItem(THEME_KEY)==='light')root.classList.add('light')})();
function toggleTheme(){root.classList.toggle('light');localStorage.setItem(THEME_KEY,root.classList.contains('light')?'light':'dark')}
const navItems=document.querySelectorAll('.nav-item[href^="#"]');
const sections=[...document.querySelectorAll('section.sec')];
const content=document.getElementById('content');
function updateNav(){let a=sections[0]?.id;for(const s of sections){if(s.getBoundingClientRect().top<=80)a=s.id}navItems.forEach(x=>x.classList.toggle('on',x.getAttribute('href')==='#'+a))}
content.addEventListener('scroll',updateNav,{passive:true});updateNav();
navItems.forEach(a=>a.addEventListener('click',e=>{e.preventDefault();document.getElementById(a.getAttribute('href').slice(1))?.scrollIntoView({behavior:'smooth'})}));
function doSearch(q){
  document.querySelectorAll('mark').forEach(m=>{const t=document.createTextNode(m.textContent);m.parentNode.replaceChild(t,m)});
  if(!q||q.length<2)return;
  const walker=document.createTreeWalker(content,NodeFilter.SHOW_TEXT,{acceptNode:n=>n.parentElement.closest('script,style,input')?NodeFilter.FILTER_REJECT:NodeFilter.FILTER_ACCEPT});
  const nodes=[];while(walker.nextNode())nodes.push(walker.currentNode);
  const re=new RegExp(q.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'),'gi');
  nodes.forEach(node=>{if(!re.test(node.textContent))return;re.lastIndex=0;const frag=document.createDocumentFragment();let last=0,m;
    while((m=re.exec(node.textContent))!==null){frag.appendChild(document.createTextNode(node.textContent.slice(last,m.index)));const mk=document.createElement('mark');mk.textContent=m[0];frag.appendChild(mk);last=m.index+m[0].length}
    frag.appendChild(document.createTextNode(node.textContent.slice(last)));node.parentNode.replaceChild(frag,node)});
  document.querySelector('mark')?.scrollIntoView({behavior:'smooth',block:'center'});
}
</script>
