          <code style="font-size:14px;color:#f59e0b">PerformanceMonitor.record_task(task)</code>
          <span style="margin-left:8px;background:#f59e0b;color:#000;font-size:11px;font-weight:700;padding:1px 6px;border-radius:4px">Contract Point</span>
          <div style="font-size:12px;color:var(--text2);margin-top:4px">Distributes TaskResult to all active trackers</div>
        </div>
        <!-- 화살표 -->
        <div style="display:flex;flex-direction:column;align-items:center;padding:4px 0">
