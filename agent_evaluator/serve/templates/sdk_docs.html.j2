      <table class="mtable" style="margin-top:10px">
        <thead><tr><th>메서드</th><th>반환</th><th>설명</th></tr></thead>
        <tbody>
          <tr><td><span class="p">record(provider, model, cost_usd, input_tokens=0, output_tokens=0, evaluation_type="llm_judge")</span></td><td><span class="r">None</span></td><td>비용 기록. <code>evaluation_type</code>: <code>"llm_judge"</code> | <code>"deepeval"</code> | <code>"ragas"</code></td></tr>
          <tr><td><span class="p">get_daily_stats()</span></td><td><span class="r">Dict</span></td><td>오늘 집계: <code>today_total_usd</code>, <code>today_call_count</code>, <code>by_provider</code>, <code>by_evaluation_type</code>, <code>daily_history</code>, <code>budget_remaining_usd</code></td></tr>
          <tr><td><span class="p">get_all_records()</span></td><td><span class="r">List[Dict]</span></td><td>전체 비용 기록 목록</td></tr>
          <tr><td><span class="p">is_budget_exceeded()</span></td><td><span class="r">bool</span></td><td>일일 예산 초과 여부</td></tr>
          <tr><td><span class="p">is_budget_alert()</span></td><td><span class="r">bool</span></td><td>alert_at 비율 도달 여부</td></tr>
          <tr><td><span class="p">reset()</span></td><td><span class="r">None</span></td><td>기록 초기화</td></tr>
        </tbody>
      </table>
