<section class="sec" id="architecture">
  <div class="sec-title">🏗️ Architecture Overview</div>
  <div class="sec-sub">Decorators are <strong>producers</strong>, trackers are <strong>consumers</strong>. The contract point is <code>PerformanceMonitor.record_task()</code>.</div>

  <!-- 데이터 흐름 다이어그램 -->
  <div class="cls-card">
    <div class="cls-head"><span class="cls-name">Overall Data Flow</span></div>
    <div class="cls-body">
      <div style="display:flex;flex-direction:column;align-items:center;gap:0;font-size:13px;padding:8px 0">
        <!-- 데코레이터 레이어 박스 -->
        <div style="border:1.5px solid var(--accent);border-radius:8px;padding:12px 24px;background:var(--bg2);width:100%;max-width:540px;box-sizing:border-box">
          <div style="text-align:center;font-weight:700;color:var(--accent);margin-bottom:8px">Decorator Layer <span style="color:var(--text2);font-weight:400">(Producer)</span></div>
          <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:6px">
            <code style="background:var(--bg3);padding:2px 7px;border-radius:4px">@agent_eval</code>
            <code style="background:var(--bg3);padding:2px 7px;border-radius:4px">@batch_eval</code>
            <code style="background:var(--bg3);padding:2px 7px;border-radius:4px">@conversation_eval</code>
            <code style="background:var(--bg3);padding:2px 7px;border-radius:4px">eval_context</code>
          </div>
          <div style="text-align:center;color:var(--text2);margin-top:6px;font-size:12px">QuickEval · EvalDecorator (Factory)</div>
        </div>
        <!-- 화살표 + 단계 설명 -->
        <div style="display:flex;align-items:flex-start;gap:12px;padding:8px 0">
          <div style="display:flex;flex-direction:column;align-items:center;padding-top:2px">
            <div style="width:2px;height:12px;background:var(--text2)"></div>
            <div style="width:0;height:0;border-left:6px solid transparent;border-right:6px solid transparent;border-top:8px solid var(--text2)"></div>
          </div>
