<span class="fn">my_agent</span>(<span class="st">"한국의 수도는?"</span>, ground_truth=<span class="st">"서울"</span>)
eval.<span class="fn">save</span>()                          <span class="cm"># → results/*.json + *.html</span>
eval.<span class="fn">gate</span>(tcr=<span class="nm">85</span>, accuracy=<span class="nm">70</span>)       <span class="cm"># CI/CD — 미달 시 exit(1)</span>

<span class="cm"># RAG 전용 (환각 탐지 자동 활성)</span>
eval = <span class="fn">QuickEval.for_rag</span>(<span class="st">"results/"</span>)
