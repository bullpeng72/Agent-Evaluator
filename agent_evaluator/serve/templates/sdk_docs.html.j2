<!-- ── Harness Engineering Config ── -->
<section class="sec" id="harness-a">
  <div class="sec-title">🔧 Harness Engineering Config <span style="font-size:13px;font-weight:400;color:var(--text2);margin-left:8px">v0.8.0+ · 7 Gates · 33 Configs</span></div>
  <div class="sec-sub">7 Gates A–G, 33 Config dataclasses. Pass as <code>@agent_eval</code> decorator parameters and <code>PerformanceMonitor</code> automatically evaluates PASS/WARN/FAIL for each Gate.</div>

  <div class="note tip" style="margin-bottom:12px">💡 <strong>Basic usage</strong>: <code>@agent_eval(monitor, task_type="qa", instructions=InstructionConfig(...), sla=SLAConfig(...))</code><br>Results visible at <code>report.extra_metrics["harness_groups"]</code> or in the dashboard Harness Gate tab.</div>

  <!-- Gate A -->
  <div class="cls-card">
    <div class="cls-head"><span class="cls-name">Gate A — Goal Achievement</span><span class="kind fn">6 Configs</span><span style="font-size:11px;color:var(--text2);margin-left:auto">Instruction compliance · Goal alignment · Plan consistency · Context retention</span></div>
    <div class="cls-body">
      <table class="mtable" style="font-size:12px">
        <thead><tr><th>Parameter</th><th>Config Class</th><th>Key Fields</th><th>Default Judgment Criteria</th></tr></thead>
        <tbody>
          <tr><td><code>instructions</code></td><td><span class="t">InstructionConfig</span></td><td><code>expected_format</code>, <code>required_keywords</code>, <code>min_chars</code></td><td>Keyword missing → FAIL</td></tr>
          <tr><td><code>goal_alignment</code></td><td><span class="t">GoalAlignmentConfig</span></td><td><code>goal_tool_map</code>, <code>alignment_threshold</code></td><td>Below threshold → WARN/FAIL</td></tr>
          <tr><td><code>plan_tracking</code></td><td><span class="t">PlanConfig</span></td><td><code>min_steps</code>, <code>max_steps</code></td><td>Step count out of range or ordering/executability check fails</td></tr>
          <tr><td><code>subtask_tracking</code></td><td><span class="t">SubtaskConfig</span></td><td><code>expected_subtasks</code>, <code>min_completion_rate</code></td><td>Subtask completion rate below threshold</td></tr>
          <tr><td><code>context_retention</code></td><td><span class="t">ContextRetentionConfig</span></td><td><code>key_entities</code>, <code>retention_threshold</code></td><td>Context key retention rate</td></tr>
          <tr><td><code>knowledge_retention</code></td><td><span class="t">KnowledgeRetentionConfig</span></td><td><code>facts_to_retain</code>, <code>retention_threshold</code></td><td>Knowledge retention &amp; utilization score</td></tr>
        </tbody>
      </table>
<pre style="margin-top:10px"><span class="kw">from</span> <span class="cn">agent_evaluator</span> <span class="kw">import</span> InstructionConfig, GoalAlignmentConfig
<span class="kw">from</span> <span class="cn">agent_evaluator.decorators</span> <span class="kw">import</span> agent_eval

<span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"qa"</span>,
    instructions=<span class="fn">InstructionConfig</span>(
        expected_format=<span class="st">"json"</span>,
        required_keywords=[<span class="st">"answer"</span>, <span class="st">"source"</span>],
        min_chars=<span class="nm">10</span>,
    ),
    goal_alignment=<span class="fn">GoalAlignmentConfig</span>(
        goal_tool_map={<span class="st">"search"</span>: [<span class="st">"web_search"</span>]},
        alignment_threshold=<span class="nm">0.5</span>,
    ),
)
<span class="kw">def</span> <span class="fn">my_agent</span>(question: str, ground_truth: str = <span class="st">""</span>) -> str: ...</pre>
    </div>
  </div>

  <!-- Gate B (id for nav scroll target) -->
  <div class="cls-card" style="margin-top:12px" id="harness-b">
    <div class="cls-head"><span class="cls-name">Gate B — Behavioral Integrity</span><span class="kind fn">6 Configs</span><span style="font-size:11px;color:var(--text2);margin-left:auto">Loop detection · Scope violation · Tool safety · State consistency</span></div>
    <div class="cls-body">
      <table class="mtable" style="font-size:12px">
        <thead><tr><th>Parameter</th><th>Config Class</th><th>Key Fields</th><th>Default Judgment Criteria</th></tr></thead>
        <tbody>
          <tr><td><code>loop_detection</code></td><td><span class="t">LoopDetectionConfig</span></td><td><code>consecutive_repeat_threshold</code>, <code>window_size</code></td><td>Loop threshold exceeded → FAIL</td></tr>
          <tr><td><code>scope</code></td><td><span class="t">ScopeConfig</span></td><td><code>allowed_tools</code>, <code>forbidden_tools</code></td><td>Forbidden tool used → FAIL</td></tr>
          <tr><td><code>tool_parameter_safety</code></td><td><span class="t">ToolParameterSafetyConfig</span></td><td><code>dangerous_patterns</code>, <code>max_argument_length</code></td><td>Dangerous pattern detected → FAIL (if <code>fail_on_dangerous</code>)</td></tr>
          <tr><td><code>context_window</code></td><td><span class="t">ContextWindowConfig</span></td><td><code>window_size_tokens</code>, <code>warn_at_pct</code></td><td>Context window saturation/repetition efficiency measured</td></tr>
          <tr><td><code>state_consistency</code></td><td><span class="t">StateConsistencyConfig</span></td><td><code>unchanged_keys</code>, <code>fail_on_unexpected_change</code></td><td>Unexpected state change detected → WARN (FAIL if <code>fail_on_unexpected_change</code>)</td></tr>
          <tr><td><code>deadlock</code></td><td><span class="t">DeadlockConfig</span></td><td><code>max_delegation_depth</code>, <code>check_circular_delegation</code></td><td>Circular delegation detected → FAIL (if <code>fail_on_deadlock</code>)</td></tr>
        </tbody>
      </table>
    </div>
