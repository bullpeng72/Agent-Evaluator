          </tr>
          <tr>
            <td><span class="p">get_security_stats()</span></td><td>—</td>
            <td><code class="t">threat_rate</code> (%), <code class="t">sql_injection_attempts</code>, <code class="t">command_injection_attempts</code>, <code class="t">path_traversal_attempts</code>, <code class="t">xss_attempts</code>, <code class="t">prompt_injection_attempts</code>, <code class="t">critical_risk_inputs</code></td>
