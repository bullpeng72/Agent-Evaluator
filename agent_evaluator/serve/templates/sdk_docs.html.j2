    </div>
  </div>

  <!-- TaskResult 필드 → 트래커 매핑 -->
  <div class="cls-card" style="margin-top:12px">
    <div class="cls-head"><span class="cls-name">TaskResult Field → Tracker Mapping</span><span style="font-size:12px;color:var(--text2);margin-left:8px">Fields auto-populated by the decorator and each tracker's consumption relationship</span></div>
    <div class="cls-body">
      <table class="mtable">
        <thead><tr><th>TaskResult Field</th><th>How Decorator Auto-supplies</th><th>Consuming Tracker</th></tr></thead>
        <tbody>
          <tr><td><span class="p">execution_time</span></td><td>Auto-measured with <code>time.perf_counter()</code></td><td>LatencyTracker (P50/P95/P99, TTFT)</td></tr>
          <tr><td><span class="p">success / completion_score</span></td><td>Auto-calculated by task_type recognition — <code>code_generation</code>/<code>coding</code>: AST parse success, <code>tool_use</code>: tool_calls presence, others: response length-based (v0.8.0+)</td><td>TaskCompletionTracker (TCR)</td></tr>
          <tr><td><span class="p">accuracy_score</span></td><td>Auto-calculated from <code>ground_truth</code> parameter vs return value (4-way)</td><td>AccuracyEvaluator</td></tr>
          <tr><td><span class="p">tokens_used</span></td><td>Auto-extracted from response object via <code>framework=</code> adapter or <code>EvalMetadata.tokens_used</code></td><td>TokenEconomyTracker (cost estimation)</td></tr>
          <tr><td><span class="p">tool_calls</span></td><td><code>framework=</code> adapter auto-extraction or <code>EvalMetadata.tool_calls</code></td><td>ToolCallAnalyzer, ToolSelectionTracker</td></tr>
          <tr><td><span class="p">extra.chain_steps</span></td><td><code>framework=</code> adapter auto-extraction</td><td>WorkflowExecutionTracker</td></tr>
          <tr><td><span class="p">extra.agent_interactions</span></td><td><code>EvalMetadata.agent_interactions</code> manual injection</td><td>AgentCoordinationTracker</td></tr>
          <tr><td><span class="p">attempts / errors</span></td><td><code>EvalMetadata.attempts</code> or auto-count</td><td>RetryCorrectionTracker</td></tr>
          <tr><td><span class="p">question / response</span></td><td>Auto-mapped from function parameter <code>question=</code></td><td>ResponseQualityEvaluator, HallucinationDetector</td></tr>
        </tbody>
      </table>
    </div>
  </div>

