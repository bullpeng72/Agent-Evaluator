.toolbar{position:sticky;top:0;background:var(--bg2);border-bottom:1px solid var(--border);padding:9px 16px;display:flex;align-items:center;gap:10px;z-index:10;font-size:13px}
.toolbar .title{font-weight:700;color:var(--accent)}.sp{flex:1}
