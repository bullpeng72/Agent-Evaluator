      <div class="slbl">Constructor Parameters</div>
      {% call param_table() %}
          <tr><td><span class="p">output_dir</span><span class="req">✦</span></td><td><span class="t">str</span></td><td>—</td><td>JSON/HTML report save directory</td></tr>
          <tr><td><span class="p">auto_save</span><span class="opt">opt</span></td><td><span class="t">bool</span></td><td><code>False</code></td><td>Calls save_to_file() automatically every N tasks</td></tr>
