<!-- ── LLMJudge ── -->
<section class="sec" id="llm-judge">
  <div class="sec-title">✨ LLMJudge <span style="font-size:13px;font-weight:400;color:var(--text2);margin-left:8px">v0.7.5+</span></div>
  <div class="sec-sub">LLM scores response quality across <strong>5 dimensions</strong> (completeness, relevance, factual consistency, toxicity, bias) without <code>ground_truth</code>. <code>rag_mode=True</code> auto-adds <strong>Faithfulness</strong> (RAG); <code>judge_criteria</code> adds <strong>G-Eval custom</strong> criteria. Supports OpenAI and Anthropic Claude.</div>
  <div class="cls-card">
    <div class="cls-head"><span class="cls-name">LLMJudge</span><span class="kind cls">class</span><span class="cls-src">agent_evaluator.integrations.llm_judge</span></div>
    <div class="cls-desc">LLM-as-Judge engine with built-in cost-control sampling (<code>sample_rate</code>) and daily budget cap (<code>budget_per_day</code>).</div>
    <div class="cls-body">
      <table class="mtable"><thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>
        <tr><td><span class="p">model</span></td><td><span class="t">str|None</span></td><td><span class="r">None</span></td><td>Auto-detects <code>agent-eval init</code> config. Explicitly set to use a specific model.</td></tr>
        <tr><td><span class="p">sample_rate</span></td><td><span class="t">float</span></td><td><span class="r">1.0</span></td><td>Evaluation sample rate (0–1). For cost control.</td></tr>
        <tr><td><span class="p">budget_per_day</span></td><td><span class="t">float|None</span></td><td><span class="r">None</span></td><td>Daily budget cap (USD). Judge skipped when exceeded.</td></tr>
        <tr><td><span class="p">judge_criteria</span><span class="opt">opt</span></td><td><span class="t">List[str]|None</span></td><td><span class="r">None</span></td><td>G-Eval custom evaluation criteria. E.g., <code>["medical_accuracy", "empathy"]</code> → <code>criteria_scores</code> auto-added (DeepEval G-Eval replacement)</td></tr>
        <tr><td><span class="p">escalation_model</span> / <span class="p">escalation_threshold</span><span class="opt">opt</span></td><td><span class="t">str|None / float</span></td><td><span class="r">None / 2.5</span></td><td>v0.8.3+ — auto re-scores with <code>escalation_model</code> when the primary <code>overall</code> score falls below <code>escalation_threshold</code> (0–5 scale)</td></tr>
        <tr><td><span class="p">max_concurrent_judge_calls</span><span class="opt">opt</span></td><td><span class="t">int</span></td><td><span class="r">5</span></td><td><code>asyncio.Semaphore</code> bound on concurrent <code>ajudge()</code> calls</td></tr>
        <tr><td><span class="p">max_retries</span><span class="opt">opt</span></td><td><span class="t">int</span></td><td><span class="r">3</span></td><td>Exponential backoff (1s/2s/4s...) retries on provider 429 rate-limit errors</td></tr>
      </tbody></table>
      <table class="mtable" style="margin-top:12px"><thead><tr><th>Method</th><th>Return Type</th><th>Description</th></tr></thead><tbody>
        <tr><td><span class="p">judge(task_id, question, response, context=None)</span></td><td><span class="t">dict</span></td><td>Single evaluation. <strong>Base keys</strong>: <code>completeness</code>·<code>relevance</code>·<code>factual_consistency</code>·<code>toxicity</code>·<code>bias</code>·<code>overall</code>·<code>safety_score</code>. <strong>Conditional</strong>: <code>faithfulness</code> (when rag_mode), <code>criteria_scores</code>·<code>criteria_overall</code> (when judge_criteria set)</td></tr>
        <tr><td><span class="p">ajudge(task_id, question, response, context=None)</span></td><td><span class="t">Awaitable[dict]</span></td><td>Async counterpart of <code>judge()</code>, bounded by <code>max_concurrent_judge_calls</code>. Used automatically by <code>@agent_eval</code>'s async wrapper and by <code>batch_eval(..., concurrent_judge=True)</code>.</td></tr>
        <tr><td><span class="p">get_summary()</span></td><td><span class="t">dict</span></td><td>Cumulative stats (call count, avg score, total cost). Dynamically includes faithfulness·criteria_scores based on results.</td></tr>
      </tbody></table>
<pre><span class="cm"># Default 5-dimension scoring (completeness·relevance·factual_consistency·toxicity·bias)</span>
<span class="kw">from</span> <span class="cn">agent_evaluator.decorators</span> <span class="kw">import</span> agent_eval

<span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"qa"</span>,
             enable_llm_judge=<span class="kw">True</span>, judge_model=<span class="st">"claude-sonnet-4-6"</span>,
             judge_sample_rate=<span class="nm">0.1</span>, judge_budget_per_day=<span class="nm">5.0</span>)
<span class="kw">def</span> <span class="fn">my_agent</span>(question: str, ground_truth: str = <span class="st">""</span>) -> str:
    <span class="kw">return</span> llm.<span class="fn">invoke</span>(question)
<span class="cm"># → TaskResult.extra["llm_judge"]: {completeness, relevance, factual_consistency, toxicity, bias, overall, safety_score}</span>

<span class="cm"># RAG Faithfulness (Ragas replacement) — rag_mode=True + enable_llm_judge=True</span>
<span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"information_retrieval"</span>,
             rag_mode=<span class="kw">True</span>, enable_llm_judge=<span class="kw">True</span>, judge_model=<span class="st">"claude-sonnet-4-6"</span>)
<span class="kw">def</span> <span class="fn">rag_agent</span>(question: str, context: str = <span class="st">""</span>, ground_truth: str = <span class="st">""</span>) -> str:
    <span class="kw">return</span> rag_chain.<span class="fn">invoke</span>({"input": question, "context": context})
<span class="cm"># → extra["llm_judge"]["faithfulness"] auto-added (0–5, 5=all claims grounded in context)</span>

<span class="cm"># G-Eval custom criteria (DeepEval replacement) — specify judge_criteria</span>
<span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"qa"</span>,
             enable_llm_judge=<span class="kw">True</span>, judge_criteria=[<span class="st">"medical_accuracy"</span>, <span class="st">"empathy"</span>, <span class="st">"clarity"</span>])
<span class="kw">def</span> <span class="fn">medical_agent</span>(question: str, ground_truth: str = <span class="st">""</span>) -> str:
    <span class="kw">return</span> llm.<span class="fn">invoke</span>(question)
<span class="cm"># → extra["llm_judge"]["criteria_scores"]: {"medical_accuracy": 4.0, "empathy": 4.5, "clarity": 4.8}</span>
<span class="cm"># → extra["llm_judge"]["criteria_overall"]: 4.43</span>

<span class="cm"># Enable globally at PerformanceMonitor level + judge_criteria</span>
monitor = <span class="fn">PerformanceMonitor</span>(
    output_dir=<span class="st">"results/"</span>,
    enable_llm_judge=<span class="kw">True</span>,
    judge_model=<span class="st">"claude-sonnet-4-6"</span>,
    judge_sample_rate=<span class="nm">0.1</span>,
    judge_criteria=[<span class="st">"professionalism"</span>, <span class="st">"safety"</span>],
)

<span class="cm"># Minimal setup via QuickEval factory</span>
<span class="kw">from</span> <span class="cn">agent_evaluator</span> <span class="kw">import</span> QuickEval
eval = <span class="fn">QuickEval.for_llm_judge</span>(<span class="st">"results/"</span>, model=<span class="st">"claude-sonnet-4-6"</span>)

<span class="de">@eval.qa</span>
<span class="kw">def</span> <span class="fn">my_agent</span>(question: str, ground_truth: str = <span class="st">""</span>) -> str:
    <span class="kw">return</span> llm.<span class="fn">invoke</span>(question)</pre>
    </div>
  </div>
</section>

<section class="sec" id="conversation">
  <div class="sec-title">✨ ConversationSession <span style="font-size:13px;font-weight:400;color:var(--text2);margin-left:8px">v0.6.3+</span></div>
  <div class="sec-sub">Measures quality of multi-turn conversational agents. Operates in pure Python (Jaccard, top-N tokens, Korean particle normalization) without an external LLM.</div>
  <div class="cls-card">
    <div class="cls-head"><span class="cls-name">ConversationSession</span><span class="kind cls">class</span><span class="cls-src">core/trackers/conversation.py</span></div>
    <div class="cls-body">
      <table class="mtable"><thead><tr><th>Method</th><th>Parameters</th><th>Description</th></tr></thead><tbody>
        <tr><td><span class="p">__init__(session_id)</span></td><td><span class="t">str</span></td><td>Initialize session</td></tr>
        <tr><td><span class="p">add_turn(user_input, agent_response, metadata=None)</span></td><td><span class="t">str, str, dict|None</span></td><td>Add conversation turn</td></tr>
        <tr><td><span class="p">compute_metrics()</span></td><td>—</td><td>Returns <code>ConversationMetrics</code>. Raises <code>InvalidOperationError</code> if fewer than 2 turns.</td></tr>
        <tr><td><span class="p">turns</span> (property)</td><td>—</td><td>Full turn list (read-only)</td></tr>
      </tbody></table>
    </div>
  </div>
  <div class="cls-card" style="margin-top:12px">
    <div class="cls-head"><span class="cls-name">ConversationMetrics</span><span class="kind cls">dataclass</span></div>
    <div class="cls-body">
      <table class="mtable"><thead><tr><th>Field</th><th>Range</th><th>Description</th></tr></thead><tbody>
        <tr><td><span class="p">context_retention_score</span></td><td><span class="r">0–1</span></td><td>Context retention rate — preservation of prior utterance info</td></tr>
        <tr><td><span class="p">topic_coherence_score</span></td><td><span class="r">0–1</span></td><td>Topic coherence — degree of topic consistency across turns</td></tr>
        <tr><td><span class="p">progressive_depth_score</span></td><td><span class="r">0–1</span></td><td>Progressive depth — trend of increasing conversation depth</td></tr>
        <tr><td><span class="p">session_completion_score</span></td><td><span class="r">0–1</span></td><td>Session completion — last response length / avg response length (structural metric, not directly correlated to quality)</td></tr>
        <tr><td><span class="p">overall_score</span></td><td><span class="r">0–1</span></td><td>Weighted average of 4 dimensions</td></tr>
        <tr><td><span class="p">turn_count</span></td><td><span class="r">int</span></td><td>Total turn count (= len(turns))</td></tr>
        <tr><td><span class="p">avg_turn_latency</span></td><td><span class="r">float|None</span></td><td>Average per-turn latency (seconds). None if no latency key in metadata.</td></tr>
      </tbody></table>
<pre><span class="cm"># Recommended: @conversation_eval decorator — automatic session management</span>
<span class="kw">from</span> <span class="cn">agent_evaluator.decorators</span> <span class="kw">import</span> conversation_eval

<span class="de">@conversation_eval</span>(monitor, flush_every=<span class="nm">5</span>)
<span class="kw">def</span> <span class="fn">chat_agent</span>(user_input: str, session_id: str = <span class="st">""</span>) -> str:
    <span class="kw">return</span> llm.<span class="fn">invoke</span>(user_input)

<span class="cm"># Same session_id calls → auto-accumulate turns → ConversationMetrics recorded on session end</span>
chat_agent(<span class="st">"How do I use async in Python?"</span>, session_id=<span class="st">"conv_001"</span>)
chat_agent(<span class="st">"Show me an asyncio.gather example."</span>, session_id=<span class="st">"conv_001"</span>)
chat_agent(<span class="st">"What's the difference with asyncio.wait?"</span>, session_id=<span class="st">"conv_001"</span>)

<span class="cm"># Or use PerformanceMonitor.conversation() context manager</span>
<span class="kw">with</span> monitor.<span class="fn">conversation</span>(<span class="st">"conv_001"</span>) <span class="kw">as</span> conv:
    conv.<span class="fn">turn</span>(user=<span class="st">"How do I use async in Python?"</span>, agent=<span class="st">"Use asyncio..."</span>)
    conv.<span class="fn">turn</span>(user=<span class="st">"Show me a gather example."</span>, agent=<span class="st">"import asyncio..."</span>)
<span class="cm"># → context_retention, topic_coherence, progressive_depth auto-aggregated</span></pre>
    </div>
  </div>
</section>

<section class="sec" id="gate-cli">
  <div class="sec-title">✨ agent-eval gate <span style="font-size:13px;font-weight:400;color:var(--text2);margin-left:8px">CLI · v0.6.3+</span></div>
  <div class="sec-sub">Reads evaluation result files and determines pass/fail based on quality thresholds. Used for release gating in CI/CD pipelines.</div>
  <div class="cls-card">
    <div class="cls-head"><span class="cls-name">agent-eval gate</span><span class="kind fn">CLI</span><span class="cls-src">cli/gate.py</span></div>
    <div class="cls-body">
      <table class="mtable"><thead><tr><th>Option</th><th>Description</th><th>Exit Code</th></tr></thead><tbody>
        <tr><td><span class="p">--tcr N</span></td><td>Minimum Task Completion Rate (%)</td><td rowspan="5"><code>0</code> pass<br><code>1</code> threshold failed<br><code>2</code> regression detected</td></tr>
        <tr><td><span class="p">--accuracy N</span></td><td>Minimum accuracy (%)</td></tr>
        <tr><td><span class="p">--p95-latency N</span></td><td>Maximum P95 latency (seconds)</td></tr>
        <tr><td><span class="p">--hallucination N</span></td><td>Maximum hallucination rate (%)</td></tr>
        <tr><td><span class="p">--llm-judge N</span></td><td>Minimum LLM Judge score (0–5)</td></tr>
        <tr><td><span class="p">--fail-on-regression N</span></td><td>Allowed regression rate vs. baseline (%)</td><td></td></tr>
        <tr><td><span class="p">--baseline PATH / --save-baseline</span></td><td>Baseline file path (default <code>&lt;result_dir&gt;/baseline.json</code>) / save current results as baseline</td><td></td></tr>
        <tr><td><span class="p">--baseline-version VERSION</span></td><td>Per-version independent baseline — resolves to <code>&lt;result_dir&gt;/baseline-VERSION.json</code> instead of the shared <code>baseline.json</code></td><td></td></tr>
        <tr><td><span class="p">--junit-xml PATH</span></td><td>Output JUnit XML report (CI integration)</td><td></td></tr>
        <tr><td><span class="p">--min-gate-score SCORE</span></td><td>Harness Gate A–G composite score lower bound (0.0–1.0); fails if the weighted group average falls below it</td><td></td></tr>
        <tr><td><span class="p">--group-weights WEIGHTS</span></td><td>Per-gate weights for <code>--min-gate-score</code>. Format: <code>'A:2.0,B:1.5,E:3.0'</code> (default all 1.0)</td><td></td></tr>
        <tr><td><span class="p">--gate-thresholds THRESHOLDS</span></td><td>Per-gate minimum score thresholds. Format: <code>'A:0.8,D:0.9,E:0.95'</code> (unlisted gates fall back to <code>--min-gate-score</code>)</td><td></td></tr>
        <tr><td><span class="p">--required-gates GATES</span></td><td>Comma-separated Gates to check, e.g. <code>'A,D,E'</code> (default: all Gates with data)</td><td></td></tr>
        <tr><td><span class="p">--fail-on-gate-warn</span></td><td>Treat Gate status <code>"warn"</code> as a failure</td><td></td></tr>
        <tr><td><span class="p">--golden-set PATH</span></td><td>Golden dataset JSON — flags cases whose current answer regresses vs. the recorded golden answer</td><td rowspan="2"><code>3</code> golden-set regression</td></tr>
        <tr><td><span class="p">--fail-on-golden-regression</span></td><td>Exit <code>3</code> when <code>--golden-set</code> finds a regression (otherwise reported but non-blocking)</td></tr>
      </tbody></table>
      <pre># GitHub Actions integration
- name: Quality Gate
  run: |
    agent-eval gate results/ci_run.json \
      --tcr 85 --accuracy 70 --p95-latency 3.0 \
      --fail-on-regression 10 \
      --junit-xml results/gate.xml

# Per-version baseline + golden-set regression gate
agent-eval gate results/v2-cot.json --baseline-version v2-cot --fail-on-regression 10
agent-eval gate results/ci_run.json --golden-set data/golden_datasets/golden_1.json --fail-on-golden-regression</pre>
    </div>
  </div>
</section>

<!-- ── AnomalyDetector ── -->
<section class="sec" id="anomaly">
  <div class="sec-title">📡 AnomalyDetector</div>
  <div class="sec-sub">Runs 6 checks over evaluation metrics using Z-score, IQR, linear-regression, ratio, and frequency algorithms. Auto-runs on save_to_file() when <code>PerformanceMonitor(enable_anomaly_detection=True)</code>.</div>
  <div class="cls-card">
    <div class="cls-head"><span class="cls-name">AnomalyDetector</span><span class="kind cls">class</span><span class="cls-src">agent_evaluator.anomaly.detector</span></div>
    <div class="cls-body">
      {% call param_table() %}
          <tr><td><span class="p">baseline_window</span><span class="opt">opt</span></td><td><span class="t">int</span></td><td><code>100</code></td><td>Maximum number of tasks used to calculate the baseline</td></tr>
          <tr><td><span class="p">detection_window</span><span class="opt">opt</span></td><td><span class="t">int</span></td><td><code>20</code></td><td>Number of recent tasks used for current state comparison</td></tr>
      {% endcall %}
      <table class="mtable" style="margin-top:12px">
        <thead><tr><th>Method</th><th>Return</th><th>Description</th></tr></thead>
        <tbody>
          <tr><td><span class="p">scan(monitor)</span></td><td><span class="r">List[AnomalyEvent]</span></td><td>Reads metrics from PerformanceMonitor, runs anomaly detection, returns list of AnomalyEvent</td></tr>
        </tbody>
      </table>
      <div class="slbl">AnomalyEvent Fields</div>
      <div class="ret-box">
        <span class="rk">type</span><span class="rv">: str — "latency_trend" | "accuracy_drift" | "token_spike" | "error_surge" | "security_pattern" | "feedback_negativity"</span><br>
        <span class="rk">severity</span><span class="rv">: str — "critical" | "warning"</span><br>
        <span class="rk">detail</span><span class="rv">: str — Detailed description (e.g. "Accuracy drifted -96.4% from baseline (z-score=4.57)")</span><br>
        <span class="rk">value</span><span class="rv">: float — Current measured value</span><br>
        <span class="rk">threshold</span><span class="rv">: float — Reference threshold</span><br>
        <span class="rk">algorithm</span><span class="rv">: str — "z-score" | "iqr" | "linear_regression" | "ratio" | "frequency"</span><br>
        <span class="rk">detected_at</span><span class="rv">: str — ISO-8601 detection timestamp</span><br>
        <span class="rv" style="color:var(--text2)">to_dict() also adds <code>event_id</code> (stable hash) and <code>metric</code> (= type)</span>
      </div>
<pre style="margin-top:12px"><span class="kw">from</span> <span class="cn">agent_evaluator</span> <span class="kw">import</span> PerformanceMonitor

<span class="cm"># Method 1: Built-in PerformanceMonitor — auto-detects on save_to_file()</span>
monitor = <span class="fn">PerformanceMonitor</span>(
    output_dir=<span class="st">"results/"</span>,
    enable_anomaly_detection=<span class="kw">True</span>,
    anomaly_baseline_window=<span class="nm">100</span>,
    anomaly_detection_window=<span class="nm">20</span>,
)
monitor.<span class="fn">record_task</span>(task)
monitor.<span class="fn">save_to_file</span>(<span class="st">"run"</span>)  <span class="cm"># → anomaly_data auto-included in JSON</span>

<span class="cm"># Method 2: Standalone usage</span>
<span class="kw">from</span> <span class="cn">agent_evaluator.anomaly.detector</span> <span class="kw">import</span> AnomalyDetector
detector = <span class="fn">AnomalyDetector</span>(baseline_window=<span class="nm">50</span>, detection_window=<span class="nm">10</span>)
anomalies = detector.<span class="fn">scan</span>(monitor)
<span class="kw">for</span> a <span class="kw">in</span> anomalies:
    <span class="fn">print</span>(f<span class="st">"{a.type} [{a.severity}] {a.detail} (algo={a.algorithm})"</span>)</pre>
    </div>
  </div>
</section>

<!-- ── AlertEngine ── -->
<section class="sec" id="alerts">
  <div class="sec-title">🔔 AlertEngine / SimpleTaskAlertRule</div>
  <div class="sec-sub">Sends real-time alerts when metric thresholds are exceeded. <code>AlertEngine</code> is a streaming approach connected to <code>StreamingEvaluator</code>; <code>SimpleTaskAlertRule</code> is a lightweight approach wired directly to the <code>@agent_eval</code> decorator.</div>
  <div class="cls-card">
    <div class="cls-head"><span class="cls-name">AlertRule</span><span class="kind cls">dataclass</span><span class="cls-src">agent_evaluator.alerts.engine</span></div>
    <div class="cls-body">
      {% call field_table(col3='Description') %}
          <tr><td><span class="p">name</span></td><td><span class="t">str</span></td><td>Rule name</td></tr>
          <tr><td><span class="p">metric</span></td><td><span class="t">str</span></td><td>Monitored metric key (e.g. <code>"tcr"</code>, <code>"error_rate"</code>, <code>"avg_latency"</code>)</td></tr>
          <tr><td><span class="p">operator</span></td><td><span class="t">str</span></td><td><code>"lt"</code> | <code>"gt"</code> | <code>"lte"</code> | <code>"gte"</code></td></tr>
          <tr><td><span class="p">threshold</span></td><td><span class="t">float</span></td><td>Threshold value</td></tr>
          <tr><td><span class="p">severity</span></td><td><span class="t">str</span></td><td><code>"critical"</code> | <code>"warning"</code> | <code>"info"</code></td></tr>
          <tr><td><span class="p">cooldown_seconds</span></td><td><span class="t">int</span></td><td>Minimum re-fire interval for the same rule (seconds). Default 300.</td></tr>
          <tr><td><span class="p">window</span></td><td><span class="t">str</span></td><td><code>"1m"</code> | <code>"5m"</code> | <code>"1h"</code>. Default <code>"5m"</code>.</td></tr>
      {% endcall %}
    </div>
  </div>
  <div class="cls-card" style="margin-top:12px">
    <div class="cls-head"><span class="cls-name">AlertEngine</span><span class="kind cls">class</span><span class="cls-src">agent_evaluator.alerts.engine</span></div>
    <div class="cls-body">
      <table class="mtable">
        <thead><tr><th>Method</th><th>Return</th><th>Description</th></tr></thead>
        <tbody>
          <tr><td><span class="p">add_rule(rule)</span></td><td><span class="r">AlertEngine</span></td><td>Add AlertRule. Method chaining supported.</td></tr>
          <tr><td><span class="p">evaluate(evaluator)</span></td><td><span class="r">List[AlertEvent]</span></td><td>Reads StreamingEvaluator metrics, evaluates rules, returns fired alerts.</td></tr>
          <tr><td><span class="p">get_rules()</span></td><td><span class="r">List[Dict]</span></td><td>List of registered rules</td></tr>
        </tbody>
      </table>
<pre style="margin-top:10px"><span class="kw">from</span> <span class="cn">agent_evaluator.alerts.engine</span> <span class="kw">import</span> AlertEngine, AlertRule
<span class="kw">from</span> <span class="cn">agent_evaluator.streaming.evaluator</span> <span class="kw">import</span> StreamingEvaluator
<span class="kw">from</span> <span class="cn">agent_evaluator</span> <span class="kw">import</span> PerformanceMonitor

monitor = <span class="fn">PerformanceMonitor</span>()
engine = <span class="fn">AlertEngine</span>()
engine.<span class="fn">add_rule</span>(<span class="fn">AlertRule</span>(
    name=<span class="st">"TCR Drop"</span>, metric=<span class="st">"tcr"</span>, operator=<span class="st">"lt"</span>,
    threshold=<span class="nm">0.7</span>, severity=<span class="st">"critical"</span>, cooldown_seconds=<span class="nm">300</span>
))
streamer = <span class="fn">StreamingEvaluator</span>(monitor=monitor, alert_handler=engine)
streamer.<span class="fn">start</span>()
streamer.<span class="fn">record</span>(<span class="st">"t1"</span>, success=<span class="kw">True</span>, execution_time=<span class="nm">1.2</span>, tokens_used=<span class="nm">300</span>)</pre>
    </div>
  </div>
  <div class="cls-card" style="margin-top:12px">
    <div class="cls-head"><span class="cls-name">SimpleTaskAlertRule</span><span class="kind cls">class</span><span class="cls-src">agent_evaluator.alerts.engine</span></div>
    <div class="cls-desc">No <code>StreamingEvaluator</code> required. Lightweight alert rule wired directly to <code>@agent_eval</code>, <code>@batch_eval</code>, or <code>EvalDecorator</code> via the <code>alert_rules=[rule]</code> parameter.</div>
    <div class="cls-body">
      {% call param_table() %}
          <tr><td><span class="p">name</span><span class="req">✦</span></td><td><span class="t">str</span></td><td>—</td><td>Rule name</td></tr>
          <tr><td><span class="p">condition</span><span class="req">✦</span></td><td><span class="t">Callable[[TaskResult], bool]</span></td><td>—</td><td>Alert trigger condition</td></tr>
          <tr><td><span class="p">handler</span><span class="req">✦</span></td><td><span class="t">Callable[[str, TaskResult], None]</span></td><td>—</td><td>Alert handler (message, TaskResult)</td></tr>
          <tr><td><span class="p">severity</span><span class="opt">opt</span></td><td><span class="t">str</span></td><td><code>"warning"</code></td><td><code>"critical"</code> | <code>"warning"</code> | <code>"info"</code></td></tr>
          <tr><td><span class="p">cooldown</span><span class="opt">opt</span></td><td><span class="t">int</span></td><td><code>0</code></td><td>Minimum re-fire interval (seconds)</td></tr>
      {% endcall %}
<pre style="margin-top:10px"><span class="kw">from</span> <span class="cn">agent_evaluator</span> <span class="kw">import</span> SimpleTaskAlertRule
<span class="kw">from</span> <span class="cn">agent_evaluator.decorators</span> <span class="kw">import</span> agent_eval

rule = <span class="fn">SimpleTaskAlertRule</span>(
    name=<span class="st">"slow_response"</span>,
    condition=<span class="kw">lambda</span> tr: tr.execution_time > <span class="nm">5.0</span>,
    handler=<span class="kw">lambda</span> msg, tr: <span class="fn">print</span>(f<span class="st">"[ALERT] {msg}"</span>),
    severity=<span class="st">"warning"</span>, cooldown=<span class="nm">60</span>,
)

<span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"qa"</span>, alert_rules=[rule])
<span class="kw">def</span> <span class="fn">my_agent</span>(question: str, ground_truth: str = <span class="st">""</span>) -> str: ...</pre>
    </div>
  </div>
</section>

<!-- ── StreamingEvaluator ── -->
<section class="sec" id="streaming">
  <div class="sec-title">🌊 StreamingEvaluator</div>
  <div class="sec-sub">Real-time evaluation based on sliding windows (1m·5m·1h). Instantly computes recent metrics without batch storage.</div>
  <div class="cls-card">
    <div class="cls-head"><span class="cls-name">StreamingEvaluator</span><span class="kind cls">class</span><span class="cls-src">agent_evaluator.streaming.evaluator</span></div>
    <div class="cls-body">
      {% call param_table() %}
          <tr><td><span class="p">monitor</span><span class="req">✦</span></td><td><span class="t">PerformanceMonitor</span></td><td>—</td><td>PerformanceMonitor instance to connect</td></tr>
          <tr><td><span class="p">flush_interval</span><span class="opt">opt</span></td><td><span class="t">int</span></td><td><code>60</code></td><td>Background flush interval (seconds)</td></tr>
          <tr><td><span class="p">alert_handler</span><span class="opt">opt</span></td><td><span class="t">AlertEngine|None</span></td><td><code>None</code></td><td>Alert engine. Rules auto-evaluated on every record() call when connected.</td></tr>
      {% endcall %}
      <table class="mtable" style="margin-top:12px">
        <thead><tr><th>Method</th><th>Return</th><th>Description</th></tr></thead>
        <tbody>
          <tr><td><span class="p">record(task_id, success, execution_time, tokens_used=0, accuracy_score=0.0, has_error=False)</span></td><td><span class="r">None</span></td><td>Records task result in the sliding window. Auto-evaluates rules when alert_handler is connected.</td></tr>
          <tr><td><span class="p">get_stats(window="5m")</span></td><td><span class="r">Dict</span></td><td>Returns window statistics. Keys: <code>count</code>, <code>tcr</code>, <code>avg_latency</code>, <code>p95_latency</code>, <code>error_rate</code>, <code>avg_tokens</code></td></tr>
          <tr><td><span class="p">start()</span></td><td><span class="r">None</span></td><td>Start background flush thread</td></tr>
          <tr><td><span class="p">stop()</span></td><td><span class="r">None</span></td><td>Stop background flush thread</td></tr>
        </tbody>
      </table>
      <div class="note" style="margin-top:8px">📊 <code>window</code>: Three concurrent windows — <code>"1m"</code> (60s) · <code>"5m"</code> (300s) · <code>"1h"</code> (3600s).</div>
<pre style="margin-top:10px"><span class="kw">from</span> <span class="cn">agent_evaluator</span> <span class="kw">import</span> PerformanceMonitor
<span class="kw">from</span> <span class="cn">agent_evaluator.streaming.evaluator</span> <span class="kw">import</span> StreamingEvaluator

monitor = <span class="fn">PerformanceMonitor</span>()
streamer = <span class="fn">StreamingEvaluator</span>(monitor=monitor, flush_interval=<span class="nm">60</span>)
streamer.<span class="fn">start</span>()

<span class="cm"># Record task result in real time</span>
streamer.<span class="fn">record</span>(<span class="st">"t1"</span>, success=<span class="kw">True</span>, execution_time=<span class="nm">1.2</span>, tokens_used=<span class="nm">350</span>, accuracy_score=<span class="nm">0.9</span>)

<span class="cm"># Query sliding window statistics</span>
stats = streamer.<span class="fn">get_stats</span>(<span class="st">"5m"</span>)
<span class="cm"># → {'count': 12, 'tcr': 0.92, 'avg_latency': 1.1, 'p95_latency': 2.3, 'error_rate': 0.08}</span>
streamer.<span class="fn">stop</span>()</pre>
    </div>
  </div>
</section>

<!-- ── CostTracker / AdaptivePolicy ── -->
<section class="sec" id="cost">
  <div class="sec-title">💸 CostTracker / AdaptivePolicy</div>
  <div class="sec-sub">Tracks external evaluation API call costs and auto-adjusts sampling rate when budget is exceeded.</div>
  <div class="cls-card">
    <div class="cls-head"><span class="cls-name">CostTracker</span><span class="kind cls">class</span><span class="cls-src">agent_evaluator.cost.policy</span></div>
    <div class="cls-body">
      {% call param_table() %}
          <tr><td><span class="p">budget_per_day</span><span class="opt">opt</span></td><td><span class="t">float|None</span></td><td><code>None</code></td><td>Daily budget cap (USD). No limit if None.</td></tr>
          <tr><td><span class="p">alert_at</span><span class="opt">opt</span></td><td><span class="t">float</span></td><td><code>0.8</code></td><td>Budget alert ratio (0.0–1.0). Default alerts at 80%.</td></tr>
      {% endcall %}
      <table class="mtable" style="margin-top:10px">
        <thead><tr><th>Method</th><th>Return</th><th>Description</th></tr></thead>
        <tbody>
          <tr><td><span class="p">record(provider, model, cost_usd, input_tokens=0, output_tokens=0, evaluation_type="llm_judge")</span></td><td><span class="r">None</span></td><td>Record a cost entry. <code>evaluation_type</code>: <code>"llm_judge"</code> | <code>"deepeval"</code> | <code>"ragas"</code></td></tr>
          <tr><td><span class="p">get_daily_stats()</span></td><td><span class="r">Dict</span></td><td>Today's aggregates: <code>today_total_usd</code>, <code>today_call_count</code>, <code>by_provider</code>, <code>by_evaluation_type</code>, <code>daily_history</code>, <code>budget_remaining_usd</code></td></tr>
          <tr><td><span class="p">get_all_records()</span></td><td><span class="r">List[Dict]</span></td><td>Full list of all cost records</td></tr>
          <tr><td><span class="p">is_budget_exceeded()</span></td><td><span class="r">bool</span></td><td>Whether daily budget is exceeded</td></tr>
          <tr><td><span class="p">is_budget_alert()</span></td><td><span class="r">bool</span></td><td>Whether alert_at ratio has been reached</td></tr>
          <tr><td><span class="p">reset()</span></td><td><span class="r">None</span></td><td>Reset all records</td></tr>
        </tbody>
      </table>
