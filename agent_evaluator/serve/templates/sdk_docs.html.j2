.tc:hover{border-color:var(--accent)}.tc .tn{font-family:monospace;font-size:13px;font-weight:700;color:var(--accent);margin-bottom:4px}
.tc .tm{font-size:12px;color:var(--green);margin-bottom:4px}.tc .td{font-size:12px;color:var(--text2);line-height:1.5}
.slbl{font-size:11px;font-weight:700;color:var(--text2);margin:16px 0 8px;text-transform:uppercase;letter-spacing:.05em}
.ret-box{background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:8px 12px;font-size:12px;font-family:monospace;margin-top:6px;line-height:1.6}
.ret-box .rk{color:var(--accent)}.ret-box .rv{color:var(--text2)}
