<span class="fn">my_agent</span>(<span class="st">"What is the capital of France?"</span>, ground_truth=<span class="st">"Paris"</span>)
eval.<span class="fn">save</span>()                          <span class="cm"># → results/*.json + *.html</span>
eval.<span class="fn">gate</span>(tcr=<span class="nm">85</span>, accuracy=<span class="nm">70</span>)       <span class="cm"># CI/CD — exits with 1 on failure</span>

<span class="cm"># RAG-only (hallucination detection auto-enabled)</span>
eval = <span class="fn">QuickEval.for_rag</span>(<span class="st">"results/"</span>)
<span class="de">@eval.rag</span>
<span class="kw">def</span> <span class="fn">rag_agent</span>(question: str, context: str = <span class="st">""</span>, ground_truth: str = <span class="st">""</span>) -> str: ...

<span class="cm"># auto-save + batch</span>
eval = <span class="fn">QuickEval</span>(<span class="st">"results/"</span>, auto_save=<span class="kw">True</span>, auto_save_interval=<span class="nm">10</span>)
<span class="de">@eval.batch</span>(task_type=<span class="st">"qa"</span>)
<span class="kw">def</span> <span class="fn">batch_agent</span>(questions: list, ground_truths: list = <span class="kw">None</span>) -> list: ...</pre>
