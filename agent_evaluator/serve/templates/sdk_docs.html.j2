          </tr>
      {% endcall %}
<pre style="margin-top:10px"><span class="kw">from</span> <span class="cn">agent_evaluator</span> <span class="kw">import</span> InputSanitizationTracker
tracker = <span class="fn">InputSanitizationTracker</span>()
r = tracker.<span class="fn">evaluate_input</span>(<span class="st">"t1"</span>, <span class="st">"SELECT * FROM users; DROP TABLE users"</span>)
<span class="cm"># → {'has_sql_injection': True, 'risk_level': 'high', 'threat_count': 1, ...}</span></pre>
