            <div style="font-size:11px;line-height:1.6;color:var(--text)">TCR<br>Latency<br>Token</div>
          </div>
          <div style="border:1px solid #22c55e;border-radius:6px;padding:8px 6px;text-align:center;background:var(--bg2)">
            <div style="font-size:10px;color:#22c55e;font-weight:700;margin-bottom:4px">L1 Always</div>
            <div style="font-size:11px;line-height:1.6;color:var(--text)">Accuracy<br>Quality<br>Halluc.*</div>
          </div>
          <div style="border:1px solid #3b82f6;border-radius:6px;padding:8px 6px;text-align:center;background:var(--bg2)">
