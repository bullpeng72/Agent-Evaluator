          <tr><td><span class="p">budget_per_day</span><span class="opt">opt</span></td><td><span class="t">float|None</span></td><td><code>None</code></td><td>Daily budget cap (USD)</td></tr>
          <tr><td><span class="p">alert_at</span><span class="opt">opt</span></td><td><span class="t">float</span></td><td><code>0.8</code></td><td>Budget alert ratio</td></tr>
      {% endcall %}
<pre style="margin-top:10px"><span class="kw">from</span> <span class="cn">agent_evaluator.cost.policy</span> <span class="kw">import</span> CostTracker, AdaptivePolicy

