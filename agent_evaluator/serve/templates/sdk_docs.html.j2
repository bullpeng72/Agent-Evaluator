<!-- ── InputSanitizationTracker ── -->
<section class="sec" id="sanitize">
  <div class="sec-title"><span class="badge l2">L2</span> InputSanitizationTracker</div>
  <div class="sec-sub">Detects 5 input attack pattern types (SQL, Command, Path, XSS, Prompt Injection) via regex.</div>
  <div class="cls-card">
    <div class="cls-head"><span class="cls-name">InputSanitizationTracker</span><span class="kind cls">class</span><span class="cls-src">agent_evaluator.core.trackers.security</span></div>
    <div class="cls-body">
      {% call tracker_table() %}
          <tr>
            <td><span class="p">evaluate_input(task_id, input_text)</span></td>
            <td><span class="t">str, str</span></td>
