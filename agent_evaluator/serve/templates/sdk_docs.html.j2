{%- macro tracker_table() %}
      <table class="mtable">
        <thead><tr><th>메서드</th><th>파라미터</th><th>반환 키</th></tr></thead>
        <tbody>{{ caller() }}</tbody>
      </table>
{%- endmacro %}
{%- macro param_table() %}
      <table class="mtable">
        <thead><tr><th>파라미터</th><th>타입</th><th>기본값</th><th>설명</th></tr></thead>
        <tbody>{{ caller() }}</tbody>
      </table>
{%- endmacro %}
{%- macro field_table(col3='설명') %}
      <table class="mtable">
        <thead><tr><th>필드</th><th>타입</th><th>{{ col3 }}</th></tr></thead>
        <tbody>{{ caller() }}</tbody>
      </table>
{%- endmacro %}
<!DOCTYPE html>
<html lang="ko" id="root">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>SDK 레퍼런스 — {{ title }}</title>
<style>
:root{--bg:#0f1117;--bg2:#1a1d27;--bg3:#22263a;--border:#2d3148;--text:#e2e4f0;--text2:#9098b8;--accent:#6c8ef5;--green:#4ade80;--yellow:#facc15;--red:#f87171;--orange:#fb923c;--r:8px}
html.light{--bg:#f4f6fc;--bg2:#fff;--bg3:#eef0f8;--border:#d1d5e8;--text:#1a1d2e;--text2:#5a6080}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);font-size:15px;line-height:1.7}
.layout{display:grid;grid-template-columns:260px 1fr;height:100vh}
.side{background:var(--bg2);border-right:1px solid var(--border);overflow-y:auto;position:sticky;top:0;height:100vh;padding:0 0 28px}
.main{overflow-y:auto;padding:36px 48px;width:100%}
.side-hdr{padding:18px 16px 12px;border-bottom:1px solid var(--border);margin-bottom:8px}
.side-hdr .logo{font-weight:700;font-size:14px}.side-hdr .logo span{color:var(--accent)}
.side-hdr .ver{font-size:11px;color:var(--text2);background:var(--bg3);border:1px solid var(--border);border-radius:99px;padding:2px 8px;margin-left:6px}
.nav-group{margin:10px 0 2px;padding:0 16px;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--text2)}
.nav-item{display:flex;align-items:center;gap:6px;padding:6px 16px;font-size:13px;color:var(--text2);border-left:3px solid transparent;text-decoration:none;transition:background .1s}
.nav-item:hover,.nav-item.on{background:var(--bg3);color:var(--text);border-left-color:var(--accent)}
.nav-item .tag{margin-left:auto;font-size:10px;padding:1px 5px;border-radius:99px;background:var(--bg3);color:var(--text2)}
.sec{margin-bottom:48px;scroll-margin-top:20px}
.sec-title{font-size:22px;font-weight:700;margin-bottom:8px;display:flex;align-items:center;gap:10px}
.sec-sub{color:var(--text2);font-size:14px;margin-bottom:20px;border-bottom:1px solid var(--border);padding-bottom:12px}
.cls-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);margin-bottom:18px;overflow:hidden}
.cls-head{padding:13px 18px;background:var(--bg3);border-bottom:1px solid var(--border);display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.cls-name{font-size:16px;font-weight:700;font-family:monospace;color:var(--accent)}
.kind{font-size:11px;padding:2px 8px;border-radius:99px;font-weight:600}
.kind.cls{background:#6c8ef522;color:var(--accent)}.kind.fn{background:#4ade8022;color:var(--green)}
.kind.en{background:#facc1522;color:var(--yellow)}.kind.ctx{background:#fb923c22;color:var(--orange)}
.cls-src{font-size:11px;color:var(--text2);margin-left:auto}
.cls-desc{padding:13px 18px;color:var(--text2);font-size:14px;line-height:1.6}
.cls-body{padding:0 18px 16px}
.mtable{width:100%;border-collapse:collapse;font-size:13px;margin-top:10px}
.mtable th{text-align:left;padding:6px 10px;font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text2);background:var(--bg3);border-bottom:1px solid var(--border)}
.mtable td{padding:7px 10px;border-bottom:1px solid var(--border);vertical-align:top;line-height:1.5}
.mtable tr:last-child td{border-bottom:none}.mtable tr:hover td{background:var(--bg3)}
.p{font-family:monospace;color:var(--accent);font-size:13px}
.t{font-family:monospace;color:var(--yellow);font-size:12px}
.r{font-family:monospace;color:var(--green);font-size:12px}
.req{color:var(--red);font-size:10px;margin-left:3px}.opt{color:var(--text2);font-size:10px;margin-left:3px}
pre{background:var(--bg3);border:1px solid var(--border);border-radius:var(--r);padding:15px 18px;overflow-x:auto;font-size:13px;font-family:'Cascadia Code','Fira Code',monospace;margin:12px 0;line-height:1.65}
code{font-family:'Cascadia Code','Fira Code',monospace;font-size:13px}
.kw{color:#c792ea}.cn{color:var(--accent)}.fn{color:var(--green)}.st{color:#c3e88d}.cm{color:var(--text2);font-style:italic}.nm{color:var(--yellow)}.de{color:#ff9d48;font-weight:600}
.badge{display:inline-block;font-size:11px;padding:2px 8px;border-radius:99px;font-weight:600}
.l1{background:#6c8ef522;color:var(--accent)}.l2{background:#4ade8022;color:var(--green)}.l3{background:#fb923c22;color:var(--orange)}
.req-b{background:#f8717122;color:var(--red)}.opt-b{background:#22263a;color:var(--text2);border:1px solid var(--border)}
.toolbar{position:sticky;top:0;background:var(--bg2);border-bottom:1px solid var(--border);padding:9px 16px;display:flex;align-items:center;gap:10px;z-index:10;font-size:13px}
.toolbar .title{font-weight:700;color:var(--accent)}.sp{flex:1}
.btn{background:var(--bg3);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:5px 12px;font-size:12px;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:4px}
.btn:hover{background:var(--accent);color:#fff;border-color:var(--accent)}
input[type=search]{background:var(--bg3);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:5px 12px;font-size:13px;width:220px;outline:none}
input[type=search]:focus{border-color:var(--accent)}
.note{background:var(--bg3);border-left:3px solid var(--accent);border-radius:0 var(--r) var(--r) 0;padding:12px 16px;font-size:13px;color:var(--text2);margin:12px 0;line-height:1.6}
.note.warn{border-left-color:var(--yellow)}.note.tip{border-left-color:var(--green)}
mark{background:#facc1544;color:var(--yellow);border-radius:2px}
hr{border:none;border-top:1px solid var(--border);margin:20px 0}
.lhdr{background:var(--bg3);border:1px solid var(--border);border-radius:var(--r);padding:12px 16px;margin-bottom:16px;display:flex;align-items:center;gap:12px}
.lhdr .lnum{font-size:24px;font-weight:800;color:var(--accent);font-family:monospace}
.lhdr .ltitle{font-weight:700;font-size:15px}.lhdr .ldesc{font-size:12px;color:var(--text2);margin-top:2px}
.lhdr .ldep{font-size:11px;padding:3px 10px;border-radius:99px;border:1px solid var(--border);color:var(--text2)}
.tgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;margin-bottom:14px}
.tc{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:12px}
.tc:hover{border-color:var(--accent)}.tc .tn{font-family:monospace;font-size:13px;font-weight:700;color:var(--accent);margin-bottom:4px}
.tc .tm{font-size:12px;color:var(--green);margin-bottom:4px}.tc .td{font-size:12px;color:var(--text2);line-height:1.5}
.slbl{font-size:11px;font-weight:700;color:var(--text2);margin:16px 0 8px;text-transform:uppercase;letter-spacing:.05em}
.ret-box{background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:8px 12px;font-size:12px;font-family:monospace;margin-top:6px;line-height:1.6}
.ret-box .rk{color:var(--accent)}.ret-box .rv{color:var(--text2)}
</style>
</head>
