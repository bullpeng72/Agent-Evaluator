               input_tokens=<span class="nm">200</span>, output_tokens=<span class="nm">80</span>, evaluation_type=<span class="st">"llm_judge"</span>)

stats = tracker.<span class="fn">get_daily_stats</span>()
<span class="cm"># → {'today_total_usd': 0.001, 'today_call_count': 1, 'by_provider': {'anthropic': 0.001}, ...}</span>

policy = <span class="fn">AdaptivePolicy</span>(default_sample_rate=<span class="nm">0.1</span>, anomaly_sample_rate=<span class="nm">1.0</span>, budget_per_day=<span class="nm">5.0</span>)
<span class="cm"># Set anomaly flag → auto-switch sampling rate</span>
policy.<span class="fn">set_anomaly_detected</span>(<span class="kw">True</span>)
