<pre><span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"tool_use"</span>, framework=<span class="st">"crewai"</span>)
<span class="kw">def</span> <span class="fn">run_crew</span>(question: str, ground_truth: str = <span class="st">""</span>) -> str:
