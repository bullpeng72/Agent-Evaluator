      {% endcall %}
<pre style="margin-top:10px"><span class="cm"># SLA compliance check example</span>
sla = {<span class="st">"qa"</span>: <span class="nm">2.0</span>, <span class="st">"code_generation"</span>: <span class="nm">5.0</span>}  <span class="cm"># in seconds</span>
