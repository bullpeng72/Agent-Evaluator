<pre><span class="kw">from</span> <span class="cn">langchain_core.messages</span> <span class="kw">import</span> HumanMessage

<span class="de">@agent_eval</span>(monitor, task_type=<span class="st">"information_retrieval"</span>, framework=<span class="st">"langgraph"</span>)
<span class="kw">def</span> <span class="fn">run_graph</span>(question: str, ground_truth: str = <span class="st">""</span>) -> str:
