<section class="sec" id="quickeval">
  <div class="sec-title">⚡ QuickEval <span style="font-size:13px;font-weight:400;color:var(--text2);margin-left:8px">v0.7.1+ · One-stop Facade</span></div>
  <div class="sec-sub">High-level Facade to start with PerformanceMonitor + EvalDecorator in one line. Provides 11 shortcut decorators + 4 factory methods.</div>
  <div class="cls-card">
    <div class="cls-head"><span class="cls-name">QuickEval</span><span class="kind cls">class</span><span class="cls-src">agent_evaluator.quick_eval</span></div>
    <div class="cls-body">
      <div class="slbl">Constructor Parameters</div>
      {% call param_table() %}
          <tr><td><span class="p">output_dir</span><span class="req">✦</span></td><td><span class="t">str</span></td><td>—</td><td>JSON/HTML report save directory</td></tr>
