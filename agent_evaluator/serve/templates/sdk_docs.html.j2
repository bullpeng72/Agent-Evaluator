          <tr><td><span class="p">@eval.planning</span></td><td><code>"planning"</code></td><td></td></tr>
          <tr><td><span class="p">@eval.data_analysis</span></td><td><code>"data_analysis"</code></td><td></td></tr>
          <tr><td><span class="p">@eval.creative</span></td><td><code>"creative"</code></td><td></td></tr>
          <tr><td><span class="p">@eval.multi_agent</span></td><td><code>"tool_use"</code></td><td>AgentCoordination enabled</td></tr>
          <tr><td><span class="p">@eval.secure</span></td><td><code>"qa"</code></td><td>security_metrics temporarily enabled</td></tr>
          <tr><td><span class="p">@eval.streaming</span></td><td><code>"qa"</code></td><td>TTFT auto-recording</td></tr>
        </tbody>
      </table>
      <div class="slbl">Key Methods</div>
      <table class="mtable">
        <thead><tr><th>Method</th><th>Return</th><th>Description</th></tr></thead>
        <tbody>
          <tr><td><span class="p">save(filename=None)</span></td><td><span class="r">None</span></td><td>JSON + HTML save</td></tr>
