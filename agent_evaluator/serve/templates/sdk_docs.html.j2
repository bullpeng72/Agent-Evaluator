      {% call param_table() %}
          <tr><td><span class="p">output_filename</span><span class="req">✦</span></td><td><span class="t">str</span></td><td>—</td><td>저장 파일명 stem (확장자 제외)</td></tr>
          <tr><td><span class="p">enable_security</span><span class="opt">opt</span></td><td><span class="t">bool</span></td><td><code>False</code></td><td>보안 지표 활성화</td></tr>
