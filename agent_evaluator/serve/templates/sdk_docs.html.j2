.cls-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);margin-bottom:18px;overflow:hidden}
.cls-head{padding:13px 18px;background:var(--bg3);border-bottom:1px solid var(--border);display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.cls-name{font-size:16px;font-weight:700;font-family:monospace;color:var(--accent)}
