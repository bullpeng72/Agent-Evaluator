{%- macro tracker_table() %}
      <table class="mtable">
        <thead><tr><th>Method</th><th>Parameters</th><th>Return Keys</th></tr></thead>
        <tbody>{{ caller() }}</tbody>
      </table>
{%- endmacro %}
{%- macro param_table() %}
      <table class="mtable">
        <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
        <tbody>{{ caller() }}</tbody>
      </table>
{%- endmacro %}
{%- macro field_table(col3='Description') %}
      <table class="mtable">
        <thead><tr><th>Field</th><th>Type</th><th>{{ col3 }}</th></tr></thead>
        <tbody>{{ caller() }}</tbody>
      </table>
{%- endmacro %}
