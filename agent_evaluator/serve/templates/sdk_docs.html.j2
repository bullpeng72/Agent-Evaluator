  <div class="cls-card">
    <div class="cls-head"><span class="cls-name">ResponseQualityEvaluator</span><span class="kind cls">class</span><span class="cls-src">core.agent_evaluator</span></div>
    <div class="cls-body">
      {% call tracker_table() %}
          <tr>
            <td><span class="p">evaluate_response(task_id, response, request, expected_elements, ground_truth=None)</span></td>
            <td><span class="t">str, str, str, List[str], Optional[str]</span></td>
