<!-- ── LLM Helpers ───────────────────────────────────────────────── -->
<section class="sec" id="llm-helpers">
  <div class="sec-title"><span class="icon">🤖</span> LLMHelper / ClaudeHelper</div>
  <div class="sec-sub">LLM을 이용한 고품질 평가 보조 클래스입니다.</div>

  <div class="cls-card">
    <div class="cls-head"><span class="cls-name">LLMHelper</span><span class="cls-kind class">class</span><span style="margin-left:8px;font-size:11px;color:var(--text2)">alias: LLMEvaluationHelper</span></div>
    <div class="cls-desc">OpenAI 모델을 사용해 응답 품질을 LLM-as-judge 방식으로 평가합니다. <code>OPENAI_API_KEY</code> 필요.</div>
    <div class="cls-body">
<pre><span class="kw">from</span> <span class="cn">agent_evaluator</span> <span class="kw">import</span> LLMHelper

helper = <span class="fn">LLMHelper</span>(model=<span class="st">"gpt-4o-mini"</span>)
score = <span class="kw">await</span> helper.<span class="fn">evaluate_response</span>(
    question=<span class="st">"수도는?"</span>,
    response=<span class="st">"서울입니다."</span>,
    expected=<span class="st">"서울"</span>,
)</pre>
    </div>
  </div>

  <div class="cls-card">
    <div class="cls-head"><span class="cls-name">ClaudeHelper</span><span class="cls-kind class">class</span><span style="margin-left:8px;font-size:11px;color:var(--text2)">alias: AnthropicEvaluationHelper</span></div>
    <div class="cls-desc">Anthropic Claude 모델을 사용하는 평가 헬퍼입니다. <code>ANTHROPIC_API_KEY</code> 필요.</div>
    <div class="cls-body">
<pre><span class="kw">from</span> <span class="cn">agent_evaluator</span> <span class="kw">import</span> ClaudeHelper

helper = <span class="fn">ClaudeHelper</span>(model=<span class="st">"claude-haiku-4-5-20251001"</span>)
score = <span class="kw">await</span> helper.<span class="fn">evaluate_response</span>(
    question=<span class="st">"질문"</span>,
    response=<span class="st">"응답"</span>,
)</pre>
    </div>
  </div>
</section>

<!-- 하단 여백 -->
<div style="height:60px"></div>
</div><!-- /main -->
</div><!-- /flex col -->
</div><!-- /layout -->

<script>
// ── 테마 토글 ──────────────────────────────────────────────────────
const root = document.getElementById('root');
const THEME_KEY = 'ae-sdk-theme';
(function(){
  if(localStorage.getItem(THEME_KEY) === 'light') root.classList.add('light');
})();
function toggleTheme(){
  root.classList.toggle('light');
  localStorage.setItem(THEME_KEY, root.classList.contains('light') ? 'light' : 'dark');
}

// ── 활성 네비게이션 하이라이트 ──────────────────────────────────────
const navItems = document.querySelectorAll('.nav-item[href^="#"]');
const sections = [...document.querySelectorAll('section.sec')];
const content  = document.getElementById('content');

function updateNav(){
  let active = sections[0]?.id;
  for(const s of sections){
    if(s.getBoundingClientRect().top <= 80) active = s.id;
  }
  navItems.forEach(a=>{
    a.classList.toggle('on', a.getAttribute('href')==='#'+active);
  });
}
content.addEventListener('scroll', updateNav, {passive:true});
updateNav();

// 네비게이션 클릭 시 스크롤
navItems.forEach(a=>{
  a.addEventListener('click', e=>{
    e.preventDefault();
    const id = a.getAttribute('href').slice(1);
    document.getElementById(id)?.scrollIntoView({behavior:'smooth'});
  });
});

// ── 검색 ────────────────────────────────────────────────────────────
function doSearch(q){
  // 기존 하이라이트 제거
  document.querySelectorAll('mark').forEach(m=>{
    const t = document.createTextNode(m.textContent);
    m.parentNode.replaceChild(t,m);
  });
  if(!q || q.length < 2) return;
  const walker = document.createTreeWalker(
    document.getElementById('content'),
    NodeFilter.SHOW_TEXT,
    { acceptNode: n => n.parentElement.closest('script,style,input') ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT }
  );
  const nodes=[];
  while(walker.nextNode()) nodes.push(walker.currentNode);
  const re = new RegExp(q.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'), 'gi');
  nodes.forEach(node=>{
    if(!re.test(node.textContent)) return;
    re.lastIndex=0;
    const frag = document.createDocumentFragment();
    let last=0, m;
    while((m=re.exec(node.textContent))!==null){
      frag.appendChild(document.createTextNode(node.textContent.slice(last,m.index)));
      const mark=document.createElement('mark');
      mark.textContent=m[0];
      frag.appendChild(mark);
      last=m.index+m[0].length;
    }
    frag.appendChild(document.createTextNode(node.textContent.slice(last)));
    node.parentNode.replaceChild(frag,node);
  });
  // 첫 번째 결과로 스크롤
  document.querySelector('mark')?.scrollIntoView({behavior:'smooth',block:'center'});
}
</script>
</body>
</html>
