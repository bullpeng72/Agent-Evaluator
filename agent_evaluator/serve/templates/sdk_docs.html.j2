<style>
:root{--bg:#0f1117;--bg2:#1a1d27;--bg3:#22263a;--border:#2d3148;--text:#e2e4f0;--text2:#9098b8;--accent:#6c8ef5;--green:#4ade80;--yellow:#facc15;--red:#f87171;--orange:#fb923c;--r:8px}
html.light{--bg:#f4f6fc;--bg2:#fff;--bg3:#eef0f8;--border:#d1d5e8;--text:#1a1d2e;--text2:#5a6080}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);font-size:15px;line-height:1.7}
.layout{display:grid;grid-template-columns:260px 1fr;height:100vh}
.side{background:var(--bg2);border-right:1px solid var(--border);overflow-y:auto;position:sticky;top:0;height:100vh;padding:0 0 28px}
.main{overflow-y:auto;padding:36px 48px;width:100%}
.side-hdr{padding:18px 16px 12px;border-bottom:1px solid var(--border);margin-bottom:8px}
.side-hdr .logo{font-weight:700;font-size:14px}.side-hdr .logo span{color:var(--accent)}
.side-hdr .ver{font-size:11px;color:var(--text2);background:var(--bg3);border:1px solid var(--border);border-radius:99px;padding:2px 8px;margin-left:6px}
.nav-group{margin:10px 0 2px;padding:0 16px;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--text2)}
.nav-item{display:flex;align-items:center;gap:6px;padding:6px 16px;font-size:13px;color:var(--text2);border-left:3px solid transparent;text-decoration:none;transition:background .1s}
.nav-item:hover,.nav-item.on{background:var(--bg3);color:var(--text);border-left-color:var(--accent)}
