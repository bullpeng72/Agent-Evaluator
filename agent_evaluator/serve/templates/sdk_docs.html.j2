<!-- ── TaskType ── -->
<section class="sec" id="task-type">
  <div class="sec-title">🏷️ TaskType</div>
  <div class="sec-sub">Task type Enum. Pass as a lowercase string to the <code>task_type=</code> parameter. Accuracy calculation strategy varies by type.</div>
  <div class="cls-card">
    <div class="cls-head"><span class="cls-name">TaskType</span><span class="kind en">enum</span><span class="cls-src">agent_evaluator.core.trackers.base</span></div>
    <div class="cls-body">
      <table class="mtable">
        <thead><tr><th>Enum Value</th><th>String</th><th>Accuracy Strategy</th><th>Use Case</th></tr></thead>
        <tbody>
          <tr><td><span class="p">TaskType.QA</span></td><td><code>"qa"</code></td><td>TokenOverlapF1(40%) + Jaccard(30%) + LCS(20%) + CharSim/Levenshtein(10%)</td><td>Q&amp;A, fact verification</td></tr>
          <tr><td><span class="p">TaskType.CODE_GENERATION</span></td><td><code>"code_generation"</code></td><td>AST comparison → normalized comparison</td><td>Code generation</td></tr>
          <tr><td><span class="p">TaskType.DATA_ANALYSIS</span></td><td><code>"data_analysis"</code></td><td>Numeric extraction + text similarity</td><td>Data analysis</td></tr>
          <tr><td><span class="p">TaskType.DOCUMENT_CREATION</span></td><td><code>"document_creation"</code></td><td>Text similarity + structure check</td><td>Document / report writing</td></tr>
          <tr><td><span class="p">TaskType.INFORMATION_RETRIEVAL</span></td><td><code>"information_retrieval"</code></td><td>Token F1 + Jaccard</td><td>Information retrieval, RAG</td></tr>
          <tr><td><span class="p">TaskType.REASONING</span></td><td><code>"reasoning"</code></td><td>Step consistency + conclusion matching</td><td>Reasoning, logic problems</td></tr>
          <tr><td><span class="p">TaskType.CREATIVE</span></td><td><code>"creative"</code></td><td>Diversity metric (inverse of similarity)</td><td>Creative writing</td></tr>
          <tr><td><span class="p">TaskType.CODING</span></td><td><code>"coding"</code></td><td>AST comparison → normalized comparison</td><td>Coding tasks</td></tr>
