        <div class="kpi-val" style="font-size:20px" x-text="(data.efficiency_metrics?.total_input_tokens||0)>0?((data.efficiency_metrics?.total_output_tokens||0)/(data.efficiency_metrics?.total_input_tokens||1)*100).toFixed(0)+'%':'-'"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
              <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <div style="padding:10px 14px;background:var(--bg)">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">토큰 많은 태스크</span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,data).length+'건'"></span>
            </div>
            <div class="dtx" style="max-height:200px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:170px minmax(0,1fr) 100px 68px;position:sticky;top:0;z-index:1">
                <span>태스크 ID</span><span>총 토큰</span><span>유형</span><span>완료율</span>
              </div>
              <template x-for="t in items(selK,data)" :key="t.task_id">
                <div class="dtx-row" style="grid-template-columns:170px minmax(0,1fr) 100px 68px">
                  <span class="dtx-id" x-text="t.task_id"></span>
                  <span x-text="_fmtNumG(t.tokens_used?.total||t.tokens_used||0)"></span>
                  <span style="font-size:11px;color:var(--text2)" x-text="t.task_type||'-'"></span>
                  <span :style="`color:${(t.completion_score||0)>=1?'var(--green)':(t.completion_score||0)>=0.7?'var(--yellow)':'var(--red)'}`"
                        x-text="((t.completion_score||0)*100).toFixed(0)+'%'"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cg3" style="margin-top:8px">
      <div class="cbox"><div class="ct">태스크별 토큰</div><div id="d2-p-tok-bar" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">입출력 비율</div><div id="d2-p-tok-ratio" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">토큰 분포</div><div id="d2-p-tok-hist" class="plt-chart"></div></div>
    </div>
  </div>

  <!-- Cost subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">💰 비용 분석</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      total_cost:{label:'총 비용',unit:'$',desc:'이번 평가에서 발생한 LLM API 사용 비용의 추정값입니다. 운영 예산 계획과 모델 선택 시 비용-성능 트레이드오프 분석에 활용됩니다. 실제 청구액과 다를 수 있습니다.',hint:'Σ(input_tokens × input_price + output_tokens × output_price)'},
      input_cost:{label:'Input 비용',unit:'$',desc:'프롬프트·컨텍스트 입력 처리에 발생한 추정 비용입니다. 프롬프트 최적화나 RAG 컨텍스트 길이 조정을 통해 절감할 수 있는 비용 항목입니다.',hint:'Σ(input_tokens × input_price_per_token)'},
      output_cost:{label:'Output 비용',unit:'$',desc:'에이전트의 응답 생성에 발생한 추정 비용입니다. 일반적으로 입력보다 단가가 높아 전체 비용에서 큰 비중을 차지합니다. 응답 길이 제한 전략으로 절감이 가능합니다.',hint:'Σ(output_tokens × output_price_per_token)'},
      avg_cost:{label:'태스크당 평균',unit:'$',desc:'태스크 1건을 처리하는 평균 비용입니다. 서비스 규모 확장 시 비용 예측의 기준값으로, 모델 교체나 프롬프트 최적화 효과를 수치로 확인하는 핵심 단위입니다.',hint:'total_cost / total_tasks'},
      monthly_est:{label:'월간 추정',unit:'$',desc:'현재 비용 구조로 1,000건을 처리할 경우의 추정 비용입니다. 실제 서비스 운영 시 API 비용을 가늠하는 기준으로 활용됩니다. 실제 청구액은 할인·캐싱·배치 처리 등에 따라 달라질 수 있습니다.',hint:'(total_cost / total_tasks) × 1000'},
    },
    formula(k,d){
      const em=d.efficiency_metrics||{};
      const tot=em.tokens?.total_cost||em.total_cost||0;
      const n=d.total_tasks||1;
      if(k==='total_cost')return `총 비용 = $${tot.toFixed(4)}\n≈ ${_fmtNumG(Math.round(tot*1000000))} μ$`;
      if(k==='input_cost')return `입력 비용 = $${(em.tokens?.input_cost||em.input_cost||0).toFixed(4)}`;
      if(k==='output_cost')return `출력 비용 = $${(em.tokens?.output_cost||em.output_cost||0).toFixed(4)}`;
      if(k==='avg_cost')return `태스크당 = $${(tot/n).toFixed(5)}\n= $${tot.toFixed(4)} / ${n}`;
      if(k==='monthly_est')return `월간 추정 = (비용/태스크) × 1000\n= $${(tot/n).toFixed(5)} × 1000 = $${(tot/n*1000).toFixed(2)}`;
      return '';
    },
    items(k,d){
      return [...(d.tasks||[])].sort((a,b)=>(b.tokens_used?.total||b.tokens_used||0)-(a.tokens_used?.total||a.tokens_used||0)).slice(0,20);
    },
    filterLabel(k){return '토큰 많은 태스크 Top20 (비용 추정)';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='total_cost'}" @click="selK=selK==='total_cost'?null:'total_cost'">
        <div class="kpi-lbl">총 비용</div>
        <div class="kpi-val" x-text="_fmtCostG(data.efficiency_metrics?.tokens?.total_cost||data.efficiency_metrics?.total_cost||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='input_cost'}" @click="selK=selK==='input_cost'?null:'input_cost'">
        <div class="kpi-lbl">Input 비용</div>
        <div class="kpi-val" x-text="_fmtCostG(data.efficiency_metrics?.tokens?.input_cost||data.efficiency_metrics?.input_cost||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='output_cost'}" @click="selK=selK==='output_cost'?null:'output_cost'">
        <div class="kpi-lbl">Output 비용</div>
        <div class="kpi-val" x-text="_fmtCostG(data.efficiency_metrics?.tokens?.output_cost||data.efficiency_metrics?.output_cost||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='avg_cost'}" @click="selK=selK==='avg_cost'?null:'avg_cost'">
        <div class="kpi-lbl">태스크당 평균</div>
        <div class="kpi-val" x-text="_fmtCostG((data.efficiency_metrics?.tokens?.total_cost||data.efficiency_metrics?.total_cost||0)/(data.total_tasks||1))"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='monthly_est'}" @click="selK=selK==='monthly_est'?null:'monthly_est'">
        <div class="kpi-lbl">월간 추정 (×1K)</div>
        <div class="kpi-val" x-text="_fmtCostG((data.efficiency_metrics?.tokens?.total_cost||data.efficiency_metrics?.total_cost||0)/(data.total_tasks||1)*1000)"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
              <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cbox" style="margin-top:8px">
      <div class="ct">태스크별 비용 (토큰 비례 추정)</div>
      <div id="d2-p-cost-bar" class="plt-chart"></div>
    </div>
    <div class="sec" style="margin-top:12px">
      <div class="sec-t">모델별 가격 정보</div>
      <div class="dtx">
        <div class="dtx-row dtx-head" style="grid-template-columns:1fr 90px 90px">
          <span>모델</span><span>입력($/1M)</span><span>출력($/1M)</span>
        </div>
        <template x-for="(v,k) in (data.pricing||{})" :key="k">
          <div class="dtx-row" style="grid-template-columns:1fr 90px 90px">
            <span class="dtx-id" x-text="k"></span>
            <span x-text="v.input_cost_per_1m!=null?'$'+v.input_cost_per_1m.toFixed(2):'-'"></span>
            <span x-text="v.output_cost_per_1m!=null?'$'+v.output_cost_per_1m.toFixed(2):'-'"></span>
          </div>
        </template>
        <div class="dtx-empty" x-show="!data.pricing||Object.keys(data.pricing||{}).length===0">가격 정보 없음</div>
      </div>
    </div>
  </div>

</div><!-- /performance -->

<!-- ══ SECTION 5: AGENTIC ══ -->
<div x-show="data && sec==='agentic'" x-cloak>
  <div x-show="!data.has_agentic" class="es">
    <div class="es-icon">🤖</div>
    <div class="es-title">에이전틱 지표 없음</div>
    <div class="es-desc"><code>PerformanceMonitor(enable_agentic=True)</code>으로 활성화하세요.</div>
  </div>
  <div x-show="data.has_agentic">

  <!-- Tool Efficiency subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔧 도구 효율성</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      total_calls:{label:'총 호출',unit:'건',desc:'이번 평가에서 에이전트가 실행한 전체 도구 호출 수입니다. 도구 사용 빈도와 에이전트의 도구 의존도를 파악하는 기본 지표이며, 태스크당 평균 호출 수와 함께 해석해야 합니다.',hint:'tool_call_executions.total_calls'},
      success_rate:{label:'성공률',unit:'%',desc:'실행된 도구 호출 중 정상적으로 결과를 반환한 비율입니다. 낮으면 도구 설정 문제, 잘못된 파라미터 사용, 또는 에이전트의 도구 사용 오류가 많음을 시사합니다.',hint:'successful_calls / total_calls × 100'},
      avg_efficiency:{label:'평균 효율성',unit:'',desc:'에이전트가 불필요한 중복·실패 없이 얼마나 효율적으로 도구를 사용하는지를 나타내는 종합 점수(0~1)입니다. 1에 가까울수록 최소한의 호출로 목적을 달성함을 의미합니다.',hint:'avg(tool_efficiency_score per task)'},
      redundancy_rate:{label:'중복 호출률',unit:'%',desc:'동일하거나 불필요하게 반복된 도구 호출의 비율입니다. 높으면 에이전트가 결과를 확인하지 않고 같은 도구를 반복 호출하거나, 전략 없이 시행착오를 반복하고 있음을 시사합니다.',hint:'redundant_calls / total_calls × 100'},
      failure_rate:{label:'실패율',unit:'%',desc:'실행된 도구 호출 중 오류나 예외를 반환한 비율입니다. 높으면 도구 파라미터 생성 오류, 입력 유효성 문제, 또는 에이전트가 사용 불가능한 도구를 호출하고 있음을 나타냅니다.',hint:'failed_calls / total_calls × 100'},
      avg_per_task:{label:'태스크당 평균',unit:'건',desc:'하나의 태스크를 완료하기 위해 평균적으로 호출하는 도구 수입니다. 지나치게 많으면 비효율적인 계획 수립이나 불필요한 탐색을, 적으면 단순한 태스크 또는 도구 미활용을 의미합니다.',hint:'total_calls / total_tasks'},
    },
    formula(k,d){
      const te=d.agentic?.tool_efficiency||{};
      const tce=d.agentic?.tool_call_executions||{};
      if(k==='total_calls')return `총 호출 = ${tce.total_calls||0}건`;
      if(k==='success_rate')return `성공률 = successful/total×100\n= ${(te.success_rate||0).toFixed(1)}%`;
      if(k==='avg_efficiency')return `효율성 = avg(효율 점수)\n= ${(te.avg_efficiency_score||0).toFixed(3)}`;
      if(k==='redundancy_rate')return `중복률 = redundant/total×100\n= ${(te.redundancy_rate||0).toFixed(1)}%`;
      if(k==='failure_rate')return `실패율 = failed/total×100\n= ${(te.failure_rate||0).toFixed(1)}%`;
      if(k==='avg_per_task')return `태스크당 = total/${d.total_tasks||1}\n= ${(te.avg_calls_per_task||0).toFixed(1)}건`;
      return '';
    },
    items(k,d){ return d.agentic?.tool_call_executions?.per_task||d.tasks||[]; },
    filterLabel(k){return '태스크별 도구 호출 상세';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='total_calls'}" @click="selK=selK==='total_calls'?null:'total_calls'">
        <div class="kpi-lbl">총 도구 호출</div>
        <div class="kpi-val" x-text="data.agentic?.tool_efficiency?.total_calls||0"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='success_rate'}" @click="selK=selK==='success_rate'?null:'success_rate'">
        <div class="kpi-lbl">성공률</div>
        <div class="kpi-val" :style="`color:${_bc(data.agentic?.tool_efficiency?.success_rate||0,90,70)}`"
             x-text="(data.agentic?.tool_efficiency?.success_rate||0).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='avg_efficiency'}" @click="selK=selK==='avg_efficiency'?null:'avg_efficiency'">
        <div class="kpi-lbl">평균 효율성</div>
        <div class="kpi-val" x-text="(data.agentic?.tool_efficiency?.avg_efficiency_score||0).toFixed(3)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='redundancy_rate'}" @click="selK=selK==='redundancy_rate'?null:'redundancy_rate'">
        <div class="kpi-lbl">중복 호출률</div>
        <div class="kpi-val" style="color:var(--yellow)" x-text="(data.agentic?.tool_efficiency?.redundancy_rate||0).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='failure_rate'}" @click="selK=selK==='failure_rate'?null:'failure_rate'">
        <div class="kpi-lbl">실패율</div>
        <div class="kpi-val" style="color:var(--red)" x-text="(data.agentic?.tool_efficiency?.failure_rate||0).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='avg_per_task'}" @click="selK=selK==='avg_per_task'?null:'avg_per_task'">
        <div class="kpi-lbl">태스크당 평균</div>
        <div class="kpi-val" x-text="(data.agentic?.tool_efficiency?.avg_calls_per_task||0).toFixed(1)"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
              <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cg" style="margin-top:8px">
      <div class="cbox"><div class="ct">도구별 사용 빈도</div><div id="d2-ag-tool-pie" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">효율성 지표 요약</div><div id="d2-ag-teff-bar" class="plt-chart"></div></div>
    </div>
  </div>

  <!-- Tool Selection subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🎯 도구 선택 정확도</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      precision:{label:'Precision',unit:'',desc:'에이전트가 선택한 도구 중 실제로 필요했던 도구의 비율입니다. 낮으면 불필요한 도구를 자주 포함하는 경향이 있어 실행 비용과 오류 가능성이 증가합니다.',hint:'TP / (TP + FP)'},
      recall:{label:'Recall',unit:'',desc:'태스크 수행에 필요한 도구 중 에이전트가 실제로 선택한 도구의 비율입니다. 낮으면 필요한 도구를 놓쳐 태스크를 불완전하게 수행할 가능성이 높아집니다.',hint:'TP / (TP + FN)'},
      f1:{label:'F1 Score',unit:'',desc:'도구 선택의 Precision과 Recall을 균형 있게 종합한 지표입니다. 도구를 정확히 선택하면서도 필요한 것을 빠뜨리지 않는 능력을 단일 수치로 나타내며, 도구 사용 능력의 대표 지표입니다.',hint:'2 × Precision × Recall / (Precision + Recall)'},
      accuracy:{label:'Accuracy',unit:'',desc:'예상 도구 집합과 실제 선택된 도구 집합이 얼마나 일치하는지를 나타내는 전반적 선택 정확도입니다. 태스크에 적합한 도구를 파악하는 에이전트의 도메인 이해 능력을 평가합니다.',hint:'correct_selections / total_selections'},
      total:{label:'평가 태스크',unit:'건',desc:'도구 선택 정확도 평가가 수행된 태스크 수입니다. expected_tools(예상 도구 목록)가 제공된 태스크에서만 측정되므로, 전체 태스크 수와 다를 수 있습니다.',hint:'tool_selection_summary.total_selections'},
    },
    formula(k,d){
      const ts=d.agentic?.tool_selection_summary||d.agentic?.tool_efficiency||{};
      if(k==='precision')return `Precision = TP/(TP+FP)\n= ${(ts.avg_precision||ts.tool_selection_precision||0).toFixed(3)}`;
      if(k==='recall')return `Recall = TP/(TP+FN)\n= ${(ts.avg_recall||ts.tool_selection_recall||0).toFixed(3)}`;
      if(k==='f1')return `F1 = 2×P×R/(P+R)\n= ${(ts.avg_f1_score||ts.tool_selection_f1||0).toFixed(3)}`;
      if(k==='accuracy')return `Accuracy = correct/total\n= ${(ts.avg_accuracy||0).toFixed(3)}`;
      if(k==='total')return `평가 태스크 = ${ts.total_selections||(d.agentic?.tool_selections||[]).length}건`;
      return '';
    },
    items(k,d){ return [...(d.agentic?.tool_selections||[])].sort((a,b)=>(b.f1_score||0)-(a.f1_score||0)); },
    filterLabel(k){return 'F1 내림차순';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='precision'}" @click="selK=selK==='precision'?null:'precision'">
        <div class="kpi-lbl">Precision</div>
        <div class="kpi-val" x-text="(data.agentic?.tool_selection_summary?.avg_precision||data.agentic?.tool_efficiency?.tool_selection_precision||0).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='recall'}" @click="selK=selK==='recall'?null:'recall'">
        <div class="kpi-lbl">Recall</div>
        <div class="kpi-val" x-text="(data.agentic?.tool_selection_summary?.avg_recall||data.agentic?.tool_efficiency?.tool_selection_recall||0).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='f1'}" @click="selK=selK==='f1'?null:'f1'">
        <div class="kpi-lbl">F1 Score</div>
        <div class="kpi-val" :style="`color:${_bc(data.agentic?.tool_selection_summary?.avg_f1_score||data.agentic?.tool_efficiency?.tool_selection_f1||0,90,70)}`"
             x-text="(data.agentic?.tool_selection_summary?.avg_f1_score||data.agentic?.tool_efficiency?.tool_selection_f1||0).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='accuracy'}" @click="selK=selK==='accuracy'?null:'accuracy'">
        <div class="kpi-lbl">Accuracy</div>
        <div class="kpi-val" :style="`color:${_bc(data.agentic?.tool_selection_summary?.avg_accuracy||0,90,70)}`"
             x-text="(data.agentic?.tool_selection_summary?.avg_accuracy||0).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='total'}" @click="selK=selK==='total'?null:'total'">
        <div class="kpi-lbl">평가 태스크</div>
        <div class="kpi-val" x-text="(data.agentic?.tool_selections||[]).length"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
              <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <div style="padding:10px 14px;background:var(--bg)">
            <div class="dtx" style="max-height:200px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:minmax(120px,1fr) 68px 68px 68px;position:sticky;top:0;z-index:1">
                <span>태스크 ID</span><span>Prec.</span><span>Recall</span><span>F1</span>
              </div>
              <template x-for="s in items(selK,data)" :key="s.task_id">
                <div class="dtx-row" style="grid-template-columns:minmax(120px,1fr) 68px 68px 68px">
                  <span class="dtx-id" x-text="s.task_id"></span>
                  <span x-text="(s.precision||0).toFixed(2)"></span>
                  <span x-text="(s.recall||0).toFixed(2)"></span>
                  <span :style="`color:${_bc((s.f1_score||0)*100,80,60)}`" x-text="(s.f1_score||0).toFixed(2)"></span>
