               x-text="gA.details?.avg_accuracy!=null?((gA.details.avg_accuracy)*100).toFixed(1)+'%':'—'"></div>
        </div>
        <!-- IFR (Instruction Adherence) — InstructionConfig 사용 시에만 -->
        <div class="kpi kpi-act" :class="{sel:selK==='avg_instruction_adherence'}" @click="selK=selK==='avg_instruction_adherence'?null:'avg_instruction_adherence'" x-show="gA.details && gA.details.avg_instruction_adherence!=null">
          <div class="kpi-lbl">Instruction Follow Rate (IFR)</div>
          <div class="kpi-val"
               :style="`color:${(gA.details?.avg_instruction_adherence||0)>=0.8?'var(--green)':(gA.details?.avg_instruction_adherence||0)>=0.6?'var(--yellow)':'var(--red)'}`"
               x-text="gA.details?.avg_instruction_adherence!=null?((gA.details.avg_instruction_adherence)*100).toFixed(1)+'%':'—'"></div>
          <div class="kpi-sub" x-text="gA.details?.tasks_with_ifr ? gA.details.tasks_with_ifr+' measured' : ''"></div>
        </div>
        <!-- 목표 정렬 — GoalAlignmentConfig -->
        <div class="kpi kpi-act" :class="{sel:selK==='avg_goal_alignment'}" @click="selK=selK==='avg_goal_alignment'?null:'avg_goal_alignment'" x-show="gA.details && gA.details.avg_goal_alignment!=null">
          <div class="kpi-lbl">Goal Alignment</div>
          <div class="kpi-val"
               :style="`color:${(gA.details?.avg_goal_alignment||0)>=0.8?'var(--green)':(gA.details?.avg_goal_alignment||0)>=0.6?'var(--yellow)':'var(--red)'}`"
               x-text="gA.details?.avg_goal_alignment!=null?((gA.details.avg_goal_alignment)*100).toFixed(1)+'%':'—'"></div>
        </div>
        <!-- 계획 일관성 — PlanConfig -->
        <div class="kpi kpi-act" :class="{sel:selK==='avg_plan_coherence'}" @click="selK=selK==='avg_plan_coherence'?null:'avg_plan_coherence'" x-show="gA.details && gA.details.avg_plan_coherence!=null">
          <div class="kpi-lbl">Plan Coherence</div>
          <div class="kpi-val"
               :style="`color:${(gA.details?.avg_plan_coherence||0)>=0.8?'var(--green)':(gA.details?.avg_plan_coherence||0)>=0.6?'var(--yellow)':'var(--red)'}`"
               x-text="gA.details?.avg_plan_coherence!=null?((gA.details.avg_plan_coherence)*100).toFixed(1)+'%':'—'"></div>
        </div>
        <!-- 서브태스크 완료 — SubtaskConfig -->
        <div class="kpi kpi-act" :class="{sel:selK==='avg_subtask_completion'}" @click="selK=selK==='avg_subtask_completion'?null:'avg_subtask_completion'" x-show="gA.details && gA.details.avg_subtask_completion!=null">
          <div class="kpi-lbl">Subtask Completion</div>
          <div class="kpi-val"
               :style="`color:${(gA.details?.avg_subtask_completion||0)>=0.8?'var(--green)':(gA.details?.avg_subtask_completion||0)>=0.6?'var(--yellow)':'var(--red)'}`"
               x-text="gA.details?.avg_subtask_completion!=null?((gA.details.avg_subtask_completion)*100).toFixed(1)+'%':'—'"></div>
        </div>
        <!-- 컨텍스트 유지 — ContextRetentionConfig -->
        <div class="kpi kpi-act" :class="{sel:selK==='avg_context_retention'}" @click="selK=selK==='avg_context_retention'?null:'avg_context_retention'" x-show="gA.details && gA.details.avg_context_retention!=null">
          <div class="kpi-lbl">Context Retention</div>
          <div class="kpi-val"
               :style="`color:${(gA.details?.avg_context_retention||0)>=0.8?'var(--green)':(gA.details?.avg_context_retention||0)>=0.6?'var(--yellow)':'var(--red)'}`"
               x-text="gA.details?.avg_context_retention!=null?((gA.details.avg_context_retention)*100).toFixed(1)+'%':'—'"></div>
        </div>
        <!-- 지식 유지 — KnowledgeRetentionConfig -->
        <div class="kpi kpi-act" :class="{sel:selK==='avg_knowledge_retention'}" @click="selK=selK==='avg_knowledge_retention'?null:'avg_knowledge_retention'" x-show="gA.details && gA.details.avg_knowledge_retention!=null">
          <div class="kpi-lbl">Knowledge Retention</div>
          <div class="kpi-val"
               :style="`color:${(gA.details?.avg_knowledge_retention||0)>=0.8?'var(--green)':(gA.details?.avg_knowledge_retention||0)>=0.6?'var(--yellow)':'var(--red)'}`"
               x-text="gA.details?.avg_knowledge_retention!=null?((gA.details.avg_knowledge_retention)*100).toFixed(1)+'%':'—'"></div>
        </div>
      </div>
      <div x-show="selK" style="margin-top:10px;padding:12px 14px;background:var(--bg2);border:1px solid var(--border);border-radius:8px">
        <template x-if="selK">
          <div>
            <div style="font-weight:600;font-size:13px;margin-bottom:8px;color:var(--text1)" x-text="meta[selK]?.label||selK"></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:8px">
              <div style="font-size:12px;line-height:1.6;padding:8px 10px;background:var(--bg3);border-radius:6px" x-text="meta[selK]?.desc||''"></div>
              <div style="font-size:11.5px;font-family:monospace;white-space:pre-wrap;padding:8px 10px;background:var(--bg);border:1px solid var(--border);border-radius:6px" x-text="formula(selK,data)"></div>
            </div>
            <div style="font-size:11px;color:var(--text2);padding:6px 10px;background:var(--bg);border-radius:4px" x-text="meta[selK]?.hint||''"></div>
              <!-- 관련 태스크 -->
              <div style="margin-top:10px;border-top:1px solid var(--border);padding-top:8px">
                <div style="display:flex;align-items:center;gap:6px;margin-bottom:6px">
                  <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">Related Tasks</span>
                  <span style="font-size:11px;color:var(--text2)" x-text="(data.tasks||[]).length+' tasks'"></span>
                </div>
                <div x-show="!(data.tasks||[]).length" style="font-size:11px;color:var(--text2);text-align:center;padding:10px">
                  Load an evaluation result file to display the task list.
                </div>
                <div class="dtx" style="max-height:180px;overflow-y:auto" x-show="(data.tasks||[]).length">
                  <div class="dtx-row dtx-head" style="grid-template-columns:minmax(100px,1.5fr) 80px 70px 50px;position:sticky;top:0;z-index:1">
                    <span>Task ID</span><span>Type</span><span>Completion</span><span>Status</span>
                  </div>
                  <template x-for="t in [...(data.tasks||[])].sort((a,b)=>(a.completion_score||0)-(b.completion_score||0)).slice(0,20)" :key="t.task_id">
                    <div class="dtx-row" style="grid-template-columns:minmax(100px,1.5fr) 80px 70px 50px">
                      <span class="dtx-id" x-text="t.task_id"></span>
                      <span class="text-muted" x-text="t.task_type||'-'"></span>
                      <span :style="`color:${(t.completion_score||0)>=0.9?'var(--green)':(t.completion_score||0)>=0.7?'var(--yellow)':'var(--red)'}`"
                            x-text="((t.completion_score||0)*100).toFixed(0)+'%'"></span>
                      <span :class="(t.completion_score||0)>=1?'badge-ok':(t.completion_score||0)>=0.7?'badge-warn':'badge-ng'"
                            x-text="(t.completion_score||0)>=1?'Done':(t.completion_score||0)>=0.7?'Partial':'Fail'"></span>
                    </div>
                  </template>
                </div>
              </div>
          </div>
        </template>
      </div>
