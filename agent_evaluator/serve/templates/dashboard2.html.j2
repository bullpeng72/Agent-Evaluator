<!DOCTYPE html>
<html lang="ko" x-data="app2()" x-init="init()" :class="{'dark':dark}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>{{ title }} — Dev Dashboard</title>
{% if offline %}
<script defer src="/static/alpine.min.js"></script>
<script src="/static/plotly.min.js"></script>
{% else %}
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/plotly.js-dist@2.35.2/plotly.min.js"></script>
{% endif %}
<style>
:root{
  --bg:#0f1117;--bg2:#1a1d27;--bg3:#22263a;--border:#2d3148;
  --text:#e2e4f0;--text2:#8890b0;--accent:#6c8ef5;
  --green:#4ade80;--yellow:#facc15;--red:#f87171;--orange:#fb923c;--r:10px;
  --sp-1:4px;--sp-2:8px;--sp-3:12px;--sp-4:16px;--sp-5:24px;--sp-6:32px;
  --fs-xs:11px;--fs-sm:12px;--fs-md:13px;--fs-lg:15px;--fs-xl:22px;--fs-2xl:28px;
  --c-ok:var(--green);--c-warn:var(--yellow);--c-ng:var(--red);--c-info:var(--accent);
}
html:not(.dark){
  --bg:#f4f6fc;--bg2:#fff;--bg3:#eef0f8;--border:#d1d5e8;
  --text:#1a1d2e;--text2:#5a6080;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);font-size:14px}
.layout{display:grid;grid-template-rows:52px 1fr 28px;height:100vh}
.hdr{background:var(--bg2);border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;padding:0 14px;position:sticky;top:0;z-index:100}
.body{display:grid;grid-template-columns:190px 1fr;overflow:hidden}
.side{background:var(--bg2);border-right:1px solid var(--border);overflow-y:auto;padding:8px 0}
.main{overflow-y:auto;padding:16px}
.sbar{background:var(--bg2);border-top:1px solid var(--border);display:flex;align-items:center;gap:12px;padding:0 14px;font-size:13px;color:var(--text2)}
.logo{font-weight:700;font-size:16px;white-space:nowrap}.logo span{color:var(--accent)}
select{background:var(--bg3);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:3px 7px;font-size:13px;max-width:240px}
.btn{background:var(--bg3);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:4px 9px;font-size:13px;cursor:pointer;white-space:nowrap;text-decoration:none;display:inline-flex;align-items:center;gap:4px}
.btn:hover,.btn.active{background:var(--accent);color:#fff;border-color:var(--accent)}
.sp{flex:1}
.dot{width:7px;height:7px;border-radius:50%;background:var(--green);display:inline-block}
.dot.off{background:var(--text2)}.dot.live{animation:pulse 1.5s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
.nav{display:flex;align-items:center;gap:7px;padding:7px 13px;cursor:pointer;font-size:13px;color:var(--text2);border-left:3px solid transparent}
.nav:hover,.nav.on{background:var(--bg3);color:var(--text);border-left-color:var(--accent)}
.nav-badge{margin-left:auto;background:var(--bg);border-radius:99px;font-size:11px;padding:1px 5px;color:var(--text2)}
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-bottom:14px}
.kpi{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:12px 14px;transition:border-color .15s,background .15s}
.kpi:hover{border-color:var(--accent)}
.kpi.sel{border-color:var(--accent);background:var(--bg3)}
.kpi-act{cursor:pointer;border-left:3px solid var(--accent);padding-left:12px}
.kpi-act::after{content:'▾ 상세';display:block;font-size:10px;color:var(--accent);text-align:right;margin-top:4px;opacity:.45;transition:opacity .15s}
.kpi-act:hover::after,.kpi-act.sel::after{opacity:1}
.kpi-lbl{font-size:12px;color:var(--text2);text-transform:uppercase;letter-spacing:.04em}
.kpi-val{font-size:26px;font-weight:800;margin:3px 0}
.kpi-sub{font-size:12px}.kpi-sub.ok{color:var(--green)}.kpi-sub.warn{color:var(--yellow)}
.dgate{display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap}
.dgate-box{flex:1;min-width:150px;background:var(--bg2);border:2px solid var(--border);border-radius:var(--r);padding:12px;transition:border-color .15s}
.dgate-box.pass{border-color:var(--green)}.dgate-box.partial{border-color:var(--yellow)}.dgate-box.fail{border-color:var(--red)}
.dgate-title{font-size:14px;font-weight:700;margin-bottom:6px;display:flex;align-items:center;justify-content:space-between}
.dgate-badge{font-size:12px;padding:1px 6px;border-radius:99px;font-weight:600}
.dgate-box.pass .dgate-badge{background:#4ade8022;color:var(--green)}.dgate-box.partial .dgate-badge{background:#facc1522;color:var(--yellow)}.dgate-box.fail .dgate-badge{background:#f8717122;color:var(--red)}
.dgate-row{font-size:12px;color:var(--text2);display:flex;align-items:center;gap:5px;padding:2px 0}
.dgate-row .dv{margin-left:auto;font-size:11px;opacity:.7}
.sec{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:14px;margin-bottom:12px}
.sec-t{font-size:15px;font-weight:600;margin-bottom:10px;display:flex;align-items:center;gap:6px}
.cg{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.cg3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
.cg4{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:10px}
.cg>*,.cg3>*,.cg4>*{min-width:0;overflow:hidden}
.cbox{background:var(--bg3);border-radius:8px;padding:10px;overflow:hidden;min-width:0}
.plt-chart{height:200px;min-width:0;width:100%}
.ct{font-size:13px;color:var(--text2);margin-bottom:6px}
.alert{border-radius:8px;padding:10px 12px;margin-bottom:8px;border-left:3px solid}
.alert.critical{background:rgba(248,113,113,.1);border-color:var(--red)}
.alert.high{background:rgba(251,146,60,.1);border-color:var(--orange)}
.alert.medium{background:rgba(250,204,21,.1);border-color:var(--yellow)}
.alert.low{background:rgba(74,222,128,.1);border-color:var(--green)}
.alert-t{font-size:14px;font-weight:600;margin-bottom:3px}
.alert-b{font-size:13px;color:var(--text2)}
.rec{background:var(--bg3);border-radius:8px;padding:10px 12px;margin-bottom:8px}
.rec-t{font-size:14px;font-weight:600;margin-bottom:4px}
.rec-b{font-size:13px;color:var(--text2)}
.drow{display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid var(--border);font-size:14px}
.drow:last-child{border-bottom:none}
.dk{color:var(--text2)}
.slist{max-height:300px;overflow-y:auto}
.es{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:var(--sp-6);color:var(--text2);text-align:center;gap:var(--sp-2)}
.es-icon{font-size:28px}.es-title{font-size:var(--fs-md);font-weight:600}
.es-desc{font-size:var(--fs-sm)}.es-desc code{background:var(--bg3);padding:1px 5px;border-radius:4px;font-size:var(--fs-xs)}
.dtx{border:1px solid var(--border);border-radius:var(--r);overflow:hidden;font-size:var(--fs-sm)}
.dtx-row{display:grid;gap:0 8px;padding:5px var(--sp-3);border-bottom:1px solid var(--border);align-items:center}
.dtx-head{font-weight:600;color:var(--text2);background:var(--bg3);font-size:var(--fs-xs);text-transform:uppercase;letter-spacing:.05em}
.dtx-row:not(.dtx-head):hover{background:var(--bg3)}
.dtx-id{font-family:monospace;font-size:var(--fs-xs);color:var(--accent);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dtx-empty{padding:var(--sp-5);text-align:center;color:var(--text2);font-size:var(--fs-sm)}
.badge-ok{background:rgba(74,222,128,.12);color:var(--green);border-radius:99px;font-size:var(--fs-xs);font-weight:600;padding:1px 7px;display:inline-block}
.badge-warn{background:rgba(250,204,21,.12);color:var(--yellow);border-radius:99px;font-size:var(--fs-xs);font-weight:600;padding:1px 7px;display:inline-block}
.badge-ng{background:rgba(248,113,113,.12);color:var(--red);border-radius:99px;font-size:var(--fs-xs);font-weight:600;padding:1px 7px;display:inline-block}
.badge-info{background:rgba(108,142,245,.12);color:var(--accent);border-radius:99px;font-size:var(--fs-xs);font-weight:600;padding:1px 7px;display:inline-block}
.badge-gray{background:var(--bg3);color:var(--text2);border-radius:99px;font-size:var(--fs-xs);padding:1px 7px;display:inline-block}
.pill{display:inline-flex;align-items:center;gap:3px;font-size:var(--fs-xs);border-radius:99px;padding:2px 7px;font-weight:600}
.pg{background:rgba(74,222,128,.12);color:var(--green);border-radius:99px;font-size:var(--fs-xs);font-weight:600;padding:1px 7px;display:inline-flex;align-items:center;gap:3px}
.py{background:rgba(250,204,21,.12);color:var(--yellow);border-radius:99px;font-size:var(--fs-xs);font-weight:600;padding:1px 7px;display:inline-flex;align-items:center;gap:3px}
.pr{background:rgba(248,113,113,.12);color:var(--red);border-radius:99px;font-size:var(--fs-xs);font-weight:600;padding:1px 7px;display:inline-flex;align-items:center;gap:3px}
.rg{margin:8px 0}
.rgt{background:var(--bg3);border-radius:99px;height:14px;overflow:hidden;margin-bottom:3px}
.rgf{height:100%;border-radius:99px;transition:width .4s}
.pscore-bar{height:6px;border-radius:3px;background:var(--bg3);overflow:hidden;min-width:80px}
.pscore-fill{height:100%;border-radius:3px;background:var(--yellow);transition:width .3s}
.pscore-fill.strong{background:var(--green)}.pscore-fill.weak{background:var(--orange)}
.sdiv{display:flex;align-items:center;gap:10px;margin:20px 0 14px;user-select:none}
.sdiv-line{flex:1;height:1px;background:var(--border)}
.sdiv-lbl{font-size:11px;font-weight:700;color:var(--text2);white-space:nowrap;letter-spacing:.06em;background:var(--bg3);border:1px solid var(--border);border-radius:99px;padding:2px 10px}
.fbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:10px}
.fbar label{font-size:13px;color:var(--text2)}
input[type=text],input[type=number]{background:var(--bg3);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:3px 7px;font-size:13px}
.dt-card{width:100%;border-collapse:collapse;font-size:13px}
.dt-card thead tr{background:var(--bg3);color:var(--text2);font-weight:600}
.dt-card th,.dt-card td{padding:6px 10px;border-bottom:1px solid var(--border);text-align:left}
.dt-card th:not(:first-child),.dt-card td:not(:first-child){text-align:right}
[x-cloak]{display:none!important}
@media(max-width:768px){.body{grid-template-columns:1fr}.side{display:none}.cg,.cg3,.cg4{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="layout">

<!-- HEADER -->
<header class="hdr">
  <div class="logo">🤖 <span>Agent</span> Evaluator <span style="font-size:11px;color:var(--text2);font-weight:400;margin-left:4px">Dev</span></div>
  <select x-model="selId" @change="loadFile(selId)" style="flex:0 1 260px">
    <option value="">— 파일 선택 —</option>
    <template x-for="f in files" :key="f.id">
      <option :value="f.id" x-text="`${f.name.substring(0,36)} (${f.total_tasks}t)`"></option>
    </template>
  </select>
  <button class="btn" @click="refresh()" title="새로고침">🔄</button>
  <a class="btn" href="/" target="_blank">Main</a>
  <a class="btn" href="/api/docs" target="_blank">API</a>
  <a class="btn" href="/sdk-docs" target="_blank">SDK</a>
  <div class="sp"></div>
  {% if watch %}<span style="font-size:11px;color:var(--green);background:rgba(74,222,128,.1);padding:2px 8px;border-radius:99px;border:1px solid rgba(74,222,128,.3)">⚡ watch</span>{% endif %}
  <span class="dot" :class="{'live':connected,'off':!connected}"></span>
  <span x-text="connected?'Live':'Offline'" style="font-size:13px;color:var(--text2)"></span>
  <button class="btn" @click="dark=!dark" x-text="dark?'☀️':'🌙'"></button>
</header>

<!-- BODY -->
<div class="body">

<!-- Sidebar -->
<nav class="side">
  <template x-for="n in nav" :key="n.id">
    <div class="nav" :class="{on:sec===n.id}" @click="sec=n.id">
      <span x-text="n.icon"></span>
      <span x-text="n.label" style="flex:1;font-size:13px"></span>
      <span class="nav-badge" x-show="data && n.badge" x-text="data && n.badge ? n.badge(data) : ''"></span>
    </div>
  </template>
</nav>

<!-- Main -->
<main class="main">

<div x-show="!data && !loading" class="es">
  <div class="es-icon">📂</div>
  <div class="es-title">결과 파일을 선택하세요</div>
  <div class="es-desc" x-show="files.length===0" style="color:var(--red)">⚠️ 결과 디렉토리에 JSON 파일이 없습니다.</div>
  <div class="es-desc" x-show="files.length>0">상단 드롭다운에서 평가 결과 파일을 선택하세요.</div>
</div>
<div x-show="loading" class="es"><p>로딩 중…</p></div>

<!-- ══ SECTION 1: OVERVIEW ══ -->
<div x-show="data && sec==='overview'" x-cloak>

  <div x-data="{
    selK:null,
    meta:{
      total_tasks:{label:'총 태스크',unit:'건',desc:'평가에 포함된 전체 태스크 수',hint:'data.total_tasks'},
      tcr:{label:'TCR',unit:'%',desc:'태스크 완료율 — 완전/부분 성공 가중 합산',hint:'Σ completion_score / total × 100'},
      accuracy:{label:'정확도',unit:'%',desc:'전체 평균 정확도 (Token Overlap 40% + Jaccard 30% + LCS 20% + Char 10%)',hint:'avg(accuracy_score) × 100'},
      hallucination:{label:'환각률',unit:'%',desc:'환각 탐지 비율 (낮을수록 좋음)',hint:'flagged / evaluated × 100'},
      p95_latency:{label:'P95 지연',unit:'s',desc:'상위 5% 제외 최대 응답시간',hint:'efficiency_metrics.latency.p95'},
      total_cost:{label:'총 비용',unit:'$',desc:'전체 태스크의 추정 비용 합계',hint:'efficiency_metrics.tokens.total_cost'},
    },
    formula(k,d){
      const t=d.tasks||[],n=t.length||1;
      if(k==='total_tasks')return `총 태스크 = ${d.total_tasks||0}건`;
      if(k==='tcr'){const s=t.reduce((a,b)=>a+(b.completion_score||0),0);return `TCR = Σ completion_score / total\n= ${s.toFixed(2)} / ${n} = ${(s/n*100).toFixed(1)}%`;}
      if(k==='accuracy'){const s=t.reduce((a,b)=>a+(b.accuracy_score||0),0);return `Accuracy = avg(accuracy_score)\n= ${s.toFixed(2)} / ${n} = ${(s/n*100).toFixed(1)}%`;}
      if(k==='hallucination'){const ev=d.accuracy_metrics?.hallucination?.total_evaluated||0,fl=d.accuracy_metrics?.hallucination?.total_flagged||0;return `환각률 = flagged/evaluated×100\n= ${fl}/${ev} = ${ev?((fl/ev)*100).toFixed(1):0}%`;}
      if(k==='p95_latency')return `P95 = ${(d.efficiency_metrics?.latency?.p95||d.efficiency_metrics?.p95_latency||0).toFixed(3)}s\n상위 5% 제외 최대 응답시간`;
      if(k==='total_cost')return `총비용 = $${(d.efficiency_metrics?.tokens?.total_cost||d.efficiency_metrics?.total_cost||0).toFixed(4)}\n태스크당 $${((d.efficiency_metrics?.tokens?.total_cost||d.efficiency_metrics?.total_cost||0)/(d.total_tasks||1)).toFixed(5)}`;
      return '';
    },
    items(k,d){
      const t=d.tasks||[];
      if(k==='accuracy')return [...t].sort((a,b)=>(b.accuracy_score||0)-(a.accuracy_score||0));
      if(k==='hallucination')return t.filter(x=>(x.hallucination_detected||x.hallucination_score>0));
      if(k==='p95_latency')return [...t].sort((a,b)=>(b.execution_time||0)-(a.execution_time||0)).slice(0,20);
      if(k==='total_cost')return [...t].sort((a,b)=>(b.tokens_used?.total||b.tokens_used||0)-(a.tokens_used?.total||a.tokens_used||0)).slice(0,20);
      return t;
    },
    filterLabel(k){return {total_tasks:'전체',tcr:'전체',accuracy:'정확도 내림차순',hallucination:'환각 탐지건',p95_latency:'느린 태스크 Top20',total_cost:'토큰 많은 태스크 Top20'}[k]||'전체';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='total_tasks'}" @click="selK=selK==='total_tasks'?null:'total_tasks'">
        <div class="kpi-lbl">Total Tasks</div>
        <div class="kpi-val" x-text="data.total_tasks||0"></div>
        <div class="kpi-sub" style="color:var(--text2)" x-text="(data.name||'').substring(0,20)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='tcr'}" @click="selK=selK==='tcr'?null:'tcr'">
        <div class="kpi-lbl">TCR</div>
        <div class="kpi-val" :style="`color:${$root.bc(tcr_($root.data),90,70)}`" x-text="$root.pct(tcr_($root.data))"></div>
        <div class="kpi-sub" :class="tcr_($root.data)>=80?'ok':tcr_($root.data)>=60?'warn':''">
          <span x-text="tcr_($root.data)>=80?'Good':tcr_($root.data)>=60?'Fair':'Low'"></span>
        </div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='accuracy'}" @click="selK=selK==='accuracy'?null:'accuracy'">
        <div class="kpi-lbl">Accuracy</div>
        <div class="kpi-val" :style="`color:${$root.bc(acc_($root.data),70,50)}`" x-text="$root.pct(acc_($root.data))"></div>
        <div class="kpi-sub" :class="acc_($root.data)>=70?'ok':acc_($root.data)>=50?'warn':''">
          <span x-text="acc_($root.data)>=70?'Good':acc_($root.data)>=50?'Fair':'Low'"></span>
        </div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='hallucination'}" @click="selK=selK==='hallucination'?null:'hallucination'">
        <div class="kpi-lbl">Hallucination</div>
        <div class="kpi-val" :style="`color:${hallRate($root.data)===0?'var(--green)':hallRate($root.data)<10?'var(--yellow)':'var(--red)'}`"
             x-text="$root.pct(hallRate($root.data))"></div>
        <div class="kpi-sub" x-text="hallRate($root.data)===0?'Safe':hallRate($root.data)<10?'Warn':'High'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='p95_latency'}" @click="selK=selK==='p95_latency'?null:'p95_latency'">
        <div class="kpi-lbl">P95 Latency</div>
        <div class="kpi-val" :style="`color:${$root.bc2lat($root.data.efficiency_metrics?.latency?.p95||$root.data.efficiency_metrics?.p95_latency||0)}`"
             x-text="$root.sec_($root.data.efficiency_metrics?.latency?.p95||$root.data.efficiency_metrics?.p95_latency||0)"></div>
        <div class="kpi-sub" style="color:var(--text2)" x-text="'avg: '+$root.sec_($root.data.efficiency_metrics?.avg_latency||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='total_cost'}" @click="selK=selK==='total_cost'?null:'total_cost'">
        <div class="kpi-lbl">Total Cost</div>
        <div class="kpi-val" x-text="$root.cost($root.data.efficiency_metrics?.tokens?.total_cost||$root.data.efficiency_metrics?.total_cost||0)"></div>
        <div class="kpi-sub" style="color:var(--text2)" x-text="'per task: '+$root.cost(($root.data.efficiency_metrics?.tokens?.total_cost||$root.data.efficiency_metrics?.total_cost||0)/($root.data.total_tasks||1))"></div>
      </div>
    </div>
    <!-- kpi-act detail panel -->
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="meta[selK]?.unit?'단위: '+meta[selK].unit:''"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
