                <span style="color:var(--text2);font-size:11px">Q: </span>
                <span x-text="c.question||c.task_id||'(no question)'"></span>
              </div>
              <template x-if="c.response||c.answer">
                <div style="font-size:12px;color:var(--text2)">
                  <span class="fs-sm">A: </span>
                  <span x-text="(c.response||c.answer||'').substring(0,120)+(((c.response||c.answer)||'').length>120?'…':'')"></span>
                </div>
              </template>
              <div x-show="c.success===false||c.completion_score<0.5" style="font-size:11px;color:#f59e0b;margin-top:4px">
