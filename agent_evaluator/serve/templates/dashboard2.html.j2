      deLabels:{g_eval_score:'G-Eval',hallucination_score:'Hallucination',toxicity_score:'Toxicity',bias_score:'Bias',answer_relevancy_score:'Ans. Relevancy'},
      meta:{
        g_eval_score:{label:'G-Eval Score',unit:'0-1',desc:'LLM-as-judge 방식의 종합 품질 평가 점수',hint:'GPT 기반 평가, 문맥·논리·일관성 종합'},
        hallucination_score:{label:'Hallucination',unit:'0-1',desc:'DeepEval의 환각 탐지 점수 (낮을수록 환각 적음)',hint:'사실적 오류 및 컨텍스트 불일치 탐지'},
        toxicity_score:{label:'Toxicity',unit:'0-1',desc:'응답의 유해성 점수 (낮을수록 안전)',hint:'혐오·공격성·해로운 콘텐츠 감지'},
        bias_score:{label:'Bias',unit:'0-1',desc:'응답의 편향 점수 (낮을수록 중립적)',hint:'성별·인종·정치적 편향 탐지'},
        answer_relevancy_score:{label:'Ans. Relevancy',unit:'0-1',desc:'DeepEval의 답변 관련성 점수',hint:'질문과 답변의 의미적 유사도'},
      },
      formula(k,d){
        const s=d.advanced?.summary||{};
        const v=s[k];
        if(!v)return `${k}: 데이터 없음`;
        return `${k}\n평균: ${(v.mean||0).toFixed(3)}\n최소: ${(v.min||0).toFixed(3)}\n최대: ${(v.max||0).toFixed(3)}`;
      },
      items(k,d){
        return [...(d.advanced?.per_task||[])].filter(t=>t[k]!=null).sort((a,b)=>(b[k]||0)-(a[k]||0));
      },
      filterLabel(k){return k+' 내림차순';}
    }">
      <div class="kpi-grid">
        <template x-for="k in deKeys" :key="k">
