            </div>
          </div>
        </template>
      </div>
      <div class="cg" style="margin-top:8px">
        <div class="cbox"><div class="ct">RAG 지표 비교</div><div id="d2-ex-rag-bar" class="plt-chart"></div></div>
        <div class="cbox"><div class="ct">태스크별 RAG 지표 비교</div><div id="d2-ex-rag-scatter" class="plt-chart"></div></div>
      </div>
    </div>
  </div>

  <!-- DeepEval subsection -->
  <div x-show="data.has_advanced">
    <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔬 DeepEval 지표</span><div class="sdiv-line"></div></div>
    <div x-data="{
      selK:null,
      deKeys:['g_eval_score','hallucination_score','toxicity_score','bias_score','answer_relevancy_score'],
      deLabels:{g_eval_score:'G-Eval',hallucination_score:'Hallucination',toxicity_score:'Toxicity',bias_score:'Bias',answer_relevancy_score:'Ans. Relevancy'},
      meta:{
        g_eval_score:{label:'G-Eval Score',unit:'0-1',desc:'LLM 자신이 판사(judge) 역할을 하여 평가하는 종합 품질 점수입니다. 규칙 기반으로 포착하기 어려운 논리적 일관성, 문맥 이해, 전반적 적절성을 인간 평가와 유사한 방식으로 측정합니다.',hint:'GPT 기반 평가, 문맥·논리·일관성 종합'},
        hallucination_score:{label:'Hallucination',unit:'0-1',desc:'DeepEval의 환각 탐지 점수입니다. 0에 가까울수록 사실적 오류와 컨텍스트 불일치가 적음을 의미하며, Agent-Evaluator 내장 환각 탐지기와 상호 보완적으로 활용할 수 있습니다.',hint:'사실적 오류 및 컨텍스트 불일치 탐지'},
        toxicity_score:{label:'Toxicity',unit:'0-1',desc:'응답에 포함된 유해·공격적·혐오적 콘텐츠의 정도를 나타냅니다. 0에 가까울수록 안전한 응답이며, 공개 서비스 배포 전 반드시 낮은 수준으로 유지해야 합니다.',hint:'혐오·공격성·해로운 콘텐츠 감지'},
        bias_score:{label:'Bias',unit:'0-1',desc:'응답에 성별, 인종, 정치 등의 편향이 포함된 정도를 측정합니다. 0에 가까울수록 중립적이고 균형 있는 응답이며, 다양한 사용자에게 공정한 서비스를 제공하기 위한 필수 점검 항목입니다.',hint:'성별·인종·정치적 편향 탐지'},
        answer_relevancy_score:{label:'Ans. Relevancy',unit:'0-1',desc:'DeepEval이 평가하는 답변 관련성 점수입니다. 질문의 의도와 답변 내용이 의미적으로 얼마나 일치하는지를 임베딩 기반으로 측정하며, Ragas의 Answer Relevancy와 상호 검증에 활용할 수 있습니다.',hint:'질문과 답변의 의미적 유사도'},
      },
      formula(k,d){
        const s=d.advanced?.summary||{};
        const v=s[k];
        if(!v)return `${k}: 데이터 없음`;
        return `${k}\n평균: ${(v.mean||0).toFixed(3)}\n최소: ${(v.min||0).toFixed(3)}\n최대: ${(v.max||0).toFixed(3)}`;
      },
      items(k,d){
        const taskMap={};(d.tasks||[]).forEach(t=>{taskMap[t.task_id]=t;});
        return [...(d.advanced?.per_task||[])].filter(t=>t[k]!=null).sort((a,b)=>(b[k]||0)-(a[k]||0))
          .map(t=>({...t, completion_score:(taskMap[t.task_id]||{}).completion_score??null, success:(taskMap[t.task_id]||{}).success??null}));
      },
      filterLabel(k){return k+' 내림차순';}
    }">
      <div class="kpi-grid">
        <template x-for="k in deKeys" :key="k">
          <div class="kpi kpi-act" :class="{sel:selK===k}" @click="selK=selK===k?null:k"
               x-show="data.advanced?.summary?.[k]!=null">
            <div class="kpi-lbl" x-text="deLabels[k]||k"></div>
            <div class="kpi-val" :style="`color:${_bc((data.advanced?.summary?.[k]?.mean||0)*100,70,50)}`"
                 x-text="(data.advanced?.summary?.[k]?.mean||0).toFixed(3)"></div>
            <div class="kpi-sub" style="color:var(--text2)"
                 x-text="`min ${(data.advanced?.summary?.[k]?.min||0).toFixed(2)} / max ${(data.advanced?.summary?.[k]?.max||0).toFixed(2)}`"></div>
          </div>
        </template>
      </div>
      <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
        <template x-if="selK">
          <div>
            <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
              <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
              <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
              <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
                <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
                <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
              </div>
              <div style="padding:10px 14px;background:var(--bg3)">
                <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 통계</div>
                <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
              </div>
            </div>
            <div style="padding:10px 14px;background:var(--bg)">
              <div class="dtx" style="max-height:220px;overflow-y:auto">
                <div class="dtx-row dtx-head" style="grid-template-columns:minmax(120px,1fr) 90px 70px;position:sticky;top:0;z-index:1">
