            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
              <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,$root.data)"></div>
            </div>
          </div>
          <div style="padding:10px 14px;background:var(--bg)">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">관련 태스크</span>
              <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="filterLabel(selK)"></span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,$root.data).length+'건'"></span>
            </div>
            <div class="dtx" style="max-height:220px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:1fr 80px 80px 60px;position:sticky;top:0;z-index:1">
                <span>태스크 ID</span><span>유형</span><span>완료율</span><span>상태</span>
              </div>
              <template x-for="t in items(selK,$root.data)" :key="t.task_id">
                <div class="dtx-row" style="grid-template-columns:1fr 80px 80px 60px">
                  <span class="dtx-id" x-text="t.task_id"></span>
                  <span style="font-size:11px;color:var(--text2)" x-text="t.task_type||'-'"></span>
                  <span :style="`color:${(t.completion_score||0)>=1?'var(--green)':(t.completion_score||0)>=0.7?'var(--yellow)':'var(--red)'}`"
                        x-text="((t.completion_score||0)*100).toFixed(0)+'%'"></span>
                  <span :class="t.success?'badge-ok':'badge-ng'" x-text="t.success?'✓':'✗'"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cg" style="margin-top:8px">
      <div class="cbox"><div class="ct">완료율 분포</div><div id="d2-q-donut" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">태스크 유형별 TCR</div><div id="d2-q-type-tcr" class="plt-chart"></div></div>
    </div>
  </div>

  <!-- Accuracy subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🎯 정확도</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      overall:{label:'전체 정확도',unit:'%',desc:'Token Overlap 40% + Jaccard 30% + LCS 20% + Char Similarity 10%의 가중 평균',hint:'avg(accuracy_score) × 100'},
      median:{label:'중앙값',unit:'%',desc:'정확도 분포의 중앙값 (이상치 영향 최소화)',hint:'median(accuracy_scores) × 100'},
      minimum:{label:'최솟값',unit:'%',desc:'가장 낮은 정확도 점수',hint:'min(accuracy_scores) × 100'},
      maximum:{label:'최댓값',unit:'%',desc:'가장 높은 정확도 점수',hint:'max(accuracy_scores) × 100'},
      stddev:{label:'표준편차',unit:'%',desc:'정확도 점수의 분산 정도. 낮을수록 일관된 성능.',hint:'std(accuracy_scores) × 100'},
    },
    formula(k,d){
      const t=d.tasks||[];
      const sc=t.map(x=>(x.accuracy_score||0)*100).filter(v=>v>0);
      const n=sc.length||1;
      const mean=sc.reduce((a,b)=>a+b,0)/n;
      const sorted=[...sc].sort((a,b)=>a-b);
      const med=n%2===0?(sorted[n/2-1]+sorted[n/2])/2:sorted[Math.floor(n/2)];
      const std=Math.sqrt(sc.reduce((a,b)=>a+(b-mean)**2,0)/n);
      if(k==='overall')return `평균 = Σ accuracy_score / n\n= ${mean.toFixed(1)}% (n=${n})\n가중: Token(40%)+Jaccard(30%)+LCS(20%)+Char(10%)`;
      if(k==='median')return `중앙값 = ${med.toFixed(1)}% (n=${n})\n이상치에 강건한 대표값`;
      if(k==='minimum')return `최솟값 = ${Math.min(...sc).toFixed(1)}%`;
      if(k==='maximum')return `최댓값 = ${Math.max(...sc).toFixed(1)}%`;
      if(k==='stddev')return `표준편차 = ${std.toFixed(1)}%\n변동계수(CV) = ${mean>0?(std/mean*100).toFixed(1):'-'}%`;
      return '';
    },
    items(k,d){
      const t=d.tasks||[];
      const sc=t.map(x=>(x.accuracy_score||0)*100).filter(v=>v>0);
      const mean=sc.reduce((a,b)=>a+b,0)/(sc.length||1);
      if(k==='minimum')return [...t].sort((a,b)=>(a.accuracy_score||0)-(b.accuracy_score||0)).slice(0,10);
      if(k==='maximum')return [...t].sort((a,b)=>(b.accuracy_score||0)-(a.accuracy_score||0)).slice(0,10);
      if(k==='stddev')return t.filter(x=>Math.abs((x.accuracy_score||0)*100-mean)>10);
      return [...t].sort((a,b)=>(b.accuracy_score||0)-(a.accuracy_score||0));
    },
    filterLabel(k){return {overall:'정확도 내림차순',median:'전체',minimum:'하위 10개',maximum:'상위 10개',stddev:'평균 ±10% 벗어난 태스크'}[k]||'전체';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='overall'}" @click="selK=selK==='overall'?null:'overall'">
        <div class="kpi-lbl">전체 정확도</div>
        <div class="kpi-val" :style="`color:${$root.bc(acc_($root.data),70,50)}`" x-text="$root.pct(acc_($root.data))"></div>
        <div class="kpi-sub" x-text="$root.data.accuracy_metrics?.total_evaluated+'건 평가'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='median'}" @click="selK=selK==='median'?null:'median'">
        <div class="kpi-lbl">중앙값</div>
        <div class="kpi-val" x-text="(()=>{const sc=($root.data.tasks||[]).map(t=>(t.accuracy_score||0)*100).filter(v=>v>0).sort((a,b)=>a-b);const n=sc.length;return n?((n%2===0?(sc[n/2-1]+sc[n/2])/2:sc[Math.floor(n/2)])||0).toFixed(1)+'%':'-';})()"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='minimum'}" @click="selK=selK==='minimum'?null:'minimum'">
        <div class="kpi-lbl">최솟값</div>
        <div class="kpi-val" style="color:var(--red)" x-text="(()=>{const sc=($root.data.tasks||[]).map(t=>(t.accuracy_score||0)*100).filter(v=>v>0);return sc.length?Math.min(...sc).toFixed(1)+'%':'-';})()"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='maximum'}" @click="selK=selK==='maximum'?null:'maximum'">
        <div class="kpi-lbl">최댓값</div>
        <div class="kpi-val" style="color:var(--green)" x-text="(()=>{const sc=($root.data.tasks||[]).map(t=>(t.accuracy_score||0)*100).filter(v=>v>0);return sc.length?Math.max(...sc).toFixed(1)+'%':'-';})()"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='stddev'}" @click="selK=selK==='stddev'?null:'stddev'">
        <div class="kpi-lbl">표준편차</div>
        <div class="kpi-val" x-text="(()=>{const sc=($root.data.tasks||[]).map(t=>(t.accuracy_score||0)*100).filter(v=>v>0);const n=sc.length;if(!n)return '-';const m=sc.reduce((a,b)=>a+b,0)/n;return Math.sqrt(sc.reduce((a,b)=>a+(b-m)**2,0)/n).toFixed(1)+'%';})()"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="meta[selK]?.unit?'단위: '+meta[selK].unit:''"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
              <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,$root.data)"></div>
            </div>
          </div>
          <div style="padding:10px 14px;background:var(--bg)">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">관련 태스크</span>
              <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="filterLabel(selK)"></span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,$root.data).length+'건'"></span>
            </div>
            <div class="dtx" style="max-height:220px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:1fr 80px 80px 60px;position:sticky;top:0;z-index:1">
                <span>태스크 ID</span><span>유형</span><span>정확도</span><span>상태</span>
              </div>
              <template x-for="t in items(selK,$root.data)" :key="t.task_id">
                <div class="dtx-row" style="grid-template-columns:1fr 80px 80px 60px">
                  <span class="dtx-id" x-text="t.task_id"></span>
                  <span style="font-size:11px;color:var(--text2)" x-text="t.task_type||'-'"></span>
                  <span :style="`color:${$root.bc((t.accuracy_score||0)*100,70,50)}`" x-text="$root.pct((t.accuracy_score||0)*100)"></span>
                  <span :class="t.success?'badge-ok':'badge-ng'" x-text="t.success?'✓':'✗'"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cg" style="margin-top:8px">
      <div class="cbox">
        <div class="ct">정확도 분포 (태스크 유형별)</div>
        <div id="d2-q-acc-hist" class="plt-chart"></div>
      </div>
      <div class="cbox">
        <div class="ct">정확도 가중치 구성</div>
        <div id="d2-q-acc-weights" class="plt-chart" style="height:100px"></div>
        <div style="margin-top:8px;font-size:11px;color:var(--text2);line-height:1.8">
          <div>🔵 <b>Token Overlap (40%)</b> — 공통 토큰 F1 스코어</div>
          <div>🟣 <b>Jaccard (30%)</b> — 집합 교집합/합집합</div>
          <div>🟡 <b>LCS Ratio (20%)</b> — 최장 공통 부분 수열</div>
          <div>⚪ <b>Char Similarity (10%)</b> — 문자 수준 편집 유사도</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Response Quality subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">⭐ 응답 품질</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      avg_score:{label:'평균 품질 점수',unit:'/5',desc:'5개 차원(관련성·완전성·정확성·명확성·유용성) 평균',hint:'avg(dimension_scores) / 5'},
      relevance:{label:'관련성',unit:'/5',desc:'응답이 질문에 얼마나 관련되어 있는가',hint:'quality_detail.dimension_summary.relevance'},
      completeness:{label:'완전성',unit:'/5',desc:'응답이 질문의 모든 측면을 다루는가',hint:'quality_detail.dimension_summary.completeness'},
      accuracy:{label:'정확성',unit:'/5',desc:'응답의 사실적 정확도',hint:'quality_detail.dimension_summary.accuracy'},
      clarity:{label:'명확성',unit:'/5',desc:'응답이 명확하고 이해하기 쉬운가',hint:'quality_detail.dimension_summary.clarity'},
      usefulness:{label:'유용성',unit:'/5',desc:'응답이 실제로 도움이 되는가',hint:'quality_detail.dimension_summary.usefulness'},
    },
    formula(k,d){
      const ds=d.quality_detail?.dimension_summary||{};
      const avg=d.quality_detail?.avg_score||0;
      if(k==='avg_score')return `평균 = (관련성+완전성+정확성+명확성+유용성)/5\n= ${avg.toFixed(2)}/5 = ${(avg*20).toFixed(1)}%`;
      return `${k} = ${(ds[k]||0).toFixed(2)}/5`;
    },
    items(k,d){
      const evs=d.quality_detail?.evaluations||[];
      if(k!=='avg_score'){
        return [...evs].sort((a,b)=>((b.dimension_scores?.[k]||b[k]||0))-(a.dimension_scores?.[k]||a[k]||0));
      }
      return [...evs].sort((a,b)=>(b.total_score||0)-(a.total_score||0));
    },
    filterLabel(k){return k==='avg_score'?'총점 내림차순':k+' 점수 내림차순';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='avg_score'}" @click="selK=selK==='avg_score'?null:'avg_score'">
        <div class="kpi-lbl">평균 품질 점수</div>
        <div class="kpi-val" x-text="(data.quality_detail?.avg_score||0).toFixed(2)+'/5'"></div>
        <div class="kpi-sub" x-text="(data.quality_detail?.evaluations||[]).length+'건 평가'"></div>
      </div>
      <template x-for="(dimLabel,dimKey) in {relevance:'관련성',completeness:'완전성',accuracy:'정확성',clarity:'명확성',usefulness:'유용성'}" :key="dimKey">
        <div class="kpi kpi-act" :class="{sel:selK===dimKey}" @click="selK=selK===dimKey?null:dimKey">
          <div class="kpi-lbl" x-text="dimLabel"></div>
          <div class="kpi-val" x-text="(data.quality_detail?.dimension_summary?.[dimKey]||0).toFixed(2)"></div>
          <div class="kpi-sub">/5</div>
        </div>
      </template>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="meta[selK]?.unit?'단위: '+meta[selK].unit:''"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
              <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,$root.data)"></div>
            </div>
          </div>
          <div style="padding:10px 14px;background:var(--bg)">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">평가 목록</span>
              <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="filterLabel(selK)"></span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,$root.data).length+'건'"></span>
            </div>
            <div class="dtx" style="max-height:220px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:1fr 60px 50px 60px;position:sticky;top:0;z-index:1">
                <span>태스크 ID</span><span>총점</span><span>등급</span><span>해당 차원</span>
              </div>
              <template x-for="ev in items(selK,$root.data)" :key="ev.task_id">
                <div class="dtx-row" style="grid-template-columns:1fr 60px 50px 60px">
                  <span class="dtx-id" x-text="ev.task_id"></span>
                  <span x-text="(ev.total_score||0).toFixed(2)"></span>
                  <span :class="{'badge-ok':ev.grade==='A','badge-info':ev.grade==='B','badge-warn':ev.grade==='C','badge-ng':ev.grade==='F'}" x-text="ev.grade||'-'"></span>
                  <span x-text="selK==='avg_score'?'-':((ev.dimension_scores?.[selK]||ev[selK]||0)).toFixed(2)"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cg" style="margin-top:8px">
      <div class="cbox"><div class="ct">품질 차원 레이더</div><div id="d2-q-radar" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">등급 분포</div><div id="d2-q-grade" class="plt-chart"></div></div>
    </div>
  </div>

  <!-- Hallucination subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔍 환각 탐지</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      hall_rate:{label:'환각률',unit:'%',desc:'평가된 태스크 중 환각이 탐지된 비율',hint:'flagged / evaluated × 100'},
      evaluated:{label:'평가 건수',unit:'건',desc:'환각 탐지를 실행한 총 태스크 수',hint:'accuracy_metrics.hallucination.total_evaluated'},
      flagged:{label:'탐지 건수',unit:'건',desc:'환각으로 분류된 태스크 수',hint:'accuracy_metrics.hallucination.total_flagged'},
      types:{label:'유형 수',unit:'종',desc:'탐지된 환각 지표 유형의 수',hint:'hallucination_detail.indicator_types keys'},
    },
    formula(k,d){
      const ev=d.accuracy_metrics?.hallucination?.total_evaluated||0;
      const fl=d.accuracy_metrics?.hallucination?.total_flagged||0;
      if(k==='hall_rate')return `환각률 = flagged/evaluated×100\n= ${fl}/${ev} = ${ev?((fl/ev)*100).toFixed(1):0}%`;
      if(k==='evaluated')return `평가 건수 = ${ev}건`;
      if(k==='flagged')return `탐지 건수 = ${fl}건 (${ev?((fl/ev)*100).toFixed(1):0}%)`;
      if(k==='types')return `유형 수 = ${Object.keys(d.hallucination_detail?.indicator_types||{}).length}종`;
      return '';
    },
    items(k,d){
      const dets=d.hallucination_detail?.detections||[];
      if(k==='evaluated')return d.tasks||[];
      return dets;
    },
    filterLabel(k){return {hall_rate:'탐지된 환각건',evaluated:'전체 태스크',flagged:'탐지 건',types:'탐지 건'}[k]||'전체';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='hall_rate'}" @click="selK=selK==='hall_rate'?null:'hall_rate'">
        <div class="kpi-lbl">환각률</div>
        <div class="kpi-val" :style="`color:${hallRate($root.data)===0?'var(--green)':hallRate($root.data)<10?'var(--yellow)':'var(--red)'}`"
             x-text="$root.pct(hallRate($root.data))"></div>
        <div class="kpi-sub" x-text="hallRate($root.data)===0?'✓ 안전':hallRate($root.data)<10?'⚠ 주의':'🚨 위험'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='evaluated'}" @click="selK=selK==='evaluated'?null:'evaluated'">
        <div class="kpi-lbl">평가 건수</div>
        <div class="kpi-val" x-text="data.accuracy_metrics?.hallucination?.total_evaluated||0"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='flagged'}" @click="selK=selK==='flagged'?null:'flagged'">
        <div class="kpi-lbl">탐지 건수</div>
        <div class="kpi-val" style="color:var(--orange)" x-text="data.accuracy_metrics?.hallucination?.total_flagged||0"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='types'}" @click="selK=selK==='types'?null:'types'">
        <div class="kpi-lbl">유형 수</div>
        <div class="kpi-val" x-text="Object.keys(data.hallucination_detail?.indicator_types||{}).length"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="meta[selK]?.unit?'단위: '+meta[selK].unit:''"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
              <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,$root.data)"></div>
            </div>
          </div>
          <div style="padding:10px 14px;background:var(--bg)">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">탐지 목록</span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,$root.data).length+'건'"></span>
            </div>
            <div class="dtx" style="max-height:220px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:1fr 100px 70px 60px;position:sticky;top:0;z-index:1">
                <span>태스크 ID</span><span>질문(앞50자)</span><span>유형</span><span>심각도</span>
              </div>
              <template x-for="det in items(selK,$root.data)" :key="det.task_id+(det.indicator_type||'')">
                <div class="dtx-row" style="grid-template-columns:1fr 100px 70px 60px">
                  <span class="dtx-id" x-text="det.task_id||det.task_id"></span>
                  <span style="font-size:11px;color:var(--text2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="(det.question||'').substring(0,30)"></span>
                  <span style="font-size:11px" x-text="det.indicator_type||'-'"></span>
                  <span :class="(det.severity||'low')==='high'?'badge-ng':(det.severity||'low')==='medium'?'badge-warn':'badge-gray'"
                        x-text="det.severity||'low'"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cbox" style="margin-top:8px">
      <div class="ct">환각 지표 유형별 분포</div>
      <div id="d2-q-hall-type" class="plt-chart"></div>
    </div>
  </div>

</div><!-- /quality -->

<!-- ══ SECTION 3: EXTERNAL (RAG + DeepEval) ══ -->
<div x-show="data && sec==='external'" x-cloak>
  <div x-show="!data.has_rag && !data.has_advanced" class="es">
    <div class="es-icon">📭</div>
    <div class="es-title">외부 평가 지표 없음</div>
    <div class="es-desc">RAG 또는 DeepEval 지표가 포함된 평가 결과를 선택하세요.</div>
    <div class="es-desc"><code>HybridPerformanceMonitor(enable_rag=True)</code> 또는 <code>enable_deepeval=True</code>로 활성화</div>
  </div>

  <!-- RAG subsection -->
  <div x-show="data.has_rag">
    <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">📚 RAG 지표 (Ragas)</span><div class="sdiv-line"></div></div>
    <div x-data="{
      selK:null,
      meta:{
        faithfulness:{label:'Faithfulness',unit:'0-1',desc:'생성된 답변이 컨텍스트에 얼마나 충실한가 (환각 없음)',hint:'generated answer ∩ context / generated answer'},
        answer_relevancy:{label:'Answer Relevancy',unit:'0-1',desc:'답변이 질문에 얼마나 관련되어 있는가',hint:'avg cosine sim(generated questions, original question)'},
        context_recall:{label:'Context Recall',unit:'0-1',desc:'ground truth 중 컨텍스트에서 얼마나 재현되는가',hint:'GT sentences supported by context / total GT sentences'},
        context_precision:{label:'Context Precision',unit:'0-1',desc:'컨텍스트 중 관련 청크의 비율',hint:'Σ(relevant chunks at k) / total chunks'},
        overall_score:{label:'Overall Score',unit:'0-1',desc:'4개 지표의 평균 (Ragas Overall)',hint:'avg(faithfulness, answer_relevancy, context_recall, context_precision)'},
      },
      formula(k,d){
        const rm=d.rag_metrics||{};
        return `${k}\n= ${(rm[k]||0).toFixed(3)}\n목표: ≥ 0.8`;
      },
      items(k,d){
        return [...(d.advanced?.per_task||[])].sort((a,b)=>(b[k]||0)-(a[k]||0));
      },
      filterLabel(k){return k+' 내림차순';}
    }">
      <div class="kpi-grid">
        <div class="kpi kpi-act" :class="{sel:selK==='faithfulness'}" @click="selK=selK==='faithfulness'?null:'faithfulness'">
          <div class="kpi-lbl">Faithfulness</div>
          <div class="kpi-val" :style="`color:${$root.bc((data.rag_metrics?.faithfulness||0)*100,70,50)}`"
               x-text="(data.rag_metrics?.faithfulness||0).toFixed(3)"></div>
          <div class="kpi-sub" style="color:var(--text2)" x-text="(data.advanced?.per_task||[]).filter(t=>t.faithfulness!=null).length+'건'"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='answer_relevancy'}" @click="selK=selK==='answer_relevancy'?null:'answer_relevancy'">
          <div class="kpi-lbl">Ans. Relevancy</div>
          <div class="kpi-val" :style="`color:${$root.bc((data.rag_metrics?.answer_relevancy||0)*100,70,50)}`"
               x-text="(data.rag_metrics?.answer_relevancy||0).toFixed(3)"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='context_recall'}" @click="selK=selK==='context_recall'?null:'context_recall'">
          <div class="kpi-lbl">Ctx. Recall</div>
          <div class="kpi-val" :style="`color:${$root.bc((data.rag_metrics?.context_recall||0)*100,70,50)}`"
               x-text="(data.rag_metrics?.context_recall||0).toFixed(3)"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='context_precision'}" @click="selK=selK==='context_precision'?null:'context_precision'">
          <div class="kpi-lbl">Ctx. Precision</div>
          <div class="kpi-val" :style="`color:${$root.bc((data.rag_metrics?.context_precision||0)*100,70,50)}`"
               x-text="(data.rag_metrics?.context_precision||0).toFixed(3)"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='overall_score'}" @click="selK=selK==='overall_score'?null:'overall_score'">
          <div class="kpi-lbl">Overall Score</div>
          <div class="kpi-val" :style="`color:${$root.bc((data.rag_metrics?.overall_score||data.advanced?.summary?.ragas_overall_score?.mean||0)*100,70,50)}`"
               x-text="(data.rag_metrics?.overall_score||data.advanced?.summary?.ragas_overall_score?.mean||0).toFixed(3)"></div>
        </div>
      </div>
      <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
        <template x-if="selK">
          <div>
            <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
              <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
              <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="meta[selK]?.unit?'범위: '+meta[selK].unit:''"></span>
              <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
              <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
                <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
                <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
              </div>
              <div style="padding:10px 14px;background:var(--bg3)">
                <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
                <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,$root.data)"></div>
              </div>
            </div>
            <div style="padding:10px 14px;background:var(--bg)">
              <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
                <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">태스크별 점수</span>
                <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,$root.data).length+'건'"></span>
              </div>
              <div class="dtx" style="max-height:220px;overflow-y:auto">
