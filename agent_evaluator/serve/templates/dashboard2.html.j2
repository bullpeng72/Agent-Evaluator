             x-text="_sec(data.efficiency_metrics?.p90_latency||data.efficiency_metrics?.latency?.p90||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='p95'}" @click="selK=selK==='p95'?null:'p95'">
