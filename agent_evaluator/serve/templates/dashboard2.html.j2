                    <div class="dtx-row" style="grid-template-columns:minmax(100px,1.5fr) 80px 70px 50px">
                      <span class="dtx-id" x-text="t.task_id"></span>
                      <span class="text-muted" x-text="t.task_type||'-'"></span>
                      <span :style="`color:${(t.completion_score||0)>=0.9?'var(--green)':(t.completion_score||0)>=0.7?'var(--yellow)':'var(--red)'}`"
                            x-text="((t.completion_score||0)*100).toFixed(0)+'%'"></span>
                      <span :class="(t.completion_score||0)>=1?'badge-ok':(t.completion_score||0)>=0.7?'badge-warn':'badge-ng'"
                            x-text="(t.completion_score||0)>=1?'Done':(t.completion_score||0)>=0.7?'Partial':'Fail'"></span>
                    </div>
                  </template>
                </div>
              </div>
          </div>
        </template>
      </div>
    </div>
  </template>

  <!-- Phase 2: Loop Detection events from harness -->
  <template x-if="data.loop_events && data.loop_events.length > 0">
    <div>
      <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔄 Loop Detection Events (Harness Gate B)</span><div class="sdiv-line"></div></div>
      <div style="background:color-mix(in srgb,var(--yellow) 10%,var(--bg2));border:1px solid color-mix(in srgb,var(--yellow) 30%,var(--border));border-radius:8px;padding:12px;margin-bottom:12px">
        <div style="font-weight:600;color:var(--yellow);margin-bottom:8px">⚠ <span x-text="data.loop_events.length"></span> loop(s) detected</div>
        <div class="dtx">
          <div class="dtx-row dtx-head" style="grid-template-columns:2fr 120px 70px 80px">
            <span>Task ID</span><span>Loop Type</span><span>Detected At</span><span>Tool</span>
          </div>
          <template x-for="(ev,i) in data.loop_events.slice(0,20)" :key="i">
            <div class="dtx-row" style="grid-template-columns:2fr 120px 70px 80px">
              <span class="dtx-id" x-text="ev.task_id||'—'"></span>
              <span style="color:var(--yellow)" x-text="ev.type||'unknown'"></span>
              <span class="muted" x-text="ev.at_step!=null?'Step '+ev.at_step:'—'"></span>
              <span style="font-family:monospace;font-size:11px" x-text="ev.tool||'—'"></span>
            </div>
          </template>
        </div>
      </div>
    </div>
  </template>

</div><!-- /agentic -->

<!-- ══ SECTION 6: SECURITY ══ -->
<div x-show="data && sec==='security'" x-cloak>
  <div x-show="!data.has_security" class="es">
    <div class="es-icon">🔒</div>
    <div class="es-title">No Security Metrics</div>
    <div class="es-desc">Enable with <code>PerformanceMonitor(enable_security_metrics=True)</code>.</div>
  </div>
  <div x-show="data.has_security">

  <!-- Security Boundary Flow (§4.4) — 입력→실행→출력 3단계 경계 흐름 -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔍 Security Boundary Flow<span class="grp-chip grp-B" style="margin-left:6px;font-size:9.5px">B Behavioral Integrity</span></span><div class="sdiv-line"></div></div>
  <div class="cbox" x-data="{
    selB: null,
    inputT(d){ return (d.security_l1?.input_security?.inputs_with_threats||0); },
    execV(d){ return (d.security_l1?.authorization?.unauthorized_calls||0)+(d.security_l2?.privilege_escalation?.escalations_detected||0); },
    outputL(d){ return (d.security_l1?.output_leakage?.outputs_with_leakage||0); },
    lc(n){ return n===0?'var(--green)':n<=2?'var(--yellow)':'var(--red)'; },
    bLabel: { input:'① Input Boundary', exec:'② Execution Boundary', output:'③ Output Boundary' },
    bDesc: {
      input: 'Detects external input threats using 5 patterns: SQL Injection, Command Injection, XSS, Path Traversal, Prompt Injection.\nAggregated based on deduplicated threat input count (inputs_with_threats).',
      exec:  'ToolAuthorizationTracker + PrivilegeEscalationDetector detect authorization violations during execution.\nViolations = unauthorized_calls + escalations_detected',
      output: 'OutputLeakageDetector detects sensitive data leaks (API keys, passwords, PII) in outputs.\nClassified and aggregated by severity: CRITICAL and HIGH.',
    },
    bFormula(k, d) {
      const is = d.security_l1?.input_security || {};
      const au = d.security_l1?.authorization || {};
      const pe = d.security_l2?.privilege_escalation || {};
      const ol = d.security_l1?.output_leakage || {};
      if (k === 'input') {
        const total = (is.sql_injection_attempts||0)+(is.command_injection_attempts||0)+(is.xss_attempts||0)+(is.path_traversal_attempts||0)+(is.prompt_injection_attempts||0);
        return `Threat inputs = inputs_with_threats (deduplicated)\nEvaluated: ${is.total_inputs_evaluated||0} / Threat inputs: ${is.inputs_with_threats||0}\nThreat rate: ${(is.threat_rate||0).toFixed(1)}%\n\nTotal detection events: ${total}\n  SQL Injection:     ${is.sql_injection_attempts||0}\n  Command Injection: ${is.command_injection_attempts||0}\n  XSS:               ${is.xss_attempts||0}\n  Path Traversal:    ${is.path_traversal_attempts||0}\n  Prompt Injection:  ${is.prompt_injection_attempts||0}`;
      }
      if (k === 'exec') {
        return `Authorization violations = unauthorized_calls + escalations_detected\n         = ${au.unauthorized_calls||0} + ${pe.escalations_detected||0} = ${(au.unauthorized_calls||0)+(pe.escalations_detected||0)}\n\nTotal tool calls: ${au.total_tool_calls||0}\nAuthorized calls: ${au.authorized_calls||0}\nUnauthorized:     ${au.unauthorized_calls||0}\nDangerous params: ${au.dangerous_params||0}\nRestricted attempts: ${au.restricted_attempts||0}\nEscalations detected: ${pe.escalations_detected||0}`;
      }
      if (k === 'output') {
        return `Data leakage = outputs_with_leakage (deduplicated)\nEvaluated: ${ol.total_outputs_evaluated||0} / Leakage detected: ${ol.outputs_with_leakage||0}\nLeakage rate: ${(ol.leakage_rate||0).toFixed(1)}%\n\nCRITICAL: ${ol.critical_severity_count||0}\nHIGH:     ${ol.high_severity_count||0}\nMEDIUM:   ${ol.medium_severity_count||0}\nLOW:      ${ol.low_severity_count||0}`;
      }
      return '';
    },
    _errMatch(t, kws){ const e=(t.errors||[]).join(' ').toLowerCase(); return kws.some(k=>e.includes(k)); },
    bItems(k,d){
      const t=d.tasks||[];
      if(k==='input'){
        // input_evals에 task_id + sanitization_needed + threat_count 있음 → 직접 join
        const evals=(d.security_l1?.input_evals||[]);
        const threatMap={};
        evals.filter(e=>e.sanitization_needed).forEach(e=>{
          threatMap[e.task_id]=(threatMap[e.task_id]||0)+(e.threat_count||1);
        });
        if(Object.keys(threatMap).length>0){
          return t.filter(x=>threatMap[x.task_id])
                   .map(x=>({...x,_sec_val:threatMap[x.task_id]}))
                   .sort((a,b)=>(b._sec_val||0)-(a._sec_val||0));
        }
        // fallback: 오류 키워드 검색
        const injKw=['injection','xss','traversal','prompt inject','sql','command inject','threat','위협'];
        const hit=t.filter(x=>this._errMatch(x,injKw));
        return hit.length>0?hit.sort((a,b)=>(a.completion_score||0)-(b.completion_score||0))
                           :[...t].filter(x=>x.errors&&x.errors.length>0).sort((a,b)=>(a.completion_score||0)-(b.completion_score||0));
      }
      if(k==='exec'){
        // tool_calls에 task_id + is_authorized 있음 → 권한 위반 태스크 직접 join
        const calls=(d.security_l1?.tool_calls||[]);
        const violMap={};
        calls.filter(c=>c.is_authorized===false).forEach(c=>{
          const tid=c.task_id||c.function_name;
          if(tid) violMap[tid]=(violMap[tid]||0)+1;
        });
        if(Object.keys(violMap).length>0){
          return t.filter(x=>violMap[x.task_id])
                   .map(x=>({...x,_sec_val:violMap[x.task_id]}))
                   .sort((a,b)=>(b._sec_val||0)-(a._sec_val||0));
        }
        // 위반 없으면 도구 호출 보유 태스크 표시 (권한 위반 발생 가능 대상)
        return [...t].filter(x=>x.tool_calls&&x.tool_calls.length>0)
                     .sort((a,b)=>(a.completion_score||0)-(b.completion_score||0));
      }
      if(k==='output'){
        // output_detections에 task_id + leakage_count 있음 → 직접 join
        const dets=(d.security_l1?.output_detections||[]);
        const leakMap={};
        dets.filter(e=>e.leakage_count>0).forEach(e=>{
          leakMap[e.task_id]=(leakMap[e.task_id]||0)+(e.leakage_count||1);
        });
        if(Object.keys(leakMap).length>0){
          return t.filter(x=>leakMap[x.task_id])
                   .map(x=>({...x,_sec_val:leakMap[x.task_id]}))
                   .sort((a,b)=>(b._sec_val||0)-(a._sec_val||0));
        }
        // fallback: 오류 키워드 검색
        const leakKw=['leak','leakage','유출','password','api key','secret','token','pii','credential','민감'];
        const hit=t.filter(x=>this._errMatch(x,leakKw));
        return hit.length>0?hit.sort((a,b)=>(a.completion_score||0)-(b.completion_score||0))
                           :[...t].filter(x=>x.errors&&x.errors.length>0).sort((a,b)=>(a.completion_score||0)-(b.completion_score||0));
      }
      return [...t].sort((a,b)=>(a.completion_score||0)-(b.completion_score||0));
    },
    bCol3Label(k){ return {input:'Threats',exec:'Violations',output:'Leaks'}[k]||'Metric'; },
    bCol3Val(k,t){
      if(t._sec_val!=null) return t._sec_val+'';
      if(k==='exec') return (t.tool_calls&&t.tool_calls.length)?t.tool_calls.length+'x':'—';
      return (t.errors&&t.errors.length)?t.errors.length+' errors':'—';
    },
    bCol3Color(k,t){
      if(t._sec_val!=null) return t._sec_val>0?'var(--red)':'var(--text2)';
      if(k==='exec') return (t.tool_calls&&t.tool_calls.length)?'var(--yellow)':'var(--text2)';
      const s=t.completion_score||0; return s>=1?'var(--green)':s>=0.7?'var(--yellow)':'var(--red)';
    },
    bFilterLabel(k){ return {input:'Threats desc',exec:'Violations desc',output:'Leaks desc'}[k]||'Security issues desc'; },
  }">
    <div style="display:flex;align-items:stretch;gap:6px;margin-bottom:10px">
      <!-- ① 입력 경계 -->
      <div class="kpi kpi-act" style="flex:1" :class="{sel:selB==='input'}" @click="selB=selB==='input'?null:'input'">
        <div class="kpi-lbl">① Input Boundary</div>
        <div class="kpi-val" :style="`color:${lc(inputT(data))}`" x-text="inputT(data)"></div>
        <div class="kpi-sub muted">Threat Inputs</div>
        <div style="font-size:10px;color:var(--text2);margin-top:8px;line-height:1.6">
          SQL <b x-text="data.security_l1?.input_security?.sql_injection_attempts||0"></b>
          &nbsp;CMD <b x-text="data.security_l1?.input_security?.command_injection_attempts||0"></b>
          &nbsp;XSS <b x-text="data.security_l1?.input_security?.xss_attempts||0"></b>
          <br>PATH <b x-text="data.security_l1?.input_security?.path_traversal_attempts||0"></b>
          &nbsp;Prompt <b x-text="data.security_l1?.input_security?.prompt_injection_attempts||0"></b>
        </div>
      </div>
      <div style="display:flex;align-items:center;color:var(--text2);font-size:20px;padding:0 2px">→</div>
      <!-- ② 실행 경계 -->
      <div class="kpi kpi-act" style="flex:1" :class="{sel:selB==='exec'}" @click="selB=selB==='exec'?null:'exec'">
        <div class="kpi-lbl">② Execution Boundary</div>
        <div class="kpi-val" :style="`color:${lc(execV(data))}`" x-text="execV(data)"></div>
        <div class="kpi-sub muted">Auth Violations</div>
        <div style="font-size:10px;color:var(--text2);margin-top:8px;line-height:1.6">
          Unauthorized <b x-text="data.security_l1?.authorization?.unauthorized_calls||0"></b>
          <br>Escalation <b x-text="data.security_l2?.privilege_escalation?.escalations_detected||0"></b>
        </div>
      </div>
      <div style="display:flex;align-items:center;color:var(--text2);font-size:20px;padding:0 2px">→</div>
      <!-- ③ 출력 경계 -->
      <div class="kpi kpi-act" style="flex:1" :class="{sel:selB==='output'}" @click="selB=selB==='output'?null:'output'">
        <div class="kpi-lbl">③ Output Boundary</div>
        <div class="kpi-val" :style="`color:${lc(outputL(data))}`" x-text="outputL(data)"></div>
        <div class="kpi-sub muted">Data Leakage</div>
        <div style="font-size:10px;color:var(--text2);margin-top:8px;line-height:1.6">
          CRITICAL <b x-text="data.security_l1?.output_leakage?.critical_severity_count||0"></b>
          &nbsp;HIGH <b x-text="data.security_l1?.output_leakage?.high_severity_count||0"></b>
          <br>Leaks <b x-text="data.security_l1?.output_leakage?.outputs_with_leakage||0"></b>
        </div>
      </div>
    </div>

    <!-- 상세 패널 (클릭 시 표시) -->
    <div x-show="selB" style="margin:8px 0 10px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selB">
        <div>
          <div class="panel-header">
            <span class="val-md" x-text="bLabel[selB]"></span>
            <span class="tag-sm" x-text="selB==='input'?'Detections':selB==='exec'?'Violations':'Leakages'"></span>
            <button class="btn-close" @click="selB=null">×</button>
          </div>
          <div class="grid-2-divider">
            <div class="panel-bg2-r">
              <div class="label-upper">Description</div>
              <div class="body-text" style="white-space:pre-line" x-text="bDesc[selB]"></div>
            </div>
            <div class="panel-bg3">
              <div class="label-upper">📐 Calculation</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="bFormula(selB, data)"></div>
            </div>
          </div>
          <div class="panel-bg">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">Related Tasks</span>
              <span class="tag-sm" x-text="bFilterLabel(selB)"></span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="bItems(selB,data).length+' records'"></span>
            </div>
            <div class="dtx" style="max-height:220px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:170px minmax(0,1fr) 72px 60px;position:sticky;top:0;z-index:1">
                <span>Task ID</span><span>Type</span><span x-text="bCol3Label(selB)">Metric</span><span>Status</span>
              </div>
              <template x-for="t in bItems(selB,data)" :key="t.task_id">
                <div class="dtx-row" style="grid-template-columns:170px minmax(0,1fr) 72px 60px">
                  <span class="dtx-id" x-text="t.task_id"></span>
                  <span class="text-muted" x-text="t.task_type||'-'"></span>
                  <span :style="`color:${bCol3Color(selB,t)}`" x-text="bCol3Val(selB,t)"></span>
                  <span :class="(t.completion_score||0)>=1?'badge-ok':(t.completion_score||0)>=0.7?'badge-warn':'badge-ng'"
                        x-text="(t.completion_score||0)>=1?'Done':(t.completion_score||0)>=0.7?'Partial':'Fail'"></span>
                </div>
              </template>
              <div x-show="bItems(selB,data).length===0" style="padding:18px 10px;text-align:center;color:var(--text2);font-size:12px;line-height:1.6">
                <span x-text="selB==='exec'?'No tasks with tool calls found.':'No tasks with recorded security threat errors found.'"></span>
              </div>
            </div>
          </div>
        </div>
      </template>
    </div>

    <!-- 종합 판정 배너 -->
    <div x-data="{ _tot: inputT(data)+execV(data)+outputL(data) }"
         :style="`padding:8px 14px;border-radius:6px;font-size:11px;font-weight:600;border:1px solid ${_tot===0?'var(--green)':_tot<=3?'var(--yellow)':'var(--red)'};background:${_tot===0?'rgba(16,185,129,0.1)':_tot<=3?'rgba(245,158,11,0.1)':'rgba(239,68,68,0.1)'}`">
      <span :style="`color:${_tot===0?'var(--green)':_tot<=3?'var(--yellow)':'var(--red)'}`"
            x-text="_tot===0?'✅ No threats across all boundaries — PASS':_tot<=3?'⚠️ Minor threats detected ('+_tot+') — WARN':'🚨 Multiple threats detected ('+_tot+') — FAIL'">
      </span>
    </div>
  </div>

  <!-- Security Summary -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🛡 Security Score Summary<span class="grp-chip grp-E" style="margin-left:6px;font-size:9.5px">E Security Boundary</span></span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    score(k,d){
      if(k==='input_sec') return 100-(d.security_l1?.input_security?.threat_rate||0);
      if(k==='output_int') return 100-(d.security_l1?.output_leakage?.leakage_rate||0);
      if(k==='auth') return d.security_l1?.authorization?.compliance_rate??100;
      if(k==='priv_esc') return 100-(d.security_l2?.privilege_escalation?.escalation_rate||0);
      if(k==='atk_det'){const ad=d.security_l2?.attack_detection||{};const n=ad.total_chains_analyzed||0;return n===0?100:Math.max(0,100-(ad.detection_rate||0));}
      return 0;},
    formula(k,d){
      const is=d.security_l1?.input_security||{};
      const ol=d.security_l1?.output_leakage||{};
      const au=d.security_l1?.authorization||{};
      const pe=d.security_l2?.privilege_escalation||{};
      const ad=d.security_l2?.attack_detection||{};
      if(k==='input_sec'){
        const n=is.total_inputs_evaluated||(d.security_l1?.input_evals||[]).length||0;
        const th=is.inputs_with_threats||0;
        const total=(is.sql_injection_attempts||0)+(is.command_injection_attempts||0)+(is.path_traversal_attempts||0)+(is.xss_attempts||0)+(is.prompt_injection_attempts||0);
        return `Input Security = 100 − threat_rate
= 100 − ${(is.threat_rate||0).toFixed(1)}% = ${(100-(is.threat_rate||0)).toFixed(1)}%

Evaluated: ${n} / Threat inputs: ${th} (deduplicated)
Threat events: SQL ${is.sql_injection_attempts||0} + CMD ${is.command_injection_attempts||0} + PATH ${is.path_traversal_attempts||0} + XSS ${is.xss_attempts||0} + Prompt ${is.prompt_injection_attempts||0} = ${total}`;}
      if(k==='output_int'){
        const n=ol.total_outputs_evaluated||(d.security_l1?.output_detections||[]).length||0;
        return `Output Integrity = 100 − leakage_rate
= 100 − ${(ol.leakage_rate||0).toFixed(1)}% = ${(100-(ol.leakage_rate||0)).toFixed(1)}%

Evaluated: ${n} / Leakage detected: ${ol.outputs_with_leakage||0}
CRITICAL: ${ol.critical_severity_count||0} / HIGH: ${ol.high_severity_count||0}`;}
      if(k==='auth'){
        const n=au.total_tool_calls||0;
        return `Authorization Compliance = authorized / total × 100
= ${au.authorized_calls||0} / ${n} × 100 = ${(au.compliance_rate??100).toFixed(1)}%

Unauthorized: ${au.unauthorized_calls||0} / Dangerous params: ${au.dangerous_params||0}
Restricted attempts: ${au.restricted_attempts||0}`;}
      if(k==='priv_esc'){
        const er=pe.escalation_rate||0;
        return `Privilege Escalation Defense = 100 − escalation_rate
= 100 − ${er.toFixed(1)}% = ${(100-er).toFixed(1)}%

Total evaluated: ${pe.total_evaluations||0} / Detected: ${pe.escalations_detected||0}`;}
      if(k==='atk_det'){
        const n=ad.total_chains_analyzed||0;
        const s=ad.suspicious_chains||0;
        const safe=n===0?100:Math.max(0,100-(ad.detection_rate||0));
        return `Chain Safety Rate = 100 − detection_rate = 100 − ${(ad.detection_rate||0).toFixed(1)}% = ${safe.toFixed(1)}%
Analyzed chains: ${n} / Suspicious: ${s} / Safe: ${n-s}
(Lower detection rate = safer)`;}
      return '';},
    items(k,d){
      if(k==='input_sec') return (d.security_l1?.input_evals||[]).filter(e=>e.sanitization_needed);
      if(k==='output_int') return (d.security_l1?.output_detections||[]).filter(e=>(e.leakage_count||0)>0);
      if(k==='auth') return (d.security_l1?.tool_calls_detail||[]).filter(t=>!t.is_authorized||t.is_restricted||t.has_dangerous_params);
      if(k==='priv_esc') return (d.security_l2?.escalation_events||[]).filter(e=>e.escalation_detected);
      if(k==='atk_det') return (d.security_l2?.attack_detections||[]).filter(e=>e.is_suspicious_chain);
      return [];},
    desc(k){
      if(k==='input_sec') return 'Detects threat patterns in agent inputs. Checks 5 types: SQL Injection, Command Injection, Path Traversal, XSS, and Prompt Injection. Lower threat rate means a safer environment. Based on InputSanitizationTracker (Layer 1) results.';
      if(k==='output_int') return 'Detects sensitive data leaks in agent outputs. Checks 8 types: API Key, password, credit card, email, SSN, phone number, private IP, and file path. Based on OutputLeakageDetector (Layer 1); lower leakage rate means higher integrity.';
      if(k==='auth') return 'Measures whether the agent only calls tools within authorized scope. Detects unauthorized calls, dangerous parameter usage, and restricted tool attempts. Higher compliance means safer tool use. Based on ToolAuthorizationTracker (Layer 1).';
      if(k==='priv_esc') return 'Detects attempts to elevate privileges beyond initial authorization during execution. Lower escalation rate means better defense. PrivilegeEscalationDetector (Layer 2) compares initial and final privilege levels.';
      if(k==='atk_det') return 'Percentage of tool call chains with no attack patterns. Calculated as 100 − detection_rate; higher means fewer attack attempts and safer behavior. ToolChainAttackDetector (Layer 2) analyzes chain patterns, confidence, and attack sequences.';
      return '';},
  }">
    <div class="kpi-grid" style="grid-template-columns:repeat(5,1fr)">
      <div class="kpi kpi-act" :class="{sel:selK==='input_sec'}" @click="selK=selK==='input_sec'?null:'input_sec'">
        <div class="kpi-lbl" style="font-size:10px">Input Security (L1)</div>
        <div class="kpi-val icon-lg" :style="`color:${_bc(score('input_sec',data),90,70)}`"
             x-text="_pct(score('input_sec',data))"></div>
        <div class="kpi-sub" x-text="`Threats ${data.security_l1?.input_security?.inputs_with_threats||0} / ${data.security_l1?.input_security?.total_inputs_evaluated||(data.security_l1?.input_evals||[]).length||0}`"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='output_int'}" @click="selK=selK==='output_int'?null:'output_int'">
        <div class="kpi-lbl" style="font-size:10px">Output Integrity (L1)</div>
        <div class="kpi-val icon-lg" :style="`color:${_bc(score('output_int',data),90,70)}`"
             x-text="_pct(score('output_int',data))"></div>
        <div class="kpi-sub" x-text="`Leaks ${data.security_l1?.output_leakage?.outputs_with_leakage||0} / ${data.security_l1?.output_leakage?.total_outputs_evaluated||(data.security_l1?.output_detections||[]).length||0}`"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='auth'}" @click="selK=selK==='auth'?null:'auth'">
        <div class="kpi-lbl" style="font-size:10px">Auth Compliance (L1)</div>
        <div class="kpi-val icon-lg" :style="`color:${_bc(score('auth',data),90,70)}`"
             x-text="_pct(score('auth',data))"></div>
        <div class="kpi-sub" x-text="`Unauth ${data.security_l1?.authorization?.unauthorized_calls||0} / ${data.security_l1?.authorization?.total_tool_calls||0}`"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='priv_esc'}" @click="selK=selK==='priv_esc'?null:'priv_esc'">
        <div class="kpi-lbl" style="font-size:10px">Priv. Escalation (L2)</div>
        <div class="kpi-val icon-lg" :style="`color:${_bc(score('priv_esc',data),90,70)}`"
             x-text="_pct(score('priv_esc',data))"></div>
        <div class="kpi-sub" x-text="`Detected ${data.security_l2?.privilege_escalation?.escalations_detected||0} / ${data.security_l2?.privilege_escalation?.total_evaluations||0}`"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='atk_det'}" @click="selK=selK==='atk_det'?null:'atk_det'">
        <div class="kpi-lbl" style="font-size:10px">Chain Safety (L2)</div>
        <div class="kpi-val icon-lg" :style="`color:${_bc(score('atk_det',data),90,70)}`"
             x-text="_pct(score('atk_det',data))"></div>
        <div class="kpi-sub" x-text="`Suspicious ${data.security_l2?.attack_detection?.suspicious_chains||0} / ${data.security_l2?.attack_detection?.total_chains_analyzed||0}`"></div>
      </div>
    </div>

    <!-- 종합 점수 상세 패널 -->
    <div x-show="selK" style="margin:8px 0 12px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <!-- 헤더 -->
          <div class="panel-header">
            <span class="val-md" x-text="{input_sec:'Input Security (L1)',output_int:'Output Integrity (L1)',auth:'Auth Compliance (L1)',priv_esc:'Priv. Escalation (L2)',atk_det:'Chain Safety (L2)'}[selK]||selK"></span>
            <span style="font-size:20px;font-weight:700;margin-left:4px" :style="`color:${_bc(score(selK,data),90,70)}`" x-text="_pct(score(selK,data))"></span>
            <span style="font-size:11px;background:var(--bg3);color:var(--text2);padding:1px 8px;border-radius:99px"
                  :class="score(selK,data)>=90?'badge-ok':score(selK,data)>=70?'badge-warn':'badge-ng'"
                  x-text="score(selK,data)>=90?'Good':score(selK,data)>=70?'Caution':'Risk'"></span>
            <button class="btn-close" @click="selK=null">×</button>
          </div>
          <!-- 설명 + 산출 방식 -->
          <div class="grid-2-divider">
            <div class="panel-bg2-r">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:6px;text-transform:uppercase">📋 Description</div>
              <div style="font-size:12px;color:var(--text1);line-height:1.7" x-text="desc(selK)"></div>
            </div>
            <div class="panel-bg3">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:6px;text-transform:uppercase">📐 Calculation</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.9;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <!-- 관련 이벤트 테이블 -->
          <div x-show="items(selK,data).length" class="panel-bg">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase"
                    x-text="{input_sec:'Threat Detection Inputs',output_int:'Leakage Detection Outputs',auth:'Unauthorized Tool Calls',priv_esc:'Privilege Escalation Events',atk_det:'Suspicious Attack Chains'}[selK]||'Related Events'"></span>
              <span class="tag-sm" x-text="items(selK,data).length+' tasks'"></span>
            </div>
            <!-- 입력 보안 이벤트 테이블 -->
            <template x-if="selK==='input_sec'">
              <div class="dtx" style="max-height:200px;overflow-y:auto">
                <div class="dtx-row dtx-head" style="grid-template-columns:1fr 50px 50px 50px 50px 50px">
                  <span>Task ID</span><span>SQL</span><span>CMD</span><span>XSS</span><span>Prompt</span><span>Risk</span>
                </div>
                <template x-for="(e,i) in items(selK,data).slice(0,20)" :key="i">
                  <div class="dtx-row" style="background:rgba(220,50,50,0.05);grid-template-columns:1fr 50px 50px 50px 50px 50px">
                    <span style="font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="e.task_id||'—'"></span>
                    <span :class="e.has_sql_injection?'badge-ng':''" x-text="e.has_sql_injection?'✓':'—'"></span>
                    <span :class="e.has_command_injection?'badge-ng':''" x-text="e.has_command_injection?'✓':'—'"></span>
                    <span :class="e.has_xss?'badge-ng':''" x-text="e.has_xss?'✓':'—'"></span>
                    <span :class="e.has_prompt_injection?'badge-ng':''" x-text="e.has_prompt_injection?'✓':'—'"></span>
                    <span style="font-size:10px;color:var(--red)" x-text="e.risk_level||e.severity||'—'"></span>
                  </div>
                </template>
              </div>
            </template>
            <!-- 출력 유출 이벤트 테이블 -->
            <template x-if="selK==='output_int'">
              <div class="dtx" style="max-height:200px;overflow-y:auto">
                <div class="dtx-row dtx-head" style="grid-template-columns:1fr 50px 60px 60px 60px 60px 60px">
                  <span>Task ID</span><span>Leaks</span><span>API Key</span><span>Password</span><span>Email</span><span>Credit Card</span><span>Severity</span>
                </div>
                <template x-for="(e,i) in items(selK,data).slice(0,20)" :key="i">
                  <div class="dtx-row" style="background:rgba(220,50,50,0.05);grid-template-columns:1fr 50px 60px 60px 60px 60px 60px">
                    <span style="font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="e.task_id||'—'"></span>
                    <span style="color:var(--red)" x-text="e.leakage_count||0"></span>
                    <span :class="e.contains_api_key?'badge-ng':''" x-text="e.contains_api_key?'✓':'—'"></span>
                    <span :class="e.contains_password?'badge-ng':''" x-text="e.contains_password?'✓':'—'"></span>
                    <span :class="e.contains_email?'badge-ng':''" x-text="e.contains_email?'✓':'—'"></span>
                    <span :class="e.contains_credit_card?'badge-ng':''" x-text="e.contains_credit_card?'✓':'—'"></span>
                    <span style="font-size:10px;color:var(--red)" x-text="e.severity||'—'"></span>
                  </div>
                </template>
              </div>
            </template>
            <!-- 권한 위반 도구 호출 테이블 -->
            <template x-if="selK==='auth'">
              <div class="dtx" style="max-height:200px;overflow-y:auto">
                <div class="dtx-row dtx-head" style="grid-template-columns:1fr minmax(80px,1fr) 70px 70px 70px">
                  <span>Task ID</span><span>Tool Name</span><span>Auth</span><span>Restricted</span><span>Dangerous Params</span>
                </div>
                <template x-for="(e,i) in items(selK,data).slice(0,20)" :key="i">
                  <div class="dtx-row" :style="`background:${!e.is_authorized?'rgba(220,50,50,0.05)':'rgba(245,158,11,0.05)'};grid-template-columns:1fr minmax(80px,1fr) 70px 70px 70px`">
                    <span style="font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="e.task_id||'—'"></span>
                    <span class="text-xs-muted" x-text="e.tool_name||'—'"></span>
                    <span :class="e.is_authorized?'badge-ok':'badge-ng'" x-text="e.is_authorized?'Auth':'Unauth'"></span>
                    <span :class="e.is_restricted?'badge-warn':''" x-text="e.is_restricted?'Restricted':'—'"></span>
                    <span :class="e.has_dangerous_params?'badge-ng':''" x-text="e.has_dangerous_params?'Dangerous':'—'"></span>
                  </div>
                </template>
              </div>
            </template>
            <!-- 권한상승 이벤트 테이블 -->
            <template x-if="selK==='priv_esc'">
              <div class="dtx" style="max-height:200px;overflow-y:auto">
                <div class="dtx-row dtx-head" style="grid-template-columns:1fr 80px 80px 80px 1fr">
                  <span>Task ID</span><span>Init Priv</span><span>Final Priv</span><span>Detected</span><span>Tool Path</span>
                </div>
                <template x-for="(e,i) in items(selK,data).slice(0,15)" :key="i">
                  <div class="dtx-row" style="background:rgba(220,50,50,0.05);grid-template-columns:1fr 80px 80px 80px 1fr">
                    <span style="font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="e.task_id||'—'"></span>
                    <span style="font-size:10px" x-text="e.initial_privilege??e.initial_privilege_level??'—'"></span>
                    <span style="font-size:10px" x-text="e.final_privilege??e.final_privilege_level??'—'"></span>
                    <span class="badge-ng">Detected</span>
                    <span class="text-xs-muted" x-text="(e.escalation_path||[]).join(' → ')||'—'"></span>
                  </div>
                </template>
              </div>
            </template>
            <!-- 공격 체인 탐지 테이블 -->
            <template x-if="selK==='atk_det'">
              <div class="dtx" style="max-height:200px;overflow-y:auto">
                <div class="dtx-row dtx-head" style="grid-template-columns:1fr 70px 70px 70px 1fr">
                  <span>Task ID</span><span>Chain Len</span><span>Confidence</span><span>Suspicious</span><span>Detected Pattern</span>
                </div>
                <template x-for="(e,i) in items(selK,data).slice(0,15)" :key="i">
                  <div class="dtx-row" style="background:rgba(220,50,50,0.05);grid-template-columns:1fr 70px 70px 70px 1fr">
                    <span style="font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="e.task_id||'—'"></span>
                    <span style="font-size:10px" x-text="e.chain_length??'—'"></span>
                    <span style="font-size:10px" x-text="(e.confidence_score??e.confidence)!=null?(e.confidence_score??e.confidence).toFixed(2):'—'"></span>
                    <span class="badge-ng">Suspicious</span>
                    <span class="text-xs-muted" x-text="(e.attack_patterns_detected||e.attack_patterns||[]).join(', ')||'—'"></span>
                  </div>
                </template>
              </div>
            </template>
          </div>
          <!-- 이벤트 없음 메시지 -->
          <div x-show="!items(selK,data).length" style="padding:12px 14px;background:var(--bg);text-align:center;font-size:12px;color:var(--green)">
            ✓ No security events — status is normal
          </div>
        </div>
      </template>
    </div>

    <div class="cbox" style="margin-bottom:12px">
      <div class="ct">Security Score by Layer — Simple Average</div>
      <div id="d2-sec-summary" class="plt-chart"></div>
    </div>
    <!-- Risk gauge bars -->
    <div class="sec">
      <div class="sec-t">Security Risk Level</div>
      <template x-for="item in [
        {label:'Input Security (L1)',val:(100-(data.security_l1?.input_security?.threat_rate||0))},
        {label:'Output Integrity (L1)',val:(100-(data.security_l1?.output_leakage?.leakage_rate||0))},
        {label:'Auth Compliance (L1)',val:(data.security_l1?.authorization?.compliance_rate??100)},
        {label:'Priv. Escalation (L2)',val:(100-(data.security_l2?.privilege_escalation?.escalation_rate||0))},
        {label:'Chain Safety (L2)',val:(()=>{const ad=data.security_l2?.attack_detection||{};const n=ad.total_chains_analyzed||0;return n===0?100:Math.max(0,100-(ad.detection_rate||0));})()},
      ]" :key="item.label">
        <div class="rg">
          <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:3px">
            <span class="muted" x-text="item.label"></span>
            <span :style="`color:${_bc(item.val,90,70)}`" x-text="_pct(item.val)"></span>
          </div>
          <div class="rgt"><div class="rgf" :style="`width:${item.val}%;background:${_bc(item.val,90,70)}`"></div></div>
        </div>
      </template>
    </div>
  </div>

  <!-- L1 Input Security -->
  <div id="s-sec-input" class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">L1 · Input Threat Detection<span class="grp-chip grp-E" style="margin-left:6px;font-size:9.5px">E Security Boundary</span></span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      input_evals:{label:'Evaluated Inputs',unit:'',desc:'Total inputs inspected by InputSanitizationTracker for security analysis. Represents security evaluation coverage; compare to total task count to check for missed evaluations.',hint:'security_l1.input_evals (count)'},
      threat_inputs:{label:'Threat Inputs',unit:'',desc:'Number of tasks detected as containing one or more threat patterns (deduplicated). Indicates how many malicious inputs the agent was exposed to, used to gauge actual attack attempt frequency.',hint:'threat tasks deduplicated'},
      threat_events:{label:'Threat Events',unit:'',desc:'Total count of detected threats across all types. Multiple threat types in one task are counted separately. Useful for identifying the most frequent attack types to prioritize defenses.',hint:'sum of all threat type counts'},
      sql_injection:{label:'SQL Injection',unit:'',desc:'Number of SQL injection attack attempts detected. Attempts to manipulate DB queries for unauthorized data access or deletion — especially dangerous when the agent uses DB-connected tools.',hint:'has_sql_injection count'},
      cmd_injection:{label:'Command Injection',unit:'',desc:'Number of command injection attack attempts detected. Attempts to insert system commands into inputs to remotely control the server — critical for agents using code execution or file system tools.',hint:'has_command_injection count'},
      path_traversal:{label:'Path Traversal',unit:'',desc:'Number of path traversal attack attempts detected. Detects attempts to access sensitive system files outside the allowed directory scope.',hint:'has_path_traversal count'},
      xss:{label:'XSS',unit:'',desc:'Number of Cross-Site Scripting (XSS) attack patterns detected. Attempts to inject malicious scripts to execute in users\' browsers — dangerous when agent output is displayed on the web.',hint:'has_xss count'},
      prompt_injection:{label:'Prompt Injection',unit:'',desc:'Number of prompt injection attack attempts detected. Attempts to neutralize the system prompt or intentionally manipulate agent behavior — the most common and unique threat to LLM-based agents.',hint:'has_prompt_injection count'},
    },
    formula(k,d){
      const is=d.security_l1?.input_security||{};
      const n=is.total_inputs_evaluated||(d.security_l1?.input_evals||[]).length||0;
      const total=(is.sql_injection_attempts||0)+(is.command_injection_attempts||0)+(is.path_traversal_attempts||0)+(is.xss_attempts||0)+(is.prompt_injection_attempts||0);
      if(k==='input_evals')return `Evaluated inputs = ${n}\n(All inputs inspected by InputSanitizationTracker)\nThreats found: ${is.inputs_with_threats||0} / Threat rate: ${(is.threat_rate||0).toFixed(1)}%`;
      if(k==='threat_inputs')return `Threat inputs = ${is.inputs_with_threats||0} (deduplicated)\nThreat rate = ${is.inputs_with_threats||0} / ${n} × 100 = ${(is.threat_rate||0).toFixed(1)}%`;
      if(k==='threat_events')return `Threat events = sum by type (duplicates allowed)\nSQL ${is.sql_injection_attempts||0} + CMD ${is.command_injection_attempts||0} + PATH ${is.path_traversal_attempts||0} + XSS ${is.xss_attempts||0} + Prompt ${is.prompt_injection_attempts||0} = ${total}`;
      if(k==='sql_injection')return `SQL Injection = ${is.sql_injection_attempts||0} / ${n} evaluated\n(has_sql_injection flag count)`;
      if(k==='cmd_injection')return `Command Injection = ${is.command_injection_attempts||0} / ${n} evaluated\n(has_command_injection flag count)`;
      if(k==='path_traversal')return `Path Traversal = ${is.path_traversal_attempts||0} / ${n} evaluated\n(has_path_traversal flag count)`;
      if(k==='xss')return `XSS = ${is.xss_attempts||0} / ${n} evaluated\n(has_xss flag count)`;
      if(k==='prompt_injection')return `Prompt Injection = ${is.prompt_injection_attempts||0} / ${n} evaluated\n(has_prompt_injection flag count)`;
      return '';},
    items(k,d){
      const evs=d.security_l1?.input_evals||[];
      if(k==='input_evals') return evs;
      if(k==='threat_inputs'||k==='threat_events') return evs.filter(e=>e.sanitization_needed);
      const flag={sql_injection:'has_sql_injection',cmd_injection:'has_command_injection',path_traversal:'has_path_traversal',xss:'has_xss',prompt_injection:'has_prompt_injection'}[k];
      return flag ? evs.filter(e=>e[flag]) : evs;},
    filterLabel(k){return 'Detection Log';}
  ">
    <div class="kpi-grid" style="grid-template-columns:repeat(auto-fill,minmax(120px,1fr))">
      <div class="kpi kpi-act" :class="{sel:selK==='input_evals'}" @click="selK=selK==='input_evals'?null:'input_evals'">
        <div class="kpi-lbl">Evaluated Inputs</div>
        <div class="kpi-val icon-lg" x-text="data.security_l1?.input_security?.total_inputs_evaluated||(data.security_l1?.input_evals||[]).length||0"></div>
        <div class="kpi-sub" x-text="`Threat rate ${(data.security_l1?.input_security?.threat_rate||0).toFixed(1)}%`"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='threat_inputs'}" @click="selK=selK==='threat_inputs'?null:'threat_inputs'">
        <div class="kpi-lbl">Threat Inputs</div>
        <div class="kpi-val" style="font-size:20px;color:var(--red)" x-text="data.security_l1?.input_security?.inputs_with_threats||0"></div>
        <div class="kpi-sub" x-text="(data.security_l1?.input_security?.inputs_with_threats||0)>0?'⚠ Threats detected':'✓ All clear'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='threat_events'}" @click="selK=selK==='threat_events'?null:'threat_events'">
        <div class="kpi-lbl">Threat Events</div>
        <div class="kpi-val" style="font-size:20px;color:var(--orange)" x-text="(()=>{const is=data.security_l1?.input_security||{};return (is.sql_injection_attempts||0)+(is.command_injection_attempts||0)+(is.path_traversal_attempts||0)+(is.xss_attempts||0)+(is.prompt_injection_attempts||0);})()"></div>
        <div class="kpi-sub">Duplicates allowed per type</div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='sql_injection'}" @click="selK=selK==='sql_injection'?null:'sql_injection'">
        <div class="kpi-lbl">SQL Injection</div>
        <div class="kpi-val icon-lg" :style="`color:${(data.security_l1?.input_security?.sql_injection_attempts||0)>0?'var(--red)':'var(--green)'}`"
             x-text="data.security_l1?.input_security?.sql_injection_attempts||0"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='cmd_injection'}" @click="selK=selK==='cmd_injection'?null:'cmd_injection'">
        <div class="kpi-lbl">Command Injection</div>
        <div class="kpi-val icon-lg" :style="`color:${(data.security_l1?.input_security?.command_injection_attempts||0)>0?'var(--red)':'var(--green)'}`"
             x-text="data.security_l1?.input_security?.command_injection_attempts||0"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='xss'}" @click="selK=selK==='xss'?null:'xss'">
        <div class="kpi-lbl">XSS</div>
        <div class="kpi-val icon-lg" :style="`color:${(data.security_l1?.input_security?.xss_attempts||0)>0?'var(--red)':'var(--green)'}`"
             x-text="data.security_l1?.input_security?.xss_attempts||0"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='prompt_injection'}" @click="selK=selK==='prompt_injection'?null:'prompt_injection'">
        <div class="kpi-lbl">Prompt Injection</div>
        <div class="kpi-val icon-lg" :style="`color:${(data.security_l1?.input_security?.prompt_injection_attempts||0)>0?'var(--red)':'var(--green)'}`"
             x-text="data.security_l1?.input_security?.prompt_injection_attempts||0"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='path_traversal'}" @click="selK=selK==='path_traversal'?null:'path_traversal'">
        <div class="kpi-lbl">Path Traversal</div>
        <div class="kpi-val icon-lg" :style="`color:${(data.security_l1?.input_security?.path_traversal_attempts||0)>0?'var(--red)':'var(--green)'}`"
             x-text="data.security_l1?.input_security?.path_traversal_attempts||0"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div class="panel-header">
            <span class="val-md" x-text="meta[selK]?.label||selK"></span>
            <template x-if="selK==='attack_detections'">
              <span style="font-size:11px;color:var(--text2);margin-left:4px"
                    x-text="`(${items(selK,data).length} analyzed · ${(data.security_l2?.attack_detection?.suspicious_chains||0)} suspicious)`"></span>
            </template>
