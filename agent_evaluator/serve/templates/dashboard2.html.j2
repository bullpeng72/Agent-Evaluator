                </div>
                <div class="dtx" style="max-height:180px;overflow-y:auto" x-show="(data.tasks||[]).length">
                  <div class="dtx-row dtx-head" style="grid-template-columns:minmax(100px,1.5fr) 80px 70px 50px;position:sticky;top:0;z-index:1">
                    <span>Task ID</span><span>Type</span><span>Completion</span><span>Status</span>
                  </div>
                  <template x-for="t in [...(data.tasks||[])].sort((a,b)=>(a.completion_score||0)-(b.completion_score||0)).slice(0,20)" :key="t.task_id">
                    <div class="dtx-row" style="grid-template-columns:minmax(100px,1.5fr) 80px 70px 50px">
                      <span class="dtx-id" x-text="t.task_id"></span>
                      <span class="text-muted" x-text="t.task_type||'-'"></span>
                      <span :style="`color:${(t.completion_score||0)>=0.9?'var(--green)':(t.completion_score||0)>=0.7?'var(--yellow)':'var(--red)'}`"
                            x-text="((t.completion_score||0)*100).toFixed(0)+'%'"></span>
                      <span :class="(t.completion_score||0)>=1?'badge-ok':(t.completion_score||0)>=0.7?'badge-warn':'badge-ng'"
                            x-text="(t.completion_score||0)>=1?'Done':(t.completion_score||0)>=0.7?'Partial':'Fail'"></span>
                    </div>
                  </template>
                </div>
              </div>
          </div>
        </template>
      </div>
    </div>
  </template>

  <template x-if="!anomalyData?.count">
    <div style="text-align:center;padding:48px;color:var(--text2)">
      <div style="font-size:32px;margin-bottom:8px">✅</div>
      <div style="font-weight:600;margin-bottom:6px">No Anomalies</div>
      <div style="font-size:12px">No anomalies detected, or <code>AnomalyDetector</code> has not run yet.</div>
    </div>
  </template>

  <template x-if="anomalyData?.count > 0">
    <div x-data="{
      anomalySelK: null,
      anomalyMeta: {
        count:    {label:'Detected Anomalies', unit:'items', desc:'Total number of anomaly patterns detected by AnomalyDetector. Detects accuracy drops, token spikes, error surges, and security threats using Z-score, IQR, and linear regression algorithms.'},
        critical: {label:'Critical',   unit:'items', desc:'Severe anomalies requiring immediate action. Current value greatly exceeds threshold or directly impacts service (accuracy drop, error surge, suspected security attack, etc.).'},
        warning:  {label:'Warning',    unit:'items', desc:'Anomalies requiring close monitoring. Slightly exceed thresholds or show deteriorating trends; not immediately critical but may escalate if left unaddressed.'},
      },
      anomalyFormula(k, d) {
        const anomalies = d.anomalies || [];
        const crit = anomalies.filter(a=>a.severity==='critical').length;
        const warn = anomalies.filter(a=>a.severity==='warning').length;
        const algos = [...new Set(anomalies.map(a=>a.algorithm).filter(Boolean))];
        if (k === 'count')    return `Detected Anomalies = Critical + Warning\n= ${crit} + ${warn} = ${d.count} items\n\nAlgorithms used:\n${algos.length?algos.map(a=>  a).join(', '):'(no info)'}`;
        if (k === 'critical') return `Critical = ${crit} items\nOf total: ${d.count>0?(crit/d.count*100).toFixed(1):0}%\n\nBy type:\n${anomalies.filter(a=>a.severity==='critical').map(a=> a.type.replaceAll('_',' ')).join('\n')||'none'}`;
        if (k === 'warning')  return `Warning = ${warn} items\nOf total: ${d.count>0?(warn/d.count*100).toFixed(1):0}%\n\nBy type:\n${anomalies.filter(a=>a.severity==='warning').map(a=> a.type.replaceAll('_',' ')).join('\n')||'none'}`;
        return '';
      },
      anomalyItems(k, d) {
        const anomalies = d.anomalies || [];
        if (k === 'critical') return anomalies.filter(a=>a.severity==='critical');
        if (k === 'warning')  return anomalies.filter(a=>a.severity==='warning');
        return anomalies;
      }
    }">
      <!-- KPI 카드 -->
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;margin-bottom:8px">
        <div class="kpi kpi-act" :class="{sel:anomalySelK==='count'}" @click="anomalySelK=anomalySelK==='count'?null:'count'">
          <div class="text-muted">Detected Anomalies</div>
          <div style="font-size:22px;font-weight:700" x-text="anomalyData.count"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:anomalySelK==='critical'}" @click="anomalySelK=anomalySelK==='critical'?null:'critical'">
          <div class="text-muted">Critical</div>
          <div style="font-size:22px;font-weight:700;color:#ef4444" x-text="anomalyData.critical"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:anomalySelK==='warning'}" @click="anomalySelK=anomalySelK==='warning'?null:'warning'">
          <div class="text-muted">Warning</div>
          <div style="font-size:22px;font-weight:700;color:#f59e0b" x-text="anomalyData.warning"></div>
        </div>
      </div>

      <!-- KPI 상세 패널 -->
      <div x-show="anomalySelK" style="margin:0 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
        <template x-if="anomalySelK">
          <div>
            <div class="panel-header">
              <span class="val-md" x-text="anomalyMeta[anomalySelK]?.label||anomalySelK"></span>
              <span class="tag-sm" x-text="anomalyMeta[anomalySelK]?.unit?'Unit: '+anomalyMeta[anomalySelK].unit:''"></span>
              <button class="btn-close" @click="anomalySelK=null">×</button>
            </div>
            <div class="grid-2-divider">
              <div class="panel-bg2-r">
                <div class="label-upper">Description</div>
                <div class="body-text" x-text="anomalyMeta[anomalySelK]?.desc||''"></div>
              </div>
              <div class="panel-bg3">
                <div class="label-upper">📐 Calculation</div>
                <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="anomalyFormula(anomalySelK, anomalyData)"></div>
              </div>
            </div>
            <div class="panel-bg">
              <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
                <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">Related Anomalies</span>
                <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="anomalyItems(anomalySelK, anomalyData).length+' items'"></span>
              </div>
              <div class="dtx" style="max-height:240px;overflow-y:auto">
                <div class="dtx-row dtx-head" style="grid-template-columns:minmax(130px,1fr) 72px 80px 80px 150px;position:sticky;top:0;z-index:1">
                  <span>Type</span><span>Severity</span><span>Current</span><span>Threshold</span><span>Detected At</span>
                </div>
                <template x-for="a in anomalyItems(anomalySelK, anomalyData)" :key="a.type+a.detected_at">
                  <div class="dtx-row" style="grid-template-columns:minmax(130px,1fr) 72px 80px 80px 150px"
                       :title="a.detail">
                    <span class="dtx-id" x-text="a.type.replaceAll('_',' ').toUpperCase()"></span>
                    <span style="font-size:11px;padding:1px 6px;border-radius:10px;white-space:nowrap"
                          :style="a.severity==='critical'?'background:rgba(239,68,68,.15);color:#ef4444':'background:rgba(245,158,11,.15);color:#f59e0b'"
                          x-text="a.severity"></span>
                    <span :style="a.severity==='critical'?'color:#ef4444':'color:#f59e0b';font-weight:700"
                          x-text="typeof a.value==='number'?a.value.toFixed(4):a.value"></span>
                    <span class="muted" x-text="typeof a.threshold==='number'?a.threshold.toFixed(4):a.threshold"></span>
                    <span class="muted" x-text="a.detected_at?.substring(0,19).replace('T',' ')"></span>
                  </div>
                </template>
              </div>
            </div>
          </div>
        </template>
      </div>

      <!-- 이상 카드 목록 (KPI 카드 미선택 시에만 표시) -->
      <template x-if="!anomalySelK">
        <div class="kpi" style="padding:0;overflow:hidden">
          <div style="padding:10px 14px;font-weight:600;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px">
            <span>Detected Anomaly List</span>
            <span class="tag-sm" x-text="(anomalyData.anomalies||[]).length+' items'"></span>
          </div>
          <table style="width:100%;border-collapse:collapse;font-size:12px">
            <thead>
              <tr style="background:var(--bg3);color:var(--text2)">
                <th style="padding:7px 12px;text-align:left">Type</th>
                <th style="padding:7px 12px;text-align:center">Severity</th>
                <th style="padding:7px 12px;text-align:left;max-width:320px">Detail</th>
                <th style="padding:7px 12px;text-align:center">Current</th>
                <th style="padding:7px 12px;text-align:center">Threshold</th>
                <th style="padding:7px 12px;text-align:center">Algorithm</th>
                <th style="padding:7px 12px;text-align:center">Detected At</th>
              </tr>
            </thead>
            <tbody>
              <template x-for="a in (anomalyData.anomalies||[])" :key="a.type+a.detected_at">
                <tr style="border-top:1px solid var(--border)"
                    :style="a.severity==='critical'?'border-left:3px solid #ef4444':'border-left:3px solid #f59e0b'">
                  <td style="padding:8px 12px;font-weight:700">
                    <span style="font-size:14px;margin-right:6px" x-text="a.severity==='critical'?'🚨':'⚠️'"></span>
                    <span x-text="a.type.replaceAll('_',' ').toUpperCase()"></span>
                  </td>
                  <td style="padding:8px 12px;text-align:center">
                    <span style="font-size:11px;padding:2px 8px;border-radius:10px"
                          :style="a.severity==='critical'?'background:rgba(239,68,68,.15);color:#ef4444':'background:rgba(245,158,11,.15);color:#f59e0b'"
                          x-text="a.severity"></span>
                  </td>
                  <td style="padding:8px 12px;color:var(--text2);max-width:320px" x-text="a.detail"></td>
                  <td style="padding:8px 12px;text-align:center;font-weight:700"
                      :style="a.severity==='critical'?'color:#ef4444':'color:#f59e0b'"
                      x-text="typeof a.value==='number'?a.value.toFixed(4):a.value"></td>
                  <td style="padding:8px 12px;text-align:center;color:var(--text2)"
                      x-text="typeof a.threshold==='number'?a.threshold.toFixed(4):a.threshold"></td>
                  <td style="padding:8px 12px;text-align:center;color:var(--text2);font-family:monospace;font-size:11px"
                      x-text="a.algorithm||'—'"></td>
                  <td style="padding:8px 12px;text-align:center;color:var(--text2);white-space:nowrap"
                      x-text="a.detected_at?.substring(0,19).replace('T',' ')"></td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>
      </template>
    </div>
  </template>
</section>

<!-- ══════════════════════════════════════════════════════════════
     Phase 3-C  평가 비용
═══════════════════════════════════════════════════════════════ -->
<section id="s-cost" class="sec" x-show="sec==='cost'" x-cloak>
  <div style="font-weight:700;font-size:15px;margin-bottom:4px">💰 Evaluation Cost</div>
  <div style="color:var(--text2);font-size:12px;margin-bottom:10px">Track external evaluation call costs: LLM Judge · DeepEval · Ragas</div>

  <!-- 용도 안내 배너 -->
  <div style="background:var(--bg3);border:1px solid var(--border);border-left:3px solid #6366f1;border-radius:6px;padding:10px 14px;font-size:12px;color:var(--text2);margin-bottom:16px;line-height:1.7">
    <div style="font-weight:600;color:var(--text1);margin-bottom:4px">🔍 About This Tab</div>
    <div>Tracks <strong>LLM Judge · DeepEval · Ragas</strong> external evaluation API call costs by provider, and visualizes daily budget consumption and projected costs. <strong>AdaptivePolicy</strong> automatically lowers the sampling rate when budget overrun is detected to prevent overspending.</div>
    <div style="margin-top:6px;padding-top:6px;border-top:1px solid var(--border)">
      🛠️ <strong>How to Enable</strong>:
      Use <code style="background:var(--bg2);padding:1px 6px;border-radius:3px;font-size:11px">CostTracker</code> + <code style="background:var(--bg2);padding:1px 6px;border-radius:3px;font-size:11px">AdaptivePolicy</code>, or
      enable auto-tracking with <code style="background:var(--bg2);padding:1px 6px;border-radius:3px;font-size:11px">HybridPerformanceMonitor(enable_llm_judge=True)</code>.
    </div>
  </div>

  <template x-if="!costData?.total_usd">
    <div style="text-align:center;padding:48px;color:var(--text2)">
      <div style="font-size:32px;margin-bottom:8px">💰</div>
      <div style="font-weight:600;margin-bottom:6px">No Cost Data</div>
      <div style="font-size:12px">Run evaluation with <code>enable_llm_judge=True</code> or use <code>CostTracker</code>.</div>
    </div>
  </template>

  <template x-if="costData?.total_usd > 0">
    <div x-data="{
      costSelK: null,
      costMeta: {
        total_usd:       {label:'Today\'s Total Cost',   unit:'$',  desc:'Cumulative cost of external evaluation API calls (LLM Judge · DeepEval · Ragas) incurred today. Sum across all providers recorded by CostTracker.'},
        budget_remaining:{label:'Budget Remaining',       unit:'$',  desc:'Daily budget limit minus cost used so far. Displays "No Limit" if no limit is set. Shown in warning color when remaining budget falls below 20%.'},
        projected_daily: {label:'Projected Daily Cost',   unit:'$',  desc:'Estimated full-day cost based on current call frequency. Actual cost may be higher when sampling rate is low.'},
        sample_rate:     {label:'Current Sampling Rate',  unit:'%',  desc:'Current evaluation sampling ratio set by AdaptivePolicy. Automatically reduced when budget overrun is likely. 100% means all tasks are being evaluated.'},
        call_count:      {label:'Call Count',         unit:'calls', desc:'Total number of external evaluation API calls made today. Efficiency = total cost / call count (cost per call).'},
      },
      costFormula(k, d) {
        const providers = Object.entries(d.by_provider||{});
        if (k === 'total_usd') {
          const perCall = d.call_count > 0 ? (d.total_usd / d.call_count) : 0;
          const prov = providers.length > 0 ? providers.map(([p,v])=>`  ${p}: $${parseFloat(v).toFixed(4)}`).join('\n') : '  (no provider data)';
          return `Total Cost = Σ(cost by provider)\n= $${(d.total_usd||0).toFixed(4)}\n\nBy provider:\n${prov}\n\nAvg per call: $${perCall.toFixed(5)}`;
        }
        if (k === 'budget_remaining') {
          const budget = d.budget_per_day;
          if (budget == null) return 'Daily budget limit not set\nConfigure with CostTracker(budget_per_day=0.10).';
          const used = budget - (d.budget_remaining_usd||0);
          const pct = budget > 0 ? (used/budget*100).toFixed(1) : 0;
          return `Budget Remaining = Daily Limit − Used\n= $${budget.toFixed(4)} − $${used.toFixed(4)}\n= $${(d.budget_remaining_usd||0).toFixed(4)}\n\nUsage rate: ${pct}%`;
        }
        if (k === 'projected_daily') {
          return `Projected Daily Cost = Current Cost × (24h / elapsed time)\n= $${(d.projected_daily_usd||0).toFixed(4)}\n\n※ Based on sampling rate ${((d.sample_rate_current||0)*100).toFixed(0)}%`;
        }
        if (k === 'sample_rate') {
          return `Current Sampling Rate = ${((d.sample_rate_current||0)*100).toFixed(0)}%\n\nAdaptivePolicy stages:\n  FULL(100%) → drops to 50% at 50% budget consumed\n  REDUCED(50%) → drops to 10% at 80% budget consumed\n  MINIMAL(10%) → at 90%+ budget consumed`;
        }
        if (k === 'call_count') {
          const perCall = d.call_count > 0 ? (d.total_usd / d.call_count) : 0;
          return `Call Count = ${d.call_count||0}\nAvg cost per call: $${perCall.toFixed(5)}\nTotal cost: $${(d.total_usd||0).toFixed(4)}`;
        }
        return '';
      }
    }">
      <!-- KPI 카드 -->
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;margin-bottom:8px">
        <div class="kpi kpi-act" :class="{sel:costSelK==='total_usd'}" @click="costSelK=costSelK==='total_usd'?null:'total_usd'">
          <div class="text-muted">Today's Total Cost</div>
          <div style="font-size:22px;font-weight:700;color:var(--accent)" x-text="'$'+(costData.total_usd||0).toFixed(4)"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:costSelK==='budget_remaining'}" @click="costSelK=costSelK==='budget_remaining'?null:'budget_remaining'">
          <div class="text-muted">Budget Remaining</div>
          <div style="font-size:22px;font-weight:700"
               x-text="costData.budget_remaining_usd!=null ? '$'+costData.budget_remaining_usd.toFixed(4) : 'No Limit'"
               :style="costData.budget_remaining_usd!=null && costData.budget_remaining_usd < costData.budget_per_day*0.2 ? 'color:var(--red)' : ''"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:costSelK==='projected_daily'}" @click="costSelK=costSelK==='projected_daily'?null:'projected_daily'">
          <div class="text-muted">Projected Daily Cost</div>
          <div style="font-size:22px;font-weight:700" x-text="'$'+(costData.projected_daily_usd||0).toFixed(4)"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:costSelK==='sample_rate'}" @click="costSelK=costSelK==='sample_rate'?null:'sample_rate'">
          <div class="text-muted">Current Sampling Rate</div>
          <div style="font-size:22px;font-weight:700" x-text="((costData.sample_rate_current||0)*100).toFixed(0)+'%'"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:costSelK==='call_count'}" @click="costSelK=costSelK==='call_count'?null:'call_count'">
          <div class="text-muted">Call Count</div>
          <div style="font-size:22px;font-weight:700" x-text="costData.call_count||0"></div>
        </div>
        <div class="kpi">
          <div class="text-muted">Model</div>
          <div style="font-size:13px;font-weight:600;margin-top:4px;word-break:break-all" x-text="costData.model||'—'"></div>
        </div>
      </div>

      <!-- KPI 상세 패널 -->
      <div x-show="costSelK" style="margin:0 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
        <template x-if="costSelK">
          <div>
            <div class="panel-header">
              <span class="val-md" x-text="costMeta[costSelK]?.label||costSelK"></span>
              <span class="tag-sm" x-text="costMeta[costSelK]?.unit?'Unit: '+costMeta[costSelK].unit:''"></span>
              <button class="btn-close" @click="costSelK=null">×</button>
            </div>
            <div class="grid-2-divider">
              <div class="panel-bg2-r">
                <div class="label-upper">Description</div>
                <div class="body-text" x-text="costMeta[costSelK]?.desc||''"></div>
              </div>
              <div class="panel-bg3">
                <div class="label-upper">📐 Calculation</div>
                <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="costFormula(costSelK, costData)"></div>
              </div>
            </div>
            <!-- 공급자별 비용 테이블 -->
            <template x-if="Object.keys(costData.by_provider||{}).length > 0">
              <div class="panel-bg">
                <div style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase;margin-bottom:8px">Cost by Provider</div>
                <div class="dtx">
                  <div class="dtx-row dtx-head" style="grid-template-columns:1fr 100px 80px">
                    <span>Provider</span><span>Cost</span><span>Share</span>
                  </div>
                  <template x-for="[provider, usd] in Object.entries(costData.by_provider||{})" :key="provider">
                    <div class="dtx-row" style="grid-template-columns:1fr 100px 80px">
