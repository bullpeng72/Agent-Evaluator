</div><!-- /quality -->

<!-- ══ SECTION 3: EXTERNAL (RAG + DeepEval) ══ -->
<div x-show="data && sec==='external'" x-cloak>
  <div x-show="!data.has_rag && !data.has_advanced" class="es">
    <div class="es-icon">📭</div>
    <div class="es-title">No External Evaluation Metrics</div>
    <div class="es-desc">Select an evaluation result that includes RAG or DeepEval metrics.</div>
    <div class="es-desc">Activate with <code>HybridPerformanceMonitor(enable_rag=True)</code> or <code>enable_deepeval=True</code></div>
  </div>

  <!-- RAG subsection -->
  <div x-show="data.has_rag">
    <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">📚 RAG Metrics (Ragas)</span><div class="sdiv-line"></div></div>
    <div x-data="{
      selK:null,
      meta:{
        faithfulness:{label:'Faithfulness',unit:'0-1',desc:'Measures how faithful the generated answer is to the provided context (retrieved documents). Higher values mean less hallucinated information; the core anti-hallucination metric for RAG systems.',hint:'generated answer ∩ context / generated answer'},
        answer_relevancy:{label:'Answer Relevancy',unit:'0-1',desc:'How relevantly the generated answer responds to the original question. Lower when retrieved results are too broad or narrow; used to detect off-topic answers.',hint:'avg cosine sim(generated questions, original question)'},
        context_recall:{label:'Context Recall',unit:'0-1',desc:'Measures how much information in the ground truth is reproduced in the retrieved context. Low values indicate relevant documents are being missed at retrieval; a priority metric for improving retrieval quality.',hint:'GT sentences supported by context / total GT sentences'},
        context_precision:{label:'Context Precision',unit:'0-1',desc:'Ratio of retrieved context chunks that are actually useful for answer generation. Low values indicate too many irrelevant documents are retrieved, causing noise and making it harder for the model to find key information.',hint:'Σ(relevant chunks at k) / total chunks'},
        overall_score:{label:'Overall Score',unit:'0-1',desc:'Average of Faithfulness, Answer Relevancy, Context Recall, and Context Precision, representing overall RAG system performance in a single value. ≥0.8 recommended for production deployment.',hint:'avg(faithfulness, answer_relevancy, context_recall, context_precision)'},
      },
      rm(k,d){
        if(k==='overall_score'){
          const keys=['faithfulness','answer_relevancy','context_recall','context_precision'];
          const vals=keys.map(m=>this.rm(m,d)).filter(v=>v>0);
          return vals.length?vals.reduce((a,b)=>a+b,0)/vals.length:0;
        }
        const v=(d.rag_metrics||{})[k];return Array.isArray(v)&&v.length?v.reduce((a,b)=>a+b,0)/v.length:(v||0);
      },
      rmin(k,d){
        if(k==='overall_score') return null;
        const v=(d.rag_metrics||{})[k];
        if(Array.isArray(v)&&v.length) return Math.min(...v);
        const pt=(d.advanced?.per_task||[]).map(t=>t['ragas_'+k]).filter(v=>v!=null);
        return pt.length?Math.min(...pt):null;
      },
      rmax(k,d){
        if(k==='overall_score') return null;
        const v=(d.rag_metrics||{})[k];
        if(Array.isArray(v)&&v.length) return Math.max(...v);
        const pt=(d.advanced?.per_task||[]).map(t=>t['ragas_'+k]).filter(v=>v!=null);
        return pt.length?Math.max(...pt):null;
      },
      rsub(k,d){
        if(k==='overall_score'){
          const keys=['faithfulness','answer_relevancy','context_recall','context_precision'];
          const cnt=keys.filter(m=>(d.rag_metrics||{})[m]?.length||(d.advanced?.per_task||[]).some(t=>t['ragas_'+m]!=null)).length;
          const n=((d.rag_metrics||{}).faithfulness||[]).length||(d.advanced?.per_task||[]).filter(t=>t.ragas_faithfulness!=null).length;
          return n+' tasks · '+cnt+' metrics';
        }
        const mn=this.rmin(k,d);const mx=this.rmax(k,d);
        const n=((d.rag_metrics||{})[k]||[]).length||(d.advanced?.per_task||[]).filter(t=>t['ragas_'+k]!=null).length;
        if(mn==null) return '';
        return 'min '+mn.toFixed(2)+' / max '+mx.toFixed(2);
      },
      formula(k,d){
        if(k==='overall_score'){
          const keys=['faithfulness','answer_relevancy','context_recall','context_precision'];
          const vals=keys.map(m=>({k:m,v:this.rm(m,d)})).filter(x=>x.v>0);
          const avg=vals.length?vals.reduce((s,x)=>s+x.v,0)/vals.length:0;
          return `overall_score\n= avg(${vals.map(x=>x.k).join(', ')})\n= ${avg.toFixed(3)}\nTarget: ≥ 0.8`;
        }
        return `${k}\n= ${this.rm(k,d).toFixed(3)}\nTarget: ≥ 0.8`;
      },
      normRag(t){
        let raw; try{raw=JSON.parse(JSON.stringify(t));}catch(e){raw=t;}
        const vf=raw.ragas_faithfulness!=null?+raw.ragas_faithfulness:null;
        const va=raw.ragas_answer_relevancy!=null?+raw.ragas_answer_relevancy:null;
        const vr=raw.ragas_context_recall!=null?+raw.ragas_context_recall:null;
        const vp=raw.ragas_context_precision!=null?+raw.ragas_context_precision:null;
        const vals=[vf,va,vr,vp].filter(v=>v!==null);
        return {task_id:String(raw.task_id||''), vf:vf, va:va, vr:vr, vp:vp, vov:vals.length?vals.reduce((x,y)=>x+y,0)/vals.length:null};
      },
      _buildCombined(d){
        const pt=(d.advanced?.per_task||[]);
        if(pt.some(t=>t.ragas_faithfulness!=null||t.ragas_answer_relevancy!=null)){
          return pt.map(t=>this.normRag(t)).filter(t=>t.vov!==null||t.vf!==null||t.va!==null||t.vr!==null||t.vp!==null);
        }
        const rag=d.rag_metrics||{};
        const f=rag.faithfulness||[],a=rag.answer_relevancy||[],r=rag.context_recall||[],p=rag.context_precision||[];
        const n=Math.max(f.length,a.length,r.length,p.length);
        if(!n) return [];
        const tasks=d.tasks||[];
        // task 수 == RAG 수이면 인덱스로 1:1 매핑, 다르면 합성 ID 사용
        const canMap=(tasks.length===n);
        return Array.from({length:n},(_,i)=>{
          const vf=f[i]!=null?+f[i]:null,va=a[i]!=null?+a[i]:null,vr=r[i]!=null?+r[i]:null,vp=p[i]!=null?+p[i]:null;
          const vals=[vf,va,vr,vp].filter(v=>v!==null);
          return {task_id:canMap?(tasks[i]?.task_id||('task_'+(i+1))):('rag_eval_'+(i+1)),vf,va,vr,vp,vov:vals.length?vals.reduce((s,v)=>s+v,0)/vals.length:null};
        });
      },
      items(k,d){
        const combined=this._buildCombined(d);
        if(k==='overall_score') return combined.filter(t=>t.vov!==null).sort((a,b)=>(b.vov||0)-(a.vov||0));
        const prop={faithfulness:'vf',answer_relevancy:'va',context_recall:'vr',context_precision:'vp'}[k]||'vf';
        return combined.filter(t=>t[prop]!==null).sort((a,b)=>(b[prop]||0)-(a[prop]||0));
      },
      filterLabel(k){return k+' desc.';}
    }">
