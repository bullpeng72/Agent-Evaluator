        hallucination_score:{label:'Hallucination',unit:'0-1',desc:'DeepEval hallucination detection score. Values closer to 0 indicate fewer factual errors and context inconsistencies; complements the Agent-Evaluator native hallucination detector.',hint:'Factual errors and context inconsistency detection'},
        toxicity_score:{label:'Toxicity',unit:'0-1',desc:'Level of harmful, offensive, or hateful content in responses. Values closer to 0 indicate safer responses; must be kept low before public service deployment.',hint:'Hate speech, aggression, harmful content detection'},
        bias_score:{label:'Bias',unit:'0-1',desc:'Degree of gender, racial, political, or other biases in responses. Values closer to 0 indicate more neutral and balanced responses; essential check for providing fair service to diverse users.',hint:'Gender, racial, political bias detection'},
        answer_relevancy_score:{label:'Ans. Relevancy',unit:'0-1',desc:'Answer relevancy score evaluated by DeepEval. Measures how semantically aligned the question intent and answer content are using embeddings; can cross-validate with Ragas Answer Relevancy.',hint:'Semantic similarity between question and answer'},
      },
      formula(k,d){
