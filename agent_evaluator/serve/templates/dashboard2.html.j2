<!DOCTYPE html>
<html lang="en" x-data="app2()" x-init="init()" :class="{'dark':dark}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>{{ title }} — Dev Dashboard</title>
{% if offline %}
<script defer src="/static/alpine.min.js"></script>
<script src="/static/plotly.min.js"></script>
{% else %}
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/plotly.js-dist@2.35.2/plotly.min.js"></script>
{% endif %}
<style>
:root{
  --bg:#0f1117;--bg2:#1a1d27;--bg3:#22263a;--border:#2d3148;
  --text:#e2e4f0;--text2:#8890b0;--accent:#6c8ef5;
  --green:#4ade80;--yellow:#facc15;--red:#f87171;--orange:#fb923c;--r:10px;
  --sp-1:4px;--sp-2:8px;--sp-3:12px;--sp-4:16px;--sp-5:24px;--sp-6:32px;
  --fs-xs:11px;--fs-sm:12px;--fs-md:13px;--fs-lg:15px;--fs-xl:22px;--fs-2xl:28px;
  --c-ok:var(--green);--c-warn:var(--yellow);--c-ng:var(--red);--c-info:var(--accent);
}
html:not(.dark){
  --bg:#f4f6fc;--bg2:#fff;--bg3:#eef0f8;--border:#d1d5e8;
  --text:#1a1d2e;--text2:#5a6080;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);font-size:14px}
.layout{display:grid;grid-template-rows:52px 1fr 28px;height:100vh}
.hdr{background:var(--bg2);border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;padding:0 14px;position:sticky;top:0;z-index:100}
.body{display:grid;grid-template-columns:190px 1fr;overflow:hidden}
.side{background:var(--bg2);border-right:1px solid var(--border);overflow-y:auto;padding:8px 0}
.main{overflow-y:auto;padding:16px}
.sbar{background:var(--bg2);border-top:1px solid var(--border);display:flex;align-items:center;gap:12px;padding:0 14px;font-size:13px;color:var(--text2)}
.logo{font-weight:700;font-size:16px;white-space:nowrap}.logo span{color:var(--accent)}
select{background:var(--bg3);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:3px 7px;font-size:13px;max-width:240px}
.btn{background:var(--bg3);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:4px 9px;font-size:13px;cursor:pointer;white-space:nowrap;text-decoration:none;display:inline-flex;align-items:center;gap:4px}
.btn:hover,.btn.active{background:var(--accent);color:#fff;border-color:var(--accent)}
.sp{flex:1}
.dot{width:7px;height:7px;border-radius:50%;background:var(--green);display:inline-block}
.dot.off{background:var(--text2)}.dot.live{animation:pulse 1.5s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
.nav{display:flex;align-items:center;gap:6px;padding:6px 12px 6px 11px;cursor:pointer;font-size:13px;color:var(--text2);border-left:4px solid transparent}
/* scope 구분: 좌측 4px 컬러 스트립 */
.nav.s-file{border-left-color:rgba(99,179,237,.5)}
.nav.s-global{border-left-color:rgba(72,187,120,.5)}
.nav:hover{background:var(--bg3);color:var(--text)}
.nav.s-file:hover{border-left-color:rgba(99,179,237,.8)}
.nav.s-global:hover{border-left-color:rgba(72,187,120,.8)}
/* 활성 상태: accent 색으로 덮어씀 (scope 색 위에) */
.nav.on{background:var(--bg3);color:var(--text);border-left-color:var(--accent)}
.nav-badge-slot{width:38px;flex-shrink:0;display:inline-flex;align-items:center;justify-content:flex-end;margin-left:auto}
.nav-badge{background:var(--bg3);border-radius:99px;font-size:10px;padding:1px 6px;color:var(--text2);white-space:nowrap}
.nav-legend{display:flex;align-items:center;gap:10px;padding:8px 12px 6px;border-top:1px solid var(--border);margin-top:4px}
.nav-legend span{font-size:10px;display:flex;align-items:center;gap:4px;color:var(--text2)}
.nav-legend .leg-file{display:inline-block;width:4px;height:14px;border-radius:2px;background:rgba(99,179,237,.6)}
.nav-legend .leg-global{display:inline-block;width:4px;height:14px;border-radius:2px;background:rgba(72,187,120,.6)}
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-bottom:14px}
.kpi{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:12px 14px;transition:border-color .15s,background .15s}
.kpi:hover{border-color:var(--accent)}
.kpi.sel{border-color:var(--accent);background:var(--bg3)}
.kpi-act{cursor:pointer;border-left:3px solid var(--accent);padding-left:12px}
.kpi-act::after{content:'▾ Details';display:block;font-size:10px;color:var(--accent);text-align:right;margin-top:4px;opacity:.45;transition:opacity .15s}
.kpi-act:hover::after,.kpi-act.sel::after{opacity:1}
.kpi-lbl{font-size:12px;color:var(--text2);text-transform:uppercase;letter-spacing:.04em}
.kpi-val{font-size:26px;font-weight:800;margin:3px 0}
.kpi-sub{font-size:12px}.kpi-sub.ok{color:var(--green)}.kpi-sub.warn{color:var(--yellow)}
.dgate{display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap}
.dgate-box{flex:1;min-width:150px;background:var(--bg2);border:2px solid var(--border);border-radius:var(--r);padding:12px;transition:border-color .15s}
.dgate-box.pass{border-color:var(--green)}.dgate-box.partial{border-color:var(--yellow)}.dgate-box.fail{border-color:var(--red)}
.dgate-title{font-size:14px;font-weight:700;margin-bottom:6px;display:flex;align-items:center;justify-content:space-between}
.dgate-badge{font-size:12px;padding:1px 6px;border-radius:99px;font-weight:600}
.dgate-box.pass .dgate-badge{background:#4ade8022;color:var(--green)}.dgate-box.partial .dgate-badge{background:#facc1522;color:var(--yellow)}.dgate-box.fail .dgate-badge{background:#f8717122;color:var(--red)}
.dgate-row{font-size:12px;color:var(--text2);display:flex;align-items:center;gap:5px;padding:2px 0}
.dgate-row .dv{margin-left:auto;font-size:11px;opacity:.7}
.sec{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:14px;margin-bottom:12px}
.sec-t{font-size:15px;font-weight:600;margin-bottom:10px;display:flex;align-items:center;gap:6px}
.cg{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.cg3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
.cg4{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:10px}
.cg>*,.cg3>*,.cg4>*{min-width:0;overflow:hidden}
.cbox{background:var(--bg3);border-radius:8px;padding:10px;overflow:hidden;min-width:0}
.plt-chart{height:200px;min-width:0;width:100%}
.ct{font-size:13px;color:var(--text2);margin-bottom:6px}
.alert{border-radius:8px;padding:10px 12px;margin-bottom:8px;border-left:3px solid;display:flex;align-items:center;justify-content:space-between;gap:10px}
.alert.critical{background:rgba(248,113,113,.1);border-color:var(--red)}
.alert.high{background:rgba(251,146,60,.1);border-color:var(--orange)}
.alert.medium{background:rgba(250,204,21,.1);border-color:var(--yellow)}
.alert.low{background:rgba(74,222,128,.1);border-color:var(--green)}
.alert-body{flex:1;min-width:0}
.alert-t{font-size:14px;font-weight:600;margin-bottom:3px}
.alert-b{font-size:13px;color:var(--text2)}
.alert-link{font-size:11px;color:var(--accent);white-space:nowrap;opacity:.8}
.alert.clickable{cursor:pointer;transition:opacity .15s}
.alert.clickable:hover{opacity:.8}
.alert.clickable:hover .alert-link{opacity:1;text-decoration:underline}
.rec{background:var(--bg3);border-radius:8px;padding:10px 12px;margin-bottom:8px}
.rec-t{font-size:14px;font-weight:600;margin-bottom:4px}
.rec-b{font-size:13px;color:var(--text2)}
.drow{display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid var(--border);font-size:14px}
.drow:last-child{border-bottom:none}
.dk{color:var(--text2)}
.slist{max-height:300px;overflow-y:auto}
.es{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:var(--sp-6);color:var(--text2);text-align:center;gap:var(--sp-2)}
.es-icon{font-size:28px}.es-title{font-size:var(--fs-md);font-weight:600}
.es-desc{font-size:var(--fs-sm)}.es-desc code{background:var(--bg3);padding:1px 5px;border-radius:4px;font-size:var(--fs-xs)}
.dtx{border:1px solid var(--border);border-radius:var(--r);overflow:hidden;font-size:var(--fs-sm)}
.dtx-row{display:grid;gap:0 8px;padding:5px var(--sp-3);border-bottom:1px solid var(--border);align-items:center}
.dtx-head{font-weight:600;color:var(--text2);background:var(--bg3);font-size:var(--fs-xs);text-transform:uppercase;letter-spacing:.05em}
.dtx-row:not(.dtx-head):hover{background:var(--bg3)}
.dtx-id{font-family:monospace;font-size:var(--fs-xs);color:var(--accent);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dtx-empty{padding:var(--sp-5);text-align:center;color:var(--text2);font-size:var(--fs-sm)}
.badge-ok{background:rgba(74,222,128,.12);color:var(--green);border-radius:99px;font-size:var(--fs-xs);font-weight:600;padding:1px 7px;display:inline-block}
.badge-warn{background:rgba(250,204,21,.12);color:var(--yellow);border-radius:99px;font-size:var(--fs-xs);font-weight:600;padding:1px 7px;display:inline-block}
.badge-ng{background:rgba(248,113,113,.12);color:var(--red);border-radius:99px;font-size:var(--fs-xs);font-weight:600;padding:1px 7px;display:inline-block}
.badge-info{background:rgba(108,142,245,.12);color:var(--accent);border-radius:99px;font-size:var(--fs-xs);font-weight:600;padding:1px 7px;display:inline-block}
.badge-gray{background:var(--bg3);color:var(--text2);border-radius:99px;font-size:var(--fs-xs);padding:1px 7px;display:inline-block}
.pill{display:inline-flex;align-items:center;gap:3px;font-size:var(--fs-xs);border-radius:99px;padding:2px 7px;font-weight:600}
.pg{background:rgba(74,222,128,.12);color:var(--green);border-radius:99px;font-size:var(--fs-xs);font-weight:600;padding:1px 7px;display:inline-flex;align-items:center;gap:3px}
.py{background:rgba(250,204,21,.12);color:var(--yellow);border-radius:99px;font-size:var(--fs-xs);font-weight:600;padding:1px 7px;display:inline-flex;align-items:center;gap:3px}
.pr{background:rgba(248,113,113,.12);color:var(--red);border-radius:99px;font-size:var(--fs-xs);font-weight:600;padding:1px 7px;display:inline-flex;align-items:center;gap:3px}
.rg{margin:8px 0}
.rgt{background:var(--bg3);border-radius:99px;height:14px;overflow:hidden;margin-bottom:3px}
.rgf{height:100%;border-radius:99px;transition:width .4s}
.pscore-bar{height:6px;border-radius:3px;background:var(--bg3);overflow:hidden;min-width:80px}
.pscore-fill{height:100%;border-radius:3px;background:var(--yellow);transition:width .3s}
.pscore-fill.strong{background:var(--green)}.pscore-fill.weak{background:var(--orange)}
.nav-grp{font-size:10px;font-weight:700;color:var(--text2);letter-spacing:.07em;padding:10px 13px 3px;text-transform:uppercase;user-select:none;display:flex;align-items:center;gap:6px}
.nav-grp::after{content:'';flex:1;height:1px;background:var(--border);margin-left:4px}
.sdiv{display:flex;align-items:center;gap:10px;margin:20px 0 14px;user-select:none}
.sdiv-line{flex:1;height:1px;background:var(--border)}
.sdiv-lbl{font-size:11px;font-weight:700;color:var(--text2);white-space:nowrap;letter-spacing:.06em;background:var(--bg3);border:1px solid var(--border);border-radius:99px;padding:2px 10px}
.fbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:10px}
.fbar label{font-size:13px;color:var(--text2)}
input[type=text],input[type=number]{background:var(--bg3);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:3px 7px;font-size:13px}
.dt-card{width:100%;border-collapse:collapse;font-size:13px}
.dt-card thead tr{background:var(--bg3);color:var(--text2);font-weight:600}
.dt-card th,.dt-card td{padding:6px 10px;border-bottom:1px solid var(--border);text-align:left}
.dt-card th:not(:first-child),.dt-card td:not(:first-child){text-align:right}
[x-cloak]{display:none!important}
@media(max-width:768px){.body{grid-template-columns:1fr}.side{display:none}.cg,.cg3,.cg4{grid-template-columns:1fr}}
/* ── 공통 유틸리티 클래스 (v0.8.2) ───────────────────────────────────── */
.text-muted{font-size:11px;color:var(--text2)}
.text-xs-muted{font-size:10px;color:var(--text2)}
.hstack{display:flex;align-items:center;gap:8px}
.card{border-radius:8px;padding:10px 14px;margin-bottom:8px;border:1px solid var(--border);background:var(--bg2)}
.label-upper{font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase}
.btn-close{margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px}
.tag-sm{font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px}
.grid-2-divider{display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)}
.val-md{font-weight:700;font-size:14px}
.val-sm{font-weight:700;font-size:13.5px}
.code-hint{font-size:11px;background:var(--bg3);border-radius:4px;padding:5px 10px;margin-bottom:8px;font-family:monospace;color:var(--text2);word-break:break-word;overflow-wrap:break-word;white-space:pre-wrap}
.grp-chip{display:inline-flex;align-items:center;font-size:10px;font-weight:700;padding:1px 7px;border-radius:10px;margin-left:6px;vertical-align:middle}
.grp-A{background:rgba(16,185,129,.15);color:#10b981}
.grp-B{background:rgba(59,130,246,.15);color:#3b82f6}
.grp-C{background:rgba(245,158,11,.15);color:#f59e0b}
.grp-D{background:rgba(14,165,233,.15);color:#0ea5e9}
.grp-E{background:rgba(239,68,68,.15);color:#ef4444}
.grp-F{background:rgba(139,92,246,.15);color:#8b5cf6}
.grp-G{background:rgba(6,182,212,.15);color:#06b6d4}
.cfg-desc{font-size:12.5px;line-height:1.6;padding:7px 10px;border-radius:5px;margin-bottom:8px;color:var(--text)}
.panel-bg2-r{padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)}
.panel-bg3{padding:10px 14px;background:var(--bg3)}
.icon-lg{font-size:20px}
.mb-2{margin-bottom:8px}
.muted{color:var(--text2)}
.hint-text{font-size:11.5px;color:var(--text2);padding:5px 0 0 14px;line-height:1.6}
.toggle-text{font-size:11.5px;color:var(--text2);cursor:pointer;user-select:none}
.flex-wrap-5{display:flex;gap:5px;flex-wrap:wrap}
.row-between{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:8px}
.badge-fail{font-size:10.5px;padding:2px 8px;border-radius:10px;background:rgba(239,68,68,.15);color:#ef4444;font-weight:600}
.badge-pass{font-size:10.5px;padding:2px 8px;border-radius:10px;background:rgba(16,185,129,.15);color:#10b981;font-weight:600}
.panel-header{display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)}
.panel-bg{padding:10px 14px;background:var(--bg)}
.body-text{font-size:13px;line-height:1.7}
.fs-sm{font-size:11px}
</style>
</head>
<body>
<div class="layout">

<!-- HEADER -->
<header class="hdr">
  <div class="logo">🤖 <span>Agent</span> Evaluator <span style="font-size:11px;color:var(--text2);font-weight:400;margin-left:4px">Dev</span></div>
  <select x-model="selId" @change="loadFile(selId)" style="flex:0 1 260px">
    <option value="">— Select File —</option>
    <template x-for="f in files" :key="f.id">
      <option :value="f.id" x-text="`${f.name.substring(0,36)} (${f.total_tasks}t)`"></option>
    </template>
  </select>
  <button class="btn" @click="refresh()" title="Refresh">🔄</button>
  <button class="btn" @click="window.open('/slides'+(selId?'?id='+selId:''),'_blank')" title="Open Presentation Slides">📊 Slide</button>
  <a class="btn" href="/api/docs" target="_blank">API</a>
  <a class="btn" href="/sdk-docs" target="_blank">SDK</a>
  <div class="sp"></div>
  {% if watch %}<span style="font-size:11px;color:var(--green);background:rgba(74,222,128,.1);padding:2px 8px;border-radius:99px;border:1px solid rgba(74,222,128,.3)">⚡ watch</span>
  <span id="ae-poll-dbg" style="font-size:10px;color:var(--text2);padding:2px 6px;border-radius:4px;background:rgba(128,128,128,.1)">poll: waiting</span>{% endif %}
  <span class="dot" :class="{'live':connected,'off':!connected}"></span>
  <span x-text="connected?'Live':'Offline'" style="font-size:13px;color:var(--text2)"></span>
  <button class="btn" @click="dark=!dark" x-text="dark?'☀️':'🌙'"></button>
</header>

<!-- BODY -->
<div class="body">

<!-- Sidebar -->
<nav class="side">

  <!-- ── Harness Gate 미니 패널 (상단 고정) ── -->
  <div x-show="data && data.harness_groups && data.harness_groups.overall"
       x-cloak
       style="margin:6px 8px 4px;border:1px solid var(--border);border-radius:8px;padding:8px 10px;background:var(--bg3)">
    <!-- 타이틀 + 전체 게이트 -->
    <div style="display:flex;align-items:center;gap:4px;margin-bottom:7px">
      <span style="font-size:10px;font-weight:700;color:var(--text2);letter-spacing:.04em;white-space:nowrap">🏁 HARNESS GATE</span>
      <span style="font-size:9px;font-weight:700;padding:1px 6px;border-radius:99px;color:#fff;margin-left:auto;white-space:nowrap;cursor:pointer"
            :style="`background:${gc(data.harness_groups.overall?.gate)}`"
            x-text="(data.harness_groups.overall?.gate||'?').toUpperCase()"
            @click="sec='overview'"></span>
    </div>
    <!-- A–G 그룹 점수 박스 -->
    <div style="display:flex;gap:3px;justify-content:space-between">
      <template x-for="gk in ['A','B','C','D','E','F','G']" :key="gk">
        <div x-show="data.harness_groups[gk]"
             :title="`${gk}: ${data.harness_groups[gk]?.name||''}\n${data.harness_groups[gk]?.score!=null?Math.round(data.harness_groups[gk].score*100)+'%':'n/a'} · ${(data.harness_groups[gk]?.gate||'?').toUpperCase()}`"
             style="display:flex;flex-direction:column;align-items:center;gap:2px;cursor:pointer"
             @click="sec=({A:'quality',B:'agentic',C:'reliability',D:'performance',E:'security',F:'agentic',G:'anomaly'}[gk]||'overview')">
          <!-- 그룹 레터 박스 -->
          <div style="width:22px;height:18px;border-radius:3px;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:800;color:#fff"
               :style="`background:${!data.gate_active?.[gk]?'var(--text2)':gc(data.harness_groups[gk]?.gate)};opacity:${data.harness_groups[gk]?.score!=null?1:.45}`"
               x-text="gk"></div>
          <!-- 점수 % (미측정 그룹은 — 표시) -->
          <div style="font-size:8.5px;line-height:1;color:var(--text2)"
               x-text="!data.gate_active?.[gk]?'—':data.harness_groups[gk]?.score!=null?Math.round(data.harness_groups[gk].score*100)+'%':'—'"></div>
        </div>
      </template>
    </div>
    <!-- 범례: 전체 점수 -->
    <div x-show="data.harness_groups.overall?.score!=null"
         style="margin-top:7px;padding-top:6px;border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between">
      <span style="font-size:9px;color:var(--text2)">Overall Score</span>
      <span style="font-size:11px;font-weight:700"
            :style="`color:${gc(data.harness_groups.overall?.gate)}`"
            x-text="data.harness_groups.overall?.score!=null?Math.round(data.harness_groups.overall.score*100)+'%':'—'"></span>
    </div>
  </div>
  <!-- ──────────────────────────────────────── -->

  <template x-for="n in nav" :key="n.id">
    <div>
      <!-- ── Tier 1: Gate 그룹 헤더 — 접기/펼치기 + Gate 상태 pill ── -->
      <div x-show="n.group" class="nav-grp"
           :style="n.hkey ? 'cursor:pointer;user-select:none' : ''"
           @click="n.hkey && (navCollapsed[n.id] = !navCollapsed[n.id])">
        <!-- 접기 화살표 (hkey 있는 그룹만) -->
        <span x-show="!!n.hkey"
              style="font-size:9px;color:var(--text2);width:10px;flex-shrink:0;margin-right:2px;transition:transform .15s"
              :style="navCollapsed[n.id] ? 'transform:rotate(-90deg)' : ''"
              x-text="'▼'"></span>
        <span x-text="n.label" style="flex:1"></span>
        <!-- Gate 상태 pill: PASS/WARN/FAIL + 점수 -->
        <span x-show="n.hkey && data && (data.harness_groups||{})[n.hkey]"
              style="font-size:9px;font-weight:700;padding:1px 6px;border-radius:99px;color:#fff;flex-shrink:0;white-space:nowrap"
              :style="n.hkey && data && (data.harness_groups||{})[n.hkey]
                ? `background:${(data.harness_groups[n.hkey].gate||'')==='pass'?'var(--green)':(data.harness_groups[n.hkey].gate||'')==='fail'?'var(--red)':'var(--yellow)'}`
                : ''"
              x-text="n.hkey && data && (data.harness_groups||{})[n.hkey]
                ? `${(data.harness_groups[n.hkey].gate||'?').toUpperCase()} ${data.harness_groups[n.hkey].score!=null?Math.round(data.harness_groups[n.hkey].score*100)+'%':''}`
                : ''">
        </span>
      </div>
      <!-- ── Tier 2: 탭 아이템 — 부모 그룹 접힘 시 숨김 ── -->
      <div x-show="!n.group && !navCollapsed[_navParentMap[n.id]]"
           class="nav" :class="{on:sec===n.id, 's-file':n.scope==='file', 's-global':n.scope==='global'}"
           @click="sec=n.id">
        <span x-text="n.icon" style="flex-shrink:0"></span>
        <span x-text="n.label" style="flex:1;font-size:13px;line-height:1.3"></span>
        <span class="nav-badge-slot">
          <span class="nav-badge" x-show="data && n.badge"
                x-text="data && n.badge ? n.badge(data) : ''"
                :style="data && n.badgeColor && n.badgeColor(data) ? `background:${n.badgeColor(data)};color:#fff` : ''"></span>
        </span>
      </div>
      <!-- ── Tier 3: 활성 탭의 섹션 빠른 이동 앵커 ── -->
      <template x-if="!n.group && sec===n.id && n.anchors && !navCollapsed[_navParentMap[n.id]]">
        <div>
          <template x-for="a in n.anchors" :key="a.id">
            <div style="display:flex;align-items:center;gap:5px;padding:3px 12px 3px 26px;cursor:pointer;font-size:11px;color:var(--text2);border-left:3px solid transparent"
                 @click.stop="(function(){const el=document.getElementById(a.id);if(el)el.scrollIntoView({behavior:'smooth',block:'start'});})()"
                 @mouseenter="$el.style.color='var(--text)';$el.style.borderLeftColor='var(--accent)'"
                 @mouseleave="$el.style.color='var(--text2)';$el.style.borderLeftColor='transparent'">
              <span style="font-size:9px;opacity:.6">↳</span>
              <span x-text="a.label"></span>
            </div>
          </template>
        </div>
      </template>
    </div>
  </template>
  <!-- 범례 -->
  <div class="nav-legend">
    <span><i class="leg-file"></i> File-based</span>
    <span><i class="leg-global"></i> Global-based</span>
  </div>
</nav>

<!-- Main -->
<main class="main">

<div x-show="!data && !loading" class="es">
  <div class="es-icon">📂</div>
  <div class="es-title">Select a result file</div>
  <div class="es-desc" x-show="files.length===0" style="color:var(--red)">⚠️ No JSON files in the results directory.</div>
  <div class="es-desc" x-show="files.length>0">Select an evaluation result file from the dropdown above.</div>
</div>
<div x-show="loading" class="es"><p>Loading…</p></div>

<!-- ══ SECTION 1: OVERVIEW ══ -->
<div x-show="data && sec==='overview'" x-cloak>

  <div x-data="{
    selK:null,
    /* ── local helpers: data is inherited from parent app2() scope ── */
    _tcr(){const t=data.tasks||[],n=t.length||1;const raw=data.accuracy_metrics?.tcr?.tcr??null;return raw!=null?raw:t.reduce((s,x)=>s+(x.completion_score||0),0)/n*100;},
    _acc(){const t=data.tasks||[],n=t.length||1;const raw=data.accuracy_metrics?.accuracy_scores?.overall_accuracy??null;return raw!=null?raw:t.reduce((s,x)=>s+(x.accuracy_score||0),0)/n*100;},
    _hall(){const dets=data.hallucination_detail?.detections||[];if(dets.length>0){const fl=dets.filter(x=>(x.hallucination_rate||0)>0).length;return(fl/dets.length)*100;}const am=data.accuracy_metrics?.hallucination||{};const raw=am.overall_rate??null;if(raw!=null)return raw;const ev=am.total_evaluated||0,fl=am.total_flagged||0;return ev>0?(fl/ev)*100:0;},
    _p95(){const em=data.efficiency_metrics||{};return em.latency?.p95??em.p95_latency??0;},
    _cost(){ return cTotal(data); },
    _pct(v){return v==null?0:Math.min(100,Math.max(0,v));},
    _col(v,hi,lo){return v>=hi?'var(--green)':v>=lo?'var(--yellow)':'var(--red)';},
    _colLat(v){return v<=2?'var(--green)':v<=5?'var(--yellow)':'var(--red)';},
    _fmtCost(v){return v==null?'—':'$'+Number(v).toFixed(4);},
    _fmtSec(v){return v==null?'—':Number(v).toFixed(2)+'s';},
    meta:{
      total_tasks:{label:'Total Tasks',unit:'tasks',desc:'Total number of tasks executed in this evaluation session. Represents the dataset size and evaluation scope, and is used as the denominator for all metrics.',hint:'data.total_tasks'},
      tcr:{label:'TCR',unit:'%',desc:'Key performance indicator showing how successfully the AI agent completed given tasks. Higher values indicate more stable completion capability and are the primary criterion for production deployment readiness.',hint:'Σ completion_score / total × 100'},
      accuracy:{label:'Accuracy',unit:'%',desc:'Factual accuracy metric showing how well agent responses match the ground truth. Used to objectively evaluate response quality in QA, information retrieval, and document creation tasks.',hint:'avg(accuracy_score) × 100'},
      hallucination:{label:'Hallucination Rate',unit:'%',desc:'Reliability metric measuring how often the agent generates false or unsupported information. Lower is better, and must be kept low before production deployment.',hint:'avg(per-task hallucination_rate) × 100'},
      p95_latency:{label:'P95 Latency',unit:'s',desc:'Time for 95% of requests to complete. Most widely used for SLA design and performance bottleneck detection. Better reflects real user experience than a simple average.',hint:'efficiency_metrics.latency.p95'},
      total_cost:{label:'Total Cost',unit:'$',desc:'Estimated cost of LLM API calls consumed in this evaluation. Used for operational budget planning and per-model cost-performance trade-off analysis, and indirectly indicates token usage efficiency.',hint:'efficiency_metrics.tokens.total_cost'},
    },
    formula(k,d){
      const t=d.tasks||[],n=t.length||1;
      if(k==='total_tasks'){const ok=t.filter(b=>b.success).length;return `Total Tasks = ${d.total_tasks||0}\nSuccess ${ok} / Failure ${n-ok}`;}
      if(k==='tcr'){const s=t.reduce((a,b)=>a+(b.completion_score||0),0);const full=t.filter(b=>(b.completion_score||0)>=1).length;const partial=t.filter(b=>(b.completion_score||0)>=0.7&&(b.completion_score||0)<1).length;const fail=t.filter(b=>(b.completion_score||0)<0.7).length;return `TCR = Σ completion_score / total\n= ${s.toFixed(2)} / ${n} = ${(s/n*100).toFixed(1)}%\nFull Success ${full} / Partial (0.7~1.0) ${partial} / Failure (<0.7) ${fail}`;}
      if(k==='accuracy'){const s=t.reduce((a,b)=>a+(b.accuracy_score||0),0);return `Accuracy = avg(accuracy_score) × 100\n= ${s.toFixed(3)} / ${n} × 100 = ${(s/n*100).toFixed(1)}%`;}
      if(k==='hallucination'){const rate=d.accuracy_metrics?.hallucination?.overall_rate||0;const dets=d.hallucination_detail?.detections||[];const allU=new Set(dets.map(x=>x.task_id)).size;const flagU=new Set(dets.filter(x=>x.hallucination_rate>0).map(x=>x.task_id)).size;return `Hallucination Rate = avg(per-task hallucination_rate) × 100\n= ${rate.toFixed(1)}%\nDetected tasks: ${flagU} / ${allU} (rate > 0)\nNot detected: ${allU-flagU}`;}
      if(k==='p95_latency'){const em=d.efficiency_metrics||{};const p95=em.latency?.p95||em.p95_latency||0;const p50=em.latency?.p50||0;const avg=em.latency?.mean||em.avg_latency||0;return `P95 = ${p95.toFixed(3)}s\nP50 (Median) = ${p50.toFixed(3)}s\nAvg = ${avg.toFixed(3)}s`;}
      if(k==='total_cost'){const cost=cTotal(d);const toks=d.efficiency_metrics?.tokens?.total_tokens||0;const src=selModel?`Applied model: ${selModel.model.split('/')[0].trim()}`:'Stored JSON value';return `${src}\nTotal cost = $${cost.toFixed(4)}\nPer task = $${(cost/(d.total_tasks||1)).toFixed(5)}\nTotal tokens = ${toks.toLocaleString()}`;}
      return '';
    },
    items(k,d){
      const t=d.tasks||[];
      if(k==='total_tasks')return [...t].sort((a,b)=>(a.completion_score||0)-(b.completion_score||0));
      if(k==='tcr')return [...t].sort((a,b)=>(a.completion_score||0)-(b.completion_score||0));
      if(k==='accuracy')return [...t].sort((a,b)=>(a.accuracy_score||0)-(b.accuracy_score||0));
      if(k==='hallucination'){const dm={};(d.hallucination_detail?.detections||[]).filter(x=>x.hallucination_rate>0).forEach(x=>{dm[x.task_id]={hr:x.hallucination_rate,hc:(x.indicators||[]).length,sc:x.response_sentences||0};});return [...t].filter(x=>dm[x.task_id]).sort((a,b)=>(dm[b.task_id]?.hr||0)-(dm[a.task_id]?.hr||0)).map(x=>({...x,_hr:dm[x.task_id]?.hr||0,_hc:dm[x.task_id]?.hc||0,_sc:dm[x.task_id]?.sc||0}));}
      if(k==='p95_latency')return [...t].sort((a,b)=>(b.execution_time||0)-(a.execution_time||0)).slice(0,20);
      if(k==='total_cost')return [...t].sort((a,b)=>(b.tokens_used?.total||b.tokens_used||0)-(a.tokens_used?.total||a.tokens_used||0)).slice(0,20);
      return t;
    },
    col3Label(k){return {accuracy:'Accuracy',hallucination:'Hallu. Rate',p95_latency:'Resp. Time',total_cost:'Tokens'}[k]||'Completion';},
    col3Val(k,t){
      if(k==='accuracy')return ((t.accuracy_score||0)*100).toFixed(1)+'%';
      if(k==='hallucination'){const sc=t._sc>0?' /'+t._sc+' sents':'';return ((t._hr||0)*100).toFixed(0)+'%'+sc;}
      if(k==='p95_latency')return (t.execution_time||0).toFixed(2)+'s';
      if(k==='total_cost')return (t.tokens_used?.total||t.tokens_used||0).toLocaleString();
      return ((t.completion_score||0)*100).toFixed(0)+'%';
    },
    col3Color(k,t){
      if(k==='accuracy')return _col((t.accuracy_score||0)*100,90,70);
      if(k==='hallucination')return (t._hr||0)>=0.5?'var(--red)':(t._hr||0)>=0.1?'var(--yellow)':'var(--green)';
      if(k==='p95_latency')return _colLat(t.execution_time||0);
      if(k==='total_cost')return 'var(--text2)';
      return (t.completion_score||0)>=1?'var(--green)':(t.completion_score||0)>=0.7?'var(--yellow)':'var(--red)';
    },
    filterLabel(k){return {total_tasks:'By Completion ↑',tcr:'By Completion ↑',accuracy:'By Accuracy ↑',hallucination:'By Hallucination ↓',p95_latency:'Slowest Top 20',total_cost:'Most Tokens Top 20'}[k]||'All';}
  }">
  <!-- Phase 2: Harness Gate Panel — harness_groups 있을 때만 표시 -->
  <template x-if="data.harness_groups && Object.keys(data.harness_groups).length > 1">
    <div x-data="{
      gMeta: {
        'A':{ name:'Goal Achievement', icon:'🎯', sec:'quality'     },
        'B':{ name:'Behavioral Integrity', icon:'🤖', sec:'agentic'     },
        'C':{ name:'Reliability',   icon:'🔁', sec:'reliability' },
        'D':{ name:'Performance Contract', icon:'⚡', sec:'performance' },
        'E':{ name:'Security Boundary', icon:'🔒', sec:'security'    },
        'F':{ name:'Multi-Agent',   icon:'🔗', sec:'realtime'    },
        'G':{ name:'Observability', icon:'📡', sec:'anomaly'     },
      },
      gc(g){ return g==='pass'?'var(--green)':g==='fail'?'var(--red)':g==='warn'||g==='partial'?'var(--yellow)':'var(--text2)'; },
      pct(gv){ return gv&&gv.score!=null?Math.round(gv.score*100):null; },
      passN(){ return Object.entries(data.harness_groups).filter(([k,v])=>k!=='overall'&&v.gate==='pass').length; },
      failN(){ return Object.entries(data.harness_groups).filter(([k,v])=>k!=='overall'&&v.gate==='fail').length; },
      warnN(){ return Object.entries(data.harness_groups).filter(([k,v])=>k!=='overall'&&(v.gate==='warn'||v.gate==='partial')).length; },
    }">
      <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🏁 Harness Evaluation Gates <span style="font-size:10px;font-weight:400;opacity:.75;margin-left:4px">— Deployment readiness per group</span></span><div class="sdiv-line"></div></div>

      <!-- ① Overall 요약 카드 -->
      <template x-if="data.harness_groups.overall">
        <div class="card">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
            <span style="font-size:11px;font-weight:700;color:var(--text2);letter-spacing:.05em">OVERALL HARNESS</span>
            <span style="font-size:18px;font-weight:800;line-height:1"
                  :style="`color:${gc(data.harness_groups.overall.gate)}`"
                  x-text="data.harness_groups.overall.score!=null?Math.round(data.harness_groups.overall.score*100)+'%':'—'"></span>
            <span style="font-size:11px;font-weight:700;padding:2px 8px;border-radius:99px;color:#fff;margin-right:auto"
                  :style="`background:${gc(data.harness_groups.overall.gate)}`"
                  x-text="(data.harness_groups.overall.gate||'?').toUpperCase()"></span>
            <span style="font-size:11px;color:var(--green)" x-text="`✓ ${passN()} Pass`"></span>
            <span style="font-size:11px;color:var(--yellow)" x-show="warnN()>0" x-text="`⚠ ${warnN()} Warn`"></span>
            <span style="font-size:11px;color:var(--red)" x-text="`✗ ${failN()} Fail`"></span>
          </div>
          <div style="height:7px;background:var(--bg3);border-radius:4px;overflow:hidden">
            <div :style="`width:${pct(data.harness_groups.overall)||0}%;height:100%;border-radius:4px;background:${gc(data.harness_groups.overall.gate)};transition:width .5s ease`"></div>
          </div>
        </div>
      </template>

      <!-- ② 그룹별 행 목록 (table — 컬럼 정렬 보장) -->
      <table style="width:100%;border-collapse:collapse;margin-bottom:16px;table-layout:fixed">
        <colgroup>
          <col style="width:26px">
          <col style="width:20px">
          <col style="width:110px">
          <col><!-- 나머지 너비 -->
          <col style="width:42px">
          <col style="width:50px">
        </colgroup>
        <tbody>
          <template x-for="[gk, gv] in Object.entries(data.harness_groups).filter(([k])=>k!=='overall')" :key="gk">
            <tr style="cursor:pointer;border-left:3px solid transparent;transition:background .12s"
                :style="`border-left-color:${pct(gv)!=null?gc(gv.gate):'var(--border)'}`"
                @mouseenter="$el.style.background='var(--bg3)'" @mouseleave="$el.style.background=''"
                @click="sec=(gMeta[gk]||{}).sec||'quality'">
              <!-- 그룹 키 배지 -->
              <td style="padding:6px 4px 6px 6px">
                <span style="font-size:10px;font-weight:800;width:18px;height:18px;border-radius:4px;display:inline-flex;align-items:center;justify-content:center;color:#fff"
                      :style="`background:${pct(gv)!=null?gc(gv.gate):'var(--text2)'}`"
                      x-text="gk"></span>
              </td>
              <!-- 아이콘 -->
              <td style="padding:6px 2px;font-size:13px;text-align:center"
                  x-text="(gMeta[gk]||{}).icon||''"></td>
              <!-- 그룹명 -->
              <td style="padding:6px 8px 6px 4px;font-size:13px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"
                  x-text="(gMeta[gk]||{}).name||gk"></td>
              <!-- 프로그레스 바 -->
              <td style="padding:6px 8px">
                <div style="height:6px;background:var(--bg3);border-radius:3px;overflow:hidden">
                  <div :style="`width:${pct(gv)!=null?pct(gv):0}%;height:100%;border-radius:3px;background:${gc(gv.gate)};transition:width .5s ease`"></div>
                </div>
              </td>
              <!-- 점수 -->
              <td style="padding:6px 4px;font-size:13px;font-weight:700;text-align:right;white-space:nowrap"
                  :style="`color:${gc(gv.gate)}`"
                  x-text="pct(gv)!=null?pct(gv)+'%':'N/A'"></td>
              <!-- 상태 배지 -->
              <td style="padding:6px 8px 6px 6px;text-align:center">
                <span style="font-size:10px;font-weight:700;padding:2px 6px;border-radius:4px;display:inline-block"
                      :style="pct(gv)!=null?`background:${gc(gv.gate)};color:#fff`:'color:var(--text2)'"
                      x-text="gv.gate?gv.gate.toUpperCase():'—'"></span>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>
  </template>

  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">📊 Key Metrics<span class="grp-chip grp-A" style="margin-left:6px;font-size:9.5px">A TCR·Accuracy·Quality</span><span class="grp-chip grp-C" style="margin-left:6px;font-size:9.5px">C Hallucination</span><span class="grp-chip grp-D" style="margin-left:6px;font-size:9.5px">D Latency·Cost</span></span><div class="sdiv-line"></div></div>
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='total_tasks'}" @click="selK=selK==='total_tasks'?null:'total_tasks'">
        <div class="kpi-lbl">Total Tasks</div>
        <div class="kpi-val" x-text="data.total_tasks||0"></div>
        <div class="kpi-sub muted" x-text="(data.name||'').substring(0,20)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='tcr'}" @click="selK=selK==='tcr'?null:'tcr'">
        <div class="kpi-lbl">TCR</div>
        <div class="kpi-val" :style="`color:${_col(_tcr(),90,70)}`" x-text="_tcr().toFixed(1)+'%'"></div>
        <div class="kpi-sub" :class="_tcr()>=90?'ok':_tcr()>=70?'warn':''">
          <span x-text="_tcr()>=90?'Good':_tcr()>=70?'Fair':'Low'"></span>
        </div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='accuracy'}" @click="selK=selK==='accuracy'?null:'accuracy'">
        <div class="kpi-lbl">Accuracy</div>
        <div class="kpi-val" :style="`color:${_col(_acc(),90,70)}`" x-text="_acc().toFixed(1)+'%'"></div>
        <div class="kpi-sub" :class="_acc()>=90?'ok':_acc()>=70?'warn':''">
          <span x-text="_acc()>=90?'Good':_acc()>=70?'Fair':'Low'"></span>
        </div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='hallucination'}" @click="selK=selK==='hallucination'?null:'hallucination'">
        <div class="kpi-lbl">Hallucination</div>
        <div class="kpi-val" :style="`color:${_hall()===0?'var(--green)':_hall()<=thresholds.hall_max*100?'var(--yellow)':'var(--red)'}`"
             x-text="_hall().toFixed(1)+'%'"></div>
        <div class="kpi-sub" x-text="_hall()===0?'Safe':_hall()<=thresholds.hall_max*100?'Warn':'High'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='p95_latency'}" @click="selK=selK==='p95_latency'?null:'p95_latency'">
        <div class="kpi-lbl">P95 Latency</div>
        <div class="kpi-val" :style="`color:${_colLat(_p95())}`" x-text="_fmtSec(_p95())"></div>
        <div class="kpi-sub muted" x-text="'avg: '+_fmtSec(data.efficiency_metrics?.latency?.mean||data.efficiency_metrics?.avg_latency||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='total_cost'}" @click="selK=selK==='total_cost'?null:'total_cost'">
        <div class="kpi-lbl">Total Cost</div>
        <div class="kpi-val" x-text="_fmtCost(_cost())"></div>
        <div class="kpi-sub muted" x-text="'per task: '+_fmtCost(_cost()/(data.total_tasks||1))"></div>
        <div class="kpi-sub" x-show="selModel" style="color:var(--accent);font-size:10px" x-text="selModel?.model?.split('/')[0]?.trim()||''"></div>
      </div>
    </div>
    <!-- kpi-act detail panel -->
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div class="panel-header">
            <span class="val-md" x-text="meta[selK]?.label||selK"></span>
            <span class="tag-sm" x-text="meta[selK]?.unit?'Unit: '+meta[selK].unit:''"></span>
            <button class="btn-close" @click="selK=null">×</button>
          </div>
          <div class="grid-2-divider">
            <div class="panel-bg2-r">
              <div class="label-upper">Description</div>
              <div class="body-text" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div class="panel-bg3">
              <div class="label-upper">📐 Calculation</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <div class="panel-bg">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">Related Tasks</span>
              <span class="tag-sm" x-text="filterLabel(selK)"></span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,data).length+' tasks'"></span>
            </div>
            <div class="dtx" style="max-height:220px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:170px minmax(0,1fr) 72px 60px;position:sticky;top:0;z-index:1">
                <span>Task ID</span><span>Type</span><span x-text="col3Label(selK)">Completion</span><span>Status</span>
              </div>
              <template x-for="t in items(selK,data)" :key="t.task_id">
                <div class="dtx-row" style="grid-template-columns:170px minmax(0,1fr) 72px 60px">
                  <span class="dtx-id" x-text="t.task_id"></span>
                  <span class="text-muted" x-text="t.task_type||'-'"></span>
                  <span :style="`color:${col3Color(selK,t)}`" x-text="col3Val(selK,t)"></span>
                  <span :class="(t.completion_score||0)>=1?'badge-ok':(t.completion_score||0)>=0.7?'badge-warn':'badge-ng'"
                        x-text="(t.completion_score||0)>=1?'Done':(t.completion_score||0)>=0.7?'Partial':'Fail'"></span>
                </div>
              </template>
              <div x-show="items(selK,data).length===0" style="padding:18px 10px;text-align:center;color:var(--text2);font-size:12px;line-height:1.6">
                Load an evaluation result file to view related tasks.
              </div>
            </div>
          </div>
        </div>
      </template>
    </div>
  </div>

  <!-- Deploy Gates -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🚀 Deployment Readiness <span style="font-size:10px;font-weight:400;opacity:.75;margin-left:4px">— Criteria met per environment</span></span><div class="sdiv-line"></div></div>
  <div class="dgate">
    <template x-for="g in deployGates()" :key="g.key">
      <div class="dgate-box" :class="g.cls">
        <div class="dgate-title">
          <span x-text="g.label"></span>
          <span class="dgate-badge" x-text="g.cls==='pass'?'PASS':g.cls==='fail'?'FAIL':`${g.passed}/${g.total}`"></span>
        </div>
        <template x-for="c in g.criteria" :key="c.name">
          <div class="dgate-row">
            <span x-text="c.pass?'✅':'❌'"></span>
            <span x-text="c.name"></span>
            <span class="dv" x-text="c.val"></span>
          </div>
        </template>
      </div>
    </template>
  </div>

  <!-- Charts: distribution only (2-col) -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">📈 Distribution<span class="grp-chip grp-A" style="margin-left:6px;font-size:9.5px">A Goal Achievement</span></span><div class="sdiv-line"></div></div>
  <div class="cg" style="margin-bottom:12px">
    <div class="cbox"><div class="ct">Success/Failure Distribution</div><div id="d2-ov-donut" class="plt-chart"></div></div>
    <div class="cbox"><div class="ct">Tasks by TaskType</div><div id="d2-ov-type" class="plt-chart"></div></div>
  </div>

  <!-- Perspective Radar: separate section -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🕸️ Perspective Scores<span class="grp-chip grp-A" style="margin-left:6px;font-size:9.5px">A Goal Achievement</span><span class="grp-chip grp-D" style="margin-left:6px;font-size:9.5px">D Performance Contract</span></span><div class="sdiv-line"></div></div>
  <div class="cg" style="margin-bottom:12px;align-items:stretch">
    <div class="cbox" style="display:flex;flex-direction:column">
      <div class="ct" style="flex-shrink:0">Agent Capability Radar <span class="text-xs-muted">(6 axes · Completion·Quality·Efficiency·Agentic·Reliability·Security)</span></div>
      <div id="d2-ov-persp" style="flex:1;min-height:260px;width:100%"></div>
    </div>
    <div class="cbox" style="display:flex;flex-direction:column;gap:8px">
      <div class="ct">📐 Axis Normalization Criteria</div>
      <p style="font-size:11px;color:var(--text2);margin:0;line-height:1.7">
        Metrics with different units are normalized to <b style="color:var(--text1)">0–1</b> for comparison on a single screen.
        Further out is better; an ideal agent has all axes close to 1.0.
      </p>
      <dl style="margin:0;display:flex;flex-direction:column;gap:0">
        <div style="display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px solid var(--border)">
          <span style="width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;margin-top:5px"></span>
          <div>
            <dt style="font-size:12px;font-weight:600;color:var(--text1);display:inline">Completion Rate</dt>
            <dd style="margin:0;font-size:11px;color:var(--text2);line-height:1.5">TCR. <code style="font-size:10px;background:var(--bg3);padding:1px 4px;border-radius:3px">avg(completion_score)</code></dd>
          </div>
        </div>
        <div style="display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px solid var(--border)">
          <span style="width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;margin-top:5px"></span>
          <div>
            <dt style="font-size:12px;font-weight:600;color:var(--text1);display:inline">Accuracy·Quality</dt>
            <dd style="margin:0;font-size:11px;color:var(--text2);line-height:1.5">Accuracy·quality·hallucination combined. <code style="font-size:10px;background:var(--bg3);padding:1px 4px;border-radius:3px">acc×0.4 + qual/5×0.4 + (1−hall)×0.2</code></dd>
          </div>
        </div>
        <div style="display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px solid var(--border)">
          <span style="width:6px;height:6px;border-radius:50%;background:#f59e0b;flex-shrink:0;margin-top:5px"></span>
          <div>
            <dt style="font-size:12px;font-weight:600;color:var(--text1);display:inline">Operational Efficiency</dt>
            <dd style="margin:0;font-size:11px;color:var(--text2);line-height:1.5">Speed+cost combined. <code style="font-size:10px;background:var(--bg3);padding:1px 4px;border-radius:3px">(max(0,1−P95/10s) + max(0,1−cost/$0.05)) ÷ 2</code></dd>
          </div>
        </div>
        <div style="display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px solid var(--border)">
          <span style="width:6px;height:6px;border-radius:50%;background:#8b5cf6;flex-shrink:0;margin-top:5px"></span>
          <div>
            <dt style="font-size:12px;font-weight:600;color:var(--text1);display:inline">Agentic Capability</dt>
            <span x-show="!data.has_agentic" class="text-xs-muted"> — Tracker inactive (N/A)</span>
            <dd style="margin:0;font-size:11px;color:var(--text2);line-height:1.5"><code style="font-size:10px;background:var(--bg3);padding:1px 4px;border-radius:3px">Tool F1×0.5 + CoordSR×0.25 + WorkflowSR×0.25</code></dd>
          </div>
        </div>
        <div style="display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px solid var(--border)">
          <span style="width:6px;height:6px;border-radius:50%;background:#10b981;flex-shrink:0;margin-top:5px"></span>
          <div>
            <dt style="font-size:12px;font-weight:600;color:var(--text1);display:inline">Reliability</dt>
            <dd style="margin:0;font-size:11px;color:var(--text2);line-height:1.5">Error·retry stability. <code style="font-size:10px;background:var(--bg3);padding:1px 4px;border-radius:3px">NoErrorTaskRate×0.6 + NoRetryTaskRate×0.4</code></dd>
          </div>
        </div>
        <div style="display:flex;gap:8px;align-items:baseline;padding:5px 0">
          <span style="width:6px;height:6px;border-radius:50%;background:#ef4444;flex-shrink:0;margin-top:5px"></span>
          <div>
            <dt style="font-size:12px;font-weight:600;color:var(--text1);display:inline">Security</dt>
            <span x-show="!data.has_security" class="text-xs-muted"> — Tracker inactive (N/A)</span>
            <dd style="margin:0;font-size:11px;color:var(--text2);line-height:1.5"><code style="font-size:10px;background:var(--bg3);padding:1px 4px;border-radius:3px">avg(InputSecurity, 1−OutputLeak, AuthCompliance)</code></dd>
          </div>
        </div>
      </dl>
    </div>
  </div>

  <!-- ═══ Gate 간 상관 히트맵 ═══ -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔥 Gate Correlation Heatmap<span class="grp-chip grp-D" style="margin-left:6px;font-size:9.5px">Pearson correlation per task score</span></span><div class="sdiv-line"></div></div>
  <div x-data="{open:false}" style="margin-bottom:12px">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
      <div style="font-size:12px;color:var(--text2);line-height:1.5">
        Pearson correlation coefficient between task-level scores across Gates A–G.
        <strong style="color:var(--green)">+1 (green)</strong> = improve together &nbsp;·&nbsp;
        <strong style="color:var(--red)">-1 (red)</strong> = opposite direction &nbsp;·&nbsp;
        <span style="color:var(--text2)">gray cell = insufficient data</span>
      </div>
      <button class="btn" @click="open=!open;$nextTick(()=>open&&drawGateHeatmap())"
              x-text="open?'Collapse':'Open Heatmap'" style="flex-shrink:0;margin-left:8px"></button>
    </div>
    <div x-show="open" x-cloak>
      <!-- 데이터 부족 안내 -->
      <template x-if="!hasHeatmapData()">
        <div style="padding:20px;text-align:center;background:var(--bg2);border:1px solid var(--border);border-radius:8px;color:var(--text2);font-size:12px">
          Insufficient data: fewer than 5 tasks or no Gate score data available for correlation analysis.
        </div>
      </template>
      <template x-if="hasHeatmapData()">
        <div>
          <div id="d2-gate-heatmap" style="height:320px"></div>
          <!-- 해석 가이드 -->
          <div style="margin-top:8px;display:flex;gap:12px;flex-wrap:wrap;font-size:11px;color:var(--text2)">
            <span>💡 A↔D high positive: performance degradation also lowers goal achievement</span>
            <span>💡 E↔B high positive: security issues and behavioral anomalies co-occur</span>
            <span>💡 Strong negative: trade-off relationship — improving one Gate may degrade another</span>
          </div>
        </div>
      </template>
    </div>
  </div>

  <!-- Anomalies Summary (aggregated from Insights) -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">⚠️ Anomalies<span class="grp-chip grp-G" style="margin-left:6px;font-size:9.5px">G Observability</span></span><div class="sdiv-line"></div></div>

  <!-- 이상 없음 -->
  <template x-if="autoAnomalies().length===0 && zScoreAnomalies().length===0 && !(data?.insights?.alerts?.length) && !(data?.insights?.recommendations?.length)">
    <div class="alert low">
      <div class="alert-body">
        <div class="alert-t">✅ No anomalies</div>
        <div class="alert-b">All key metrics are within thresholds.</div>
      </div>
    </div>
  </template>

  <!-- 카운트 요약 배지 -->
  <template x-if="autoAnomalies().length>0 || zScoreAnomalies().length>0 || (data?.insights?.alerts?.length) || (data?.insights?.recommendations?.length)">
    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px">
      <template x-if="autoAnomalies().length>0">
        <span class="badge-ng" style="cursor:pointer" @click="sec='insights'" x-text="'Threshold: ' + autoAnomalies().length"></span>
      </template>
      <template x-if="zScoreAnomalies().length>0">
        <span class="badge-warn" style="cursor:pointer" @click="sec='insights'" x-text="'Statistical anomaly: ' + zScoreAnomalies().length"></span>
      </template>
      <template x-if="data?.insights?.alerts?.length">
        <span class="badge-info" style="cursor:pointer" @click="sec='insights'" x-text="'Server alerts: ' + data.insights.alerts.length"></span>
      </template>
      <template x-if="data?.insights?.recommendations?.length">
        <span class="badge-gray" style="cursor:pointer" @click="sec='insights'" x-text="'Recommendations: ' + data.insights.recommendations.length"></span>
      </template>
    </div>
  </template>

  <!-- ① 임계값 기반 이상 (최대 3건) -->
  <template x-for="(a, i) in autoAnomalies().slice(0,3)" :key="'ta'+i">
    <div class="alert clickable" :class="a.level" @click="sec='insights'">
      <div class="alert-body">
        <div style="display:flex;align-items:center;gap:5px;margin-bottom:2px">
          <span class="text-xs-muted">Threshold</span>
          <span class="alert-t" x-text="a.metric"></span>
        </div>
        <div class="alert-b" x-text="a.detail"></div>
      </div>
      <span class="alert-link">Insights →</span>
    </div>
  </template>
  <template x-if="autoAnomalies().length > 3">
    <div style="font-size:11px;color:var(--text2);padding:0 0 6px 4px;cursor:pointer" @click="sec='insights'"
         x-text="'… +' + (autoAnomalies().length - 3) + ' more'"></div>
  </template>

  <!-- ② Z-Score 통계 이상 (최대 3건) -->
  <template x-if="zScoreAnomalies().length > 0">
    <div>
      <template x-for="(z, i) in zScoreAnomalies().slice(0,3)" :key="'zs'+i">
        <div class="alert clickable medium" @click="sec='insights'">
          <div class="alert-body">
            <div style="display:flex;align-items:center;gap:5px;margin-bottom:2px">
              <span class="text-xs-muted">Statistical anomaly</span>
              <span class="alert-t" x-text="z.task_id"></span>
            </div>
            <div class="alert-b">
              <span x-show="z.zLat!=null && Math.abs(z.zLat)>2" x-text="'Latency z='+((z.zLat||0).toFixed(1))+'σ ('+((z.lat||0).toFixed(2))+'s)'"></span>
              <span x-show="z.zLat!=null&&Math.abs(z.zLat)>2&&z.zAcc!=null&&Math.abs(z.zAcc)>2"> · </span>
              <span x-show="z.zAcc!=null && Math.abs(z.zAcc)>2" x-text="'Accuracy z='+((z.zAcc||0).toFixed(1))+'σ ('+(((z.acc||0)*100).toFixed(1))+'%)'"></span>
            </div>
          </div>
          <span class="alert-link">Insights →</span>
        </div>
      </template>
      <template x-if="zScoreAnomalies().length > 3">
        <div style="font-size:11px;color:var(--text2);padding:0 0 6px 4px;cursor:pointer" @click="sec='insights'"
             x-text="'… +' + (zScoreAnomalies().length - 3) + ' more'"></div>
      </template>
    </div>
  </template>

  <!-- ③ 서버 알림 (최대 2건) -->
  <template x-if="data?.insights?.alerts?.length">
    <div>
      <template x-for="(al, i) in (data.insights.alerts||[]).slice(0,2)" :key="'al'+i">
        <div class="alert clickable" :class="al.level==='error'?'critical':al.level==='warn'?'medium':'low'" @click="sec='insights'">
          <div class="alert-body">
            <div style="display:flex;align-items:center;gap:5px;margin-bottom:2px">
              <span class="text-xs-muted">Server alert</span>
              <span :class="al.level==='error'?'badge-ng':al.level==='warn'?'badge-warn':'badge-info'" x-text="al.level||'info'"></span>
            </div>
            <div class="alert-b" x-text="al.message||al"></div>
          </div>
          <span class="alert-link">Insights →</span>
        </div>
      </template>
    </div>
  </template>

  <!-- ④ 권고사항 상위 2건 -->
  <template x-if="data?.insights?.recommendations?.length">
    <div>
      <template x-for="(r, i) in (data.insights.recommendations||[]).slice(0,2)" :key="'rc'+i">
        <div class="rec" style="cursor:pointer" @click="sec='insights'">
          <div class="rec-t" style="display:flex;align-items:center;gap:6px">
            <span class="text-xs-muted">Recommendation</span>
            <span :class="(r.priority||r.level)==='high'?'badge-ng':(r.priority||r.level)==='medium'?'badge-warn':'badge-info'"
                  x-text="((r.priority||r.level||'low')).toUpperCase()"></span>
            <span style="font-size:12px" x-text="r.title||r.message||r"></span>
          </div>
          <div class="rec-b" x-text="r.detail||''"></div>
        </div>
      </template>
      <template x-if="(data.insights.recommendations||[]).length > 2">
        <div style="font-size:11px;color:var(--text2);padding:2px 0 4px 4px;cursor:pointer" @click="sec='insights'"
             x-text="'… + ' + ((data.insights.recommendations||[]).length - 2) + ' more'"></div>
      </template>
    </div>
  </template>

  <!-- 전체 보기 -->
  <template x-if="autoAnomalies().length>0 || zScoreAnomalies().length>0 || (data?.insights?.alerts?.length) || (data?.insights?.recommendations?.length)">
    <div style="text-align:right;margin-top:6px">
      <button class="btn" @click="sec='insights'" class="fs-sm">View all in Insights →</button>
    </div>
  </template>

</div><!-- /overview -->

<!-- ══ SECTION 2: QUALITY ══ -->
<div x-show="data && sec==='quality'" x-cloak>

  <!-- TCR subsection -->
  <div id="s-quality-group-a" class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">✅ Task Completion Rate (TCR)<span class="grp-chip grp-A" style="margin-left:6px;font-size:9.5px">A Goal Achievement</span></span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    expandedId:null,
    meta:{
      tcr:{label:'TCR',unit:'%',desc:'Overall completion capability of the agent, weighted by full and partial successes via completion_score. Measures more realistic performance by recognizing partial completions instead of binary pass/fail.',hint:'Σ completion_score / total × 100'},
      full_success:{label:'Full Success',unit:'tasks',desc:'Tasks that fully met all requested requirements. Higher values indicate the agent\'s stable full-completion capability.',hint:'score ≥ 1.0'},
      partial_success:{label:'Partial Success',unit:'tasks',desc:'Tasks that met core requirements but missed some details. Indicates the agent understood the direction but lacked precision. Important category for identifying improvement areas.',hint:'0.7 ≤ score < 1.0'},
      failures:{label:'Failure',unit:'tasks',desc:'Tasks that did not meet the completion threshold. Analyzing failure types and patterns helps identify agent weaknesses and task types requiring improvement.',hint:'score < 0.7'},
    },
    formula(k,d){
      const t=d.tasks||[],n=t.length||1;
      const fs=t.filter(x=>x.completion_score>=1.0).length;
      const ps=t.filter(x=>x.completion_score>=0.7&&x.completion_score<1.0).length;
      const fl=t.filter(x=>x.completion_score<0.7).length;
      const ws=t.reduce((a,b)=>a+(b.completion_score||0),0);
      if(k==='tcr')return `TCR = Σ completion_score / total\n= ${ws.toFixed(2)} / ${n} = ${(ws/n*100).toFixed(1)}%`;
      if(k==='full_success')return `Full Success = score ≥ 1.0\n${fs} / ${n} = ${(fs/n*100).toFixed(1)}%`;
      if(k==='partial_success')return `Partial Success = 0.7 ≤ score < 1.0\n${ps} / ${n} = ${(ps/n*100).toFixed(1)}%`;
      if(k==='failures')return `Failure = score < 0.7\n${fl} / ${n} = ${(fl/n*100).toFixed(1)}%`;
      return '';
    },
    items(k,d){
      const t=d.tasks||[];
      if(k==='full_success')return t.filter(x=>x.completion_score>=1.0);
      if(k==='partial_success')return t.filter(x=>x.completion_score>=0.7&&x.completion_score<1.0);
      if(k==='failures')return t.filter(x=>x.completion_score<0.7);
      return t;
    },
    filterLabel(k){return {full_success:'score≥1.0',partial_success:'0.7≤score<1.0',failures:'score<0.7',tcr:'All'}[k]||'All';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='tcr'}" @click="selK=selK==='tcr'?null:'tcr'">
        <div class="kpi-lbl">TCR</div>
        <div class="kpi-val" :style="`color:${_bc(_tcrG(data),thresholds.tcr_min*100,Math.max(0,thresholds.tcr_min*100-20))}`" x-text="_tcrG(data).toFixed(1)+'%'"></div>
        <div class="kpi-sub" x-text="(()=>{const t=data.tasks||[];const fs=t.filter(x=>x.completion_score>=1.0).length;const ps=t.filter(x=>x.completion_score>=0.7&&x.completion_score<1.0).length;return `Full${fs}+Partial${ps} / ${t.length}`;})()"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='full_success'}" @click="selK=selK==='full_success'?null:'full_success'">
        <div class="kpi-lbl">Full Success</div>
        <div class="kpi-val" style="color:var(--green)" x-text="(data.tasks||[]).filter(t=>t.completion_score>=1.0).length"></div>
        <div class="kpi-sub" x-text="((data.tasks||[]).filter(t=>t.completion_score>=1.0).length/(data.total_tasks||1)*100).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='partial_success'}" @click="selK=selK==='partial_success'?null:'partial_success'">
        <div class="kpi-lbl">Partial Success</div>
        <div class="kpi-val" style="color:var(--yellow)" x-text="(data.tasks||[]).filter(t=>t.completion_score>=0.7&&t.completion_score<1.0).length"></div>
        <div class="kpi-sub" x-text="((data.tasks||[]).filter(t=>t.completion_score>=0.7&&t.completion_score<1.0).length/(data.total_tasks||1)*100).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='failures'}" @click="selK=selK==='failures'?null:'failures'">
        <div class="kpi-lbl">Failure</div>
        <div class="kpi-val" style="color:var(--red)" x-text="(data.tasks||[]).filter(t=>t.completion_score<0.7).length"></div>
        <div class="kpi-sub" x-text="((data.tasks||[]).filter(t=>t.completion_score<0.7).length/(data.total_tasks||1)*100).toFixed(1)+'%'"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <!-- Panel header -->
          <div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span class="val-md" x-text="meta[selK]?.label||selK"></span>
            <span style="font-size:12px;color:var(--text2);background:var(--bg3);padding:1px 8px;border-radius:99px"
                  x-text="items(selK,data).length+' tasks'"></span>
            <!-- 부분 성공: 재시도 미달 배지 -->
            <template x-if="selK==='partial_success'">
              <span style="display:flex;gap:6px;flex-wrap:wrap">
                <span x-show="items(selK,data).filter(t=>(t.attempts||1)>1).length>0"
                      style="font-size:11px;background:rgba(245,158,11,.15);color:var(--yellow);padding:1px 8px;border-radius:99px;border:1px solid rgba(245,158,11,.3)"
                      x-text="'⚠ Under threshold after retry: '+items(selK,data).filter(t=>(t.attempts||1)>1).length"></span>
                <span style="font-size:11px;background:rgba(239,68,68,.1);color:var(--red);padding:1px 8px;border-radius:99px;border:1px solid rgba(239,68,68,.25)"
                      x-text="'Weak (70~84%): '+items(selK,data).filter(t=>(t.completion_score||0)<0.85&&(t.completion_score||0)>=0.7).length"></span>
                <span style="font-size:11px;background:rgba(245,158,11,.15);color:var(--yellow);padding:1px 8px;border-radius:99px;border:1px solid rgba(245,158,11,.3)"
                      x-text="'Strong (85~99%): '+items(selK,data).filter(t=>(t.completion_score||0)>=0.85).length"></span>
              </span>
            </template>
            <!-- 실패: 오류 있는 태스크 배지 -->
            <template x-if="selK==='failures'">
              <span x-show="items(selK,data).filter(t=>t.errors&&t.errors.length).length>0"
                    style="font-size:11px;background:rgba(239,68,68,.1);color:var(--red);padding:1px 8px;border-radius:99px;border:1px solid rgba(239,68,68,.25)"
                    x-text="'Errors: '+items(selK,data).filter(t=>t.errors&&t.errors.length).length"></span>
            </template>
            <button class="btn-close" @click="selK=null;expandedId=null">×</button>
          </div>
          <!-- 설명 + 산출방식 -->
          <div class="grid-2-divider">
            <div class="panel-bg2-r">
              <div class="label-upper">Description</div>
              <div class="body-text" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div class="panel-bg3">
              <div class="label-upper">📐 Calculation</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <!-- Task table -->
          <div class="panel-bg">
            <div class="dtx" style="max-height:360px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:minmax(120px,1fr) 90px 72px 40px 60px 52px;position:sticky;top:0;z-index:1">
                <span>Task ID</span><span>Type</span><span>Completion</span><span>Tries</span><span>Accuracy</span><span></span>
              </div>
              <template x-for="(t,ti) in items(selK,data)" :key="t.task_id||ti">
                <div>
                  <!-- Main row -->
                  <div class="dtx-row"
                       :style="`grid-template-columns:minmax(120px,1fr) 90px 72px 40px 60px 52px;${expandedId===t.task_id?'background:rgba(99,102,241,.07);border-left:2px solid var(--accent)':''}`">
                    <span class="dtx-id" style="font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="t.task_id"></span>
                    <span style="font-size:11px;color:var(--text2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="t.task_type||'—'"></span>
                    <span>
                      <div style="display:flex;align-items:center;gap:4px">
                        <div style="flex:1;height:4px;background:var(--bg3);border-radius:2px;overflow:hidden">
                          <div :style="`width:${Math.min(100,(t.completion_score||0)*100).toFixed(0)}%;height:100%;background:${(t.completion_score||0)>=1?'var(--green)':(t.completion_score||0)>=0.85?'var(--yellow)':'var(--orange)'};border-radius:2px`"></div>
                        </div>
                        <span style="font-size:10px;width:28px;text-align:right;color:var(--text2)"
                              :style="`color:${(t.completion_score||0)>=1?'var(--green)':(t.completion_score||0)>=0.7?'var(--yellow)':'var(--red)'}`"
                              x-text="((t.completion_score||0)*100).toFixed(0)+'%'"></span>
                      </div>
                    </span>
                    <span style="font-size:11px;color:var(--text2);text-align:center"
                          :style="`color:${(t.attempts||1)>1?'var(--yellow)':'var(--text2)'}`"
                          x-text="t.attempts||1"></span>
                    <span style="font-size:11px;text-align:center"
                          :style="`color:${t.accuracy_score!=null?(t.accuracy_score>=0.7?'var(--green)':t.accuracy_score>=0.4?'var(--yellow)':'var(--red)'):'var(--text2)'}`"
                          x-text="t.accuracy_score!=null?((t.accuracy_score||0)*100).toFixed(0)+'%':'—'"></span>
                    <button class="btn" style="padding:1px 8px;font-size:10px;min-width:0"
                            :style="`background:${expandedId===t.task_id?'var(--accent)':'transparent'};color:${expandedId===t.task_id?'#fff':'var(--accent)'};border-color:var(--accent)`"
                            @click.stop="expandedId=expandedId===t.task_id?null:t.task_id"
                            x-text="expandedId===t.task_id?'Close':'Detail'"></button>
                  </div>
                  <!-- Sub-info row (always visible) -->
                  <div style="padding:2px 8px 4px 8px;font-size:10px;color:var(--text2);display:flex;gap:12px;flex-wrap:wrap"
                       x-show="(t.errors&&t.errors.length)||(t.accuracy_score==null)">
                    <span x-show="t.accuracy_score==null" class="muted">🔍 Accuracy not measured (ground_truth not set)</span>
                    <span x-show="t.errors&&t.errors.length" style="color:var(--red)"
                          x-text="'Errors: '+(t.errors||[]).slice(0,2).join(' · ')+(t.errors?.length>2?' + '+(t.errors.length-2)+' more':'')"></span>
                  </div>
                  <!-- Expanded detail row -->
                  <div x-show="expandedId===t.task_id"
                       style="background:rgba(99,102,241,.04);border-top:1px solid var(--border);border-left:2px solid var(--accent)">

                    <!-- ① 부분성공/실패: 원인 분석 패널 -->
                    <template x-if="(t.completion_score||0)<1.0">
                      <div style="border-bottom:1px solid var(--border)" :style="`background:${tcrSev(t).bg}`">
                        <div style="padding:10px 14px 0 14px">
                          <!-- 헤더: 심각도 라벨 + 점수 게이지 -->
                          <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap">
                            <span style="font-size:10px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.05em">🔍 Incomplete Cause Analysis</span>
                            <span style="font-size:11px;padding:2px 8px;border-radius:99px;border:1px solid;font-weight:600"
                                  :style="`color:${tcrSev(t).color};border-color:${tcrSev(t).border};background:var(--bg2)`"
                                  x-text="tcrSev(t).label"></span>
                            <div style="flex:1;max-width:200px;display:flex;align-items:center;gap:5px">
                              <div style="flex:1;height:5px;background:var(--bg3);border-radius:3px;overflow:hidden">
                                <div :style="`width:${((t.completion_score||0)*100).toFixed(0)}%;height:100%;border-radius:3px;background:${(t.completion_score||0)>=0.9?'#f59e0b':(t.completion_score||0)>=0.7?'#f97316':'var(--red)'}`"></div>
                              </div>
                              <span style="font-size:11px;font-variant-numeric:tabular-nums;font-weight:700;flex-shrink:0"
                                    :style="`color:${tcrSev(t).color}`"
                                    x-text="((t.completion_score||0)*100).toFixed(0)+'%'"></span>
                            </div>
                          </div>

                          <!-- 패턴 해석 -->
                          <div style="font-size:12px;line-height:1.6;padding:6px 10px;border-radius:6px;border-left:3px solid;margin-bottom:10px;background:var(--bg2)"
                               :style="`border-color:${tcrSev(t).color}`"
                               x-text="tcrPattern(t)"></div>

                          <!-- 지표 교차 분석 카드 -->
                          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px">
                            <div style="flex:1;min-width:80px;padding:6px 10px;background:var(--bg2);border-radius:6px;border:1px solid var(--border)">
                              <div style="font-size:10px;color:var(--text2);margin-bottom:1px">Completion Rate</div>
                              <div style="font-size:14px;font-weight:700"
                                   :style="`color:${(t.completion_score||0)>=0.9?'#f59e0b':(t.completion_score||0)>=0.7?'#f97316':'var(--red)'}`"
                                   x-text="((t.completion_score||0)*100).toFixed(0)+'%'"></div>
                              <div style="font-size:10px"
                                   :style="`color:${(t.completion_score||0)>=0.9?'var(--yellow)':'var(--red)'}`"
                                   x-text="(t.completion_score||0)>=0.9?'▲ Minor':'(t.completion_score||0)>=0.7?'⚠ Partial':'✕ Failed'"></div>
                            </div>
                            <div style="flex:1;min-width:80px;padding:6px 10px;background:var(--bg2);border-radius:6px;border:1px solid var(--border)">
                              <div style="font-size:10px;color:var(--text2);margin-bottom:1px">Accuracy</div>
                              <div style="font-size:14px;font-weight:700"
                                   :style="`color:${(t.accuracy_score||0)>=0.7?'var(--green)':(t.accuracy_score||0)>=0.4?'var(--yellow)':'var(--red)'}`"
                                   x-text="t.accuracy_score>0?((t.accuracy_score||0)*100).toFixed(0)+'%':'—'"></div>
                              <div class="text-xs-muted"
                                   x-text="t.accuracy_score>0?((t.accuracy_score||0)>=0.7?'✓ Good':(t.accuracy_score||0)>=0.4?'⚠ Fair':'✕ Low'):'N/A'"></div>
                            </div>
                            <template x-if="(t.advanced_metrics||{}).g_eval_score!=null">
                              <div style="flex:1;min-width:80px;padding:6px 10px;background:var(--bg2);border-radius:6px;border:1px solid var(--border)">
                                <div style="font-size:10px;color:var(--text2);margin-bottom:1px">G-Eval</div>
                                <div style="font-size:14px;font-weight:700"
                                     :style="`color:${(t.advanced_metrics.g_eval_score||0)>=0.7?'var(--green)':(t.advanced_metrics.g_eval_score||0)>=0.4?'var(--yellow)':'var(--red)'}`"
                                     x-text="(t.advanced_metrics.g_eval_score||0).toFixed(3)"></div>
                                <div style="font-size:10px"
                                     :style="`color:${t.advanced_metrics.g_eval_passed===true||t.advanced_metrics.g_eval_passed==='true'?'var(--green)':'var(--red)'}`"
                                     x-text="t.advanced_metrics.g_eval_passed===true||t.advanced_metrics.g_eval_passed==='true'?'✓ Pass':'✕ Fail'"></div>
                              </div>
                            </template>
                            <template x-if="(t.attempts||1)>1">
                              <div style="flex:1;min-width:80px;padding:6px 10px;background:var(--bg2);border-radius:6px;border:1px solid rgba(245,158,11,.3)">
                                <div style="font-size:10px;color:var(--text2);margin-bottom:1px">Retries</div>
                                <div style="font-size:14px;font-weight:700;color:var(--yellow)" x-text="(t.attempts||1)"></div>
                                <div style="font-size:10px;color:var(--yellow)">⚠ Unstable</div>
                              </div>
                            </template>
                            <template x-if="(t.errors||[]).length>0">
                              <div style="flex:1;min-width:80px;padding:6px 10px;background:var(--bg2);border-radius:6px;border:1px solid rgba(239,68,68,.3)">
                                <div style="font-size:10px;color:var(--text2);margin-bottom:1px">Errors</div>
                                <div style="font-size:14px;font-weight:700;color:var(--red)" x-text="(t.errors||[]).length"></div>
                                <div style="font-size:10px;color:var(--red)">✕ Occurred</div>
                              </div>
                            </template>
                          </div>

                          <!-- 정확도 성분 분석 -->
                          <template x-if="tcrAccComp(t).length>0">
                            <div style="margin-bottom:10px">
                              <div style="font-size:10px;font-weight:600;color:var(--text2);margin-bottom:4px">Accuracy Component Analysis <span style="font-weight:400;color:var(--text2)">(sorted low→high · with weights)</span></div>
                              <template x-for="(c,ci) in tcrAccComp(t)" :key="ci">
                                <div style="display:flex;align-items:center;gap:5px;margin-bottom:3px">
                                  <span style="width:88px;flex-shrink:0;font-size:10px;color:var(--text2)" x-text="c.label"></span>
                                  <div style="flex:1;height:5px;background:var(--bg3);border-radius:3px;overflow:hidden">
                                    <div :style="`width:${(c.val*100).toFixed(0)}%;height:100%;border-radius:3px;background:${c.val>=0.7?'#10b981':c.val>=0.4?'#f59e0b':'#ef4444'}`"></div>
                                  </div>
                                  <span style="width:32px;text-align:right;font-size:10px;font-variant-numeric:tabular-nums"
                                        :style="`color:${c.val>=0.7?'var(--green)':c.val>=0.4?'var(--yellow)':'var(--red)'}`"
                                        x-text="(c.val*100).toFixed(0)+'%'"></span>
                                  <span style="width:28px;font-size:10px;color:var(--text2)" x-text="'w'+c.w+'%'"></span>
                                </div>
                              </template>
                              <div style="font-size:10px;color:var(--text2);margin-top:3px;padding-left:93px"
                                   x-text="tcrAccComp(t)[0]?'↑ '+tcrAccComp(t)[0].label+' lowest ('+((tcrAccComp(t)[0].val||0)*100).toFixed(0)+'%) — this component is dragging accuracy down the most':''"></div>
                            </div>
                          </template>

                          <!-- G-Eval 불합격 이유 -->
                          <template x-if="(t.advanced_metrics||{}).g_eval_reason&&(t.advanced_metrics.g_eval_passed===false||t.advanced_metrics.g_eval_passed==='false')">
                            <div style="margin-bottom:10px;padding:7px 10px;background:rgba(239,68,68,.06);border:1px solid rgba(239,68,68,.2);border-radius:6px">
                              <div style="font-size:10px;font-weight:600;color:var(--red);margin-bottom:3px">🤖 G-Eval Fail Reason</div>
                              <div style="font-size:11px;color:var(--text);line-height:1.6" x-text="t.advanced_metrics.g_eval_reason"></div>
                            </div>
                          </template>

                          <!-- 개선 권고 -->
                          <template x-if="tcrRecs(t).length>0">
                            <div style="margin-bottom:12px">
                              <div style="font-size:10px;font-weight:600;color:var(--text2);margin-bottom:4px">💡 Improvement Recommendations</div>
                              <template x-for="(rc,ri) in tcrRecs(t)" :key="ri">
                                <div style="display:flex;gap:6px;align-items:flex-start;margin-bottom:4px;padding:5px 8px;background:var(--bg2);border-radius:5px">
                                  <span x-text="rc.icon" style="flex-shrink:0;font-size:13px;margin-top:1px"></span>
                                  <span style="flex:1;font-size:11px;color:var(--text);line-height:1.5" x-text="rc.text"></span>
                                  <span style="flex-shrink:0;font-size:10px;padding:1px 5px;border-radius:99px;margin-top:1px"
                                        :style="rc.pri==='high'?'background:rgba(239,68,68,.15);color:var(--red)':rc.pri==='med'?'background:rgba(245,158,11,.15);color:var(--yellow)':'background:var(--bg3);color:var(--text2)'"
                                        x-text="rc.pri==='high'?'High':'Note'"></span>
                                </div>
                              </template>
                            </div>
                          </template>
                        </div>
                      </div>
                    </template>

                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;font-size:12px">
                      <!-- Left: 태스크 기본 정보 -->
                      <div style="padding:10px 14px;border-right:1px solid var(--border)">
                        <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px">Task Info</div>
                        <div class="drow"><span class="dk">ID</span><span style="font-family:monospace;font-size:11px" x-text="t.task_id"></span></div>
                        <div class="drow"><span class="dk">Type</span><span x-text="t.task_type||'—'"></span></div>
                        <div class="drow"><span class="dk">Completion</span>
                          <span :style="`color:${(t.completion_score||0)>=1?'var(--green)':(t.completion_score||0)>=0.7?'var(--yellow)':'var(--red)'};font-weight:700`"
                                x-text="((t.completion_score||0)*100).toFixed(1)+'%'"></span></div>
                        <div class="drow"><span class="dk">Accuracy</span>
                          <span :style="t.accuracy_score!=null?`color:${(t.accuracy_score||0)>=0.7?'var(--green)':(t.accuracy_score||0)>=0.4?'var(--yellow)':'var(--red)'}`:''"
                                x-text="t.accuracy_score!=null?((t.accuracy_score||0)*100).toFixed(1)+'%':'N/A'"></span></div>
                        <div class="drow"><span class="dk">Latency</span><span x-text="t.execution_time!=null?t.execution_time.toFixed(3)+'s':'—'"></span></div>
                        <div class="drow"><span class="dk">Tokens</span><span x-text="(t.tokens_used?.total||t.tokens_used||0).toLocaleString()"></span></div>
                        <div class="drow"><span class="dk">Attempts</span>
                          <span :style="`color:${(t.attempts||1)>1?'var(--yellow)':'var(--text)'}`"
                                x-text="t.attempts||1"></span></div>
                        <div class="drow"><span class="dk">Tool Calls</span><span x-text="Array.isArray(t.tool_calls)?t.tool_calls.length:(t.tool_calls!=null?t.tool_calls:'0')"></span></div>
                        <div class="drow" x-show="t.framework"><span class="dk">Framework</span><span x-text="t.framework"></span></div>

                        <!-- accuracy_detail breakdown -->
                        <template x-if="t.accuracy_detail&&Object.keys(t.accuracy_detail).length">
                          <div style="margin-top:8px">
                            <div style="font-size:10px;font-weight:600;color:var(--text2);margin-bottom:3px">Accuracy Details</div>
                            <template x-for="(v,k) in t.accuracy_detail" :key="k">
                              <div class="drow" style="font-size:10px">
                                <span class="dk" x-text="k"></span>
                                <span x-text="typeof v==='number'?(v*100).toFixed(1)+'%':String(v)"></span>
                              </div>
                            </template>
                          </div>
                        </template>
                      </div>

                      <!-- Right: 오류 + Q&A 비교 + Advanced Metrics -->
                      <div style="padding:10px 14px">
                        <!-- 오류 목록 -->
                        <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px">Errors & Other</div>
                        <template x-if="t.errors&&t.errors.length">
                          <div>
                            <template x-for="(e,ei) in (t.errors||[])" :key="ei">
                              <div style="font-family:monospace;font-size:10px;color:var(--red);padding:3px 6px;background:rgba(239,68,68,.08);border-radius:4px;margin-bottom:3px;word-break:break-all" x-text="e"></div>
                            </template>
                          </div>
                        </template>
                        <template x-if="!(t.errors&&t.errors.length)">
                          <div style="color:var(--green);font-size:11px;margin-bottom:8px">✓ No Errors</div>
                        </template>

                        <!-- Q&A 비교 (부분성공/실패 시) -->
                        <template x-if="(t.completion_score||0)<1.0&&(t.question||t.response||t.ground_truth)">
                          <div style="margin-top:10px">
                            <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:5px">💬 Q&A Comparison</div>
                            <template x-if="t.question">
                              <div style="margin-bottom:6px">
                                <div style="font-size:10px;color:var(--text2);margin-bottom:2px">Question / Input</div>
                                <div style="font-size:11px;background:var(--bg3);border-radius:5px;padding:5px 8px;border-left:2px solid var(--accent);max-height:70px;overflow-y:auto;line-height:1.5;word-break:break-all"
                                     x-text="t.question"></div>
                              </div>
                            </template>
                            <template x-if="t.response">
                              <div style="margin-bottom:6px">
                                <div style="font-size:10px;color:var(--text2);margin-bottom:2px">Agent Response</div>
                                <div style="font-size:11px;background:var(--bg3);border-radius:5px;padding:5px 8px;border-left:2px solid var(--yellow);max-height:80px;overflow-y:auto;line-height:1.5;word-break:break-all"
                                     x-text="t.response"></div>
                              </div>
                            </template>
                            <template x-if="t.ground_truth">
                              <div style="margin-bottom:6px">
                                <div style="font-size:10px;color:var(--text2);margin-bottom:2px">Ground Truth</div>
                                <div style="font-size:11px;background:rgba(16,185,129,.06);border-radius:5px;padding:5px 8px;border-left:2px solid var(--green);max-height:70px;overflow-y:auto;line-height:1.5;word-break:break-all"
                                     x-text="t.ground_truth"></div>
                              </div>
                            </template>
                          </div>
                        </template>

                        <!-- Advanced Metrics -->
                        <template x-if="t.advanced_metrics&&Object.keys(t.advanced_metrics).length">
                          <div style="margin-top:10px">
                            <div style="font-size:10px;font-weight:600;color:var(--text2);margin-bottom:3px">Advanced Metrics</div>
                            <template x-for="(v,k) in t.advanced_metrics" :key="k">
                              <div class="drow" style="font-size:10px">
                                <span class="dk" x-text="k"></span>
                                <span x-text="typeof v==='number'?v.toFixed(3):String(v)"></span>
                              </div>
                            </template>
                          </div>
                        </template>
                      </div>
                    </div>
                  </div>
                </div>
              </template>
            </div>
            <div style="margin-top:6px;font-size:10px;color:var(--text2)">
              <span x-text="filterLabel(selK)"></span> · Click [Detail] to view full info
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cg" style="margin-top:8px">
      <div class="cbox"><div class="ct">Completion Rate Distribution</div><div id="d2-q-donut" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">TCR by Task Type</div><div id="d2-q-type-tcr" class="plt-chart"></div></div>
    </div>
  </div>

  <!-- Accuracy subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🎯 Accuracy<span class="grp-chip grp-A" style="margin-left:6px;font-size:9.5px">A Goal Achievement</span></span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      overall:{label:'Overall Accuracy',unit:'%',desc:'Overall accuracy indicating how well agent responses match the ground truth. Calculated from 4 perspectives (token, set, character similarity) for fair evaluation across diverse response types.',hint:'avg(accuracy_score) × 100'},
      median:{label:'Median',unit:'%',desc:'Median of the accuracy distribution, unaffected by extremely high or low outliers. Useful for understanding typical agent performance; large deviation from mean indicates many outlier tasks.',hint:'median(accuracy_scores) × 100'},
      minimum:{label:'Minimum',unit:'%',desc:'Lowest accuracy score across all tasks. Used to identify weak cases the agent struggles with and find task types needing improvement in the dataset.',hint:'min(accuracy_scores) × 100'},
      maximum:{label:'Maximum',unit:'%',desc:'Highest accuracy score across all tasks. Helps identify task types the agent performs best at, serving as a benchmark for strength areas.',hint:'max(accuracy_scores) × 100'},
      stddev:{label:'Std Dev',unit:'%',desc:'Measures how spread out accuracy scores are from the mean. Lower values indicate consistent performance regardless of task type, serving as a measure of predictability and reliability.',hint:'std(accuracy_scores) × 100'},
    },
    formula(k,d){
      const t=d.tasks||[];
      const sc=t.map(x=>(x.accuracy_score||0)*100).filter(v=>v>0);
      const n=sc.length||1;
      const mean=sc.reduce((a,b)=>a+b,0)/n;
      const sorted=[...sc].sort((a,b)=>a-b);
      const med=n%2===0?(sorted[n/2-1]+sorted[n/2])/2:sorted[Math.floor(n/2)];
      const std=Math.sqrt(sc.reduce((a,b)=>a+(b-mean)**2,0)/n);
      if(k==='overall')return `Mean = Σ accuracy_score / n\n= ${mean.toFixed(1)}% (n=${n})\nWeighted: TokenOverlapF1(40%)+Jaccard(30%)+LCS(20%)+Char/Levenshtein(10%)`;
      if(k==='median')return `Median = ${med.toFixed(1)}% (n=${n})\nRobust to outliers`;
      if(k==='minimum')return `Minimum = ${Math.min(...sc).toFixed(1)}%`;
      if(k==='maximum')return `Maximum = ${Math.max(...sc).toFixed(1)}%`;
      if(k==='stddev')return `Std Dev = ${std.toFixed(1)}%\nCoefficient of Variation (CV) = ${mean>0?(std/mean*100).toFixed(1):'-'}%`;
      return '';
    },
    items(k,d){
      const t=d.tasks||[];
      const sc=t.map(x=>(x.accuracy_score||0)*100).filter(v=>v>0);
      const mean=sc.reduce((a,b)=>a+b,0)/(sc.length||1);
      if(k==='minimum')return [...t].sort((a,b)=>(a.accuracy_score||0)-(b.accuracy_score||0)).slice(0,10);
      if(k==='maximum')return [...t].sort((a,b)=>(b.accuracy_score||0)-(a.accuracy_score||0)).slice(0,10);
      if(k==='stddev')return t.filter(x=>Math.abs((x.accuracy_score||0)*100-mean)>10);
      if(k==='median'){const srt=[...sc].sort((a,b)=>a-b);const nm=srt.length;const med=nm?(nm%2===0?(srt[nm/2-1]+srt[nm/2])/2:srt[Math.floor(nm/2)]):0;return [...t].filter(x=>(x.accuracy_score||0)*100>0).sort((a,b)=>Math.abs((a.accuracy_score||0)*100-med)-Math.abs((b.accuracy_score||0)*100-med));}
      return [...t].sort((a,b)=>(b.accuracy_score||0)-(a.accuracy_score||0));
    },
    filterLabel(k){return {overall:'Accuracy desc.',median:'All',minimum:'Bottom 10',maximum:'Top 10',stddev:'Tasks ±10% from mean'}[k]||'All';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='overall'}" @click="selK=selK==='overall'?null:'overall'">
        <div class="kpi-lbl">Overall Accuracy</div>
        <div class="kpi-val" :style="`color:${_bc(_accG(data),thresholds.acc_min*100,Math.max(0,thresholds.acc_min*100-20))}`" x-text="_accG(data).toFixed(1)+'%'"></div>
        <div class="kpi-sub" x-text="(data.tasks||[]).filter(t=>(t.accuracy_score||0)>0).length+' evaluated'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='median'}" @click="selK=selK==='median'?null:'median'">
        <div class="kpi-lbl">Median</div>
        <div class="kpi-val" x-text="(()=>{const sc=(data.tasks||[]).map(t=>(t.accuracy_score||0)*100).filter(v=>v>0).sort((a,b)=>a-b);const n=sc.length;return n?((n%2===0?(sc[n/2-1]+sc[n/2])/2:sc[Math.floor(n/2)])||0).toFixed(1)+'%':'-';})()"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='minimum'}" @click="selK=selK==='minimum'?null:'minimum'">
        <div class="kpi-lbl">Minimum</div>
        <div class="kpi-val" style="color:var(--red)" x-text="(()=>{const sc=(data.tasks||[]).map(t=>(t.accuracy_score||0)*100).filter(v=>v>0);return sc.length?Math.min(...sc).toFixed(1)+'%':'-';})()"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='maximum'}" @click="selK=selK==='maximum'?null:'maximum'">
        <div class="kpi-lbl">Maximum</div>
        <div class="kpi-val" style="color:var(--green)" x-text="(()=>{const sc=(data.tasks||[]).map(t=>(t.accuracy_score||0)*100).filter(v=>v>0);return sc.length?Math.max(...sc).toFixed(1)+'%':'-';})()"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='stddev'}" @click="selK=selK==='stddev'?null:'stddev'">
        <div class="kpi-lbl">Std Dev</div>
        <div class="kpi-val" x-text="(()=>{const sc=(data.tasks||[]).map(t=>(t.accuracy_score||0)*100).filter(v=>v>0);const n=sc.length;if(!n)return '-';const m=sc.reduce((a,b)=>a+b,0)/n;return Math.sqrt(sc.reduce((a,b)=>a+(b-m)**2,0)/n).toFixed(1)+'%';})()"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div class="panel-header">
            <span class="val-md" x-text="meta[selK]?.label||selK"></span>
            <span class="tag-sm" x-text="meta[selK]?.unit?'Unit: '+meta[selK].unit:''"></span>
            <button class="btn-close" @click="selK=null">×</button>
          </div>
          <div class="grid-2-divider">
            <div class="panel-bg2-r">
              <div class="label-upper">Description</div>
              <div class="body-text" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div class="panel-bg3">
              <div class="label-upper">📐 Calculation</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <div class="panel-bg">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">Related Tasks</span>
              <span class="tag-sm" x-text="filterLabel(selK)"></span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,data).length+' tasks'"></span>
            </div>
            <div class="dtx" style="max-height:220px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:170px minmax(0,1fr) 68px 68px;position:sticky;top:0;z-index:1">
                <span>Task ID</span><span>Type</span><span>Accuracy</span><span>Completion</span>
              </div>
              <template x-for="t in items(selK,data)" :key="t.task_id">
                <div class="dtx-row" style="grid-template-columns:170px minmax(0,1fr) 68px 68px">
                  <span class="dtx-id" x-text="t.task_id"></span>
                  <span class="text-muted" x-text="t.task_type||'-'"></span>
                  <span :style="`color:${_bc((t.accuracy_score||0)*100,70,50)}`" x-text="((t.accuracy_score||0)*100).toFixed(1)+'%'"></span>
                  <span :style="`color:${(t.completion_score||0)>=1?'var(--green)':(t.completion_score||0)>=0.7?'var(--yellow)':'var(--red)'}`"
                        x-text="((t.completion_score||0)*100).toFixed(0)+'%'"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cg" style="margin-top:8px">
      <div class="cbox">
        <div class="ct">Accuracy Distribution (by Task Type)</div>
        <div id="d2-q-acc-hist" class="plt-chart"></div>
      </div>
      <div class="cbox">
        <div class="ct">Accuracy Weight Composition</div>
        <div id="d2-q-acc-weights" class="plt-chart" style="height:100px"></div>
        <div style="margin-top:8px;font-size:11px;color:var(--text2);line-height:1.8">
          <div>🔵 <b>Token Overlap F1 (40%)</b> — Common token F1 score (precision×recall harmonic mean, padding-safe)</div>
          <div>🟣 <b>Jaccard (30%)</b> — Set intersection/union</div>
          <div>🟡 <b>LCS Ratio (20%)</b> — Longest Common Subsequence</div>
          <div>⚪ <b>Char Similarity (10%)</b> — Levenshtein distance-based (character order aware, v0.8.0+)</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Response Quality subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">⭐ Response Quality<span class="grp-chip grp-A" style="margin-left:6px;font-size:9.5px">A Goal Achievement</span></span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      avg_score:{label:'Avg Quality Score',unit:'/5',desc:'Weighted average of 5 quality dimensions. Evaluates practical value beyond mere answer matching; most correlated with user satisfaction.',hint:'avg(total_score) — total_score = relevance×0.25 + completeness×0.25 + accuracy×0.20 + clarity×0.15 + usefulness×0.15'},
      relevance:{label:'Relevance',unit:'/5',desc:'How directly the response addresses the core intent of the question. Useful for detecting irrelevant information or off-topic responses.',hint:'quality_detail.dimension_summary.relevance'},
      completeness:{label:'Completeness',unit:'/5',desc:'Whether the response covers all aspects required by the question. Identifies incomplete answers and evaluates multi-part question handling capability.',hint:'quality_detail.dimension_summary.completeness'},
      accuracy:{label:'Accuracy',unit:'/5',desc:'Whether facts, numbers, and concepts in the response are actually correct. Detects responses with wrong information; especially important for factual QA and analysis tasks.',hint:'quality_detail.dimension_summary.accuracy'},
      clarity:{label:'Clarity',unit:'/5',desc:'Whether the response is clearly and understandably structured. Detects ambiguous expressions, unclear structure, or excessive complexity; relates to whether users can correctly understand and use the response.',hint:'quality_detail.dimension_summary.clarity'},
      usefulness:{label:'Usefulness',unit:'/5',desc:'How helpful the response is in real situations. Identifies technically correct but impractical responses; measures value in directly helping end users solve problems.',hint:'quality_detail.dimension_summary.usefulness'},
    },
    formula(k,d){
      const ds=d.quality_detail?.dimension_summary||{};
      const avg=d.quality_detail?.avg_score||0;
      if(k==='avg_score')return `Weighted avg = relevance×0.25 + completeness×0.25 + accuracy×0.20 + clarity×0.15 + usefulness×0.15\n= ${(ds.relevance||0).toFixed(2)}×0.25 + ${(ds.completeness||0).toFixed(2)}×0.25 + ${(ds.accuracy||0).toFixed(2)}×0.20 + ${(ds.clarity||0).toFixed(2)}×0.15 + ${(ds.usefulness||0).toFixed(2)}×0.15\n= ${avg.toFixed(2)}/5 = ${(avg*20).toFixed(1)}%`;
      return `${k} = ${(ds[k]||0).toFixed(2)}/5`;
    },
    items(k,d){
      const evs=d.quality_detail?.evaluations||[];
      if(k!=='avg_score'){
        return [...evs].sort((a,b)=>((b.dimension_scores?.[k]||b[k]||0))-(a.dimension_scores?.[k]||a[k]||0));
      }
      return [...evs].sort((a,b)=>(b.total_score||0)-(a.total_score||0));
    },
    filterLabel(k){return k==='avg_score'?'Total score desc.':k+' score desc.';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='avg_score'}" @click="selK=selK==='avg_score'?null:'avg_score'">
        <div class="kpi-lbl">Avg Quality Score</div>
        <div class="kpi-val" x-text="(data.quality_detail?.avg_score||0).toFixed(2)+'/5'"></div>
        <div class="kpi-sub" x-text="(data.quality_detail?.evaluations||[]).length+' evaluated'"></div>
      </div>
      <template x-for="(dimLabel,dimKey) in {relevance:'Relevance',completeness:'Completeness',accuracy:'Accuracy',clarity:'Clarity',usefulness:'Usefulness'}" :key="dimKey">
        <div class="kpi kpi-act" :class="{sel:selK===dimKey}" @click="selK=selK===dimKey?null:dimKey">
          <div class="kpi-lbl" x-text="dimLabel"></div>
          <div class="kpi-val" x-text="(data.quality_detail?.dimension_summary?.[dimKey]||0).toFixed(2)+'/5'"></div>
          <div class="kpi-sub" x-text="(()=>{const evs=data.quality_detail?.evaluations||[];const sc=evs.map(e=>(e.dimension_scores?.[dimKey]??0));if(!evs.length)return 'No data';const mn=Math.min(...sc).toFixed(1);const mx=Math.max(...sc).toFixed(1);return evs.length+' · '+mn+'~'+mx;})()"></div>
        </div>
      </template>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div class="panel-header">
            <span class="val-md" x-text="meta[selK]?.label||selK"></span>
            <span class="tag-sm" x-text="meta[selK]?.unit?'Unit: '+meta[selK].unit:''"></span>
            <button class="btn-close" @click="selK=null">×</button>
          </div>
          <div class="grid-2-divider">
            <div class="panel-bg2-r">
              <div class="label-upper">Description</div>
              <div class="body-text" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div class="panel-bg3">
              <div class="label-upper">📐 Calculation</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <div class="panel-bg">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">Evaluations</span>
              <span class="tag-sm" x-text="filterLabel(selK)"></span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,data).length+' tasks'"></span>
            </div>
            <div class="dtx" style="max-height:220px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:minmax(100px,1fr) 50px 36px 40px 40px 40px 40px 40px;position:sticky;top:0;z-index:1">
                <span>Task ID</span><span title="Total Score (0-5)">Score</span><span>Grade</span>
                <span title="Relevance">Rel</span><span title="Completeness">Comp</span>
                <span title="Accuracy">Acc</span><span title="Clarity">Clar</span>
                <span title="Usefulness">Use</span>
              </div>
              <template x-for="(ev,_i) in items(selK,data)" :key="_i">
                <div class="dtx-row" style="grid-template-columns:minmax(100px,1fr) 50px 36px 40px 40px 40px 40px 40px">
                  <span class="dtx-id" x-text="ev.task_id"></span>
                  <span x-text="(ev.total_score||0).toFixed(2)"></span>
                  <span :class="{'badge-ok':ev.grade==='A','badge-info':ev.grade==='B','badge-warn':ev.grade==='C'||ev.grade==='D','badge-ng':ev.grade==='F'}" x-text="ev.grade||'-'"></span>
                  <span :style="`color:${_bc((ev.dimension_scores?.relevance||ev.relevance||0)*20,70,50)}`" x-text="(ev.dimension_scores?.relevance||ev.relevance||0).toFixed(1)"></span>
                  <span :style="`color:${_bc((ev.dimension_scores?.completeness||ev.completeness||0)*20,70,50)}`" x-text="(ev.dimension_scores?.completeness||ev.completeness||0).toFixed(1)"></span>
                  <span :style="`color:${_bc((ev.dimension_scores?.accuracy||ev.accuracy||0)*20,70,50)}`" x-text="(ev.dimension_scores?.accuracy||ev.accuracy||0).toFixed(1)"></span>
                  <span :style="`color:${_bc((ev.dimension_scores?.clarity||ev.clarity||0)*20,70,50)}`" x-text="(ev.dimension_scores?.clarity||ev.clarity||0).toFixed(1)"></span>
                  <span :style="`color:${_bc((ev.dimension_scores?.usefulness||ev.usefulness||0)*20,70,50)}`" x-text="(ev.dimension_scores?.usefulness||ev.usefulness||0).toFixed(1)"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cg" style="margin-top:8px">
      <div class="cbox"><div class="ct">Quality Dimension Radar</div><div id="d2-q-radar" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">Grade Distribution</div><div id="d2-q-grade" class="plt-chart"></div></div>
    </div>
  </div>

  <!-- ── LLM Judge 섹션 (enable_llm_judge=True 일 때만 표시) ── -->
  <template x-if="data?.llm_judge?.judged_count > 0">
    <div x-data="{
      selK: null,
      meta: {
        overall:      {label:'Overall Score', desc:'Average Judge score across 3 quality dimensions (completeness · relevance · factual_consistency). toxicity·bias are aggregated separately as safety_score. Automatically monitors response quality without ground_truth.',        hint:'overall = (completeness + relevance + factual_consistency) / 3\nsafety_score = (10 − toxicity − bias) / 10'},
        completeness: {label:'Completeness',   desc:'Whether the response covers all aspects and sub-questions raised. 0=question completely ignored, 5=all aspects fully covered.',                                                             hint:'LLM Judge → integer 0–5\n(response coverage vs. question scope)'},
        relevance:    {label:'Relevance',       desc:'Whether the response directly addresses the core intent of the question. 0=completely off-topic, 5=perfectly on-point.',                                                                hint:'LLM Judge → integer 0–5\n(response focus vs. question intent)'},
        factual:      {label:'Factual Consistency',desc:'Whether the response is internally consistent without contradictions or obvious errors. Measures internal coherence rather than external fact verification. 0=contradictory, 5=consistent and reliable.',          hint:'LLM Judge → integer 0–5\n(no internal contradictions or errors)'},
        faithfulness: {label:'Faithfulness (RAG)',desc:'Whether all claims in the RAG response are supported by retrieved context. Auto-added when context= is passed. Tasks with missing fields are excluded from aggregation; only actually scored tasks are averaged. (Native Ragas replacement)',  hint:'LLM Judge faithfulness → integer 0–5\n(ratio of claims supported by context)\n※ Tasks with missing fields excluded'},
        criteria:     {label:'Custom Criteria', desc:'Average score of service-specific evaluation criteria defined by the judge_criteria=[...] parameter. Native replacement for DeepEval G-Eval.',                                               hint:'criteria_overall = mean(each judge_criteria dimension score)'},
      },
      formula(k) {
        const jd = data.llm_judge;
        if(k==='overall')     return `Mean = (completeness + relevance + factual consistency) / 3\n= (${(jd.avg_completeness||0).toFixed(2)} + ${(jd.avg_relevance||0).toFixed(2)} + ${(jd.avg_factual_consistency||0).toFixed(2)}) / 3\n= ${(jd.avg_overall||0).toFixed(2)} / 5`;
        if(k==='completeness')return `avg completeness = ${(jd.avg_completeness||0).toFixed(2)} / 5\nModel: ${jd.model||'—'}  |  Samples: ${jd.judged_count}`;
        if(k==='relevance')   return `avg relevance = ${(jd.avg_relevance||0).toFixed(2)} / 5\nModel: ${jd.model||'—'}  |  Samples: ${jd.judged_count}`;
        if(k==='factual')     return `avg factual_consistency = ${(jd.avg_factual_consistency||0).toFixed(2)} / 5\nModel: ${jd.model||'—'}  |  Samples: ${jd.judged_count}`;
        if(k==='faithfulness')return `avg faithfulness = ${(jd.avg_faithfulness||0).toFixed(2)} / 5\nRAG mode only (rag_mode=True + enable_llm_judge=True)\nModel: ${jd.model||'—'}  |  Samples: ${jd.judged_count}`;
        if(k==='criteria')    return `avg criteria_overall = ${(jd.avg_criteria_overall||0).toFixed(2)} / 5\nCustom criteria mean defined by judge_criteria=[...] parameter\nModel: ${jd.model||'—'}  |  Samples: ${jd.judged_count}`;
        return '';
      },
      scoreKey(k) { return {overall:'overall',completeness:'completeness',relevance:'relevance',factual:'factual_consistency',faithfulness:'faithfulness',criteria:'criteria_overall'}[k]||'overall'; },
      items(k) {
        const rs = data.llm_judge.results || [];
        const sk = this.scoreKey(k);
        return [...rs].sort((a,b)=>(b.scores?.[sk]??0)-(a.scores?.[sk]??0));
      },
      scoreCol(k) { return {overall:'Overall',completeness:'Completeness',relevance:'Relevance',factual:'Factual'}[k]||'Score'; },
      _jc(v) { return v>=4?'var(--green)':v>=2.5?'var(--yellow)':'var(--red)'; }
    }">
      <!-- 섹션 구분자 -->
      <div class="sdiv">
        <div class="sdiv-line"></div>
        <span class="sdiv-lbl">🤖 LLM Judge</span>
        <span style="font-size:11px;color:var(--text2);margin-left:6px">— no ground_truth required · auto-scoring 5 dimensions + Faithfulness(RAG) + G-Eval custom</span>
        <div class="sdiv-line"></div>
      </div>

      <!-- KPI 4개 (클릭 가능) -->
      <div class="kpi-grid">
        <div class="kpi kpi-act" style="border-left:3px solid #8b5cf6" :class="{sel:selK==='overall'}" @click="selK=selK==='overall'?null:'overall'">
          <div class="kpi-lbl">Overall Score</div>
          <div class="kpi-val" :style="`color:${_jc(data.llm_judge.avg_overall||0)}`"
               x-text="(data.llm_judge.avg_overall||0).toFixed(2)+'/5'"></div>
          <div class="kpi-sub" x-text="data.llm_judge.judged_count+' scored'"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='completeness'}" @click="selK=selK==='completeness'?null:'completeness'">
          <div class="kpi-lbl">Completeness</div>
          <div class="kpi-val" :style="`color:${_jc(data.llm_judge.avg_completeness||0)}`"
               x-text="(data.llm_judge.avg_completeness||0).toFixed(2)+'/5'"></div>
          <div class="kpi-sub">Covers all question aspects</div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='relevance'}" @click="selK=selK==='relevance'?null:'relevance'">
          <div class="kpi-lbl">Relevance</div>
          <div class="kpi-val" :style="`color:${_jc(data.llm_judge.avg_relevance||0)}`"
               x-text="(data.llm_judge.avg_relevance||0).toFixed(2)+'/5'"></div>
          <div class="kpi-sub">Matches core question intent</div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='factual'}" @click="selK=selK==='factual'?null:'factual'">
          <div class="kpi-lbl">Factual Consistency</div>
          <div class="kpi-val" :style="`color:${_jc(data.llm_judge.avg_factual_consistency||0)}`"
               x-text="(data.llm_judge.avg_factual_consistency||0).toFixed(2)+'/5'"></div>
          <div class="kpi-sub">No internal contradictions/errors</div>
        </div>
        <template x-if="(data.llm_judge.avg_faithfulness||0) > 0">
          <div class="kpi kpi-act" :class="{sel:selK==='faithfulness'}" @click="selK=selK==='faithfulness'?null:'faithfulness'">
            <div class="kpi-lbl">Faithfulness (RAG)</div>
            <div class="kpi-val" :style="`color:${_jc(data.llm_judge.avg_faithfulness||0)}`"
                 x-text="(data.llm_judge.avg_faithfulness||0).toFixed(2)+'/5'"></div>
            <div class="kpi-sub">Context support ratio</div>
          </div>
        </template>
        <template x-if="(data.llm_judge.avg_criteria_overall||0) > 0">
          <div class="kpi kpi-act" :class="{sel:selK==='criteria'}" @click="selK=selK==='criteria'?null:'criteria'">
            <div class="kpi-lbl">Custom Criteria</div>
            <div class="kpi-val" :style="`color:${_jc(data.llm_judge.avg_criteria_overall||0)}`"
                 x-text="(data.llm_judge.avg_criteria_overall||0).toFixed(2)+'/5'"></div>
            <div class="kpi-sub">G-Eval custom dimension avg</div>
          </div>
        </template>
      </div>

      <!-- 클릭 상세 패널 -->
      <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
        <template x-if="selK">
          <div>
            <!-- 패널 헤더 -->
            <div class="panel-header">
              <span class="val-md" x-text="meta[selK]?.label||selK"></span>
              <span class="tag-sm">0–5 pts</span>
              <span class="tag-sm"
                    x-text="data.llm_judge.model||'—'"></span>
              <button class="btn-close" @click="selK=null">×</button>
            </div>
            <!-- 설명 | 산출 방식 -->
            <div class="grid-2-divider">
              <div class="panel-bg2-r">
                <div class="label-upper">Description</div>
                <div class="body-text" x-text="meta[selK]?.desc||''"></div>
              </div>
              <div class="panel-bg3">
                <div class="label-upper">📐 Calculation</div>
                <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK)"></div>
              </div>
            </div>
            <!-- 태스크 상세 -->
            <div class="panel-bg">
              <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
                <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">Related Tasks</span>
                <span class="tag-sm">Score desc.</span>
                <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK).length+' tasks'"></span>
              </div>
              <div class="dtx" style="max-height:220px;overflow-y:auto">
                <div class="dtx-row dtx-head" style="grid-template-columns:minmax(140px,1fr) 60px 60px 60px 60px minmax(0,2fr);position:sticky;top:0;z-index:1">
                  <span>Task ID</span><span style="text-align:center">Comp.</span><span style="text-align:center">Rel.</span><span style="text-align:center">Factual</span><span style="text-align:center">Overall</span><span>Reasoning</span>
                </div>
                <template x-for="r in items(selK)" :key="r.task_id">
                  <div class="dtx-row" style="grid-template-columns:minmax(140px,1fr) 60px 60px 60px 60px minmax(0,2fr)">
                    <span class="dtx-id" x-text="r.task_id"></span>
                    <span style="text-align:center;font-size:12px" :style="`color:${_jc(r.scores?.completeness??0)}`" x-text="r.scores?.completeness??'—'"></span>
                    <span style="text-align:center;font-size:12px" :style="`color:${_jc(r.scores?.relevance??0)}`" x-text="r.scores?.relevance??'—'"></span>
                    <span style="text-align:center;font-size:12px" :style="`color:${_jc(r.scores?.factual_consistency??0)}`" x-text="r.scores?.factual_consistency??'—'"></span>
                    <span style="text-align:center;font-size:12px;font-weight:700" :style="`color:${_jc(r.scores?.overall??0)}`" x-text="r.scores?.overall!=null?r.scores.overall.toFixed(2):'—'"></span>
                    <span style="font-size:11px;color:var(--text2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="r.reasoning||'—'"></span>
