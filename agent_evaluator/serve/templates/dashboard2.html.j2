      <!-- 메타 정보 -->
      <div class="cbox" style="margin-bottom:10px">
        <div class="ct">Judge Config</div>
        <div class="drow"><span class="muted">Model</span><span style="font-family:monospace;font-size:12px" x-text="data.llm_judge.model||'—'"></span></div>
        <div class="drow"><span class="muted">Scored</span><span x-text="data.llm_judge.judged_count+' tasks'"></span></div>
