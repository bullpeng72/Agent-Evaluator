  <!-- Retry subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔁 재시도 / 보정</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      retry_rate:{label:'재시도율',unit:'%',desc:'재시도가 발생한 태스크 비율',hint:'tasks_with_retry / total_tasks × 100'},
      first_success:{label:'첫 시도 성공률',unit:'%',desc:'첫 번째 시도에서 성공한 비율',hint:'first_attempt_success / total_tasks × 100'},
      eventual_success:{label:'최종 성공률',unit:'%',desc:'재시도 포함 최종적으로 성공한 비율',hint:'eventual_success_count / total_tasks × 100'},
      correction:{label:'보정 성공률',unit:'%',desc:'재시도로 인해 실패→성공으로 전환된 비율',hint:'correction_success / retry_tasks × 100'},
      avg_attempts:{label:'평균 시도',unit:'회',desc:'태스크당 평균 시도 횟수',hint:'avg(total_attempts)'},
      avg_retry_time:{label:'평균 재시도 시간',unit:'s',desc:'재시도에 소요된 평균 시간',hint:'avg(retry_time) 재시도 있는 태스크 한정'},
    },
    formula(k,d){
      const rs=d.agentic?.retry_summary||{};
      if(k==='retry_rate')return `재시도율 = ${rs.overall_retry_rate||0}%`;
      if(k==='first_success')return `첫 시도 성공 = ${rs.first_attempt_success_rate||0}%`;
      if(k==='eventual_success')return `최종 성공 = ${rs.eventual_success_rate||0}%`;
      if(k==='correction')return `보정 성공 = ${rs.correction_success_rate||0}%\n재시도 → 성공 전환 비율`;
      if(k==='avg_attempts')return `평균 시도 = ${(rs.avg_attempts||0).toFixed(2)}회`;
      if(k==='avg_retry_time')return `평균 재시도 시간 = ${(rs.avg_retry_time||0).toFixed(2)}s\n재시도 발생 태스크 한정`;
      return '';
    },
    items(k,d){
      const ra=d.agentic?.retry_attempts||[];
      if(k==='retry_rate'||k==='first_success')return ra.filter(r=>r.total_attempts>1);
      return ra;
    },
    filterLabel(k){return ['retry_rate','first_success'].includes(k)?'재시도 발생 태스크':'전체 재시도 기록';}
  }">
