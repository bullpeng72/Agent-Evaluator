        <!-- 정확도 -->
        <div class="kpi kpi-act" :class="{sel:selK==='avg_accuracy'}" @click="selK=selK==='avg_accuracy'?null:'avg_accuracy'" x-show="gA.details && gA.details.avg_accuracy!=null">
