                  <span class="dtx-id" x-text="t.task_id"></span>
                  <span class="text-muted" x-text="t.task_type||'-'"></span>
                  <span :style="`color:${_bc2lat(t.execution_time||0)}`" x-text="_sec(t.execution_time||0)"></span>
                  <span :class="t.success?'badge-ok':'badge-ng'" x-text="t.success?'✓':'✗'"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cg3" style="margin-top:8px">
      <div class="cbox"><div class="ct">Latency Percentiles</div><div id="d2-p-lat-bar" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">Latency Distribution Histogram</div><div id="d2-p-lat-hist" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">Per-Task Latency</div><div id="d2-p-lat-task" class="plt-chart"></div></div>
    </div>
    <div class="sec" style="margin-top:12px">
      <div class="sec-t">Slow Tasks (Top 10)</div>
      <div class="dtx">
        <div class="dtx-row dtx-head" style="grid-template-columns:170px minmax(0,1fr) 72px 56px;position:sticky;top:0;z-index:1">
          <span>Task ID</span><span>Type</span><span>Latency(s)</span><span>Completion</span>
        </div>
        <template x-for="t in slowTasks(10)" :key="t.task_id">
          <div class="dtx-row" style="grid-template-columns:170px minmax(0,1fr) 72px 56px">
            <span class="dtx-id" x-text="t.task_id"></span>
            <span class="text-muted" x-text="t.task_type||'-'"></span>
            <span :style="`color:${_bc2lat(t.execution_time||0)}`" x-text="_sec(t.execution_time||0)"></span>
            <span :class="t.success?'badge-ok':'badge-ng'" x-text="t.success?'✓':'✗'"></span>
          </div>
        </template>
      </div>
    </div>
  </div>

  <!-- Token Economy subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🪙 Token Economy<span class="grp-chip grp-D" style="margin-left:6px;font-size:9.5px">D Performance Contract</span></span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      total:{label:'Total Tokens',unit:'tokens',desc:'Total LLM tokens consumed across this evaluation. A core efficiency metric directly tied to infrastructure cost, used as a baseline for prompt design and context management optimization.',hint:'Σ(input_tokens + output_tokens)'},
      input:{label:'Input Tokens',unit:'tokens',desc:'Tokens consumed by prompts, system instructions, and context. Used to identify unnecessarily long prompts or excessive context injection, and to evaluate prompt efficiency via the I/O ratio.',hint:'Σ input_tokens'},
      output:{label:'Output Tokens',unit:'tokens',desc:'Tokens generated in agent responses. Used to identify verbosity trends and detect unnecessarily long outputs. A high ratio relative to input indicates longer responses.',hint:'Σ output_tokens'},
      avg_per_task:{label:'Avg per Task',unit:'tokens',desc:'Average tokens consumed per task. The key unit for cost forecasting; comparing by task type helps identify token-heavy complex tasks.',hint:'total_tokens / total_tasks'},
      io_ratio:{label:'I/O Ratio',unit:'%',desc:'Ratio of output tokens to input tokens. Excessively high values may indicate unnecessarily verbose responses; too low may mean overly terse replies. The optimal ratio varies by task type.',hint:'output_tokens / input_tokens × 100'},
    },
    formula(k,d){
      const tok=(d.efficiency_metrics||{}).tokens||{};
      const tot=tok.total_tokens||0;
      const inp=tok.total_input_tokens||0;
      const out=tok.total_output_tokens||0;
      const n=d.total_tasks||1;
      const avg=tok.avg_tokens_per_task||Math.round(tot/n)||0;
      if(k==='total')return `Σ(input_tokens + output_tokens)\n= ${_fmtNumG(inp)} + ${_fmtNumG(out)}\n= ${_fmtNumG(tot)}`;
      if(k==='input')return `Σ input_tokens = ${_fmtNumG(inp)}\n${tot?((inp/tot)*100).toFixed(1):0}% of total\n(token_distribution.input_ratio)`;
      if(k==='output')return `Σ output_tokens = ${_fmtNumG(out)}\n${tot?((out/tot)*100).toFixed(1):0}% of total\n(token_distribution.output_ratio)`;
      if(k==='avg_per_task')return `avg_tokens_per_task\n= ${_fmtNumG(tot)} / ${n} tasks\n= ${_fmtNumG(Math.round(avg))}`;
      if(k==='io_ratio')return `output_tokens / input_tokens × 100\n= ${_fmtNumG(out)} / ${_fmtNumG(inp)}\n= ${inp?((out/inp)*100).toFixed(1):0}%`;
      return '';
    },
    items(k,d){
      return [...(d.tasks||[])].sort((a,b)=>{
        const at=(a.tokens_used?.total||a.tokens_used||0);
        const bt=(b.tokens_used?.total||b.tokens_used||0);
        return bt-at;
      }).slice(0,20);
    },
    filterLabel(k){return 'Top 20 Token-Heavy Tasks';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='total'}" @click="selK=selK==='total'?null:'total'">
        <div class="kpi-lbl">Total Tokens</div>
        <div class="kpi-val icon-lg" x-text="_fmtNumG(data.efficiency_metrics?.tokens?.total_tokens||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='input'}" @click="selK=selK==='input'?null:'input'">
        <div class="kpi-lbl">Input Tokens</div>
        <div class="kpi-val icon-lg" x-text="_fmtNumG(data.efficiency_metrics?.tokens?.total_input_tokens||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='output'}" @click="selK=selK==='output'?null:'output'">
        <div class="kpi-lbl">Output Tokens</div>
        <div class="kpi-val icon-lg" x-text="_fmtNumG(data.efficiency_metrics?.tokens?.total_output_tokens||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='avg_per_task'}" @click="selK=selK==='avg_per_task'?null:'avg_per_task'">
        <div class="kpi-lbl">Avg per Task</div>
        <div class="kpi-val icon-lg" x-text="_fmtNumG(Math.round(data.efficiency_metrics?.tokens?.avg_tokens_per_task||(data.efficiency_metrics?.tokens?.total_tokens||0)/(data.total_tasks||1)))"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='io_ratio'}" @click="selK=selK==='io_ratio'?null:'io_ratio'">
        <div class="kpi-lbl">I/O Ratio</div>
        <div class="kpi-val icon-lg" x-text="(data.efficiency_metrics?.tokens?.total_input_tokens||0)>0?((data.efficiency_metrics?.tokens?.total_output_tokens||0)/(data.efficiency_metrics?.tokens?.total_input_tokens||1)*100).toFixed(0)+'%':((data.efficiency_metrics?.tokens?.token_distribution?.output_ratio||0)*100).toFixed(0)+'%'||'-'"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div class="panel-header">
            <span class="val-md" x-text="meta[selK]?.label||selK"></span>
            <button class="btn-close" @click="selK=null">×</button>
          </div>
          <div class="grid-2-divider">
            <div class="panel-bg2-r">
              <div class="label-upper">Description</div>
              <div class="body-text" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div class="panel-bg3">
              <div class="label-upper">📐 Calculation</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <div class="panel-bg">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">High-Token Tasks</span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,data).length+' tasks'"></span>
            </div>
            <div class="dtx" style="max-height:200px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:150px 72px 72px 72px minmax(0,1fr) 64px;position:sticky;top:0;z-index:1">
                <span>Task ID</span><span>Total</span><span style="color:#6366f1">Input</span><span style="color:#06b6d4">Output</span><span>Type</span><span>Completion</span>
              </div>
              <template x-for="t in items(selK,data)" :key="t.task_id">
                <div class="dtx-row" style="grid-template-columns:150px 72px 72px 72px minmax(0,1fr) 64px">
                  <span class="dtx-id" x-text="t.task_id"></span>
                  <span x-text="_fmtNumG((typeof t.tokens_used==='object'&&t.tokens_used)?(t.tokens_used.total||(t.tokens_used.input||t.tokens_used.input_tokens||0)+(t.tokens_used.output||t.tokens_used.output_tokens||0)):t.tokens_used||0)"></span>
                  <span style="color:#6366f1" x-text="_fmtNumG((typeof t.tokens_used==='object'&&t.tokens_used)?(t.tokens_used.input||t.tokens_used.input_tokens||0):0)"></span>
                  <span style="color:#06b6d4" x-text="_fmtNumG((typeof t.tokens_used==='object'&&t.tokens_used)?(t.tokens_used.output||t.tokens_used.output_tokens||0):0)"></span>
                  <span class="text-muted" x-text="t.task_type||'-'"></span>
                  <span :style="`color:${(t.completion_score||0)>=1?'var(--green)':(t.completion_score||0)>=0.7?'var(--yellow)':'var(--red)'}`"
                        x-text="((t.completion_score||0)*100).toFixed(0)+'%'"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cg3" style="margin-top:8px">
      <div class="cbox"><div class="ct">Tokens per Task</div><div id="d2-p-tok-bar" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">I/O Token Ratio</div><div id="d2-p-tok-ratio" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">Token Distribution</div><div id="d2-p-tok-hist" class="plt-chart"></div></div>
    </div>
  </div>

  <!-- Cost subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">💰 Cost Analysis<span class="grp-chip grp-D" style="margin-left:6px;font-size:9.5px">D Performance Contract</span></span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK: null,
    meta:{
      total_cost:{label:'Total Cost',unit:'$',desc:'Estimated LLM API usage cost for this evaluation. Selecting a model will recalculate costs at that model\'s rate.',hint:'Σ(input_tokens × inp_price + output_tokens × out_price) / 1M'},
      p50_cost:{label:'P50 Cost',unit:'$',desc:'Median of the task cost distribution. Half of all tasks are processed at or below this cost. Less sensitive to outliers than the mean, better reflecting typical task cost.',hint:'50th percentile(task_cost)'},
      p95_cost:{label:'P95 Cost',unit:'$',desc:'95% of all tasks are processed at or below this cost. Used as a reference for cost outlier detection and SLA cost ceiling design.',hint:'95th percentile(task_cost)'},
      avg_cost:{label:'Avg per Task',unit:'$',desc:'Average cost to process one task. The baseline for cost forecasting at scale, and the key metric to quantify the impact of model switching or prompt optimization.',hint:'total_cost / total_tasks'},
      monthly_est:{label:'×1K Estimate',unit:'$',desc:'Estimated cost to process 1,000 tasks at the current average. Actual billing may differ due to discounts, caching, or batch processing.',hint:'avg_cost_per_task × 1000'},
    },
    formula(k,d){
      const m=selModel;
      const tot=cTotal(d), avg=cAvg(d), p50=cP50(d), p95=cP95(d);
      const em=d?.efficiency_metrics||{};
      const iTok=em.tokens?.total_input_tokens||0, oTok=em.tokens?.total_output_tokens||0;
      const src=m?`Applied model: ${m.model}\nInput $${m.inp}/1M × Output $${m.out}/1M`:'Using cost from saved JSON';
      if(k==='total_cost') return `${src}\nΣ(inp×${m?m.inp+'$':'-'} + out×${m?m.out+'$':'-'}) / 1M\n= $${tot.toFixed(6)}\n\nInput ${_fmtNumG(iTok)} + Output ${_fmtNumG(oTok)} tokens`;
      if(k==='p50_cost')   return `${src}\n50th percentile(task_cost)\n= $${p50.toFixed(6)}\n\nHalf of all tasks below this cost`;
      if(k==='p95_cost')   return `${src}\n95th percentile(task_cost)\n= $${p95.toFixed(6)}\n\nReference for SLA cost ceiling design`;
      if(k==='avg_cost')   return `${src}\ntotal_cost / tasks\n= $${tot.toFixed(6)} / ${d?.total_tasks||1} tasks\n= $${avg.toFixed(6)}`;
      if(k==='monthly_est')return `${src}\navg_cost × 1,000 tasks\n= $${avg.toFixed(6)} × 1000\n= $${(avg*1000).toFixed(4)}`;
      return '';
    },
    items(k,d){ return [...(d?.tasks||[])].sort((a,b)=>(b.tokens_used?.total||0)-(a.tokens_used?.total||0)).slice(0,20); },
    filterLabel(k){ return 'Top 20 Token-Heavy Tasks'; },
  }">

    <!-- KPI 카드 — 전역 selModel 반영 -->
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='total_cost'}" @click="selK=selK==='total_cost'?null:'total_cost'">
        <div class="kpi-lbl">Total Cost</div>
        <div class="kpi-val" x-text="_fmtCostG(cTotal(data))"></div>
        <div class="kpi-sub" x-show="selModel" style="color:var(--accent);font-size:10px" x-text="selModel?.model?.split('/')[0]?.trim()||''"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='p50_cost'}" @click="selK=selK==='p50_cost'?null:'p50_cost'">
        <div class="kpi-lbl">P50 Cost</div>
        <div class="kpi-val" x-text="_fmtCostG(cP50(data))"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='p95_cost'}" @click="selK=selK==='p95_cost'?null:'p95_cost'">
        <div class="kpi-lbl">P95 Cost</div>
        <div class="kpi-val" x-text="_fmtCostG(cP95(data))"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='avg_cost'}" @click="selK=selK==='avg_cost'?null:'avg_cost'">
        <div class="kpi-lbl">Avg per Task</div>
        <div class="kpi-val" x-text="_fmtCostG(cAvg(data))"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='monthly_est'}" @click="selK=selK==='monthly_est'?null:'monthly_est'">
        <div class="kpi-lbl">×1K Estimate</div>
        <div class="kpi-val" x-text="_fmtCostG(cAvg(data)*1000)"></div>
      </div>
    </div>

    <!-- KPI 상세 패널 -->
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div class="panel-header">
            <span class="val-md" x-text="meta[selK]?.label||selK"></span>
            <button class="btn-close" @click="selK=null">×</button>
          </div>
          <div class="grid-2-divider">
            <div class="panel-bg2-r">
              <div class="label-upper">Description</div>
              <div class="body-text" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div class="panel-bg3">
              <div class="label-upper">📐 Calculation</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <div class="panel-bg">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">Tokens &amp; Cost per Task</span>
              <span class="tag-sm" x-text="filterLabel(selK)"></span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,data).length+' tasks'"></span>
            </div>
            <div class="dtx" style="max-height:220px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:minmax(100px,1fr) 60px 60px 60px 70px;position:sticky;top:0;z-index:1">
                <span>Task ID</span><span title="Input Tokens">Input</span><span title="Output Tokens">Output</span><span title="Total Tokens">Total</span><span title="Estimated Cost ($)">Cost ($)</span>
              </div>
              <template x-for="(t,_i) in items(selK,data)" :key="_i">
                <div class="dtx-row" style="grid-template-columns:minmax(100px,1fr) 60px 60px 60px 70px">
                  <span class="dtx-id" x-text="t.task_id"></span>
                  <span style="color:#6366f1;font-size:11px" x-text="_fmtNumG((typeof t.tokens_used==='object'&&t.tokens_used)?(t.tokens_used.input||t.tokens_used.input_tokens||0):0)"></span>
                  <span style="color:#06b6d4;font-size:11px" x-text="_fmtNumG((typeof t.tokens_used==='object'&&t.tokens_used)?(t.tokens_used.output||t.tokens_used.output_tokens||0):0)"></span>
                  <span class="fs-sm" x-text="_fmtNumG((typeof t.tokens_used==='object'&&t.tokens_used)?(t.tokens_used.total||(t.tokens_used.input||0)+(t.tokens_used.output||0)):t.tokens_used||0)"></span>
                  <span class="fs-sm" x-text="(()=>{const tu=typeof t.tokens_used==='object'&&t.tokens_used?t.tokens_used:{};const inp=tu.input||tu.input_tokens||0,out=tu.output||tu.output_tokens||0;const m=selModel;return '$'+(m?((inp*(m.inp||3)+out*(m.out||15))/1e6):((inp*3+out*15)/1e6)).toFixed(6);})()"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>

    <div class="cbox" style="margin-top:8px">
      <div class="ct">Cost per Task (Token-Proportional Estimate)</div>
      <div id="d2-p-cost-bar" class="plt-chart"></div>
    </div>

    <!-- ② 모델 가격표 + Agent 적용 모델 선택 -->
    <div class="sec" style="margin-top:12px">
      <!-- 헤더 -->
      <div class="sec-t" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
        <span>Model Pricing</span>
        <span style="font-size:11px;color:var(--text2);font-weight:400">(per 1M tokens)</span>
        <!-- 선택된 모델 배지 -->
        <span x-show="selModel"
              style="font-size:11px;padding:2px 10px;border-radius:99px;background:rgba(16,185,129,0.15);color:#10b981;font-weight:700;display:flex;align-items:center;gap:4px">
          ✓ <span x-text="selModel?.model?.split('/')[0]?.trim()"></span> Applied
          <span style="font-size:10px;opacity:0.75;font-weight:400">· Persists after reload</span>
          <button @click="clearModel()"
                  style="background:transparent;border:none;color:#10b981;cursor:pointer;font-size:14px;line-height:1;padding:0 0 0 2px">×</button>
        </span>
        <span x-show="!selModel" class="text-muted">— Select a model to recalculate all costs (persists after reload)</span>
        <div style="margin-left:auto;display:flex;gap:6px">
          <button x-show="pEd" @click="pAdd()"
                  style="padding:3px 10px;border-radius:5px;border:1px solid #10b981;background:transparent;color:#10b981;font-size:12px;cursor:pointer">+ Add Row</button>
          <button @click="togglePEd()"
                  style="padding:3px 10px;border-radius:5px;border:1px solid var(--accent);background:transparent;color:var(--accent);font-size:12px;cursor:pointer"
                  x-text="pEd?'✓ Done':'✏ Edit'"></button>
        </div>
      </div>

      <!-- 가격표 -->
      <div class="dtx" style="margin-top:8px">
        <div class="dtx-row dtx-head"
             :style="pEd ? 'grid-template-columns:1fr 90px 90px 70px 36px'
                         : 'grid-template-columns:1fr 90px 90px 70px'">
          <span>Model</span><span>Input ($/1M)</span><span>Output ($/1M)</span><span>Apply</span>
          <span x-show="pEd"></span>
        </div>
        <template x-for="(row,idx) in pRows" :key="idx">
          <div class="dtx-row"
               :style="selModel?.model===row.model
                 ? (pEd ? 'grid-template-columns:1fr 90px 90px 70px 36px;align-items:center;background:rgba(16,185,129,0.06);border-left:3px solid #10b981;padding-left:9px'
                        : 'grid-template-columns:1fr 90px 90px 70px;background:rgba(16,185,129,0.06);border-left:3px solid #10b981;padding-left:9px')
                 : (pEd ? 'grid-template-columns:1fr 90px 90px 70px 36px;align-items:center'
                        : 'grid-template-columns:1fr 90px 90px 70px')">
            <!-- 보기 모드 -->
            <span x-show="!pEd" class="dtx-id">
              <span x-text="row.model||'-'"></span>
            </span>
            <span x-show="!pEd"
                  :style="selModel?.model===row.model ? 'font-weight:700;color:#10b981' : ''"
                  x-text="'$'+(row.inp??0).toFixed(3)"></span>
            <span x-show="!pEd"
                  :style="selModel?.model===row.model ? 'font-weight:700;color:#10b981' : ''"
                  x-text="'$'+(row.out??0).toFixed(3)"></span>
            <!-- 선택 버튼 -->
            <span x-show="!pEd" style="display:flex;justify-content:center">
              <button @click="pickModel(row)"
                      :style="selModel?.model===row.model
                        ? 'padding:2px 10px;border-radius:5px;border:1px solid #10b981;background:rgba(16,185,129,0.15);color:#10b981;font-size:11px;font-weight:700;cursor:pointer'
                        : 'padding:2px 10px;border-radius:5px;border:1px solid var(--border);background:transparent;color:var(--text2);font-size:11px;cursor:pointer'"
                      x-text="selModel?.model===row.model ? '✓ Applied' : 'Select'"></button>
            </span>
            <!-- 편집 모드 -->
            <input x-show="pEd" :value="row.model" @input="pRowSet(idx,'model',$event.target.value)"
                   style="background:var(--bg3);border:1px solid var(--border);border-radius:4px;padding:2px 6px;color:var(--text);font-size:12px;width:100%;box-sizing:border-box">
            <input x-show="pEd" type="number" :value="row.inp" @input="pRowSet(idx,'inp',$event.target.value)"
                   step="0.001" min="0" style="background:var(--bg3);border:1px solid var(--border);border-radius:4px;padding:2px 6px;color:var(--text);font-size:12px;width:80px">
            <input x-show="pEd" type="number" :value="row.out" @input="pRowSet(idx,'out',$event.target.value)"
                   step="0.001" min="0" style="background:var(--bg3);border:1px solid var(--border);border-radius:4px;padding:2px 6px;color:var(--text);font-size:12px;width:80px">
            <span x-show="pEd"></span>
            <button x-show="pEd" @click="pDel(idx)"
                    style="background:transparent;border:none;color:#f87171;font-size:16px;cursor:pointer;line-height:1">×</button>
          </div>
        </template>
      </div>

      <!-- 현재 비용 산출 기준 안내 -->
      <div style="margin-top:10px;padding:8px 12px;background:var(--bg3);border-radius:6px;font-size:11.5px;color:var(--text2);display:flex;align-items:center;gap:8px;flex-wrap:wrap">
        <span>📐 Cost Calculation Basis (Dashboard-wide):</span>
        <span x-show="selModel" style="color:#10b981;font-weight:600"
              x-text="selModel ? selModel.model.split('/')[0].trim()+' — Input $'+selModel.inp+'/1M · Output $'+selModel.out+'/1M (recalculated from raw tokens)' : ''"></span>
        <span x-show="!selModel" class="muted">Using cost values from saved JSON (selecting a model updates Overview, Gate, Insights, and Radar charts)</span>
      </div>
    </div>
  </div>

  <!-- Phase 2: Harness Gate D — 성능 계약 / SLA Gate -->
  <template x-if="data.harness_groups && data.harness_groups['D']">
    <div x-data="{
  gD: data.harness_groups['D'],
  selK:null,
  meta:{
    group_d:{label:'Gate D Overall',desc:'Weighted-average gate for performance contract metrics (P95 latency, token efficiency, resource budget, TTFT variability, cost predictability, efficiency ROI).',hint:'gate: pass≥0.75, warn≥0.6, fail<0.6'},
    p95_latency_s:{label:'P95 Latency',desc:'SLA compliance based on P95 latency threshold when SLAConfig is configured.',hint:'LatencyTracker P95 value (s) | 🟢 <5s 🟡 <10s 🔴 ≥10s'},
    token_efficiency:{label:'Token Efficiency',desc:'Actual usage efficiency relative to max token budget when ResourceBudgetConfig is set. Higher means more tasks completed within budget.',hint:'Tasks completed within budget | 🟢 ≥80% 🟡 ≥50% 🔴 <50%'},
    avg_budget_score:{label:'Resource Budget',desc:'Budget compliance score for tasks using ResourceBudgetConfig. Excellent when usage is below 80% of budget.',hint:'Inverse budget utilization score | 🟢 ≥0.8 🟡 ≥0.6 🔴 <0.6'},
    ttft_variability_score:{label:'TTFT Variability',desc:'Consistency evaluation via standard deviation and P95/P50 ratio of time-to-first-token when TTFTVariabilityConfig is set.',hint:'Low variability → score near 1.0 | 🟢 stddev<100ms 🟡 <300ms 🔴 ≥300ms'},
    avg_cost_predictability:{label:'Cost Predictability',desc:'Predictability measured by cost coefficient of variation (CV) within the same task_type when CostPredictabilityConfig is set.',hint:'CV < max_coefficient_of_variation | 🟢 CV<0.2 🟡 0.2-0.3 🔴 >0.3'},
    avg_efficiency_ratio:{label:'Efficiency ROI',desc:'Completion score ROI per cost unit when EfficiencyConfig is set. Ratio of actual cost to target cost.',hint:'completion_score / cost_unit | 🟢 ROI>1.0 🟡 0.5-1.0 🔴 <0.5'},
  },
  formula(k,d){
    const g=d.harness_groups?.D||{};
    const dt=g.details||{};
    if(k==='group_d') return `Overall = ${(g.score||0)*100 .toFixed(1)}%\nGate: ${(g.gate||'?').toUpperCase()}`;
    const v=dt[k];
    if(v==null) return 'No data';
    const isTime=k==='p95_latency_s';
    return `${this.meta[k]?.label} = ${isTime?v.toFixed(2)+'s':(v*100).toFixed(1)+'%'}\nRaw value: ${v.toFixed(4)}`;
  }
}">
      <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🎯 Harness Gate D — Performance Contract (SLA Gate)</span><div class="sdiv-line"></div></div>
      <div class="kpi-grid">
        <!-- D 종합 게이트 -->
        <div class="kpi kpi-act" :class="{sel:selK==='group_d'}" @click="selK=selK==='group_d'?null:'group_d'">
          <div class="kpi-lbl">Gate D Overall</div>
          <div class="kpi-val"
               :style="`color:${gD.gate==='pass'?'var(--green)':gD.gate==='fail'?'var(--red)':'var(--yellow)'}`"
               x-text="gD.score!=null?(gD.score*100).toFixed(1)+'%':'—'"></div>
          <div class="kpi-sub"
               :class="gD.gate==='pass'?'ok':gD.gate==='fail'?'':'warn'"
               x-text="(gD.gate||'?').toUpperCase()"></div>
        </div>
        <!-- P95 지연 -->
        <div class="kpi kpi-act" :class="{sel:selK==='p95_latency_s'}" @click="selK=selK==='p95_latency_s'?null:'p95_latency_s'" x-show="gD.details && gD.details.p95_latency_s!=null">
          <div class="kpi-lbl">P95 Latency</div>
          <div class="kpi-val"
               :style="`color:${(gD.details?.p95_latency_s||0)<5?'var(--green)':(gD.details?.p95_latency_s||0)<10?'var(--yellow)':'var(--red)'}`"
               x-text="gD.details?.p95_latency_s!=null?gD.details.p95_latency_s.toFixed(2)+'s':'—'"></div>
          <div class="kpi-sub" :class="(gD.details?.p95_latency_s||0)<5?'ok':'warn'"
               x-text="(gD.details?.p95_latency_s||0)<5?'SLA OK':'SLA Exceeded'"></div>
        </div>
        <!-- 토큰 효율 -->
        <div class="kpi kpi-act" :class="{sel:selK==='token_efficiency'}" @click="selK=selK==='token_efficiency'?null:'token_efficiency'" x-show="gD.details && gD.details.token_efficiency!=null">
          <div class="kpi-lbl">Token Efficiency</div>
          <div class="kpi-val"
               :style="`color:${(gD.details?.token_efficiency||0)>=0.8?'var(--green)':(gD.details?.token_efficiency||0)>=0.5?'var(--yellow)':'var(--red)'}`"
               x-text="gD.details?.token_efficiency!=null?((gD.details.token_efficiency)*100).toFixed(0)+'%':'—'"></div>
        </div>
        <!-- 리소스 예산 — ResourceBudgetConfig -->
        <div class="kpi kpi-act" :class="{sel:selK==='avg_budget_score'}" @click="selK=selK==='avg_budget_score'?null:'avg_budget_score'" x-show="gD.details && gD.details.avg_budget_score!=null">
          <div class="kpi-lbl">Resource Budget</div>
          <div class="kpi-val"
               :style="`color:${(gD.details?.avg_budget_score||0)>=0.8?'var(--green)':(gD.details?.avg_budget_score||0)>=0.6?'var(--yellow)':'var(--red)'}`"
               x-text="gD.details?.avg_budget_score!=null?((gD.details.avg_budget_score)*100).toFixed(1)+'%':'—'"></div>
          <div class="kpi-sub muted">ResourceBudget</div>
        </div>
        <!-- TTFT 변동성 — TTFTVariabilityConfig -->
        <div class="kpi kpi-act" :class="{sel:selK==='ttft_variability_score'}" @click="selK=selK==='ttft_variability_score'?null:'ttft_variability_score'" x-show="gD.details && gD.details.ttft_variability_score!=null">
          <div class="kpi-lbl">TTFT Variability</div>
          <div class="kpi-val"
               :style="`color:${(gD.details?.ttft_variability_score||0)>=0.8?'var(--green)':(gD.details?.ttft_variability_score||0)>=0.6?'var(--yellow)':'var(--red)'}`"
               x-text="gD.details?.ttft_variability_score!=null?((gD.details.ttft_variability_score)*100).toFixed(1)+'%':'—'"></div>
          <div class="kpi-sub muted" x-show="gD.details?.ttft_stddev_ms!=null"
               x-text="'σ='+(gD.details?.ttft_stddev_ms||0).toFixed(0)+'ms'"></div>
        </div>
        <!-- 비용 예측성 — CostPredictabilityConfig -->
        <div class="kpi kpi-act" :class="{sel:selK==='avg_cost_predictability'}" @click="selK=selK==='avg_cost_predictability'?null:'avg_cost_predictability'" x-show="gD.details && gD.details.avg_cost_predictability!=null">
          <div class="kpi-lbl">Cost Predictability</div>
          <div class="kpi-val"
               :style="`color:${(gD.details?.avg_cost_predictability||0)>=0.8?'var(--green)':(gD.details?.avg_cost_predictability||0)>=0.6?'var(--yellow)':'var(--red)'}`"
               x-text="gD.details?.avg_cost_predictability!=null?((gD.details.avg_cost_predictability)*100).toFixed(1)+'%':'—'"></div>
          <div class="kpi-sub muted">CostPredictability</div>
        </div>
        <!-- 효율 ROI — EfficiencyConfig -->
        <div class="kpi kpi-act" :class="{sel:selK==='avg_efficiency_ratio'}" @click="selK=selK==='avg_efficiency_ratio'?null:'avg_efficiency_ratio'" x-show="gD.details && gD.details.avg_efficiency_ratio!=null">
          <div class="kpi-lbl">Efficiency ROI</div>
          <div class="kpi-val"
               :style="`color:${(gD.details?.avg_efficiency_ratio||0)>=1.0?'var(--green)':(gD.details?.avg_efficiency_ratio||0)>=0.5?'var(--yellow)':'var(--red)'}`"
               x-text="gD.details?.avg_efficiency_ratio!=null?((gD.details.avg_efficiency_ratio)*100).toFixed(1)+'%':'—'"></div>
          <div class="kpi-sub muted">Efficiency</div>
        </div>
      </div>
      <div x-show="selK" style="margin-top:10px;padding:12px 14px;background:var(--bg2);border:1px solid var(--border);border-radius:8px">
        <template x-if="selK">
          <div>
            <div style="font-weight:600;font-size:13px;margin-bottom:8px;color:var(--text1)" x-text="meta[selK]?.label||selK"></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:8px">
              <div style="font-size:12px;line-height:1.6;padding:8px 10px;background:var(--bg3);border-radius:6px" x-text="meta[selK]?.desc||''"></div>
              <div style="font-size:11.5px;font-family:monospace;white-space:pre-wrap;padding:8px 10px;background:var(--bg);border:1px solid var(--border);border-radius:6px" x-text="formula(selK,data)"></div>
            </div>
            <div style="font-size:11px;color:var(--text2);padding:6px 10px;background:var(--bg);border-radius:4px" x-text="meta[selK]?.hint||''"></div>
              <!-- 관련 태스크 -->
              <div style="margin-top:10px;border-top:1px solid var(--border);padding-top:8px">
                <div style="display:flex;align-items:center;gap:6px;margin-bottom:6px">
                  <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">Related Tasks</span>
                  <span style="font-size:11px;color:var(--text2)" x-text="(data.tasks||[]).length+' tasks'"></span>
                </div>
                <div x-show="!(data.tasks||[]).length" style="font-size:11px;color:var(--text2);text-align:center;padding:10px">
                  Load an evaluation result file to display the task list.
                </div>
                <div class="dtx" style="max-height:180px;overflow-y:auto" x-show="(data.tasks||[]).length">
                  <div class="dtx-row dtx-head" style="grid-template-columns:minmax(100px,1.5fr) 80px 70px 50px;position:sticky;top:0;z-index:1">
                    <span>Task ID</span><span>Type</span><span>Completion</span><span>Status</span>
                  </div>
                  <template x-for="t in [...(data.tasks||[])].sort((a,b)=>(a.completion_score||0)-(b.completion_score||0)).slice(0,20)" :key="t.task_id">
                    <div class="dtx-row" style="grid-template-columns:minmax(100px,1.5fr) 80px 70px 50px">
                      <span class="dtx-id" x-text="t.task_id"></span>
                      <span class="text-muted" x-text="t.task_type||'-'"></span>
                      <span :style="`color:${(t.completion_score||0)>=0.9?'var(--green)':(t.completion_score||0)>=0.7?'var(--yellow)':'var(--red)'}`"
                            x-text="((t.completion_score||0)*100).toFixed(0)+'%'"></span>
                      <span :class="(t.completion_score||0)>=1?'badge-ok':(t.completion_score||0)>=0.7?'badge-warn':'badge-ng'"
                            x-text="(t.completion_score||0)>=1?'Done':(t.completion_score||0)>=0.7?'Partial':'Fail'"></span>
                    </div>
                  </template>
                </div>
              </div>
          </div>
        </template>
      </div>
    </div>
  </template>

</div><!-- /performance -->

<!-- ══ SECTION: RELIABILITY (Phase 2) ══ -->
<div x-show="data && sec==='reliability'" x-cloak
     x-init="if(sec==='reliability') loadReliability()">

  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔁 Reproducibility &amp; Reliability (Gate C)<span class="grp-chip grp-C" style="margin-left:6px;font-size:9.5px">C Reliability</span></span><div class="sdiv-line"></div></div>

  <div x-data="{
    selK:null,
    meta:{
      error_free_rate:{label:'Error-Free Tasks',desc:'Percentage of tasks completed without errors. Aggregated from tasks where the errors array is empty and attempts=1.',hint:'error_free = tasks_with_no_errors / total_tasks × 100 | 🟢 ≥90% 🟡 ≥70% 🔴 <70%'},
      retry_free_rate:{label:'Retry-Free Tasks',desc:'Percentage of tasks that succeeded on the first attempt without retries. Higher values indicate more stable agent behavior.',hint:'retry_free = tasks_with_attempts≤1 / total_tasks × 100 | 🟢 ≥90% 🟡 ≥70% 🔴 <70%'},
      group_c_summary:{label:'Gate C Overall',desc:'Weighted-average gate for reliability metrics (graceful degradation, retry consistency, idempotency, reproducibility, fault tolerance).',hint:'gate: pass≥0.75, warn≥0.6, fail<0.6'},
    },
    formula(k,d){
      if(k==='error_free_rate') return `error_free_rate = ${d.reliability?.error_free_rate?.toFixed(1)||'—'}%\n\nTasks with errors=[] AND attempts=1`;
      if(k==='retry_free_rate') return `retry_free_rate = ${d.reliability?.retry_free_rate?.toFixed(1)||'—'}%\n\nTasks with attempts ≤ 1`;
      if(k==='group_c_summary'){const g=d.harness_groups?.C||{};return `Overall = ${(g.score||0)*100 .toFixed(1)}%\nGate: ${(g.gate||'?').toUpperCase()}`;}
      return '';
    }
  }">
  <div class="kpi-grid">
    <div class="kpi kpi-act" :class="{sel:selK==='error_free_rate'}" @click="selK=selK==='error_free_rate'?null:'error_free_rate'">
      <div class="kpi-lbl">Error-Free Tasks</div>
      <div class="kpi-val"
           :style="`color:${(reliabilityData.error_free_rate||0)>=90?'var(--green)':(reliabilityData.error_free_rate||0)>=70?'var(--yellow)':'var(--red)'}`"
           x-text="reliabilityData.error_free_rate!=null?reliabilityData.error_free_rate.toFixed(1)+'%':'—'"></div>
      <div class="kpi-sub ok" x-show="(reliabilityData.error_free_rate||0)>=90">Good</div>
    </div>
    <div class="kpi kpi-act" :class="{sel:selK==='retry_free_rate'}" @click="selK=selK==='retry_free_rate'?null:'retry_free_rate'">
      <div class="kpi-lbl">Retry-Free Tasks</div>
      <div class="kpi-val"
           :style="`color:${(reliabilityData.retry_free_rate||0)>=90?'var(--green)':(reliabilityData.retry_free_rate||0)>=70?'var(--yellow)':'var(--red)'}`"
           x-text="reliabilityData.retry_free_rate!=null?reliabilityData.retry_free_rate.toFixed(1)+'%':'—'"></div>
    </div>
    <template x-if="data.harness_groups && data.harness_groups['C']">
      <div class="kpi kpi-act" :class="{sel:selK==='group_c_summary'}" @click="selK=selK==='group_c_summary'?null:'group_c_summary'">
        <div class="kpi-lbl">Gate C Overall</div>
        <div class="kpi-val"
             :style="`color:${data.harness_groups.C.gate==='pass'?'var(--green)':data.harness_groups.C.gate==='fail'?'var(--red)':'var(--yellow)'}`"
             x-text="data.harness_groups.C.score!=null?(data.harness_groups.C.score*100).toFixed(1)+'%':'—'"></div>
        <div class="kpi-sub"
             :class="data.harness_groups.C.gate==='pass'?'ok':data.harness_groups.C.gate==='fail'?'':'warn'"
             x-text="(data.harness_groups.C.gate||'?').toUpperCase()"></div>
      </div>
    </template>
  </div>
  <!-- 기본 신뢰성 카드 상세 패널 -->
  <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
    <template x-if="selK">
      <div>
        <div class="panel-header">
          <span class="val-md" x-text="meta[selK]?.label||selK"></span>
          <button class="btn-close" @click="selK=null">×</button>
        </div>
        <div class="grid-2-divider">
          <div class="panel-bg2-r">
            <div class="label-upper">Description</div>
            <div class="body-text" x-text="meta[selK]?.desc||''"></div>
          </div>
          <div class="panel-bg3">
            <div class="label-upper">📐 Calculation</div>
            <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
          </div>
        </div>
        <div class="panel-bg">
          <div style="font-size:11px;color:var(--text2);margin-bottom:6px" x-text="meta[selK]?.hint||''"></div>
          <div style="display:flex;align-items:center;gap:6px;margin-top:8px;margin-bottom:6px">
            <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">Related Tasks</span>
            <span style="font-size:11px;color:var(--text2)" x-text="(data.tasks||[]).length+' tasks'"></span>
          </div>
          <div x-show="!(data.tasks||[]).length" style="font-size:11px;color:var(--text2);text-align:center;padding:10px">
            Load an evaluation result file to display the task list.
          </div>
          <div class="dtx" style="max-height:180px;overflow-y:auto" x-show="(data.tasks||[]).length">
            <div class="dtx-row dtx-head" style="grid-template-columns:minmax(100px,1.5fr) 80px 70px 50px;position:sticky;top:0;z-index:1">
              <span>Task ID</span><span>Type</span><span>Completion</span><span>Status</span>
            </div>
            <template x-for="t in [...(data.tasks||[])].sort((a,b)=>(a.completion_score||0)-(b.completion_score||0)).slice(0,20)" :key="t.task_id">
              <div class="dtx-row" style="grid-template-columns:minmax(100px,1.5fr) 80px 70px 50px">
                <span class="dtx-id" x-text="t.task_id"></span>
                <span class="text-muted" x-text="t.task_type||'-'"></span>
                <span :style="`color:${(t.completion_score||0)>=0.9?'var(--green)':(t.completion_score||0)>=0.7?'var(--yellow)':'var(--red)'}`"
                      x-text="((t.completion_score||0)*100).toFixed(0)+'%'"></span>
                <span :class="(t.completion_score||0)>=1?'badge-ok':(t.completion_score||0)>=0.7?'badge-warn':'badge-ng'"
                      x-text="(t.completion_score||0)>=1?'Done':(t.completion_score||0)>=0.7?'Partial':'Fail'"></span>
              </div>
            </template>
          </div>
        </div>
      </div>
    </template>
  </div>
  </div>
  <!-- Gate C Phase 4-6 확장 지표 -->
  <template x-if="data.harness_groups && data.harness_groups['C']">
    <div x-data="{
  gC: data.harness_groups['C'],
  selK:null,
  meta:{
    avg_degradation:{label:'Graceful Degradation',desc:'Measures partial completion and best-effort response in degraded conditions when GracefulDegradationConfig is set.',hint:'quality_floor met + error acknowledgment markers | 🟢 ≥0.8 🟡 ≥0.6 🔴 <0.6'},
    avg_retry_consistency:{label:'Retry Consistency',desc:'Measures whether performance improves after retry when RetryConsistencyConfig is set. Penalized if retry yields no improvement.',hint:'improvement_threshold exceeded | 🟢 >10% improvement 🟡 0-10% 🔴 degraded'},
    avg_idempotency:{label:'Idempotency',desc:'Penalizes non-idempotent tool calls (create/delete/update) and rewards duplicate detection when IdempotencyConfig is set.',hint:'1.0 when no non-idempotent calls | 🟢 ≥0.9 🟡 ≥0.7 🔴 <0.7'},
    avg_reproducibility:{label:'Reproducibility',desc:'Average response similarity across N repeated runs with the same input when ReproducibilityConfig is set.',hint:'Average token F1 similarity | 🟢 ≥0.9 🟡 ≥0.7 🔴 <0.7'},
    avg_fault_tolerance:{label:'Fault Tolerance',desc:'Tracks fallback tool usage after tool failure when FaultToleranceConfig is set.',hint:'Fallback recovery rate | 🟢 ≥0.8 🟡 ≥0.5 🔴 <0.5'},
    llm_faithfulness:{label:'Faithfulness (LLM Judge)',desc:'LLM-as-judge measure of how faithfully the RAG response is grounded in retrieved context. When present, this score (faith/5) replaces HallucinationDetector in the Gate C calculation (★ = used in score). Auto-added when rag_mode=True + LLMJudgeConfig is set. Score 0–5; 5 = all claims supported by context.',hint:'avg_faithfulness from LLMJudge | 🟢 ≥4.0 🟡 ≥2.5 🔴 <2.5\n★ = replaces NLP hallucination in Gate C score'},
  },
  formula(k,d){
    if(k==='llm_faithfulness'){
      const v=d.llm_judge?.avg_faithfulness;
      return v!=null?`Faithfulness = ${v.toFixed(2)} / 5\nJudge: ${d.llm_judge?.model||'—'}\nScored: ${d.llm_judge?.judged_count||0} tasks`:'No LLM Judge data';
    }
    const dt=(d.harness_groups?.C||{}).details||{};
    const v=dt[k];
    if(v==null) return 'No data';
    return `${this.meta[k]?.label} = ${(v*100).toFixed(1)}%\nRaw value: ${v.toFixed(4)}`;
  }
}">
      <div class="kpi-grid" style="margin-top:8px">
        <!-- 우아한 저하 — GracefulDegradationConfig -->
        <div class="kpi kpi-act" :class="{sel:selK==='avg_degradation'}" @click="selK=selK==='avg_degradation'?null:'avg_degradation'" x-show="gC.details && gC.details.avg_degradation!=null">
          <div class="kpi-lbl">Graceful Degradation</div>
          <div class="kpi-val"
               :style="`color:${(gC.details?.avg_degradation||0)>=0.8?'var(--green)':(gC.details?.avg_degradation||0)>=0.6?'var(--yellow)':'var(--red)'}`"
               x-text="gC.details?.avg_degradation!=null?((gC.details.avg_degradation)*100).toFixed(1)+'%':'—'"></div>
          <div class="kpi-sub muted">GracefulDegradation</div>
        </div>
        <!-- 재시도 일관성 — RetryConsistencyConfig -->
        <div class="kpi kpi-act" :class="{sel:selK==='avg_retry_consistency'}" @click="selK=selK==='avg_retry_consistency'?null:'avg_retry_consistency'" x-show="gC.details && gC.details.avg_retry_consistency!=null">
          <div class="kpi-lbl">Retry Consistency</div>
          <div class="kpi-val"
               :style="`color:${(gC.details?.avg_retry_consistency||0)>=0.8?'var(--green)':(gC.details?.avg_retry_consistency||0)>=0.6?'var(--yellow)':'var(--red)'}`"
               x-text="gC.details?.avg_retry_consistency!=null?((gC.details.avg_retry_consistency)*100).toFixed(1)+'%':'—'"></div>
          <div class="kpi-sub muted">RetryConsistency</div>
        </div>
        <!-- 멱등성 — IdempotencyConfig -->
        <div class="kpi kpi-act" :class="{sel:selK==='avg_idempotency'}" @click="selK=selK==='avg_idempotency'?null:'avg_idempotency'" x-show="gC.details && gC.details.avg_idempotency!=null">
          <div class="kpi-lbl">Idempotency</div>
          <div class="kpi-val"
               :style="`color:${(gC.details?.avg_idempotency||0)>=0.8?'var(--green)':(gC.details?.avg_idempotency||0)>=0.6?'var(--yellow)':'var(--red)'}`"
               x-text="gC.details?.avg_idempotency!=null?((gC.details.avg_idempotency)*100).toFixed(1)+'%':'—'"></div>
          <div class="kpi-sub muted">Idempotency</div>
        </div>
        <!-- 재현성 — ReproducibilityConfig -->
        <div class="kpi kpi-act" :class="{sel:selK==='avg_reproducibility'}" @click="selK=selK==='avg_reproducibility'?null:'avg_reproducibility'" x-show="gC.details && gC.details.avg_reproducibility!=null">
          <div class="kpi-lbl">Reproducibility</div>
          <div class="kpi-val"
               :style="`color:${(gC.details?.avg_reproducibility||0)>=0.9?'var(--green)':(gC.details?.avg_reproducibility||0)>=0.7?'var(--yellow)':'var(--red)'}`"
               x-text="gC.details?.avg_reproducibility!=null?((gC.details.avg_reproducibility)*100).toFixed(1)+'%':'—'"></div>
          <div class="kpi-sub muted">Reproducibility</div>
        </div>
        <!-- 장애 내성 — FaultToleranceConfig -->
        <div class="kpi kpi-act" :class="{sel:selK==='avg_fault_tolerance'}" @click="selK=selK==='avg_fault_tolerance'?null:'avg_fault_tolerance'" x-show="gC.details && gC.details.avg_fault_tolerance!=null">
          <div class="kpi-lbl">Fault Tolerance</div>
          <div class="kpi-val"
               :style="`color:${(gC.details?.avg_fault_tolerance||0)>=0.8?'var(--green)':(gC.details?.avg_fault_tolerance||0)>=0.5?'var(--yellow)':'var(--red)'}`"
               x-text="gC.details?.avg_fault_tolerance!=null?((gC.details.avg_fault_tolerance)*100).toFixed(1)+'%':'—'"></div>
          <div class="kpi-sub muted">FaultTolerance</div>
        </div>
        <!-- LLM Judge Faithfulness — rag_mode=True + LLMJudgeConfig 시 표시 -->
        <template x-if="(data.llm_judge?.avg_faithfulness||0) > 0">
          <div class="kpi kpi-act" :class="{sel:selK==='llm_faithfulness'}" @click="selK=selK==='llm_faithfulness'?null:'llm_faithfulness'">
            <div class="kpi-lbl" x-text="gC.details?.avg_llm_faithfulness!=null?'Faithfulness (LLM) ★':'Faithfulness (LLM)'"></div>
            <div class="kpi-val"
                 :style="`color:${(data.llm_judge.avg_faithfulness||0)>=4?'var(--green)':(data.llm_judge.avg_faithfulness||0)>=2.5?'var(--yellow)':'var(--red)'}`"
                 x-text="(data.llm_judge.avg_faithfulness||0).toFixed(2)+'/5'"></div>
            <div class="kpi-sub muted" x-text="gC.details?.avg_llm_faithfulness!=null?'★ Gate C score':'LLMJudge RAG'"></div>
          </div>
        </template>
      </div>
      <div x-show="selK" style="margin-top:10px;padding:12px 14px;background:var(--bg2);border:1px solid var(--border);border-radius:8px">
        <template x-if="selK">
          <div>
            <div style="font-weight:600;font-size:13px;margin-bottom:8px;color:var(--text1)" x-text="meta[selK]?.label||selK"></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:8px">
              <div style="font-size:12px;line-height:1.6;padding:8px 10px;background:var(--bg3);border-radius:6px" x-text="meta[selK]?.desc||''"></div>
              <div style="font-size:11.5px;font-family:monospace;white-space:pre-wrap;padding:8px 10px;background:var(--bg);border:1px solid var(--border);border-radius:6px" x-text="formula(selK,data)"></div>
            </div>
            <div style="font-size:11px;color:var(--text2);padding:6px 10px;background:var(--bg);border-radius:4px" x-text="meta[selK]?.hint||''"></div>
              <!-- 관련 태스크 -->
              <div style="margin-top:10px;border-top:1px solid var(--border);padding-top:8px">
                <div style="display:flex;align-items:center;gap:6px;margin-bottom:6px">
                  <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">Related Tasks</span>
                  <span style="font-size:11px;color:var(--text2)" x-text="(data.tasks||[]).length+' tasks'"></span>
                </div>
                <div x-show="!(data.tasks||[]).length" style="font-size:11px;color:var(--text2);text-align:center;padding:10px">
                  Load an evaluation result file to display the task list.
                </div>
                <div class="dtx" style="max-height:180px;overflow-y:auto" x-show="(data.tasks||[]).length">
                  <div class="dtx-row dtx-head" style="grid-template-columns:minmax(100px,1.5fr) 80px 70px 50px;position:sticky;top:0;z-index:1">
                    <span>Task ID</span><span>Type</span><span>Completion</span><span>Status</span>
                  </div>
                  <template x-for="t in [...(data.tasks||[])].sort((a,b)=>(a.completion_score||0)-(b.completion_score||0)).slice(0,20)" :key="t.task_id">
                    <div class="dtx-row" style="grid-template-columns:minmax(100px,1.5fr) 80px 70px 50px">
                      <span class="dtx-id" x-text="t.task_id"></span>
                      <span class="text-muted" x-text="t.task_type||'-'"></span>
                      <span :style="`color:${(t.completion_score||0)>=0.9?'var(--green)':(t.completion_score||0)>=0.7?'var(--yellow)':'var(--red)'}`"
                            x-text="((t.completion_score||0)*100).toFixed(0)+'%'"></span>
                      <span :class="(t.completion_score||0)>=1?'badge-ok':(t.completion_score||0)>=0.7?'badge-warn':'badge-ng'"
                            x-text="(t.completion_score||0)>=1?'Done':(t.completion_score||0)>=0.7?'Partial':'Fail'"></span>
                    </div>
                  </template>
                </div>
              </div>
          </div>
        </template>
      </div>
    </div>
  </template>

  <!-- 재현성: task_type별 분산 -->
  <template x-if="reliabilityData.reproducibility_by_type && Object.keys(reliabilityData.reproducibility_by_type||{}).length">
    <div>
      <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">📐 Reproducibility by Task Type (completion_score variance)</span><div class="sdiv-line"></div></div>
      <div class="dtx">
        <div class="dtx-row dtx-head" style="grid-template-columns:2fr 60px 60px 60px 60px">
          <span>Task Type</span><span>Count</span><span>Mean</span><span>Std</span><span>CV%</span>
        </div>
        <template x-for="[tt, stats] in Object.entries(reliabilityData.reproducibility_by_type||{})" :key="tt">
          <div class="dtx-row" style="grid-template-columns:2fr 60px 60px 60px 60px">
            <span class="dtx-id" x-text="tt"></span>
            <span x-text="stats.count"></span>
            <span x-text="stats.mean!=null?stats.mean.toFixed(2):'—'"></span>
            <span :style="`color:${(stats.std||0)<=0.1?'var(--green)':(stats.std||0)<=0.2?'var(--yellow)':'var(--red)'}`"
                  x-text="stats.std!=null?stats.std.toFixed(3):'—'"></span>
            <span :style="`color:${(stats.cv||0)<=10?'var(--green)':(stats.cv||0)<=20?'var(--yellow)':'var(--red)'}`"
                  x-text="stats.cv!=null?stats.cv+'%':'—'"></span>
          </div>
        </template>
      </div>
    </div>
  </template>

  <!-- Fault Tolerance by Tool -->
  <template x-if="reliabilityData.fault_tolerance_by_tool && Object.keys(reliabilityData.fault_tolerance_by_tool||{}).length">
    <div>
      <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🛠 Fault Tolerance by Tool</span><div class="sdiv-line"></div></div>
      <div class="dtx">
        <div class="dtx-row dtx-head" style="grid-template-columns:2fr 70px 70px 80px">
          <span>Tool</span><span>Total Errors</span><span>Recovered</span><span>Recovery Rate</span>
        </div>
        <template x-for="[tool, stats] in Object.entries(reliabilityData.fault_tolerance_by_tool||{})" :key="tool">
          <div class="dtx-row" style="grid-template-columns:2fr 70px 70px 80px">
            <span class="dtx-id" x-text="tool"></span>
            <span x-text="stats.total||0"></span>
            <span x-text="stats.recovered||0"></span>
            <span :style="`color:${(stats.recovery_rate||0)>=80?'var(--green)':(stats.recovery_rate||0)>=50?'var(--yellow)':'var(--red)'}`"
                  x-text="stats.recovery_rate!=null?stats.recovery_rate+'%':'—'"></span>
          </div>
        </template>
      </div>
    </div>
  </template>

  <!-- Loop Events -->
  <template x-if="reliabilityData.loop_events && reliabilityData.loop_events.length">
    <div>
      <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔄 Loop Detection Events</span><div class="sdiv-line"></div></div>
      <div class="dtx">
        <div class="dtx-row dtx-head" style="grid-template-columns:2fr 100px 70px">
          <span>Task ID</span><span>Loop Type</span><span>Detected At</span>
        </div>
        <template x-for="(ev,i) in (reliabilityData.loop_events||[]).slice(0,30)" :key="i">
          <div class="dtx-row" style="grid-template-columns:2fr 100px 70px">
            <span class="dtx-id" x-text="ev.task_id||'—'"></span>
            <span style="color:var(--yellow)" x-text="ev.type||'unknown'"></span>
            <span class="muted" x-text="ev.at_step!=null?'Step '+ev.at_step:'—'"></span>
          </div>
        </template>
      </div>
    </div>
  </template>

  <!-- 데이터 없음 -->
  <div x-show="!reliabilityLoading && (!reliabilityData || (!reliabilityData.error_free_rate && !Object.keys(reliabilityData.fault_tolerance_by_tool||{}).length))" class="es">
    <div class="es-icon">🔁</div>
    <div class="es-title">No Reproducibility Data</div>
    <div class="es-desc">Select an evaluation result file to automatically aggregate this data.</div>
  </div>
  <div x-show="reliabilityLoading" style="padding:32px;text-align:center;color:var(--text2)">Loading…</div>

  <!-- ── Retry / 보정 (Gate C) ─────────────────────────────────────────── -->
  <!-- 재시도·보정 지표는 Gate C (신뢰성) 소속: RetryCorrectionTracker -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔁 Retry / Correction<span class="grp-chip grp-C" style="margin-left:6px;font-size:9.5px">C Reliability</span></span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      retry_rate:{label:'Retry Rate (by Attempt)',unit:'%',desc:'Percentage of all execution attempts that were retries. Calculated on an attempt basis, distinct from the task-based retry rate. Higher values indicate frequent first-attempt failures, increasing cost and latency.',hint:'overall_retry_rate = (total_attempts − tasks) / total_attempts × 100'},
      first_success:{label:'First-Attempt Success',unit:'%',desc:'Percentage of tasks that succeeded on the first attempt without retries. Higher values indicate stable agent planning and execution, reducing cost and latency in production. Equals 100% minus the task-based retry rate.',hint:'first_attempt_success_rate = 1st-attempt successes / total tasks × 100'},
      eventual_success:{label:'Eventual Success Rate',unit:'%',desc:'Percentage of tasks that ultimately succeeded including retries. The gap from first-attempt success rate represents the retry benefit (+Xpp); a large gap indicates retries are effectively recovering failures.',hint:'eventual_success_rate = ultimately successful tasks / total tasks × 100'},
      correction:{label:'Correction Success Rate',unit:'%',desc:'Percentage of retried tasks that ultimately succeeded. Reflects the agent\'s self-correction ability; low values indicate repeated errors despite retries, signaling a need to improve prompts or tool design.',hint:'correction_success_rate = succeeded after retry / retried tasks × 100'},
      avg_attempts:{label:'Avg Attempts',unit:'',desc:'Average number of attempts required to complete a task. Closer to 1.0 is more efficient. More retries linearly increase LLM call costs and response latency — set a target (≤1.3) and monitor.',hint:'avg_attempts_per_task = avg(total_attempts per task)'},
      avg_retry_time:{label:'Avg Retry Time',unit:'s',desc:'Average time spent exclusively on retries for tasks that had retries. Only retried tasks are counted in the denominator. High values indicate long retry wait times or complex error handling.',hint:'avg_retry_time = avg(retry_time) — retried tasks only'},
    },
    formula(k,d){
      const rs=d.agentic?.retry_summary||{};
      const ra=d.agentic?.retry_attempts||[];
      const total=ra.length||1;
      const tw=rs.total_tasks_with_retries||ra.filter(r=>(r.total_attempts||1)>1).length||0;
      const ta=rs.total_attempts||ra.reduce((s,r)=>s+(r.total_attempts||1),0)||0;
      const firstOK=rs.first_attempt_success_rate!=null?rs.first_attempt_success_rate:null;
      const finalOK=rs.eventual_success_rate||0;
      const effect=firstOK!=null?(finalOK-firstOK).toFixed(1):null;
      if(k==='retry_rate')return `overall_retry_rate (attempt-based)\n= (total_attempts ${ta} − tasks ${total}) / total_attempts ${ta} × 100\n= ${(rs.overall_retry_rate||0).toFixed(1)}%\n\nretry_rate (task-based, ref.)\n= retried tasks ${tw} / total ${total} × 100\n= ${(rs.retry_rate||0).toFixed(1)}%\n\n※ These two metrics differ because the denominator is different`;
      if(k==='first_success')return `First-Attempt Success Rate\n= 1st-attempt successes / total tasks × 100\n= ${(rs.first_attempt_success_rate||0).toFixed(1)}%\n\nRetried tasks: ${tw} / ${total} total\n(Equivalent to 100 − retry_rate(task-based) = ${(100-(rs.retry_rate||0)).toFixed(1)}%)`;
      if(k==='eventual_success'){const e=effect!=null?`\n\nRetry benefit = eventual(${finalOK.toFixed(1)}%) − first-attempt(${(firstOK||0).toFixed(1)}%)\n= +${effect}%p (successes recovered by retries)`:'';return `Eventual Success Rate\n= ultimately successful tasks / total tasks × 100\n= ${finalOK.toFixed(1)}%${e}`;}
      if(k==='correction')return `Correction Success Rate\n= succeeded after retry / retried tasks × 100\n= ${(rs.correction_success_rate||0).toFixed(1)}%\n\nRetried tasks: ${tw}\n※ Failed retries are not counted in this metric`;
      if(k==='avg_attempts'){const dist=ra.reduce((m,r)=>{const a=r.total_attempts||1;m[a]=(m[a]||0)+1;return m;},{});const distStr=Object.entries(dist).sort((a,b)=>+a[0]-+b[0]).map(([a,c])=>`${a}x: ${c} tasks`).join(' / ');return `Avg Attempts = avg(total_attempts)\n= ${(rs.avg_attempts_per_task||rs.avg_attempts||0).toFixed(2)}\n\nAttempt distribution: ${distStr}\n1.0 means all tasks succeeded on the first try`;}
      if(k==='avg_retry_time')return `Avg Retry Time (retried tasks only)\n= avg(retry_time)\n= ${(rs.avg_retry_time||0).toFixed(2)}s\n\nRetried tasks: ${tw} of ${total} total\n※ Only retried tasks are counted in the denominator`;
      return '';
    },
    items(k,d){
      const ra=d.agentic?.retry_attempts||[];
      if(k==='retry_rate') return [...ra].filter(r=>(r.total_attempts||1)>1).sort((a,b)=>(b.total_attempts||1)-(a.total_attempts||1));
      if(k==='first_success') return [...ra].sort((a,b)=>((a.total_attempts||1)>1?1:0)-((b.total_attempts||1)>1?1:0));
      if(k==='eventual_success') return [...ra].sort((a,b)=>(a.final_success===b.final_success?0:a.final_success?1:-1));
      if(k==='correction') return [...ra].filter(r=>(r.total_attempts||1)>1).sort((a,b)=>(a.final_success===b.final_success?0:a.final_success?1:-1));
      if(k==='avg_retry_time') return [...ra].filter(r=>(r.total_attempts||1)>1).sort((a,b)=>(b.total_retry_time||b.total_time||0)-(a.total_retry_time||a.total_time||0));
      return [...ra].sort((a,b)=>(b.total_attempts||1)-(a.total_attempts||1));
    },
    filterLabel(k){
      if(k==='retry_rate'||k==='avg_retry_time'||k==='correction') return 'Retried Tasks';
      if(k==='first_success') return 'All Tasks (first-success first, retried last)';
      if(k==='eventual_success') return 'All Tasks (failures first)';
      return 'All Tasks (most attempts first)';
    },
    attemptColor(n){return n>=3?'#e55':n===2?'#e9a020':'inherit';},
    retryTimeColor(s){return s>5?'#e55':s>2?'#e9a020':'inherit';},
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='retry_rate'}" @click="selK=selK==='retry_rate'?null:'retry_rate'">
        <div class="kpi-lbl">Retry Rate</div>
        <div class="kpi-val" x-text="_pct(data.agentic?.retry_summary?.overall_retry_rate||0)"></div>
        <div class="kpi-sub" x-text="'task-based '+_pct(data.agentic?.retry_summary?.retry_rate||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='first_success'}" @click="selK=selK==='first_success'?null:'first_success'">
        <div class="kpi-lbl">First-Attempt Success</div>
        <div class="kpi-val" :style="`color:${_bc(data.agentic?.retry_summary?.first_attempt_success_rate||0,90,70)}`"
             x-text="_pct(data.agentic?.retry_summary?.first_attempt_success_rate||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='eventual_success'}" @click="selK=selK==='eventual_success'?null:'eventual_success'">
        <div class="kpi-lbl">Eventual Success</div>
        <div class="kpi-val" :style="`color:${_bc(data.agentic?.retry_summary?.eventual_success_rate||0,90,70)}`"
             x-text="_pct(data.agentic?.retry_summary?.eventual_success_rate||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='correction'}" @click="selK=selK==='correction'?null:'correction'">
        <div class="kpi-lbl">Correction Success</div>
        <div class="kpi-val" :style="`color:${_bc(data.agentic?.retry_summary?.correction_success_rate||0,80,60)}`"
             x-text="_pct(data.agentic?.retry_summary?.correction_success_rate||0)"></div>
        <div class="kpi-sub" x-text="'retried: '+((data.agentic?.retry_summary?.total_tasks_with_retries)||(data.agentic?.retry_attempts||[]).filter(r=>(r.total_attempts||1)>1).length||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='avg_attempts'}" @click="selK=selK==='avg_attempts'?null:'avg_attempts'">
        <div class="kpi-lbl">Avg Attempts</div>
        <div class="kpi-val" x-text="(data.agentic?.retry_summary?.avg_attempts_per_task||data.agentic?.retry_summary?.avg_attempts||0).toFixed(2)+'x'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='avg_retry_time'}" @click="selK=selK==='avg_retry_time'?null:'avg_retry_time'">
        <div class="kpi-lbl">Avg Retry Time</div>
        <div class="kpi-val" x-text="_sec(data.agentic?.retry_summary?.avg_retry_time||0)"></div>
        <div class="kpi-sub">retried tasks only</div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div class="panel-header">
            <span class="val-md" x-text="meta[selK]?.label||selK"></span>
            <button class="btn-close" @click="selK=null">×</button>
          </div>
          <div class="grid-2-divider">
            <div class="panel-bg2-r">
              <div class="label-upper">Description</div>
              <div class="body-text" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div class="panel-bg3">
              <div class="label-upper">📐 Calculation</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <div class="panel-bg">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:6px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">Retry Log per Task</span>
              <span class="tag-sm" x-text="filterLabel(selK)"></span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,data).length+' tasks'"></span>
            </div>
            <div style="font-size:11px;color:var(--text2);margin-bottom:6px">
              🔴 ≥3 retries &nbsp;🟡 2 retries &nbsp;· Retry time 🟡 &gt;2s &nbsp;🔴 &gt;5s
            </div>
            <div class="dtx" style="max-height:240px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:minmax(100px,1.2fr) 90px 44px minmax(0,1fr) 58px 70px;position:sticky;top:0;z-index:1">
                <span>Task ID</span><span>Type</span><span>Attempts</span><span>Retry Reason</span><span>Final</span><span>Retry Time</span>
              </div>
              <template x-for="(r, ridx) in items(selK,data)" :key="ridx">
                <div class="dtx-row" :style="`grid-template-columns:minmax(100px,1.2fr) 90px 44px minmax(0,1fr) 58px 70px;${!r.final_success&&(r.total_attempts||1)>1?'background:rgba(220,50,50,0.06)':''}`">
                  <span class="dtx-id" x-text="r.task_id"></span>
                  <span style="font-size:11px;color:var(--text2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap" :title="r.task_type||'—'" x-text="r.task_type||'—'"></span>
                  <span :style="`font-weight:600;color:${attemptColor(r.total_attempts||1)}`" x-text="(r.total_attempts||1)+'x'"></span>
                  <span style="font-size:11px;color:var(--text2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap" :title="(r.retry_reasons||[]).filter(x=>x&&x!=='unknown'&&x!=='').join(', ')||'—'" x-text="(r.retry_reasons&&r.retry_reasons.filter(x=>x&&x!=='unknown'&&x!=='').length>0?r.retry_reasons.filter(x=>x&&x!=='unknown'&&x!=='').join(', '):'—')"></span>
                  <span :class="r.final_success?'badge-ok':'badge-ng'" x-text="r.final_success?'✓':'✗'"></span>
                  <span :style="`color:${retryTimeColor(r.total_retry_time||r.total_time||0)}`" x-text="_sec(r.total_retry_time||r.total_time||0)"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cg" style="margin-top:8px">
      <div class="cbox"><div class="ct">Retry Count Distribution</div><div id="d2-rel-retry-hist" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">Retry Rate by Task Type</div><div id="d2-rel-retry-type" class="plt-chart"></div></div>
    </div>
  </div>

  <!-- Hallucination subsection -->
  <div id="s-hallucination" class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔍 Hallucination Detection<span class="grp-chip grp-C" style="margin-left:6px;font-size:9.5px">C Reliability</span></span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      hall_rate:{label:'Hallucination Rate',unit:'%',desc:'Ratio of tasks with detected hallucination indicators. Measures how often the agent generates false or unsourced information; a key risk metric for reliable AI service operations.',hint:'flagged / evaluated × 100'},
      evaluated:{label:'Evaluated',unit:'tasks',desc:'Number of tasks analyzed for hallucination detection (Layer 1 only). Check DeepEval hallucination in the External Evaluation tab.',hint:'hallucination_detail.detections.length'},
      flagged:{label:'Flagged',unit:'tasks',desc:'Number of tasks with one or more hallucination indicators detected. Responses with numerical mismatch, unsupported claims, or context inconsistency patterns; candidates for human review.',hint:'hallucination_detail.detections.filter(d=>d.hallucination_rate>0).length'},
      types:{label:'Indicator Types',unit:'types',desc:'Number of distinct hallucination indicator types observed in this evaluation. More diverse types suggest the agent\'s hallucination issues are widespread rather than isolated to a specific cause.',hint:'hallucination_detail.indicator_types keys'},
    },
    formula(k,d){
      const dets=(d.hallucination_detail?.detections||[]).filter(x=>x.source!=='deepeval');
      const ev=dets.length;
      const fl=dets.filter(x=>(x.hallucination_rate||0)>0).length;
      if(k==='hall_rate')return `Hallucination Rate = flagged / evaluated × 100 (Layer 1 only)\n= ${fl} / ${ev} = ${ev?((fl/ev)*100).toFixed(1):0}%`;
      if(k==='evaluated')return `Evaluated = ${ev} tasks (Layer 1 detections)\nDeepEval records: see External Evaluation tab`;
      if(k==='flagged')return `Flagged = ${fl} tasks (hallucination_rate > 0)\nHallucination Rate = ${ev?((fl/ev)*100).toFixed(1):0}%`;
      const typesSet={};dets.filter(x=>(x.hallucination_rate||0)>0).forEach(det=>{new Set((det.indicators||[]).map(i=>i.type||'unknown')).forEach(t=>{typesSet[t]=(typesSet[t]||0)+1;});});
      if(k==='types')return `Indicator Types = ${Object.keys(typesSet).length}\n(per flagged task, detection count by indicator type)`;
      return '';
    },
    items(k,d){
      const dets=(d.hallucination_detail?.detections||[]).filter(x=>x.source!=='deepeval');
      if(k==='types'){
        // detection 1건 = 1행 (indicator 여러 개는 배지 묶음으로 표시) → 탐지 건수와 동일
        const sevRank={high:3,medium:2,low:1};
        return dets.filter(det=>(det.hallucination_rate||0)>0).map((det,i)=>{
          const inds=det.indicators||[];
          const types=[...new Set(inds.map(x=>x.type||'unknown'))];
          const maxSev=inds.reduce((a,b)=>(sevRank[b.severity]||0)>(sevRank[a]||0)?b.severity:a,'low');
          return {_key:'t'+i,task_id:det.task_id,question:det.question||'(no question)',indicator_types:types,severity:maxSev,hall_rate:det.hallucination_rate||0};
        });
      }
      const filtered=(k==='flagged'||k==='hall_rate')?dets.filter(det=>(det.hallucination_rate||0)>0):dets;
      // tasks에서 response/ground_truth cross-reference
      const taskMap={};(d.tasks||[]).forEach(t=>{taskMap[t.task_id]=t;});
      return filtered.map((det,i)=>{
        const tk=taskMap[det.task_id]||{};
        return {_key:'d'+i,task_id:det.task_id,question:det.question||tk.question||'(no question)',hall_rate:det.hallucination_rate||0,ind_count:(det.indicators||[]).length,indicators:det.indicators||[],context:det.context||null,response_sentences:det.response_sentences||0,response:tk.response||null,ground_truth:tk.ground_truth||null};
      });
    },
    filterLabel(k){return {hall_rate:'Flagged tasks',evaluated:'All tasks',flagged:'Flagged',types:'Flagged'}[k]||'All';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='hall_rate'}" @click="selK=selK==='hall_rate'?null:'hall_rate'">
        <div class="kpi-lbl">Hallucination Rate</div>
        <div class="kpi-val" :style="`color:${_hallG(data)===0?'var(--green)':_hallG(data)<=thresholds.hall_max*100?'var(--yellow)':'var(--red)'}`"
             x-text="_hallG(data).toFixed(1)+'%'"></div>
        <div class="kpi-sub" x-text="_hallG(data)===0?'✓ Safe':_hallG(data)<=thresholds.hall_max*100?'⚠ Caution':'🚨 Critical'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='evaluated'}" @click="selK=selK==='evaluated'?null:'evaluated'">
        <div class="kpi-lbl">Evaluated</div>
        <div class="kpi-val" x-text="(data.hallucination_detail?.detections||[]).filter(d=>d.source!=='deepeval').length"></div>
        <div class="kpi-sub muted">Layer 1</div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='flagged'}" @click="selK=selK==='flagged'?null:'flagged'">
        <div class="kpi-lbl">Flagged</div>
        <div class="kpi-val" style="color:var(--orange)" x-text="(data.hallucination_detail?.detections||[]).filter(d=>d.source!=='deepeval'&&(d.hallucination_rate||0)>0).length"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='types'}" @click="selK=selK==='types'?null:'types'">
        <div class="kpi-lbl">Types</div>
        <div class="kpi-val" x-text="(()=>{const s=new Set();(data.hallucination_detail?.detections||[]).filter(d=>d.source!=='deepeval'&&(d.hallucination_rate||0)>0).forEach(d=>(d.indicators||[]).forEach(i=>s.add(i.type||'unknown')));return s.size;})()"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div class="panel-header">
            <span class="val-md" x-text="meta[selK]?.label||selK"></span>
            <span class="tag-sm" x-text="meta[selK]?.unit?'Unit: '+meta[selK].unit:''"></span>
            <button class="btn-close" @click="selK=null">×</button>
          </div>
          <div class="grid-2-divider">
            <div class="panel-bg2-r">
              <div class="label-upper">Description</div>
              <div class="body-text" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div class="panel-bg3">
              <div class="label-upper">📐 Calculation</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <div class="panel-bg">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase" x-text="selK==='types'?'Flagged Task List (by type)':selK==='evaluated'?'Evaluation Records':'Detection List'"></span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="selK==='types'?items(selK,data).length+' flagged tasks':items(selK,data).length+' tasks'"></span>
            </div>
            <!-- types → per-detection card list (1건=1행, indicator 배지 묶음) -->
            <template x-if="selK==='types'">
              <div style="max-height:340px;overflow-y:auto;display:flex;flex-direction:column;gap:6px">
                <template x-for="det in items(selK,data)" :key="det._key">
                  <div style="border:1px solid var(--border);border-radius:6px;padding:8px 12px;background:var(--bg2)">
                    <div style="display:flex;align-items:center;gap:6px;margin-bottom:5px;flex-wrap:wrap">
                      <span class="dtx-id" x-text="det.task_id"></span>
                      <template x-for="tp in det.indicator_types" :key="tp">
                        <span style="font-size:10px;font-weight:600;background:rgba(239,68,68,0.1);color:var(--red);padding:1px 6px;border-radius:4px;border:1px solid rgba(239,68,68,0.25)" x-text="tp"></span>
                      </template>
                      <span :class="det.severity==='high'?'badge-ng':det.severity==='medium'?'badge-warn':'badge-gray'" style="margin-left:auto" x-text="det.severity"></span>
                    </div>
                    <div style="font-size:11px;color:var(--text2);line-height:1.6;word-break:break-all" x-text="det.question"></div>
                  </div>
                </template>
              </div>
            </template>
            <!-- hall_rate/flagged/evaluated → detection card list -->
            <template x-if="selK!=='types'">
              <div>
                <template x-if="(data.hallucination_detail?.detections||[]).some((d,i,a)=>a.findIndex(x=>x.task_id===d.task_id)!==i)">
                  <div style="font-size:11px;color:var(--orange);padding:4px 8px;background:rgba(245,158,11,0.08);border-radius:4px;margin-bottom:6px">
                    ⚠ Multiple detection records for same task — Layer 1 (native) and Layer 3 (DeepEval) results are mixed. Rows without questions are Layer 3 adapter records.
                  </div>
                </template>
                <div style="max-height:380px;overflow-y:auto;display:flex;flex-direction:column;gap:8px">
                  <template x-for="det in items(selK,data)" :key="det._key">
                    <div style="border:1px solid var(--border);border-radius:6px;overflow:hidden"
                         :style="(det.hall_rate>0&&det.ind_count===0)?'border-color:rgba(245,158,11,0.5)':''">
                      <!-- 헤더: 태스크 ID + 환각률 -->
                      <div style="display:flex;align-items:center;gap:8px;padding:7px 12px;background:var(--bg2);border-bottom:1px solid var(--border)">
                        <span class="dtx-id" x-text="det.task_id"></span>
                        <span style="margin-left:auto;font-size:13px;font-weight:700"
                              :style="`color:${(det.hall_rate||0)>=0.5?'var(--red)':(det.hall_rate||0)>0?'var(--orange)':'var(--green)'}`"
                              x-text="((det.hall_rate||0)*100).toFixed(0)+'%'"></span>
                        <template x-if="det.response_sentences>0">
                          <span class="text-xs-muted" x-text="det.response_sentences+' sentences'"></span>
                        </template>
                      </div>
                      <!-- 질문 + 답변 2열 -->
                      <div class="grid-2-divider">
                        <div style="padding:8px 12px;border-right:1px solid var(--border)">
                          <div style="font-size:10px;font-weight:700;color:var(--text2);text-transform:uppercase;margin-bottom:3px">Question</div>
                          <div style="font-size:12px;color:var(--text1);line-height:1.6;word-break:break-all" x-text="det.question"></div>
                        </div>
                        <div style="padding:8px 12px">
                          <div style="font-size:10px;font-weight:700;color:var(--text2);text-transform:uppercase;margin-bottom:3px">Agent Response</div>
                          <template x-if="det.response">
                            <div style="font-size:12px;color:var(--text1);line-height:1.6;word-break:break-all" x-text="det.response"></div>
                          </template>
                          <template x-if="!det.response">
                            <div class="text-muted">No response data</div>
                          </template>
                          <template x-if="det.ground_truth">
                            <div style="margin-top:6px;padding-top:6px;border-top:1px dashed var(--border)">
                              <div style="font-size:10px;font-weight:700;color:var(--text2);text-transform:uppercase;margin-bottom:2px">Ground Truth</div>
                              <div style="font-size:11px;color:var(--green);line-height:1.5;word-break:break-all" x-text="det.ground_truth"></div>
                            </div>
                          </template>
                        </div>
                      </div>
                      <!-- 컨텍스트 (있을 때만) -->
                      <template x-if="det.context">
                        <div style="padding:6px 12px;background:rgba(99,102,241,0.04);border-bottom:1px solid var(--border)">
                          <div style="font-size:10px;font-weight:700;color:var(--text2);text-transform:uppercase;margin-bottom:2px">Reference Context</div>
                          <div style="font-size:11px;color:var(--text2);line-height:1.5;word-break:break-all" x-text="det.context"></div>
                        </div>
                      </template>
                      <!-- 지표 유형 배지 -->
                      <div style="padding:7px 12px;display:flex;flex-wrap:wrap;gap:5px;align-items:center">
                        <template x-if="det.indicators.length===0">
                          <span style="font-size:11px;color:var(--orange)"
                                x-text="det.hall_rate>0?'⚠ Hallucination rate > 0 · No detailed indicators (SDK anomaly)':'No indicators (normal)'"></span>
                        </template>
                        <template x-for="(ind,ii) in det.indicators" :key="ii">
                          <span :class="ind.severity==='high'?'badge-ng':ind.severity==='medium'?'badge-warn':'badge-gray'"
                                x-text="(ind.type||'unknown')+(ind.severity?' · '+ind.severity:'')"></span>
                        </template>
                      </div>
                    </div>
                  </template>
                </div>
              </div>
            </template>
          </div>
        </div>
      </template>
    </div>
    <div class="cbox" style="margin-top:8px">
      <div class="ct">Hallucination Indicator Type Distribution</div>
      <div id="d2-q-hall-type" style="min-width:0;width:100%;min-height:80px"></div>
    </div>
  </div>

</div><!-- /reliability -->

<!-- ══ SECTION 5: AGENTIC ══ -->
<div x-show="data && sec==='agentic'" x-cloak>
  <div x-show="!data.has_agentic" class="es">
    <div class="es-icon">🤖</div>
    <div class="es-title">No Agentic Metrics</div>
    <div class="es-desc">Enable with <code>PerformanceMonitor(enable_agentic=True)</code>.</div>
  </div>
  <div x-show="data.has_agentic">

  <!-- Tool Efficiency subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔧 Tool Efficiency<span class="grp-chip grp-B" style="margin-left:6px;font-size:9.5px">B Behavioral Integrity</span></span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      total_calls:{label:'Total Calls',unit:'',desc:'Total number of tool calls made by the agent during this evaluation. A basic metric for tool usage frequency and agent tool dependency; interpret alongside average calls per task.',hint:'tool_efficiency.total_calls'},
      success_rate:{label:'Success Rate',unit:'%',desc:'Percentage of tool calls that returned results successfully. Low values suggest tool configuration issues, incorrect parameter usage, or frequent agent tool errors.',hint:'(total_calls − failed_calls) / total_calls × 100'},
      avg_efficiency:{label:'Avg Efficiency',unit:'/100',desc:'Overall score (0–100) for how efficiently the agent uses tools without unnecessary duplicates or failures. Closer to 100 means the agent achieves goals with minimal calls. Higher waste rate (redundant + failed) lowers the score.',hint:'avg(100 − waste_rate×100) per task\nwaste_rate = (redundant + failed) / total'},
      redundancy_rate:{label:'Redundancy Rate',unit:'%',desc:'Percentage of tool calls that were identical or unnecessarily repeated. High values indicate the agent is calling the same tool without checking results, or trial-and-erroring without strategy.',hint:'redundant_calls / total_calls × 100'},
      failure_rate:{label:'Failure Rate',unit:'%',desc:'Percentage of tool calls that returned errors or exceptions. High values indicate parameter generation errors, input validation issues, or the agent calling unavailable tools.',hint:'failed_calls / total_calls × 100'},
      avg_per_task:{label:'Avg per Task',unit:'',desc:'Average number of tool calls to complete one task. Too many indicates inefficient planning or unnecessary exploration; too few may mean simple tasks or underutilized tools.',hint:'avg(total_calls per task)'},
    },
    formula(k,d){
      const te=d.agentic?.tool_efficiency||{};
      const tc=te.total_calls||0;
      const red=te.total_redundant_calls||0;
      const fail=te.total_failed_calls||0;
      if(k==='total_calls')return `Total calls = ${tc}\nSuccess: ${tc-(fail||0)} / Failed: ${fail} / Redundant: ${red}`;
      if(k==='success_rate')return `Success Rate = (total − failed) / total × 100\n= (${tc} − ${fail}) / ${tc} × 100\n= ${(te.success_rate||0).toFixed(1)}%`;
      if(k==='avg_efficiency')return `Efficiency = 100 − waste_rate×100\nwaste_rate = (redundant + failed) / total\n= (${red} + ${fail}) / ${tc}\n= ${(te.avg_efficiency_score||0).toFixed(1)} / 100`;
      if(k==='redundancy_rate')return `Redundancy Rate = redundant / total × 100\n= ${red} / ${tc} × 100\n= ${(te.redundancy_rate||0).toFixed(1)}%`;
      if(k==='failure_rate')return `Failure Rate = failed / total × 100\n= ${fail} / ${tc} × 100\n= ${(te.failure_rate||0).toFixed(1)}%`;
      if(k==='avg_per_task')return `Avg per Task = avg(per-task calls)\n= ${(te.avg_calls_per_task||0).toFixed(2)}`;
      return '';
    },
    items(k,d){
      const rows=d.agentic?.tool_call_executions||[];
      if(!rows.length) return [];
      const s=[...rows];
      if(k==='total_calls'||k==='avg_per_task') return s.sort((a,b)=>(b.total_calls||0)-(a.total_calls||0));
      if(k==='success_rate'||k==='failure_rate') return s.sort((a,b)=>(b.failed_calls||0)-(a.failed_calls||0));
      if(k==='redundancy_rate') return s.sort((a,b)=>(b.redundant_calls||0)-(a.redundant_calls||0));
      if(k==='avg_efficiency') return s.sort((a,b)=>(a.efficiency_score??100)-(b.efficiency_score??100));
      return s;
    },
    sortLabel(k){
      if(k==='total_calls'||k==='avg_per_task') return 'Most calls first';
      if(k==='success_rate'||k==='failure_rate') return 'Most failures first';
      if(k==='redundancy_rate') return 'Most redundant first';
      if(k==='avg_efficiency') return 'Lowest efficiency first';
      return 'By task';
    },
    hlCol(k,t){
      if(k==='total_calls'||k==='avg_per_task') return 'total';
      if(k==='success_rate'||k==='failure_rate') return 'fail';
      if(k==='redundancy_rate') return 'red';
      if(k==='avg_efficiency') return 'eff';
      return '';
    },
    effColor(score){ return score>=90?'var(--green)':score>=70?'var(--yellow)':'var(--red)'; },
    redRate(t){ const tc=t.total_calls||0; return tc?((t.redundant_calls||0)/tc*100):0; },
    failRate(t){ const tc=t.total_calls||0; return tc?((t.failed_calls||0)/tc*100):0; },
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='total_calls'}" @click="selK=selK==='total_calls'?null:'total_calls'">
        <div class="kpi-lbl">Total Tool Calls</div>
        <div class="kpi-val" x-text="data.agentic?.tool_efficiency?.total_calls||0"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='success_rate'}" @click="selK=selK==='success_rate'?null:'success_rate'">
        <div class="kpi-lbl">Success Rate</div>
        <div class="kpi-val" :style="`color:${_bc(data.agentic?.tool_efficiency?.success_rate||0,90,70)}`"
             x-text="(data.agentic?.tool_efficiency?.success_rate||0).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='avg_efficiency'}" @click="selK=selK==='avg_efficiency'?null:'avg_efficiency'">
        <div class="kpi-lbl">Avg Efficiency</div>
        <div class="kpi-val" :style="`color:${_bc(data.agentic?.tool_efficiency?.avg_efficiency_score||0,90,70)}`"
             x-text="(data.agentic?.tool_efficiency?.avg_efficiency_score||0).toFixed(1)+'/100'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='redundancy_rate'}" @click="selK=selK==='redundancy_rate'?null:'redundancy_rate'">
        <div class="kpi-lbl">Redundancy Rate</div>
        <div class="kpi-val" style="color:var(--yellow)" x-text="(data.agentic?.tool_efficiency?.redundancy_rate||0).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='failure_rate'}" @click="selK=selK==='failure_rate'?null:'failure_rate'">
        <div class="kpi-lbl">Failure Rate</div>
        <div class="kpi-val" style="color:var(--red)" x-text="(data.agentic?.tool_efficiency?.failure_rate||0).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='avg_per_task'}" @click="selK=selK==='avg_per_task'?null:'avg_per_task'">
        <div class="kpi-lbl">Avg per Task</div>
        <div class="kpi-val" x-text="(data.agentic?.tool_efficiency?.avg_calls_per_task||0).toFixed(1)+'x'"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div class="panel-header">
            <span class="val-md" x-text="meta[selK]?.label||selK"></span>
            <button class="btn-close" @click="selK=null">×</button>
          </div>
          <div class="grid-2-divider">
            <div class="panel-bg2-r">
              <div class="label-upper">Description</div>
              <div class="body-text" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div class="panel-bg3">
              <div class="label-upper">📐 Calculation</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <!-- 태스크별 상세 테이블 -->
          <div class="panel-bg">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">Tool Call Detail per Task</span>
              <span class="tag-sm" x-text="sortLabel(selK)"></span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,data).length+' tasks'"></span>
            </div>
            <template x-if="items(selK,data).length>0">
              <div class="dtx" style="max-height:220px;overflow-y:auto">
                <div class="dtx-row dtx-head" style="grid-template-columns:minmax(120px,1fr) 52px 52px 52px 56px 72px;position:sticky;top:0;z-index:1">
                  <span>Task ID</span>
                  <span>Calls</span>
                  <span>Unique</span>
                  <span>Redundant</span>
                  <span>Failed</span>
                  <span>Efficiency</span>
                </div>
                <template x-for="t in items(selK,data)" :key="t.task_id">
                  <div class="dtx-row" style="grid-template-columns:minmax(120px,1fr) 52px 52px 52px 56px 72px">
                    <span class="dtx-id" x-text="t.task_id||'-'"></span>
                    <span :style="hlCol(selK,t)==='total'?'font-weight:700;color:var(--accent)':''"
                          x-text="t.total_calls||0"></span>
                    <span x-text="t.unique_tools||0"></span>
                    <span :style="(t.redundant_calls||0)>0?(hlCol(selK,t)==='red'?'font-weight:700;color:var(--yellow)':'color:var(--yellow)'):''"
                          x-text="(t.redundant_calls||0)>0?((t.redundant_calls||0)+' ('+redRate(t).toFixed(0)+'%)'):'0'"></span>
                    <span :style="(t.failed_calls||0)>0?(hlCol(selK,t)==='fail'?'font-weight:700;color:var(--red)':'color:var(--red)'):''"
                          x-text="(t.failed_calls||0)>0?((t.failed_calls||0)+' ('+failRate(t).toFixed(0)+'%)'):'0'"></span>
                    <span :style="`font-weight:${hlCol(selK,t)==='eff'?'700':'400'};color:${effColor(t.efficiency_score??100)}`"
                          x-text="(t.efficiency_score??100).toFixed(1)"></span>
                  </div>
                </template>
              </div>
            </template>
            <template x-if="items(selK,data).length===0">
              <div style="text-align:center;color:var(--text2);font-size:13px;padding:20px 0">No per-task tool call data available.</div>
            </template>
          </div>
        </div>
      </template>
    </div>
    <div class="cg" style="margin-top:8px">
      <div class="cbox"><div class="ct">Tool Usage Frequency</div><div id="d2-ag-tool-pie" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">Efficiency Metrics Summary</div><div id="d2-ag-teff-bar" class="plt-chart"></div></div>
    </div>
  </div>

  <!-- Tool Selection subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🎯 Tool Selection Accuracy<span class="grp-chip grp-B" style="margin-left:6px;font-size:9.5px">B Behavioral Integrity</span></span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      precision:{label:'Precision',unit:'%',desc:'Proportion of tools selected by the agent that were actually needed. Low values indicate a tendency to include unnecessary tools, increasing execution costs and error likelihood. Measured only on tasks with expected_tools set.',hint:'TP / (TP + FP) per task → 0–100% avg'},
      recall:{label:'Recall',unit:'%',desc:'Proportion of required tools that the agent actually selected. Low values indicate missed tools, increasing the likelihood of incomplete task execution. Measured only on tasks with expected_tools set.',hint:'TP / (TP + FN) per task → 0–100% avg'},
      f1:{label:'F1 Score',unit:'%',desc:'Balanced combination of Precision and Recall for tool selection. Represents in a single score the ability to select tools accurately while not missing necessary ones — the primary indicator of tool usage capability. Measured only on tasks with expected_tools set.',hint:'2 × P × R / (P + R) per task → 0–100% avg'},
      accuracy:{label:'Accuracy',unit:'%',desc:'Overall selection accuracy indicating how well the expected tool set matches the actually selected tool set. Evaluates the agent\'s domain understanding in identifying appropriate tools for each task.',hint:'correct_selections / total_selections per task → 0–100% avg'},
      total:{label:'Evaluated Tasks',unit:'',desc:'Number of tasks for which tool selection accuracy was evaluated. Only measured for tasks where expected_tools was provided when creating the TaskResult, so may differ from total task count.',hint:'len(tool_selections) — tasks with expected_tools'},
    },
    formula(k,d){
      const ts=d.agentic?.tool_selection_summary||{};
      const n=ts.total_selections||(d.agentic?.tool_selections||[]).length||0;
      if(k==='precision'){const v=ts.avg_precision||0;return `Precision = TP/(TP+FP) per task → avg\n= ${v.toFixed(1)}%\nEvaluated tasks: ${n}`;}
      if(k==='recall'){const v=ts.avg_recall||0;return `Recall = TP/(TP+FN) per task → avg\n= ${v.toFixed(1)}%\nEvaluated tasks: ${n}`;}
      if(k==='f1'){const v=ts.avg_f1_score||0;return `F1 = 2×P×R/(P+R) per task → avg\n= ${v.toFixed(1)}%\nEvaluated tasks: ${n}`;}
      if(k==='accuracy'){const v=ts.avg_accuracy||0;return `Accuracy = correct/total per task → avg\n= ${v.toFixed(1)}%\nEvaluated tasks: ${n}`;}
      if(k==='total')return `Evaluated tasks = ${n}\n(tasks with expected_tools only)`;
      return '';
    },
    items(k,d){ return [...(d.agentic?.tool_selections||[])].sort((a,b)=>(b.f1_score||0)-(a.f1_score||0)); },
    filterLabel(k){return 'F1 descending';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='precision'}" @click="selK=selK==='precision'?null:'precision'">
        <div class="kpi-lbl">Precision</div>
        <div class="kpi-val" x-text="(data.agentic?.tool_selection_summary?.avg_precision||0).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='recall'}" @click="selK=selK==='recall'?null:'recall'">
        <div class="kpi-lbl">Recall</div>
        <div class="kpi-val" x-text="(data.agentic?.tool_selection_summary?.avg_recall||0).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='f1'}" @click="selK=selK==='f1'?null:'f1'">
        <div class="kpi-lbl">F1 Score</div>
        <div class="kpi-val" :style="`color:${_bc(data.agentic?.tool_selection_summary?.avg_f1_score||0,90,70)}`"
             x-text="(data.agentic?.tool_selection_summary?.avg_f1_score||0).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='accuracy'}" @click="selK=selK==='accuracy'?null:'accuracy'">
        <div class="kpi-lbl">Accuracy</div>
        <div class="kpi-val" :style="`color:${_bc(data.agentic?.tool_selection_summary?.avg_accuracy||0,90,70)}`"
             x-text="(data.agentic?.tool_selection_summary?.avg_accuracy||0).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='total'}" @click="selK=selK==='total'?null:'total'">
        <div class="kpi-lbl">Evaluated Tasks</div>
        <div class="kpi-val" x-text="(data.agentic?.tool_selections||[]).length"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div class="panel-header">
            <span class="val-md" x-text="meta[selK]?.label||selK"></span>
            <button class="btn-close" @click="selK=null">×</button>
          </div>
          <div class="grid-2-divider">
            <div class="panel-bg2-r">
              <div class="label-upper">Description</div>
              <div class="body-text" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div class="panel-bg3">
              <div class="label-upper">📐 Calculation</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <div class="panel-bg">
            <div class="dtx" style="max-height:200px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:minmax(120px,1fr) 68px 68px 68px;position:sticky;top:0;z-index:1">
                <span>Task ID</span><span>Prec.</span><span>Recall</span><span>F1</span>
              </div>
              <template x-for="s in items(selK,data)" :key="s.task_id">
                <div class="dtx-row" style="grid-template-columns:minmax(120px,1fr) 68px 68px 68px">
                  <span class="dtx-id" x-text="s.task_id"></span>
                  <span x-text="(s.precision||0).toFixed(1)+'%'"></span>
                  <span x-text="(s.recall||0).toFixed(1)+'%'"></span>
                  <span :style="`color:${_bc(s.f1_score||0,80,60)}`" x-text="(s.f1_score||0).toFixed(1)+'%'"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cbox" style="margin-top:8px">
      <div class="ct">F1 Score per Task</div>
      <div id="d2-ag-sel-bar" style="min-height:260px;width:100%"></div>
    </div>
  </div>

  <!-- Retry 섹션은 Gate C (신뢰성) 소속 → reliability 탭으로 이동됨 (Zero-Base 재설계) -->

  <!-- Multi-Agent Coordination subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🤝 Multi-Agent Collaboration<span class="grp-chip grp-F" style="margin-left:6px;font-size:9.5px">F Multi-Agent</span></span><div class="sdiv-line"></div></div>
  <div x-show="!data.has_coordination">
    <div class="badge-gray" style="display:inline-block;margin-bottom:12px">No collaboration data — AgentCoordinationTracker not enabled</div>
  </div>
  <div x-show="data.has_coordination">
    <div x-data="{
      selK:null,
      meta:{
        total_interactions:{label:'Total Interactions',unit:'',desc:'Total number of inter-agent interactions. Includes delegation, direct communication, and collaboration types. Together with average interactions per task, reflects workflow complexity.',hint:'agent_interactions.length'},
        success_interactions:{label:'Successful Interactions',unit:'',desc:'Number of inter-agent interactions that completed successfully. Failed interactions are highlighted in red in the list below. Reflects the receiving agent\'s processing success, indicating collaboration interface quality.',hint:'successful_interactions'},
        success_rate:{label:'Collaboration Success Rate',unit:'%',desc:'Percentage of inter-agent collaborations that succeeded. Failed interactions are highlighted below, making it easy to identify which agent pairs are experiencing failures.',hint:'successful / total × 100'},
        unique_agents:{label:'Participating Agents',unit:'',desc:'Number of unique agents that participated in interactions during this evaluation. The table below shows each agent\'s sent (from) and received (to) counts and total participation frequency.',hint:'unique_agents'},
      },
      formula(k,d){
        const cs=d.agentic?.coordination_summary||{};
        const ai=d.agentic?.agent_interactions||[];
        const tot=cs.total_interactions||0;
        const suc=cs.successful_interactions||0;
        const fail=tot-suc;
        const taskSet=new Set(ai.map(i=>i.task_id));
        const avgPerTask=taskSet.size?+(tot/taskSet.size).toFixed(1):0;
        if(k==='total_interactions')return `Total interactions = ${tot}\nSuccess: ${suc} / Failed: ${fail}\nParticipating agents: ${cs.unique_agents||0}\nParticipating tasks: ${taskSet.size} (avg ${avgPerTask} per task)`;
        if(k==='success_interactions')return `Successful interactions = ${suc}\n= total(${tot}) − failed(${fail})\nSuccess rate: ${(cs.success_rate||0).toFixed(1)}%`;
        if(k==='success_rate')return `Collaboration Success Rate = successful / total × 100\n= ${suc} / ${tot} × 100\n= ${(cs.success_rate||0).toFixed(1)}%${fail>0?'\n\n⚠️ '+fail+' failed interaction(s) highlighted in the list below.':'\n\n✓ No failed interactions'}`;
        if(k==='unique_agents'){
          const agents=(cs.agent_list||[]);
          const pairMap={};
          ai.forEach(i=>{const p=`${i.from_agent}→${i.to_agent}`;pairMap[p]=(pairMap[p]||0)+1;});
          const topPair=Object.entries(pairMap).sort((a,b)=>b[1]-a[1])[0];
          return `Participating agents = ${cs.unique_agents||0}\n[${agents.join(', ')}]\n\nMost frequent pair: ${topPair?topPair[0]+' ('+topPair[1]+')':'none'}`;
        }
        return '';
      },
      items(k,d){
        const ai=d.agentic?.agent_interactions||[];
        if(k==='success_interactions') return ai.filter(i=>i.success);
        if(k==='success_rate') return [...ai].sort((a,b)=>(a.success===b.success)?0:a.success?1:-1);
        if(k==='unique_agents'){
          const sentMap={}, recvMap={};
          ai.forEach(i=>{
            sentMap[i.from_agent]=(sentMap[i.from_agent]||0)+1;
            recvMap[i.to_agent]=(recvMap[i.to_agent]||0)+1;
          });
          const agents=new Set([...Object.keys(sentMap),...Object.keys(recvMap)]);
          return [...agents].map(a=>({agent:a,sent:sentMap[a]||0,recv:recvMap[a]||0}))
                            .sort((a,b)=>(b.sent+b.recv)-(a.sent+a.recv));
        }
        return ai;
      },
      rowCount(k,d){ return this.items(k,d).length; },
      filterLabel(k){
        if(k==='success_interactions') return 'Successful interactions';
        if(k==='success_rate') return 'Failures first';
        if(k==='unique_agents') return 'Most active first';
        return 'All interactions';
      },
    }">
      <div class="kpi-grid">
        <div class="kpi kpi-act" :class="{sel:selK==='total_interactions'}" @click="selK=selK==='total_interactions'?null:'total_interactions'">
          <div class="kpi-lbl">Total Interactions</div>
          <div class="kpi-val" x-text="data.agentic?.coordination_summary?.total_interactions||0"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='success_interactions'}" @click="selK=selK==='success_interactions'?null:'success_interactions'">
          <div class="kpi-lbl">Successful Interactions</div>
          <div class="kpi-val" style="color:var(--green)" x-text="data.agentic?.coordination_summary?.successful_interactions||0"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='success_rate'}" @click="selK=selK==='success_rate'?null:'success_rate'">
          <div class="kpi-lbl">Collab. Success Rate</div>
          <div class="kpi-val" :style="`color:${_bc(data.agentic?.coordination_summary?.success_rate||0,90,70)}`"
               x-text="_pct(data.agentic?.coordination_summary?.success_rate||0)"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='unique_agents'}" @click="selK=selK==='unique_agents'?null:'unique_agents'">
          <div class="kpi-lbl">Participating Agents</div>
          <div class="kpi-val" x-text="data.agentic?.coordination_summary?.unique_agents||0"></div>
        </div>
      </div>
      <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
        <template x-if="selK">
          <div>
            <div class="panel-header">
              <span class="val-md" x-text="meta[selK]?.label||selK"></span>
              <button class="btn-close" @click="selK=null">×</button>
            </div>
            <div class="grid-2-divider">
              <div class="panel-bg2-r">
                <div class="label-upper">Description</div>
                <div class="body-text" x-text="meta[selK]?.desc||''"></div>
              </div>
              <div class="panel-bg3">
                <div class="label-upper">📐 Calculation</div>
                <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
              </div>
            </div>
            <!-- 에이전트 요약표 (unique_agents 전용) -->
            <template x-if="selK==='unique_agents'">
              <div class="panel-bg">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
                  <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">Activity per Agent</span>
                  <span class="tag-sm">Most active first</span>
                  <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="rowCount(selK,data)+' agents'"></span>
                </div>
                <div class="dtx" style="max-height:200px;overflow-y:auto">
                  <div class="dtx-row dtx-head" style="grid-template-columns:minmax(120px,1fr) 60px 60px 70px;position:sticky;top:0;z-index:1">
                    <span>Agent</span><span>Sent</span><span>Recv</span><span>Total</span>
                  </div>
                  <template x-for="(ag, idx) in items(selK,data)" :key="idx">
                    <div class="dtx-row" style="grid-template-columns:minmax(120px,1fr) 60px 60px 70px">
                      <span class="dtx-id" x-text="ag.agent"></span>
                      <span x-text="ag.sent"></span>
                      <span x-text="ag.recv"></span>
                      <span style="font-weight:600;color:var(--accent)" x-text="ag.sent+ag.recv"></span>
                    </div>
                  </template>
                </div>
              </div>
            </template>
            <!-- 인터랙션 목록표 (나머지 KPI) -->
            <template x-if="selK!=='unique_agents'">
              <div class="panel-bg">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
                  <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">Interaction Detail</span>
                  <span class="tag-sm" x-text="filterLabel(selK)"></span>
                  <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="rowCount(selK,data)+' records'"></span>
                </div>
                <div class="dtx" style="max-height:200px;overflow-y:auto">
                  <div class="dtx-row dtx-head" style="grid-template-columns:140px 90px 90px minmax(0,1fr) 52px;position:sticky;top:0;z-index:1">
                    <span>Task ID</span><span>From</span><span>To</span><span>Context</span><span>Status</span>
                  </div>
                  <template x-for="(i, idx) in items(selK,data)" :key="idx">
                    <div class="dtx-row" :style="`grid-template-columns:140px 90px 90px minmax(0,1fr) 52px;${!i.success?'background:rgba(239,68,68,0.06)':''}`">
                      <span class="dtx-id" x-text="i.task_id"></span>
                      <span class="fs-sm" x-text="i.from_agent||'-'"></span>
                      <span class="fs-sm" x-text="i.to_agent||'-'"></span>
                      <span class="text-xs-muted" x-text="i.context||'-'"></span>
                      <span :class="i.success?'badge-ok':'badge-ng'" x-text="i.success?'✓':'✗'"></span>
                    </div>
                  </template>
                </div>
              </div>
            </template>
          </div>
        </template>
      </div>
      <div class="cbox" style="margin-top:8px">
        <div class="ct">Interactions per Agent</div>
        <div id="d2-ag-coord-bar" class="plt-chart"></div>
      </div>
    </div>
  </div>

  <!-- Harness Gate F — 다중 에이전트 협업 -->
  <template x-if="data.harness_groups && data.harness_groups['F'] && data.harness_groups['F'].score!=null">
    <div x-data="{
  gF: data.harness_groups['F'],
  selK:null,
  meta:{
    group_f:{label:'Gate F Overall',desc:'Weighted-average gate for multi-agent collaboration metrics (consensus rate, propagation fidelity, role compliance, conflict resolution).',hint:'gate: pass≥0.75, warn≥0.6, fail<0.6'},
    avg_consensus:{label:'Consensus Rate',desc:'Consensus quality among multiple agents when ConsensusConfig is set. Supports majority, weighted, and unanimous methods.',hint:'tasks achieving consensus / total × 100 | 🟢 ≥0.8 🟡 ≥0.6 🔴 <0.6'},
    avg_propagation:{label:'Propagation Fidelity',desc:'Rate at which source agent facts are preserved in downstream agents when PropagationConfig is set.',hint:'Key fact preservation rate | 🟢 ≥0.9 🟡 ≥0.7 🔴 <0.7'},
    avg_role_compliance:{label:'Role Compliance',desc:'Percentage of time agents operate within their role scope (allowed tools and actions) when AgentRoleConfig is set.',hint:'Penalized for role violations | 🟢 ≥0.9 🟡 ≥0.7 🔴 <0.7'},
    avg_conflict_resolution:{label:'Conflict Resolution',desc:'Rate at which inter-agent conflicts are resolved after detection when ConflictResolutionConfig is set.',hint:'Resolution markers confirmed / conflicts detected | 🟢 ≥0.9 🟡 ≥0.7 🔴 <0.7'},
  },
  formula(k,d){
    const g=d.harness_groups?.F||{};
    const dt=g.details||{};
    if(k==='group_f') return `Overall = ${(g.score||0)*100 .toFixed(1)}%\nGate: ${(g.gate||'?').toUpperCase()}`;
    const v=dt[k];
    if(v==null) return 'No data';
    return `${this.meta[k]?.label} = ${(v*100).toFixed(1)}%\nRaw value: ${v.toFixed(4)}`;
  }
}">
      <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🤝 Harness Gate F — Multi-Agent Collaboration</span><div class="sdiv-line"></div></div>
      <div class="kpi-grid">
        <div class="kpi kpi-act" :class="{sel:selK==='group_f'}" @click="selK=selK==='group_f'?null:'group_f'">
          <div class="kpi-lbl">Gate F Overall</div>
          <div class="kpi-val"
               :style="`color:${gF.gate==='pass'?'var(--green)':gF.gate==='fail'?'var(--red)':'var(--yellow)'}`"
               x-text="gF.score!=null?(gF.score*100).toFixed(1)+'%':'—'"></div>
          <div class="kpi-sub"
               :class="gF.gate==='pass'?'ok':gF.gate==='fail'?'':'warn'"
               x-text="(gF.gate||'?').toUpperCase()"></div>
        </div>
        <!-- 합의율 — ConsensusConfig -->
        <div class="kpi kpi-act" :class="{sel:selK==='avg_consensus'}" @click="selK=selK==='avg_consensus'?null:'avg_consensus'" x-show="gF.details && gF.details.avg_consensus!=null">
          <div class="kpi-lbl">Consensus Rate</div>
          <div class="kpi-val"
               :style="`color:${(gF.details?.avg_consensus||0)>=0.8?'var(--green)':(gF.details?.avg_consensus||0)>=0.6?'var(--yellow)':'var(--red)'}`"
               x-text="gF.details?.avg_consensus!=null?((gF.details.avg_consensus)*100).toFixed(1)+'%':'—'"></div>
          <div class="kpi-sub muted">Consensus</div>
        </div>
        <!-- 전파 충실도 — PropagationConfig -->
        <div class="kpi kpi-act" :class="{sel:selK==='avg_propagation'}" @click="selK=selK==='avg_propagation'?null:'avg_propagation'" x-show="gF.details && gF.details.avg_propagation!=null">
          <div class="kpi-lbl">Propagation Fidelity</div>
          <div class="kpi-val"
               :style="`color:${(gF.details?.avg_propagation||0)>=0.8?'var(--green)':(gF.details?.avg_propagation||0)>=0.6?'var(--yellow)':'var(--red)'}`"
               x-text="gF.details?.avg_propagation!=null?((gF.details.avg_propagation)*100).toFixed(1)+'%':'—'"></div>
