            </tbody>
          </table>
        </div>
      </div>
    </div>
  </template>

</div><!-- /quality -->

<!-- ══ SECTION 3: EXTERNAL (RAG + DeepEval) ══ -->
<div x-show="data && sec==='external'" x-cloak>
  <div x-show="!data.has_rag && !data.has_advanced" class="es">
    <div class="es-icon">📭</div>
    <div class="es-title">외부 평가 지표 없음</div>
    <div class="es-desc">RAG 또는 DeepEval 지표가 포함된 평가 결과를 선택하세요.</div>
    <div class="es-desc"><code>HybridPerformanceMonitor(enable_rag=True)</code> 또는 <code>enable_deepeval=True</code>로 활성화</div>
  </div>

  <!-- RAG subsection -->
  <div x-show="data.has_rag">
    <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">📚 RAG 지표 (Ragas)</span><div class="sdiv-line"></div></div>
    <div x-data="{
      selK:null,
      meta:{
        faithfulness:{label:'Faithfulness',unit:'0-1',desc:'생성된 답변이 제공된 컨텍스트(검색 문서)에 얼마나 충실한지를 측정합니다. 1에 가까울수록 컨텍스트에 없는 정보를 지어내지 않으며, RAG 시스템에서 환각 방지의 핵심 지표입니다.',hint:'generated answer ∩ context / generated answer'},
        answer_relevancy:{label:'Answer Relevancy',unit:'0-1',desc:'생성된 답변이 원래 질문에 얼마나 관련성 있게 응답하는지를 나타냅니다. 검색 결과가 너무 넓거나 좁을 때 낮아지며, 질문의 핵심에서 벗어난 답변을 탐지하는 데 활용됩니다.',hint:'avg cosine sim(generated questions, original question)'},
        context_recall:{label:'Context Recall',unit:'0-1',desc:'정답(ground truth)에 포함된 정보가 검색된 컨텍스트에 얼마나 재현되어 있는지를 측정합니다. 낮으면 검색 단계에서 관련 문서를 놓치고 있음을 의미하며, 검색 품질 개선의 우선 지표입니다.',hint:'GT sentences supported by context / total GT sentences'},
        context_precision:{label:'Context Precision',unit:'0-1',desc:'검색된 컨텍스트 청크 중 실제로 답변 생성에 유용한 청크의 비율입니다. 낮으면 불필요한 문서가 많이 검색되어 노이즈가 발생하고 모델이 핵심 정보를 찾기 어려워집니다.',hint:'Σ(relevant chunks at k) / total chunks'},
        overall_score:{label:'Overall Score',unit:'0-1',desc:'Faithfulness, Answer Relevancy, Context Recall, Context Precision의 평균으로 RAG 시스템의 전반적 성능을 하나의 값으로 나타냅니다. 0.8 이상을 프로덕션 배포 기준으로 권장합니다.',hint:'avg(faithfulness, answer_relevancy, context_recall, context_precision)'},
      },
      rm(k,d){
        if(k==='overall_score'){
          const keys=['faithfulness','answer_relevancy','context_recall','context_precision'];
          const vals=keys.map(m=>this.rm(m,d)).filter(v=>v>0);
          return vals.length?vals.reduce((a,b)=>a+b,0)/vals.length:0;
        }
        const v=(d.rag_metrics||{})[k];return Array.isArray(v)&&v.length?v.reduce((a,b)=>a+b,0)/v.length:(v||0);
      },
      rmin(k,d){
        if(k==='overall_score') return null;
        const v=(d.rag_metrics||{})[k];
        if(Array.isArray(v)&&v.length) return Math.min(...v);
        const pt=(d.advanced?.per_task||[]).map(t=>t['ragas_'+k]).filter(v=>v!=null);
        return pt.length?Math.min(...pt):null;
      },
      rmax(k,d){
        if(k==='overall_score') return null;
        const v=(d.rag_metrics||{})[k];
        if(Array.isArray(v)&&v.length) return Math.max(...v);
        const pt=(d.advanced?.per_task||[]).map(t=>t['ragas_'+k]).filter(v=>v!=null);
        return pt.length?Math.max(...pt):null;
      },
      rsub(k,d){
        if(k==='overall_score'){
          const keys=['faithfulness','answer_relevancy','context_recall','context_precision'];
          const cnt=keys.filter(m=>(d.rag_metrics||{})[m]?.length||(d.advanced?.per_task||[]).some(t=>t['ragas_'+m]!=null)).length;
          const n=(d.advanced?.per_task||[]).filter(t=>t.ragas_faithfulness!=null).length;
          return n+'건 · '+cnt+'지표';
        }
        const mn=this.rmin(k,d);const mx=this.rmax(k,d);
        const n=((d.rag_metrics||{})[k]||[]).length||(d.advanced?.per_task||[]).filter(t=>t['ragas_'+k]!=null).length;
        if(mn==null) return '';
        return 'min '+mn.toFixed(2)+' / max '+mx.toFixed(2);
      },
      formula(k,d){
        if(k==='overall_score'){
          const keys=['faithfulness','answer_relevancy','context_recall','context_precision'];
          const vals=keys.map(m=>({k:m,v:this.rm(m,d)})).filter(x=>x.v>0);
          const avg=vals.length?vals.reduce((s,x)=>s+x.v,0)/vals.length:0;
          return `overall_score\n= avg(${vals.map(x=>x.k).join(', ')})\n= ${avg.toFixed(3)}\n목표: ≥ 0.8`;
        }
        return `${k}\n= ${this.rm(k,d).toFixed(3)}\n목표: ≥ 0.8`;
      },
      normRag(t){
        let raw; try{raw=JSON.parse(JSON.stringify(t));}catch(e){raw=t;}
        const vf=raw.ragas_faithfulness!=null?+raw.ragas_faithfulness:null;
        const va=raw.ragas_answer_relevancy!=null?+raw.ragas_answer_relevancy:null;
        const vr=raw.ragas_context_recall!=null?+raw.ragas_context_recall:null;
        const vp=raw.ragas_context_precision!=null?+raw.ragas_context_precision:null;
        const vals=[vf,va,vr,vp].filter(v=>v!==null);
        return {task_id:String(raw.task_id||''), vf:vf, va:va, vr:vr, vp:vp, vov:vals.length?vals.reduce((x,y)=>x+y,0)/vals.length:null};
      },
      items(k,d){
        const pt=(d.advanced?.per_task||[]);
        if(k==='overall_score'){
          return pt.map(t=>this.normRag(t)).filter(t=>t.vov!==null).sort((a,b)=>(b.vov||0)-(a.vov||0));
        }
        const keyMap={faithfulness:'vf',answer_relevancy:'va',context_recall:'vr',context_precision:'vp'};
        const prop=keyMap[k]||'vf';
        return pt.map(t=>this.normRag(t)).filter(t=>t[prop]!==null).sort((a,b)=>(b[prop]||0)-(a[prop]||0));
      },
      filterLabel(k){return k+' 내림차순';}
    }">
      <div class="kpi-grid">
        <div class="kpi kpi-act" :class="{sel:selK==='faithfulness'}" @click="selK=selK==='faithfulness'?null:'faithfulness'">
          <div class="kpi-lbl">Faithfulness</div>
          <div class="kpi-val" :style="`color:${_bc(rm('faithfulness',data)*100,70,50)}`"
               x-text="rm('faithfulness',data).toFixed(3)"></div>
          <div class="kpi-sub" style="color:var(--text2)" x-text="rsub('faithfulness',data)"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='answer_relevancy'}" @click="selK=selK==='answer_relevancy'?null:'answer_relevancy'">
          <div class="kpi-lbl">Ans. Relevancy</div>
          <div class="kpi-val" :style="`color:${_bc(rm('answer_relevancy',data)*100,70,50)}`"
               x-text="rm('answer_relevancy',data).toFixed(3)"></div>
          <div class="kpi-sub" style="color:var(--text2)" x-text="rsub('answer_relevancy',data)"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='context_recall'}" @click="selK=selK==='context_recall'?null:'context_recall'">
          <div class="kpi-lbl">Ctx. Recall</div>
          <div class="kpi-val" :style="`color:${_bc(rm('context_recall',data)*100,70,50)}`"
               x-text="rm('context_recall',data).toFixed(3)"></div>
          <div class="kpi-sub" style="color:var(--text2)" x-text="rsub('context_recall',data)"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='context_precision'}" @click="selK=selK==='context_precision'?null:'context_precision'">
          <div class="kpi-lbl">Ctx. Precision</div>
          <div class="kpi-val" :style="`color:${_bc(rm('context_precision',data)*100,70,50)}`"
               x-text="rm('context_precision',data).toFixed(3)"></div>
          <div class="kpi-sub" style="color:var(--text2)" x-text="rsub('context_precision',data)"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='overall_score'}" @click="selK=selK==='overall_score'?null:'overall_score'">
          <div class="kpi-lbl">Overall Score</div>
          <div class="kpi-val" :style="`color:${_bc(rm('overall_score',data)*100,70,50)}`"
               x-text="rm('overall_score',data).toFixed(3)"></div>
          <div class="kpi-sub" style="color:var(--text2)" x-text="rsub('overall_score',data)"></div>
        </div>
      </div>
      <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
        <template x-if="selK">
          <div>
            <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
              <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
              <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="meta[selK]?.unit?'범위: '+meta[selK].unit:''"></span>
              <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
              <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
