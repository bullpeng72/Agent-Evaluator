  <div x-show="data.has_workflow">
    <div x-data="{
      selK:null,
      meta:{
        total_steps:{label:'Total Steps',unit:'',desc:'Total number of steps completed across all workflow executions. Reflects the complexity and granularity of agent operations; assess workflow health together with step success rate.',hint:'workflow_summary.total_steps'},
        success_steps:{label:'Successful Steps',unit:'',desc:'Number of workflow steps that completed successfully. Failed steps can have cascading effects on subsequent steps; identifying which steps fail most often helps prioritize improvements.',hint:'workflow_summary.successful_steps'},
        step_rate:{label:'Step Success Rate',unit:'%',desc:'Percentage of workflow steps completed successfully. Reflects overall workflow stability; low values suggest repeated failures at specific step types or positions.',hint:'successful_steps / total_steps × 100'},
        wf_tasks:{label:'Workflow Tasks',unit:'',desc:'Number of tasks for which workflow execution data was recorded. Only measured for tasks with WorkflowExecutionTracker active; compare to total tasks to see workflow adoption rate.',hint:'workflow_summary.total_tasks'},
        task_rate:{label:'Task Completion Rate',unit:'%',desc:'Percentage of tasks that completed the entire workflow successfully. Even with high step success rates, full workflow completion is tracked separately — use this metric to evaluate end-goal achievement.',hint:'workflow_summary.task_success_rate'},
      },
      formula(k,d){
        const ws=d.agentic?.workflow_summary||{};
        const tot=ws.total_steps||0;
        const suc=ws.successful_steps||0;
        const wfN=(d.agentic?.workflow_executions||[]).length;
        if(k==='total_steps')return `Total steps = ${tot}\nSuccess: ${suc} / Failed: ${tot-suc}\n(workflow_executions record count)`;
        if(k==='success_steps')return `Successful steps = ${suc}\n= total(${tot}) − failed(${tot-suc})`;
        if(k==='step_rate')return `Step Success Rate = successful_steps / total_steps × 100\n= ${suc} / ${tot} × 100\n= ${(ws.step_success_rate||0).toFixed(1)}%`;
        if(k==='wf_tasks')return `Workflow tasks = ${ws.total_tasks||0}\n(unique tasks by task_id)\nTotal step records: ${wfN}`;
        if(k==='task_rate')return `Task Completion Rate = fully_successful_tasks / total_tasks × 100\n= ${ws.fully_successful_tasks||0} / ${ws.total_tasks||0} × 100\n= ${(ws.task_success_rate||0).toFixed(1)}%\n(only tasks with all steps successful)`;
        return '';
      },
      items(k,d){ return d.agentic?.workflow_executions||[]; },
      filterLabel(k){return 'All workflow executions';}
    }">
      <div class="kpi-grid">
        <div class="kpi kpi-act" :class="{sel:selK==='total_steps'}" @click="selK=selK==='total_steps'?null:'total_steps'">
