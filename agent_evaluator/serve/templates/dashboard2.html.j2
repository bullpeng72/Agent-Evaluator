              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,$root.data).length+'건'"></span>
            </div>
            <div class="dtx" style="max-height:200px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:1fr 50px 60px 60px;position:sticky;top:0;z-index:1">
