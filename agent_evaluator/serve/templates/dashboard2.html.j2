  <!-- DeepEval subsection -->
  <div x-show="data.has_advanced">
    <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔬 DeepEval 지표</span><div class="sdiv-line"></div></div>
    <div x-data="{
      selK:null,
      deKeys:['g_eval_score','hallucination_score','toxicity_score','bias_score','answer_relevancy_score'],
      deLabels:{g_eval_score:'G-Eval',hallucination_score:'Hallucination',toxicity_score:'Toxicity',bias_score:'Bias',answer_relevancy_score:'Ans. Relevancy'},
      meta:{
        g_eval_score:{label:'G-Eval Score',unit:'0-1',desc:'LLM 자신이 판사(judge) 역할을 하여 평가하는 종합 품질 점수입니다. 규칙 기반으로 포착하기 어려운 논리적 일관성, 문맥 이해, 전반적 적절성을 인간 평가와 유사한 방식으로 측정합니다.',hint:'GPT 기반 평가, 문맥·논리·일관성 종합'},
        hallucination_score:{label:'Hallucination',unit:'0-1',desc:'DeepEval의 환각 탐지 점수입니다. 0에 가까울수록 사실적 오류와 컨텍스트 불일치가 적음을 의미하며, Agent-Evaluator 내장 환각 탐지기와 상호 보완적으로 활용할 수 있습니다.',hint:'사실적 오류 및 컨텍스트 불일치 탐지'},
        toxicity_score:{label:'Toxicity',unit:'0-1',desc:'응답에 포함된 유해·공격적·혐오적 콘텐츠의 정도를 나타냅니다. 0에 가까울수록 안전한 응답이며, 공개 서비스 배포 전 반드시 낮은 수준으로 유지해야 합니다.',hint:'혐오·공격성·해로운 콘텐츠 감지'},
        bias_score:{label:'Bias',unit:'0-1',desc:'응답에 성별, 인종, 정치 등의 편향이 포함된 정도를 측정합니다. 0에 가까울수록 중립적이고 균형 있는 응답이며, 다양한 사용자에게 공정한 서비스를 제공하기 위한 필수 점검 항목입니다.',hint:'성별·인종·정치적 편향 탐지'},
        answer_relevancy_score:{label:'Ans. Relevancy',unit:'0-1',desc:'DeepEval이 평가하는 답변 관련성 점수입니다. 질문의 의도와 답변 내용이 의미적으로 얼마나 일치하는지를 임베딩 기반으로 측정하며, Ragas의 Answer Relevancy와 상호 검증에 활용할 수 있습니다.',hint:'질문과 답변의 의미적 유사도'},
      },
      formula(k,d){
        const s=d.advanced?.summary||{};
        const v=s[k];
        if(!v)return `${k}: 데이터 없음`;
        return `${k}\n평균: ${(v.mean||0).toFixed(3)}\n최소: ${(v.min||0).toFixed(3)}\n최대: ${(v.max||0).toFixed(3)}`;
      },
      items(k,d){
        const taskMap={};(d.tasks||[]).forEach(t=>{taskMap[t.task_id]=t;});
        return [...(d.advanced?.per_task||[])].filter(t=>t[k]!=null).sort((a,b)=>(b[k]||0)-(a[k]||0))
          .map(t=>({...t, completion_score:(taskMap[t.task_id]||{}).completion_score??null, success:(taskMap[t.task_id]||{}).success??null}));
      },
      filterLabel(k){return k+' 내림차순';}
    }">
      <div class="kpi-grid">
        <template x-for="k in deKeys" :key="k">
          <div class="kpi kpi-act" :class="{sel:selK===k}" @click="selK=selK===k?null:k"
               x-show="data.advanced?.summary?.[k]!=null">
            <div class="kpi-lbl" x-text="deLabels[k]||k"></div>
            <div class="kpi-val" :style="`color:${_bc((data.advanced?.summary?.[k]?.mean||0)*100,70,50)}`"
                 x-text="(data.advanced?.summary?.[k]?.mean||0).toFixed(3)"></div>
            <div class="kpi-sub" style="color:var(--text2)"
                 x-text="`min ${(data.advanced?.summary?.[k]?.min||0).toFixed(2)} / max ${(data.advanced?.summary?.[k]?.max||0).toFixed(2)}`"></div>
          </div>
        </template>
      </div>
      <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
        <template x-if="selK">
          <div>
            <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
              <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
              <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
              <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
                <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
                <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
              </div>
              <div style="padding:10px 14px;background:var(--bg3)">
                <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 통계</div>
                <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
              </div>
            </div>
            <div style="padding:10px 14px;background:var(--bg)">
              <div class="dtx" style="max-height:220px;overflow-y:auto">
                <div class="dtx-row dtx-head" style="grid-template-columns:minmax(120px,1fr) 110px 80px;position:sticky;top:0;z-index:1">
                  <span>태스크 ID</span>
                  <span x-text="meta[selK]?.label||'지표'"></span>
                  <span>Task 완료율</span>
                </div>
                <template x-for="t in items(selK,data)" :key="t.task_id">
                  <div class="dtx-row" style="grid-template-columns:minmax(120px,1fr) 110px 80px">
                    <span class="dtx-id" x-text="t.task_id"></span>
                    <span :style="`color:${_bc((t[selK]||0)*100,70,50)}`" x-text="(t[selK]||0).toFixed(3)"></span>
                    <span x-text="t.completion_score!=null?((t.completion_score||0)*100).toFixed(0)+'%':'-'"></span>
                  </div>
                </template>
              </div>
            </div>
          </div>
        </template>
      </div>
      <div style="margin-top:8px;display:flex;flex-direction:column;gap:8px">
        <div class="cbox"><div class="ct">DeepEval 지표 요약</div><div id="d2-ex-de-bar" class="plt-chart"></div></div>
        <div class="cbox"><div class="ct">DeepEval 지표 × 태스크 히트맵</div><div id="d2-ex-de-hist" style="min-height:200px;width:100%"></div></div>
      </div>
    </div>
  </div>

</div><!-- /external -->

<!-- ══ SECTION 4: PERFORMANCE ══ -->
<div x-show="data && sec==='performance'" x-cloak>

  <!-- Latency subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">⏱ 지연 시간</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      mean:{label:'평균',unit:'s',desc:'전체 태스크의 평균 응답 시간입니다. 전반적인 성능 수준을 나타내지만, 극단적으로 느린 태스크(이상치)에 의해 높아질 수 있어 P50·P95와 함께 해석해야 합니다.',hint:'avg(execution_time)'},
      p50:{label:'P50 (중앙값)',unit:'s',desc:'응답 시간의 중앙값으로, 태스크의 절반은 이 시간보다 빠르게 완료됩니다. 극단값의 영향을 받지 않아 에이전트의 일반적인 응답 속도를 가장 잘 나타내는 지표입니다.',hint:'median(execution_time)'},
      p90:{label:'P90',unit:'s',desc:'전체 태스크의 90%가 이 시간 내에 완료됩니다. 대부분의 사용자가 경험하는 응답 속도를 나타내며, 일반 서비스 SLA 기준으로 자주 활용됩니다.',hint:'90th percentile(execution_time)'},
      p95:{label:'P95',unit:'s',desc:'전체 태스크의 95%가 이 시간 내에 완료됩니다. SLA(서비스 수준 협약) 설계에 가장 널리 사용되는 기준값으로, 극소수 이상치를 제외한 실질적인 최악 응답 시간을 나타냅니다.',hint:'95th percentile(execution_time)'},
      p99:{label:'P99',unit:'s',desc:'전체 태스크의 99%가 이 시간 내에 완료됩니다. 거의 모든 사용자가 경험하는 최대 응답 시간을 나타내며, 고가용성·고신뢰성이 요구되는 서비스의 SLA 기준으로 사용됩니다.',hint:'99th percentile(execution_time)'},
      maximum:{label:'최대',unit:'s',desc:'기록된 가장 느린 태스크의 응답 시간입니다. 타임아웃 설정이나 최악의 시나리오 설계에 활용되며, 이 수치가 비정상적으로 높으면 특정 태스크 유형에서 성능 병목이 발생함을 시사합니다.',hint:'max(execution_time)'},
      stddev:{label:'표준편차',unit:'s',desc:'응답 시간의 분산 정도입니다. 낮을수록 모든 태스크에서 일정한 응답 속도를 유지함을 의미하며, 사용자 경험의 예측 가능성을 나타냅니다. 높으면 일부 태스크에서만 성능이 크게 저하되고 있음을 나타냅니다.',hint:'std(execution_time)'},
    },
    formula(k,d){
      const lat=(d.efficiency_metrics||{}).latency||{};
      const p90=_latPct((d.tasks||[]).map(t=>t.execution_time),90);
      if(k==='mean')return `avg(execution_time)\n= ${_sec(lat.mean||0)}\n\n전체 ${d.total_tasks||0}건의 산술평균`;
      if(k==='p50')return `median(execution_time)\n= ${_sec(lat.p50||0)}\n\n정렬된 배열의 50번째 백분위\nnp.percentile(times, 50, method='linear')`;
      if(k==='p90')return `np.percentile(times, 90, method='linear')\n= ${_sec(p90)}\n\n※ LatencyTracker 미수집 항목\n  → tasks[].execution_time 에서 직접 계산`;
      if(k==='p95')return `np.percentile(times, 95, method='linear')\n= ${_sec(lat.p95||0)}\n\nSLA 설계 기준으로 가장 널리 활용`;
      if(k==='p99')return `np.percentile(times, 99, method='linear')\n= ${_sec(lat.p99||0)}\n\n거의 모든 사용자가 경험하는 최대 응답 시간`;
      if(k==='maximum')return `max(execution_time)\n= ${_sec(lat.max||0)}\n\n기록된 가장 느린 단일 태스크`;
      if(k==='stddev')return `std(execution_time)\n= ${_sec(lat.std||0)}\n\n응답 시간의 일관성 지표\n낮을수록 예측 가능한 응답 속도`;
      return '';
    },
    items(k,d){
      const t=d.tasks||[];
      if(k==='maximum'||k==='p99'||k==='p95'||k==='p90')return [...t].sort((a,b)=>(b.execution_time||0)-(a.execution_time||0)).slice(0,15);
      return [...t].sort((a,b)=>(a.execution_time||0)-(b.execution_time||0)).slice(0,15);
    },
    filterLabel(k){return ['maximum','p99','p95','p90'].includes(k)?'느린 태스크 Top15':'빠른 태스크 Top15';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='mean'}" @click="selK=selK==='mean'?null:'mean'">
        <div class="kpi-lbl">평균</div>
        <div class="kpi-val" x-text="_sec(data.efficiency_metrics?.latency?.mean||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='p50'}" @click="selK=selK==='p50'?null:'p50'">
        <div class="kpi-lbl">P50</div>
        <div class="kpi-val" x-text="_sec(data.efficiency_metrics?.latency?.p50||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='p90'}" @click="selK=selK==='p90'?null:'p90'">
        <div class="kpi-lbl">P90</div>
        <div class="kpi-val" :style="`color:${_bc2lat(_latPct((data.tasks||[]).map(t=>t.execution_time),90))}`"
             x-text="_sec(_latPct((data.tasks||[]).map(t=>t.execution_time),90))"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='p95'}" @click="selK=selK==='p95'?null:'p95'">
        <div class="kpi-lbl">P95</div>
        <div class="kpi-val" :style="`color:${_bc2lat(data.efficiency_metrics?.latency?.p95||0)}`"
             x-text="_sec(data.efficiency_metrics?.latency?.p95||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='p99'}" @click="selK=selK==='p99'?null:'p99'">
        <div class="kpi-lbl">P99</div>
        <div class="kpi-val" :style="`color:${_bc2lat(data.efficiency_metrics?.latency?.p99||0)}`"
             x-text="_sec(data.efficiency_metrics?.latency?.p99||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='maximum'}" @click="selK=selK==='maximum'?null:'maximum'">
        <div class="kpi-lbl">최대</div>
        <div class="kpi-val" x-text="_sec(data.efficiency_metrics?.latency?.max||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='stddev'}" @click="selK=selK==='stddev'?null:'stddev'">
        <div class="kpi-lbl">표준편차</div>
        <div class="kpi-val" x-text="_sec(data.efficiency_metrics?.latency?.std||0)"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="meta[selK]?.unit?'단위: '+meta[selK].unit:''"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
              <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <div style="padding:10px 14px;background:var(--bg)">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">관련 태스크</span>
              <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="filterLabel(selK)"></span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,data).length+'건'"></span>
            </div>
            <div class="dtx" style="max-height:220px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:170px minmax(0,1fr) 72px 56px;position:sticky;top:0;z-index:1">
                <span>태스크 ID</span><span>유형</span><span>지연(s)</span><span>완료</span>
              </div>
              <template x-for="t in items(selK,data)" :key="t.task_id">
                <div class="dtx-row" style="grid-template-columns:170px minmax(0,1fr) 72px 56px">
                  <span class="dtx-id" x-text="t.task_id"></span>
                  <span style="font-size:11px;color:var(--text2)" x-text="t.task_type||'-'"></span>
                  <span :style="`color:${_bc2lat(t.execution_time||0)}`" x-text="_sec(t.execution_time||0)"></span>
                  <span :class="t.success?'badge-ok':'badge-ng'" x-text="t.success?'✓':'✗'"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cg3" style="margin-top:8px">
      <div class="cbox"><div class="ct">백분위 지연 시간</div><div id="d2-p-lat-bar" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">지연 분포 히스토그램</div><div id="d2-p-lat-hist" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">태스크별 지연</div><div id="d2-p-lat-task" class="plt-chart"></div></div>
    </div>
    <div class="sec" style="margin-top:12px">
      <div class="sec-t">느린 태스크 (상위 10)</div>
      <div class="dtx">
        <div class="dtx-row dtx-head" style="grid-template-columns:170px minmax(0,1fr) 72px 56px;position:sticky;top:0;z-index:1">
          <span>태스크 ID</span><span>유형</span><span>지연(s)</span><span>완료</span>
        </div>
        <template x-for="t in slowTasks(10)" :key="t.task_id">
          <div class="dtx-row" style="grid-template-columns:170px minmax(0,1fr) 72px 56px">
            <span class="dtx-id" x-text="t.task_id"></span>
            <span style="font-size:11px;color:var(--text2)" x-text="t.task_type||'-'"></span>
            <span :style="`color:${_bc2lat(t.execution_time||0)}`" x-text="_sec(t.execution_time||0)"></span>
            <span :class="t.success?'badge-ok':'badge-ng'" x-text="t.success?'✓':'✗'"></span>
          </div>
        </template>
      </div>
    </div>
  </div>

  <!-- Token Economy subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🪙 토큰 경제</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      total:{label:'총 토큰',unit:'tokens',desc:'이번 평가 전체에서 소비된 LLM 토큰의 총량입니다. 인프라 비용과 직결되는 핵심 효율 지표이며, 프롬프트 설계 및 컨텍스트 관리 최적화의 기준으로 활용됩니다.',hint:'Σ(input_tokens + output_tokens)'},
      input:{label:'Input 토큰',unit:'tokens',desc:'프롬프트·시스템 지시문·컨텍스트 등 입력으로 소비된 토큰 수입니다. 불필요하게 긴 프롬프트나 과도한 컨텍스트 주입을 식별하고, 입출력 비율로 프롬프트 효율성을 평가하는 데 활용됩니다.',hint:'Σ input_tokens'},
      output:{label:'Output 토큰',unit:'tokens',desc:'에이전트가 생성한 응답의 토큰 수입니다. 응답 길이의 경향성을 파악하고 불필요하게 장황한 출력을 탐지하는 데 활용됩니다. 입력 대비 비율이 높으면 출력이 상대적으로 긴 경향을 의미합니다.',hint:'Σ output_tokens'},
      avg_per_task:{label:'태스크당 평균',unit:'tokens',desc:'태스크 1건을 처리하는 데 평균적으로 소모되는 토큰 수입니다. 비용 예측의 핵심 단위이며, 태스크 유형별로 비교하면 토큰을 많이 소모하는 복잡한 태스크를 식별할 수 있습니다.',hint:'total_tokens / total_tasks'},
      io_ratio:{label:'입출력 비율',unit:'%',desc:'입력 토큰 대비 출력 토큰의 비율입니다. 과도하게 높으면 불필요하게 장황한 응답일 가능성이 있고, 너무 낮으면 응답이 지나치게 간결할 수 있습니다. 최적 비율은 태스크 유형에 따라 다릅니다.',hint:'output_tokens / input_tokens × 100'},
    },
    formula(k,d){
      const tok=(d.efficiency_metrics||{}).tokens||{};
      const tot=tok.total_tokens||0;
      const inp=tok.total_input_tokens||0;
      const out=tok.total_output_tokens||0;
      const n=d.total_tasks||1;
      const avg=tok.avg_tokens_per_task||Math.round(tot/n)||0;
      if(k==='total')return `Σ(input_tokens + output_tokens)\n= ${_fmtNumG(inp)} + ${_fmtNumG(out)}\n= ${_fmtNumG(tot)}`;
      if(k==='input')return `Σ input_tokens = ${_fmtNumG(inp)}\n전체의 ${tot?((inp/tot)*100).toFixed(1):0}%\n(token_distribution.input_ratio)`;
      if(k==='output')return `Σ output_tokens = ${_fmtNumG(out)}\n전체의 ${tot?((out/tot)*100).toFixed(1):0}%\n(token_distribution.output_ratio)`;
      if(k==='avg_per_task')return `avg_tokens_per_task\n= ${_fmtNumG(tot)} / ${n}건\n= ${_fmtNumG(Math.round(avg))}`;
      if(k==='io_ratio')return `output_tokens / input_tokens × 100\n= ${_fmtNumG(out)} / ${_fmtNumG(inp)}\n= ${inp?((out/inp)*100).toFixed(1):0}%`;
      return '';
    },
    items(k,d){
      return [...(d.tasks||[])].sort((a,b)=>{
        const at=(a.tokens_used?.total||a.tokens_used||0);
        const bt=(b.tokens_used?.total||b.tokens_used||0);
        return bt-at;
      }).slice(0,20);
    },
    filterLabel(k){return '토큰 많은 태스크 Top20';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='total'}" @click="selK=selK==='total'?null:'total'">
        <div class="kpi-lbl">총 토큰</div>
        <div class="kpi-val" style="font-size:20px" x-text="_fmtNumG(data.efficiency_metrics?.tokens?.total_tokens||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='input'}" @click="selK=selK==='input'?null:'input'">
        <div class="kpi-lbl">Input 토큰</div>
        <div class="kpi-val" style="font-size:20px" x-text="_fmtNumG(data.efficiency_metrics?.tokens?.total_input_tokens||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='output'}" @click="selK=selK==='output'?null:'output'">
        <div class="kpi-lbl">Output 토큰</div>
        <div class="kpi-val" style="font-size:20px" x-text="_fmtNumG(data.efficiency_metrics?.tokens?.total_output_tokens||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='avg_per_task'}" @click="selK=selK==='avg_per_task'?null:'avg_per_task'">
        <div class="kpi-lbl">태스크당 평균</div>
        <div class="kpi-val" style="font-size:20px" x-text="_fmtNumG(Math.round(data.efficiency_metrics?.tokens?.avg_tokens_per_task||(data.efficiency_metrics?.tokens?.total_tokens||0)/(data.total_tasks||1)))"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='io_ratio'}" @click="selK=selK==='io_ratio'?null:'io_ratio'">
        <div class="kpi-lbl">입출력 비율</div>
        <div class="kpi-val" style="font-size:20px" x-text="(data.efficiency_metrics?.tokens?.total_input_tokens||0)>0?((data.efficiency_metrics?.tokens?.total_output_tokens||0)/(data.efficiency_metrics?.tokens?.total_input_tokens||1)*100).toFixed(0)+'%':((data.efficiency_metrics?.tokens?.token_distribution?.output_ratio||0)*100).toFixed(0)+'%'||'-'"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
              <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <div style="padding:10px 14px;background:var(--bg)">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">토큰 많은 태스크</span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,data).length+'건'"></span>
            </div>
            <div class="dtx" style="max-height:200px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:150px 72px 72px 72px minmax(0,1fr) 64px;position:sticky;top:0;z-index:1">
                <span>태스크 ID</span><span>총</span><span style="color:#6366f1">입력</span><span style="color:#06b6d4">출력</span><span>유형</span><span>완료율</span>
              </div>
              <template x-for="t in items(selK,data)" :key="t.task_id">
                <div class="dtx-row" style="grid-template-columns:150px 72px 72px 72px minmax(0,1fr) 64px">
                  <span class="dtx-id" x-text="t.task_id"></span>
                  <span x-text="_fmtNumG((typeof t.tokens_used==='object'&&t.tokens_used)?(t.tokens_used.total||(t.tokens_used.input||t.tokens_used.input_tokens||0)+(t.tokens_used.output||t.tokens_used.output_tokens||0)):t.tokens_used||0)"></span>
                  <span style="color:#6366f1" x-text="_fmtNumG((typeof t.tokens_used==='object'&&t.tokens_used)?(t.tokens_used.input||t.tokens_used.input_tokens||0):0)"></span>
                  <span style="color:#06b6d4" x-text="_fmtNumG((typeof t.tokens_used==='object'&&t.tokens_used)?(t.tokens_used.output||t.tokens_used.output_tokens||0):0)"></span>
                  <span style="font-size:11px;color:var(--text2)" x-text="t.task_type||'-'"></span>
                  <span :style="`color:${(t.completion_score||0)>=1?'var(--green)':(t.completion_score||0)>=0.7?'var(--yellow)':'var(--red)'}`"
                        x-text="((t.completion_score||0)*100).toFixed(0)+'%'"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cg3" style="margin-top:8px">
      <div class="cbox"><div class="ct">태스크별 토큰</div><div id="d2-p-tok-bar" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">입출력 비율</div><div id="d2-p-tok-ratio" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">토큰 분포</div><div id="d2-p-tok-hist" class="plt-chart"></div></div>
    </div>
  </div>

  <!-- Cost subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">💰 비용 분석</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK: null,
    meta:{
      total_cost:{label:'총 비용',unit:'$',desc:'이번 평가에서 발생한 LLM API 사용 비용의 추정값입니다. 적용 모델을 선택하면 해당 모델의 단가로 재산출됩니다.',hint:'Σ(input_tokens × inp_price + output_tokens × out_price) / 1M'},
      p50_cost:{label:'P50 비용',unit:'$',desc:'태스크 비용 분포의 중앙값입니다. 절반의 태스크는 이 비용 이하로 처리됩니다. 평균보다 이상치 영향을 덜 받아 일반적인 태스크 비용을 더 잘 반영합니다.',hint:'50th percentile(task_cost)'},
      p95_cost:{label:'P95 비용',unit:'$',desc:'전체 태스크의 95%가 이 비용 이하로 처리됩니다. 비용 이상치 탐지 및 SLA 비용 상한선 설계 기준으로 활용합니다.',hint:'95th percentile(task_cost)'},
      avg_cost:{label:'태스크당 평균',unit:'$',desc:'태스크 1건을 처리하는 평균 비용입니다. 서비스 확장 시 비용 예측의 기준값이며, 모델 교체·프롬프트 최적화 효과를 수치로 확인하는 핵심 단위입니다.',hint:'total_cost / total_tasks'},
      monthly_est:{label:'×1K 추정',unit:'$',desc:'현재 평균 태스크 비용으로 1,000건을 처리할 경우의 추정 비용입니다. 할인·캐싱·배치 처리 등에 따라 실제 청구액은 달라질 수 있습니다.',hint:'avg_cost_per_task × 1000'},
    },
    formula(k,d){
      const m=selModel;
      const tot=cTotal(d), avg=cAvg(d), p50=cP50(d), p95=cP95(d);
      const em=d?.efficiency_metrics||{};
      const iTok=em.tokens?.total_input_tokens||0, oTok=em.tokens?.total_output_tokens||0;
      const src=m?`적용 모델: ${m.model}\n입력 $${m.inp}/1M × 출력 $${m.out}/1M`:'JSON 저장 단가 사용';
      if(k==='total_cost') return `${src}\nΣ(inp×${m?m.inp+'$':'-'} + out×${m?m.out+'$':'-'}) / 1M\n= $${tot.toFixed(6)}\n\n입력 ${_fmtNumG(iTok)} + 출력 ${_fmtNumG(oTok)} 토큰`;
      if(k==='p50_cost')   return `${src}\n50th percentile(task_cost)\n= $${p50.toFixed(6)}\n\n절반의 태스크가 이 비용 이하`;
      if(k==='p95_cost')   return `${src}\n95th percentile(task_cost)\n= $${p95.toFixed(6)}\n\nSLA 비용 상한 설계 기준`;
      if(k==='avg_cost')   return `${src}\ntotal_cost / tasks\n= $${tot.toFixed(6)} / ${d?.total_tasks||1}건\n= $${avg.toFixed(6)}`;
      if(k==='monthly_est')return `${src}\navg_cost × 1,000건\n= $${avg.toFixed(6)} × 1000\n= $${(avg*1000).toFixed(4)}`;
      return '';
    },
    items(k,d){ return [...(d?.tasks||[])].sort((a,b)=>(b.tokens_used?.total||0)-(a.tokens_used?.total||0)).slice(0,20); },
    filterLabel(k){ return '토큰 많은 태스크 Top20'; },
  }">

    <!-- KPI 카드 — 전역 selModel 반영 -->
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='total_cost'}" @click="selK=selK==='total_cost'?null:'total_cost'">
        <div class="kpi-lbl">총 비용</div>
        <div class="kpi-val" x-text="_fmtCostG(cTotal(data))"></div>
        <div class="kpi-sub" x-show="selModel" style="color:var(--accent);font-size:10px" x-text="selModel?.model?.split('/')[0]?.trim()||''"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='p50_cost'}" @click="selK=selK==='p50_cost'?null:'p50_cost'">
        <div class="kpi-lbl">P50 비용</div>
        <div class="kpi-val" x-text="_fmtCostG(cP50(data))"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='p95_cost'}" @click="selK=selK==='p95_cost'?null:'p95_cost'">
        <div class="kpi-lbl">P95 비용</div>
        <div class="kpi-val" x-text="_fmtCostG(cP95(data))"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='avg_cost'}" @click="selK=selK==='avg_cost'?null:'avg_cost'">
        <div class="kpi-lbl">태스크당 평균</div>
        <div class="kpi-val" x-text="_fmtCostG(cAvg(data))"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='monthly_est'}" @click="selK=selK==='monthly_est'?null:'monthly_est'">
        <div class="kpi-lbl">×1K 추정</div>
        <div class="kpi-val" x-text="_fmtCostG(cAvg(data)*1000)"></div>
      </div>
    </div>

    <!-- KPI 상세 패널 -->
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
              <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
        </div>
      </template>
    </div>

    <div class="cbox" style="margin-top:8px">
      <div class="ct">태스크별 비용 (토큰 비례 추정)</div>
      <div id="d2-p-cost-bar" class="plt-chart"></div>
    </div>

    <!-- ② 모델 가격표 + Agent 적용 모델 선택 -->
    <div class="sec" style="margin-top:12px">
      <!-- 헤더 -->
      <div class="sec-t" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
        <span>모델별 가격 정보</span>
        <span style="font-size:11px;color:var(--text2);font-weight:400">($/1M 토큰 기준)</span>
        <!-- 선택된 모델 배지 -->
        <span x-show="selModel"
              style="font-size:11px;padding:2px 10px;border-radius:99px;background:rgba(16,185,129,0.15);color:#10b981;font-weight:700;display:flex;align-items:center;gap:4px">
          ✓ <span x-text="selModel?.model?.split('/')[0]?.trim()"></span> 적용 중
          <span style="font-size:10px;opacity:0.75;font-weight:400">· 재실행 후에도 유지</span>
          <button @click="clearModel()"
                  style="background:transparent;border:none;color:#10b981;cursor:pointer;font-size:14px;line-height:1;padding:0 0 0 2px">×</button>
        </span>
        <span x-show="!selModel" style="font-size:11px;color:var(--text2)">— 모델 선택 시 전체 비용 재산출 (선택값 재실행 후에도 유지)</span>
        <div style="margin-left:auto;display:flex;gap:6px">
          <button x-show="pEd" @click="pAdd()"
                  style="padding:3px 10px;border-radius:5px;border:1px solid #10b981;background:transparent;color:#10b981;font-size:12px;cursor:pointer">+ 행 추가</button>
          <button @click="togglePEd()"
                  style="padding:3px 10px;border-radius:5px;border:1px solid var(--accent);background:transparent;color:var(--accent);font-size:12px;cursor:pointer"
                  x-text="pEd?'✓ 완료':'✏ 편집'"></button>
        </div>
      </div>

      <!-- 가격표 -->
      <div class="dtx" style="margin-top:8px">
        <div class="dtx-row dtx-head"
             :style="pEd ? 'grid-template-columns:1fr 90px 90px 70px 36px'
                         : 'grid-template-columns:1fr 90px 90px 70px'">
          <span>모델</span><span>입력($/1M)</span><span>출력($/1M)</span><span>Agent 적용</span>
          <span x-show="pEd"></span>
        </div>
        <template x-for="(row,idx) in pRows" :key="idx">
          <div class="dtx-row"
               :style="selModel?.model===row.model
                 ? (pEd ? 'grid-template-columns:1fr 90px 90px 70px 36px;align-items:center;background:rgba(16,185,129,0.06);border-left:3px solid #10b981;padding-left:9px'
                        : 'grid-template-columns:1fr 90px 90px 70px;background:rgba(16,185,129,0.06);border-left:3px solid #10b981;padding-left:9px')
                 : (pEd ? 'grid-template-columns:1fr 90px 90px 70px 36px;align-items:center'
                        : 'grid-template-columns:1fr 90px 90px 70px')">
            <!-- 보기 모드 -->
            <span x-show="!pEd" class="dtx-id">
              <span x-text="row.model||'-'"></span>
            </span>
            <span x-show="!pEd"
                  :style="selModel?.model===row.model ? 'font-weight:700;color:#10b981' : ''"
                  x-text="'$'+(row.inp??0).toFixed(3)"></span>
            <span x-show="!pEd"
                  :style="selModel?.model===row.model ? 'font-weight:700;color:#10b981' : ''"
                  x-text="'$'+(row.out??0).toFixed(3)"></span>
            <!-- 선택 버튼 -->
            <span x-show="!pEd" style="display:flex;justify-content:center">
              <button @click="pickModel(row)"
                      :style="selModel?.model===row.model
                        ? 'padding:2px 10px;border-radius:5px;border:1px solid #10b981;background:rgba(16,185,129,0.15);color:#10b981;font-size:11px;font-weight:700;cursor:pointer'
                        : 'padding:2px 10px;border-radius:5px;border:1px solid var(--border);background:transparent;color:var(--text2);font-size:11px;cursor:pointer'"
                      x-text="selModel?.model===row.model ? '✓ 적용됨' : '선택'"></button>
            </span>
            <!-- 편집 모드 -->
            <input x-show="pEd" :value="row.model" @input="pRowSet(idx,'model',$event.target.value)"
                   style="background:var(--bg3);border:1px solid var(--border);border-radius:4px;padding:2px 6px;color:var(--text);font-size:12px;width:100%;box-sizing:border-box">
            <input x-show="pEd" type="number" :value="row.inp" @input="pRowSet(idx,'inp',$event.target.value)"
                   step="0.001" min="0" style="background:var(--bg3);border:1px solid var(--border);border-radius:4px;padding:2px 6px;color:var(--text);font-size:12px;width:80px">
            <input x-show="pEd" type="number" :value="row.out" @input="pRowSet(idx,'out',$event.target.value)"
                   step="0.001" min="0" style="background:var(--bg3);border:1px solid var(--border);border-radius:4px;padding:2px 6px;color:var(--text);font-size:12px;width:80px">
            <span x-show="pEd"></span>
            <button x-show="pEd" @click="pDel(idx)"
                    style="background:transparent;border:none;color:#f87171;font-size:16px;cursor:pointer;line-height:1">×</button>
          </div>
        </template>
      </div>

      <!-- 현재 비용 산출 기준 안내 -->
      <div style="margin-top:10px;padding:8px 12px;background:var(--bg3);border-radius:6px;font-size:11.5px;color:var(--text2);display:flex;align-items:center;gap:8px;flex-wrap:wrap">
        <span>📐 비용 산출 기준 (전체 대시보드):</span>
        <span x-show="selModel" style="color:#10b981;font-weight:600"
              x-text="selModel ? selModel.model.split('/')[0].trim()+' — 입력 $'+selModel.inp+'/1M · 출력 $'+selModel.out+'/1M (raw 토큰 재산출)' : ''"></span>
        <span x-show="!selModel" style="color:var(--text2)">평가 실행 시 저장된 JSON 비용값 (모델 선택 시 개요·배포게이트·인사이트·레이더 전체 반영)</span>
      </div>
    </div>
  </div>

</div><!-- /performance -->

<!-- ══ SECTION 5: AGENTIC ══ -->
<div x-show="data && sec==='agentic'" x-cloak>
  <div x-show="!data.has_agentic" class="es">
    <div class="es-icon">🤖</div>
    <div class="es-title">에이전틱 지표 없음</div>
    <div class="es-desc"><code>PerformanceMonitor(enable_agentic=True)</code>으로 활성화하세요.</div>
  </div>
  <div x-show="data.has_agentic">

  <!-- Tool Efficiency subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔧 도구 효율성</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      total_calls:{label:'총 호출',unit:'건',desc:'이번 평가에서 에이전트가 실행한 전체 도구 호출 수입니다. 도구 사용 빈도와 에이전트의 도구 의존도를 파악하는 기본 지표이며, 태스크당 평균 호출 수와 함께 해석해야 합니다.',hint:'tool_efficiency.total_calls'},
      success_rate:{label:'성공률',unit:'%',desc:'실행된 도구 호출 중 정상적으로 결과를 반환한 비율입니다. 낮으면 도구 설정 문제, 잘못된 파라미터 사용, 또는 에이전트의 도구 사용 오류가 많음을 시사합니다.',hint:'(total_calls − failed_calls) / total_calls × 100'},
      avg_efficiency:{label:'평균 효율성',unit:'/100',desc:'에이전트가 불필요한 중복·실패 없이 얼마나 효율적으로 도구를 사용하는지를 나타내는 종합 점수(0~100)입니다. 100에 가까울수록 최소한의 호출로 목적을 달성함을 의미합니다. 낭비율(중복+실패)이 높을수록 점수가 낮아집니다.',hint:'avg(100 − 낭비율×100) per task\n낭비율 = (redundant + failed) / total'},
      redundancy_rate:{label:'중복 호출률',unit:'%',desc:'동일하거나 불필요하게 반복된 도구 호출의 비율입니다. 높으면 에이전트가 결과를 확인하지 않고 같은 도구를 반복 호출하거나, 전략 없이 시행착오를 반복하고 있음을 시사합니다.',hint:'redundant_calls / total_calls × 100'},
      failure_rate:{label:'실패율',unit:'%',desc:'실행된 도구 호출 중 오류나 예외를 반환한 비율입니다. 높으면 도구 파라미터 생성 오류, 입력 유효성 문제, 또는 에이전트가 사용 불가능한 도구를 호출하고 있음을 나타냅니다.',hint:'failed_calls / total_calls × 100'},
      avg_per_task:{label:'태스크당 평균',unit:'건',desc:'하나의 태스크를 완료하기 위해 평균적으로 호출하는 도구 수입니다. 지나치게 많으면 비효율적인 계획 수립이나 불필요한 탐색을, 적으면 단순한 태스크 또는 도구 미활용을 의미합니다.',hint:'avg(total_calls per task)'},
    },
    formula(k,d){
      const te=d.agentic?.tool_efficiency||{};
      const tc=te.total_calls||0;
      const red=te.total_redundant_calls||0;
      const fail=te.total_failed_calls||0;
      if(k==='total_calls')return `총 호출 = ${tc}건\n성공: ${tc-(fail||0)}건 / 실패: ${fail}건 / 중복: ${red}건`;
      if(k==='success_rate')return `성공률 = (total − failed) / total × 100\n= (${tc} − ${fail}) / ${tc} × 100\n= ${(te.success_rate||0).toFixed(1)}%`;
      if(k==='avg_efficiency')return `효율 = 100 − 낭비율×100\n낭비율 = (redundant + failed) / total\n= (${red} + ${fail}) / ${tc}\n= ${(te.avg_efficiency_score||0).toFixed(1)} / 100`;
      if(k==='redundancy_rate')return `중복률 = redundant / total × 100\n= ${red} / ${tc} × 100\n= ${(te.redundancy_rate||0).toFixed(1)}%`;
      if(k==='failure_rate')return `실패율 = failed / total × 100\n= ${fail} / ${tc} × 100\n= ${(te.failure_rate||0).toFixed(1)}%`;
      if(k==='avg_per_task')return `태스크당 = avg(per-task calls)\n= ${(te.avg_calls_per_task||0).toFixed(2)}건`;
      return '';
    },
    items(k,d){
      const rows=d.agentic?.tool_call_executions||[];
      if(!rows.length) return [];
      const s=[...rows];
      if(k==='total_calls'||k==='avg_per_task') return s.sort((a,b)=>(b.total_calls||0)-(a.total_calls||0));
      if(k==='success_rate'||k==='failure_rate') return s.sort((a,b)=>(b.failed_calls||0)-(a.failed_calls||0));
      if(k==='redundancy_rate') return s.sort((a,b)=>(b.redundant_calls||0)-(a.redundant_calls||0));
      if(k==='avg_efficiency') return s.sort((a,b)=>(a.efficiency_score??100)-(b.efficiency_score??100));
      return s;
    },
    sortLabel(k){
      if(k==='total_calls'||k==='avg_per_task') return '총 호출 많은 순';
      if(k==='success_rate'||k==='failure_rate') return '실패 많은 순';
      if(k==='redundancy_rate') return '중복 많은 순';
      if(k==='avg_efficiency') return '효율성 낮은 순';
      return '태스크별';
    },
    hlCol(k,t){
      if(k==='total_calls'||k==='avg_per_task') return 'total';
      if(k==='success_rate'||k==='failure_rate') return 'fail';
      if(k==='redundancy_rate') return 'red';
      if(k==='avg_efficiency') return 'eff';
      return '';
    },
    effColor(score){ return score>=90?'var(--green)':score>=70?'var(--yellow)':'var(--red)'; },
    redRate(t){ const tc=t.total_calls||0; return tc?((t.redundant_calls||0)/tc*100):0; },
    failRate(t){ const tc=t.total_calls||0; return tc?((t.failed_calls||0)/tc*100):0; },
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='total_calls'}" @click="selK=selK==='total_calls'?null:'total_calls'">
        <div class="kpi-lbl">총 도구 호출</div>
        <div class="kpi-val" x-text="data.agentic?.tool_efficiency?.total_calls||0"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='success_rate'}" @click="selK=selK==='success_rate'?null:'success_rate'">
        <div class="kpi-lbl">성공률</div>
        <div class="kpi-val" :style="`color:${_bc(data.agentic?.tool_efficiency?.success_rate||0,90,70)}`"
             x-text="(data.agentic?.tool_efficiency?.success_rate||0).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='avg_efficiency'}" @click="selK=selK==='avg_efficiency'?null:'avg_efficiency'">
        <div class="kpi-lbl">평균 효율성</div>
        <div class="kpi-val" :style="`color:${_bc(data.agentic?.tool_efficiency?.avg_efficiency_score||0,90,70)}`"
             x-text="(data.agentic?.tool_efficiency?.avg_efficiency_score||0).toFixed(1)+'/100'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='redundancy_rate'}" @click="selK=selK==='redundancy_rate'?null:'redundancy_rate'">
        <div class="kpi-lbl">중복 호출률</div>
        <div class="kpi-val" style="color:var(--yellow)" x-text="(data.agentic?.tool_efficiency?.redundancy_rate||0).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='failure_rate'}" @click="selK=selK==='failure_rate'?null:'failure_rate'">
        <div class="kpi-lbl">실패율</div>
        <div class="kpi-val" style="color:var(--red)" x-text="(data.agentic?.tool_efficiency?.failure_rate||0).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='avg_per_task'}" @click="selK=selK==='avg_per_task'?null:'avg_per_task'">
        <div class="kpi-lbl">태스크당 평균</div>
        <div class="kpi-val" x-text="(data.agentic?.tool_efficiency?.avg_calls_per_task||0).toFixed(1)+'건'"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
              <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <!-- 태스크별 상세 테이블 -->
          <div style="padding:10px 14px;background:var(--bg)">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">태스크별 도구 호출 상세</span>
              <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="sortLabel(selK)"></span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,data).length+'건'"></span>
            </div>
            <template x-if="items(selK,data).length>0">
              <div class="dtx" style="max-height:220px;overflow-y:auto">
                <div class="dtx-row dtx-head" style="grid-template-columns:minmax(120px,1fr) 52px 52px 52px 56px 72px;position:sticky;top:0;z-index:1">
                  <span>태스크 ID</span>
                  <span>총 호출</span>
                  <span>고유 도구</span>
                  <span>중복</span>
                  <span>실패</span>
                  <span>효율성</span>
                </div>
                <template x-for="t in items(selK,data)" :key="t.task_id">
                  <div class="dtx-row" style="grid-template-columns:minmax(120px,1fr) 52px 52px 52px 56px 72px">
                    <span class="dtx-id" x-text="t.task_id||'-'"></span>
                    <span :style="hlCol(selK,t)==='total'?'font-weight:700;color:var(--accent)':''"
                          x-text="t.total_calls||0"></span>
                    <span x-text="t.unique_tools||0"></span>
                    <span :style="(t.redundant_calls||0)>0?(hlCol(selK,t)==='red'?'font-weight:700;color:var(--yellow)':'color:var(--yellow)'):''"
                          x-text="(t.redundant_calls||0)>0?((t.redundant_calls||0)+'건 ('+redRate(t).toFixed(0)+'%)'):'0'"></span>
                    <span :style="(t.failed_calls||0)>0?(hlCol(selK,t)==='fail'?'font-weight:700;color:var(--red)':'color:var(--red)'):''"
                          x-text="(t.failed_calls||0)>0?((t.failed_calls||0)+'건 ('+failRate(t).toFixed(0)+'%)'):'0'"></span>
                    <span :style="`font-weight:${hlCol(selK,t)==='eff'?'700':'400'};color:${effColor(t.efficiency_score??100)}`"
                          x-text="(t.efficiency_score??100).toFixed(1)"></span>
                  </div>
                </template>
              </div>
            </template>
            <template x-if="items(selK,data).length===0">
              <div style="text-align:center;color:var(--text2);font-size:13px;padding:20px 0">태스크별 도구 호출 데이터가 없습니다.</div>
            </template>
          </div>
        </div>
      </template>
    </div>
    <div class="cg" style="margin-top:8px">
      <div class="cbox"><div class="ct">도구별 사용 빈도</div><div id="d2-ag-tool-pie" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">효율성 지표 요약</div><div id="d2-ag-teff-bar" class="plt-chart"></div></div>
    </div>
  </div>

  <!-- Tool Selection subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🎯 도구 선택 정확도</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      precision:{label:'Precision',unit:'%',desc:'에이전트가 선택한 도구 중 실제로 필요했던 도구의 비율입니다. 낮으면 불필요한 도구를 자주 포함하는 경향이 있어 실행 비용과 오류 가능성이 증가합니다. expected_tools가 설정된 태스크에서만 측정됩니다.',hint:'TP / (TP + FP) per task → 0~100% 평균'},
      recall:{label:'Recall',unit:'%',desc:'태스크 수행에 필요한 도구 중 에이전트가 실제로 선택한 도구의 비율입니다. 낮으면 필요한 도구를 놓쳐 태스크를 불완전하게 수행할 가능성이 높아집니다. expected_tools가 설정된 태스크에서만 측정됩니다.',hint:'TP / (TP + FN) per task → 0~100% 평균'},
      f1:{label:'F1 Score',unit:'%',desc:'도구 선택의 Precision과 Recall을 균형 있게 종합한 지표입니다. 도구를 정확히 선택하면서도 필요한 것을 빠뜨리지 않는 능력을 단일 수치로 나타내며, 도구 사용 능력의 대표 지표입니다. expected_tools가 설정된 태스크에서만 측정됩니다.',hint:'2 × P × R / (P + R) per task → 0~100% 평균'},
      accuracy:{label:'Accuracy',unit:'%',desc:'예상 도구 집합과 실제 선택된 도구 집합이 얼마나 일치하는지를 나타내는 전반적 선택 정확도입니다. 태스크에 적합한 도구를 파악하는 에이전트의 도메인 이해 능력을 평가합니다.',hint:'correct_selections / total_selections per task → 0~100% 평균'},
      total:{label:'평가 태스크',unit:'건',desc:'도구 선택 정확도 평가가 수행된 태스크 수입니다. TaskResult 생성 시 expected_tools(예상 도구 목록)가 제공된 태스크에서만 측정되므로, 전체 태스크 수와 다를 수 있습니다.',hint:'len(tool_selections) — expected_tools 있는 태스크'},
    },
    formula(k,d){
      const ts=d.agentic?.tool_selection_summary||{};
      const n=ts.total_selections||(d.agentic?.tool_selections||[]).length||0;
      if(k==='precision'){const v=ts.avg_precision||0;return `Precision = TP/(TP+FP) per task → avg\n= ${v.toFixed(1)}%\n평가 태스크: ${n}건`;}
      if(k==='recall'){const v=ts.avg_recall||0;return `Recall = TP/(TP+FN) per task → avg\n= ${v.toFixed(1)}%\n평가 태스크: ${n}건`;}
      if(k==='f1'){const v=ts.avg_f1_score||0;return `F1 = 2×P×R/(P+R) per task → avg\n= ${v.toFixed(1)}%\n평가 태스크: ${n}건`;}
      if(k==='accuracy'){const v=ts.avg_accuracy||0;return `Accuracy = correct/total per task → avg\n= ${v.toFixed(1)}%\n평가 태스크: ${n}건`;}
      if(k==='total')return `평가 태스크 = ${n}건\n(expected_tools 제공된 태스크만)`;
      return '';
    },
    items(k,d){ return [...(d.agentic?.tool_selections||[])].sort((a,b)=>(b.f1_score||0)-(a.f1_score||0)); },
    filterLabel(k){return 'F1 내림차순';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='precision'}" @click="selK=selK==='precision'?null:'precision'">
        <div class="kpi-lbl">Precision</div>
        <div class="kpi-val" x-text="(data.agentic?.tool_selection_summary?.avg_precision||0).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='recall'}" @click="selK=selK==='recall'?null:'recall'">
        <div class="kpi-lbl">Recall</div>
        <div class="kpi-val" x-text="(data.agentic?.tool_selection_summary?.avg_recall||0).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='f1'}" @click="selK=selK==='f1'?null:'f1'">
        <div class="kpi-lbl">F1 Score</div>
        <div class="kpi-val" :style="`color:${_bc(data.agentic?.tool_selection_summary?.avg_f1_score||0,90,70)}`"
             x-text="(data.agentic?.tool_selection_summary?.avg_f1_score||0).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='accuracy'}" @click="selK=selK==='accuracy'?null:'accuracy'">
        <div class="kpi-lbl">Accuracy</div>
        <div class="kpi-val" :style="`color:${_bc(data.agentic?.tool_selection_summary?.avg_accuracy||0,90,70)}`"
             x-text="(data.agentic?.tool_selection_summary?.avg_accuracy||0).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='total'}" @click="selK=selK==='total'?null:'total'">
        <div class="kpi-lbl">평가 태스크</div>
        <div class="kpi-val" x-text="(data.agentic?.tool_selections||[]).length"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
              <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <div style="padding:10px 14px;background:var(--bg)">
            <div class="dtx" style="max-height:200px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:minmax(120px,1fr) 68px 68px 68px;position:sticky;top:0;z-index:1">
                <span>태스크 ID</span><span>Prec.</span><span>Recall</span><span>F1</span>
              </div>
              <template x-for="s in items(selK,data)" :key="s.task_id">
                <div class="dtx-row" style="grid-template-columns:minmax(120px,1fr) 68px 68px 68px">
                  <span class="dtx-id" x-text="s.task_id"></span>
                  <span x-text="(s.precision||0).toFixed(1)+'%'"></span>
                  <span x-text="(s.recall||0).toFixed(1)+'%'"></span>
                  <span :style="`color:${_bc(s.f1_score||0,80,60)}`" x-text="(s.f1_score||0).toFixed(1)+'%'"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cbox" style="margin-top:8px">
      <div class="ct">태스크별 F1 Score</div>
      <div id="d2-ag-sel-bar" style="min-height:260px;width:100%"></div>
    </div>
  </div>

  <!-- Retry subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔁 재시도 / 보정</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      retry_rate:{label:'재시도율 (시도 기준)',unit:'%',desc:'전체 실행 시도 중 재시도가 차지하는 비율입니다. 시도 횟수 기준으로 계산하며, 태스크 기준 재시도율(retry_rate)과 구분됩니다. 높을수록 첫 시도 실패가 잦아 비용과 지연이 증가합니다.',hint:'overall_retry_rate = (총시도 − 태스크수) / 총시도 × 100'},
      first_success:{label:'첫 시도 성공률',unit:'%',desc:'추가 재시도 없이 첫 번째 시도에서 성공한 태스크의 비율입니다. 높을수록 에이전트의 계획·실행 능력이 안정적이며, 운영 환경에서 비용과 응답 시간을 절감합니다. 100% − 재시도율(태스크 기준)에 해당합니다.',hint:'first_attempt_success_rate = 1회 성공 태스크 / 전체 태스크 × 100'},
      eventual_success:{label:'최종 성공률',unit:'%',desc:'재시도를 포함해 결국 성공한 태스크의 비율입니다. 첫 시도 성공률과의 차이가 재시도 효과(+Xpp)이며, 이 값이 크면 재시도 전략이 실패 만회에 기여하고 있음을 나타냅니다.',hint:'eventual_success_rate = 최종 성공 태스크 / 전체 태스크 × 100'},
      correction:{label:'보정 성공률',unit:'%',desc:'재시도가 발생한 태스크 중에서 결국 성공으로 전환된 비율입니다. 에이전트의 자기 교정 능력을 나타내며, 낮으면 재시도해도 동일한 오류를 반복하고 있어 프롬프트 또는 도구 설계 개선이 필요합니다.',hint:'correction_success_rate = retry 후 성공 / retry 발생 태스크 × 100'},
      avg_attempts:{label:'평균 시도',unit:'회',desc:'태스크 1건을 완료하는 데 평균적으로 소요된 시도 횟수입니다. 1.0에 가까울수록 효율적입니다. 재시도가 많을수록 LLM 호출 비용과 응답 지연이 선형으로 증가하므로 목표치(≤1.3)를 설정해 모니터링하는 것이 좋습니다.',hint:'avg_attempts_per_task = avg(total_attempts per task)'},
      avg_retry_time:{label:'평균 재시도 시간',unit:'s',desc:'재시도가 발생한 태스크에서 재시도에만 소요된 평균 시간입니다. 전체 태스크가 아닌 재시도 태스크만 분모로 사용합니다. 높으면 재시도 대기 시간이 길거나 복잡한 오류 처리가 발생하고 있음을 의미합니다.',hint:'avg_retry_time = avg(retry_time) — 재시도 발생 태스크 한정'},
    },
    formula(k,d){
      const rs=d.agentic?.retry_summary||{};
      const ra=d.agentic?.retry_attempts||[];
      const total=ra.length||1;
      const tw=rs.total_tasks_with_retries||ra.filter(r=>(r.total_attempts||1)>1).length||0;
      const ta=rs.total_attempts||ra.reduce((s,r)=>s+(r.total_attempts||1),0)||0;
      const firstOK=rs.first_attempt_success_rate!=null?rs.first_attempt_success_rate:null;
      const finalOK=rs.eventual_success_rate||0;
      const effect=firstOK!=null?(finalOK-firstOK).toFixed(1):null;
      if(k==='retry_rate')return `overall_retry_rate (시도 기준)\n= (총시도 ${ta} − 태스크 ${total}) / 총시도 ${ta} × 100\n= ${(rs.overall_retry_rate||0).toFixed(1)}%\n\nretry_rate (태스크 기준, 참고)\n= 재시도 발생 태스크 ${tw} / 전체 ${total} × 100\n= ${(rs.retry_rate||0).toFixed(1)}%\n\n※ 두 지표는 분모가 달라 값 차이가 있습니다`;
      if(k==='first_success')return `첫 시도 성공률\n= 1회 성공 태스크 / 전체 태스크 × 100\n= ${(rs.first_attempt_success_rate||0).toFixed(1)}%\n\n재시도 발생 태스크: ${tw}건 / 전체 ${total}건\n(100 − retry_rate(태스크기준) = ${(100-(rs.retry_rate||0)).toFixed(1)}%와 동일)`;
      if(k==='eventual_success'){const e=effect!=null?`\n\n재시도 효과 = 최종(${finalOK.toFixed(1)}%) − 첫시도(${(firstOK||0).toFixed(1)}%)\n= +${effect}%p (재시도로 만회한 성공 비율)`:'';return `최종 성공률\n= 최종 성공 태스크 / 전체 태스크 × 100\n= ${finalOK.toFixed(1)}%${e}`;}
      if(k==='correction')return `보정 성공률\n= retry 후 성공 / retry 발생 태스크 × 100\n= ${(rs.correction_success_rate||0).toFixed(1)}%\n\nretry 발생 태스크: ${tw}건\n※ 재시도해도 실패하면 보정 성공률에 포함되지 않음`;
      if(k==='avg_attempts'){const dist=ra.reduce((m,r)=>{const a=r.total_attempts||1;m[a]=(m[a]||0)+1;return m;},{});const distStr=Object.entries(dist).sort((a,b)=>+a[0]-+b[0]).map(([a,c])=>`${a}회: ${c}건`).join(' / ');return `평균 시도 = avg(total_attempts)\n= ${(rs.avg_attempts_per_task||rs.avg_attempts||0).toFixed(2)}회\n\n시도 횟수 분포: ${distStr}\n1.0이면 전 태스크 1회 성공`;}
      if(k==='avg_retry_time')return `평균 재시도 시간 (재시도 태스크 한정)\n= avg(retry_time)\n= ${(rs.avg_retry_time||0).toFixed(2)}s\n\nretry 발생 태스크: ${tw}건 (전체 ${total}건 중)\n※ 분모는 재시도 태스크만 포함`;
      return '';
    },
    items(k,d){
      const ra=d.agentic?.retry_attempts||[];
      if(k==='retry_rate') return [...ra].filter(r=>(r.total_attempts||1)>1).sort((a,b)=>(b.total_attempts||1)-(a.total_attempts||1));
      if(k==='first_success') return [...ra].sort((a,b)=>((a.total_attempts||1)>1?1:0)-((b.total_attempts||1)>1?1:0));
      if(k==='eventual_success') return [...ra].sort((a,b)=>(a.final_success===b.final_success?0:a.final_success?1:-1));
      if(k==='correction') return [...ra].filter(r=>(r.total_attempts||1)>1).sort((a,b)=>(a.final_success===b.final_success?0:a.final_success?1:-1));
      if(k==='avg_retry_time') return [...ra].filter(r=>(r.total_attempts||1)>1).sort((a,b)=>(b.total_retry_time||b.total_time||0)-(a.total_retry_time||a.total_time||0));
      return [...ra].sort((a,b)=>(b.total_attempts||1)-(a.total_attempts||1));
    },
    filterLabel(k){
      if(k==='retry_rate'||k==='avg_retry_time'||k==='correction') return '재시도 발생 태스크';
      if(k==='first_success') return '전체 태스크 (1회성공 → 재시도 순)';
      if(k==='eventual_success') return '전체 태스크 (실패 우선)';
      return '전체 태스크 (시도 많은 순)';
    },
    attemptColor(n){return n>=3?'#e55':n===2?'#e9a020':'inherit';},
    retryTimeColor(s){return s>5?'#e55':s>2?'#e9a020':'inherit';},
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='retry_rate'}" @click="selK=selK==='retry_rate'?null:'retry_rate'">
        <div class="kpi-lbl">재시도율</div>
        <div class="kpi-val" x-text="_pct(data.agentic?.retry_summary?.overall_retry_rate||0)"></div>
        <div class="kpi-sub" x-text="'태스크기준 '+_pct(data.agentic?.retry_summary?.retry_rate||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='first_success'}" @click="selK=selK==='first_success'?null:'first_success'">
        <div class="kpi-lbl">첫 시도 성공률</div>
        <div class="kpi-val" :style="`color:${_bc(data.agentic?.retry_summary?.first_attempt_success_rate||0,90,70)}`"
             x-text="_pct(data.agentic?.retry_summary?.first_attempt_success_rate||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='eventual_success'}" @click="selK=selK==='eventual_success'?null:'eventual_success'">
        <div class="kpi-lbl">최종 성공률</div>
        <div class="kpi-val" :style="`color:${_bc(data.agentic?.retry_summary?.eventual_success_rate||0,90,70)}`"
             x-text="_pct(data.agentic?.retry_summary?.eventual_success_rate||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='correction'}" @click="selK=selK==='correction'?null:'correction'">
        <div class="kpi-lbl">보정 성공률</div>
        <div class="kpi-val" :style="`color:${_bc(data.agentic?.retry_summary?.correction_success_rate||0,80,60)}`"
             x-text="_pct(data.agentic?.retry_summary?.correction_success_rate||0)"></div>
        <div class="kpi-sub" x-text="'재시도 '+((data.agentic?.retry_summary?.total_tasks_with_retries)||(data.agentic?.retry_attempts||[]).filter(r=>(r.total_attempts||1)>1).length||0)+'건'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='avg_attempts'}" @click="selK=selK==='avg_attempts'?null:'avg_attempts'">
        <div class="kpi-lbl">평균 시도</div>
        <div class="kpi-val" x-text="(data.agentic?.retry_summary?.avg_attempts_per_task||data.agentic?.retry_summary?.avg_attempts||0).toFixed(2)+'회'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='avg_retry_time'}" @click="selK=selK==='avg_retry_time'?null:'avg_retry_time'">
        <div class="kpi-lbl">평균 재시도 시간</div>
        <div class="kpi-val" x-text="_sec(data.agentic?.retry_summary?.avg_retry_time||0)"></div>
        <div class="kpi-sub">재시도 태스크 기준</div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
              <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <div style="padding:10px 14px;background:var(--bg)">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:6px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">태스크별 재시도 기록</span>
              <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="filterLabel(selK)"></span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,data).length+'건'"></span>
            </div>
            <div style="font-size:11px;color:var(--text2);margin-bottom:6px">
              🔴 3회↑ 재시도 &nbsp;🟡 2회 재시도 &nbsp;· 재시도 시간 🟡 &gt;2s &nbsp;🔴 &gt;5s
            </div>
            <div class="dtx" style="max-height:240px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:minmax(100px,1.2fr) 90px 44px minmax(0,1fr) 58px 70px;position:sticky;top:0;z-index:1">
                <span>태스크 ID</span><span>유형</span><span>시도</span><span>재시도 이유</span><span>최종성공</span><span>재시도시간</span>
              </div>
              <template x-for="(r, ridx) in items(selK,data)" :key="ridx">
                <div class="dtx-row" :style="`grid-template-columns:minmax(100px,1.2fr) 90px 44px minmax(0,1fr) 58px 70px;${!r.final_success&&(r.total_attempts||1)>1?'background:rgba(220,50,50,0.06)':''}`">
                  <span class="dtx-id" x-text="r.task_id"></span>
                  <span style="font-size:11px;color:var(--text2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap" :title="r.task_type||'—'" x-text="r.task_type||'—'"></span>
                  <span :style="`font-weight:600;color:${attemptColor(r.total_attempts||1)}`" x-text="(r.total_attempts||1)+'회'"></span>
                  <span style="font-size:11px;color:var(--text2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap" :title="(r.retry_reasons||[]).filter(x=>x&&x!=='unknown'&&x!=='').join(', ')||'—'" x-text="(r.retry_reasons&&r.retry_reasons.filter(x=>x&&x!=='unknown'&&x!=='').length>0?r.retry_reasons.filter(x=>x&&x!=='unknown'&&x!=='').join(', '):'—')"></span>
                  <span :class="r.final_success?'badge-ok':'badge-ng'" x-text="r.final_success?'✓':'✗'"></span>
                  <span :style="`color:${retryTimeColor(r.total_retry_time||r.total_time||0)}`" x-text="_sec(r.total_retry_time||r.total_time||0)"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cg" style="margin-top:8px">
      <div class="cbox"><div class="ct">재시도 횟수 분포</div><div id="d2-ag-retry-hist" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">태스크 유형별 재시도율</div><div id="d2-ag-retry-type" class="plt-chart"></div></div>
    </div>
  </div>

  <!-- Multi-Agent Coordination subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🤝 멀티에이전트 협업</span><div class="sdiv-line"></div></div>
  <div x-show="!data.has_coordination">
    <div class="badge-gray" style="display:inline-block;margin-bottom:12px">협업 데이터 없음 — AgentCoordinationTracker 미활성화</div>
  </div>
  <div x-show="data.has_coordination">
    <div x-data="{
      selK:null,
      meta:{
        total_interactions:{label:'총 인터랙션',unit:'건',desc:'에이전트 간에 발생한 전체 상호작용 수입니다. 도구 위임(delegation)·직접 통신(communication)·협력(collaboration) 유형을 모두 포함하며, 태스크당 평균 인터랙션 수와 함께 워크플로우 복잡성을 나타냅니다.',hint:'agent_interactions.length'},
        success_interactions:{label:'성공 인터랙션',unit:'건',desc:'에이전트 간 상호작용 중 정상적으로 완료된 수입니다. 실패 인터랙션이 있다면 아래 목록에 빨간색으로 표시됩니다. 수신 에이전트의 처리 성공 여부를 반영하며, 협업 인터페이스 품질을 나타냅니다.',hint:'successful_interactions'},
        success_rate:{label:'협업 성공률',unit:'%',desc:'에이전트 간 협업이 성공적으로 이루어진 비율입니다. 실패 인터랙션이 있을 경우 아래 목록에 강조 표시되며, 어떤 에이전트 쌍에서 실패가 발생하는지 파악할 수 있습니다.',hint:'successful / total × 100'},
        unique_agents:{label:'참여 에이전트',unit:'명',desc:'이번 평가에서 상호작용에 참여한 고유한 에이전트 수입니다. 아래 표에서 각 에이전트의 발신(from)·수신(to) 횟수와 총 참여 빈도를 확인할 수 있습니다.',hint:'unique_agents'},
      },
      formula(k,d){
        const cs=d.agentic?.coordination_summary||{};
        const ai=d.agentic?.agent_interactions||[];
        const tot=cs.total_interactions||0;
        const suc=cs.successful_interactions||0;
        const fail=tot-suc;
        const taskSet=new Set(ai.map(i=>i.task_id));
        const avgPerTask=taskSet.size?+(tot/taskSet.size).toFixed(1):0;
        if(k==='total_interactions')return `총 인터랙션 = ${tot}건\n성공: ${suc}건 / 실패: ${fail}건\n참여 에이전트: ${cs.unique_agents||0}명\n참여 태스크: ${taskSet.size}건 (태스크당 평균 ${avgPerTask}건)`;
        if(k==='success_interactions')return `성공 인터랙션 = ${suc}건\n= total(${tot}) − failed(${fail})\n성공률: ${(cs.success_rate||0).toFixed(1)}%`;
        if(k==='success_rate')return `협업 성공률 = successful / total × 100\n= ${suc} / ${tot} × 100\n= ${(cs.success_rate||0).toFixed(1)}%${fail>0?'\n\n⚠️ 실패 인터랙션 '+fail+'건이 아래 목록에 강조 표시됩니다.':'\n\n✓ 실패 인터랙션 없음'}`;
        if(k==='unique_agents'){
          const agents=(cs.agent_list||[]);
          const pairMap={};
          ai.forEach(i=>{const p=`${i.from_agent}→${i.to_agent}`;pairMap[p]=(pairMap[p]||0)+1;});
          const topPair=Object.entries(pairMap).sort((a,b)=>b[1]-a[1])[0];
          return `참여 에이전트 = ${cs.unique_agents||0}명\n[${agents.join(', ')}]\n\n가장 빈번한 쌍: ${topPair?topPair[0]+' ('+topPair[1]+'건)':'없음'}`;
        }
        return '';
      },
      items(k,d){
        const ai=d.agentic?.agent_interactions||[];
        if(k==='success_interactions') return ai.filter(i=>i.success);
        if(k==='success_rate') return [...ai].sort((a,b)=>(a.success===b.success)?0:a.success?1:-1);
        if(k==='unique_agents'){
          const sentMap={}, recvMap={};
          ai.forEach(i=>{
            sentMap[i.from_agent]=(sentMap[i.from_agent]||0)+1;
            recvMap[i.to_agent]=(recvMap[i.to_agent]||0)+1;
          });
          const agents=new Set([...Object.keys(sentMap),...Object.keys(recvMap)]);
          return [...agents].map(a=>({agent:a,sent:sentMap[a]||0,recv:recvMap[a]||0}))
                            .sort((a,b)=>(b.sent+b.recv)-(a.sent+a.recv));
        }
        return ai;
      },
      rowCount(k,d){ return this.items(k,d).length; },
      filterLabel(k){
        if(k==='success_interactions') return '성공 인터랙션';
        if(k==='success_rate') return '실패 우선 정렬';
        if(k==='unique_agents') return '참여 많은 순';
        return '전체 인터랙션';
      },
    }">
      <div class="kpi-grid">
        <div class="kpi kpi-act" :class="{sel:selK==='total_interactions'}" @click="selK=selK==='total_interactions'?null:'total_interactions'">
          <div class="kpi-lbl">총 인터랙션</div>
          <div class="kpi-val" x-text="data.agentic?.coordination_summary?.total_interactions||0"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='success_interactions'}" @click="selK=selK==='success_interactions'?null:'success_interactions'">
          <div class="kpi-lbl">성공 인터랙션</div>
          <div class="kpi-val" style="color:var(--green)" x-text="data.agentic?.coordination_summary?.successful_interactions||0"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='success_rate'}" @click="selK=selK==='success_rate'?null:'success_rate'">
          <div class="kpi-lbl">협업 성공률</div>
          <div class="kpi-val" :style="`color:${_bc(data.agentic?.coordination_summary?.success_rate||0,90,70)}`"
               x-text="_pct(data.agentic?.coordination_summary?.success_rate||0)"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='unique_agents'}" @click="selK=selK==='unique_agents'?null:'unique_agents'">
          <div class="kpi-lbl">참여 에이전트</div>
          <div class="kpi-val" x-text="data.agentic?.coordination_summary?.unique_agents||0"></div>
        </div>
      </div>
      <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
        <template x-if="selK">
          <div>
            <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
              <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
              <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
              <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
                <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
                <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
              </div>
              <div style="padding:10px 14px;background:var(--bg3)">
                <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
                <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
              </div>
            </div>
            <!-- 에이전트 요약표 (unique_agents 전용) -->
            <template x-if="selK==='unique_agents'">
              <div style="padding:10px 14px;background:var(--bg)">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
                  <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">에이전트별 활동</span>
                  <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px">참여 많은 순</span>
                  <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="rowCount(selK,data)+'명'"></span>
                </div>
                <div class="dtx" style="max-height:200px;overflow-y:auto">
                  <div class="dtx-row dtx-head" style="grid-template-columns:minmax(120px,1fr) 60px 60px 70px;position:sticky;top:0;z-index:1">
                    <span>에이전트</span><span>발신</span><span>수신</span><span>총 참여</span>
                  </div>
                  <template x-for="(ag, idx) in items(selK,data)" :key="idx">
                    <div class="dtx-row" style="grid-template-columns:minmax(120px,1fr) 60px 60px 70px">
                      <span class="dtx-id" x-text="ag.agent"></span>
                      <span x-text="ag.sent+'건'"></span>
                      <span x-text="ag.recv+'건'"></span>
                      <span style="font-weight:600;color:var(--accent)" x-text="(ag.sent+ag.recv)+'건'"></span>
                    </div>
                  </template>
                </div>
              </div>
            </template>
            <!-- 인터랙션 목록표 (나머지 KPI) -->
            <template x-if="selK!=='unique_agents'">
              <div style="padding:10px 14px;background:var(--bg)">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
                  <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">인터랙션 상세</span>
                  <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="filterLabel(selK)"></span>
                  <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="rowCount(selK,data)+'건'"></span>
                </div>
                <div class="dtx" style="max-height:200px;overflow-y:auto">
                  <div class="dtx-row dtx-head" style="grid-template-columns:140px 90px 90px minmax(0,1fr) 52px;position:sticky;top:0;z-index:1">
                    <span>태스크 ID</span><span>From</span><span>To</span><span>컨텍스트</span><span>성공</span>
                  </div>
                  <template x-for="(i, idx) in items(selK,data)" :key="idx">
                    <div class="dtx-row" :style="`grid-template-columns:140px 90px 90px minmax(0,1fr) 52px;${!i.success?'background:rgba(239,68,68,0.06)':''}`">
                      <span class="dtx-id" x-text="i.task_id"></span>
                      <span style="font-size:11px" x-text="i.from_agent||'-'"></span>
                      <span style="font-size:11px" x-text="i.to_agent||'-'"></span>
                      <span style="font-size:10px;color:var(--text2)" x-text="i.context||'-'"></span>
                      <span :class="i.success?'badge-ok':'badge-ng'" x-text="i.success?'✓':'✗'"></span>
                    </div>
                  </template>
                </div>
              </div>
            </template>
          </div>
        </template>
      </div>
      <div class="cbox" style="margin-top:8px">
        <div class="ct">에이전트별 인터랙션 수</div>
        <div id="d2-ag-coord-bar" class="plt-chart"></div>
      </div>
    </div>
  </div>

  <!-- Workflow subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔀 워크플로우 실행</span><div class="sdiv-line"></div></div>
  <div x-show="!data.has_workflow">
    <div class="badge-gray" style="display:inline-block;margin-bottom:12px">워크플로우 데이터 없음 — WorkflowExecutionTracker 미활성화</div>
  </div>
  <div x-show="data.has_workflow">
    <div x-data="{
      selK:null,
      meta:{
        total_steps:{label:'총 스텝 수',unit:'개',desc:'전체 워크플로우 실행에서 통과한 총 단계 수입니다. 에이전트가 수행하는 작업의 복잡성과 세분화 수준을 나타내며, 스텝 성공률과 함께 워크플로우 건전성을 평가합니다.',hint:'workflow_summary.total_steps'},
        success_steps:{label:'성공 스텝',unit:'개',desc:'정상적으로 완료된 워크플로우 단계 수입니다. 실패한 단계는 이후 단계에 연쇄 영향을 미칠 수 있어, 어느 단계에서 주로 실패하는지 파악하면 개선 우선순위를 설정하는 데 유용합니다.',hint:'workflow_summary.successful_steps'},
        step_rate:{label:'스텝 성공률',unit:'%',desc:'전체 워크플로우 단계 중 성공적으로 완료된 비율입니다. 워크플로우 실행의 전반적인 안정성을 나타내며, 낮을 경우 특정 단계 유형이나 순서에서 반복적으로 실패가 발생함을 시사합니다.',hint:'successful_steps / total_steps × 100'},
        wf_tasks:{label:'워크플로우 태스크',unit:'건',desc:'워크플로우 실행 데이터가 기록된 태스크의 수입니다. WorkflowExecutionTracker가 활성화된 태스크에서만 측정되며, 전체 태스크 대비 워크플로우 활용 비율을 파악할 수 있습니다.',hint:'workflow_summary.total_tasks'},
        task_rate:{label:'태스크 완료율',unit:'%',desc:'워크플로우 전체를 성공적으로 완료한 태스크의 비율입니다. 스텝 성공률이 높아도 전체 워크플로우 완료 여부는 별도로 측정되므로, 이 지표로 최종 목표 달성 능력을 평가합니다.',hint:'workflow_summary.task_success_rate'},
      },
      formula(k,d){
        const ws=d.agentic?.workflow_summary||{};
        const tot=ws.total_steps||0;
        const suc=ws.successful_steps||0;
        const wfN=(d.agentic?.workflow_executions||[]).length;
        if(k==='total_steps')return `총 스텝 = ${tot}개\n성공: ${suc}개 / 실패: ${tot-suc}개\n(workflow_executions 레코드 수)`;
        if(k==='success_steps')return `성공 스텝 = ${suc}개\n= total(${tot}) − failed(${tot-suc})`;
        if(k==='step_rate')return `스텝 성공률 = successful_steps / total_steps × 100\n= ${suc} / ${tot} × 100\n= ${(ws.step_success_rate||0).toFixed(1)}%`;
        if(k==='wf_tasks')return `워크플로우 태스크 = ${ws.total_tasks||0}건\n(task_id 기준 고유 태스크 수)\n총 스텝 레코드 수: ${wfN}건`;
        if(k==='task_rate')return `태스크 완료율 = fully_successful_tasks / total_tasks × 100\n= ${ws.fully_successful_tasks||0} / ${ws.total_tasks||0} × 100\n= ${(ws.task_success_rate||0).toFixed(1)}%\n(모든 스텝이 성공인 태스크만 계산)`;
        return '';
      },
      items(k,d){ return d.agentic?.workflow_executions||[]; },
      filterLabel(k){return '전체 워크플로우 실행';}
    }">
      <div class="kpi-grid">
        <div class="kpi kpi-act" :class="{sel:selK==='total_steps'}" @click="selK=selK==='total_steps'?null:'total_steps'">
          <div class="kpi-lbl">총 스텝 수</div>
          <div class="kpi-val" x-text="data.agentic?.workflow_summary?.total_steps||0"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='success_steps'}" @click="selK=selK==='success_steps'?null:'success_steps'">
          <div class="kpi-lbl">성공 스텝</div>
          <div class="kpi-val" style="color:var(--green)" x-text="data.agentic?.workflow_summary?.successful_steps||0"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='step_rate'}" @click="selK=selK==='step_rate'?null:'step_rate'">
          <div class="kpi-lbl">스텝 성공률</div>
          <div class="kpi-val" :style="`color:${_bc(data.agentic?.workflow_summary?.step_success_rate||0,90,70)}`"
               x-text="_pct(data.agentic?.workflow_summary?.step_success_rate||0)"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='wf_tasks'}" @click="selK=selK==='wf_tasks'?null:'wf_tasks'">
          <div class="kpi-lbl">워크플로우 태스크</div>
          <div class="kpi-val" x-text="data.agentic?.workflow_summary?.total_tasks||0"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='task_rate'}" @click="selK=selK==='task_rate'?null:'task_rate'">
          <div class="kpi-lbl">태스크 완료율</div>
          <div class="kpi-val" :style="`color:${_bc(data.agentic?.workflow_summary?.task_success_rate||0,90,70)}`"
               x-text="_pct(data.agentic?.workflow_summary?.task_success_rate||0)"></div>
        </div>
      </div>
      <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
        <template x-if="selK">
          <div>
            <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
              <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
              <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
              <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
                <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
                <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
              </div>
              <div style="padding:10px 14px;background:var(--bg3)">
                <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
                <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
              </div>
            </div>
            <div style="padding:10px 14px;background:var(--bg)">
              <div class="dtx" style="max-height:200px;overflow-y:auto">
                <div class="dtx-row dtx-head" style="grid-template-columns:170px minmax(0,1fr) 72px 56px;position:sticky;top:0;z-index:1">
                  <span>태스크 ID</span><span>스텝명</span><span>프레임워크</span><span>성공</span>
                </div>
                <template x-for="w in items(selK,data)" :key="w.task_id+(w.step_name||'')">
                  <div class="dtx-row" style="grid-template-columns:170px minmax(0,1fr) 72px 56px">
                    <span class="dtx-id" x-text="w.task_id"></span>
                    <span style="font-size:11px;color:var(--text2)" x-text="w.step_name||'-'"></span>
                    <span style="font-size:11px;color:var(--text2)" x-text="w.framework||'-'"></span>
                    <span :class="w.success?'badge-ok':'badge-ng'" x-text="w.success?'✓':'✗'"></span>
                  </div>
                </template>
              </div>
            </div>
          </div>
        </template>
      </div>
      <div class="cbox" style="margin-top:8px">
        <div class="ct">워크플로우 단계 성공/실패 퍼널</div>
        <div id="d2-ag-wf-funnel" class="plt-chart"></div>
      </div>
    </div>
  </div>

  <!-- Framework Distribution -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🏗 프레임워크 분포</span><div class="sdiv-line"></div></div>
  <div class="sec">
    <div class="sec-t">프레임워크별 태스크 현황</div>
    <div class="dtx">
      <div class="dtx-row dtx-head" style="grid-template-columns:1fr 60px 60px 50px">
        <span>프레임워크</span><span>태스크</span><span>성공률</span><span>비율</span>
      </div>
      <template x-for="f in frameworkDist(data)" :key="f.name">
        <div class="dtx-row" style="grid-template-columns:1fr 60px 60px 50px">
          <span class="dtx-id" x-text="f.name"></span>
          <span x-text="f.count+'건'"></span>
          <span :style="`color:${_bc(f.rate,90,70)}`" x-text="f.rate.toFixed(1)+'%'"></span>
          <span style="color:var(--text2)" x-text="f.pct.toFixed(1)+'%'"></span>
        </div>
      </template>
      <div class="dtx-empty" x-show="frameworkDist(data).length===0">프레임워크 정보 없음</div>
    </div>
  </div>

  </div><!-- /has_agentic -->
</div><!-- /agentic -->

<!-- ══ SECTION 6: SECURITY ══ -->
<div x-show="data && sec==='security'" x-cloak>
  <div x-show="!data.has_security" class="es">
    <div class="es-icon">🔒</div>
    <div class="es-title">보안 지표 없음</div>
    <div class="es-desc"><code>PerformanceMonitor(enable_security_metrics=True)</code>으로 활성화하세요.</div>
  </div>
  <div x-show="data.has_security">

  <!-- Security Summary -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🛡 보안 종합 점수</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    score(k,d){
      if(k==='input_sec') return 100-(d.security_l1?.input_security?.threat_rate||0);
      if(k==='output_int') return 100-(d.security_l1?.output_leakage?.leakage_rate||0);
      if(k==='auth') return d.security_l1?.authorization?.compliance_rate??100;
      if(k==='priv_esc') return 100-(d.security_l2?.privilege_escalation?.escalation_rate||0);
      if(k==='atk_det'){const ad=d.security_l2?.attack_detection||{};const n=ad.total_chains_analyzed||0;return n===0?100:Math.max(0,100-(ad.detection_rate||0));}
      return 0;},
    formula(k,d){
      const is=d.security_l1?.input_security||{};
      const ol=d.security_l1?.output_leakage||{};
      const au=d.security_l1?.authorization||{};
      const pe=d.security_l2?.privilege_escalation||{};
      const ad=d.security_l2?.attack_detection||{};
      if(k==='input_sec'){
        const n=is.total_inputs_evaluated||(d.security_l1?.input_evals||[]).length||0;
        const th=is.inputs_with_threats||0;
        const total=(is.sql_injection_attempts||0)+(is.command_injection_attempts||0)+(is.path_traversal_attempts||0)+(is.xss_attempts||0)+(is.prompt_injection_attempts||0);
        return `입력 보안 = 100 − 위협율
= 100 − ${(is.threat_rate||0).toFixed(1)}% = ${(100-(is.threat_rate||0)).toFixed(1)}%

평가 입력: ${n}건 / 위협 입력: ${th}건 (중복 제거)
위협 이벤트: SQL ${is.sql_injection_attempts||0} + CMD ${is.command_injection_attempts||0} + PATH ${is.path_traversal_attempts||0} + XSS ${is.xss_attempts||0} + Prompt ${is.prompt_injection_attempts||0} = ${total}건`;}
      if(k==='output_int'){
        const n=ol.total_outputs_evaluated||(d.security_l1?.output_detections||[]).length||0;
        return `출력 무결성 = 100 − 유출율
= 100 − ${(ol.leakage_rate||0).toFixed(1)}% = ${(100-(ol.leakage_rate||0)).toFixed(1)}%

평가 출력: ${n}건 / 유출 탐지: ${ol.outputs_with_leakage||0}건
심각: ${ol.critical_severity_count||0}건 / 고위험: ${ol.high_severity_count||0}건`;}
      if(k==='auth'){
        const n=au.total_tool_calls||0;
        return `권한 준수 = 허가 호출 / 전체 호출 × 100
= ${au.authorized_calls||0} / ${n} × 100 = ${(au.compliance_rate??100).toFixed(1)}%

무단 호출: ${au.unauthorized_calls||0}건 / 위험 파라미터: ${au.dangerous_params||0}건
제한 시도: ${au.restricted_attempts||0}건`;}
      if(k==='priv_esc'){
        const er=pe.escalation_rate||0;
        return `권한상승 방어 = 100 − 상승률
= 100 − ${er.toFixed(1)}% = ${(100-er).toFixed(1)}%

전체 평가: ${pe.total_evaluations||0}건 / 탐지: ${pe.escalations_detected||0}건`;}
      if(k==='atk_det'){
        const n=ad.total_chains_analyzed||0;
        const s=ad.suspicious_chains||0;
        const safe=n===0?100:Math.max(0,100-(ad.detection_rate||0));
        return `체인 안전율 = 100 − 탐지율 = 100 − ${(ad.detection_rate||0).toFixed(1)}% = ${safe.toFixed(1)}%
분석 체인: ${n}건 / 의심 체인: ${s}건 / 안전 체인: ${n-s}건
(탐지율 낮을수록, 안전율 높을수록 좋음)`;}
      return '';},
    items(k,d){
      if(k==='input_sec') return (d.security_l1?.input_evals||[]).filter(e=>e.sanitization_needed);
      if(k==='output_int') return (d.security_l1?.output_detections||[]).filter(e=>(e.leakage_count||0)>0);
      if(k==='auth') return (d.security_l1?.tool_calls_detail||[]).filter(t=>!t.is_authorized||t.is_restricted||t.has_dangerous_params);
      if(k==='priv_esc') return (d.security_l2?.escalation_events||[]).filter(e=>e.escalation_detected);
      if(k==='atk_det') return (d.security_l2?.attack_detections||[]).filter(e=>e.is_suspicious_chain);
      return [];},
    desc(k){
      if(k==='input_sec') return '에이전트 입력에 포함된 위협 패턴을 탐지합니다. SQL 인젝션·커맨드 인젝션·경로 순회·XSS·프롬프트 인젝션 5가지 유형을 검사하며, 위협율이 낮을수록 안전한 환경입니다. InputSanitizationTracker (Layer 1) 가 검사한 결과를 기반으로 합니다.';
      if(k==='output_int') return '에이전트 출력에 포함된 민감 정보 유출을 탐지합니다. API Key·패스워드·신용카드·이메일·SSN·전화번호·개인 IP·파일 경로 8가지 유형을 검사합니다. OutputLeakageDetector (Layer 1) 결과이며 유출율이 낮을수록 무결성이 높습니다.';
      if(k==='auth') return '에이전트가 허가된 범위 내에서만 도구를 호출하는지 측정합니다. 무단 호출·위험 파라미터 사용·제한 도구 시도를 탐지하며, 준수율이 높을수록 도구 사용이 안전합니다. ToolAuthorizationTracker (Layer 1) 기반입니다.';
      if(k==='priv_esc') return '에이전트가 실행 중 초기 권한을 초과해 권한을 확대하려는 시도를 탐지합니다. 상승률이 낮을수록 방어율이 높습니다. PrivilegeEscalationDetector (Layer 2) 가 초기/최종 권한 수준을 비교해 상승 여부를 판단합니다.';
      if(k==='atk_det') return '연속된 도구 호출 체인 중 공격 패턴이 없는 안전한 체인의 비율입니다. 100 − 탐지율로 계산하며, 높을수록 공격 시도가 적고 안전합니다. ToolChainAttackDetector (Layer 2) 가 체인 패턴·신뢰도·공격 시퀀스를 분석합니다.';
      return '';},
  }">
    <div class="kpi-grid" style="grid-template-columns:repeat(5,1fr)">
      <div class="kpi kpi-act" :class="{sel:selK==='input_sec'}" @click="selK=selK==='input_sec'?null:'input_sec'">
        <div class="kpi-lbl" style="font-size:10px">입력 보안 (L1)</div>
        <div class="kpi-val" style="font-size:20px" :style="`color:${_bc(score('input_sec',data),90,70)}`"
             x-text="_pct(score('input_sec',data))"></div>
        <div class="kpi-sub" x-text="`위협 ${data.security_l1?.input_security?.inputs_with_threats||0} / ${data.security_l1?.input_security?.total_inputs_evaluated||(data.security_l1?.input_evals||[]).length||0}건`"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='output_int'}" @click="selK=selK==='output_int'?null:'output_int'">
        <div class="kpi-lbl" style="font-size:10px">출력 무결성 (L1)</div>
        <div class="kpi-val" style="font-size:20px" :style="`color:${_bc(score('output_int',data),90,70)}`"
             x-text="_pct(score('output_int',data))"></div>
        <div class="kpi-sub" x-text="`유출 ${data.security_l1?.output_leakage?.outputs_with_leakage||0} / ${data.security_l1?.output_leakage?.total_outputs_evaluated||(data.security_l1?.output_detections||[]).length||0}건`"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='auth'}" @click="selK=selK==='auth'?null:'auth'">
        <div class="kpi-lbl" style="font-size:10px">권한 준수 (L1)</div>
        <div class="kpi-val" style="font-size:20px" :style="`color:${_bc(score('auth',data),90,70)}`"
             x-text="_pct(score('auth',data))"></div>
        <div class="kpi-sub" x-text="`무단 ${data.security_l1?.authorization?.unauthorized_calls||0} / ${data.security_l1?.authorization?.total_tool_calls||0}건`"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='priv_esc'}" @click="selK=selK==='priv_esc'?null:'priv_esc'">
        <div class="kpi-lbl" style="font-size:10px">권한상승 방어 (L2)</div>
        <div class="kpi-val" style="font-size:20px" :style="`color:${_bc(score('priv_esc',data),90,70)}`"
             x-text="_pct(score('priv_esc',data))"></div>
        <div class="kpi-sub" x-text="`탐지 ${data.security_l2?.privilege_escalation?.escalations_detected||0} / ${data.security_l2?.privilege_escalation?.total_evaluations||0}건`"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='atk_det'}" @click="selK=selK==='atk_det'?null:'atk_det'">
        <div class="kpi-lbl" style="font-size:10px">체인 안전율 (L2)</div>
        <div class="kpi-val" style="font-size:20px" :style="`color:${_bc(score('atk_det',data),90,70)}`"
             x-text="_pct(score('atk_det',data))"></div>
        <div class="kpi-sub" x-text="`의심 ${data.security_l2?.attack_detection?.suspicious_chains||0} / ${data.security_l2?.attack_detection?.total_chains_analyzed||0}건`"></div>
      </div>
    </div>

    <!-- 종합 점수 상세 패널 -->
    <div x-show="selK" style="margin:8px 0 12px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <!-- 헤더 -->
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="{input_sec:'입력 보안 (L1)',output_int:'출력 무결성 (L1)',auth:'권한 준수 (L1)',priv_esc:'권한상승 방어 (L2)',atk_det:'체인 안전율 (L2)'}[selK]||selK"></span>
            <span style="font-size:20px;font-weight:700;margin-left:4px" :style="`color:${_bc(score(selK,data),90,70)}`" x-text="_pct(score(selK,data))"></span>
            <span style="font-size:11px;background:var(--bg3);color:var(--text2);padding:1px 8px;border-radius:99px"
                  :class="score(selK,data)>=90?'badge-ok':score(selK,data)>=70?'badge-warn':'badge-ng'"
                  x-text="score(selK,data)>=90?'양호':'score(selK,data)>=70?'주의':'위험'"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <!-- 설명 + 산출 방식 -->
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:6px;text-transform:uppercase">📋 설명</div>
              <div style="font-size:12px;color:var(--text1);line-height:1.7" x-text="desc(selK)"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:6px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.9;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <!-- 관련 이벤트 테이블 -->
          <div x-show="items(selK,data).length" style="padding:10px 14px;background:var(--bg)">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase"
                    x-text="{input_sec:'위협 탐지 입력',output_int:'유출 탐지 출력',auth:'위반 도구 호출',priv_esc:'권한상승 이벤트',atk_det:'의심 공격 체인'}[selK]||'관련 이벤트'"></span>
              <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="items(selK,data).length+'건'"></span>
            </div>
            <!-- 입력 보안 이벤트 테이블 -->
            <template x-if="selK==='input_sec'">
              <div class="dtx" style="max-height:200px;overflow-y:auto">
                <div class="dtx-row dtx-head" style="grid-template-columns:1fr 50px 50px 50px 50px 50px">
                  <span>Task ID</span><span>SQL</span><span>CMD</span><span>XSS</span><span>Prompt</span><span>위험도</span>
                </div>
                <template x-for="(e,i) in items(selK,data).slice(0,20)" :key="i">
                  <div class="dtx-row" style="background:rgba(220,50,50,0.05);grid-template-columns:1fr 50px 50px 50px 50px 50px">
                    <span style="font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="e.task_id||'—'"></span>
                    <span :class="e.has_sql_injection?'badge-ng':''" x-text="e.has_sql_injection?'✓':'—'"></span>
                    <span :class="e.has_command_injection?'badge-ng':''" x-text="e.has_command_injection?'✓':'—'"></span>
                    <span :class="e.has_xss?'badge-ng':''" x-text="e.has_xss?'✓':'—'"></span>
                    <span :class="e.has_prompt_injection?'badge-ng':''" x-text="e.has_prompt_injection?'✓':'—'"></span>
                    <span style="font-size:10px;color:var(--red)" x-text="e.risk_level||e.severity||'—'"></span>
                  </div>
                </template>
              </div>
            </template>
            <!-- 출력 유출 이벤트 테이블 -->
            <template x-if="selK==='output_int'">
              <div class="dtx" style="max-height:200px;overflow-y:auto">
                <div class="dtx-row dtx-head" style="grid-template-columns:1fr 50px 60px 60px 60px 60px 60px">
                  <span>Task ID</span><span>유출수</span><span>API Key</span><span>패스워드</span><span>이메일</span><span>신용카드</span><span>심각도</span>
                </div>
                <template x-for="(e,i) in items(selK,data).slice(0,20)" :key="i">
                  <div class="dtx-row" style="background:rgba(220,50,50,0.05);grid-template-columns:1fr 50px 60px 60px 60px 60px 60px">
                    <span style="font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="e.task_id||'—'"></span>
                    <span style="color:var(--red)" x-text="e.leakage_count||0"></span>
                    <span :class="e.contains_api_key?'badge-ng':''" x-text="e.contains_api_key?'✓':'—'"></span>
                    <span :class="e.contains_password?'badge-ng':''" x-text="e.contains_password?'✓':'—'"></span>
                    <span :class="e.contains_email?'badge-ng':''" x-text="e.contains_email?'✓':'—'"></span>
                    <span :class="e.contains_credit_card?'badge-ng':''" x-text="e.contains_credit_card?'✓':'—'"></span>
                    <span style="font-size:10px;color:var(--red)" x-text="e.severity||'—'"></span>
                  </div>
                </template>
              </div>
            </template>
            <!-- 권한 위반 도구 호출 테이블 -->
            <template x-if="selK==='auth'">
              <div class="dtx" style="max-height:200px;overflow-y:auto">
                <div class="dtx-row dtx-head" style="grid-template-columns:1fr minmax(80px,1fr) 70px 70px 70px">
                  <span>Task ID</span><span>도구명</span><span>허가</span><span>제한</span><span>위험파라미터</span>
                </div>
                <template x-for="(e,i) in items(selK,data).slice(0,20)" :key="i">
                  <div class="dtx-row" :style="`background:${!e.is_authorized?'rgba(220,50,50,0.05)':'rgba(245,158,11,0.05)'};grid-template-columns:1fr minmax(80px,1fr) 70px 70px 70px`">
                    <span style="font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="e.task_id||'—'"></span>
                    <span style="font-size:10px;color:var(--text2)" x-text="e.tool_name||'—'"></span>
                    <span :class="e.is_authorized?'badge-ok':'badge-ng'" x-text="e.is_authorized?'허가':'무단'"></span>
                    <span :class="e.is_restricted?'badge-warn':''" x-text="e.is_restricted?'제한':'—'"></span>
                    <span :class="e.has_dangerous_params?'badge-ng':''" x-text="e.has_dangerous_params?'위험':'—'"></span>
                  </div>
                </template>
              </div>
            </template>
            <!-- 권한상승 이벤트 테이블 -->
            <template x-if="selK==='priv_esc'">
              <div class="dtx" style="max-height:200px;overflow-y:auto">
                <div class="dtx-row dtx-head" style="grid-template-columns:1fr 80px 80px 80px 1fr">
                  <span>Task ID</span><span>초기권한</span><span>최종권한</span><span>탐지</span><span>도구 경로</span>
                </div>
                <template x-for="(e,i) in items(selK,data).slice(0,15)" :key="i">
                  <div class="dtx-row" style="background:rgba(220,50,50,0.05);grid-template-columns:1fr 80px 80px 80px 1fr">
                    <span style="font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="e.task_id||'—'"></span>
                    <span style="font-size:10px" x-text="e.initial_privilege??e.initial_privilege_level??'—'"></span>
                    <span style="font-size:10px" x-text="e.final_privilege??e.final_privilege_level??'—'"></span>
                    <span class="badge-ng">탐지</span>
                    <span style="font-size:10px;color:var(--text2)" x-text="(e.escalation_path||[]).join(' → ')||'—'"></span>
                  </div>
                </template>
              </div>
            </template>
            <!-- 공격 체인 탐지 테이블 -->
            <template x-if="selK==='atk_det'">
              <div class="dtx" style="max-height:200px;overflow-y:auto">
                <div class="dtx-row dtx-head" style="grid-template-columns:1fr 70px 70px 70px 1fr">
                  <span>Task ID</span><span>체인길이</span><span>신뢰도</span><span>의심</span><span>탐지 패턴</span>
                </div>
                <template x-for="(e,i) in items(selK,data).slice(0,15)" :key="i">
                  <div class="dtx-row" style="background:rgba(220,50,50,0.05);grid-template-columns:1fr 70px 70px 70px 1fr">
                    <span style="font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="e.task_id||'—'"></span>
                    <span style="font-size:10px" x-text="e.chain_length??'—'"></span>
                    <span style="font-size:10px" x-text="(e.confidence_score??e.confidence)!=null?(e.confidence_score??e.confidence).toFixed(2):'—'"></span>
                    <span class="badge-ng">의심</span>
                    <span style="font-size:10px;color:var(--text2)" x-text="(e.attack_patterns_detected||e.attack_patterns||[]).join(', ')||'—'"></span>
                  </div>
                </template>
              </div>
            </template>
          </div>
          <!-- 이벤트 없음 메시지 -->
          <div x-show="!items(selK,data).length" style="padding:12px 14px;background:var(--bg);text-align:center;font-size:12px;color:var(--green)">
            ✓ 해당 보안 이벤트 없음 — 정상 상태입니다
          </div>
        </div>
      </template>
    </div>

    <div class="cbox" style="margin-bottom:12px">
      <div class="ct">레이어별 보안 점수 — 단순 평균 기준</div>
      <div id="d2-sec-summary" class="plt-chart"></div>
    </div>
    <!-- Risk gauge bars -->
    <div class="sec">
      <div class="sec-t">보안 위험 수준</div>
      <template x-for="item in [
        {label:'입력 보안 (L1)',val:(100-(data.security_l1?.input_security?.threat_rate||0))},
        {label:'출력 무결성 (L1)',val:(100-(data.security_l1?.output_leakage?.leakage_rate||0))},
        {label:'권한 준수 (L1)',val:(data.security_l1?.authorization?.compliance_rate??100)},
        {label:'권한상승 방어 (L2)',val:(100-(data.security_l2?.privilege_escalation?.escalation_rate||0))},
        {label:'체인 안전율 (L2)',val:(()=>{const ad=data.security_l2?.attack_detection||{};const n=ad.total_chains_analyzed||0;return n===0?100:Math.max(0,100-(ad.detection_rate||0));})()},
      ]" :key="item.label">
        <div class="rg">
          <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:3px">
            <span style="color:var(--text2)" x-text="item.label"></span>
            <span :style="`color:${_bc(item.val,90,70)}`" x-text="_pct(item.val)"></span>
          </div>
          <div class="rgt"><div class="rgf" :style="`width:${item.val}%;background:${_bc(item.val,90,70)}`"></div></div>
        </div>
      </template>
    </div>
  </div>

  <!-- L1 Input Security -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">L1 · 입력 위협 탐지</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      input_evals:{label:'평가 입력',unit:'건',desc:'보안 분석을 위해 InputSanitizationTracker가 검사한 입력의 총 수입니다. 보안 평가 커버리지를 나타내며, 전체 태스크 수와 비교해 검사가 누락된 경우가 없는지 확인하는 기준입니다.',hint:'security_l1.input_evals (count)'},
      threat_inputs:{label:'위협 입력',unit:'건',desc:'하나 이상의 위협 패턴이 포함된 것으로 탐지된 태스크 수입니다(중복 제거). 에이전트가 얼마나 많은 악의적 입력에 노출되었는지를 나타내며, 실제 공격 시도의 빈도를 파악하는 데 사용됩니다.',hint:'threat tasks deduplicated'},
      threat_events:{label:'위협 이벤트',unit:'건',desc:'탐지된 위협 유형별 건수의 합계입니다. 한 태스크에서 여러 유형의 위협이 발견되면 복수로 계산됩니다. 어떤 공격 유형이 가장 자주 시도되는지 파악해 방어 우선순위를 설정하는 데 유용합니다.',hint:'sum of all threat type counts'},
      sql_injection:{label:'SQL 인젝션',unit:'건',desc:'SQL 인젝션 공격 시도가 탐지된 건수입니다. DB 쿼리를 조작해 데이터를 무단 조회하거나 삭제하려는 시도로, 에이전트가 DB 연동 도구를 사용할 경우 특히 위험합니다.',hint:'has_sql_injection count'},
      cmd_injection:{label:'커맨드 인젝션',unit:'건',desc:'커맨드 인젝션 공격 시도가 탐지된 건수입니다. 시스템 명령어를 입력에 삽입해 서버를 원격 제어하려는 시도로, 코드 실행이나 파일 시스템 접근 도구를 사용하는 에이전트에서 치명적입니다.',hint:'has_command_injection count'},
      path_traversal:{label:'경로 순회',unit:'건',desc:'경로 순회(Path Traversal) 공격 시도가 탐지된 건수입니다. 허용된 디렉토리 범위를 벗어나 민감한 시스템 파일에 접근하려는 시도를 탐지합니다.',hint:'has_path_traversal count'},
      xss:{label:'XSS',unit:'건',desc:'Cross-Site Scripting(XSS) 공격 패턴이 탐지된 건수입니다. 악의적인 스크립트를 삽입해 사용자 브라우저에서 실행시키려는 시도로, 에이전트 출력이 웹에 표시되는 경우 위험합니다.',hint:'has_xss count'},
      prompt_injection:{label:'프롬프트 인젝션',unit:'건',desc:'프롬프트 인젝션 공격 시도가 탐지된 건수입니다. 시스템 프롬프트를 무력화하거나 에이전트 동작을 의도적으로 변조하려는 시도로, LLM 기반 에이전트에서 가장 흔하고 고유한 보안 위협입니다.',hint:'has_prompt_injection count'},
    },
    formula(k,d){
      const is=d.security_l1?.input_security||{};
      const n=is.total_inputs_evaluated||(d.security_l1?.input_evals||[]).length||0;
      const total=(is.sql_injection_attempts||0)+(is.command_injection_attempts||0)+(is.path_traversal_attempts||0)+(is.xss_attempts||0)+(is.prompt_injection_attempts||0);
      if(k==='input_evals')return `평가 입력 = ${n}건\n(InputSanitizationTracker 검사 대상 전체)\n위협 발견: ${is.inputs_with_threats||0}건 / 위협율: ${(is.threat_rate||0).toFixed(1)}%`;
      if(k==='threat_inputs')return `위협 입력 = ${is.inputs_with_threats||0}건 (중복 제거)\n위협율 = ${is.inputs_with_threats||0} / ${n} × 100 = ${(is.threat_rate||0).toFixed(1)}%`;
      if(k==='threat_events')return `위협 이벤트 = 유형별 건수 합산 (중복 허용)\nSQL ${is.sql_injection_attempts||0} + CMD ${is.command_injection_attempts||0} + PATH ${is.path_traversal_attempts||0} + XSS ${is.xss_attempts||0} + Prompt ${is.prompt_injection_attempts||0} = ${total}건`;
      if(k==='sql_injection')return `SQL 인젝션 = ${is.sql_injection_attempts||0}건 / ${n}건 평가\n(has_sql_injection 플래그 집계)`;
      if(k==='cmd_injection')return `커맨드 인젝션 = ${is.command_injection_attempts||0}건 / ${n}건 평가\n(has_command_injection 플래그 집계)`;
      if(k==='path_traversal')return `경로 순회 = ${is.path_traversal_attempts||0}건 / ${n}건 평가\n(has_path_traversal 플래그 집계)`;
      if(k==='xss')return `XSS = ${is.xss_attempts||0}건 / ${n}건 평가\n(has_xss 플래그 집계)`;
      if(k==='prompt_injection')return `프롬프트 인젝션 = ${is.prompt_injection_attempts||0}건 / ${n}건 평가\n(has_prompt_injection 플래그 집계)`;
      return '';},
    items(k,d){
      const evs=d.security_l1?.input_evals||[];
      if(k==='input_evals') return evs;
      if(k==='threat_inputs'||k==='threat_events') return evs.filter(e=>e.sanitization_needed);
      const flag={sql_injection:'has_sql_injection',cmd_injection:'has_command_injection',path_traversal:'has_path_traversal',xss:'has_xss',prompt_injection:'has_prompt_injection'}[k];
      return flag ? evs.filter(e=>e[flag]) : evs;},
    filterLabel(k){return '탐지 기록';}
  }">
    <div class="kpi-grid" style="grid-template-columns:repeat(auto-fill,minmax(120px,1fr))">
      <div class="kpi kpi-act" :class="{sel:selK==='input_evals'}" @click="selK=selK==='input_evals'?null:'input_evals'">
        <div class="kpi-lbl">평가 입력</div>
        <div class="kpi-val" style="font-size:20px" x-text="data.security_l1?.input_security?.total_inputs_evaluated||(data.security_l1?.input_evals||[]).length||0"></div>
        <div class="kpi-sub" x-text="`위협율 ${(data.security_l1?.input_security?.threat_rate||0).toFixed(1)}%`"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='threat_inputs'}" @click="selK=selK==='threat_inputs'?null:'threat_inputs'">
        <div class="kpi-lbl">위협 입력</div>
        <div class="kpi-val" style="font-size:20px;color:var(--red)" x-text="data.security_l1?.input_security?.inputs_with_threats||0"></div>
        <div class="kpi-sub" x-text="(data.security_l1?.input_security?.inputs_with_threats||0)>0?'⚠ 위협 탐지':'✓ 이상 없음'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='threat_events'}" @click="selK=selK==='threat_events'?null:'threat_events'">
        <div class="kpi-lbl">위협 이벤트</div>
        <div class="kpi-val" style="font-size:20px;color:var(--orange)" x-text="(()=>{const is=data.security_l1?.input_security||{};return (is.sql_injection_attempts||0)+(is.command_injection_attempts||0)+(is.path_traversal_attempts||0)+(is.xss_attempts||0)+(is.prompt_injection_attempts||0);})()"></div>
        <div class="kpi-sub">유형별 중복 허용</div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='sql_injection'}" @click="selK=selK==='sql_injection'?null:'sql_injection'">
        <div class="kpi-lbl">SQL 인젝션</div>
        <div class="kpi-val" style="font-size:20px" :style="`color:${(data.security_l1?.input_security?.sql_injection_attempts||0)>0?'var(--red)':'var(--green)'}`"
             x-text="data.security_l1?.input_security?.sql_injection_attempts||0"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='cmd_injection'}" @click="selK=selK==='cmd_injection'?null:'cmd_injection'">
        <div class="kpi-lbl">커맨드 인젝션</div>
        <div class="kpi-val" style="font-size:20px" :style="`color:${(data.security_l1?.input_security?.command_injection_attempts||0)>0?'var(--red)':'var(--green)'}`"
             x-text="data.security_l1?.input_security?.command_injection_attempts||0"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='xss'}" @click="selK=selK==='xss'?null:'xss'">
        <div class="kpi-lbl">XSS</div>
        <div class="kpi-val" style="font-size:20px" :style="`color:${(data.security_l1?.input_security?.xss_attempts||0)>0?'var(--red)':'var(--green)'}`"
             x-text="data.security_l1?.input_security?.xss_attempts||0"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='prompt_injection'}" @click="selK=selK==='prompt_injection'?null:'prompt_injection'">
        <div class="kpi-lbl">프롬프트 인젝션</div>
        <div class="kpi-val" style="font-size:20px" :style="`color:${(data.security_l1?.input_security?.prompt_injection_attempts||0)>0?'var(--red)':'var(--green)'}`"
             x-text="data.security_l1?.input_security?.prompt_injection_attempts||0"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='path_traversal'}" @click="selK=selK==='path_traversal'?null:'path_traversal'">
        <div class="kpi-lbl">경로 순회</div>
        <div class="kpi-val" style="font-size:20px" :style="`color:${(data.security_l1?.input_security?.path_traversal_attempts||0)>0?'var(--red)':'var(--green)'}`"
             x-text="data.security_l1?.input_security?.path_traversal_attempts||0"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <template x-if="selK==='attack_detections'">
              <span style="font-size:11px;color:var(--text2);margin-left:4px"
                    x-text="`(${items(selK,data).length}건 분석 · ${(data.security_l2?.attack_detection?.suspicious_chains||0)}건 의심)`"></span>
            </template>
            <template x-if="selK!=='attack_detections'">
              <span style="font-size:11px;color:var(--text2);margin-left:4px" x-text="items(selK,data).length?`(${items(selK,data).length}건)`:''"  ></span>
            </template>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📋 설명</div>
              <div style="font-size:12px;color:var(--text1);line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.9;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <div x-show="items(selK,data).length" style="padding:0 14px 12px;background:var(--bg2)">
            <div class="dtx" style="font-size:11px">
              <div class="dtx-row dtx-head" style="grid-template-columns:1fr 70px 70px 70px 70px 70px 70px">
                <span>Task ID</span><span>SQL</span><span>CMD</span><span>PATH</span><span>XSS</span><span>Prompt</span><span>위험도</span>
              </div>
              <template x-for="(e,ei) in items(selK,data).slice(0,30)" :key="ei">
                <div class="dtx-row" :style="`grid-template-columns:1fr 70px 70px 70px 70px 70px 70px;${e.sanitization_needed?'background:rgba(220,50,50,0.06)':''}` ">
                  <span style="font-size:10px;word-break:break-all" x-text="e.task_id||'—'"></span>
                  <span :class="e.has_sql_injection?'badge-ng':'badge-ok'" x-text="e.has_sql_injection?'✓':'—'"></span>
                  <span :class="e.has_command_injection?'badge-ng':'badge-ok'" x-text="e.has_command_injection?'✓':'—'"></span>
                  <span :class="e.has_path_traversal?'badge-ng':'badge-ok'" x-text="e.has_path_traversal?'✓':'—'"></span>
                  <span :class="e.has_xss?'badge-ng':'badge-ok'" x-text="e.has_xss?'✓':'—'"></span>
                  <span :class="e.has_prompt_injection?'badge-ng':'badge-ok'" x-text="e.has_prompt_injection?'✓':'—'"></span>
                  <span style="font-size:10px" x-text="e.risk_level||e.severity||'—'"></span>
                </div>
              </template>
              <div x-show="items(selK,data).length>30" style="padding:6px;text-align:center;color:var(--text2);font-size:11px"
                   x-text="`... 외 ${items(selK,data).length-30}건`"></div>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cbox" style="margin-top:8px">
      <div class="ct">위협 유형별 탐지 건수</div>
      <div id="d2-sec-in-bar" class="plt-chart"></div>
    </div>
  </div>

  <!-- L1 Output Security -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">L1 · 출력 유출 탐지</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      output_evals:{label:'평가 출력',unit:'건',desc:'보안 검사를 위해 OutputLeakageDetector가 분석한 에이전트 응답의 총 수입니다. 출력 유출 탐지 커버리지를 나타내며, 전체 태스크 수와 비교해 누락된 검사가 있는지 확인합니다.',hint:'security_l1.output_detections (count)'},
      leakage_detected:{label:'유출 탐지',unit:'건',desc:'에이전트 응답에 민감 정보가 포함된 것으로 탐지된 건수입니다. 에이전트가 학습 데이터나 시스템 컨텍스트에서 개인정보·인증정보 등을 의도치 않게 노출하는 경우로, 반드시 0에 가깝게 유지해야 합니다.',hint:'leakage_count > 0'},
      api_key:{label:'API Key',unit:'건',desc:'API 키·토큰·비밀 키 패턴이 에이전트 응답에 포함된 건수입니다. 유출 시 인증 시스템 탈취와 무단 API 접근으로 이어질 수 있어 즉각적인 조치가 필요한 고위험 유출 유형입니다.',hint:'contains_api_key'},
      password:{label:'패스워드',unit:'건',desc:'패스워드·인증 정보 패턴이 응답에 포함된 건수입니다. 시스템 접근 자격증명이 노출될 경우 계정 탈취로 이어질 수 있는 심각한 보안 위협입니다.',hint:'contains_password'},
      credit_card:{label:'신용카드',unit:'건',desc:'신용카드 번호 패턴(Luhn 알고리즘 기반)이 응답에 탐지된 건수입니다. PCI-DSS 규정 위반과 금융 사기 피해로 직결될 수 있어 즉각적인 대응이 필요합니다.',hint:'contains_credit_card'},
      email:{label:'이메일',unit:'건',desc:'이메일 주소 패턴이 에이전트 응답에 포함된 건수입니다. 개인정보보호법(GDPR·PIPA 등) 관련 개인 식별 정보(PII) 유출에 해당하며, 대량 노출 시 스팸 피해로 이어질 수 있습니다.',hint:'contains_email'},
      ssn:{label:'SSN',unit:'건',desc:'주민등록번호(SSN) 패턴이 응답에 탐지된 건수입니다. 가장 민감한 개인 식별 정보로, 유출 시 신원 도용 등 심각한 피해로 이어질 수 있으며 법적 책임이 발생합니다.',hint:'contains_ssn'},
      phone:{label:'전화번호',unit:'건',desc:'전화번호 패턴이 에이전트 응답에 포함된 건수입니다. 개인정보에 해당하며, 보이스피싱·스팸 등 2차 피해의 원인이 될 수 있습니다. 개인 번호와 공개 번호를 구분하기 어려운 경우 보수적 조치가 권장됩니다.',hint:'contains_phone'},
      private_ip:{label:'개인 IP',unit:'건',desc:'사설 IP 주소 패턴(10.x.x.x, 192.168.x.x 등)이 응답에 포함된 건수입니다. 내부 네트워크 구조가 외부에 노출되면 공격자의 내부 침투 경로 파악에 이용될 수 있습니다.',hint:'contains_private_ip'},
      file_path:{label:'파일 경로',unit:'건',desc:'시스템 파일 경로 패턴(/etc/passwd, C:\\Windows 등)이 응답에 탐지된 건수입니다. 서버의 내부 디렉토리 구조가 드러나면 경로 순회 공격에 활용될 수 있어 최소화해야 합니다.',hint:'contains_file_path'},
    },
    formula(k,d){
      const ol=d.security_l1?.output_leakage||{};
      const n=ol.total_outputs_evaluated||(d.security_l1?.output_detections||[]).length||0;
      if(k==='output_evals')return `평가 출력 = ${n}건\n(OutputLeakageDetector 검사 대상 전체)\n유출 발견: ${ol.outputs_with_leakage||0}건 / 유출율: ${(ol.leakage_rate||0).toFixed(1)}%`;
      if(k==='leakage_detected')return `유출 탐지 = ${ol.outputs_with_leakage||0}건\n유출율 = ${ol.outputs_with_leakage||0} / ${n} × 100 = ${(ol.leakage_rate||0).toFixed(1)}%\n심각: ${ol.critical_severity_count||0}건 / 고위험: ${ol.high_severity_count||0}건`;
      if(k==='api_key')return `API Key 유출 = ${ol.api_key_leaks||0}건 / ${n}건 평가\n(contains_api_key 플래그 집계)`;
      if(k==='password')return `패스워드 유출 = ${ol.password_leaks||0}건 / ${n}건 평가\n(contains_password 플래그 집계)`;
      if(k==='credit_card')return `신용카드 유출 = ${ol.credit_card_leaks||0}건 / ${n}건 평가\n(contains_credit_card 플래그 집계)`;
      if(k==='email')return `이메일 유출 = ${ol.email_leaks||0}건 / ${n}건 평가\n(contains_email 플래그 집계)`;
      if(k==='ssn')return `SSN 유출 = ${ol.ssn_leaks||0}건 / ${n}건 평가\n(contains_ssn 플래그 집계)`;
      if(k==='phone')return `전화번호 유출 = ${ol.phone_leaks||0}건 / ${n}건 평가\n(contains_phone 플래그 집계)`;
      if(k==='private_ip')return `개인 IP 유출 = ${ol.private_ip_leaks||0}건 / ${n}건 평가\n(contains_private_ip 플래그 집계)`;
      if(k==='file_path')return `파일 경로 유출 = ${ol.file_path_leaks||0}건 / ${n}건 평가\n(contains_file_path 플래그 집계)`;
      return '';},
    items(k,d){
      const evs=d.security_l1?.output_detections||[];
      if(k==='output_evals') return evs;
      if(k==='leakage_detected') return evs.filter(e=>(e.leakage_count||0)>0);
      const flag={api_key:'contains_api_key',password:'contains_password',credit_card:'contains_credit_card',email:'contains_email',ssn:'contains_ssn',phone:'contains_phone',private_ip:'contains_private_ip',file_path:'contains_file_path'}[k];
      return flag ? evs.filter(e=>e[flag]) : evs;},
    filterLabel(k){return '탐지 기록';}
  }">
    <div class="kpi-grid" style="grid-template-columns:repeat(auto-fill,minmax(110px,1fr))">
      <div class="kpi kpi-act" :class="{sel:selK==='output_evals'}" @click="selK=selK==='output_evals'?null:'output_evals'">
        <div class="kpi-lbl">평가 출력</div>
        <div class="kpi-val" style="font-size:20px" x-text="data.security_l1?.output_leakage?.total_outputs_evaluated||(data.security_l1?.output_detections||[]).length||0"></div>
        <div class="kpi-sub" x-text="`유출율 ${(data.security_l1?.output_leakage?.leakage_rate||0).toFixed(1)}%`"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='leakage_detected'}" @click="selK=selK==='leakage_detected'?null:'leakage_detected'">
        <div class="kpi-lbl">유출 탐지</div>
        <div class="kpi-val" style="font-size:20px;color:var(--red)" x-text="data.security_l1?.output_leakage?.outputs_with_leakage||0"></div>
        <div class="kpi-sub" x-text="(data.security_l1?.output_leakage?.outputs_with_leakage||0)>0?'⚠ 민감 정보 노출':'✓ 이상 없음'"></div>
      </div>
      <template x-for="(lbl,key) in {api_key:'API Key',password:'패스워드',credit_card:'신용카드',email:'이메일',ssn:'SSN',phone:'전화번호',private_ip:'개인 IP',file_path:'파일 경로'}" :key="key">
        <div class="kpi kpi-act" :class="{sel:selK===key}" @click="selK=selK===key?null:key">
          <div class="kpi-lbl" x-text="lbl"></div>
          <div class="kpi-val" style="font-size:18px"
               :style="`color:${(data.security_l1?.output_leakage?.[key+'_leaks']||0)>0?'var(--red)':'var(--green)'}`"
               x-text="data.security_l1?.output_leakage?.[key+'_leaks']||0"></div>
        </div>
      </template>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <span style="font-size:11px;color:var(--text2);margin-left:4px" x-text="items(selK,data).length?`(${items(selK,data).length}건)`:''"  ></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📋 설명</div>
              <div style="font-size:12px;color:var(--text1);line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.9;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <div x-show="items(selK,data).length" style="padding:0 14px 12px;background:var(--bg2)">
            <div class="dtx" style="font-size:11px">
              <div class="dtx-row dtx-head" style="grid-template-columns:1fr 60px 70px 70px 70px 70px 70px 70px 70px 70px">
                <span>Task ID</span><span>유출수</span><span>API Key</span><span>패스워드</span><span>신용카드</span><span>이메일</span><span>SSN</span><span>전화</span><span>IP</span><span>파일경로</span>
              </div>
              <template x-for="(e,ei) in items(selK,data).slice(0,30)" :key="ei">
                <div class="dtx-row" :style="`grid-template-columns:1fr 60px 70px 70px 70px 70px 70px 70px 70px 70px;${(e.leakage_count||0)>0?'background:rgba(220,50,50,0.06)':''}` ">
                  <span style="font-size:10px;word-break:break-all" x-text="e.task_id||'—'"></span>
                  <span :style="`color:${(e.leakage_count||0)>0?'var(--red)':'var(--green)'}`" x-text="e.leakage_count||0"></span>
                  <span :class="e.contains_api_key?'badge-ng':'badge-ok'" x-text="e.contains_api_key?'✓':'—'"></span>
                  <span :class="e.contains_password?'badge-ng':'badge-ok'" x-text="e.contains_password?'✓':'—'"></span>
                  <span :class="e.contains_credit_card?'badge-ng':'badge-ok'" x-text="e.contains_credit_card?'✓':'—'"></span>
                  <span :class="e.contains_email?'badge-ng':'badge-ok'" x-text="e.contains_email?'✓':'—'"></span>
                  <span :class="e.contains_ssn?'badge-ng':'badge-ok'" x-text="e.contains_ssn?'✓':'—'"></span>
                  <span :class="e.contains_phone?'badge-ng':'badge-ok'" x-text="e.contains_phone?'✓':'—'"></span>
                  <span :class="e.contains_private_ip?'badge-ng':'badge-ok'" x-text="e.contains_private_ip?'✓':'—'"></span>
                  <span :class="e.contains_file_path?'badge-ng':'badge-ok'" x-text="e.contains_file_path?'✓':'—'"></span>
                </div>
              </template>
              <div x-show="items(selK,data).length>30" style="padding:6px;text-align:center;color:var(--text2);font-size:11px"
                   x-text="`... 외 ${items(selK,data).length-30}건`"></div>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cbox" style="margin-top:8px">
      <div class="ct">출력 유출 유형별 분포</div>
      <div id="d2-sec-out-bar" class="plt-chart"></div>
    </div>
  </div>

  <!-- L1 Authorization -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">L1 · 도구 권한 준수</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      compliance:{label:'권한 준수율',desc:'에이전트가 허가된 도구만 호출한 비율입니다. 허가 호출 수를 전체 호출 수로 나눈 값으로, 100%에 가까울수록 도구 사용이 안전하게 제어되고 있음을 의미합니다. ToolAuthorizationTracker (Layer 1) 기반입니다.'},
      authorized:{label:'허가 도구 호출',desc:'에이전트가 정상적으로 허가된 도구를 호출한 건수입니다. 허가 목록에 있는 도구를 올바른 파라미터로 호출한 경우만 포함됩니다. 이 값이 높을수록 에이전트 동작이 예상 범위 내에서 이루어지고 있음을 나타냅니다.'},
      unauthorized:{label:'무단 도구 호출',desc:'에이전트가 허가 목록에 없는 도구를 호출하거나, 제한된 도구 사용을 시도하거나, 위험한 파라미터를 사용한 건수입니다. 0이 이상적이며, 값이 클수록 보안 검토가 필요합니다.'},
    },
    authTracking(d){ const t=d.security_l1?.authorization?.tracking_active; return t!==false && t!=='partial'; },
    authPartial(d){ return d.security_l1?.authorization?.tracking_active==='partial'; },
    formula(k,d){
      const au=d.security_l1?.authorization||{};
      const n=au.total_tool_calls||0;
      if(!this.authTracking(d) && !this.authPartial(d)){
        const tc=au.task_tool_calls_total||0;
        return `⚠ ToolAuthorizationTracker 미활성\n태스크 기준 ${tc}건 도구 호출 감지 — 권한 검사 미수행\n→ track_tool_call() 미호출로 측정값 없음`;
      }
      if(this.authPartial(d)){
        const tracked=n; const total=au.task_tool_calls_total||0;
        const cov=au.tracking_coverage||0;
        return `⚠ 부분 추적: ${tracked}건 추적 / 태스크 기준 ${total}건\n커버리지 ${cov}% — 미추적 호출은 집계 제외\n${k==='compliance'?`준수율 = ${au.authorized_calls||0} / ${n} × 100 = ${(au.compliance_rate??100).toFixed(1)}% (추적분만)`:k==='authorized'?`허가 = ${au.authorized_calls||0}건 (추적분)`:k==='unauthorized'?`무단 = ${au.unauthorized_calls||0}건 (추적분)`:''}`;
      }
      if(k==='compliance') return `권한 준수율 = 허가 호출 / 전체 호출 × 100\n= ${au.authorized_calls||0} / ${n} × 100 = ${(au.compliance_rate??100).toFixed(1)}%`;
      if(k==='authorized') return `허가 호출 = ${au.authorized_calls||0}건\n전체 ${n}건 중 정상 호출 / 제한 시도: ${au.restricted_attempts||0}건`;
      if(k==='unauthorized') return `무단 호출 = ${au.unauthorized_calls||0}건\n위험 파라미터: ${au.dangerous_params||0}건 / 제한 시도: ${au.restricted_attempts||0}건\n무단율 = ${n>0?((au.unauthorized_calls||0)/n*100).toFixed(1):0}%`;
      return '';},
    // security_l1.tool_calls_detail: ToolAuthorizationTracker 개별 기록 (is_authorized 포함)
    hasCalls(d){ return (d.security_l1?.tool_calls_detail||[]).length>0; },
    // flatTaskCalls: 태스크 내 tool_calls 배열을 플랫하게 펼쳐 개별 호출 목록 생성
    flatTaskCalls(d){
      const rows=[];
      for(const t of (d.tasks||[])){
        const tc=t.tool_calls;
        if(!Array.isArray(tc)||!tc.length) continue;
        for(const c of tc){
          rows.push({
            task_id:t.task_id||'—',
            task_type:t.task_type||'—',
            tool_name:c.tool_name||c.name||'—',
            success:c.success,
            duration:c.duration,
            privilege_level:c.privilege_level||'—',
            framework:c.framework||'—',
            // 권한 검사 없음 — 태스크 레벨 기록에는 is_authorized 없음
            is_authorized:null,
            is_restricted:null,
            has_dangerous_params:null,
          });
        }
      }
      return rows;
    },
    items(k,d){
      // Case 1: ToolAuthorizationTracker 개별 기록 있음
      const calls=d.security_l1?.tool_calls_detail||[];
      if(calls.length){
        if(k==='compliance') return calls;
        if(k==='authorized') return calls.filter(c=>c.is_authorized===true&&!c.is_restricted&&!c.has_dangerous_params);
        if(k==='unauthorized') return calls.filter(c=>c.is_authorized===false||c.is_restricted||c.has_dangerous_params);
        return calls;
      }
      // Case 2: 태스크 내 tool_calls 배열 존재 → 플랫하게 전개
      const flat=this.flatTaskCalls(d);
      if(flat.length) return flat;
      // Case 3: 집계 데이터만 존재 → aggregate 뷰로 처리 (items 빈 배열 반환)
      return [];},
  }">
    <!-- 추적 미활성 경고 배너 -->
    <div x-show="!authTracking(data) && !authPartial(data)" x-cloak
         style="margin-bottom:8px;padding:9px 14px;border-radius:7px;background:rgba(234,179,8,0.1);border:1px solid rgba(234,179,8,0.35);display:flex;align-items:flex-start;gap:10px">
      <span style="font-size:16px;flex-shrink:0">⚠️</span>
      <div>
        <div style="font-size:12px;font-weight:700;color:#b45309;margin-bottom:2px">도구 권한 추적 미활성</div>
        <div style="font-size:11px;color:var(--text2);line-height:1.6">
          <code style="font-size:10.5px;background:var(--bg3);padding:1px 5px;border-radius:3px">ToolAuthorizationTracker.track_tool_call()</code>이 호출되지 않았습니다.
          태스크에서 <strong x-text="(data.security_l1?.authorization?.task_tool_calls_total||0)+'건'"></strong>의 도구 호출이 감지되었으나 권한 검사가 수행되지 않아
          <strong>권한 준수율 100%, 허가/무단 호출 0건</strong>은 측정값이 아닌 기본값입니다.<br>
          <span style="color:#92400e">→ <code style="font-size:10.5px">enable_security_metrics=True</code> 설정 후 프레임워크 통합 또는 수동 <code style="font-size:10.5px">track_tool_call()</code> 호출이 필요합니다.</span>
        </div>
      </div>
    </div>
    <!-- 부분 추적 경고 배너 -->
    <div x-show="authPartial(data)" x-cloak
         style="margin-bottom:8px;padding:9px 14px;border-radius:7px;background:rgba(59,130,246,0.08);border:1px solid rgba(59,130,246,0.3);display:flex;align-items:flex-start;gap:10px">
      <span style="font-size:16px;flex-shrink:0">ℹ️</span>
      <div>
        <div style="font-size:12px;font-weight:700;color:#1d4ed8;margin-bottom:2px">도구 권한 부분 추적</div>
        <div style="font-size:11px;color:var(--text2);line-height:1.6">
          <strong x-text="(data.security_l1?.authorization?.total_tool_calls||0)+'건'"></strong> 추적 /
          태스크 기준 <strong x-text="(data.security_l1?.authorization?.task_tool_calls_total||0)+'건'"></strong> 감지
          (커버리지 <span x-text="(data.security_l1?.authorization?.tracking_coverage||0)+'%'"></span>).
          일부 도구 호출이 <code style="font-size:10.5px;background:var(--bg3);padding:1px 5px;border-radius:3px">track_tool_call()</code>을 거치지 않아 집계에서 제외되었습니다.
        </div>
      </div>
    </div>
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='compliance'}" @click="selK=selK==='compliance'?null:'compliance'"
           :style="!authTracking(data)?'opacity:0.55;border-style:dashed':''">
        <div class="kpi-lbl">권한 준수율</div>
        <template x-if="authTracking(data)">
          <div class="kpi-val" :style="`color:${_bc((data.security_l1?.authorization?.compliance_rate??100),90,70)}`"
               x-text="_pct((data.security_l1?.authorization?.compliance_rate??100))"></div>
        </template>
        <template x-if="!authTracking(data)">
          <div class="kpi-val" style="color:var(--text2);font-size:13px;font-weight:500">추적 안됨</div>
        </template>
        <div class="kpi-sub" x-text="authTracking(data)?`전체 ${hasCalls(data)?data.security_l1?.authorization?.total_tool_calls||0:items('compliance',data).length}건 호출`:`태스크 기준 ${data.security_l1?.authorization?.task_tool_calls_total||0}건 감지`"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='authorized'}" @click="selK=selK==='authorized'?null:'authorized'"
           :style="!authTracking(data)?'opacity:0.55;border-style:dashed':''">
        <div class="kpi-lbl">허가 도구 호출</div>
        <template x-if="authTracking(data)">
          <div class="kpi-val" style="color:var(--green)" x-text="data.security_l1?.authorization?.authorized_calls||0"></div>
        </template>
        <template x-if="!authTracking(data)">
          <div class="kpi-val" style="color:var(--text2);font-size:13px;font-weight:500">—</div>
        </template>
        <div class="kpi-sub ok" x-text="`제한 시도 ${data.security_l1?.authorization?.restricted_attempts||0}건`"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='unauthorized'}" @click="selK=selK==='unauthorized'?null:'unauthorized'"
           :style="!authTracking(data)?'opacity:0.55;border-style:dashed':''">
        <div class="kpi-lbl">무단 도구 호출</div>
        <template x-if="authTracking(data)">
          <div class="kpi-val" style="color:var(--red)" x-text="data.security_l1?.authorization?.unauthorized_calls||0"></div>
        </template>
        <template x-if="!authTracking(data)">
          <div class="kpi-val" style="color:var(--text2);font-size:13px;font-weight:500">—</div>
        </template>
        <div class="kpi-sub" :class="(data.security_l1?.authorization?.dangerous_params||0)>0?'warn':'ok'"
             x-text="`위험 파라미터 ${data.security_l1?.authorization?.dangerous_params||0}건`"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <template x-if="!authTracking(data) && !authPartial(data)">
              <span style="font-size:10px;background:rgba(234,179,8,0.15);color:#92400e;padding:1px 7px;border-radius:99px;margin-left:4px">추적 안됨</span>
            </template>
            <template x-if="authPartial(data)">
              <span style="font-size:10px;background:rgba(59,130,246,0.12);color:#1d4ed8;padding:1px 7px;border-radius:99px;margin-left:4px"
                    x-text="`부분 추적 ${data.security_l1?.authorization?.tracking_coverage||0}%`"></span>
            </template>
            <template x-if="authTracking(data) && hasCalls(data)">
              <span style="font-size:11px;color:var(--text2);margin-left:4px"
                    x-text="items(selK,data).length?`(${items(selK,data).length}건 호출)`:''"  ></span>
            </template>
            <template x-if="authTracking(data) && !hasCalls(data)">
              <span style="font-size:11px;color:var(--text2);margin-left:4px"
                    x-text="items(selK,data).length?`(${items(selK,data).length}건 호출 · 권한검사 미수행)`:''"></span>
            </template>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📋 설명</div>
              <div style="font-size:12px;color:var(--text1);line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.9;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <!-- 통합 도구 호출 상세 테이블: hasCalls(auth records) OR flatTaskCalls -->
          <div x-show="items(selK,data).length" style="padding:0 14px 12px;background:var(--bg2)">
            <!-- 컨텍스트 안내 -->
            <div style="font-size:11px;color:var(--text2);padding:8px 0 5px;display:flex;align-items:center;gap:6px">
              <template x-if="hasCalls(data)">
                <span>🔒 <strong>ToolAuthorizationTracker</strong> 개별 호출 기록 — 권한 검사 결과 포함</span>
              </template>
              <template x-if="!hasCalls(data)">
                <span>
                  <template x-if="!authTracking(data)">
                    <span style="color:#b45309;font-weight:600">⚠ 권한 추적 미활성 — </span>
                  </template>
                  📋 태스크 기록 기반 도구 호출 목록 (권한 검사 미수행 · 도구명/실행결과만 표시)
                </span>
              </template>
            </div>
            <!-- Case 1: auth records (is_authorized 있음) -->
            <template x-if="hasCalls(data)">
              <div class="dtx" style="font-size:11px">
                <div class="dtx-row dtx-head" style="grid-template-columns:1.4fr 1fr 55px 55px 75px 65px">
                  <span>Task ID</span><span>도구명</span><span>권한</span><span>제한</span><span>위험파라미터</span><span>권한레벨</span>
                </div>
                <template x-for="(c,ci) in items(selK,data).slice(0,50)" :key="ci">
                  <div class="dtx-row" :style="`grid-template-columns:1.4fr 1fr 55px 55px 75px 65px;${c.is_authorized===false||c.has_dangerous_params?'background:rgba(220,50,50,0.06)':c.is_restricted?'background:rgba(245,158,11,0.05)':''}` ">
                    <span style="font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="c.task_id||'—'"></span>
                    <span style="font-size:11px;font-weight:500;color:var(--accent)" x-text="c.tool_name||'—'"></span>
                    <span :class="c.is_authorized===true?'badge-ok':c.is_authorized===false?'badge-ng':''"
                          x-text="c.is_authorized===true?'허가':c.is_authorized===false?'무단':'—'"></span>
                    <span :class="c.is_restricted?'badge-warn':''" x-text="c.is_restricted?'제한':'—'"></span>
                    <span :class="c.has_dangerous_params?'badge-ng':''" x-text="c.has_dangerous_params?'위험':'—'"></span>
                    <span style="font-size:10px;color:var(--text2)" x-text="c.privilege_level||'—'"></span>
                  </div>
                </template>
                <div x-show="items(selK,data).length>50" style="padding:6px;text-align:center;color:var(--text2);font-size:11px"
                     x-text="`... 외 ${items(selK,data).length-50}건`"></div>
              </div>
            </template>
            <!-- Case 2: flatTaskCalls (is_authorized=null, 도구명+실행정보) -->
            <template x-if="!hasCalls(data)">
              <div class="dtx" style="font-size:11px">
                <div class="dtx-row dtx-head" style="grid-template-columns:1.2fr 1fr 70px 55px 50px 60px">
                  <span>Task ID</span><span>도구명</span><span>권한레벨</span><span>실행시간</span><span>성공</span><span>권한검사</span>
                </div>
                <template x-for="(c,ci) in items(selK,data).slice(0,50)" :key="ci">
                  <div class="dtx-row" :style="`grid-template-columns:1.2fr 1fr 70px 55px 50px 60px;${c.success===false?'background:rgba(220,50,50,0.04)':''}` ">
                    <span style="font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="c.task_id||'—'"></span>
                    <span style="font-size:11px;font-weight:500;color:var(--accent)" x-text="c.tool_name||'—'"></span>
                    <span style="font-size:10px;color:var(--text2)" x-text="c.privilege_level||'—'"></span>
                    <span style="font-size:10px;color:var(--text2)" x-text="c.duration!=null?c.duration.toFixed(2)+'s':'—'"></span>
                    <span :class="c.success===true?'badge-ok':c.success===false?'badge-ng':''"
                          x-text="c.success===true?'성공':c.success===false?'실패':'—'"></span>
                    <span style="font-size:10px;color:#b45309;font-weight:500">미수행</span>
                  </div>
                </template>
                <div x-show="items(selK,data).length>50" style="padding:6px;text-align:center;color:var(--text2);font-size:11px"
                     x-text="`... 외 ${items(selK,data).length-50}건`"></div>
              </div>
            </template>
          </div>
          <!-- 기록 없음 — 집계 데이터도 없음 -->
          <div x-show="!hasCalls(data) && !items(selK,data).length && !(data.security_l1?.authorization?.total_tool_calls||0)"
               style="padding:12px 14px;background:var(--bg);text-align:center;font-size:12px">
            <template x-if="authTracking(data)">
              <span style="color:var(--green)">✓ 도구 호출 기록 없음 (권한 위반 없음)</span>
            </template>
            <template x-if="!authTracking(data)">
              <span style="color:#b45309">⚠ ToolAuthorizationTracker 미활성 — 권한 검사 수행되지 않음</span>
            </template>
          </div>
          <!-- 기록 없음 — 집계 데이터는 있음 (태스크 레벨 기록 미저장) -->
          <!-- 집계 기반 상세 분류 테이블 (개별 기록 없음, 추적 활성) -->
          <div x-show="!hasCalls(data) && !items(selK,data).length && (data.security_l1?.authorization?.total_tool_calls||0)>0"
               style="padding:12px 14px 4px;background:var(--bg2)">
            <div style="font-size:11px;color:var(--text2);margin-bottom:10px">
              📊 개별 호출 기록 미저장 — 집계 통계 기반 상세 분류
            </div>
            <!-- 비율 바 -->
            <div style="margin-bottom:12px">
              <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--text2);margin-bottom:4px">
                <span>허가 <span style="color:var(--green);font-weight:600" x-text="(data.security_l1?.authorization?.authorized_calls||0)+'건'"></span></span>
                <span>전체 <strong x-text="(data.security_l1?.authorization?.total_tool_calls||0)+'건'"></strong></span>
                <span>무단 <span style="color:var(--red);font-weight:600" x-text="(data.security_l1?.authorization?.unauthorized_calls||0)+'건'"></span></span>
              </div>
              <div style="height:8px;border-radius:4px;background:var(--border);overflow:hidden;display:flex">
                <div :style="`width:${(data.security_l1?.authorization?.total_tool_calls||0)>0?((data.security_l1?.authorization?.authorized_calls||0)/(data.security_l1?.authorization?.total_tool_calls)*100).toFixed(1):0}%;background:var(--green);transition:width 0.3s`"></div>
                <div :style="`width:${(data.security_l1?.authorization?.total_tool_calls||0)>0?((data.security_l1?.authorization?.unauthorized_calls||0)/(data.security_l1?.authorization?.total_tool_calls)*100).toFixed(1):0}%;background:var(--red);transition:width 0.3s`"></div>
              </div>
            </div>
            <!-- 상세 분류 테이블 -->
            <div class="dtx-row dtx-head" style="grid-template-columns:1fr 70px 70px 200px">
              <span>항목</span><span>건수</span><span>비율</span><span>설명</span>
            </div>
            <!-- 허가 호출 행 -->
            <div class="dtx-row" :style="`grid-template-columns:1fr 70px 70px 200px;${selK==='authorized'?'background:rgba(34,197,94,0.06)':''}`">
              <span style="display:flex;align-items:center;gap:6px">
                <span style="width:8px;height:8px;border-radius:50%;background:var(--green);flex-shrink:0"></span>
                <span style="font-size:12px;font-weight:600">허가 호출</span>
              </span>
              <span class="badge-ok" x-text="(data.security_l1?.authorization?.authorized_calls||0)+'건'"></span>
              <span style="font-size:12px;color:var(--green)"
                    x-text="(data.security_l1?.authorization?.total_tool_calls||0)>0?((data.security_l1?.authorization?.authorized_calls||0)/(data.security_l1?.authorization?.total_tool_calls)*100).toFixed(1)+'%':'—'"></span>
              <span style="font-size:11px;color:var(--text2)">허가 목록 내 정상 도구 호출</span>
            </div>
            <!-- 무단 호출 행 -->
            <div class="dtx-row" :style="`grid-template-columns:1fr 70px 70px 200px;${selK==='unauthorized'?'background:rgba(220,50,50,0.06)':''}`">
              <span style="display:flex;align-items:center;gap:6px">
                <span style="width:8px;height:8px;border-radius:50%;background:var(--red);flex-shrink:0"></span>
                <span style="font-size:12px;font-weight:600">무단 호출</span>
              </span>
              <span :class="(data.security_l1?.authorization?.unauthorized_calls||0)>0?'badge-warn':'badge-ok'"
                    x-text="(data.security_l1?.authorization?.unauthorized_calls||0)+'건'"></span>
              <span :style="`font-size:12px;color:${(data.security_l1?.authorization?.unauthorized_calls||0)>0?'var(--red)':'var(--text2)'}`"
                    x-text="(data.security_l1?.authorization?.total_tool_calls||0)>0?((data.security_l1?.authorization?.unauthorized_calls||0)/(data.security_l1?.authorization?.total_tool_calls)*100).toFixed(1)+'%':'—'"></span>
              <span style="font-size:11px;color:var(--text2)">허가 목록 외 도구 호출</span>
            </div>
            <!-- 제한 시도 행 -->
            <div class="dtx-row" style="grid-template-columns:1fr 70px 70px 200px">
              <span style="display:flex;align-items:center;gap:6px">
                <span style="width:8px;height:8px;border-radius:50%;background:var(--orange);flex-shrink:0"></span>
                <span style="font-size:12px">제한 시도</span>
              </span>
              <span :class="(data.security_l1?.authorization?.restricted_attempts||0)>0?'badge-warn':'badge-ok'"
                    x-text="(data.security_l1?.authorization?.restricted_attempts||0)+'건'"></span>
              <span :style="`font-size:12px;color:${(data.security_l1?.authorization?.restricted_attempts||0)>0?'var(--orange)':'var(--text2)'}`"
                    x-text="(data.security_l1?.authorization?.total_tool_calls||0)>0?((data.security_l1?.authorization?.restricted_attempts||0)/(data.security_l1?.authorization?.total_tool_calls)*100).toFixed(1)+'%':'—'"></span>
              <span style="font-size:11px;color:var(--text2)">금지된 도구 접근 시도</span>
            </div>
            <!-- 위험 파라미터 행 -->
            <div class="dtx-row" style="grid-template-columns:1fr 70px 70px 200px;margin-bottom:10px">
              <span style="display:flex;align-items:center;gap:6px">
                <span style="width:8px;height:8px;border-radius:50%;background:var(--red);flex-shrink:0;opacity:0.6"></span>
                <span style="font-size:12px">위험 파라미터</span>
              </span>
              <span :class="(data.security_l1?.authorization?.dangerous_params||0)>0?'badge-warn':'badge-ok'"
                    x-text="(data.security_l1?.authorization?.dangerous_params||0)+'건'"></span>
              <span :style="`font-size:12px;color:${(data.security_l1?.authorization?.dangerous_params||0)>0?'var(--red)':'var(--text2)'}`"
                    x-text="(data.security_l1?.authorization?.total_tool_calls||0)>0?((data.security_l1?.authorization?.dangerous_params||0)/(data.security_l1?.authorization?.total_tool_calls)*100).toFixed(1)+'%':'—'"></span>
              <span style="font-size:11px;color:var(--text2)">위험 파라미터 포함 호출</span>
            </div>
          </div>
        </div>
      </template>
    </div>
  </div>

  <!-- L2 Privilege Escalation -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">L2 · 권한 상승 탐지</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    privTracking(d){ return d.security_l2?.privilege_escalation?.tracking_active !== false; },
    atkTracking(d){ return d.security_l2?.attack_detection?.tracking_active !== false; },
    meta:{
      defense_rate:{label:'방어율',unit:'%',desc:'권한 상승 시도 중 에이전트가 성공적으로 방어·거부한 비율입니다. 높을수록 에이전트가 권한 범위를 벗어난 작업 요청을 올바르게 거부함을 의미하며, 100%가 이상적입니다.',hint:'privilege_escalation score'},
      escalation_events:{label:'상승 이벤트',unit:'건',desc:'에이전트가 부여된 권한 범위를 초과하는 작업을 시도한 이벤트 수입니다. 의도치 않은 설계 결함이거나 악의적 입력에 의한 권한 남용 시도일 수 있으며, 0이 되도록 관리해야 합니다.',hint:'security_l2.escalation_events'},
      attack_detections:{label:'공격 탐지',unit:'건',desc:'여러 도구 호출을 체계적으로 연결하는 공격 체인(Attack Chain) 패턴이 탐지된 수입니다. 단일 위협보다 정교한 복합 공격으로, 탐지 시 에이전트 아키텍처 전체에 대한 보안 점검이 필요합니다.',hint:'security_l2.attack_detections'},
    },
    formula(k,d){
      const pe=d.security_l2?.privilege_escalation||{};
      const ad=d.security_l2?.attack_detection||{};
      if((k==='defense_rate'||k==='escalation_events') && !this.privTracking(d)){
        return `⚠ PrivilegeEscalationDetector 미활성\n태스크 ${pe.task_count||0}건 존재 — 권한 변화 추적 미수행\n→ track_privilege_change() 미호출로 측정값 없음`;
      }
      if(k==='attack_detections' && !this.atkTracking(d)){
        const tc=ad.task_tool_calls_total||0;
        return `⚠ ToolChainAttackDetector 미활성\n태스크 기준 ${tc}건 도구 호출 감지 — 체인 분석 미수행\n→ track_tool_chain() 미호출로 측정값 없음`;
      }
      if(k==='defense_rate'){
        const er=(pe.escalation_rate||0);
        return `방어율 = 100 − 상승률\n= 100 − ${er.toFixed(1)}% = ${(100-er).toFixed(1)}%\n상승 탐지: ${pe.escalations_detected||0}건 / 평가: ${pe.total_evaluations||0}건`;
      }
      if(k==='escalation_events'){
        return `상승 이벤트 = ${pe.escalations_detected||0}건 탐지\n전체 평가: ${pe.total_evaluations||0}건 / 상승률: ${(pe.escalation_rate||0).toFixed(1)}%\n(PrivilegeEscalationDetector — escalation_detected=True 건수)`;
      }
      if(k==='attack_detections'){
        const n=ad.total_chains_analyzed||0;
        const s=ad.suspicious_chains||0;
        return `공격 탐지 = ${s}건\n탐지율 = ${s} / ${n} × 100 = ${(ad.detection_rate||0).toFixed(1)}%\n(ToolChainAttackDetector 의심 체인 분석)`;
      }
      return '';
    },
    items(k,d){
      if(k==='attack_detections') return d.security_l2?.attack_detections||[];
      if(k==='escalation_events') return (d.security_l2?.escalation_events||[]).filter(e=>e.escalation_detected);
      // defense_rate: 전체 이벤트 (탐지+정상 모두 표시)
      return d.security_l2?.escalation_events||[];
    },
    // 태스크 목록 (추적 미활성 시 폴백)
    taskItems(d){ return (d.tasks||[]).filter(t=>(Array.isArray(t.tool_calls)?t.tool_calls.length:(t.tool_calls||0))>0||(d.tasks||[]).length>0).slice(0,50); },
    filterLabel(k){return k==='attack_detections'?'공격 체인 탐지':'권한 상승 이벤트';}
  }">
    <!-- PrivilegeEscalationDetector 미활성 경고 배너 -->
    <div x-show="!privTracking(data)" x-cloak
         style="margin-bottom:8px;padding:9px 14px;border-radius:7px;background:rgba(234,179,8,0.1);border:1px solid rgba(234,179,8,0.35);display:flex;align-items:flex-start;gap:10px">
      <span style="font-size:16px;flex-shrink:0">⚠️</span>
      <div>
        <div style="font-size:12px;font-weight:700;color:#b45309;margin-bottom:2px">권한 상승 추적 미활성</div>
        <div style="font-size:11px;color:var(--text2);line-height:1.6">
          <code style="font-size:10.5px;background:var(--bg3);padding:1px 5px;border-radius:3px">PrivilegeEscalationDetector.track_privilege_change()</code>이 호출되지 않았습니다.
          <strong x-text="(data.security_l2?.privilege_escalation?.task_count||0)+'개'"></strong> 태스크가 존재하나 권한 변화 추적이 수행되지 않아
          <strong>방어율 100%, 상승 이벤트 0건</strong>은 측정값이 아닌 기본값입니다.<br>
          <span style="color:#92400e">→ <code style="font-size:10.5px">enable_security_metrics=True</code> 설정 후 프레임워크 통합 또는 수동 호출이 필요합니다.</span>
        </div>
      </div>
    </div>
    <!-- ToolChainAttackDetector 미활성 경고 배너 -->
    <div x-show="!atkTracking(data)" x-cloak
         style="margin-bottom:8px;padding:9px 14px;border-radius:7px;background:rgba(234,179,8,0.1);border:1px solid rgba(234,179,8,0.35);display:flex;align-items:flex-start;gap:10px">
      <span style="font-size:16px;flex-shrink:0">⚠️</span>
      <div>
        <div style="font-size:12px;font-weight:700;color:#b45309;margin-bottom:2px">공격 체인 분석 미활성</div>
        <div style="font-size:11px;color:var(--text2);line-height:1.6">
          <code style="font-size:10.5px;background:var(--bg3);padding:1px 5px;border-radius:3px">ToolChainAttackDetector.track_tool_chain()</code>이 호출되지 않았습니다.
          태스크 기준 <strong x-text="(data.security_l2?.attack_detection?.task_tool_calls_total||0)+'건'"></strong>의 도구 호출이 감지되었으나 체인 분석이 수행되지 않아
          <strong>공격 탐지 0건</strong>은 측정값이 아닌 기본값입니다.
        </div>
      </div>
    </div>
    <div class="kpi-grid">
      <!-- 방어율 KPI -->
      <div class="kpi kpi-act" :class="{sel:selK==='defense_rate'}" @click="selK=selK==='defense_rate'?null:'defense_rate'"
           :style="!privTracking(data)?'opacity:0.55;border-style:dashed':''">
        <div class="kpi-lbl">방어율</div>
        <template x-if="privTracking(data)">
          <div class="kpi-val" :style="`color:${_bc((100-(data.security_l2?.privilege_escalation?.escalation_rate||0)),90,70)}`"
               x-text="_pct((100-(data.security_l2?.privilege_escalation?.escalation_rate||0)))"></div>
        </template>
        <template x-if="!privTracking(data)">
          <div class="kpi-val" style="color:var(--text2);font-size:13px;font-weight:500">추적 안됨</div>
        </template>
        <div class="kpi-sub" x-text="privTracking(data)?`평가 ${data.security_l2?.privilege_escalation?.total_evaluations||0}건`:`태스크 ${data.security_l2?.privilege_escalation?.task_count||0}건`"></div>
      </div>
      <!-- 상승 이벤트 KPI -->
      <div class="kpi kpi-act" :class="{sel:selK==='escalation_events'}" @click="selK=selK==='escalation_events'?null:'escalation_events'"
           :style="!privTracking(data)?'opacity:0.55;border-style:dashed':''">
        <div class="kpi-lbl">상승 이벤트</div>
        <template x-if="privTracking(data)">
          <div class="kpi-val" :style="`color:${(data.security_l2?.privilege_escalation?.escalations_detected||0)>0?'var(--red)':'var(--green)'}`"
               x-text="data.security_l2?.privilege_escalation?.escalations_detected||0"></div>
        </template>
        <template x-if="!privTracking(data)">
          <div class="kpi-val" style="color:var(--text2);font-size:13px;font-weight:500">—</div>
        </template>
        <div class="kpi-sub" :class="privTracking(data)&&(data.security_l2?.privilege_escalation?.escalations_detected||0)>0?'warn':'ok'"
             x-text="privTracking(data)?`평가 ${data.security_l2?.privilege_escalation?.total_evaluations||0}건 중 탐지`:'권한 추적 미수행'"></div>
      </div>
      <!-- 공격 탐지 KPI -->
      <div class="kpi kpi-act" :class="{sel:selK==='attack_detections'}" @click="selK=selK==='attack_detections'?null:'attack_detections'"
           :style="!atkTracking(data)?'opacity:0.55;border-style:dashed':''">
        <div class="kpi-lbl">공격 탐지</div>
        <template x-if="atkTracking(data)">
          <div class="kpi-val" :style="`color:${(data.security_l2?.attack_detection?.suspicious_chains||0)>0?'var(--red)':'var(--green)'}`"
               x-text="data.security_l2?.attack_detection?.suspicious_chains||0"></div>
        </template>
        <template x-if="!atkTracking(data)">
          <div class="kpi-val" style="color:var(--text2);font-size:13px;font-weight:500">—</div>
        </template>
        <div class="kpi-sub" x-text="atkTracking(data)?`분석 ${data.security_l2?.attack_detection?.total_chains_analyzed||0}건`:'체인 분석 미수행'"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <template x-if="selK==='attack_detections'">
              <template x-if="!atkTracking(data)">
                <span style="font-size:10px;background:rgba(234,179,8,0.15);color:#92400e;padding:1px 7px;border-radius:99px;margin-left:4px">추적 안됨</span>
              </template>
              <template x-if="atkTracking(data)">
                <span style="font-size:11px;color:var(--text2);margin-left:4px"
                      x-text="items(selK,data).length?`(${items(selK,data).length}건 분석 · ${data.security_l2?.attack_detection?.suspicious_chains||0}건 의심)`:'(기록 없음)'"></span>
              </template>
            </template>
            <template x-if="selK==='escalation_events'">
              <template x-if="!privTracking(data)">
                <span style="font-size:10px;background:rgba(234,179,8,0.15);color:#92400e;padding:1px 7px;border-radius:99px;margin-left:4px">추적 안됨</span>
              </template>
              <template x-if="privTracking(data)">
                <span style="font-size:11px;margin-left:4px"
                      :style="`color:${items(selK,data).length?'var(--red)':'var(--text2)'}`"
                      x-text="items(selK,data).length?`(${items(selK,data).length}건 탐지)`:'(탐지 없음)'"></span>
              </template>
            </template>
            <template x-if="selK==='defense_rate'">
              <template x-if="!privTracking(data)">
                <span style="font-size:10px;background:rgba(234,179,8,0.15);color:#92400e;padding:1px 7px;border-radius:99px;margin-left:4px">추적 안됨</span>
              </template>
              <template x-if="privTracking(data)">
                <span style="font-size:11px;color:var(--text2);margin-left:4px"
                      x-text="items(selK,data).length?`(전체 ${items(selK,data).length}건 평가 · ${items(selK,data).filter(e=>e.escalation_detected).length}건 상승)`:'(기록 없음)'"></span>
              </template>
            </template>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📋 설명</div>
              <div style="font-size:12px;color:var(--text1);line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.9;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <!-- 공격 탐지: 전체 정상 배너 -->
          <div x-show="selK==='attack_detections' && items(selK,data).length && !(data.security_l2?.attack_detection?.suspicious_chains||0)"
               style="padding:7px 14px;background:rgba(16,185,129,0.07);font-size:11px;color:var(--green);display:flex;align-items:center;gap:6px;border-bottom:1px solid var(--border)">
            ✓ 분석된 <span x-text="items(selK,data).length+'건'"></span> 체인 모두 정상 — 공격 패턴 미탐지
          </div>

          <!-- 데이터 없음: 추적 미활성 → 태스크 폴백 테이블 -->
          <div x-show="!items(selK,data).length && (selK==='defense_rate'||selK==='escalation_events') && !privTracking(data)"
               style="padding:0 14px 12px;background:var(--bg2)">
            <div style="font-size:11px;color:#b45309;font-weight:600;padding:8px 0 6px">
              ⚠ PrivilegeEscalationDetector 미활성 — 태스크 목록으로 표시 (권한 정보 미수집)
            </div>
            <div class="dtx" style="font-size:11px">
              <div class="dtx-row dtx-head" style="grid-template-columns:1.2fr 90px 60px 60px 65px">
                <span>Task ID</span><span>태스크 유형</span><span>도구 호출수</span><span>완료율</span><span>권한 추적</span>
              </div>
              <template x-for="(t,ti) in (data.tasks||[]).slice(0,30)" :key="ti">
                <div class="dtx-row" :style="`grid-template-columns:1.2fr 90px 60px 60px 65px;${t.success===false?'background:rgba(220,50,50,0.04)':''}`">
                  <span style="font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="t.task_id||'—'"></span>
                  <span style="font-size:10px;color:var(--text2)" x-text="t.task_type||'—'"></span>
                  <span style="font-size:11px" x-text="Array.isArray(t.tool_calls)?t.tool_calls.length:(t.tool_calls||0)"></span>
                  <span style="font-size:11px" :style="`color:${_bc((t.completion_score||0)*100,85,70)}`"
                        x-text="t.completion_score!=null?((t.completion_score||0)*100).toFixed(0)+'%':'—'"></span>
                  <span style="font-size:10px;color:#b45309;font-weight:500">미수행</span>
                </div>
              </template>
              <div x-show="(data.tasks||[]).length>30" style="padding:6px;text-align:center;color:var(--text2);font-size:11px"
                   x-text="`... 외 ${(data.tasks||[]).length-30}건`"></div>
            </div>
          </div>
          <div x-show="!items(selK,data).length && selK==='attack_detections' && !atkTracking(data)"
               style="padding:0 14px 12px;background:var(--bg2)">
            <div style="font-size:11px;color:#b45309;font-weight:600;padding:8px 0 6px">
              ⚠ ToolChainAttackDetector 미활성 — 도구 호출 목록으로 표시 (체인 분석 미수행)
            </div>
            <div class="dtx" style="font-size:11px">
              <div class="dtx-row dtx-head" style="grid-template-columns:1.2fr 90px 60px 60px 65px">
                <span>Task ID</span><span>태스크 유형</span><span>도구 호출수</span><span>완료율</span><span>체인 분석</span>
              </div>
              <template x-for="(t,ti) in (data.tasks||[]).filter(t=>(Array.isArray(t.tool_calls)?t.tool_calls.length:(t.tool_calls||0))>0).slice(0,30)" :key="ti">
                <div class="dtx-row" style="grid-template-columns:1.2fr 90px 60px 60px 65px">
                  <span style="font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="t.task_id||'—'"></span>
                  <span style="font-size:10px;color:var(--text2)" x-text="t.task_type||'—'"></span>
                  <span style="font-size:11px" x-text="Array.isArray(t.tool_calls)?t.tool_calls.length:(t.tool_calls||0)"></span>
                  <span style="font-size:11px" :style="`color:${_bc((t.completion_score||0)*100,85,70)}`"
                        x-text="t.completion_score!=null?((t.completion_score||0)*100).toFixed(0)+'%':'—'"></span>
                  <span style="font-size:10px;color:#b45309;font-weight:500">미수행</span>
                </div>
              </template>
            </div>
          </div>
          <!-- 데이터 없음: 추적 활성이나 기록 없음 -->
          <div x-show="!items(selK,data).length && (selK==='defense_rate'||selK==='escalation_events') && privTracking(data)"
               style="padding:14px;text-align:center;font-size:12px;color:var(--text2);background:var(--bg2)">
            <span>PrivilegeEscalationDetector 평가 기록 없음</span>
          </div>
          <div x-show="!items(selK,data).length && selK==='attack_detections' && atkTracking(data)"
               style="padding:14px;text-align:center;font-size:12px;color:var(--text2);background:var(--bg2)">
            <span>ToolChainAttackDetector 분석 기록 없음 — 공격 체인 평가가 수행되지 않았습니다</span>
          </div>

          <!-- 권한 상승 이벤트 / 방어율 테이블 (escalation_events & defense_rate) -->
          <div x-show="(selK==='escalation_events'||selK==='defense_rate') && items(selK,data).length"
               style="padding:0 14px 12px;background:var(--bg2)">
            <div style="font-size:11px;color:var(--text2);padding:8px 0 5px">
              <template x-if="selK==='defense_rate'">
                <span>🛡 전체 평가 이벤트 (탐지 + 정상) — 권한 경로 추적</span>
              </template>
              <template x-if="selK==='escalation_events'">
                <span>🚨 권한 상승 탐지 이벤트만 표시</span>
              </template>
            </div>
            <div class="dtx" style="font-size:11px">
              <div class="dtx-row dtx-head" style="grid-template-columns:1.2fr 70px 70px 55px 50px 2fr">
                <span>Task ID</span><span>초기 권한</span><span>최대 권한</span><span>위험도</span><span>판정</span><span>상승 경로</span>
              </div>
              <template x-for="(e,ei) in items(selK,data).slice(0,30)" :key="ei">
                <div class="dtx-row" :style="`grid-template-columns:1.2fr 70px 70px 55px 50px 2fr;${e.escalation_detected?'background:rgba(220,50,50,0.06)':''}` ">
                  <span style="font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="e.task_id||'—'"></span>
                  <span style="font-size:11px;font-weight:500" x-text="e.initial_privilege||e.initial_privilege_level||'—'"></span>
                  <span style="font-size:11px;font-weight:500"
                        :style="`color:${e.escalation_detected?'var(--red)':'var(--text1)'}`"
                        x-text="e.max_privilege||e.final_privilege||'—'"></span>
                  <span style="font-size:11px"
                        :style="`color:${(e.risk_score||0)>=7?'var(--red)':(e.risk_score||0)>=4?'var(--orange)':'var(--text2)'}`"
                        x-text="e.risk_score!=null?e.risk_score+'점':'—'"></span>
                  <span :class="e.escalation_detected?'badge-ng':'badge-ok'" x-text="e.escalation_detected?'상승':'정상'"></span>
                  <span style="font-size:10px;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis"
                        :title="(e.escalation_path||[]).join(' → ')"
                        x-text="(e.escalation_path||[]).length?(e.escalation_path||[]).join(' → '):'직접 상승 (경로 미기록)'"></span>
                </div>
              </template>
              <div x-show="items(selK,data).length>30" style="padding:6px;text-align:center;color:var(--text2);font-size:11px"
                   x-text="`... 외 ${items(selK,data).length-30}건`"></div>
            </div>
            <!-- 권한 상승 요약 통계 -->
            <template x-if="selK==='escalation_events' && items(selK,data).length">
              <div style="margin-top:10px;padding:8px 10px;background:var(--bg3);border-radius:6px;display:flex;flex-direction:row;flex-wrap:wrap;gap:6px 16px;align-items:flex-start">
                <div style="flex:0 0 auto;min-width:80px">
                  <div style="font-size:10px;color:var(--text2)">평균 위험도</div>
                  <div style="font-size:15px;font-weight:700;color:var(--red)"
                       x-text="items(selK,data).length?(items(selK,data).reduce((s,e)=>s+(e.risk_score||0),0)/items(selK,data).length).toFixed(1)+'점':'—'"></div>
                </div>
                <div style="flex:0 0 auto;min-width:80px">
                  <div style="font-size:10px;color:var(--text2)">최고 위험도</div>
                  <div style="font-size:15px;font-weight:700;color:var(--red)"
                       x-text="items(selK,data).length?Math.max(...items(selK,data).map(e=>e.risk_score||0))+'점':'—'"></div>
                </div>
                <div style="flex:0 0 auto;min-width:100px">
                  <div style="font-size:10px;color:var(--text2)">초기 권한 분포</div>
                  <div style="font-size:11px;color:var(--text1)"
                       x-text="[...new Set(items(selK,data).map(e=>e.initial_privilege||''))].filter(Boolean).join(', ')||'—'"></div>
                </div>
                <div style="flex:0 0 auto;min-width:100px">
                  <div style="font-size:10px;color:var(--text2)">도달 최고 권한</div>
                  <div style="font-size:11px;font-weight:600;color:var(--red)"
                       x-text="[...new Set(items(selK,data).map(e=>e.max_privilege||''))].filter(Boolean).join(', ')||'—'"></div>
                </div>
              </div>
            </template>
          </div>

          <!-- 공격 탐지 테이블 -->
          <div x-show="selK==='attack_detections' && items(selK,data).length"
               style="padding:0 14px 12px;background:var(--bg2)">
            <div style="font-size:11px;color:var(--text2);padding:8px 0 5px">
              🔗 공격 체인 분석 결과 — 의심 체인 강조 표시
            </div>
            <div class="dtx" style="font-size:11px">
              <div class="dtx-row dtx-head" style="grid-template-columns:1.2fr 55px 50px 55px 2fr">
                <span>Task ID</span><span>체인길이</span><span>판정</span><span>신뢰도</span><span>탐지 패턴 / 공격 유형</span>
              </div>
              <template x-for="(e,ei) in items(selK,data).slice(0,30)" :key="ei">
                <div class="dtx-row" :style="`grid-template-columns:1.2fr 55px 50px 55px 2fr;${e.is_suspicious_chain?'background:rgba(220,50,50,0.06)':''}` ">
                  <span style="font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="e.task_id||'—'"></span>
                  <span style="font-size:11px;font-weight:500" x-text="e.chain_length??'—'"></span>
                  <span :class="e.is_suspicious_chain?'badge-ng':'badge-ok'" x-text="e.is_suspicious_chain?'의심':'정상'"></span>
                  <span :style="`font-size:11px;color:${(e.confidence_score??e.confidence||0)>=0.7?'var(--red)':(e.confidence_score??e.confidence||0)>=0.4?'var(--orange)':'var(--text2)'}`"
                        x-text="(e.confidence_score??e.confidence)!=null?((e.confidence_score??e.confidence)*100).toFixed(0)+'%':'—'"></span>
                  <span style="display:flex;flex-wrap:wrap;gap:3px;align-items:center">
                    <template x-for="pat in (e.attack_patterns_detected||e.attack_patterns||[])" :key="pat">
                      <span style="font-size:10px;background:rgba(220,50,50,0.15);color:var(--red);padding:1px 5px;border-radius:3px" x-text="pat"></span>
                    </template>
                    <template x-if="e.attack_types">
                      <span style="display:contents">
                        <template x-if="e.attack_types.data_exfiltration">
                          <span style="font-size:10px;background:rgba(220,50,50,0.12);color:#be123c;padding:1px 5px;border-radius:3px">데이터 유출</span>
                        </template>
                        <template x-if="e.attack_types.lateral_movement">
                          <span style="font-size:10px;background:rgba(234,88,12,0.12);color:#c2410c;padding:1px 5px;border-radius:3px">측면 이동</span>
                        </template>
                        <template x-if="e.attack_types.persistence">
                          <span style="font-size:10px;background:rgba(124,58,237,0.12);color:#7c3aed;padding:1px 5px;border-radius:3px">지속성</span>
                        </template>
                        <template x-if="e.attack_types.defense_evasion">
                          <span style="font-size:10px;background:rgba(15,118,110,0.12);color:#0f766e;padding:1px 5px;border-radius:3px">탐지 우회</span>
                        </template>
                      </span>
                    </template>
                    <template x-if="!(e.attack_patterns_detected||e.attack_patterns||[]).length && !e.is_suspicious_chain">
                      <span style="font-size:10px;color:var(--text2)">패턴 미탐지</span>
                    </template>
                  </span>
                </div>
              </template>
              <div x-show="items(selK,data).length>30" style="padding:6px;text-align:center;color:var(--text2);font-size:11px"
                   x-text="`... 외 ${items(selK,data).length-30}건`"></div>
            </div>
            <!-- 공격 유형 요약 -->
            <template x-if="(data.security_l2?.attack_detection?.suspicious_chains||0)>0">
              <div style="margin-top:10px;padding:8px 10px;background:var(--bg3);border-radius:6px;display:flex;flex-direction:row;flex-wrap:wrap;gap:6px 14px;align-items:flex-start">
                <div style="flex:0 0 auto;min-width:72px">
                  <div style="font-size:10px;color:var(--text2)">의심 체인</div>
                  <div style="font-size:15px;font-weight:700;color:var(--red)"
                       x-text="(data.security_l2?.attack_detection?.suspicious_chains||0)+'건'"></div>
                </div>
                <template x-if="(data.security_l2?.attack_detection?.data_exfiltration_detected||0)>0">
                  <div style="flex:0 0 auto;min-width:72px">
                    <div style="font-size:10px;color:var(--text2)">데이터 유출</div>
                    <div style="font-size:15px;font-weight:700;color:#be123c" x-text="(data.security_l2?.attack_detection?.data_exfiltration_detected||0)+'건'"></div>
                  </div>
                </template>
                <template x-if="(data.security_l2?.attack_detection?.lateral_movement_detected||0)>0">
                  <div style="flex:0 0 auto;min-width:72px">
                    <div style="font-size:10px;color:var(--text2)">측면 이동</div>
                    <div style="font-size:15px;font-weight:700;color:#c2410c" x-text="(data.security_l2?.attack_detection?.lateral_movement_detected||0)+'건'"></div>
                  </div>
                </template>
                <template x-if="(data.security_l2?.attack_detection?.persistence_detected||0)>0">
                  <div style="flex:0 0 auto;min-width:60px">
                    <div style="font-size:10px;color:var(--text2)">지속성</div>
                    <div style="font-size:15px;font-weight:700;color:#7c3aed" x-text="(data.security_l2?.attack_detection?.persistence_detected||0)+'건'"></div>
                  </div>
                </template>
                <template x-if="(data.security_l2?.attack_detection?.defense_evasion_detected||0)>0">
                  <div style="flex:0 0 auto;min-width:72px">
                    <div style="font-size:10px;color:var(--text2)">탐지 우회</div>
                    <div style="font-size:15px;font-weight:700;color:#0f766e" x-text="(data.security_l2?.attack_detection?.defense_evasion_detected||0)+'건'"></div>
                  </div>
                </template>
                <div style="flex:0 0 auto;min-width:72px">
                  <div style="font-size:10px;color:var(--text2)">평균 신뢰도</div>
                  <div style="font-size:15px;font-weight:700"
                       x-text="(data.security_l2?.attack_detection?.avg_confidence??0)>=0?((data.security_l2?.attack_detection?.avg_confidence||0)*100).toFixed(0)+'%':'—'"></div>
                </div>
              </div>
            </template>
          </div>
        </div>
      </template>
    </div>
  </div>

  <!-- OWASP LLM Top 10 -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔐 OWASP LLM Top 10 대응</span><div class="sdiv-line"></div></div>
  <div class="sec">
    <div class="sec-t">OWASP LLM Top 10 (2025) — 트래커 매핑</div>
    <div class="dtx">
      <div class="dtx-row dtx-head" style="grid-template-columns:50px 1fr 1fr 60px">
        <span>ID</span><span>위협</span><span>관련 트래커</span><span>평가</span>
      </div>
      <template x-for="item in [
        {id:'LLM01',threat:'Prompt Injection',tracker:'InputSanitizationTracker',covered:true},
        {id:'LLM02',threat:'Insecure Output Handling',tracker:'OutputLeakageDetector',covered:true},
        {id:'LLM03',threat:'Training Data Poisoning',tracker:'(외부 평가 필요)',covered:false},
        {id:'LLM04',threat:'Model Denial of Service',tracker:'LatencyTracker',covered:true},
        {id:'LLM05',threat:'Supply Chain Vulnerabilities',tracker:'(외부 평가 필요)',covered:false},
        {id:'LLM06',threat:'Sensitive Info Disclosure',tracker:'OutputLeakageDetector',covered:true},
        {id:'LLM07',threat:'Insecure Plugin Design',tracker:'ToolAuthorizationTracker',covered:true},
        {id:'LLM08',threat:'Excessive Agency',tracker:'PrivilegeEscalationDetector',covered:true},
        {id:'LLM09',threat:'Overreliance',tracker:'HallucinationDetector + AccuracyEvaluator',covered:true},
        {id:'LLM10',threat:'Model Theft',tracker:'(네트워크 레이어 평가 필요)',covered:false},
      ]" :key="item.id">
        <div class="dtx-row" style="grid-template-columns:50px 1fr 1fr 60px">
          <span class="badge-info" x-text="item.id"></span>
          <span style="font-size:12px" x-text="item.threat"></span>
          <span style="font-size:11px;color:var(--text2)" x-text="item.tracker"></span>
          <span :class="item.covered?'badge-ok':'badge-gray'" x-text="item.covered?'✓ 평가':'—'"></span>
        </div>
      </template>
    </div>
    <div style="margin-top:8px;font-size:11px;color:var(--text2)">
      ⓘ Agent-Evaluator v{{ version }} 기준. 평가 커버리지 7/10 (LLM03·LLM05·LLM10은 외부 평가 필요)
    </div>
  </div>

  </div><!-- /has_security -->
</div><!-- /security -->
<!-- ===== SECTION 7: TASKS ===== -->
<section id="s-tasks" class="sec" x-show="sec==='tasks'" x-cloak>
  <h2 class="sh">태스크 목록</h2>

  <!-- Filter Bar -->
  <div class="fbar" style="background:var(--bg3);border-radius:var(--r);padding:10px 12px;margin-bottom:12px;border:1px solid var(--border)">
    <label style="font-size:12px;color:var(--text2)">유형</label>
    <select x-model="taskFilter.type">
      <option value="">전체</option>
      <template x-for="t in taskTypes()" :key="t"><option :value="t" x-text="t"></option></template>
    </select>
    <label style="font-size:12px;color:var(--text2)">상태</label>
    <select x-model="taskFilter.status">
      <option value="">전체</option>
      <option value="success">성공</option>
      <option value="fail">실패</option>
    </select>
    <label style="font-size:12px;color:var(--text2)">검색</label>
    <input x-model="taskFilter.q" type="text" placeholder="task_id 또는 에러 검색..." style="flex:1;min-width:160px" />
    <span style="font-size:12px;color:var(--accent);font-weight:700" x-text="filteredTasks().length + ' 건'"></span>
    <button class="btn" @click="taskChartOpen=!taskChartOpen" x-text="taskChartOpen?'차트 숨기기':'차트 보기'"></button>
  </div>

  <!-- Chart Panel: x-effect triggers drawTaskCharts() after DOM is visible (double rAF for layout) -->
  <div x-show="taskChartOpen"
       x-effect="if(taskChartOpen) $nextTick(()=>requestAnimationFrame(()=>requestAnimationFrame(()=>drawTaskCharts())))"
       style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px">
    <div class="cbox">
      <div class="ct" style="font-size:11px;color:var(--text2);margin-bottom:4px">유형별 평균 완료율</div>
      <div id="d2-ts-type-tcr" style="height:220px"></div>
    </div>
    <div class="cbox">
      <div class="ct" style="font-size:11px;color:var(--text2);margin-bottom:4px">지연 vs 완료율 분포</div>
      <div id="d2-ts-scatter" style="height:220px"></div>
    </div>
  </div>

  <!-- Task Table -->
  <div style="overflow-x:auto">
    <table class="dt-card">
      <thead>
        <tr>
          <th style="text-align:left;min-width:160px">Task ID</th>
          <th style="text-align:left">유형</th>
          <th style="text-align:left">상태</th>
          <th style="text-align:left;min-width:130px">완료율</th>
          <th>정확도</th>
          <th>지연(s)</th>
          <th>토큰</th>
          <th>도구호출</th>
          <th style="text-align:left">오류</th>
        </tr>
      </thead>
      <tbody>
        <template x-for="(t,i) in filteredTasks()" :key="t.task_id||i">
          <tr style="cursor:pointer" @click="t._open=!t._open">
            <td style="font-family:monospace;font-size:11px;color:var(--accent)" x-text="t.task_id||'—'"></td>
            <td style="font-size:12px" x-text="t.task_type||'—'"></td>
            <td>
              <span :class="t.success?'badge-ok':'badge-ng'" x-text="t.success?'성공':'실패'"></span>
            </td>
            <td>
              <div style="display:flex;align-items:center;gap:6px">
                <div class="pscore-bar" style="flex:1">
                  <div class="pscore-fill"
                       :class="(t.completion_score||0)>=1?'strong':(t.completion_score||0)>=0.7?'':'weak'"
                       :style="`width:${Math.min(100,(t.completion_score||0)*100).toFixed(0)}%`"></div>
                </div>
                <span style="font-size:11px;width:34px;text-align:right;font-variant-numeric:tabular-nums"
                      x-text="((t.completion_score||0)*100).toFixed(0)+'%'"></span>
              </div>
            </td>
            <td x-text="t.accuracy_score!=null?((t.accuracy_score)*100).toFixed(1)+'%':'—'"></td>
            <td x-text="t.execution_time!=null?t.execution_time.toFixed(2):'—'"></td>
            <td x-text="_fmtNumG(t.tokens_used?.total||t.tokens_used||0)"></td>
            <td x-text="Array.isArray(t.tool_calls)?t.tool_calls.length:(t.tool_calls!=null?t.tool_calls:'—')"></td>
            <td style="font-size:11px;color:var(--red);max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                x-text="(t.errors&&t.errors.length)?t.errors[0]:'—'"></td>
          </tr>
          <template x-if="t._open">
            <tr>
              <td colspan="9" style="background:rgba(248,113,113,.06);padding:10px 14px">
                <div style="font-size:12px;font-weight:600;color:var(--red);margin-bottom:4px">오류 상세</div>
                <template x-for="(e,ei) in (t.errors||[])" :key="ei">
                  <div style="font-family:monospace;font-size:11px;color:var(--red);margin-bottom:2px" x-text="e"></div>
                </template>
                <template x-if="!(t.errors&&t.errors.length)">
                  <div style="font-size:12px;color:var(--text2)">기록된 오류 없음</div>
                </template>
                <template x-if="t.advanced_metrics&&Object.keys(t.advanced_metrics).length">
                  <div style="margin-top:8px">
                    <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px">Advanced Metrics</div>
                    <template x-for="(v,k) in t.advanced_metrics" :key="k">
                      <div class="drow" style="font-size:11px">
                        <span class="dk" x-text="k"></span>
                        <span x-text="typeof v==='number'?v.toFixed(3):String(v)"></span>
                      </div>
                    </template>
                  </div>
                </template>
              </td>
            </tr>
          </template>
        </template>
        <template x-if="filteredTasks().length===0">
          <tr>
            <td colspan="9" class="dtx-empty">조건에 맞는 태스크가 없습니다</td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>
</section>

<!-- ===== SECTION 8: INSIGHTS ===== -->
<section id="s-insights" class="sec" x-show="sec==='insights'" x-cloak>
  <h2 class="sh">인사이트 &amp; 분석</h2>

  <!-- 이상징후 배너 -->
  <template x-if="autoAnomalies().length > 0">
    <div style="display:flex;align-items:center;gap:8px;background:rgba(99,102,241,.08);border:1px solid rgba(99,102,241,.25);border-radius:8px;padding:8px 12px;margin-bottom:14px;font-size:13px">
      <span>⚠️</span>
      <span style="color:var(--text1)"><strong x-text="autoAnomalies().length"></strong>개의 이상 항목이 탐지되었습니다. 아래에서 상세 내용과 권고사항을 확인하세요.</span>
      <button @click="sec='overview'" class="btn" style="margin-left:auto;font-size:11px">← 개요로 돌아가기</button>
    </div>
  </template>

  <!-- 자동 이상 탐지 -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔍 자동 이상 탐지</span><div class="sdiv-line"></div></div>
  <div x-data="{open:true}">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
      <div style="display:flex;align-items:center;gap:8px">
        <span style="font-size:13px;font-weight:600;color:var(--text)">임계치 기반 이상 항목</span>
        <template x-if="autoAnomalies().length>0">
          <span class="badge-ng" x-text="autoAnomalies().length + '건 초과'"></span>
        </template>
        <template x-if="autoAnomalies().length===0">
          <span class="badge-ok">전체 정상</span>
        </template>
      </div>
      <button class="btn" @click="open=!open" x-text="open?'접기':'펼치기'"></button>
    </div>
    <div x-show="open">
      <template x-if="autoAnomalies().length===0">
        <div style="display:flex;align-items:center;gap:10px;padding:16px;background:rgba(16,185,129,.08);border:1px solid rgba(16,185,129,.25);border-radius:8px">
          <span style="font-size:24px">✅</span>
          <div>
            <div style="font-size:13px;font-weight:600;color:var(--green)">모든 지표 정상</div>
            <div style="font-size:12px;color:var(--text2)">TCR · 정확도 · 환각률 · P95 지연 · 비용 — 모두 임계치 이내</div>
          </div>
        </div>
      </template>

      <template x-for="(a,i) in autoAnomalies()" :key="i">
        <div style="margin-bottom:10px;padding:14px;border-radius:8px;border:1px solid"
             :style="a.level==='critical'
               ? 'border-color:rgba(239,68,68,.4);background:rgba(239,68,68,.05)'
               : 'border-color:rgba(245,158,11,.4);background:rgba(245,158,11,.05)'">

          <!-- 헤더: 아이콘 + 지표명 + 레벨 배지 -->
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:10px">
            <div style="display:flex;align-items:center;gap:8px">
              <span style="font-size:22px" x-text="
                a.metric.includes('TCR')||a.metric.includes('완료율') ? '📋' :
                a.metric.includes('정확도') ? '🎯' :
                a.metric.includes('환각') ? '🌀' :
                a.metric.includes('지연') ? '⚡' :
                a.metric.includes('비용') ? '💰' : '⚠️'
              "></span>
              <div>
                <div style="font-size:14px;font-weight:700;color:var(--text)" x-text="a.metric"></div>
                <div style="font-size:11px;color:var(--text2);margin-top:1px" x-text="
                  a.metric.includes('TCR')||a.metric.includes('완료율') ? '태스크 실행 흐름 및 실패 원인 점검 필요' :
                  a.metric.includes('정확도') ? 'Ground Truth 대비 응답 품질 개선 필요' :
                  a.metric.includes('환각') ? 'RAG 컨텍스트 보강 또는 프롬프트 강화 필요' :
                  a.metric.includes('지연') ? '고지연 태스크 병목 구간 분석 필요' :
                  a.metric.includes('비용') ? '토큰 사용량 최적화 또는 모델 교체 검토' : '임계치 초과 — 상세 분석 필요'
                "></div>
              </div>
            </div>
            <span style="flex-shrink:0"
                  :class="a.level==='critical'?'badge-ng':'badge-warn'"
                  x-text="a.level==='critical'?'🔴 위험':'🟡 경고'"></span>
          </div>

          <!-- 현재값 vs 임계치 수치 비교 -->
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;font-size:12px">
            <div>
              <span style="color:var(--text2)">현재 </span>
              <span style="font-size:16px;font-weight:700"
                    :style="a.level==='critical'?'color:var(--red)':'color:var(--yellow)'"
                    x-text="a.detail.match(/현재\s([^\s<>]+)/)?.[1]||'—'"></span>
            </div>
            <div style="color:var(--text2);font-size:11px">
              <span x-text="a.detail.includes('>')? '초과' : '미달'"></span>
              임계치
              <span style="font-weight:600;color:var(--text)"
                    x-text="a.detail.match(/임계치\s([^\s]+)/)?.[1]||'—'"></span>
            </div>
          </div>

          <!-- 진행바: 미달=단색(경고)+마커, 초과=그린세이프존+위험존+마커 -->
          <div style="position:relative;margin-top:10px">
            <div style="height:8px;border-radius:4px;background:var(--bg3);overflow:hidden">
              <div :style="(() => {
                const m=a.detail.match(/현재\s\$?([\d.]+)/), t=a.detail.match(/임계치\s\$?([\d.]+)/);
                if(!m||!t) return `width:50%;height:100%;background:${a.level==='critical'?'#ef4444':'#f59e0b'}`;
                const cur=parseFloat(m[1]), thr=parseFloat(t[1]);
                const isOver=a.detail.includes('>');
                const dangerColor=a.level==='critical'?'#ef4444':'#f59e0b';
                if(isOver){
                  const scaleMax=cur*1.15;
                  const thrP=(thr/scaleMax*100).toFixed(2);
                  const curP=Math.min(100,cur/scaleMax*100).toFixed(2);
                  return `width:${curP}%;height:100%;background:linear-gradient(to right,#10b981 0%,#10b981 ${thrP}%,${dangerColor} ${thrP}%,${dangerColor} 100%)`;
                } else {
                  const scaleMax=thr*1.15;
                  const curP=Math.min(100,cur/scaleMax*100).toFixed(2);
                  return `width:${curP}%;height:100%;background:#f59e0b`;
                }
              })()"></div>
            </div>
            <!-- 임계치 마커: outer wrapper에 absolute 배치 (overflow:hidden 에 클리핑 안됨) -->
            <div :style="(() => {
              const m=a.detail.match(/현재\s\$?([\d.]+)/), t=a.detail.match(/임계치\s\$?([\d.]+)/);
              if(!m||!t) return 'display:none';
              const cur=parseFloat(m[1]), thr=parseFloat(t[1]);
              const isOver=a.detail.includes('>');
              const scaleMax=isOver?cur*1.15:thr*1.15;
              const pct=Math.min(96,thr/scaleMax*100).toFixed(2);
              const color=isOver?'#10b981':'#6366f1';
              return `position:absolute;top:-4px;bottom:-4px;width:2px;left:${pct}%;background:${color};box-shadow:0 0 0 1.5px rgba(0,0,0,0.4);border-radius:1px;z-index:3`;
            })()"></div>
          </div>
          <div style="display:flex;justify-content:space-between;margin-top:5px;font-size:10px;color:var(--text2)">
            <span x-text="'현재: ' + (a.detail.match(/현재\s([^\s<>]+)/)?.[1]||'—')"></span>
            <span :style="a.detail.includes('>')? 'color:#10b981' : 'color:#6366f1'">│ 임계치 마커</span>
            <span x-text="'기준: ' + (a.detail.match(/임계치\s([^\s]+)/)?.[1]||'—')"></span>
          </div>
        </div>
      </template>

      <!-- 정상 지표 요약 (이상 있을 때) -->
      <template x-if="autoAnomalies().length > 0">
        <div style="margin-top:4px;padding:10px 14px;background:var(--bg3);border-radius:6px;font-size:11px;color:var(--text2)">
          ✅ 정상 지표:
          <span x-text="[
            autoAnomalies().find(a=>a.metric.includes('TCR')||a.metric.includes('완료율')) ? '' : 'TCR',
            autoAnomalies().find(a=>a.metric.includes('정확도')) ? '' : '정확도',
            autoAnomalies().find(a=>a.metric.includes('환각')) ? '' : '환각률',
            autoAnomalies().find(a=>a.metric.includes('지연')) ? '' : 'P95 지연',
            autoAnomalies().find(a=>a.metric.includes('비용')) ? '' : '비용',
          ].filter(Boolean).join(' · ') || '없음'"></span>
        </div>
      </template>
    </div>
  </div>

  <!-- 통계적 이상 탐지 -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">📊 통계적 이상 탐지 (Z-Score)</span><div class="sdiv-line"></div></div>
  <div style="background:var(--bg3);border-radius:var(--r);padding:14px;border:1px solid var(--border);margin-bottom:14px">
    <div style="font-size:13px;font-weight:600;color:var(--text);margin-bottom:4px">|z| &gt; 2 태스크</div>
    <div style="font-size:12px;color:var(--text2);margin-bottom:12px">지연 또는 정확도가 평균에서 표준편차 2배 이상 벗어난 태스크</div>
    <template x-if="zScoreAnomalies().length===0">
      <div style="text-align:center;padding:16px;color:var(--text2);font-size:13px">통계적 이상 태스크 없음</div>
    </template>
    <template x-if="zScoreAnomalies().length>0">
      <div>
        <div style="overflow-x:auto;margin-bottom:12px">
          <table class="dt-card">
            <thead>
              <tr>
                <th style="text-align:left">Task ID</th>
                <th style="text-align:left">유형</th>
                <th>지연(s)</th>
                <th>지연 Z</th>
                <th>정확도</th>
                <th>정확도 Z</th>
              </tr>
            </thead>
            <tbody>
              <template x-for="(z,i) in zScoreAnomalies()" :key="i">
                <tr>
                  <td style="font-family:monospace;font-size:11px;color:var(--accent)" x-text="z.task_id"></td>
                  <td style="font-size:12px" x-text="z.task_type||'—'"></td>
                  <td x-text="z.lat!=null?z.lat.toFixed(2):'—'"></td>
                  <td :style="`color:${Math.abs(z.zLat||0)>2?'var(--red)':'var(--text)'};font-weight:${Math.abs(z.zLat||0)>2?700:400}`"
                      x-text="z.zLat!=null?z.zLat.toFixed(2):'—'"></td>
                  <td x-text="z.acc!=null?(z.acc*100).toFixed(1)+'%':'—'"></td>
                  <td :style="`color:${Math.abs(z.zAcc||0)>2?'var(--red)':'var(--text)'};font-weight:${Math.abs(z.zAcc||0)>2?700:400}`"
                      x-text="z.zAcc!=null?z.zAcc.toFixed(2):'—'"></td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>
        <!-- Z-Score 이상 해석 -->
        <div style="border-top:1px solid var(--border);padding-top:12px">
          <div style="font-size:12px;font-weight:600;color:var(--text);margin-bottom:8px">🔍 이상 태스크 해석 및 개선 방향</div>
          <template x-for="(z,i) in zScoreAnomalies()" :key="'interp'+i">
            <div style="margin-bottom:8px;padding:10px 12px;background:var(--bg2);border-radius:6px;border-left:3px solid"
                 :style="Math.max(Math.abs(z.zLat||0),Math.abs(z.zAcc||0))>3?'border-color:var(--red)':'border-color:var(--yellow)'">
              <div style="font-size:12px;font-weight:600;color:var(--accent);margin-bottom:6px;font-family:monospace" x-text="z.task_id"></div>
              <!-- 지연 이상 -->
              <div x-show="Math.abs(z.zLat||0)>2" style="font-size:12px;color:var(--text);margin-bottom:4px;display:flex;gap:6px;align-items:flex-start">
                <span style="flex-shrink:0">⚡</span>
                <span x-text="(z.zLat||0)>0
                  ? `지연 이상 (Z=${(z.zLat).toFixed(2)}): 평균보다 ${Math.abs(z.zLat).toFixed(2)}σ 느림 — 해당 태스크의 병목 구간을 분석하고 프롬프트 최적화 또는 타임아웃 설정을 검토하세요.`
                  : `지연 단축 (Z=${(z.zLat).toFixed(2)}): 평균보다 ${Math.abs(z.zLat).toFixed(2)}σ 빠름 — 캐시 히트 또는 처리 단계 스킵 여부를 확인하세요.`"></span>
              </div>
              <!-- 정확도 이상 -->
              <div x-show="Math.abs(z.zAcc||0)>2" style="font-size:12px;color:var(--text);margin-bottom:4px;display:flex;gap:6px;align-items:flex-start">
                <span style="flex-shrink:0">🎯</span>
                <span x-text="(z.zAcc||0)<0
                  ? `정확도 이상 (Z=${(z.zAcc).toFixed(2)}): 평균보다 ${Math.abs(z.zAcc).toFixed(2)}σ 낮음 — Ground Truth와 응답을 직접 비교하고 프롬프트·컨텍스트를 우선 점검하세요.`
                  : `정확도 우수 (Z=${(z.zAcc).toFixed(2)}): 평균보다 ${Math.abs(z.zAcc).toFixed(2)}σ 높음 — 이 태스크의 성공 패턴을 참고해 다른 태스크에 적용하세요.`"></span>
              </div>
              <!-- 고지연 + 저정확도 복합 -->
              <div x-show="(z.zLat||0)>2 && (z.zAcc||0)<-2"
                   style="margin-top:6px;font-size:11px;padding:5px 8px;background:rgba(239,68,68,.1);border-radius:4px;color:var(--text)">
                ⚠️ 고지연 + 저정확도 동시 발생 — 타임아웃으로 인한 응답 품질 저하 가능성이 높습니다. 지연 원인을 먼저 해결하세요.
              </div>
            </div>
          </template>
        </div>
      </div>
    </template>
  </div>

  <!-- 📉 지표 회귀 감지 -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">📉 지표 회귀 감지</span><div class="sdiv-line"></div></div>
  <div x-data="{open:true}" style="margin-bottom:14px">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
        <span style="font-size:13px;font-weight:600;color:var(--text)">이전 파일 대비 지표 변화</span>
        <template x-if="prevData">
          <span class="badge-gray" x-text="'기준: ' + (prevData._name||prevData._id||'이전 파일').replace(/\.json$/,'').slice(-28)"></span>
        </template>
      </div>
      <button class="btn" @click="open=!open" x-text="open?'접기':'펼치기'"></button>
    </div>
    <div x-show="open">
      <template x-if="prevLoading">
        <div style="text-align:center;padding:20px;color:var(--text2)">⏳ 이전 파일 로딩 중…</div>
      </template>
      <template x-if="!prevLoading && !prevData">
        <div style="padding:14px 16px;background:var(--bg3);border-radius:8px;border:1px solid var(--border);font-size:13px;color:var(--text2);text-align:center">
          이전 파일 없음 — 결과 파일이 2개 이상이어야 회귀 분석이 가능합니다
        </div>
      </template>
      <template x-if="!prevLoading && prevData">
        <div>
          <!-- 회귀 배너 -->
          <template x-if="regressionItems().filter(it=>it.worse).length > 0">
            <div style="display:flex;align-items:center;gap:8px;background:rgba(239,68,68,.06);border:1px solid rgba(239,68,68,.25);border-radius:8px;padding:8px 12px;margin-bottom:12px;font-size:13px">
              <span>📉</span>
              <span><strong x-text="regressionItems().filter(it=>it.worse).length"></strong>개 지표에서 회귀가 감지되었습니다.</span>
            </div>
          </template>
          <template x-if="regressionItems().filter(it=>it.worse).length === 0">
            <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;background:rgba(16,185,129,.06);border:1px solid rgba(16,185,129,.25);border-radius:8px;margin-bottom:12px">
              <span style="font-size:20px">✅</span>
              <span style="font-size:13px;font-weight:600;color:var(--green)">이전 파일 대비 회귀 없음</span>
            </div>
          </template>
          <!-- 지표 테이블 -->
          <div style="overflow-x:auto">
            <table class="dt-card">
              <thead>
                <tr>
                  <th style="text-align:left">지표</th>
                  <th style="text-align:center">이전</th>
                  <th style="text-align:center">현재</th>
                  <th style="text-align:center">변화</th>
                  <th style="text-align:center">상태</th>
                </tr>
              </thead>
              <tbody>
                <template x-for="(it,i) in regressionItems()" :key="i">
                  <tr>
                    <td style="padding:7px 10px">
                      <span x-text="it.icon" style="margin-right:5px"></span>
                      <span x-text="it.label" style="font-size:12px;color:var(--text)"></span>
                    </td>
                    <td style="text-align:center;padding:7px 10px;font-size:12px;color:var(--text2)"
                        x-text="it.unit==='$' ? ('$'+it.prev.toFixed(5)) : it.prev.toFixed(it.unit==='s'?3:1)+it.unit"></td>
                    <td style="text-align:center;padding:7px 10px;font-size:12px;font-weight:600"
                        :style="{color: it.worse?'var(--red)':it.better?'var(--green)':'var(--text)'}"
                        x-text="it.unit==='$' ? ('$'+it.cur.toFixed(5)) : it.cur.toFixed(it.unit==='s'?3:1)+it.unit"></td>
                    <td style="text-align:center;padding:7px 10px;font-size:12px;font-weight:600"
                        :style="{color: it.worse?'var(--red)':it.better?'var(--green)':'var(--text2)'}"
                        x-text="(it.delta>0?'+':'')+(it.unit==='$'?it.delta.toFixed(5):it.delta.toFixed(it.unit==='s'?3:1))+it.unit"></td>
                    <td style="text-align:center;padding:7px 10px">
                      <span x-show="it.worse"  class="badge-ng"   style="font-size:11px">📉 회귀</span>
                      <span x-show="it.better" class="badge-ok"   style="font-size:11px">📈 개선</span>
                      <span x-show="!it.worse && !it.better" class="badge-gray" style="font-size:11px">→ 유지</span>
                    </td>
                  </tr>
                </template>
                <template x-if="regressionItems().length === 0">
                  <tr><td colspan="5" style="text-align:center;padding:16px;color:var(--text2);font-size:12px">비교 가능한 지표 없음</td></tr>
                </template>
              </tbody>
            </table>
          </div>
          <div style="margin-top:8px;padding:6px 10px;font-size:11px;color:var(--text2)">
            임계: TCR/정확도 ±2%, 품질 ±3%, 환각률 ±2%, P95 ±0.1s — 임계 미만 변화는 "유지"로 처리
          </div>
        </div>
      </template>
    </div>
  </div>

  <!-- 지표 상관관계 -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔗 지표 상관관계 (Pearson)</span><div class="sdiv-line"></div></div>
  <div style="background:var(--bg3);border-radius:var(--r);padding:14px;border:1px solid var(--border);margin-bottom:6px">
    <div style="font-size:12px;color:var(--text2);margin-bottom:10px">accuracy / execution_time / tokens_used / completion_score — 파랑: 양의 상관, 빨강: 음의 상관</div>
    <!-- 핵심 상관 요약 -->
    <div x-show="corrPairs().length>0" style="margin-bottom:12px;padding:10px 12px;background:var(--bg2);border-radius:6px;border:1px solid var(--border)">
      <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:6px">📌 핵심 인사이트</div>
      <template x-for="p in corrPairs().filter(p=>Math.abs(p.r)>=0.3)" :key="'sum'+p.label">
        <div style="display:flex;align-items:flex-start;gap:6px;margin-bottom:4px;font-size:12px">
          <span :style="`color:${Math.abs(p.r)>=0.7?'var(--red)':Math.abs(p.r)>=0.5?'var(--accent)':'var(--yellow)'};flex-shrink:0`"
                x-text="Math.abs(p.r)>=0.7?'🔴':Math.abs(p.r)>=0.5?'🔵':'🟡'"></span>
          <span>
            <strong x-text="p.label"></strong>
            <span style="color:var(--text2)" x-text="` (r=${p.r.toFixed(3)}) — `"></span>
            <span style="color:var(--text)" x-text="p.interp"></span>
          </span>
        </div>
      </template>
      <div x-show="corrPairs().filter(p=>Math.abs(p.r)>=0.3).length===0"
           style="font-size:12px;color:var(--text2)">모든 지표 쌍이 약한 상관 (|r| &lt; 0.3) — 지표들이 독립적으로 움직이고 있습니다.</div>
    </div>
    <div style="overflow-x:auto;margin-bottom:14px">
      <table class="dt-card" style="text-align:center">
        <thead>
          <tr>
            <th style="text-align:left"></th>
            <template x-for="col in ['accuracy','latency','tokens','completion']" :key="col">
              <th x-text="col"></th>
            </template>
          </tr>
        </thead>
        <tbody>
          <template x-for="row in corrMatrix()" :key="row.label">
            <tr>
              <td style="text-align:left;font-weight:600;color:var(--text2);font-size:12px" x-text="row.label"></td>
              <template x-for="(v,ci) in row.vals" :key="ci">
                <td :style="`background:${v===1?'transparent':v>0.5?'rgba(99,102,241,'+Math.abs(v)*0.3+')':v<-0.5?'rgba(239,68,68,'+Math.abs(v)*0.3+')':'transparent'}`"
                    x-text="v!=null?v.toFixed(2):'—'"></td>
              </template>
            </tr>
          </template>
        </tbody>
      </table>
    </div>
    <!-- 쌍별 해석 및 대응방안 -->
    <div style="font-size:12px;font-weight:600;color:var(--text);margin-bottom:8px">📊 쌍별 해석 및 대응방안</div>
    <div x-show="corrPairs().length===0" style="font-size:13px;color:var(--text2);padding:8px">분석 가능한 태스크 데이터 부족 (최소 3건 필요)</div>
    <div style="display:flex;flex-direction:column;gap:6px">
      <template x-for="p in corrPairs()" :key="p.label">
        <div style="padding:10px;border-radius:6px;border:1px solid var(--border)"
             :style="p.noData?'background:var(--bg3);opacity:.7':Math.abs(p.r)>=0.5?'background:rgba(99,102,241,.06)':Math.abs(p.r)>=0.3?'background:rgba(234,179,8,.04)':'background:var(--bg2)'">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;flex-wrap:wrap">
            <span style="font-weight:600;font-size:12px;color:var(--text)" x-text="p.label"></span>
            <template x-if="!p.noData">
              <span style="font-size:12px;font-variant-numeric:tabular-nums"
                    :style="`color:${Math.abs(p.r)>=0.5?'var(--accent)':Math.abs(p.r)>=0.3?'var(--yellow)':'var(--text2)'}`"
                    x-text="'r = '+p.r.toFixed(3)"></span>
            </template>
            <template x-if="!p.noData">
              <span class="badge-gray"
                    :style="`background:${Math.abs(p.r)>=0.5?'rgba(99,102,241,.2)':Math.abs(p.r)>=0.3?'rgba(234,179,8,.2)':'var(--bg3)'}`"
                    x-text="Math.abs(p.r)>=0.5?'강한 상관':Math.abs(p.r)>=0.3?'중간 상관':'약한 상관'"></span>
            </template>
            <template x-if="!p.noData">
              <span class="badge-gray" x-text="p.r>0?'양의 상관':'음의 상관'"></span>
            </template>
            <template x-if="p.noData">
              <span class="badge-gray" style="opacity:.6">데이터 없음</span>
            </template>
          </div>
          <div style="font-size:12px;color:var(--text2)" x-text="p.interp"></div>
          <div x-show="p.action" style="margin-top:6px;font-size:11px;padding:6px 10px;background:rgba(99,102,241,.08);border-left:2px solid var(--accent);border-radius:0 4px 4px 0;color:var(--text)">
            💡 <span x-text="p.action"></span>
          </div>
        </div>
      </template>
    </div>
  </div>

  <!-- 배포 게이트 -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🚀 배포 게이트</span><div class="sdiv-line"></div></div>
  <div class="dgate" style="margin-bottom:16px">
    <template x-for="g in deployGates()" :key="g.key">
      <div class="dgate-box" :class="g.cls">
        <div class="dgate-title">
          <span x-text="g.label"></span>
          <span class="dgate-badge" x-text="g.cls==='pass'?'PASS':g.cls==='fail'?'FAIL':`${g.passed}/${g.total}`"></span>
        </div>
        <template x-for="c in g.criteria" :key="c.name">
          <div class="dgate-row">
            <span x-text="c.pass?'✅':'❌'"></span>
            <span x-text="c.name"></span>
            <span class="dv" x-text="c.val"></span>
          </div>
        </template>
      </div>
    </template>
  </div>

  <!-- 서버 알림 -->
  <template x-if="data.insights && data.insights.alerts && data.insights.alerts.length">
    <div>
      <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔔 서버 알림</span><div class="sdiv-line"></div></div>
      <div style="margin-bottom:14px">
        <template x-for="(al,i) in data.insights.alerts" :key="i">
          <div class="alert" :class="al.level==='error'?'critical':al.level==='warn'?'medium':'low'" style="margin-bottom:6px">
            <div class="alert-body">
              <div class="alert-t">
                <span :class="al.level==='error'?'badge-ng':al.level==='warn'?'badge-warn':'badge-info'"
                      x-text="al.level||'info'"></span>
              </div>
              <div class="alert-b" x-text="al.message||al"></div>
            </div>
          </div>
        </template>
      </div>
    </div>
  </template>

  <!-- 권고사항 + 성능 병목 개선 -->
  <div>
    <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">💡 권고사항 및 대응방안</span><div class="sdiv-line"></div></div>
    <div style="margin-bottom:14px">
      <!-- 서버 권고사항 -->
      <template x-if="data.insights && data.insights.recommendations && data.insights.recommendations.length">
        <div>
          <template x-for="(r,i) in data.insights.recommendations" :key="i">
            <div class="rec" style="margin-bottom:8px">
              <div class="rec-t" style="display:flex;align-items:center;gap:8px">
                <span :class="(r.priority||r.level)==='high'?'badge-ng':(r.priority||r.level)==='medium'?'badge-warn':'badge-info'"
                      x-text="((r.priority||r.level||'low')).toUpperCase()"></span>
                <span style="font-weight:600" x-text="recTitle(r)"></span>
              </div>
              <div class="rec-b" x-show="recIssue(r)" x-html="md2html(recIssue(r))"></div>
              <details x-show="r.suggestion||r.impact" style="margin-top:6px">
                <summary style="cursor:pointer;font-size:12px;color:var(--accent)">💡 개선 제안 보기</summary>
                <div style="font-size:12px;line-height:1.7;margin-top:8px;color:var(--text2)" x-html="md2html(r.suggestion||'')"></div>
                <div x-show="r.impact" style="margin-top:8px;padding-top:8px;border-top:1px solid var(--border);font-size:12px;line-height:1.7;color:var(--text2)">
                  <strong>📈 예상 효과:</strong> <span x-html="md2html(r.impact||'')"></span>
                </div>
              </details>
            </div>
          </template>
        </div>
      </template>
      <!-- 성능 병목 기반 개선 항목 -->
      <template x-if="bottleneckAnalysis().length>0">
        <div>
          <div style="font-size:12px;font-weight:600;color:var(--text2);padding:8px 0 6px;border-top:1px solid var(--border)">⚡ 성능 병목 기반 개선 항목</div>
          <template x-for="(b,i) in bottleneckAnalysis()" :key="i">
            <div class="rec" style="margin-bottom:8px">
              <div class="rec-t" style="display:flex;align-items:center;gap:8px">
                <span :class="b.severity==='high'?'badge-ng':b.severity==='medium'?'badge-warn':'badge-info'"
                      x-text="b.severity.toUpperCase()"></span>
                <span style="font-weight:600" x-text="b.title"></span>
              </div>
              <div class="rec-b" x-text="b.desc"></div>
              <div x-show="b.action" style="margin-top:6px;font-size:11px;padding:6px 10px;background:rgba(99,102,241,.08);border-left:2px solid var(--accent);border-radius:0 4px 4px 0;color:var(--text)">
                💡 <span x-text="b.action"></span>
              </div>
              <div x-show="b.tasks&&b.tasks.length>0" style="margin-top:6px;display:flex;flex-wrap:wrap;gap:4px">
                <template x-for="t in (b.tasks||[])" :key="t.task_id">
                  <span class="badge-gray" style="font-family:monospace;font-size:10px"
                        x-text="`${t.task_id} (${(t.execution_time||0).toFixed(2)}s)`"></span>
                </template>
              </div>
            </div>
          </template>
        </div>
      </template>
      <!-- 권고사항/병목 모두 없음 -->
      <div x-show="!(data.insights?.recommendations?.length>0) && !bottleneckAnalysis().length"
           style="text-align:center;padding:20px;color:var(--text2);font-size:13px">
        ✅ 개선 방안이 없습니다 — 현재 지표 양호
      </div>
    </div>
  </div>

</section>

<!-- ═══════════════ COMPARE ═══════════════ -->
<section id="s-compare" class="sec" x-show="sec==='compare'" x-cloak
         x-effect="if(sec==='compare') { loadCompareData() }">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
    <span style="font-weight:700;font-size:15px">📂 파일 비교</span>
    <span class="badge-info" x-text="compareIds.length + '/5 선택'"></span>
  </div>

  <div class="sdiv"><div class="sdiv-lbl">비교 파일 선택</div><div class="sdiv-line"></div></div>
  <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px">
    <template x-for="f in files" :key="f.id">
      <label style="display:flex;align-items:center;gap:6px;cursor:pointer;padding:6px 10px;border:1px solid var(--border);border-radius:6px;background:var(--bg2);font-size:12px"
             :style="compareIds.includes(f.id) ? 'border-color:var(--accent);background:var(--accent)11' : ''">
        <input type="checkbox" :checked="compareIds.includes(f.id)" @change="toggleCompare(f.id)">
        <span x-text="f.name||f.id"></span>
        <span class="badge-gray" x-text="f.total_tasks+'건'"></span>
      </label>
    </template>
  </div>

  <template x-if="compareLoading">
    <div style="text-align:center;padding:32px;color:var(--text2)">⏳ 로딩 중…</div>
  </template>

  <template x-if="!compareLoading && compareData.length >= 2">
    <div>
      <!-- 서브탭 -->
      <div style="display:flex;gap:6px;margin-bottom:14px;border-bottom:1px solid var(--border);padding-bottom:10px">
        <button class="btn"
                :style="cmpTab==='compare'?'border-color:var(--accent);color:var(--accent);font-weight:700':''"
                @click="cmpTab='compare'">📊 비교표</button>
        <button class="btn"
                :style="cmpTab==='trend'?'border-color:var(--accent);color:var(--accent);font-weight:700':''"
                @click="cmpTab='trend';$nextTick(()=>drawTrendChart())">📈 트렌드</button>
      </div>

      <!-- 비교표 -->
      <div x-show="cmpTab==='compare'">
      <div class="sdiv"><div class="sdiv-lbl">종합 비교 레이더 <span style="font-size:10px;color:var(--text2)">(6축 · 0–1 정규화 · 개요와 동일 관점)</span></div><div class="sdiv-line"></div></div>
      <div id="d2-cmp-radar" style="height:360px;margin-bottom:20px"></div>

      <div class="sdiv"><div class="sdiv-lbl">지표 비교</div><div class="sdiv-line"></div></div>
      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:12px">
          <thead>
            <tr style="border-bottom:2px solid var(--border)">
              <th style="text-align:left;padding:6px 10px;color:var(--text2);white-space:nowrap;min-width:130px">지표</th>
              <template x-for="d in compareData" :key="d.id">
                <th style="text-align:center;padding:6px 10px;color:var(--text2);white-space:nowrap;min-width:140px" x-text="d.name||d.id"></th>
              </template>
            </tr>
          </thead>
          <tbody>
            <!-- ── 레이더 6축 핵심 지표 ── -->
            <tr style="background:var(--bg2)">
              <td colspan="99" style="padding:4px 10px;font-size:10px;font-weight:700;color:var(--text2);letter-spacing:.05em">🎯 레이더 6축 핵심 지표 (0–100% · 높을수록 우수)</td>
            </tr>
            <!-- 완료율 -->
            <tr style="border-bottom:1px solid var(--border)">
              <td style="padding:6px 10px;color:var(--text2)">완료율 <span style="font-size:10px">(TCR)</span></td>
              <template x-for="d in compareData" :key="d.id">
                <td style="text-align:center;padding:6px 10px;font-weight:600"
                    :style="{color:bc(_tcrG(d))}"
                    x-text="_tcrG(d).toFixed(1)+'%'"></td>
              </template>
            </tr>
            <!-- 정확·품질 -->
            <tr style="border-bottom:1px solid var(--border)">
              <td style="padding:6px 10px;color:var(--text2)">정확·품질 <span style="font-size:10px">(acc+qual+hall 통합)</span></td>
              <template x-for="d in compareData" :key="d.id">
                <td style="text-align:center;padding:6px 10px;font-weight:600"
                    :style="{color:bc(_cmpQualAccNorm(d))}"
                    x-text="_cmpQualAccNorm(d).toFixed(1)+'%'"></td>
              </template>
            </tr>
            <!-- 운영 효율 -->
            <tr style="border-bottom:1px solid var(--border)">
              <td style="padding:6px 10px;color:var(--text2)">운영 효율 <span style="font-size:10px">(지연+비용 통합)</span></td>
              <template x-for="d in compareData" :key="d.id">
                <td style="text-align:center;padding:6px 10px;font-weight:600"
                    :style="{color:_cmpOpsNorm(d)!=null?bc(_cmpOpsNorm(d),90,70):'var(--text2)'}"
                    x-text="_cmpOpsNorm(d)!=null ? _cmpOpsNorm(d).toFixed(1)+'%' : '—'"></td>
              </template>
            </tr>
            <!-- 에이전틱 역량 -->
            <tr style="border-bottom:1px solid var(--border)">
              <td style="padding:6px 10px;color:var(--text2)">에이전틱 역량 <span style="font-size:10px">(Tool F1+협업+워크플로우)</span></td>
              <template x-for="d in compareData" :key="d.id">
                <td style="text-align:center;padding:6px 10px;font-weight:600"
                    :style="{color:_cmpAgenticNorm(d)!=null?bc(_cmpAgenticNorm(d),80,60):'var(--text2)'}"
                    x-text="_cmpAgenticNorm(d)!=null ? _cmpAgenticNorm(d).toFixed(1)+'%' : '—'"></td>
              </template>
            </tr>
            <!-- 신뢰성 -->
            <tr style="border-bottom:1px solid var(--border)">
              <td style="padding:6px 10px;color:var(--text2)">신뢰성 <span style="font-size:10px">(오류없는태스크+재시도없는태스크)</span></td>
              <template x-for="d in compareData" :key="d.id">
                <td style="text-align:center;padding:6px 10px;font-weight:600"
                    :style="{color:_cmpReliabilityNorm(d)!=null?bc(_cmpReliabilityNorm(d),90,70):'var(--text2)'}"
                    x-text="_cmpReliabilityNorm(d)!=null ? _cmpReliabilityNorm(d).toFixed(1)+'%' : '—'"></td>
              </template>
            </tr>
            <!-- 보안 -->
            <tr style="border-bottom:1px solid var(--border)">
              <td style="padding:6px 10px;color:var(--text2)">보안 <span style="font-size:10px">(L1 평균)</span></td>
              <template x-for="d in compareData" :key="d.id">
                <td style="text-align:center;padding:6px 10px;font-weight:600"
                    :style="{color:_cmpSecNorm(d)!=null?bc(_cmpSecNorm(d),90,70):'var(--text2)'}"
                    x-text="_cmpSecNorm(d)!=null ? _cmpSecNorm(d).toFixed(1)+'%' : '—'"></td>
              </template>
            </tr>
            <!-- ── 상세 지표 ── -->
            <tr style="background:var(--bg2)">
              <td colspan="99" style="padding:4px 10px;font-size:10px;font-weight:700;color:var(--text2);letter-spacing:.05em">📊 상세 지표</td>
            </tr>
            <!-- p95 지연 (raw) -->
            <tr style="border-bottom:1px solid var(--border)">
              <td style="padding:6px 10px;color:var(--text2)">p95 지연</td>
              <template x-for="d in compareData" :key="d.id">
                <td style="text-align:center;padding:6px 10px"
                    x-text="d.efficiency_metrics?.latency?.p95!=null ? d.efficiency_metrics.latency.p95.toFixed(2)+'s' : '—'"></td>
              </template>
            </tr>
            <!-- 평균 지연 (raw) -->
            <tr style="border-bottom:1px solid var(--border)">
              <td style="padding:6px 10px;color:var(--text2)">평균 지연</td>
              <template x-for="d in compareData" :key="d.id">
                <td style="text-align:center;padding:6px 10px"
                    x-text="(d.efficiency_metrics?.latency?.avg_latency??d.efficiency_metrics?.avg_latency??0).toFixed(2)+'s'"></td>
              </template>
            </tr>
            <!-- 태스크당 비용 (raw) -->
            <tr style="border-bottom:1px solid var(--border)">
              <td style="padding:6px 10px;color:var(--text2)">태스크당 비용</td>
              <template x-for="d in compareData" :key="d.id">
                <td style="text-align:center;padding:6px 10px"
                    x-text="d.efficiency_metrics?.tokens?.avg_cost_per_task!=null ? '$'+(d.efficiency_metrics.tokens.avg_cost_per_task).toFixed(5) : '—'"></td>
              </template>
            </tr>
            <!-- 총 비용 (raw) -->
            <tr style="border-bottom:1px solid var(--border)">
              <td style="padding:6px 10px;color:var(--text2)">총 비용</td>
              <template x-for="d in compareData" :key="d.id">
                <td style="text-align:center;padding:6px 10px"
                    x-text="'$'+(d.efficiency_metrics?.tokens?.total_cost??d.pricing?.total_cost??0).toFixed(5)"></td>
              </template>
            </tr>
            <!-- 환각률 -->
            <tr style="border-bottom:1px solid var(--border)">
              <td style="padding:6px 10px;color:var(--text2)">환각률</td>
              <template x-for="d in compareData" :key="d.id">
                <td style="text-align:center;padding:6px 10px" x-data="{
                  get hr() {
                    const h=d.accuracy_metrics?.hallucination||{};
                    const tot=h.total_evaluated||0, flag=h.total_flagged||0;
                    return tot>0?(flag/tot*100):null;
                  }
                }">
                  <span :style="{color: !d.has_hallucination?'var(--text2)':hr==null?'var(--text2)':hr>20?'var(--red)':hr>5?'var(--yellow)':'var(--green)'}"
                        x-text="d.has_hallucination&&hr!=null ? hr.toFixed(1)+'%' : '—'"></span>
                </td>
              </template>
            </tr>
            <!-- ── 기본 정보 ── -->
            <tr style="background:var(--bg2)">
              <td colspan="99" style="padding:4px 10px;font-size:10px;font-weight:700;color:var(--text2);letter-spacing:.05em">ℹ️ 기본 정보</td>
            </tr>
            <!-- 총 태스크 -->
            <tr style="border-bottom:1px solid var(--border)">
              <td style="padding:6px 10px;color:var(--text2)">총 태스크</td>
              <template x-for="d in compareData" :key="d.id">
                <td style="text-align:center;padding:6px 10px;font-weight:600" x-text="d.total_tasks??'—'"></td>
              </template>
            </tr>
            <!-- 성공 / 실패 -->
            <tr style="border-bottom:1px solid var(--border)">
              <td style="padding:6px 10px;color:var(--text2)">성공 / 실패</td>
              <template x-for="d in compareData" :key="d.id">
                <td style="text-align:center;padding:6px 10px">
                  <span :style="{color:'var(--green)'}" x-text="(d.tasks||[]).filter(t=>t.success).length"></span>
                  <span style="color:var(--text2)"> / </span>
                  <span :style="{color:'var(--red)'}" x-text="(d.tasks||[]).filter(t=>!t.success).length"></span>
                </td>
              </template>
            </tr>
            <!-- 평가 시각 -->
            <tr>
              <td style="padding:6px 10px;color:var(--text2)">평가 시각</td>
              <template x-for="d in compareData" :key="d.id">
                <td style="text-align:center;padding:6px 10px;font-size:11px;color:var(--text2)"
                    x-text="d.timestamp ? d.timestamp.slice(0,16).replace('T',' ') : '—'"></td>
              </template>
            </tr>
          </tbody>
        </table>
      </div>
      </div><!-- /비교표 -->

      <!-- 트렌드 탭 -->
      <div x-show="cmpTab==='trend'">
        <div class="sdiv"><div class="sdiv-lbl">📈 시계열 트렌드 <span style="font-size:10px;color:var(--text2)">선택 파일을 타임스탬프 순 정렬 · 좌축 % / 우축 초(s)</span></div><div class="sdiv-line"></div></div>
        <div id="d2-cmp-trend" style="width:100%;min-height:390px"></div>
        <div style="margin-top:8px;padding:8px 12px;background:var(--bg3);border-radius:6px;font-size:11px;color:var(--text2)">
          💡 파일 선택 순서가 아닌 <strong>타임스탬프 기준</strong>으로 정렬됩니다.
          P95 지연은 우측 y축(초)입니다.
        </div>
      </div><!-- /트렌드 -->
    </div>
  </template>

  <template x-if="!compareLoading && compareIds.length < 2">
    <div style="text-align:center;padding:56px;color:var(--text2)">
      <div style="font-size:36px;margin-bottom:8px">📂</div>
      <div>2개 이상 파일을 선택하면 비교가 시작됩니다</div>
    </div>
  </template>
</section>

<!-- ═══════════════ GOLDEN DATASET ═══════════════ -->
<section id="s-golden" class="sec" x-show="sec==='golden'" x-cloak
         x-effect="if(sec==='golden' && !goldenFiles.length) { loadGolden() }">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
    <span style="font-weight:700;font-size:15px">📚 골든 데이터셋</span>
    <button class="btn" @click="loadGolden()">새로고침</button>
  </div>

  <div class="sdiv"><div class="sdiv-lbl">PDF에서 Q&amp;A 생성</div><div class="sdiv-line"></div></div>
  <div class="kpi" style="margin-bottom:16px">
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:8px">
      <label class="btn" style="cursor:pointer">
        📄 PDF 업로드
        <input type="file" accept=".pdf" @change="uploadGoldenPdf($event)" style="display:none">
      </label>
      <div style="display:flex;align-items:center;gap:6px">
        <span class="dk">생성 건수</span>
        <input type="number" x-model.number="goldenPdfNum" min="1" max="100"
               style="width:60px;padding:4px 8px;border:1px solid var(--border);border-radius:4px;background:var(--bg2);color:var(--text);font-size:12px">
      </div>
      <span x-show="goldenPdfLoading" class="badge-info">⏳ 생성 중…</span>
    </div>
    <template x-if="goldenPdfResult">
      <div>
        <span x-show="goldenPdfResult.ok" class="badge-ok" x-text="'✅ ' + goldenPdfResult.item_count + '건 생성: ' + (goldenPdfResult.filename||'')"></span>
        <span x-show="!goldenPdfResult.ok" class="badge-ng">❌ 오류 발생</span>
      </div>
    </template>
  </div>

  <div class="sdiv"><div class="sdiv-lbl">데이터셋 목록 <span class="badge-gray" x-text="goldenFiles.length+'개'"></span></div><div class="sdiv-line"></div></div>

  <template x-if="goldenLoading">
    <div style="text-align:center;padding:24px;color:var(--text2)">⏳ 로딩 중…</div>
  </template>
  <template x-if="!goldenLoading && !goldenFiles.length">
    <div style="text-align:center;padding:48px;color:var(--text2)">
      <div style="font-size:32px;margin-bottom:8px">📚</div>
      <div>골든 데이터셋이 없습니다. PDF를 업로드하거나 API로 생성하세요.</div>
    </div>
  </template>

  <template x-for="f in goldenFiles" :key="f.name">
    <div class="kpi" style="margin-bottom:8px">
      <div style="display:flex;align-items:center;gap:8px">
        <span style="flex:1;font-size:13px;font-weight:500" x-text="f.name"></span>
        <span class="badge-gray" x-text="(f.count??'?')+'건'"></span>
        <span class="badge-gray" x-text="f.size_bytes ? Math.round(f.size_bytes/1024)+'KB' : ''"></span>
        <template x-if="goldenCurrent?.stem===f.stem && goldenDirty">
          <button class="btn" style="background:var(--accent);color:#fff;border:none"
                  :disabled="goldenSaving"
                  @click="saveGoldenCurrent()"
                  x-text="goldenSaving ? '저장 중…' : '저장'"></button>
        </template>
        <button class="btn" @click="loadGoldenDetail(f.stem)"
                x-text="goldenCurrent?.stem===f.stem ? '닫기' : '보기'"></button>
        <button class="btn" style="color:var(--red)"
                @click="if(confirm(f.name+' 파일을 삭제할까요?')) deleteGoldenFile(f.stem)">파일삭제</button>
      </div>

      <template x-if="goldenCurrent && goldenCurrent.stem === f.stem">
        <div style="margin-top:12px">
          <!-- 항목 목록 -->
          <div style="max-height:480px;overflow-y:auto">
            <template x-for="(item, idx) in goldenCurrent.items" :key="idx">
              <div class="dt-card" style="margin-bottom:6px">
                <!-- 보기 모드 -->
                <template x-if="goldenEditIdx !== idx">
                  <div>
                    <div style="display:flex;gap:6px;align-items:center;margin-bottom:4px">
                      <span class="badge-gray" x-text="item.id||(idx+1)"></span>
                      <div style="flex:1"></div>
                      <button class="btn" style="font-size:11px;padding:2px 8px"
                              @click="goldenStartEdit(idx)">수정</button>
                      <button class="btn" style="font-size:11px;padding:2px 8px;color:var(--red)"
                              @click="goldenDeleteItem(idx)">삭제</button>
                    </div>
                    <div class="dk" style="font-size:12px" x-text="item.question||item.input||'(질문 없음)'"></div>
                    <div style="font-size:11px;color:var(--text2);margin-top:3px"
                         x-text="item.expected_answer||item.ground_truth||item.answer||''"></div>
                  </div>
                </template>
                <!-- 수정 모드 -->
                <template x-if="goldenEditIdx === idx">
                  <div>
                    <div style="font-size:12px;font-weight:600;margin-bottom:8px;color:var(--accent)">✏️ 항목 수정</div>
                    <div style="margin-bottom:6px">
                      <div style="font-size:11px;color:var(--text2);margin-bottom:3px">질문</div>
                      <textarea x-model="goldenEditBuf.question" rows="2"
                        style="width:100%;box-sizing:border-box;font-size:12px;padding:5px 8px;border:1px solid var(--accent);border-radius:4px;background:var(--bg2);color:var(--text);resize:vertical"></textarea>
                    </div>
                    <div style="margin-bottom:6px">
                      <div style="font-size:11px;color:var(--text2);margin-bottom:3px">정답</div>
                      <textarea x-model="goldenEditBuf.expected_answer" rows="2"
                        style="width:100%;box-sizing:border-box;font-size:12px;padding:5px 8px;border:1px solid var(--border);border-radius:4px;background:var(--bg2);color:var(--text);resize:vertical"></textarea>
                    </div>
                    <template x-if="goldenEditBuf.context !== undefined">
                      <div style="margin-bottom:6px">
                        <div style="font-size:11px;color:var(--text2);margin-bottom:3px">컨텍스트</div>
                        <textarea x-model="goldenEditBuf.context" rows="2"
                          style="width:100%;box-sizing:border-box;font-size:12px;padding:5px 8px;border:1px solid var(--border);border-radius:4px;background:var(--bg2);color:var(--text);resize:vertical"></textarea>
                      </div>
                    </template>
                    <div style="display:flex;gap:6px">
                      <button class="btn" style="background:var(--accent);color:#fff;border:none"
                              @click="goldenApplyEdit(idx)">적용</button>
                      <button class="btn" @click="goldenEditIdx=-1">취소</button>
                    </div>
                  </div>
                </template>
              </div>
            </template>

            <div x-show="goldenCurrent.items.length === 0"
                 style="text-align:center;padding:16px;color:var(--text2);font-size:12px">
              항목이 없습니다. 저장하면 파일이 삭제됩니다.
            </div>
          </div>

          <!-- 새 항목 추가 폼 -->
          <template x-if="goldenAddMode">
            <div class="dt-card" style="margin-top:8px;border:1px dashed var(--accent)">
              <div style="font-size:12px;font-weight:600;margin-bottom:8px;color:var(--accent)">➕ 새 항목 추가</div>
              <div style="margin-bottom:6px">
                <div style="font-size:11px;color:var(--text2);margin-bottom:3px">질문 <span style="color:var(--red)">*</span></div>
                <textarea x-model="goldenAddBuf.question" rows="2" placeholder="질문을 입력하세요"
                  style="width:100%;box-sizing:border-box;font-size:12px;padding:5px 8px;border:1px solid var(--accent);border-radius:4px;background:var(--bg2);color:var(--text);resize:vertical"></textarea>
              </div>
              <div style="margin-bottom:6px">
                <div style="font-size:11px;color:var(--text2);margin-bottom:3px">정답</div>
                <textarea x-model="goldenAddBuf.expected_answer" rows="2" placeholder="정답(ground truth)을 입력하세요"
                  style="width:100%;box-sizing:border-box;font-size:12px;padding:5px 8px;border:1px solid var(--border);border-radius:4px;background:var(--bg2);color:var(--text);resize:vertical"></textarea>
              </div>
              <div style="margin-bottom:8px">
                <div style="font-size:11px;color:var(--text2);margin-bottom:3px">컨텍스트 (선택)</div>
                <textarea x-model="goldenAddBuf.context" rows="2" placeholder="RAG 컨텍스트 (선택사항)"
                  style="width:100%;box-sizing:border-box;font-size:12px;padding:5px 8px;border:1px solid var(--border);border-radius:4px;background:var(--bg2);color:var(--text);resize:vertical"></textarea>
              </div>
              <div style="display:flex;gap:6px">
                <button class="btn" style="background:var(--accent);color:#fff;border:none"
                        @click="goldenAddItem()">추가</button>
                <button class="btn"
                        @click="goldenAddMode=false;goldenAddBuf={question:'',expected_answer:'',ground_truth:'',context:'',id:''}">취소</button>
              </div>
            </div>
          </template>

          <!-- 하단 버튼 -->
          <div x-show="!goldenAddMode" style="margin-top:8px">
            <button class="btn" @click="goldenStartAdd()">➕ 항목 추가</button>
          </div>
        </div>
      </template>
    </div>
  </template>
</section>

<!-- ═══════════════ EXPORT ═══════════════ -->
<section id="s-export" class="sec" x-show="sec==='export'" x-cloak>
  <div style="font-weight:700;font-size:15px;margin-bottom:12px">📤 내보내기</div>

  <template x-if="!selId">
    <div style="text-align:center;padding:48px;color:var(--text2)">평가 결과 파일을 먼저 선택하세요</div>
  </template>

  <template x-if="selId">
    <div>
      <!-- 현재 파일 정보 -->
      <div class="sdiv"><div class="sdiv-lbl">현재 파일: <strong x-text="data?.name||selId"></strong></div><div class="sdiv-line"></div></div>

      <!-- 포함 평가 지표 배지 -->
      <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px">
        <span style="font-size:11px;color:var(--text2);padding:3px 0;margin-right:4px">포함 지표:</span>
        <span style="font-size:11px;padding:2px 9px;border-radius:99px;background:#6366f133;color:#818cf8">기본 (TCR·정확도·지연·비용)</span>
        <span x-show="data?.has_quality" style="font-size:11px;padding:2px 9px;border-radius:99px;background:#8b5cf633;color:#a78bfa">품질 (응답품질·환각)</span>
        <span x-show="data?.has_agentic" style="font-size:11px;padding:2px 9px;border-radius:99px;background:#06b6d433;color:#22d3ee">에이전틱 (도구·재시도·워크플로우)</span>
        <span x-show="data?.has_security" style="font-size:11px;padding:2px 9px;border-radius:99px;background:#ef444433;color:#f87171">보안 (L1 입력/출력·L2 권한상승)</span>
        <span x-show="data?.has_rag" style="font-size:11px;padding:2px 9px;border-radius:99px;background:#10b98133;color:#34d399">RAG (Faithfulness·Relevancy·Recall·Precision)</span>
        <span x-show="data?.has_advanced" style="font-size:11px;padding:2px 9px;border-radius:99px;background:#f59e0b33;color:#fbbf24">외부평가 (DeepEval·G-Eval·Toxicity·Bias)</span>
      </div>

      <!-- 3개 형식 카드 -->
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px">

        <!-- JSON -->
        <div class="kpi" style="display:flex;flex-direction:column;gap:6px">
          <div style="display:flex;align-items:center;gap:8px">
            <span style="font-size:22px">📋</span>
            <div>
              <div style="font-weight:700;font-size:14px">JSON</div>
              <div style="font-size:10px;color:var(--text2)">원본 완전 데이터</div>
            </div>
          </div>
          <div style="font-size:11px;color:var(--text2);line-height:1.6;border-top:1px solid var(--border);padding-top:6px">
            SDK가 생성한 평가 결과 원본 파일 그대로 다운로드.<br>
            모든 레이어(기본·에이전틱·하이브리드) 데이터 포함.<br>
            <span style="color:var(--accent)">재분석·파이프라인 연동·백업에 적합</span>
          </div>
          <div style="font-size:10px;color:var(--text2);background:var(--bg2);border-radius:6px;padding:6px 8px;font-family:monospace;line-height:1.8">
            tasks[] · accuracy_metrics<br>
            efficiency_metrics · pricing<br>
            <template x-if="data?.has_quality">
              <span>quality_detail · hallucination_detail<br></span>
            </template>
            <template x-if="data?.has_agentic">
              <span>agentic (tool/retry/workflow)<br></span>
            </template>
            <template x-if="data?.has_security">
              <span>security_l1 · security_l2<br></span>
            </template>
            <template x-if="data?.has_rag || data?.has_advanced">
              <span>advanced (RAG · DeepEval)</span>
            </template>
          </div>
          <a class="btn" :href="'/api/export/json/'+selId" download style="text-decoration:none;margin-top:auto">다운로드</a>
        </div>

        <!-- CSV -->
        <div class="kpi" style="display:flex;flex-direction:column;gap:6px">
          <div style="display:flex;align-items:center;gap:8px">
            <span style="font-size:22px">📊</span>
            <div>
              <div style="font-weight:700;font-size:14px">CSV</div>
              <div style="font-size:10px;color:var(--text2)">태스크별 지표 테이블</div>
            </div>
          </div>
          <div style="font-size:11px;color:var(--text2);line-height:1.6;border-top:1px solid var(--border);padding-top:6px">
            태스크 1건 = 1행. Excel·pandas 등 분석 도구에 바로 로드.<br>
            <span style="color:var(--accent)">데이터 분석·비교·필터링에 적합</span>
          </div>
          <div style="font-size:10px;color:var(--text2);background:var(--bg2);border-radius:6px;padding:6px 8px;font-family:monospace;line-height:1.8">
            task_id · task_type · success<br>
            completion_score · accuracy_score<br>
            execution_time · tokens_total<br>
            attempts · errors · framework<br>
            <template x-if="data?.has_agentic">
              <span>tool_calls_count<br></span>
            </template>
            <template x-if="data?.has_rag || data?.has_advanced">
              <span>ragas_* · g_eval_score · …</span>
            </template>
          </div>
          <a class="btn" :href="'/api/export/csv/'+selId" download style="text-decoration:none;margin-top:auto">다운로드</a>
        </div>

        <!-- HTML -->
        <div class="kpi" style="display:flex;flex-direction:column;gap:6px">
          <div style="display:flex;align-items:center;gap:8px">
            <span style="font-size:22px">🌐</span>
            <div>
              <div style="font-weight:700;font-size:14px">HTML</div>
              <div style="font-size:10px;color:var(--text2)">독립 실행형 리포트</div>
            </div>
          </div>
          <div style="font-size:11px;color:var(--text2);line-height:1.6;border-top:1px solid var(--border);padding-top:6px">
            브라우저에서 바로 열리는 시각적 리포트.<br>
            서버 없이 공유·보고서 첨부 가능.<br>
            <span style="color:var(--accent)">팀 공유·리뷰·아카이브에 적합</span>
          </div>
          <div style="font-size:10px;color:var(--text2);background:var(--bg2);border-radius:6px;padding:6px 8px;font-family:monospace;line-height:1.8">
            KPI 요약 · 성공/실패 차트<br>
            태스크 상세 테이블<br>
            <template x-if="data?.has_quality">
              <span>품질·환각 지표<br></span>
            </template>
            <template x-if="data?.has_security">
              <span>보안 L1/L2 요약<br></span>
            </template>
            <template x-if="data?.has_rag || data?.has_advanced">
              <span>RAG · DeepEval 지표</span>
            </template>
          </div>
          <a class="btn" :href="'/api/export/html/'+selId" download style="text-decoration:none;margin-top:auto">다운로드</a>
        </div>
      </div>

      <!-- 전체 파일 일괄 내보내기 -->
      <div class="sdiv"><div class="sdiv-lbl">전체 파일 일괄 내보내기</div><div class="sdiv-line"></div></div>
      <div style="display:flex;flex-direction:column;gap:6px">
        <template x-for="f in files" :key="f.id">
          <div class="kpi" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
            <div style="flex:1;min-width:0">
              <div style="font-size:12px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" x-text="f.name||f.id"></div>
              <div style="font-size:10px;color:var(--text2);margin-top:2px;display:flex;flex-wrap:wrap;gap:4px">
                <span x-show="f.has_quality" style="padding:1px 5px;border-radius:99px;background:#8b5cf622;color:#a78bfa">품질</span>
                <span x-show="f.has_agentic" style="padding:1px 5px;border-radius:99px;background:#06b6d422;color:#22d3ee">에이전틱</span>
                <span x-show="f.has_security" style="padding:1px 5px;border-radius:99px;background:#ef444422;color:#f87171">보안</span>
                <span x-show="f.has_rag" style="padding:1px 5px;border-radius:99px;background:#10b98122;color:#34d399">RAG</span>
                <span x-show="f.has_advanced" style="padding:1px 5px;border-radius:99px;background:#f59e0b22;color:#fbbf24">외부평가</span>
                <span style="color:var(--text2)" x-text="f.total_tasks+'개 태스크'"></span>
              </div>
            </div>
            <a class="btn" :href="'/api/export/json/'+f.id" download style="text-decoration:none;font-size:11px;padding:3px 10px">JSON</a>
            <a class="btn" :href="'/api/export/csv/'+f.id" download style="text-decoration:none;font-size:11px;padding:3px 10px">CSV</a>
            <a class="btn" :href="'/api/export/html/'+f.id" download style="text-decoration:none;font-size:11px;padding:3px 10px">HTML</a>
          </div>
        </template>
      </div>
    </div>
  </template>
</section>

<!-- ═══════════════ TRANSPARENCY ═══════════════ -->
<section id="s-transparency" class="sec" x-show="sec==='transparency'" x-cloak
         x-effect="if(sec==='transparency'){ loadTransparency('traces'); loadTransparency('annotations'); loadTransparency('audit'); }">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
    <span style="font-weight:700;font-size:15px">🔍 투명성</span>
    <button class="btn" @click="trDetail={};annDetail={};transpTraces=[];transpAnnotations=[];transpAudit=[];transpAuditItems=[];loadTransparency('traces');loadTransparency('annotations');loadTransparency('audit')">새로고침</button>
  </div>

  <!-- Sub-tabs -->
  <div style="display:flex;gap:6px;margin-bottom:14px;border-bottom:1px solid var(--border);padding-bottom:8px">
    <button class="btn" :style="transpTab==='annotations'?'background:var(--accent);color:#fff;border-color:var(--accent)':''"
            @click="loadTransparency('annotations');transpTab='annotations'">
      📝 어노테이션 <span class="badge-gray" x-text="transpAnnotations.length"></span>
    </button>
    <button class="btn" :style="transpTab==='traces'?'background:var(--accent);color:#fff;border-color:var(--accent)':''"
            @click="loadTransparency('traces');transpTab='traces'">
      🔬 추적 로그 <span class="badge-gray" x-text="transpTraces.length"></span>
    </button>
    <button class="btn" :style="transpTab==='audit'?'background:var(--accent);color:#fff;border-color:var(--accent)':''"
            @click="loadTransparency('audit');transpTab='audit'">
      📋 감사 로그 <span class="badge-gray" x-text="transpAudit.length"></span>
    </button>
  </div>

  <!-- ───── ANNOTATIONS ───── -->
  <div x-show="transpTab==='annotations'">
    <!-- 범위 안내 -->
    <div style="display:flex;align-items:flex-start;gap:8px;padding:10px 12px;background:rgba(99,102,241,.08);border:1px solid rgba(99,102,241,.25);border-radius:6px;font-size:12px;color:var(--text2);margin-bottom:12px">
      🔗
      <span><strong style="color:var(--text)">파일별 필터 적용</strong> — 현재 선택된 평가 파일
      (<code style="background:var(--bg3);padding:1px 4px;border-radius:3px" x-text="files.find(f=>f.id===selId)?.name||'없음'"></code>)과 연결된 어노테이션을 표시합니다.
      <code style="background:var(--bg3);padding:1px 4px;border-radius:3px">source_file_id</code>가 없는 글로벌 항목도 함께 표시됩니다.</span>
    </div>

    <!-- 새 어노테이션 작성 토글 -->
    <div style="display:flex;justify-content:flex-end;margin-bottom:10px">
      <button class="btn" @click="annForm.show=!annForm.show; if(annForm.show){ annForm.target_id=files.find(f=>f.id===selId)?.name||''; annForm.target_type='evaluation'; annForm.error=''; }"
              :style="annForm.show?'background:var(--accent);color:#fff;border-color:var(--accent)':''">
        ✏️ 새 어노테이션 작성
      </button>
    </div>

    <!-- 작성 폼 -->
    <div x-show="annForm.show" style="background:var(--bg3);border:1px solid var(--accent);border-radius:var(--r);padding:14px;margin-bottom:14px">
      <div style="font-size:13px;font-weight:600;color:var(--text);margin-bottom:10px">✏️ 어노테이션 작성</div>
      <!-- 제목 -->
      <div style="margin-bottom:8px">
        <label style="font-size:12px;color:var(--text2);display:block;margin-bottom:4px">제목 *</label>
        <input x-model="annForm.title" type="text" placeholder="어노테이션 제목을 입력하세요"
               style="width:100%;padding:6px 10px;background:var(--bg2);border:1px solid var(--border);border-radius:4px;color:var(--text);font-size:13px;box-sizing:border-box">
      </div>
      <!-- 유형 / 우선순위 / 작성자 -->
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:8px">
        <div>
          <label style="font-size:12px;color:var(--text2);display:block;margin-bottom:4px">유형</label>
          <select x-model="annForm.annotation_type"
                  style="width:100%;padding:6px 8px;background:var(--bg2);border:1px solid var(--border);border-radius:4px;color:var(--text);font-size:12px">
            <option value="note">📝 Note</option>
            <option value="warning">⚠️ Warning</option>
            <option value="review">🔍 Review</option>
            <option value="improvement">💡 Improvement</option>
            <option value="bug">🐛 Bug</option>
            <option value="question">❓ Question</option>
          </select>
        </div>
        <div>
          <label style="font-size:12px;color:var(--text2);display:block;margin-bottom:4px">우선순위</label>
          <select x-model="annForm.priority"
                  style="width:100%;padding:6px 8px;background:var(--bg2);border:1px solid var(--border);border-radius:4px;color:var(--text);font-size:12px">
            <option value="low">🟢 Low</option>
            <option value="medium">🟡 Medium</option>
            <option value="high">🟠 High</option>
            <option value="critical">🔴 Critical</option>
          </select>
        </div>
        <div>
          <label style="font-size:12px;color:var(--text2);display:block;margin-bottom:4px">작성자</label>
          <input x-model="annForm.author" type="text" placeholder="이름 (선택)"
                 style="width:100%;padding:6px 10px;background:var(--bg2);border:1px solid var(--border);border-radius:4px;color:var(--text);font-size:12px;box-sizing:border-box">
        </div>
      </div>
      <!-- 대상 유형 / 대상 ID -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px">
        <div>
          <label style="font-size:12px;color:var(--text2);display:block;margin-bottom:4px">대상 유형</label>
          <select x-model="annForm.target_type"
                  style="width:100%;padding:6px 8px;background:var(--bg2);border:1px solid var(--border);border-radius:4px;color:var(--text);font-size:12px">
            <option value="evaluation">evaluation</option>
            <option value="metric">metric</option>
            <option value="task">task</option>
            <option value="dataset">dataset</option>
          </select>
        </div>
        <div>
          <label style="font-size:12px;color:var(--text2);display:block;margin-bottom:4px">대상 ID (선택)</label>
          <input x-model="annForm.target_id" type="text" placeholder="예: task_001, tcr"
                 style="width:100%;padding:6px 10px;background:var(--bg2);border:1px solid var(--border);border-radius:4px;color:var(--text);font-size:12px;box-sizing:border-box">
        </div>
      </div>
      <!-- 내용 -->
      <div style="margin-bottom:10px">
        <label style="font-size:12px;color:var(--text2);display:block;margin-bottom:4px">내용 *</label>
        <textarea x-model="annForm.content" rows="4" placeholder="어노테이션 내용을 입력하세요"
                  style="width:100%;padding:6px 10px;background:var(--bg2);border:1px solid var(--border);border-radius:4px;color:var(--text);font-size:12px;resize:vertical;box-sizing:border-box"></textarea>
      </div>
      <!-- 에러 -->
      <div x-show="annForm.error" style="color:var(--red);font-size:12px;margin-bottom:8px" x-text="annForm.error"></div>
      <!-- 버튼 -->
      <div style="display:flex;gap:8px;justify-content:flex-end">
        <button class="btn" @click="annForm.show=false;annForm.error=''">취소</button>
        <button class="btn" @click="saveAnnotation()" :disabled="annForm.saving"
                style="background:var(--accent);color:#fff;border-color:var(--accent)"
                x-text="annForm.saving?'저장 중...':'저장'"></button>
      </div>
    </div>

    <!-- 어노테이션 목록 -->
