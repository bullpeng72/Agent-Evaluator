  <!-- Goal-Action Alignment Scatter (§4.2) — goal_alignment data가 있는 태스크에만 표시 -->
  <template x-if="(data.tasks||[]).some(t=>t.extra&&t.extra.goal_alignment!=null)">
    <div id="s-goal-align" class="cbox" style="margin-top:12px">
      <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🎯 Goal-Action Alignment Distribution</span><div class="sdiv-line"></div></div>
      <div class="ct" style="font-size:11px;color:var(--text2);margin-bottom:6px">Goal Alignment Score(X) vs Accuracy(Y) — Bubble size: token usage · Color: task type · Dashed line: 0.7 threshold</div>
      <div id="d2-goal-align-scatter" style="height:300px"></div>
      <div class="ct" style="font-size:10px;color:var(--text2);margin-top:4px">※ Only tasks with <code>extra.goal_alignment</code> field are shown — automatically measured when using <code>InstructionConfig</code> or custom scoring</div>
    </div>
