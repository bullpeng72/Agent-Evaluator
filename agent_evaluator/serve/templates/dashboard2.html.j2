    selK:null,
    meta:{
      defense_rate:{label:'방어율',unit:'%',desc:'권한 상승 시도 방어 성공 비율',hint:'privilege_escalation score'},
      escalation_events:{label:'상승 이벤트',unit:'건',desc:'탐지된 권한 상승 시도 이벤트 수',hint:'security_l2.escalation_events'},
      attack_detections:{label:'공격 탐지',unit:'건',desc:'탐지된 공격 체인 수',hint:'security_l2.attack_detections'},
    },
    formula(k,d){
      if(k==='defense_rate')return `방어율 = ${d.security_l2?.privilege_escalation||0}%`;
      if(k==='escalation_events')return `상승 이벤트 = ${d.security_l2?.escalation_events||0}건`;
      if(k==='attack_detections')return `공격 탐지 = ${d.security_l2?.attack_detections||0}건`;
      return '';
    },
    items(k,d){return d.security_l2?.escalation_events_list||d.security_l2?.attack_detections_list||[];},
    filterLabel(k){return '탐지 이벤트';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='defense_rate'}" @click="selK=selK==='defense_rate'?null:'defense_rate'">
        <div class="kpi-lbl">방어율</div>
        <div class="kpi-val" :style="`color:${$root.bc(data.security_l2?.privilege_escalation||0,90,70)}`"
             x-text="$root.pct(data.security_l2?.privilege_escalation||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='escalation_events'}" @click="selK=selK==='escalation_events'?null:'escalation_events'">
        <div class="kpi-lbl">상승 이벤트</div>
        <div class="kpi-val" :style="`color:${(data.security_l2?.escalation_events||0)>0?'var(--red)':'var(--green)'}`"
             x-text="data.security_l2?.escalation_events||0"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='attack_detections'}" @click="selK=selK==='attack_detections'?null:'attack_detections'">
        <div class="kpi-lbl">공격 탐지</div>
        <div class="kpi-val" x-text="data.security_l2?.attack_detections||0"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="padding:10px 14px;background:var(--bg2)">
            <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            <div style="font-size:12px;font-family:monospace;color:var(--accent);margin-top:8px;white-space:pre-line" x-text="formula(selK,$root.data)"></div>
          </div>
        </div>
      </template>
    </div>
  </div>

  <!-- OWASP LLM Top 10 -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔐 OWASP LLM Top 10 대응</span><div class="sdiv-line"></div></div>
  <div class="sec">
    <div class="sec-t">OWASP LLM Top 10 (2025) — 트래커 매핑</div>
    <div class="dtx">
      <div class="dtx-row dtx-head" style="grid-template-columns:50px 1fr 1fr 60px">
        <span>ID</span><span>위협</span><span>관련 트래커</span><span>평가</span>
      </div>
      <template x-for="item in [
        {id:'LLM01',threat:'Prompt Injection',tracker:'InputSanitizationTracker',covered:true},
        {id:'LLM02',threat:'Insecure Output Handling',tracker:'OutputLeakageDetector',covered:true},
        {id:'LLM03',threat:'Training Data Poisoning',tracker:'(외부 평가 필요)',covered:false},
        {id:'LLM04',threat:'Model Denial of Service',tracker:'LatencyTracker',covered:true},
        {id:'LLM05',threat:'Supply Chain Vulnerabilities',tracker:'(외부 평가 필요)',covered:false},
        {id:'LLM06',threat:'Sensitive Info Disclosure',tracker:'OutputLeakageDetector',covered:true},
        {id:'LLM07',threat:'Insecure Plugin Design',tracker:'ToolAuthorizationTracker',covered:true},
        {id:'LLM08',threat:'Excessive Agency',tracker:'PrivilegeEscalationDetector',covered:true},
        {id:'LLM09',threat:'Overreliance',tracker:'HallucinationDetector + AccuracyEvaluator',covered:true},
        {id:'LLM10',threat:'Model Theft',tracker:'(네트워크 레이어 평가 필요)',covered:false},
      ]" :key="item.id">
        <div class="dtx-row" style="grid-template-columns:50px 1fr 1fr 60px">
          <span class="badge-info" x-text="item.id"></span>
          <span style="font-size:12px" x-text="item.threat"></span>
          <span style="font-size:11px;color:var(--text2)" x-text="item.tracker"></span>
          <span :class="item.covered?'badge-ok':'badge-gray'" x-text="item.covered?'✓ 평가':'—'"></span>
        </div>
      </template>
    </div>
    <div style="margin-top:8px;font-size:11px;color:var(--text2)">
      ⓘ Agent-Evaluator v{{ version }} 기준. 평가 커버리지 7/10 (LLM03·LLM05·LLM10은 외부 평가 필요)
    </div>
  </div>

  </div><!-- /has_security -->
</div><!-- /security -->
<!-- ===== SECTION 7: TASKS ===== -->
<section id="s-tasks" class="sec" x-show="sec==='tasks'" x-cloak>
  <h2 class="sh">태스크 목록</h2>

  <!-- Filter Bar -->
  <div class="card mb-4" x-data="{open:false}">
    <div class="flex flex-wrap gap-3 items-center">
      <div class="flex items-center gap-2">
        <label class="text-xs text-gray-500 dark:text-gray-400">유형</label>
        <select x-model="taskFilter.type" class="text-sm border border-gray-300 dark:border-gray-600 rounded px-2 py-1 bg-white dark:bg-gray-700 dark:text-white">
          <option value="">전체</option>
          <template x-for="t in taskTypes()" :key="t"><option :value="t" x-text="t"></option></template>
        </select>
      </div>
      <div class="flex items-center gap-2">
        <label class="text-xs text-gray-500 dark:text-gray-400">상태</label>
        <select x-model="taskFilter.status" class="text-sm border border-gray-300 dark:border-gray-600 rounded px-2 py-1 bg-white dark:bg-gray-700 dark:text-white">
          <option value="">전체</option>
          <option value="success">성공</option>
          <option value="fail">실패</option>
        </select>
      </div>
      <div class="flex items-center gap-2 flex-1">
        <label class="text-xs text-gray-500 dark:text-gray-400">검색</label>
        <input x-model="taskFilter.q" type="text" placeholder="task_id 또는 에러 검색..." class="text-sm border border-gray-300 dark:border-gray-600 rounded px-2 py-1 bg-white dark:bg-gray-700 dark:text-white flex-1" />
      </div>
      <span class="text-xs text-indigo-600 dark:text-indigo-400 font-semibold" x-text="filteredTasks().length + ' 건'"></span>
      <button @click="open=!open" class="text-xs px-2 py-1 rounded bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600" x-text="open ? '차트 숨기기' : '차트 보기'"></button>
    </div>
    <div x-show="open" x-transition class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
      <div><div id="d2-ts-type-tcr" style="height:260px"></div></div>
      <div><div id="d2-ts-scatter" style="height:260px"></div></div>
    </div>
  </div>

  <!-- Task Table -->
  <div class="card overflow-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-xs text-gray-500 dark:text-gray-400 border-b border-gray-200 dark:border-gray-700">
          <th class="py-2 pr-4 font-medium">Task ID</th>
          <th class="py-2 pr-4 font-medium">유형</th>
          <th class="py-2 pr-4 font-medium">상태</th>
          <th class="py-2 pr-3 font-medium" style="min-width:120px">완료율</th>
          <th class="py-2 pr-3 font-medium">정확도</th>
          <th class="py-2 pr-3 font-medium">지연(s)</th>
          <th class="py-2 pr-3 font-medium">토큰</th>
          <th class="py-2 pr-3 font-medium">도구호출</th>
          <th class="py-2 font-medium">오류</th>
        </tr>
      </thead>
      <tbody>
        <template x-for="(t,i) in filteredTasks()" :key="t.task_id||i">
          <tr class="border-b border-gray-100 dark:border-gray-800 hover:bg-gray-50 dark:hover:bg-gray-800/50 dtx cursor-pointer"
              @click="t._open=!t._open; $el.nextElementSibling && $el.nextElementSibling.classList.toggle('hidden')">
            <td class="py-2 pr-4 font-mono text-xs" x-text="t.task_id||'—'"></td>
            <td class="py-2 pr-4 text-xs" x-text="t.task_type||'—'"></td>
            <td class="py-2 pr-4">
              <span class="badge" :class="t.success ? 'badge-green' : 'badge-red'" x-text="t.success ? '성공' : '실패'"></span>
            </td>
            <td class="py-2 pr-3">
              <div class="flex items-center gap-2">
                <div class="pscore-bar flex-1">
                  <div class="pscore-fill" :style="`width:${pct(t.completion_score||0,1)}%`"></div>
                </div>
                <span class="text-xs tabular-nums w-10 text-right" x-text="pct(t.completion_score||0,1).toFixed(0)+'%'"></span>
              </div>
            </td>
            <td class="py-2 pr-3 text-xs tabular-nums" x-text="t.accuracy_score!=null ? (t.accuracy_score*100).toFixed(1)+'%' : '—'"></td>
            <td class="py-2 pr-3 text-xs tabular-nums" x-text="t.execution_time!=null ? t.execution_time.toFixed(2) : '—'"></td>
            <td class="py-2 pr-3 text-xs tabular-nums" x-text="t.tokens_used!=null ? fmtNum(t.tokens_used) : '—'"></td>
            <td class="py-2 pr-3 text-xs tabular-nums" x-text="t.tool_calls!=null ? t.tool_calls : '—'"></td>
            <td class="py-2 text-xs text-red-500 dark:text-red-400 truncate max-w-xs" x-text="(t.errors&&t.errors.length)?t.errors[0]:'—'"></td>
          </tr>
          <template x-if="t._open && (!t.success || (t.errors&&t.errors.length))">
            <tr>
              <td colspan="9" class="px-4 py-3 bg-red-50 dark:bg-red-900/20 text-xs">
                <div class="font-semibold text-red-700 dark:text-red-300 mb-1">오류 상세</div>
                <template x-for="(e,ei) in (t.errors||[])" :key="ei">
                  <div class="font-mono text-red-600 dark:text-red-400 mb-0.5" x-text="e"></div>
                </template>
                <template x-if="!(t.errors&&t.errors.length)">
                  <div class="text-gray-500">기록된 오류 없음</div>
                </template>
              </td>
            </tr>
          </template>
        </template>
        <template x-if="filteredTasks().length===0">
          <tr>
            <td colspan="9" class="py-8 text-center text-gray-400 text-sm">조건에 맞는 태스크가 없습니다</td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>
</section>
<!-- ===== SECTION 8: INSIGHTS ===== -->
<section id="s-insights" class="sec" x-show="sec==='insights'" x-cloak>
  <h2 class="sh">인사이트 &amp; 분석</h2>

  <!-- Auto Anomalies -->
  <div class="sdiv">자동 이상 탐지</div>
  <div class="card mb-4" x-data="{expanded:true}">
    <div class="flex items-center justify-between mb-3">
      <h3 class="font-semibold text-gray-800 dark:text-gray-200">임계치 기반 이상 항목</h3>
      <button @click="expanded=!expanded" class="text-xs px-2 py-1 rounded bg-gray-100 dark:bg-gray-700 hover:bg-gray-200" x-text="expanded?'접기':'펼치기'"></button>
    </div>
    <div x-show="expanded" x-transition>
      <template x-if="autoAnomalies().length===0">
        <div class="text-center py-6 text-green-600 dark:text-green-400 text-sm font-medium">이상 항목 없음 — 모든 지표가 임계치 내에 있습니다</div>
      </template>
      <template x-for="(a,i) in autoAnomalies()" :key="i">
        <div class="flex items-start gap-3 py-2 border-b border-gray-100 dark:border-gray-800 last:border-0">
          <span class="badge mt-0.5" :class="a.level==='critical'?'badge-red':a.level==='warn'?'badge-yellow':'badge-blue'" x-text="a.level==='critical'?'위험':a.level==='warn'?'경고':'정보'"></span>
          <div>
            <div class="text-sm font-medium text-gray-800 dark:text-gray-200" x-text="a.metric"></div>
            <div class="text-xs text-gray-500 dark:text-gray-400" x-text="a.detail"></div>
          </div>
        </div>
      </template>
    </div>
  </div>

  <!-- Threshold Settings -->
  <div class="sdiv">임계치 설정</div>
  <div class="card mb-4">
    <h3 class="font-semibold text-gray-800 dark:text-gray-200 mb-3">이상 탐지 임계치</h3>
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
      <div>
        <label class="text-xs text-gray-500 dark:text-gray-400 block mb-1">TCR 최솟값</label>
        <input type="number" step="0.01" min="0" max="1" x-model.number="thresholds.tcr_min" class="w-full text-sm border border-gray-300 dark:border-gray-600 rounded px-2 py-1 bg-white dark:bg-gray-700 dark:text-white" />
      </div>
      <div>
        <label class="text-xs text-gray-500 dark:text-gray-400 block mb-1">정확도 최솟값</label>
        <input type="number" step="0.01" min="0" max="1" x-model.number="thresholds.acc_min" class="w-full text-sm border border-gray-300 dark:border-gray-600 rounded px-2 py-1 bg-white dark:bg-gray-700 dark:text-white" />
      </div>
      <div>
        <label class="text-xs text-gray-500 dark:text-gray-400 block mb-1">환각률 최댓값</label>
        <input type="number" step="0.01" min="0" max="1" x-model.number="thresholds.hall_max" class="w-full text-sm border border-gray-300 dark:border-gray-600 rounded px-2 py-1 bg-white dark:bg-gray-700 dark:text-white" />
      </div>
      <div>
        <label class="text-xs text-gray-500 dark:text-gray-400 block mb-1">P95 지연(s) 최댓값</label>
        <input type="number" step="0.1" min="0" x-model.number="thresholds.p95_max" class="w-full text-sm border border-gray-300 dark:border-gray-600 rounded px-2 py-1 bg-white dark:bg-gray-700 dark:text-white" />
      </div>
      <div>
        <label class="text-xs text-gray-500 dark:text-gray-400 block mb-1">평균 비용($) 최댓값</label>
        <input type="number" step="0.0001" min="0" x-model.number="thresholds.cost_max" class="w-full text-sm border border-gray-300 dark:border-gray-600 rounded px-2 py-1 bg-white dark:bg-gray-700 dark:text-white" />
      </div>
    </div>
  </div>

  <!-- Z-Score Statistical Anomalies -->
  <div class="sdiv">통계적 이상 탐지 (Z-Score)</div>
  <div class="card mb-4">
    <h3 class="font-semibold text-gray-800 dark:text-gray-200 mb-1">|z| &gt; 2 태스크</h3>
    <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">지연 또는 정확도가 평균에서 표준편차 2배 이상 벗어난 태스크</p>
    <template x-if="zScoreAnomalies().length===0">
      <div class="text-center py-4 text-gray-400 text-sm">통계적 이상 태스크 없음</div>
    </template>
    <template x-if="zScoreAnomalies().length>0">
      <div class="overflow-auto">
        <table class="w-full text-xs">
          <thead>
            <tr class="text-left text-gray-500 dark:text-gray-400 border-b border-gray-200 dark:border-gray-700">
              <th class="py-1.5 pr-4">Task ID</th>
              <th class="py-1.5 pr-4">유형</th>
              <th class="py-1.5 pr-4">지연(s)</th>
              <th class="py-1.5 pr-4">지연 Z</th>
              <th class="py-1.5 pr-4">정확도</th>
              <th class="py-1.5">정확도 Z</th>
            </tr>
          </thead>
          <tbody>
            <template x-for="(z,i) in zScoreAnomalies()" :key="i">
              <tr class="border-b border-gray-100 dark:border-gray-800">
                <td class="py-1.5 pr-4 font-mono" x-text="z.task_id"></td>
                <td class="py-1.5 pr-4" x-text="z.task_type||'—'"></td>
                <td class="py-1.5 pr-4" x-text="z.lat!=null?z.lat.toFixed(2):'—'"></td>
                <td class="py-1.5 pr-4" :class="Math.abs(z.zLat||0)>2?'text-red-500 dark:text-red-400 font-semibold':''">
                  <span x-text="z.zLat!=null?z.zLat.toFixed(2):'—'"></span>
                </td>
                <td class="py-1.5 pr-4" x-text="z.acc!=null?(z.acc*100).toFixed(1)+'%':'—'"></td>
                <td class="py-1.5" :class="Math.abs(z.zAcc||0)>2?'text-red-500 dark:text-red-400 font-semibold':''">
                  <span x-text="z.zAcc!=null?z.zAcc.toFixed(2):'—'"></span>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </template>
  </div>

  <!-- Metric Correlation -->
  <div class="sdiv">지표 상관관계</div>
  <div class="card mb-4">
    <h3 class="font-semibold text-gray-800 dark:text-gray-200 mb-1">Pearson 상관계수</h3>
    <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">accuracy_score / execution_time / tokens_used / completion_score 4개 지표 간 상관관계</p>
    <div class="overflow-auto">
      <table class="text-xs text-center">
        <thead>
          <tr class="text-gray-500 dark:text-gray-400">
            <th class="py-1.5 pr-3 text-left"></th>
            <template x-for="col in ['accuracy','latency','tokens','completion']" :key="col">
              <th class="py-1.5 px-3 font-medium" x-text="col"></th>
            </template>
          </tr>
        </thead>
        <tbody>
          <template x-for="row in corrMatrix()" :key="row.label">
            <tr class="border-b border-gray-100 dark:border-gray-800">
              <td class="py-1.5 pr-3 text-left font-medium text-gray-700 dark:text-gray-300" x-text="row.label"></td>
              <template x-for="(v,ci) in row.vals" :key="ci">
                <td class="py-1.5 px-3 tabular-nums"
                    :style="`background:${v===1?'transparent':v>0.5?'rgba(99,102,241,'+Math.abs(v)*0.3+')':v<-0.5?'rgba(239,68,68,'+Math.abs(v)*0.3+')':'transparent'}`"
                    x-text="v!=null?v.toFixed(2):'—'"></td>
              </template>
            </tr>
          </template>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Deploy Gates / Metrics PASS/FAIL -->
  <div class="sdiv">배포 게이트</div>
  <div class="card mb-4">
    <h3 class="font-semibold text-gray-800 dark:text-gray-200 mb-3">핵심 지표 PASS / FAIL</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      <template x-for="g in deployGates()" :key="g.name">
        <div class="flex items-center justify-between p-3 rounded-lg border" :class="g.pass?'border-green-200 dark:border-green-800 bg-green-50 dark:bg-green-900/20':'border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-900/20'">
          <div>
            <div class="text-sm font-medium" :class="g.pass?'text-green-800 dark:text-green-200':'text-red-800 dark:text-red-200'" x-text="g.name"></div>
            <div class="text-xs mt-0.5" :class="g.pass?'text-green-600 dark:text-green-400':'text-red-600 dark:text-red-400'" x-text="g.detail"></div>
          </div>
          <span class="badge ml-4" :class="g.pass?'badge-green':'badge-red'" x-text="g.pass?'PASS':'FAIL'"></span>
        </div>
      </template>
    </div>
  </div>

  <!-- Server Alerts -->
  <template x-if="data.insights && data.insights.alerts && data.insights.alerts.length">
    <div>
      <div class="sdiv">서버 알림</div>
      <div class="card mb-4">
        <template x-for="(al,i) in data.insights.alerts" :key="i">
          <div class="flex items-start gap-3 py-2 border-b border-gray-100 dark:border-gray-800 last:border-0">
            <span class="badge mt-0.5" :class="al.level==='error'?'badge-red':al.level==='warn'?'badge-yellow':'badge-blue'" x-text="al.level||'info'"></span>
            <div class="text-sm text-gray-700 dark:text-gray-300" x-text="al.message||al"></div>
          </div>
        </template>
      </div>
    </div>
  </template>

  <!-- Recommendations -->
  <template x-if="data.insights && data.insights.recommendations && data.insights.recommendations.length">
    <div>
      <div class="sdiv">권고사항</div>
      <div class="card mb-4">
        <template x-for="(r,i) in data.insights.recommendations" :key="i">
          <div class="flex items-start gap-3 py-2 border-b border-gray-100 dark:border-gray-800 last:border-0">
            <span class="badge mt-0.5" :class="(r.priority||r.level)==='high'?'badge-red':(r.priority||r.level)==='medium'?'badge-yellow':'badge-blue'" x-text="(r.priority||r.level||'low').toUpperCase()"></span>
            <div>
              <div class="text-sm font-medium text-gray-800 dark:text-gray-200" x-text="r.title||r.message||r"></div>
              <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5" x-text="r.detail||''"></div>
            </div>
          </div>
        </template>
      </div>
    </div>
  </template>

</section>

    </main><!-- /main -->
  </div><!-- /layout -->

  <!-- Status Bar -->
  <div class="status-bar">
    <span x-text="data ? (data.title||'평가 결과') : '—'"></span>
    <span class="mx-2 opacity-40">|</span>
    <span x-text="data ? ((data.summary&&data.summary.total_tasks)||0) + ' 태스크' : '—'"></span>
    <span class="mx-2 opacity-40">|</span>
    <span x-text="data ? (data.generated_at||data.timestamp||'') : '—'"></span>
    <span class="flex-1"></span>
    <template x-if="connected">
      <span class="flex items-center gap-1.5 text-green-400"><span class="w-2 h-2 rounded-full bg-green-400 animate-pulse inline-block"></span>Live</span>
    </template>
    <template x-if="!connected">
      <span class="text-gray-400">정적</span>
    </template>
    <span class="mx-2 opacity-40">|</span>
    <span>Agent-Evaluator v{{ version }}</span>
  </div>

</div><!-- /x-data app2 -->
<script>
/* ── standalone helper (used by both app2 and badge pre-render) ── */
function autoAnomalies_inner(data, thresholds) {
  if (!data) return [];
  const s = data.summary || {};
  const out = [];
  const tcr = s.task_completion_rate ?? s.overall_tcr ?? null;
  const acc = s.accuracy_rate ?? s.overall_accuracy ?? null;
  const hall = s.hallucination_rate ?? null;
  const p95 = s.p95_latency ?? null;
  const avgCost = s.avg_cost_per_task ?? null;

  if (tcr !== null && tcr < thresholds.tcr_min)
    out.push({ level: 'critical', metric: '태스크 완료율 (TCR)', detail: `현재 ${(tcr*100).toFixed(1)}% < 임계치 ${(thresholds.tcr_min*100).toFixed(0)}%` });
  if (acc !== null && acc < thresholds.acc_min)
    out.push({ level: 'warn', metric: '정확도', detail: `현재 ${(acc*100).toFixed(1)}% < 임계치 ${(thresholds.acc_min*100).toFixed(0)}%` });
  if (hall !== null && hall > thresholds.hall_max)
    out.push({ level: 'critical', metric: '환각률', detail: `현재 ${(hall*100).toFixed(1)}% > 임계치 ${(thresholds.hall_max*100).toFixed(0)}%` });
  if (p95 !== null && p95 > thresholds.p95_max)
    out.push({ level: 'warn', metric: 'P95 지연', detail: `현재 ${p95.toFixed(2)}s > 임계치 ${thresholds.p95_max}s` });
  if (avgCost !== null && avgCost > thresholds.cost_max)
    out.push({ level: 'warn', metric: '평균 비용', detail: `현재 $${avgCost.toFixed(4)} > 임계치 $${thresholds.cost_max}` });
  return out;
}

/* ── main Alpine.js app ── */
function app2() {
  return {
    dark: false,
    sec: 'overview',
    files: [],
    selId: null,
    data: null,
    loading: false,
    connected: false,
    taskFilter: { type: '', status: '', q: '' },
    thresholds: { tcr_min: 0.8, acc_min: 0.7, hall_max: 0.2, p95_max: 5, cost_max: 0.01 },
    nav: [
      { id:'overview',   label:'개요',        icon:'📊' },
      { id:'quality',    label:'품질',         icon:'🎯' },
      { id:'external',   label:'외부 평가',    icon:'🔬' },
      { id:'performance',label:'성능',         icon:'⚡' },
      { id:'agentic',    label:'에이전틱',     icon:'🤖' },
      { id:'security',   label:'보안',         icon:'🔒' },
      { id:'tasks',      label:'태스크',       icon:'📋' },
      { id:'insights',   label:'인사이트',     icon:'💡' },
    ],

    /* ── lifecycle ── */
    async init() {
      const saved = localStorage.getItem('d2-dark');
      if (saved !== null) this.dark = saved === 'true';
      else this.dark = window.matchMedia('(prefers-color-scheme:dark)').matches;
      this._applyDark();
      await this.refresh();
      {% if watch %}this._connectSSE();{% endif %}
    },
    _applyDark() {
      document.documentElement.classList.toggle('dark', this.dark);
      localStorage.setItem('d2-dark', this.dark);
    },
    toggleDark() { this.dark = !this.dark; this._applyDark(); },

    async refresh() {
      this.loading = true;
      try {
        const res = await fetch('/api/results');
        const list = await res.json();
        this.files = list;
        if (list.length && !this.selId) this.selId = list[0].id;
        if (this.selId) await this.loadFile(this.selId);
      } catch(e) { console.warn('refresh error', e); }
      finally { this.loading = false; }
    },

    async loadFile(id) {
      this.selId = id;
      this.loading = true;
      try {
        const res = await fetch(`/api/results/${id}`);
        this.data = await res.json();
        this.$nextTick(() => this.drawCharts());
      } catch(e) { console.warn('loadFile error', e); }
      finally { this.loading = false; }
    },

    {% if watch %}
    _connectSSE() {
      const es = new EventSource('/api/stream');
      es.addEventListener('update', async () => {
        if (this.selId) await this.loadFile(this.selId);
        else await this.refresh();
      });
      es.addEventListener('open', () => { this.connected = true; });
      es.addEventListener('error', () => { this.connected = false; });
    },
    {% endif %}

    /* ── helper functions ── */
    pct(v, scale=1) { if (v==null) return 0; return Math.min(100, Math.max(0, (v/scale)*100)); },
    sec_(v) { if (v==null) return '—'; return v.toFixed(2)+'s'; },
    cost(v) { if (v==null) return '—'; return '$'+v.toFixed(4); },
    fmtNum(v) { if (v==null) return '—'; if (v>=1e6) return (v/1e6).toFixed(1)+'M'; if (v>=1e3) return (v/1e3).toFixed(1)+'K'; return v.toString(); },
    bc(v) {
      if (v==null) return 'badge-gray';
      if (v>=0.9) return 'badge-green';
      if (v>=0.7) return 'badge-yellow';
      return 'badge-red';
    },
    bc2lat(v) {
      if (v==null) return 'badge-gray';
      if (v<=2) return 'badge-green';
      if (v<=5) return 'badge-yellow';
      return 'badge-red';
    },
    hallRate() {
      const s = this.data?.summary || {};
      return s.hallucination_rate ?? s.hallucination_ratio ?? null;
    },
    tcr_() {
      const s = this.data?.summary || {};
      return s.task_completion_rate ?? s.overall_tcr ?? null;
    },
    acc_() {
      const s = this.data?.summary || {};
      return s.accuracy_rate ?? s.overall_accuracy ?? null;
    },
    taskTypes() {
      const tasks = this.data?.tasks || [];
      return [...new Set(tasks.map(t => t.task_type).filter(Boolean))];
    },
    filteredTasks() {
      const tasks = this.data?.tasks || [];
      const { type, status, q } = this.taskFilter;
      return tasks.filter(t => {
        if (type && t.task_type !== type) return false;
        if (status === 'success' && !t.success) return false;
        if (status === 'fail' && t.success) return false;
        if (q) {
          const ql = q.toLowerCase();
          if (!(t.task_id||'').toLowerCase().includes(ql) &&
              !(t.errors||[]).join(' ').toLowerCase().includes(ql)) return false;
        }
        return true;
      });
    },
    slowTasks(n=5) {
      const tasks = this.data?.tasks || [];
      return [...tasks].sort((a,b) => (b.execution_time||0)-(a.execution_time||0)).slice(0,n);
    },
    deployGates() {
      const s = this.data?.summary || {};
      const t = this.thresholds;
      const tcr = s.task_completion_rate ?? s.overall_tcr ?? null;
      const acc = s.accuracy_rate ?? s.overall_accuracy ?? null;
      const hall = s.hallucination_rate ?? null;
      const p95 = s.p95_latency ?? null;
      const cost = s.avg_cost_per_task ?? null;
      return [
        { name: '태스크 완료율 (TCR)', pass: tcr==null||tcr>=t.tcr_min, detail: `${tcr!=null?(tcr*100).toFixed(1)+'%':'N/A'} (임계치: ${(t.tcr_min*100).toFixed(0)}%)` },
        { name: '정확도', pass: acc==null||acc>=t.acc_min, detail: `${acc!=null?(acc*100).toFixed(1)+'%':'N/A'} (임계치: ${(t.acc_min*100).toFixed(0)}%)` },
        { name: '환각률', pass: hall==null||hall<=t.hall_max, detail: `${hall!=null?(hall*100).toFixed(1)+'%':'N/A'} (임계치: ≤${(t.hall_max*100).toFixed(0)}%)` },
        { name: 'P95 지연', pass: p95==null||p95<=t.p95_max, detail: `${p95!=null?p95.toFixed(2)+'s':'N/A'} (임계치: ≤${t.p95_max}s)` },
        { name: '평균 비용', pass: cost==null||cost<=t.cost_max, detail: `${cost!=null?'$'+cost.toFixed(4):'N/A'} (임계치: ≤$${t.cost_max})` },
      ];
    },
    autoAnomalies() { return autoAnomalies_inner(this.data, this.thresholds); },
    _perspVal(key) {
      const adv = this.data?.advanced || {};
      return adv[key] ?? adv.summary?.[key] ?? null;
    },
    zScoreAnomalies() {
      const tasks = this.data?.tasks || [];
      if (tasks.length < 3) return [];
      const lats = tasks.map(t => t.execution_time).filter(v => v!=null);
      const accs = tasks.map(t => t.accuracy_score).filter(v => v!=null);
      const mean = arr => arr.reduce((a,b)=>a+b,0)/arr.length;
      const std = arr => { const m=mean(arr); return Math.sqrt(arr.reduce((a,b)=>a+(b-m)**2,0)/arr.length); };
      const mLat=mean(lats), sLat=std(lats)||1, mAcc=mean(accs), sAcc=std(accs)||1;
      const out = [];
      for (const t of tasks) {
        const zLat = t.execution_time!=null ? (t.execution_time-mLat)/sLat : null;
        const zAcc = t.accuracy_score!=null ? (t.accuracy_score-mAcc)/sAcc : null;
        if ((zLat!=null && Math.abs(zLat)>2) || (zAcc!=null && Math.abs(zAcc)>2))
          out.push({ task_id:t.task_id, task_type:t.task_type, lat:t.execution_time, zLat, acc:t.accuracy_score, zAcc });
      }
      return out.sort((a,b) => Math.max(Math.abs(b.zLat||0),Math.abs(b.zAcc||0)) - Math.max(Math.abs(a.zLat||0),Math.abs(a.zAcc||0)));
    },
    corrMatrix() {
      const tasks = this.data?.tasks || [];
      const keys = ['accuracy_score','execution_time','tokens_used','completion_score'];
      const labels = ['accuracy','latency','tokens','completion'];
      const pearson = (xs,ys) => {
        const n=xs.length; if(!n) return null;
        const mx=xs.reduce((a,b)=>a+b,0)/n, my=ys.reduce((a,b)=>a+b,0)/n;
        let num=0,dx=0,dy=0;
        for (let i=0;i<n;i++) { num+=(xs[i]-mx)*(ys[i]-my); dx+=(xs[i]-mx)**2; dy+=(ys[i]-my)**2; }
        if (!dx||!dy) return null;
        return num/Math.sqrt(dx*dy);
      };
      return keys.map((rk,ri) => ({
        label: labels[ri],
        vals: keys.map((ck,ci) => {
          if (ri===ci) return 1;
          const pairs = tasks.map(t => [t[rk],t[ck]]).filter(([a,b])=>a!=null&&b!=null);
          if (pairs.length<3) return null;
          return pearson(pairs.map(p=>p[0]), pairs.map(p=>p[1]));
        })
      }));
    },
    ragKpis() {
      const adv = this.data?.advanced || {};
      const r = adv.ragas || adv.rag || {};
      const tasks = this.data?.tasks || [];
      const ragTasks = tasks.filter(t => t.ragas_metrics || t.rag_metrics);
      const n = ragTasks.length;
      const avg = key => {
        if (r[key]!=null) return r[key];
        if (!n) return null;
        const vals = ragTasks.map(t=>(t.ragas_metrics||t.rag_metrics||{})[key]).filter(v=>v!=null);
        return vals.length ? vals.reduce((a,b)=>a+b,0)/vals.length : null;
      };
      return {
        faithfulness: avg('faithfulness'),
        answer_relevancy: avg('answer_relevancy'),
        context_recall: avg('context_recall'),
        context_precision: avg('context_precision'),
        overall: r.overall ?? r.overall_score ?? null,
        n,
      };
    },
    deepevalKpis() {
      const adv = this.data?.advanced || {};
      const de = adv.deepeval || adv.deep_eval || {};
      const metrics = de.metrics || de.summary || {};
      const tasks = this.data?.tasks || [];
      const deTasks = tasks.filter(t => t.deepeval_metrics || t.deep_eval_metrics);
      return {
        metrics,
        n: deTasks.length,
        keys: Object.keys(metrics).filter(k => !k.startsWith('ragas_')),
      };
    },
    frameworkDist(data) {
      const tasks = (data||this.data)?.tasks || [];
      const cnt = {};
      for (const t of tasks) {
        const fw = t.framework || t.agent_framework || 'unknown';
        cnt[fw] = (cnt[fw]||0) + 1;
      }
      const total = tasks.length || 1;
      return Object.entries(cnt).map(([fw,c]) => ({ fw, c, pct: (c/total*100).toFixed(1) }))
        .sort((a,b)=>b.c-a.c);
    },
    toolCallByTool(data) {
      const src = (data||this.data);
      const adv = src?.advanced || {};
      const tool = adv.tool_call || adv.tool_calls || {};
      const byTool = tool.by_tool || tool.tool_distribution || {};
      return Object.entries(byTool).map(([name,v]) => ({
        name,
        calls: typeof v === 'object' ? (v.calls||v.count||0) : v,
        success_rate: typeof v === 'object' ? (v.success_rate??null) : null,
      })).sort((a,b)=>b.calls-a.calls);
    },
    /* ── chart renderer ── */
    _plt(id, traces, layout) {
      const el = document.getElementById(id);
      if (!el) return;
      const base = {
        paper_bgcolor:'rgba(0,0,0,0)', plot_bgcolor:'rgba(0,0,0,0)',
        font:{ family:'Inter,sans-serif', size:11, color: this.dark?'#d1d5db':'#374151' },
        margin:{t:30,r:10,b:40,l:50},
        showlegend: false,
      };
      Plotly.react(el, traces, Object.assign({}, base, layout), { responsive:true, displayModeBar:false });
    },

    drawCharts() {
      if (!this.data) return;
      const s = this.data.summary || {};
      const tasks = this.data.tasks || [];
      const adv = this.data.advanced || {};
      const clr = ['#6366f1','#8b5cf6','#06b6d4','#10b981','#f59e0b','#ef4444','#ec4899','#14b8a6'];

      /* --- Overview --- */
      const tcrV = this.tcr_() ?? 0;
      const accV = this.acc_() ?? 0;
      const hallV = this.hallRate() ?? 0;
      this._plt('d2-ov-donut', [{
        values: [s.successful_tasks||0, s.failed_tasks||0],
        labels: ['성공','실패'], type:'pie', hole:0.6,
        marker:{colors:['#10b981','#ef4444']},
        textinfo:'none', hovertemplate:'%{label}: %{value}<extra></extra>'
      }], { showlegend:true, legend:{orientation:'h',y:-0.1} });

      const ttypes = this.taskTypes();
      const tcrByType = ttypes.map(tp => {
        const g = tasks.filter(t=>t.task_type===tp);
        return g.length ? g.filter(t=>t.success).length/g.length : 0;
      });
      this._plt('d2-ov-type', [{
        x: ttypes, y: tcrByType, type:'bar',
        marker:{color:'#6366f1'}, hovertemplate:'%{x}: %{y:.1%}<extra></extra>'
      }], { yaxis:{tickformat:'.0%',range:[0,1]} });

      const perspKeys = ['tcr','accuracy','quality','latency_norm','cost_norm'];
      const perspLabels = ['완료율','정확도','품질','지연(역)','비용(역)'];
      const latNorm = s.p95_latency!=null ? Math.max(0,1-s.p95_latency/10) : 0;
      const costNorm = s.avg_cost_per_task!=null ? Math.max(0,1-s.avg_cost_per_task/0.05) : 0;
      const perspVals = [tcrV, accV, (s.avg_quality_score||0)/5, latNorm, costNorm];
      this._plt('d2-ov-persp', [{
        r: perspVals, theta: perspLabels, type:'scatterpolar', fill:'toself',
        line:{color:'#6366f1'}, fillcolor:'rgba(99,102,241,0.2)',
        hovertemplate:'%{theta}: %{r:.2f}<extra></extra>'
      }], { polar:{radialaxis:{range:[0,1],tickformat:'.0%'}}, margin:{t:40,r:40,b:40,l:40} });

      /* --- Quality: TCR by type --- */
      this._plt('d2-q-donut', [{
        values: [s.successful_tasks||0, s.failed_tasks||0],
        labels: ['성공','실패'], type:'pie', hole:0.55,
        marker:{colors:['#10b981','#ef4444']}, textinfo:'none',
        hovertemplate:'%{label}: %{value}<extra></extra>'
      }], { showlegend:true, legend:{orientation:'h',y:-0.1} });
      this._plt('d2-q-type-tcr', [{
        x: ttypes, y: tcrByType, type:'bar',
        marker:{color:'#6366f1'}, hovertemplate:'%{x}: %{y:.1%}<extra></extra>'
      }], { yaxis:{tickformat:'.0%',range:[0,1]} });

      /* --- Quality: Accuracy --- */
      const accScores = tasks.map(t=>t.accuracy_score).filter(v=>v!=null);
      this._plt('d2-q-acc-hist', [{
        x: accScores, type:'histogram', nbinsx:20,
        marker:{color:'#6366f1'}, hovertemplate:'%{x:.2f}: %{y}건<extra></extra>'
      }], { xaxis:{title:'정확도'}, yaxis:{title:'건수'} });
      this._plt('d2-q-acc-weights', [{
        x: ['Token Overlap','Jaccard','LCS','Char'], y:[0.4,0.3,0.2,0.1],
        type:'bar', marker:{color:clr}, hovertemplate:'%{x}: %{y:.0%}<extra></extra>'
      }], { yaxis:{tickformat:'.0%'}, title:{text:'가중치 구성',font:{size:11}} });

      /* --- Quality: Response Quality radar --- */
      const rq = adv.response_quality || {};
      const rqDims = ['relevance','completeness','clarity','accuracy','usefulness'];
      const rqVals = rqDims.map(d => rq[d]??rq['avg_'+d]??0);
      this._plt('d2-q-radar', [{
        r: rqVals, theta: rqDims, type:'scatterpolar', fill:'toself',
        line:{color:'#8b5cf6'}, fillcolor:'rgba(139,92,246,0.2)',
        hovertemplate:'%{theta}: %{r:.2f}<extra></extra>'
      }], { polar:{radialaxis:{range:[0,1]}}, margin:{t:40,r:40,b:40,l:40} });
      const gradeMap = v => v>=0.9?'A+':v>=0.8?'A':v>=0.7?'B+':v>=0.6?'B':v>=0.5?'C':'D';
      const grades = rqDims.map(d => gradeMap(rq[d]??0));
      this._plt('d2-q-grade', [{
        x: rqDims, y: rqVals, type:'bar',
        text: grades, textposition:'outside',
        marker:{color:rqVals.map(v=>v>=0.8?'#10b981':v>=0.6?'#f59e0b':'#ef4444')},
        hovertemplate:'%{x}: %{y:.2f}<extra></extra>'
      }], { yaxis:{range:[0,1.2],tickformat:'.0%'} });

      /* --- Quality: Hallucination --- */
      const hall = adv.hallucination || {};
      const hallTypes = ['factual_error','unsupported_claim','contradiction','fabricated_detail','other'];
      const hallCounts = hallTypes.map(k => hall[k]||hall['count_'+k]||0);
      this._plt('d2-q-hall-type', [{
        x: hallTypes, y: hallCounts, type:'bar',
        marker:{color:'#ef4444'}, hovertemplate:'%{x}: %{y}건<extra></extra>'
      }], { xaxis:{tickangle:-20}, yaxis:{title:'건수'} });

      /* --- External: RAG --- */
      const rk = this.ragKpis();
      const ragMetrics = ['faithfulness','answer_relevancy','context_recall','context_precision'];
      const ragVals = ragMetrics.map(k=>rk[k]??0);
      this._plt('d2-ex-rag-bar', [{
        x: ragMetrics, y: ragVals, type:'bar',
        marker:{color:'#06b6d4'}, hovertemplate:'%{x}: %{y:.3f}<extra></extra>'
      }], { yaxis:{range:[0,1],tickformat:'.2f'} });

      const ragTasks = tasks.filter(t=>t.ragas_metrics||t.rag_metrics);
      const ragScatter = ragTasks.map(t=>{
        const rm = t.ragas_metrics||t.rag_metrics||{};
        return { x:t.execution_time||0, y:rm.faithfulness??0, id:t.task_id };
      });
      this._plt('d2-ex-rag-scatter', [{
        x: ragScatter.map(p=>p.x), y: ragScatter.map(p=>p.y),
        mode:'markers', type:'scatter',
        marker:{color:'#06b6d4', size:6},
        hovertemplate:'%{customdata}: %{y:.3f}<extra></extra>',
        customdata: ragScatter.map(p=>p.id)
      }], { xaxis:{title:'지연(s)'}, yaxis:{title:'Faithfulness',range:[0,1]} });

      /* --- External: DeepEval --- */
      const dk = this.deepevalKpis();
      const deKeys = dk.keys.slice(0,8);
      const deVals = deKeys.map(k=>dk.metrics[k]||0);
      this._plt('d2-ex-de-bar', [{
        x: deKeys, y: deVals, type:'bar',
        marker:{color:'#8b5cf6'}, hovertemplate:'%{x}: %{y:.3f}<extra></extra>'
      }], { xaxis:{tickangle:-30}, yaxis:{range:[0,1]} });

      const deTasks = tasks.filter(t=>t.deepeval_metrics||t.deep_eval_metrics);
      const deScores = deTasks.flatMap(t=>Object.values(t.deepeval_metrics||t.deep_eval_metrics||{})).filter(v=>typeof v==='number');
      this._plt('d2-ex-de-hist', [{
        x: deScores, type:'histogram', nbinsx:20,
        marker:{color:'#8b5cf6'}, hovertemplate:'%{x:.2f}: %{y}건<extra></extra>'
      }], { xaxis:{title:'점수'}, yaxis:{title:'건수'} });

      /* --- Performance: Latency --- */
      const latKeys = ['p50_latency','p75_latency','p90_latency','p95_latency','p99_latency'];
      const latVals = latKeys.map(k=>s[k]??null);
      this._plt('d2-p-lat-bar', [{
        x: ['P50','P75','P90','P95','P99'], y: latVals.map(v=>v??0), type:'bar',
        marker:{color:'#f59e0b'}, hovertemplate:'%{x}: %{y:.2f}s<extra></extra>'
      }], { yaxis:{title:'초(s)'} });
      const latScores = tasks.map(t=>t.execution_time).filter(v=>v!=null);
      this._plt('d2-p-lat-hist', [{
        x: latScores, type:'histogram', nbinsx:25,
        marker:{color:'#f59e0b'}, hovertemplate:'%{x:.2f}s: %{y}건<extra></extra>'
      }], { xaxis:{title:'지연(s)'}, yaxis:{title:'건수'} });
      const slow = this.slowTasks(10);
      this._plt('d2-p-lat-task', [{
        x: slow.map(t=>t.execution_time||0), y: slow.map(t=>t.task_id||'?'),
        type:'bar', orientation:'h',
        marker:{color:'#ef4444'}, hovertemplate:'%{y}: %{x:.2f}s<extra></extra>'
      }], { margin:{l:120,t:20,r:20,b:40}, xaxis:{title:'초(s)'} });

      /* --- Performance: Token --- */
      const tok = adv.token_economy || adv.token || {};
      this._plt('d2-p-tok-bar', [{
        x: ['총 토큰','프롬프트','완성','평균/태스크'],
        y: [tok.total_tokens||s.total_tokens||0, tok.total_prompt_tokens||0, tok.total_completion_tokens||0, tok.avg_tokens_per_task||s.avg_tokens_per_task||0],
        type:'bar', marker:{color:clr}, hovertemplate:'%{x}: %{y:,.0f}<extra></extra>'
      }], {});
      const pTok = tok.total_prompt_tokens||0, cTok = tok.total_completion_tokens||0;
      this._plt('d2-p-tok-ratio', [{
        values: [pTok, cTok], labels:['프롬프트','완성'], type:'pie', hole:0.5,
        marker:{colors:['#6366f1','#06b6d4']}, textinfo:'percent',
        hovertemplate:'%{label}: %{value:,.0f}<extra></extra>'
      }], { showlegend:true });
      const tokScores = tasks.map(t=>t.tokens_used).filter(v=>v!=null);
      this._plt('d2-p-tok-hist', [{
        x: tokScores, type:'histogram', nbinsx:20,
        marker:{color:'#6366f1'}, hovertemplate:'%{x:,.0f}: %{y}건<extra></extra>'
      }], { xaxis:{title:'토큰'}, yaxis:{title:'건수'} });

      /* --- Performance: Cost --- */
      const cost = adv.cost || {};
      const modelCostKeys = Object.keys(cost.by_model||{});
      this._plt('d2-p-cost-bar', [{
        x: modelCostKeys.length ? modelCostKeys : ['전체'],
        y: modelCostKeys.length ? modelCostKeys.map(k=>(cost.by_model||{})[k]||0) : [s.total_cost||tok.total_cost||0],
        type:'bar', marker:{color:'#10b981'}, hovertemplate:'%{x}: $%{y:.4f}<extra></extra>'
      }], { yaxis:{title:'비용($)'} });

      /* --- Agentic: Tool Pie --- */
      const tca = adv.tool_call || adv.tool_calls || {};
      const byTool = this.toolCallByTool();
      this._plt('d2-ag-tool-pie', [{
        values: byTool.map(t=>t.calls), labels: byTool.map(t=>t.name), type:'pie', hole:0.4,
        marker:{colors:clr}, textinfo:'percent',
        hovertemplate:'%{label}: %{value}회<extra></extra>'
      }], { showlegend:true, legend:{orientation:'h',y:-0.15} });
      this._plt('d2-ag-teff-bar', [{
        x: byTool.map(t=>t.name), y: byTool.map(t=>t.success_rate??0),
        type:'bar', marker:{color:byTool.map(t=>(t.success_rate??0)>=0.9?'#10b981':'#f59e0b')},
        hovertemplate:'%{x}: %{y:.1%}<extra></extra>'
      }], { yaxis:{tickformat:'.0%',range:[0,1]} });

      /* --- Agentic: Tool Selection --- */
      const ts = adv.tool_selection || {};
      const tsKeys = Object.keys(ts.by_tool||{});
      this._plt('d2-ag-sel-bar', [{
        x: tsKeys, y: tsKeys.map(k=>(ts.by_tool||{})[k]?.f1??0),
        type:'bar', marker:{color:'#8b5cf6'}, hovertemplate:'%{x}: F1=%{y:.2f}<extra></extra>'
      }], { yaxis:{title:'F1 Score',range:[0,1]} });

      /* --- Agentic: Retry --- */
      const rt = adv.retry || adv.retry_correction || {};
      const retryByType = rt.by_task_type || {};
      this._plt('d2-ag-retry-hist', [{
        x: tasks.map(t=>t.attempts||t.total_attempts||1).filter(v=>v>1),
        type:'histogram', nbinsx:10, marker:{color:'#f59e0b'},
        hovertemplate:'%{x}회: %{y}건<extra></extra>'
      }], { xaxis:{title:'시도 횟수'}, yaxis:{title:'건수'} });
      const rtTypes = Object.keys(retryByType);
      this._plt('d2-ag-retry-type', [{
        x: rtTypes, y: rtTypes.map(k=>retryByType[k]?.retry_rate??0),
        type:'bar', marker:{color:'#f59e0b'}, hovertemplate:'%{x}: %{y:.1%}<extra></extra>'
      }], { yaxis:{tickformat:'.0%'} });

      /* --- Agentic: Coordination --- */
      const coord = adv.coordination || adv.agent_coordination || {};
      const agents = Object.keys(coord.by_agent||{});
      this._plt('d2-ag-coord-bar', [{
        x: agents, y: agents.map(a=>(coord.by_agent||{})[a]?.interactions??0),
        type:'bar', marker:{color:'#06b6d4'}, hovertemplate:'%{x}: %{y}회<extra></extra>'
      }], { yaxis:{title:'인터랙션 수'} });

      /* --- Agentic: Workflow --- */
      const wf = adv.workflow || adv.workflow_execution || {};
      const wfSteps = wf.total_steps||0, wfSuccessSteps = wf.successful_steps||0;
      const wfTasks = wf.total_workflow_tasks||tasks.length||0, wfSuccessTasks = wf.successful_workflow_tasks||(s.successful_tasks||0);
      this._plt('d2-ag-wf-funnel', [{
        x: ['전체 단계','성공 단계','전체 태스크','성공 태스크'],
        y: [wfSteps, wfSuccessSteps, wfTasks, wfSuccessTasks],
        type:'bar', marker:{color:['#6366f1','#10b981','#6366f1','#10b981']},
        hovertemplate:'%{x}: %{y}<extra></extra>'
      }], {});

      /* --- Security: Summary --- */
      const sec = adv.security || {};
      const secScores = {
        input: sec.input_security_score??sec.l1_input??null,
        output: sec.output_leakage_score??sec.l1_output??null,
        auth: sec.authorization_score??sec.l1_auth??null,
        priv: sec.privilege_escalation_score??sec.l2_privilege??null,
        attack: sec.attack_detection_score??sec.l2_attack??null,
      };
      this._plt('d2-sec-summary', [{
        x: ['입력 보안','출력 유출','인가 준수','권한 상승','공격 탐지'],
        y: Object.values(secScores).map(v=>v??0),
        type:'bar',
        marker:{color:Object.values(secScores).map(v=>v==null?'#9ca3af':v>=0.9?'#10b981':v>=0.7?'#f59e0b':'#ef4444')},
        hovertemplate:'%{x}: %{y:.2f}<extra></extra>'
      }], { yaxis:{range:[0,1],tickformat:'.0%'} });

      /* --- Security: Input Bar --- */
      const inp = sec.input_sanitization || sec.input || {};
      const inpTypes = ['sql_injection','command_injection','path_traversal','xss','prompt_injection'];
      const inpLabels = ['SQL인젝션','커맨드인젝션','경로순회','XSS','프롬프트인젝션'];
      this._plt('d2-sec-in-bar', [{
        x: inpLabels, y: inpTypes.map(k=>inp[k]??inp['count_'+k]??0),
        type:'bar', marker:{color:'#ef4444'}, hovertemplate:'%{x}: %{y}건<extra></extra>'
      }], { yaxis:{title:'탐지 건수'} });

      /* --- Security: Output Bar --- */
      const out2 = sec.output_leakage || sec.output || {};
      const outTypes = ['api_key_leaks','password_leaks','credit_card_leaks','email_leaks','ssn_leaks','phone_leaks','private_ip_leaks','file_path_leaks'];
      const outLabels = ['API Key','패스워드','신용카드','이메일','SSN','전화번호','개인 IP','파일경로'];
      this._plt('d2-sec-out-bar', [{
        x: outLabels, y: outTypes.map(k=>out2[k]??0),
        type:'bar', marker:{color:'#ef4444'}, hovertemplate:'%{x}: %{y}건<extra></extra>'
      }], { xaxis:{tickangle:-30}, yaxis:{title:'탐지 건수'} });

      /* --- Tasks: TCR by type --- */
      this._plt('d2-ts-type-tcr', [{
        x: ttypes, y: tcrByType, type:'bar',
        marker:{color:'#6366f1'}, hovertemplate:'%{x}: %{y:.1%}<extra></extra>'
      }], { yaxis:{tickformat:'.0%',range:[0,1]} });

      const scatterT = tasks.filter(t=>t.completion_score!=null&&t.execution_time!=null);
      this._plt('d2-ts-scatter', [{
        x: scatterT.map(t=>t.execution_time), y: scatterT.map(t=>t.completion_score),
        mode:'markers', type:'scatter',
        marker:{color:scatterT.map(t=>t.success?'#10b981':'#ef4444'), size:6},
        hovertemplate:'%{customdata}<br>지연: %{x:.2f}s | 완료율: %{y:.2f}<extra></extra>',
        customdata: scatterT.map(t=>t.task_id||'?')
      }], { xaxis:{title:'지연(s)'}, yaxis:{title:'완료율',range:[0,1]} });
    },
  }; /* end app2() return */
} /* end app2() */
</script>
</body>
</html>
