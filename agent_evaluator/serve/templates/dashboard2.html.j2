                </div>
                <template x-for="t in items(selK,data)" :key="t.task_id">
                  <div class="dtx-row" style="grid-template-columns:minmax(120px,1fr) 90px 70px">
                    <span class="dtx-id" x-text="t.task_id"></span>
                    <span :style="`color:${_bc((t[selK]||0)*100,70,50)}`" x-text="(t[selK]||0).toFixed(3)"></span>
                    <span x-text="t.completion_score!=null?((t.completion_score||0)*100).toFixed(0)+'%':'-'"></span>
