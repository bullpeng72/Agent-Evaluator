          <div class="kpi-sub"
               :class="gA.gate==='pass'?'ok':gA.gate==='fail'?'':'warn'"
               x-text="(gA.gate||'?').toUpperCase()"></div>
        </div>
        <!-- TCR -->
        <div class="kpi kpi-act" :class="{sel:selK==='tcr'}" @click="selK=selK==='tcr'?null:'tcr'" x-show="gA.details && gA.details.task_completion_rate!=null">
          <div class="kpi-lbl">Task Completion (TCR)</div>
          <div class="kpi-val"
               :style="`color:${(gA.details?.task_completion_rate||0)>=85?'var(--green)':(gA.details?.task_completion_rate||0)>=70?'var(--yellow)':'var(--red)'}`"
