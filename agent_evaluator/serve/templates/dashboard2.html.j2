      selK:null,
      meta:{
        total_steps:{label:'총 스텝 수',unit:'개',desc:'전체 워크플로우 단계 수',hint:'workflow_summary.total_steps'},
        success_steps:{label:'성공 스텝',unit:'개',desc:'성공적으로 완료된 스텝 수',hint:'workflow_summary.successful_steps'},
        step_rate:{label:'스텝 성공률',unit:'%',desc:'전체 스텝 중 성공 비율',hint:'successful_steps / total_steps × 100'},
        wf_tasks:{label:'워크플로우 태스크',unit:'건',desc:'워크플로우 실행이 기록된 태스크 수',hint:'workflow_executions.length'},
