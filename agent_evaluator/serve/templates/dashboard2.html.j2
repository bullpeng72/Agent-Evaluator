</div><!-- /external -->

<!-- ══ SECTION 4: PERFORMANCE ══ -->
<div x-show="data && sec==='performance'" x-cloak>

  <!-- Latency subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">⏱ 지연 시간</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      mean:{label:'평균',unit:'s',desc:'전체 태스크의 평균 응답 시간입니다. 전반적인 성능 수준을 나타내지만, 극단적으로 느린 태스크(이상치)에 의해 높아질 수 있어 P50·P95와 함께 해석해야 합니다.',hint:'avg(execution_time)'},
      p50:{label:'P50 (중앙값)',unit:'s',desc:'응답 시간의 중앙값으로, 태스크의 절반은 이 시간보다 빠르게 완료됩니다. 극단값의 영향을 받지 않아 에이전트의 일반적인 응답 속도를 가장 잘 나타내는 지표입니다.',hint:'median(execution_time)'},
      p90:{label:'P90',unit:'s',desc:'전체 태스크의 90%가 이 시간 내에 완료됩니다. 대부분의 사용자가 경험하는 응답 속도를 나타내며, 일반 서비스 SLA 기준으로 자주 활용됩니다.',hint:'90th percentile(execution_time)'},
      p95:{label:'P95',unit:'s',desc:'전체 태스크의 95%가 이 시간 내에 완료됩니다. SLA(서비스 수준 협약) 설계에 가장 널리 사용되는 기준값으로, 극소수 이상치를 제외한 실질적인 최악 응답 시간을 나타냅니다.',hint:'95th percentile(execution_time)'},
      p99:{label:'P99',unit:'s',desc:'전체 태스크의 99%가 이 시간 내에 완료됩니다. 거의 모든 사용자가 경험하는 최대 응답 시간을 나타내며, 고가용성·고신뢰성이 요구되는 서비스의 SLA 기준으로 사용됩니다.',hint:'99th percentile(execution_time)'},
      maximum:{label:'최대',unit:'s',desc:'기록된 가장 느린 태스크의 응답 시간입니다. 타임아웃 설정이나 최악의 시나리오 설계에 활용되며, 이 수치가 비정상적으로 높으면 특정 태스크 유형에서 성능 병목이 발생함을 시사합니다.',hint:'max(execution_time)'},
      stddev:{label:'표준편차',unit:'s',desc:'응답 시간의 분산 정도입니다. 낮을수록 모든 태스크에서 일정한 응답 속도를 유지함을 의미하며, 사용자 경험의 예측 가능성을 나타냅니다. 높으면 일부 태스크에서만 성능이 크게 저하되고 있음을 나타냅니다.',hint:'std(execution_time)'},
    },
    formula(k,d){
      const em=d.efficiency_metrics||{};
      if(k==='mean')return `평균 지연 = ${_sec(em.avg_latency||em.latency?.mean||0)}\n전체 태스크 평균`;
      if(k==='p50')return `P50 = ${_sec(em.p50_latency||em.latency?.p50||0)}\n50번째 백분위`;
      if(k==='p90')return `P90 = ${_sec(em.p90_latency||em.latency?.p90||0)}\n90번째 백분위`;
      if(k==='p95')return `P95 = ${_sec(em.p95_latency||em.latency?.p95||0)}\n95번째 백분위 (SLA 기준)`;
      if(k==='p99')return `P99 = ${_sec(em.p99_latency||em.latency?.p99||0)}\n99번째 백분위`;
      if(k==='maximum')return `최대 = ${_sec(em.max_latency||em.latency?.max||0)}`;
      if(k==='stddev')return `표준편차 = ${_sec(em.std_latency||em.latency?.std||0)}`;
      return '';
    },
    items(k,d){
      const t=d.tasks||[];
      if(k==='maximum'||k==='p99'||k==='p95'||k==='p90')return [...t].sort((a,b)=>(b.execution_time||0)-(a.execution_time||0)).slice(0,15);
      return [...t].sort((a,b)=>(a.execution_time||0)-(b.execution_time||0)).slice(0,15);
    },
    filterLabel(k){return ['maximum','p99','p95','p90'].includes(k)?'느린 태스크 Top15':'빠른 태스크 Top15';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='mean'}" @click="selK=selK==='mean'?null:'mean'">
        <div class="kpi-lbl">평균</div>
        <div class="kpi-val" x-text="_sec(data.efficiency_metrics?.avg_latency||data.efficiency_metrics?.latency?.mean||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='p50'}" @click="selK=selK==='p50'?null:'p50'">
        <div class="kpi-lbl">P50</div>
        <div class="kpi-val" x-text="_sec(data.efficiency_metrics?.p50_latency||data.efficiency_metrics?.latency?.p50||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='p90'}" @click="selK=selK==='p90'?null:'p90'">
        <div class="kpi-lbl">P90</div>
