             x-text="_sec(data.efficiency_metrics?.p95_latency||data.efficiency_metrics?.latency?.p95||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='p99'}" @click="selK=selK==='p99'?null:'p99'">
        <div class="kpi-lbl">P99</div>
        <div class="kpi-val" :style="`color:${_bc2lat(data.efficiency_metrics?.p99_latency||data.efficiency_metrics?.latency?.p99||0)}`"
             x-text="_sec(data.efficiency_metrics?.p99_latency||data.efficiency_metrics?.latency?.p99||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='maximum'}" @click="selK=selK==='maximum'?null:'maximum'">
        <div class="kpi-lbl">최대</div>
        <div class="kpi-val" x-text="_sec(data.efficiency_metrics?.max_latency||data.efficiency_metrics?.latency?.max||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='stddev'}" @click="selK=selK==='stddev'?null:'stddev'">
