        if(k==='total_steps')return `총 스텝 = ${ws.total_steps||0}개`;
        if(k==='success_steps')return `성공 스텝 = ${ws.successful_steps||0}개`;
        if(k==='step_rate')return `스텝 성공률 = ${ws.step_success_rate||0}%`;
        if(k==='wf_tasks')return `워크플로우 태스크 = ${(d.agentic?.workflow_executions||[]).length}건`;
        if(k==='task_rate')return `태스크 완료율 = ${ws.task_success_rate||0}%`;
        return '';
      },
      items(k,d){ return d.agentic?.workflow_executions||[]; },
      filterLabel(k){return '전체 워크플로우 실행';}
