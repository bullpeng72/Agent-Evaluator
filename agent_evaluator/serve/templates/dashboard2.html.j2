    bc2lat(v) {
      if (v==null) return 'var(--text2)';
      if (v<=2) return 'var(--green)';
      if (v<=5) return 'var(--yellow)';
      return 'var(--red)';
    },
    hallRate() {
      const am = this.data?.accuracy_metrics || {};
      const hall = am.hallucination || {};
      const rate = hall.overall_rate ?? hall.hallucination_rate ?? null;
      if (rate != null) return rate;
      // fallback: compute from total_evaluated / total_flagged
      const tot = hall.total_evaluated || 0;
      const flagged = hall.total_flagged || 0;
      return tot > 0 ? (flagged / tot) * 100 : 0;
    },
    tcr_() {
      const am = this.data?.accuracy_metrics || {};
      const tcr = am.tcr || {};
      const v = tcr.tcr ?? tcr.task_completion_rate ?? null;
      if (v != null) return v;
      // fallback: compute from tasks
      const tasks = this.data?.tasks || [];
      if (!tasks.length) return 0;
      return tasks.reduce((s, t) => s + (t.completion_score || 0), 0) / tasks.length * 100;
    },
    acc_() {
      const am = this.data?.accuracy_metrics || {};
      const acc = am.accuracy_scores || {};
      const v = acc.overall_accuracy ?? acc.accuracy_rate ?? null;
      if (v != null) return v;
      // fallback: compute from tasks
      const tasks = this.data?.tasks || [];
      if (!tasks.length) return 0;
      return tasks.reduce((s, t) => s + (t.accuracy_score || 0), 0) / tasks.length * 100;
    },
    taskTypes() {
      const tasks = this.data?.tasks || [];
      return [...new Set(tasks.map(t => t.task_type).filter(Boolean))];
    },
    filteredTasks() {
      const tasks = this.data?.tasks || [];
      const { type, status, q } = this.taskFilter;
      return tasks.filter(t => {
        if (type && t.task_type !== type) return false;
        if (status === 'success' && !t.success) return false;
        if (status === 'fail' && t.success) return false;
        if (q) {
          const ql = q.toLowerCase();
          if (!(t.task_id||'').toLowerCase().includes(ql) &&
              !(t.errors||[]).join(' ').toLowerCase().includes(ql)) return false;
        }
        return true;
      });
    },
    slowTasks(n=5) {
      const tasks = this.data?.tasks || [];
      return [...tasks].sort((a,b) => (b.execution_time||0)-(a.execution_time||0)).slice(0,n);
    },
    deployGates() {
      if (!this.data) return [];
      const am = this.data?.accuracy_metrics || {};
      const em = this.data?.efficiency_metrics || {};
      const tasks = this.data?.tasks || [];
      const n = tasks.length || 1;
      const t = this.thresholds; // fraction-based: tcr_min=0.7, acc_min=0.7, hall_max=0.2, p95_max=5, cost_max=0.05

      // Actual values as fractions (0-1)
      const tcrRaw = am.tcr?.tcr ?? am.tcr?.task_completion_rate ?? null;
      const tcr = tcrRaw != null ? tcrRaw / 100 : tasks.reduce((s,x) => s+(x.completion_score||0), 0) / n;
      const accRaw = am.accuracy_scores?.overall_accuracy ?? am.accuracy_scores?.accuracy_rate ?? null;
      const acc = accRaw != null ? accRaw / 100 : tasks.reduce((s,x) => s+(x.accuracy_score||0), 0) / n;
      const hallRaw = am.hallucination?.overall_rate ?? am.hallucination?.hallucination_rate ?? null;
      const hallEv  = am.hallucination?.total_evaluated || 0;
      const hallFl  = am.hallucination?.total_flagged  || 0;
      const hall = hallRaw != null ? hallRaw / 100 : (hallEv > 0 ? hallFl / hallEv : null);
      const p95  = em.latency?.p95 ?? em.p95_latency ?? null;
      const cost = this.cAvg(this.data);  // 전역 selModel 반영

      // Stage thresholds derived from user settings (dev = relaxed, staging = target, prod = strict)
      const devTCR  = Math.max(0.5,  t.tcr_min  - 0.1);
      const devACC  = Math.max(0.3,  t.acc_min  - 0.15);
      const devHALL = +(t.hall_max * 2).toFixed(3);
      const stgTCR  = t.tcr_min;
      const stgACC  = Math.min(1.0,  t.acc_min  + 0.05);
      const stgHALL = t.hall_max;
      const stgP95  = t.p95_max;
      const prdTCR  = Math.min(1.0,  t.tcr_min  + 0.05);
      const prdACC  = Math.min(1.0,  t.acc_min  + 0.1);
      const prdHALL = +(t.hall_max * 0.6).toFixed(3);
      const prdP95  = +(t.p95_max  * 0.75).toFixed(1);
      const prdCOST = t.cost_max;

      const pct = v => (v * 100).toFixed(1) + '%';
      const gates = [
        {
          label: '🔬 개발', key: 'dev',
          criteria: [
            { name: `TCR ≥ ${(devTCR*100).toFixed(0)}%`,      pass: tcr  >= devTCR,                        val: pct(tcr) },
            { name: `Accuracy ≥ ${(devACC*100).toFixed(0)}%`, pass: acc  >= devACC,                        val: pct(acc) },
            { name: `Hall ≤ ${(devHALL*100).toFixed(0)}%`,    pass: hall == null || hall <= devHALL,        val: hall != null ? pct(hall) : 'N/A' },
          ],
        },
        {
          label: '🚀 스테이징', key: 'staging',
          criteria: [
            { name: `TCR ≥ ${(stgTCR*100).toFixed(0)}%`,      pass: tcr  >= stgTCR,                        val: pct(tcr) },
            { name: `Accuracy ≥ ${(stgACC*100).toFixed(0)}%`, pass: acc  >= stgACC,                        val: pct(acc) },
            { name: `Hall ≤ ${(stgHALL*100).toFixed(0)}%`,    pass: hall == null || hall <= stgHALL,        val: hall != null ? pct(hall) : 'N/A' },
            { name: `P95 ≤ ${stgP95}s`,                       pass: p95  == null || p95  <= stgP95,         val: p95 != null ? p95.toFixed(2) + 's' : 'N/A' },
          ],
        },
        {
          label: '🏭 프로덕션', key: 'prod',
          criteria: [
            { name: `TCR ≥ ${(prdTCR*100).toFixed(0)}%`,                      pass: tcr  >= prdTCR,                   val: pct(tcr) },
            { name: `Accuracy ≥ ${(prdACC*100).toFixed(0)}%`,                 pass: acc  >= prdACC,                   val: pct(acc) },
            { name: `Hall ≤ ${(prdHALL*100).toFixed(0)}%`,                    pass: hall == null || hall <= prdHALL,  val: hall != null ? pct(hall) : 'N/A' },
            { name: `P95 ≤ ${prdP95}s`,                                        pass: p95  == null || p95  <= prdP95,  val: p95 != null ? p95.toFixed(2) + 's' : 'N/A' },
            { name: `Cost ≤ $${parseFloat(prdCOST.toFixed(3))}/task`,         pass: cost == null || cost <= prdCOST, val: cost != null ? '$' + cost.toFixed(4) : 'N/A' },
          ],
        },
      ];
      return gates.map(g => ({
        ...g,
        passed: g.criteria.filter(c => c.pass).length,
        total:  g.criteria.length,
        cls:    g.criteria.every(c => c.pass)  ? 'pass'
              : g.criteria.every(c => !c.pass) ? 'fail'
              : 'partial',
      }));
    },
    autoAnomalies() { return autoAnomalies_inner(this.data, this.thresholds, this.cAvg(this.data)); },
    _perspVal(key) {
      const adv = this.data?.advanced || {};
      return adv[key] ?? adv.summary?.[key] ?? null;
    },
    zScoreAnomalies() {
      const tasks = this.data?.tasks || [];
      if (tasks.length < 3) return [];
      const lats = tasks.map(t => t.execution_time).filter(v => v!=null);
      const accs = tasks.map(t => t.accuracy_score).filter(v => v!=null);
      const mean = arr => arr.reduce((a,b)=>a+b,0)/arr.length;
      const std = arr => { const m=mean(arr); return Math.sqrt(arr.reduce((a,b)=>a+(b-m)**2,0)/arr.length); };
      const mLat=mean(lats), sLat=std(lats)||1, mAcc=mean(accs), sAcc=std(accs)||1;
      const out = [];
      for (const t of tasks) {
        const zLat = t.execution_time!=null ? (t.execution_time-mLat)/sLat : null;
        const zAcc = t.accuracy_score!=null ? (t.accuracy_score-mAcc)/sAcc : null;
        if ((zLat!=null && Math.abs(zLat)>2) || (zAcc!=null && Math.abs(zAcc)>2))
          out.push({ task_id:t.task_id, task_type:t.task_type, lat:t.execution_time, zLat, acc:t.accuracy_score, zAcc });
      }
      return out.sort((a,b) => Math.max(Math.abs(b.zLat||0),Math.abs(b.zAcc||0)) - Math.max(Math.abs(a.zLat||0),Math.abs(a.zAcc||0)));
    },
    corrMatrix() {
      const tasks = this.data?.tasks || [];
      const keys = ['accuracy_score','execution_time','tokens_used','completion_score'];
      const labels = ['accuracy','latency','tokens','completion'];
      const pearson = (xs,ys) => {
        const n=xs.length; if(!n) return null;
        const mx=xs.reduce((a,b)=>a+b,0)/n, my=ys.reduce((a,b)=>a+b,0)/n;
        let num=0,dx=0,dy=0;
        for (let i=0;i<n;i++) { num+=(xs[i]-mx)*(ys[i]-my); dx+=(xs[i]-mx)**2; dy+=(ys[i]-my)**2; }
        if (!dx||!dy) return null;
        return num/Math.sqrt(dx*dy);
      };
      return keys.map((rk,ri) => ({
        label: labels[ri],
        vals: keys.map((ck,ci) => {
          if (ri===ci) return 1;
          const pairs = tasks.map(t => [t[rk],t[ck]]).filter(([a,b])=>a!=null&&b!=null);
          if (pairs.length<3) return null;
          return pearson(pairs.map(p=>p[0]), pairs.map(p=>p[1]));
        })
      }));
    },
    corrPairs() {
      const tasks = this.data?.tasks || [];
      if (tasks.length < 3) return [];
      const _tok = t => {
        const v=(t.tokens_used?.total)||(t.tokens_used?.input||0)+(t.tokens_used?.output||0);
        return (v>0)?v:null;
      };
      const pearsonPair = (keyA, keyB, getA, getB) => {
        const pairs = tasks.map(t=>[getA(t),getB(t)]).filter(([a,b])=>a!=null&&b!=null&&!isNaN(a)&&!isNaN(b));
        if (pairs.length < 3) return null;
        const xs=pairs.map(p=>p[0]), ys=pairs.map(p=>p[1]);
        const n=xs.length;
        const mx=xs.reduce((s,v)=>s+v,0)/n, my=ys.reduce((s,v)=>s+v,0)/n;
        const num=xs.reduce((s,x,i)=>s+(x-mx)*(ys[i]-my),0);
        const dx=Math.sqrt(xs.reduce((s,x)=>s+(x-mx)**2,0));
        const dy=Math.sqrt(ys.reduce((s,y)=>s+(y-my)**2,0));
        return (dx&&dy)?+(num/(dx*dy)).toFixed(3):null;
      };
      const defs = [
        { label:'정확도 ↔ 지연시간',
          getA:t=>t.accuracy_score*100, getB:t=>t.execution_time||0,
          pos:'지연이 길수록 정확도도 높아지는 경향 — 복잡한 태스크에 더 많은 처리 시간이 소요될 수 있습니다.',
          neg:'지연이 길수록 정확도가 낮아지는 경향 — 타임아웃이나 지연으로 인한 품질 저하를 의심하세요.',
          none:'지연과 정확도 간 뚜렷한 관계 없음 — 지연이 현재 품질에 큰 영향을 주지 않습니다.',
          posAction:'복잡한 태스크에 타임아웃 여유를 확보하고 응답 캐싱을 검토하세요.',
          negAction:'지연이 긴 태스크의 실패 원인을 분석하고 프롬프트 최적화 또는 모델 업그레이드를 검토하세요.' },
        { label:'정확도 ↔ 토큰 수',
          getA:t=>t.accuracy_score*100, getB:t=>_tok(t),
          pos:'토큰을 많이 사용할수록 정확도가 높아지는 경향 — 상세한 응답이 품질 향상에 기여합니다.',
          neg:'토큰이 많을수록 정확도가 낮아지는 경향 — 장황한 응답이 오히려 정확도를 해칩니다.',
          none:'토큰 수와 정확도 간 뚜렷한 관계 없음 — 응답 길이가 품질을 결정하지 않습니다.',
          posAction:'적정 컨텍스트 길이를 유지하되 불필요한 반복을 줄이는 프롬프트 설계를 권장합니다.',
          negAction:'max_tokens 제한을 설정하고 핵심 답변에 집중하도록 프롬프트를 개선하세요.' },
        { label:'정확도 ↔ 완료율',
          getA:t=>t.accuracy_score*100, getB:t=>t.completion_score*100,
          pos:'완료율이 높을수록 정확도도 높음 — 태스크 성공과 정확도가 일관되게 연동됩니다.',
          neg:'완료율과 정확도가 반비례 — 완료했지만 정확하지 않거나 실패했지만 부분 점수가 있을 수 있습니다.',
          none:'완료율과 정확도 간 상관 없음 — 두 기준이 독립적으로 작동합니다.',
          posAction:'현재 평가 기준을 유지하세요. 두 지표가 함께 개선됩니다.',
          negAction:'완료 기준과 품질 기준을 재검토하고 부분 완료 처리 로직을 정비하세요.' },
        { label:'지연시간 ↔ 토큰 수',
          getA:t=>t.execution_time||0, getB:t=>_tok(t),
          pos:'토큰이 많을수록 지연도 길어지는 경향 — 예상된 정상 패턴입니다.',
          neg:'토큰이 많은데 지연이 짧거나 반대 패턴 — 캐싱 또는 배치 처리 영향일 수 있습니다.',
          none:'토큰 수와 지연 간 뚜렷한 관계 없음 — 지연이 다른 요인(네트워크·큐)에 의해 결정될 수 있습니다.',
          posAction:'고토큰 태스크를 배치 처리하거나 스트리밍 응답으로 체감 지연을 줄이세요.',
          negAction:'지연 원인을 재분석하세요. 토큰 외 네트워크·에러 재시도 등이 주요 요인일 수 있습니다.' },
      ];
      return defs.map(d => {
        const r = pearsonPair(null, null, d.getA, d.getB);
        if (r === null) return { label:d.label, r:0, interp:'데이터 부족 (토큰 정보 없음 또는 측정값 3건 미만)', action:null, noData:true };
        const absR = Math.abs(r);
        let interpText, action;
        if (absR < 0.2) { interpText = d.none; action = null; }
        else if (r > 0) { interpText = d.pos; action = d.posAction; }
        else { interpText = d.neg; action = d.negAction; }
        return { label:d.label, r, interp:interpText, action, noData:false };
      });
    },
    bottleneckAnalysis() {
      const tasks = this.data?.tasks||[]; if (!tasks.length) return [];
      const results = [];
      const slowThreshold = (this.data?.efficiency_metrics?.latency?.p95 || 2);
      const slow = [...tasks].sort((a,b)=>(b.execution_time||0)-(a.execution_time||0))
                              .filter(t=>(t.execution_time||0)>slowThreshold);
      if (slow.length) {
        results.push({severity:'high',
          title:`느린 태스크 ${slow.length}건 (P95 초과)`,
          desc:`P95 기준(${slowThreshold.toFixed(2)}s) 초과 태스크 발견`,
          action:'해당 태스크의 프롬프트 간소화·캐싱·비동기 처리를 검토하거나 더 빠른 모델로 전환하세요.',
          tasks: slow.slice(0,5)});
      }
      const typeLatency={};
      tasks.forEach(t=>{ const k=t.task_type||'unknown'; (typeLatency[k]=typeLatency[k]||[]).push(t.execution_time||0); });
      const worstType = Object.entries(typeLatency)
        .map(([k,v])=>({type:k,avg:v.reduce((a,b)=>a+b,0)/v.length,n:v.length}))
        .sort((a,b)=>b.avg-a.avg)[0];
      if (worstType && worstType.avg > slowThreshold*0.7) {
        results.push({severity:'medium',
          title:`${worstType.type} 유형이 가장 느림`,
          desc:`평균 ${worstType.avg.toFixed(2)}s (${worstType.n}건)`,
          action:`${worstType.type} 유형의 프롬프트·로직을 집중 최적화하거나 별도 서빙 경로를 마련하세요.`,
          tasks:[]});
      }
      const _tok = t => (t.tokens_used?.total)||(t.tokens_used?.input||0)+(t.tokens_used?.output||0);
      const avgTok = tasks.reduce((s,t)=>s+_tok(t),0)/tasks.length;
      const heavyTok = [...tasks].sort((a,b)=>_tok(b)-_tok(a)).filter(t=>_tok(t)>avgTok*2);
      if (heavyTok.length) {
        results.push({severity:'low',
          title:`토큰 과다 사용 태스크 ${heavyTok.length}건`,
          desc:`평균 대비 2배 이상 토큰 사용 (평균 ${Math.round(avgTok)}개 기준)`,
          action:'max_tokens 제한을 설정하고 시스템 프롬프트를 간결하게 정리해 토큰 비용을 절감하세요.',
          tasks: heavyTok.slice(0,5)});
      }
      const failedAvgLat = tasks.filter(t=>!t.success).reduce((s,t,_,a)=>s+(t.execution_time||0)/a.length,0)||0;
      const successAvgLat = tasks.filter(t=>t.success).reduce((s,t,_,a)=>s+(t.execution_time||0)/a.length,0)||0;
      if (failedAvgLat>0 && successAvgLat>0 && failedAvgLat>successAvgLat*1.3) {
        results.push({severity:'medium',
          title:'실패 태스크가 성공 태스크보다 느림',
          desc:`실패 평균 ${failedAvgLat.toFixed(2)}s vs 성공 평균 ${successAvgLat.toFixed(2)}s`,
          action:'타임아웃 설정을 낮춰 빠른 실패(fail-fast)를 유도하고, 재시도 로직의 지수 백오프를 검토하세요.',
          tasks:[]});
      }
      return results;
    },
    ragKpis() {
      const ragM = this.data?.rag_metrics || {};
      const perTask = this.data?.advanced?.per_task || [];
      const ragPT = perTask.filter(t => t.ragas_faithfulness != null);
      const _avg = (arr) => Array.isArray(arr) && arr.length ? arr.reduce((a,b)=>a+b,0)/arr.length : null;
      const _ptAvg = (key) => {
        const vals = ragPT.map(t => t['ragas_'+key]).filter(v => v != null);
        return vals.length ? vals.reduce((a,b)=>a+b,0)/vals.length : null;
      };
      const avg = key => {
        const v = ragM[key];
        if (Array.isArray(v) && v.length) return _avg(v);
        if (v != null) return v;
        return _ptAvg(key);
      };
      const n = ragPT.length;
      const f=avg('faithfulness'), a=avg('answer_relevancy'), r=avg('context_recall'), p=avg('context_precision');
      const overallVals=[f,a,r,p].filter(v=>v!=null);
      const overall = overallVals.length ? overallVals.reduce((s,v)=>s+v,0)/overallVals.length : null;
      return {
        faithfulness: f,
        answer_relevancy: a,
        context_recall: r,
        context_precision: p,
        overall,
        n,
      };
    },
    deepevalKpis() {
      const adv = this.data?.advanced || {};
      // summary = advanced_metrics_summary: {g_eval_score:{mean,min,max}, ...}
      const summary = adv.summary || {};
      const deKeyList = ['g_eval_score','hallucination_score','toxicity_score','bias_score','answer_relevancy_score'];
      // Build metrics map: key -> mean value
      const metrics = {};
      deKeyList.forEach(k => { if (summary[k]?.mean != null) metrics[k] = summary[k].mean; });
      // Fallback: compute mean from per_task if summary missing
      const pt = adv.per_task || [];
      deKeyList.forEach(k => {
        if (metrics[k] == null) {
          const vals = pt.map(t => t[k]).filter(v => v != null && typeof v === 'number');
          if (vals.length) metrics[k] = vals.reduce((a,b)=>a+b,0)/vals.length;
        }
      });
      const dePT = pt.filter(t => deKeyList.some(k => t[k] != null));
      return {
        metrics,
        summary,
        n: dePT.length,
        keys: deKeyList.filter(k => metrics[k] != null),
      };
    },
    frameworkDist(data) {
      const tasks = (data||this.data)?.tasks || [];
      const cnt = {}, suc = {};
      for (const t of tasks) {
        const fw = t.framework || t.agent_framework || 'unknown';
        cnt[fw] = (cnt[fw]||0) + 1;
        if (t.success) suc[fw] = (suc[fw]||0) + 1;
      }
      const total = tasks.length || 1;
      return Object.entries(cnt).map(([name, count]) => ({
        name,
        count,
        rate: count > 0 ? (suc[name]||0) / count * 100 : 0,
        pct: count / total * 100,
      })).sort((a,b)=>b.count-a.count);
    },
    toolCallByTool(data) {
      const src = (data||this.data);
      const counts = {};

      // [1순위] tool_selections[].actual_tools — 실제 사용 도구 이름 배열 (JSON에 항상 존재)
      for (const s of (src?.agentic?.tool_selections || [])) {
        for (const name of (s.actual_tools || [])) {
          if (name) counts[name] = (counts[name]||0) + 1;
        }
      }
      if (Object.keys(counts).length > 0) {
        return Object.entries(counts).map(([name,calls])=>({name,calls,success_rate:null}))
          .sort((a,b)=>b.calls-a.calls);
      }

      // [2순위] tool_call_executions[].tool_call_counts (dict 또는 배열)
      for (const t of (src?.agentic?.tool_call_executions || [])) {
        const bt = t.tool_call_counts || {};
        if (Array.isArray(bt)) {
          for (const item of bt) {
            const n = item.tool_name||item.name||'?';
            counts[n] = (counts[n]||0) + (item.count||item.calls||1);
          }
        } else {
          for (const [n, v] of Object.entries(bt)) {
            counts[n] = (counts[n]||0) + (typeof v==='object'?(v.count||v.calls||0):Number(v)||0);
          }
        }
        // tool_names 배열 fallback
        if (!Object.keys(bt).length) {
          for (const n of (t.tool_names||[])) {
            counts[n] = (counts[n]||0) + 1;
          }
        }
      }
      if (Object.keys(counts).length > 0) {
        return Object.entries(counts).map(([name,calls])=>({name,calls,success_rate:null}))
          .sort((a,b)=>b.calls-a.calls);
      }

      // [3순위] data.advanced 경로 (legacy)
      const adv = src?.advanced || {};
      const tool = adv.tool_call || adv.tool_calls || {};
      const byTool = tool.by_tool || tool.tool_distribution || {};
      return Object.entries(byTool).map(([name,v])=>({
        name,
        calls: typeof v==='object'?(v.calls||v.count||0):v,
        success_rate: typeof v==='object'?(v.success_rate??null):null,
      })).sort((a,b)=>b.calls-a.calls);
    },
    /* ── compare ── */
    toggleCompare(id) {
      const idx = this.compareIds.indexOf(id);
      if (idx >= 0) this.compareIds.splice(idx, 1);
      else if (this.compareIds.length < 5) this.compareIds.push(id);
    },
    async loadCompareData() {
      if (!this.compareIds.length) { this.compareData = []; return; }
      this.compareLoading = true;
      try {
        const results = await Promise.all(this.compareIds.map(id => fetch(`/api/results/${id}`).then(r => r.json())));
        this.compareData = results;
        this.$nextTick(() => this.drawCompareChart());
      } catch(e) { console.warn('compare error', e); }
      finally { this.compareLoading = false; }
    },
    drawCompareChart() {
      if (this.compareData.length < 2) return;
      // 개요 에이전트 역량 레이더와 동일한 6축 · 0–1 정규화
      const dims = ['완료율','정확·품질','운영 효율','에이전틱\n역량','신뢰성','보안'];
      const clr  = ['#6366f1','#10b981','#f59e0b','#ef4444','#8b5cf6','#ec4899'];
      const traces = this.compareData.map((d, i) => {
        const tcr        = _tcrG(d) / 100;
        const qualAcc    = _cmpQualAccNorm(d) / 100;
        const ops        = (_cmpOpsNorm(d) ?? 0) / 100;
        const agentic    = (_cmpAgenticNorm(d) ?? 0) / 100;
        const reliability = (_cmpReliabilityNorm(d) ?? 0) / 100;
        const sec        = (_cmpSecNorm(d) ?? 0) / 100;
        const vals = [tcr, qualAcc, ops, agentic, reliability, sec];
        return {
          type: 'scatterpolar', fill: 'toself',
          r: [...vals, vals[0]], theta: [...dims, dims[0]],
          name: d.name || d.id,
          line:      { color: clr[i % clr.length], width: 2 },
          fillcolor:   clr[i % clr.length] + '33',
          hovertemplate: '%{theta}: %{r:.0%}<extra></extra>',
        };
      });
      this._plt('d2-cmp-radar', traces, {
        polar: {
          radialaxis: { range: [0, 1], tickformat: '.0%', tickfont: { size: 9 }, gridcolor: 'rgba(128,128,128,0.2)' },
          angularaxis: { tickfont: { size: 12 } },
        },
        showlegend: true, legend: { orientation: 'h', y: -0.08, x: 0.5, xanchor: 'center' },
        margin: { t: 30, r: 80, b: 70, l: 80 },
        autosize: true,
      });
    },
    /* ── prev data & regression ── */
    async loadPrevData() {
      if (!this.selId || !this.files.length) return;
      const idx = this.files.findIndex(f => f.id === this.selId);
      if (idx < 0 || idx >= this.files.length - 1) { this.prevData = null; return; }
      const prevFile = this.files[idx + 1];
      if (this.prevData?._id === prevFile.id) return;
      this.prevLoading = true;
      try {
        const d = await fetch(`/api/results/${prevFile.id}`).then(r => r.json());
        d._id   = prevFile.id;
        d._name = prevFile.name || prevFile.id;
        this.prevData = d;
      } catch(e) { this.prevData = null; }
      finally { this.prevLoading = false; }
    },
    regressionItems() {
      if (!this.data || !this.prevData) return [];
      const cur = this.data, prev = this.prevData;
      const hallRate = d => { const h = d.accuracy_metrics?.hallucination||{}; const tot=h.total_evaluated||0,flag=h.total_flagged||0; return tot>0?(flag/tot*100):null; };
      const qualPct  = d => d.quality_detail?.avg_score != null ? +(d.quality_detail.avg_score*20).toFixed(1) : null;
      return [
        { label:'완료율 (TCR)',  icon:'📋', cur:+_tcrG(cur).toFixed(1),  prev:+_tcrG(prev).toFixed(1),  unit:'%', higher:true,  thresh:2 },
        { label:'정확도',        icon:'🎯', cur:+_accG(cur).toFixed(1),  prev:+_accG(prev).toFixed(1),  unit:'%', higher:true,  thresh:2 },
        { label:'품질 점수',     icon:'⭐', cur:qualPct(cur),             prev:qualPct(prev),            unit:'%', higher:true,  thresh:3 },
        { label:'환각률',        icon:'🌀', cur:hallRate(cur),            prev:hallRate(prev),           unit:'%', higher:false, thresh:2 },
        { label:'P95 지연',      icon:'⚡', cur:cur.efficiency_metrics?.latency?.p95??null,  prev:prev.efficiency_metrics?.latency?.p95??null,  unit:'s', higher:false, thresh:0.1 },
        { label:'태스크당 비용', icon:'💰', cur:cur.efficiency_metrics?.tokens?.avg_cost_per_task??null, prev:prev.efficiency_metrics?.tokens?.avg_cost_per_task??null, unit:'$', higher:false, thresh:0.00005 },
      ].filter(it => it.cur != null && it.prev != null)
       .map(it => {
         const delta = +(it.cur - it.prev).toFixed(it.unit==='$'?6:it.unit==='s'?3:1);
         const worse  = it.higher ? delta < -it.thresh : delta >  it.thresh;
         const better = it.higher ? delta >  it.thresh : delta < -it.thresh;
         return { ...it, delta, worse, better };
       });
    },
    drawTrendChart() {
      if (!this.compareData || this.compareData.length < 2) return;
      const sorted = [...this.compareData].sort((a, b) => {
        const ta = a.timestamp||'', tb = b.timestamp||'';
        return ta < tb ? -1 : ta > tb ? 1 : 0;
      });
      const labels = sorted.map(d => (d.name||d.id).replace(/\.json$/,'').slice(-22));
      const mk = (name, y, color, dash, symbol) => ({
        name, x: labels, y,
        type:'scatter', mode:'lines+markers', connectgaps:true,
        line:{ color, dash:dash||'solid', width:2 },
        marker:{ color, size:7, symbol:symbol||'circle' },
      });
      const traces = [
        mk('TCR%',        sorted.map(d => +_tcrG(d).toFixed(1)),             '#6366f1'),
        mk('정확·품질%',  sorted.map(d => +_cmpQualAccNorm(d).toFixed(1)),   '#8b5cf6'),
        mk('운영효율%',   sorted.map(d => { const v=_cmpOpsNorm(d); return v!=null?+v.toFixed(1):null; }), '#f59e0b'),
        mk('신뢰성%',     sorted.map(d => { const v=_cmpReliabilityNorm(d); return v!=null?+v.toFixed(1):null; }), '#10b981'),
        { ...mk('P95 지연(s)', sorted.map(d => d.efficiency_metrics?.latency?.p95??null), '#ef4444', 'dot', 'diamond'), yaxis:'y2' },
      ];
      this._plt('d2-cmp-trend', traces, {
        height: 390,
        legend:{ orientation:'h', y:-0.20, x:0.5, xanchor:'center', font:{size:11} },
        xaxis:{ tickangle: labels.length>6?-30:0, tickfont:{size:11}, automargin:true },
        yaxis:{ title:{text:'%',font:{size:11}}, range:[0,108] },
        yaxis2:{ title:{text:'s',font:{size:11}}, overlaying:'y', side:'right', rangemode:'tozero' },
        margin:{ l:48, r:58, t:16, b:90 },
        hovermode:'x unified',
      });
    },
    /* ── golden dataset ── */
    async loadGolden() {
      this.goldenLoading = true;
      try { this.goldenFiles = await fetch('/api/golden').then(r => r.json()); }
      catch(e) { console.warn('golden load error', e); }
      finally { this.goldenLoading = false; }
    },
    async loadGoldenDetail(stem) {
      if (this.goldenCurrent?.stem === stem) {
        this.goldenCurrent = null; this.goldenDirty = false; this.goldenEditIdx = -1; this.goldenAddMode = false;
        return;
      }
      try {
        const data = await fetch(`/api/golden/${encodeURIComponent(stem)}`).then(r => r.json());
        this.goldenCurrent = { stem, items: Array.isArray(data) ? data : (data.items || []) };
        this.goldenDirty = false; this.goldenEditIdx = -1; this.goldenAddMode = false;
      } catch(e) { console.warn('golden detail error', e); }
    },
    goldenStartEdit(idx) {
      this.goldenEditIdx = idx;
      const item = this.goldenCurrent.items[idx];
      this.goldenEditBuf = {
        ...item,
        question: item.question || item.input || '',
        expected_answer: item.expected_answer || item.ground_truth || item.answer || '',
      };
    },
    goldenApplyEdit(idx) {
      const buf = this.goldenEditBuf;
      const item = this.goldenCurrent.items[idx];
      this.goldenCurrent.items.splice(idx, 1, { ...item, ...buf, ground_truth: buf.expected_answer });
      this.goldenEditIdx = -1;
      this.goldenDirty = true;
    },
    goldenDeleteItem(idx) {
      if (!confirm((this.goldenCurrent.items[idx].id || (idx+1)) + ' 항목을 삭제할까요?')) return;
      this.goldenCurrent.items.splice(idx, 1);
      if (this.goldenEditIdx === idx) this.goldenEditIdx = -1;
      this.goldenDirty = true;
    },
    goldenStartAdd() {
      this.goldenAddMode = true;
      this.goldenAddBuf = { question:'', expected_answer:'', ground_truth:'', context:'', id:'' };
    },
    goldenAddItem() {
      const q = (this.goldenAddBuf.question || '').trim();
      if (!q) { alert('질문을 입력하세요'); return; }
      const newItem = {
        id: 'item_' + String(this.goldenCurrent.items.length + 1).padStart(3, '0'),
        question: q,
        expected_answer: (this.goldenAddBuf.expected_answer || '').trim(),
        ground_truth: (this.goldenAddBuf.expected_answer || '').trim(),
      };
      const ctx = (this.goldenAddBuf.context || '').trim();
      if (ctx) newItem.context = ctx;
      this.goldenCurrent.items.push(newItem);
      this.goldenAddMode = false;
      this.goldenAddBuf = { question:'', expected_answer:'', ground_truth:'', context:'', id:'' };
      this.goldenDirty = true;
    },
    async saveGoldenCurrent() {
      if (!this.goldenCurrent || !this.goldenDirty) return;
      this.goldenSaving = true;
      try {
        if (this.goldenCurrent.items.length === 0) {
          const r = await fetch(`/api/golden/${encodeURIComponent(this.goldenCurrent.stem)}`, { method: 'DELETE' });
          if (r.ok) { this.goldenCurrent = null; this.goldenDirty = false; }
        } else {
          await fetch(`/api/golden/${encodeURIComponent(this.goldenCurrent.stem)}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(this.goldenCurrent.items),
          });
          this.goldenDirty = false;
        }
        await this.loadGolden();
      } catch(e) { console.warn('golden save error', e); }
      finally { this.goldenSaving = false; }
    },
    async deleteGoldenFile(stem) {
      try {
        await fetch(`/api/golden/${encodeURIComponent(stem)}`, { method: 'DELETE' });
        if (this.goldenCurrent?.stem === stem) { this.goldenCurrent = null; this.goldenDirty = false; }
        await this.loadGolden();
      } catch(e) { console.warn('golden delete error', e); }
    },
    async uploadGoldenPdf(event) {
      const file = event.target.files[0]; if (!file) return;
      const fd = new FormData(); fd.append('file', file); fd.append('num_items', this.goldenPdfNum);
      this.goldenPdfLoading = true; this.goldenPdfResult = null;
      try {
        this.goldenPdfResult = await fetch('/api/golden/pdf', { method: 'POST', body: fd }).then(r => r.json());
        if (this.goldenPdfResult.ok) {
          const fname = (this.goldenPdfResult.filename || 'pdf_dataset').replace(/\.pdf$/i, '');
          await fetch('/api/golden', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: fname, items: this.goldenPdfResult.items }),
          });
          await this.loadGolden();
        }
      } catch(e) { console.warn('pdf upload error', e); }
      finally { this.goldenPdfLoading = false; event.target.value = ''; }
    },
    /* ── transparency ── */
    async loadTransparency(type) {
      const all = !type;
      try {
        if (all || type === 'traces') {
          const r = await fetch('/api/transparency/traces');
          this.transpTraces = await r.json();
        }
        if (all || type === 'annotations') {
          const q = this.selId ? `?file_id=${encodeURIComponent(this.selId)}` : '';
          const r = await fetch(`/api/transparency/annotations${q}`);
          this.transpAnnotations = await r.json();
        }
        if (all || type === 'audit') {
          const r = await fetch('/api/transparency/audit');
          this.transpAudit = await r.json();
          const items = [];
          for (const a of this.transpAudit) {
            try {
              const rd = await fetch(`/api/transparency/audit/${a.stem}`);
              items.push({ ...a, ...(await rd.json()) });
            } catch(e) { items.push(a); }
          }
          this.transpAuditItems = items;
        }
      } catch(e) { console.warn('transparency load error', e); }
    },
    async loadTrace(stem) {
      try {
        const r = await fetch(`/api/transparency/traces/${stem}`);
        this.trDetail = { ...this.trDetail, [stem]: await r.json() };
      } catch(e) {}
    },
    async loadAnnotation(stem) {
      try {
        const r = await fetch(`/api/transparency/annotations/${stem}`);
        this.annDetail = { ...this.annDetail, [stem]: await r.json() };
      } catch(e) {}
    },
    async saveAnnotation() {
      const f = this.annForm;
      if (!f.title.trim() || !f.content.trim()) { f.error = '제목과 내용을 입력하세요.'; return; }
      f.saving = true; f.error = '';
      try {
        const r = await fetch('/api/transparency/annotations', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title: f.title.trim(), content: f.content.trim(),
            annotation_type: f.annotation_type, priority: f.priority,
            author: f.author.trim() || 'dashboard',
            target_type: f.target_type, target_id: f.target_id.trim(),
            source_file_id: this.selId || '',
          }),
        });
        if (!r.ok) throw new Error(await r.text());
        const ann = await r.json();
        this.transpAnnotations = [];
        await this.loadTransparency('annotations');
        this.annDetail = { ...this.annDetail, [ann.annotation_id]: ann };
        f.show = false; f.title = ''; f.content = ''; f.target_id = ''; f.author = '';
      } catch(e) { f.error = '저장 실패: ' + e.message; }
      finally { f.saving = false; }
    },
    async saveReply(stem) {
      const f = this.replyForm;
      if (!f.content.trim()) return;
      f.saving = true;
      try {
        const r = await fetch(`/api/transparency/annotations/${stem}/reply`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content: f.content.trim(), author: f.author.trim() || 'dashboard' }),
        });
        if (!r.ok) throw new Error(await r.text());
        this.annDetail = { ...this.annDetail, [stem]: await r.json() };
        f.stem = null; f.content = ''; f.author = '';
      } catch(e) {}
      finally { f.saving = false; }
    },
    /* ── settings ── */
    async loadSettings() {
      try {
        const d = await fetch('/api/thresholds').then(r => r.json());
        this.settingsData = { tcr_min: d.tcr ?? 90, acc_min: d.acc ?? 70, hall_max: d.hall ?? 5, p95_max: d.p95 ?? 2, cost_max: d.cost ?? 0.01 };
        this.thresholds = { tcr_min: (d.tcr ?? 90) / 100, acc_min: (d.acc ?? 70) / 100, hall_max: (d.hall ?? 5) / 100, p95_max: d.p95 ?? 2, cost_max: d.cost ?? 0.01 };
      } catch(e) { console.warn('settings load error', e); }
    },
    async saveSettings() {
      this.settingsSaving = true;
      try {
        const r = await fetch('/api/thresholds', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tcr: this.settingsData.tcr_min, acc: this.settingsData.acc_min, hall: this.settingsData.hall_max, p95: this.settingsData.p95_max, cost: this.settingsData.cost_max }),
        });
        if (r.ok) {
          this.thresholds = { tcr_min: this.settingsData.tcr_min / 100, acc_min: this.settingsData.acc_min / 100, hall_max: this.settingsData.hall_max / 100, p95_max: this.settingsData.p95_max, cost_max: this.settingsData.cost_max };
          this.settingsSaved = true; setTimeout(() => { this.settingsSaved = false; }, 2500);
        }
      } catch(e) { console.warn('settings save error', e); }
      finally { this.settingsSaving = false; }
    },
    applyPreset(name) {
      const presets = {
        default: { tcr_min:90, acc_min:70, hall_max:5,  p95_max:2.0,  cost_max:0.010 },
        strict:  { tcr_min:95, acc_min:85, hall_max:3,  p95_max:1.5,  cost_max:0.005 },
        relaxed: { tcr_min:80, acc_min:60, hall_max:10, p95_max:3.0,  cost_max:0.020 },
      };
      const p = presets[name];
      if (!p) return;
      this.settingsData = { ...p };
    },
    async testWebhook() {
      if (!this.webhookUrl.startsWith('https://')) { this.webhookResult = { ok: false, status: 0, error: 'URL은 https://로 시작해야 합니다' }; return; }
      this.webhookLoading = true; this.webhookResult = null;
      try {
        let payload; try { payload = JSON.parse(this.webhookPayload); } catch { payload = this.webhookPayload; }
        this.webhookResult = await fetch('/api/webhook/test', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url: this.webhookUrl, payload }),
        }).then(r => r.json());
      } catch(e) { this.webhookResult = { ok: false, status: 0, error: e.message }; }
      finally { this.webhookLoading = false; }
    },

    /* ── chart renderer ── */
    _plt(id, traces, layout) {
      const el = document.getElementById(id);
      if (!el || el.clientWidth === 0) return; // skip hidden x-show containers (sec watcher redraws on show)
      const base = {
        paper_bgcolor:'rgba(0,0,0,0)', plot_bgcolor:'rgba(0,0,0,0)',
        font:{ family:'Inter,sans-serif', size:11, color: this.dark?'#d1d5db':'#374151' },
        margin:{t:20,r:15,b:40,l:45},  // balanced default; pie/polar overrides per-chart
        showlegend: false,
      };
      Plotly.react(el, traces, Object.assign({}, base, layout), { responsive:true, displayModeBar:false });
    },

    drawTaskCharts() {
      if (!this.data) return;
      const tasks = this.data.tasks || [];
      const ttypes = this.taskTypes();
      const tcrByType = ttypes.map(tp => {
        const g = tasks.filter(t => t.task_type === tp);
        return g.length ? g.reduce((s, t) => s + (t.completion_score || 0), 0) / g.length : 0;
      });
      const el1 = document.getElementById('d2-ts-type-tcr');
      if (el1) Plotly.react(el1, [{
        x: ttypes, y: tcrByType, type: 'bar',
        marker: { color: '#6366f1' }, hovertemplate: '%{x}: %{y:.1%}<extra></extra>'
      }], Object.assign({ paper_bgcolor:'rgba(0,0,0,0)', plot_bgcolor:'rgba(0,0,0,0)', font:{family:'Inter,sans-serif',size:11,color:this.dark?'#d1d5db':'#374151'}, margin:{t:20,r:15,b:40,l:45}, showlegend:false }, { yaxis:{ tickformat:'.0%', range:[0,1] } }), { responsive:true, displayModeBar:false });
      const scatterT = tasks.filter(t => t.completion_score != null && t.execution_time != null);
      const el2 = document.getElementById('d2-ts-scatter');
      if (el2) Plotly.react(el2, [{
        x: scatterT.map(t => t.execution_time), y: scatterT.map(t => t.completion_score),
        mode: 'markers', type: 'scatter',
        marker: { color: scatterT.map(t => t.success ? '#10b981' : '#ef4444'), size: 6 },
        hovertemplate: '%{customdata}<br>지연: %{x:.2f}s | 완료율: %{y:.2f}<extra></extra>',
        customdata: scatterT.map(t => t.task_id || '?')
      }], Object.assign({ paper_bgcolor:'rgba(0,0,0,0)', plot_bgcolor:'rgba(0,0,0,0)', font:{family:'Inter,sans-serif',size:11,color:this.dark?'#d1d5db':'#374151'}, margin:{t:20,r:15,b:40,l:45}, showlegend:false }, { xaxis:{ title:'지연(s)' }, yaxis:{ title:'완료율', range:[0,1] } }), { responsive:true, displayModeBar:false });
    },

    drawCharts() {
      if (!this.data) return;
      const tasks = this.data.tasks || [];
      const adv = this.data.advanced || {};
      const clr = ['#6366f1','#8b5cf6','#06b6d4','#10b981','#f59e0b','#ef4444','#ec4899','#14b8a6'];

      /* --- Overview --- */
      const tcrV = (this.tcr_() ?? 0) / 100;
      const accV = (this.acc_() ?? 0) / 100;
      // d2-ov-donut: compute from tasks (data.summary does not exist in detail API)
      const succCount = tasks.filter(t => t.success).length;
      const failCount = tasks.length - succCount;
      this._plt('d2-ov-donut', [{
        values: [succCount, failCount],
        labels: ['성공','실패'], type:'pie', hole:0.6,
        marker:{colors:['#10b981','#ef4444']},
        textinfo:'none', hovertemplate:'%{label}: %{value}건<extra></extra>'
      }], {
        showlegend:true, legend:{orientation:'h', y:-0.05, x:0.5, xanchor:'center'},
        margin:{t:10,r:10,b:55,l:10}
      });

      // d2-ov-type: count per task type (not success rate)
      const ttypes = this.taskTypes();
      const countByType = ttypes.map(tp => tasks.filter(t => t.task_type === tp).length);
      this._plt('d2-ov-type', [{
        x: ttypes, y: countByType, type:'bar',
        marker:{color:'#6366f1'}, hovertemplate:'%{x}: %{y}건<extra></extra>'
      }], {
        margin:{t:10,r:10,b:50,l:40},
        xaxis:{automargin:true},
        yaxis:{title:{text:'건수'},dtick:1,automargin:true}
      });

      // d2-ov-persp: 6-axis radar (완료율, 정확·품질, 운영효율, 에이전틱역량, 신뢰성, 보안)
      const _d = this.data;
      const opsNorm       = (_cmpOpsNorm(_d) ?? 0) / 100;
      const qualAccNorm   = _cmpQualAccNorm(_d) / 100;
      const agenticNorm   = (_cmpAgenticNorm(_d) ?? 0) / 100;
      const reliabilityNorm = (_cmpReliabilityNorm(_d) ?? 0) / 100;
      const secNormV      = (_cmpSecNorm(_d) ?? 0) / 100;
      const perspLabels = ['완료율','정확·품질','운영 효율','에이전틱\n역량','신뢰성','보안'];
      const perspVals   = [tcrV, qualAccNorm, opsNorm, agenticNorm, reliabilityNorm, secNormV];
      // N/A 축 강조색 분리 (has_agentic=false → 회색, has_security=false → 회색)
      const perspColors = perspLabels.map((_, i) => {
        if (i === 3 && !_d.has_agentic) return 'rgba(156,163,175,0.4)';
        if (i === 5 && !_d.has_security) return 'rgba(156,163,175,0.4)';
        return 'rgba(99,102,241,0.15)';
      });
      const perspLabelsC = [...perspLabels, perspLabels[0]];
      const perspValsC   = [...perspVals,   perspVals[0]];
      this._plt('d2-ov-persp', [{
        r: perspValsC, theta: perspLabelsC, type:'scatterpolar', fill:'toself',
        line:{color:'#6366f1',width:2}, fillcolor:'rgba(99,102,241,0.15)',
        hovertemplate:'%{theta}: %{r:.0%}<extra></extra>',
        name: '종합 점수',
      }], {
        polar:{
          radialaxis:{range:[0,1], tickformat:'.0%', tickfont:{size:9}, gridcolor:'rgba(128,128,128,0.2)'},
          angularaxis:{tickfont:{size:11}},
          domain:{x:[0,1], y:[0,1]},
        },
        margin:{t:50,r:80,b:50,l:80},
        autosize: true,
        showlegend: false,
      });

      /* --- Quality: TCR by type --- */
      this._plt('d2-q-donut', [{
        values: [succCount, failCount],
        labels: ['성공','실패'], type:'pie', hole:0.55,
        marker:{colors:['#10b981','#ef4444']}, textinfo:'none',
        hovertemplate:'%{label}: %{value}건<extra></extra>'
      }], {
        showlegend:true, legend:{orientation:'h', y:-0.05, x:0.5, xanchor:'center'},
        margin:{t:10,r:10,b:55,l:10}
      });
      // TCR rate per type (0-1 scale)
      const tcrByType = ttypes.map(tp => {
        const g = tasks.filter(t => t.task_type === tp);
        return g.length ? g.reduce((s,t) => s + (t.completion_score||0), 0) / g.length : 0;
      });
      this._plt('d2-q-type-tcr', [{
        x: ttypes, y: tcrByType, type:'bar',
        marker:{color:'#6366f1'}, hovertemplate:'%{x}: %{y:.1%}<extra></extra>'
      }], { yaxis:{tickformat:'.0%',range:[0,1]} });

      /* --- Quality: Accuracy --- */
      const accScores = tasks.map(t=>t.accuracy_score).filter(v=>v!=null);
      this._plt('d2-q-acc-hist', [{
        x: accScores, type:'histogram', nbinsx:20,
        marker:{color:'#6366f1'}, hovertemplate:'%{x:.2f}: %{y}건<extra></extra>'
      }], { xaxis:{title:'정확도'}, yaxis:{title:'건수'} });
      this._plt('d2-q-acc-weights', [{
        x: ['Token Overlap','Jaccard','LCS','Char'], y:[0.4,0.3,0.2,0.1],
        type:'bar', marker:{color:clr}, hovertemplate:'%{x}: %{y:.0%}<extra></extra>'
      }], { yaxis:{tickformat:'.0%'}, title:{text:'가중치 구성',font:{size:11}} });

      /* --- Quality: Response Quality radar --- */
      const rq = this.data?.quality_detail?.dimension_summary || adv.response_quality || {};
      const rqDims = ['relevance','completeness','clarity','accuracy','usefulness'];
      const rqVals = rqDims.map(d => rq[d]??rq['avg_'+d]??0);
      this._plt('d2-q-radar', [{
        r: rqVals, theta: rqDims, type:'scatterpolar', fill:'toself',
        line:{color:'#8b5cf6'}, fillcolor:'rgba(139,92,246,0.2)',
        hovertemplate:'%{theta}: %{r:.2f}<extra></extra>'
      }], { polar:{radialaxis:{range:[0,5],tickfont:{size:9}}}, margin:{t:25,r:55,b:25,l:45} });
      const gradeMap = v => v>=4.5?'A':v>=4.0?'B':v>=3.5?'C':v>=3.0?'D':'F'; // SDK: A≥4.5, B≥4.0, C≥3.5, D≥3.0, F<3.0
      const grades = rqDims.map(d => gradeMap(rq[d]??0));
      this._plt('d2-q-grade', [{
        x: rqDims, y: rqVals, type:'bar',
        text: grades, textposition:'outside',
        marker:{color:rqVals.map(v=>v>=4.5?'#10b981':v>=3.5?'#f59e0b':'#ef4444')},
        hovertemplate:'%{x}: %{y:.2f}<extra></extra>'
      }], { yaxis:{range:[0,6],title:{text:'점수 (0-5)',font:{size:10}}} });

      /* --- Quality: Hallucination (Layer 1 탐지 건 전용 — 탐지 건수와 동일 모집단) --- */
      // rate>0인 Layer 1 detections만 → 각 유형이 몇 건의 탐지 태스크에 나타났는지 (합계 ≤ 탐지 건수)
      const _hallDets = (this.data?.hallucination_detail?.detections || [])
        .filter(d => d.source !== 'deepeval' && (d.hallucination_rate||0) > 0);
      const hallIndTypes = {};
      _hallDets.forEach(det => {
        const seenTypes = new Set((det.indicators||[]).map(ind => ind.type||'unknown'));
        seenTypes.forEach(t => { hallIndTypes[t] = (hallIndTypes[t]||0) + 1; });
      });
      const hallTypes = Object.keys(hallIndTypes).length ? Object.keys(hallIndTypes) : ['factual_error','unsupported_claim','contradiction','fabricated_detail','other'];
      const hallCounts = hallTypes.map(k => hallIndTypes[k]||0);
      this._plt('d2-q-hall-type', [{
        x: hallCounts, y: hallTypes, type:'bar', orientation:'h',
        marker:{color:'#ef4444'}, hovertemplate:'%{y}: %{x}건<extra></extra>'
      }], { xaxis:{title:'탐지 태스크 수 (복수 유형 보유 시 합계 > 탐지 건수)', dtick:1}, yaxis:{automargin:true}, margin:{l:140,r:15,t:20,b:60} });

      /* --- External: RAG --- */
      const ragMetrics = ['faithfulness','answer_relevancy','context_recall','context_precision'];
      const ragRawM = this.data?.rag_metrics || {};
      const ragPT2 = (this.data?.advanced?.per_task || []).filter(t => t['ragas_faithfulness'] != null);
      const _ragAvg = k => {
        const arr = ragRawM[k];
        if (Array.isArray(arr) && arr.length) return arr.reduce((a,b)=>a+b,0)/arr.length;
        const vals = ragPT2.map(t=>t['ragas_'+k]).filter(v=>v!=null);
        return vals.length ? vals.reduce((a,b)=>a+b,0)/vals.length : 0;
      };
      const ragVals = ragMetrics.map(k => _ragAvg(k));
      this._plt('d2-ex-rag-bar', [{
        x: ragMetrics, y: ragVals, type:'bar',
        marker:{color:'#06b6d4'}, hovertemplate:'%{x}: %{y:.3f}<extra></extra>'
      }], { yaxis:{range:[0,1],tickformat:'.2f'} });

      // 태스크별 RAG 점수: grouped bar chart (태스크 x 4지표)
      // ragPT2 is from advanced.per_task (tasks with ragas_* in advanced_metrics).
      // Fallback: rebuild from top-level rag_metrics arrays when per_task is empty.
      let ragPT2b = ragPT2.slice();
      if (!ragPT2b.length) {
        const rm = this.data?.rag_metrics || {};
        const rkeys = ['faithfulness','answer_relevancy','context_recall','context_precision'];
        const maxLen = Math.max(0, ...rkeys.map(k => Array.isArray(rm[k]) ? rm[k].length : 0));
        if (maxLen > 0) {
          const srcTasks = this.data?.tasks || [];
          ragPT2b = Array.from({length: maxLen}, (_, i) => {
            const entry = {task_id: srcTasks[i]?.task_id || ('Task '+(i+1))};
            rkeys.forEach(k => { if (Array.isArray(rm[k]) && rm[k][i] != null) entry['ragas_'+k] = rm[k][i]; });
            return entry;
          });
        }
      }
      const ragTaskIds = ragPT2b.map(t => String(t.task_id||''));
      const ragMetricDefs = [
        {key:'ragas_faithfulness',     label:'Faithfulness',    color:'#06b6d4'},
        {key:'ragas_answer_relevancy', label:'Ans. Relevancy',  color:'#8b5cf6'},
        {key:'ragas_context_recall',   label:'Ctx. Recall',     color:'#10b981'},
        {key:'ragas_context_precision',label:'Ctx. Precision',  color:'#f59e0b'},
      ];
      if (!ragTaskIds.length) {
        // Truly no per-task RAG data — show empty-state annotation
        this._plt('d2-ex-rag-scatter', [], {
          annotations: [{
            text: '태스크별 RAG 데이터 없음',
            xref:'paper', yref:'paper', x:0.5, y:0.5, showarrow:false,
            font:{size:13, color: this.dark?'#9ca3af':'#6b7280'},
          }],
          xaxis:{visible:false}, yaxis:{visible:false},
        });
      } else {
        const ragGroupTraces = ragMetricDefs.map(m => ({
          name: m.label,
          x: ragTaskIds,
          y: ragPT2b.map(t => t[m.key]!=null ? Number(t[m.key]) : null),
          type: 'bar',
          marker: {color: m.color},
          hovertemplate: '%{x}<br>'+m.label+': %{y:.3f}<extra></extra>',
        }));
        const _elRag = document.getElementById('d2-ex-rag-scatter');
        if (_elRag) _elRag.style.height = '280px';
        this._plt('d2-ex-rag-scatter', ragGroupTraces, {
          height: 280,
          barmode: 'group',
          xaxis: {automargin:true, tickangle: ragTaskIds.length > 8 ? -45 : 0, tickfont:{size:10}},
          yaxis: {range:[0,1], tickformat:'.2f', title:{text:'점수',font:{size:10}}},
          showlegend: true,
          legend: {orientation:'h', y:-0.28, x:0.5, xanchor:'center', font:{size:10}},
          margin: {t:20, r:15, b:80, l:45},
        });
      }

      /* --- External: DeepEval --- */
      const dk = this.deepevalKpis();
      const deKeys = dk.keys.slice(0,8);
      const deVals = deKeys.map(k=>dk.metrics[k]||0);
      const deLabels = {g_eval_score:'G-Eval',hallucination_score:'Hallucination',toxicity_score:'Toxicity',bias_score:'Bias',answer_relevancy_score:'Ans. Relevancy'};
      this._plt('d2-ex-de-bar', [{
        x: deKeys.map(k=>deLabels[k]||k), y: deVals, type:'bar',
        marker:{color:'#8b5cf6'}, hovertemplate:'%{x}: %{y:.3f}<extra></extra>'
      }], { yaxis:{range:[0,1],tickformat:'.2f'} });

      // DeepEval heatmap: task × metric
      const deHmKeys = ['g_eval_score','hallucination_score','toxicity_score','bias_score','answer_relevancy_score'];
      const deHmLabels = {g_eval_score:'G-Eval',hallucination_score:'Hallucination',toxicity_score:'Toxicity',bias_score:'Bias',answer_relevancy_score:'Ans. Relevancy'};
      const deHmPT = (this.data?.advanced?.per_task||[]).filter(t=>deHmKeys.some(k=>t[k]!=null));
      const deHmTaskIds = deHmPT.map(t=>String(t.task_id||''));
      const deHmXLabels = deHmKeys.map(k=>deHmLabels[k]||k);
      // z[row=task][col=metric], y=taskIds reversed for top-down display
      const deHmZ = deHmPT.map(t=>deHmKeys.map(k=>t[k]!=null?Number(t[k]):null));
      const deHmText = deHmZ.map(row=>row.map(v=>v!=null?v.toFixed(2):'—'));
      const deHmH = Math.max(200, deHmTaskIds.length * 28 + 80);
      const _elDeHm = document.getElementById('d2-ex-de-hist');
      if (_elDeHm) _elDeHm.style.height = deHmH + 'px';
      this._plt('d2-ex-de-hist', [{
        type:'heatmap',
        x: deHmXLabels,
        y: deHmTaskIds,
        z: deHmZ,
        text: deHmText,
        texttemplate: '%{text}',
        textfont: {size:10},
        colorscale: [[0,'#ef4444'],[0.5,'#f59e0b'],[1,'#10b981']],
        zmin:0, zmax:1,
        showscale: true,
        colorbar: {thickness:12, len:0.8, tickformat:'.1f', title:{text:'점수',side:'right',font:{size:10}}},
        hovertemplate: '%{y}<br>%{x}: %{z:.3f}<extra></extra>',
      }], {
        height: deHmH,
        xaxis:{side:'bottom', tickangle:-20},
        yaxis:{automargin:true},
        margin:{t:20, r:70, b:60, l:10},
      });

      /* --- Performance: Latency --- */
      const lat = this.data.efficiency_metrics?.latency || {};
      const latTimes = tasks.map(t=>t.execution_time).filter(v=>v!=null).sort((a,b)=>a-b);
      function _lp(p){
        if (!latTimes.length) return 0;
        if (latTimes.length === 1) return latTimes[0];
        const idx = (p/100)*(latTimes.length-1), lo=Math.floor(idx), hi=Math.ceil(idx);
        return lo===hi ? latTimes[lo] : latTimes[lo]+(idx-lo)*(latTimes[hi]-latTimes[lo]);
      }
      const latVals = [
        lat.p50  ?? _lp(50),   // P50
        _lp(75),                // P75 (트래커 미수집 → tasks 직접 계산)
        _lp(90),                // P90 (트래커 미수집 → tasks 직접 계산)
        lat.p95  ?? _lp(95),   // P95
        lat.p99  ?? _lp(99),   // P99
      ];
      this._plt('d2-p-lat-bar', [{
        x: ['P50','P75','P90','P95','P99'], y: latVals, type:'bar',
        marker:{color:['#6366f1','#8b5cf6','#f59e0b','#f59e0b','#ef4444']},
        hovertemplate:'%{x}: %{y:.3f}s<extra></extra>'
      }], { yaxis:{title:'초(s)'}, margin:{t:20,r:20,b:40,l:50} });
      const latScores = tasks.map(t=>t.execution_time).filter(v=>v!=null);
      this._plt('d2-p-lat-hist', [{
        x: latScores, type:'histogram', nbinsx:25,
        marker:{color:'#f59e0b'}, hovertemplate:'%{x:.2f}s: %{y}건<extra></extra>'
      }], { xaxis:{title:'지연(s)'}, yaxis:{title:'건수'} });
      const slow = this.slowTasks(10);
      this._plt('d2-p-lat-task', [{
        x: slow.map(t=>t.execution_time||0), y: slow.map(t=>t.task_id||'?'),
        type:'bar', orientation:'h',
        marker:{color:'#ef4444'}, hovertemplate:'%{y}: %{x:.2f}s<extra></extra>'
      }], { margin:{l:120,t:20,r:20,b:40}, xaxis:{title:'초(s)'} });

      /* --- Performance: Token --- */
      const em = this.data.efficiency_metrics || {};
      const tokEm = em.tokens || em.token || {};
      const tok = adv.token_economy || adv.token || {};
      // 실제 필드명: total_input_tokens / total_output_tokens (prompt/completion 아님)
      const iTok = tok.total_input_tokens  || tokEm.total_input_tokens  || tok.total_prompt_tokens     || tokEm.total_prompt_tokens     || 0;
      const oTok = tok.total_output_tokens || tokEm.total_output_tokens || tok.total_completion_tokens || tokEm.total_completion_tokens || 0;
      const tTok = tok.total_tokens || tokEm.total_tokens || 0;
      const aTok = tok.avg_tokens_per_task || tokEm.avg_tokens_per_task || 0;
      this._plt('d2-p-tok-bar', [{
        x: ['총 토큰','입력 토큰','출력 토큰','평균/태스크'],
        y: [tTok, iTok, oTok, aTok],
        type:'bar',
        marker:{color:['#6366f1','#8b5cf6','#06b6d4','#10b981']},
        hovertemplate:'%{x}: %{y:,.0f}<extra></extra>'
      }], { yaxis:{title:'토큰'}, margin:{t:20,r:20,b:40,l:60} });
      // 파이: 두 값이 모두 0이면 빈 도넛 대신 안내 텍스트 처리
      if (iTok > 0 || oTok > 0) {
        this._plt('d2-p-tok-ratio', [{
          values: [iTok, oTok], labels:['입력','출력'], type:'pie', hole:0.5,
          marker:{colors:['#6366f1','#06b6d4']}, textinfo:'percent+label',
          hovertemplate:'%{label}: %{value:,.0f}토큰<extra></extra>'
        }], { showlegend:true, legend:{orientation:'h',y:-0.05,x:0.5,xanchor:'center'}, margin:{t:10,r:10,b:55,l:10} });
      }
      // 토큰 분포: tokens_used 추출 (object 또는 숫자 혼용 처리)
      function _getTok(t) {
        const v = t.tokens_used;
        if (typeof v === 'object' && v !== null)
          return v.total || (v.input||v.input_tokens||0) + (v.output||v.output_tokens||0) || 0;
        return v || 0;
      }
      const tokScores = tasks.map(t => ({id: t.task_id||'?', val: _getTok(t)})).filter(d => d.val > 0);
      if (tokScores.length > 0) {
        if (tokScores.length <= 30) {
          // 태스크 수 적으면 태스크별 바 차트 (정확한 실수치 표시)
          const sorted = [...tokScores].sort((a,b) => b.val - a.val);
          this._plt('d2-p-tok-hist', [{
            x: sorted.map(d=>d.id), y: sorted.map(d=>d.val), type:'bar',
            marker:{color:'#6366f1'}, hovertemplate:'%{x}: %{y:,.0f}토큰<extra></extra>'
          }], { xaxis:{title:'태스크', tickangle:-30}, yaxis:{title:'토큰 수'}, margin:{t:20,r:20,b:70,l:60} });
        } else {
          // 태스크 많으면 히스토그램 (빈 크기를 정수 단위로 고정해 정확도 향상)
          const vals = tokScores.map(d=>d.val);
          const mn = Math.min(...vals), mx = Math.max(...vals);
          const binSz = Math.max(1, Math.round((mx-mn)/Math.min(vals.length, 20)));
          this._plt('d2-p-tok-hist', [{
            x: vals, type:'histogram',
            xbins:{start: mn - binSz/2, end: mx + binSz/2, size: binSz},
            marker:{color:'#6366f1'}, hovertemplate:'%{x:,.0f}토큰: %{y}건<extra></extra>'
          }], { xaxis:{title:'토큰 수'}, yaxis:{title:'건수'}, margin:{t:20,r:20,b:40,l:50} });
        }
      }

      /* --- Performance: Cost --- */
      const totalCost = tokEm.total_cost || tok.total_cost || 0;
      // 태스크별 토큰 합산 후 비례 배분으로 태스크별 비용 추정
      const taskCostList = tasks.map(t => ({ id: t.task_id||'?', tok: _getTok(t) })).filter(d => d.tok > 0);
      const sumTok = taskCostList.reduce((s, d) => s + d.tok, 0) || tTok || 1;
      const taskCostSorted = taskCostList.map(d => ({
        id: d.id,
        cost: (d.tok / sumTok) * totalCost
      })).sort((a, b) => b.cost - a.cost).slice(0, 25);
      if (taskCostSorted.length > 0) {
        this._plt('d2-p-cost-bar', [{
          x: taskCostSorted.map(d => d.id),
          y: taskCostSorted.map(d => d.cost),
          type: 'bar', marker: { color: '#10b981' },
          hovertemplate: '%{x}: $%{y:.5f}<extra></extra>'
        }], { yaxis:{title:'비용($)'}, xaxis:{tickangle:-30}, margin:{t:20,r:20,b:90,l:70} });
      } else {
        this._plt('d2-p-cost-bar', [{
          x: ['전체'], y: [totalCost], type: 'bar',
          marker: { color: '#10b981' }, hovertemplate: '%{x}: $%{y:.4f}<extra></extra>'
        }], { yaxis:{title:'비용($)'}, margin:{t:20,r:20,b:40,l:70} });
      }

      /* --- Agentic: Tool Pie --- */
      const byTool = this.toolCallByTool();
      if (byTool.length > 0) {
        this._plt('d2-ag-tool-pie', [{
          values: byTool.map(t=>t.calls), labels: byTool.map(t=>t.name), type:'pie', hole:0.4,
          marker:{colors:clr}, textinfo:'percent+label',
          hovertemplate:'%{label}: %{value}회<extra></extra>'
        }], { showlegend:false, margin:{t:10,r:10,b:10,l:10} });
      }
      // 효율성 지표 요약: 도구별 호출 수 바 차트 (success_rate가 없으면 호출 빈도로 대체)
      const teEff = this.data.agentic?.tool_efficiency || {};
      const hasSR = byTool.some(t=>t.success_rate!=null);
      if (hasSR) {
        this._plt('d2-ag-teff-bar', [{
          x: byTool.map(t=>t.name), y: byTool.map(t=>t.success_rate??0),
          type:'bar', marker:{color:byTool.map(t=>(t.success_rate??0)>=90?'#10b981':'#f59e0b')},
          hovertemplate:'%{x}: %{y:.1f}%<extra></extra>'
        }], { yaxis:{title:'성공률(%)',range:[0,100]}, xaxis:{tickangle:-30}, margin:{t:20,r:20,b:80,l:55} });
      } else if (byTool.length > 0) {
        // 도구별 호출 수 바 차트
        this._plt('d2-ag-teff-bar', [{
          x: byTool.map(t=>t.name), y: byTool.map(t=>t.calls),
          type:'bar', marker:{color:clr},
          hovertemplate:'%{x}: %{y}회<extra></extra>'
        }], { yaxis:{title:'호출 수(회)'}, xaxis:{tickangle:-30}, margin:{t:20,r:20,b:80,l:55} });
      } else {
        // 전체 효율 지표 요약 바
        this._plt('d2-ag-teff-bar', [{
          x:['성공률','중복 호출률','실패율'],
          y:[teEff.success_rate||0, teEff.redundancy_rate||0, teEff.failure_rate||0],
          type:'bar', marker:{color:['#10b981','#f59e0b','#ef4444']},
          hovertemplate:'%{x}: %{y:.1f}%<extra></extra>'
        }], { yaxis:{title:'(%)',range:[0,100]}, margin:{t:20,r:20,b:40,l:55} });
      }

      /* --- Agentic: Tool Selection --- */
      // F1 오름차순 정렬 (낮은 태스크가 맨 위 → 주의 집중)
      const tsSel = (this.data.agentic?.tool_selections || []).sort((a,b)=>(a.f1_score||0)-(b.f1_score||0));
      if (tsSel.length > 0) {
        const tsH = Math.max(260, tsSel.length * 34 + 80);
        const _elTs = document.getElementById('d2-ag-sel-bar');
        if (_elTs) _elTs.style.height = tsH + 'px';
        const tsColor = s => { const f=s.f1_score||0; return f>=90?'#10b981':f>=70?'#f59e0b':'#ef4444'; };
        this._plt('d2-ag-sel-bar', [{
          name: 'F1',
          y: tsSel.map(s=>s.task_id||'?'),
          x: tsSel.map(s=>s.f1_score||0),
          type:'bar', orientation:'h',
          marker:{color:tsSel.map(tsColor)},
          text: tsSel.map(s=>(s.f1_score||0).toFixed(1)+'%'),
          textposition:'outside', textfont:{size:11}, cliponaxis:false,
          hovertemplate:'<b>%{y}</b><br>F1: %{x:.1f}%<extra></extra>',
        },{
          name: 'Precision',
          y: tsSel.map(s=>s.task_id||'?'),
          x: tsSel.map(s=>s.precision||0),
          type:'scatter', mode:'markers',
          marker:{color:'#6366f1', size:9, symbol:'circle'},
          hovertemplate:'<b>%{y}</b><br>Precision: %{x:.1f}%<extra></extra>',
        },{
          name: 'Recall',
          y: tsSel.map(s=>s.task_id||'?'),
          x: tsSel.map(s=>s.recall||0),
          type:'scatter', mode:'markers',
          marker:{color:'#06b6d4', size:9, symbol:'diamond'},
          hovertemplate:'<b>%{y}</b><br>Recall: %{x:.1f}%<extra></extra>',
        }], {
          height: tsH,
          xaxis:{range:[0,118], ticksuffix:'%', tickformat:'.0f',
                 title:{text:'Score (%)', font:{size:10}}},
          yaxis:{automargin:true, tickfont:{size:11}},
          showlegend:true,
          legend:{orientation:'h', y:-0.08, x:0.5, xanchor:'center', font:{size:10}},
          margin:{t:10, r:55, b:45, l:10},
          shapes:[
            {type:'line',x0:90,x1:90,y0:0,y1:1,yref:'paper',
             line:{color:'#10b981',width:1,dash:'dot'}},
            {type:'line',x0:70,x1:70,y0:0,y1:1,yref:'paper',
             line:{color:'#f59e0b',width:1,dash:'dot'}},
          ],
        });
      }

      /* --- Agentic: Retry --- */
      // 재시도 횟수 분포 — retry_attempts 집계 (막대 차트, 가독성 향상)
      const retryAttemptsDist = this.data.agentic?.retry_attempts || [];
      if (retryAttemptsDist.length > 0) {
        const rdist = {};
        for (const r of retryAttemptsDist) { const a = r.total_attempts||1; rdist[a]=(rdist[a]||0)+1; }
        const rxs = Object.keys(rdist).map(Number).sort((a,b)=>a-b);
        const rColors = rxs.map(x=>x>=3?'#e55':x===2?'#e9a020':'#8b5cf6');
        this._plt('d2-ag-retry-hist', [{
          x: rxs.map(x=>x+'회'), y: rxs.map(x=>rdist[x]),
          type:'bar', marker:{color:rColors},
          hovertemplate:'%{x}: %{y}건<extra></extra>'
        }], { xaxis:{title:'시도 횟수'}, yaxis:{title:'태스크 수', dtick:1}, bargap:0.35, margin:{t:20,r:20,b:40,l:50} });
      } else {
        this._plt('d2-ag-retry-hist', [{x:[],y:[],type:'bar'}], { annotations:[{x:0.5,y:0.5,xref:'paper',yref:'paper',text:'재시도 없음',showarrow:false,font:{color:'#888',size:13}}] });
      }
      // 태스크 유형별 재시도율 — data.agentic.retry_attempts 집계
      const retryAttempts = this.data.agentic?.retry_attempts || [];
      const rtByType = {};
      for (const r of retryAttempts) {
        const tp = r.task_type || r.type || 'unknown';
        if (!rtByType[tp]) rtByType[tp] = {total:0, retries:0};
        rtByType[tp].total++;
        if ((r.total_attempts||1) > 1) rtByType[tp].retries++;
      }
      const rtTypeKeys = Object.keys(rtByType);
      if (rtTypeKeys.length > 0) {
        this._plt('d2-ag-retry-type', [{
          x: rtTypeKeys,
          y: rtTypeKeys.map(k => rtByType[k].total > 0 ? rtByType[k].retries/rtByType[k].total*100 : 0),
          type:'bar', marker:{color:'#f59e0b'}, hovertemplate:'%{x}: %{y:.1f}%<extra></extra>'
        }], { yaxis:{title:'재시도율(%)',range:[0,100]}, xaxis:{tickangle:-30}, margin:{t:20,r:20,b:80,l:55} });
      } else if (this.data.agentic?.retry_summary) {
        // fallback: retry_summary.by_task_type
        const rsByType = this.data.agentic.retry_summary.by_task_type || {};
        const rsTKeys = Object.keys(rsByType);
        if (rsTKeys.length > 0) {
          this._plt('d2-ag-retry-type', [{
            x: rsTKeys, y: rsTKeys.map(k => (rsByType[k]?.retry_rate||rsByType[k]?.avg_attempts||0)),
            type:'bar', marker:{color:'#f59e0b'}, hovertemplate:'%{x}: %{y:.1f}<extra></extra>'
          }], { yaxis:{title:'평균 시도'}, xaxis:{tickangle:-30}, margin:{t:20,r:20,b:80,l:55} });
        }
      }

      /* --- Agentic: Coordination --- */
      // data.agentic.agent_interactions 에서 에이전트별 집계
      const agInteractions = this.data.agentic?.agent_interactions || [];
      const agCounts = {};
      for (const i of agInteractions) {
        const from = i.from_agent || i.from || '?';
        const to   = i.to_agent   || i.to   || '?';
        if (from !== '?') agCounts[from] = (agCounts[from]||0) + 1;
        if (to   !== '?') agCounts[to]   = (agCounts[to]  ||0) + 1;
      }
      const agKeys = Object.keys(agCounts).sort((a,b)=>agCounts[b]-agCounts[a]);
      if (agKeys.length > 0) {
        this._plt('d2-ag-coord-bar', [{
          x: agKeys, y: agKeys.map(a=>agCounts[a]),
          type:'bar', marker:{color:'#06b6d4'}, hovertemplate:'%{x}: %{y}회<extra></extra>'
        }], { yaxis:{title:'인터랙션 수'}, xaxis:{tickangle:-30}, margin:{t:20,r:20,b:80,l:55} });
      }

      /* --- Agentic: Workflow --- */
      // data.agentic.workflow_summary (loader 집계 결과)
      const wfSum = this.data.agentic?.workflow_summary || {};
      const wfSteps        = wfSum.total_steps            || 0;
      const wfSuccessSteps = wfSum.successful_steps       || 0;
      const wfTasks        = wfSum.total_tasks            || 0;
      const wfSuccessTasks = wfSum.fully_successful_tasks || 0;
      this._plt('d2-ag-wf-funnel', [{
        x: ['전체 단계','성공 단계','전체 태스크','성공 태스크'],
        y: [wfSteps, wfSuccessSteps, wfTasks, wfSuccessTasks],
        type:'bar', marker:{color:['#6366f1','#10b981','#8b5cf6','#06b6d4']},
        hovertemplate:'%{x}: %{y}<extra></extra>'
      }], { margin:{t:20,r:20,b:40,l:55} });

      /* --- Security: Summary --- */
      const sl1 = this.data.security_l1 || {};
      const sl2 = this.data.security_l2 || {};
      const secScores = [
        sl1.input_security  != null ? (100-(sl1.input_security?.threat_rate||0))/100 : null,
        sl1.output_leakage  != null ? (100-(sl1.output_leakage?.leakage_rate||0))/100 : null,
        sl1.authorization   != null ? (sl1.authorization?.compliance_rate??100)/100   : null,
        sl2.privilege_escalation != null ? (100-(sl2.privilege_escalation?.escalation_rate||0))/100 : null,
        sl2.attack_detection     != null ? (sl2.attack_detection?.total_chains_analyzed||0)===0?1:Math.max(0,100-(sl2.attack_detection?.detection_rate||0))/100 : null,
      ];
      this._plt('d2-sec-summary', [{
        x: ['입력 보안','출력 유출','인가 준수','권한 상승','체인 안전'],
        y: secScores.map(v=>v??0),
        type:'bar',
        marker:{color:secScores.map(v=>v==null?'#9ca3af':v>=0.9?'#10b981':v>=0.7?'#f59e0b':'#ef4444')},
        hovertemplate:'%{x}: %{y:.1%}<extra></extra>'
      }], { yaxis:{range:[0,1],tickformat:'.0%'} });

      /* --- Security: Input Bar --- */
      // input_security 객체: sql_injection_attempts, command_injection_attempts 등
      const inpSec = this.data.security_l1?.input_security || {};
      const inpLabels = ['SQL인젝션','커맨드인젝션','경로순회','XSS','프롬프트인젝션'];
      const inpVals = [
        inpSec.sql_injection_attempts||0, inpSec.command_injection_attempts||0,
        inpSec.path_traversal_attempts||0, inpSec.xss_attempts||0, inpSec.prompt_injection_attempts||0
      ];
      this._plt('d2-sec-in-bar', [{
        x: inpLabels, y: inpVals,
        type:'bar', marker:{color:'#ef4444'}, hovertemplate:'%{x}: %{y}건<extra></extra>'
      }], { yaxis:{title:'탐지 건수'} });

      /* --- Security: Output Bar --- */
      // output_leakage 객체: api_key_leaks, password_leaks 등 (필드명 올바름)
      const outLeak = this.data.security_l1?.output_leakage || {};
      const outTypes = ['api_key_leaks','password_leaks','credit_card_leaks','email_leaks','ssn_leaks','phone_leaks','private_ip_leaks','file_path_leaks'];
      const outLabels = ['API Key','패스워드','신용카드','이메일','SSN','전화번호','개인 IP','파일경로'];
      this._plt('d2-sec-out-bar', [{
        x: outLabels, y: outTypes.map(k=>outLeak[k]??0),
        type:'bar', marker:{color:'#ef4444'}, hovertemplate:'%{x}: %{y}건<extra></extra>'
      }], { xaxis:{tickangle:-30}, yaxis:{title:'탐지 건수'} });

      /* --- Tasks: TCR by type --- */
      this._plt('d2-ts-type-tcr', [{
        x: ttypes, y: tcrByType, type:'bar',
        marker:{color:'#6366f1'}, hovertemplate:'%{x}: %{y:.1%}<extra></extra>'
      }], { yaxis:{tickformat:'.0%',range:[0,1]} });

      const scatterT = tasks.filter(t=>t.completion_score!=null&&t.execution_time!=null);
      this._plt('d2-ts-scatter', [{
        x: scatterT.map(t=>t.execution_time), y: scatterT.map(t=>t.completion_score),
        mode:'markers', type:'scatter',
        marker:{color:scatterT.map(t=>t.success?'#10b981':'#ef4444'), size:6},
        hovertemplate:'%{customdata}<br>지연: %{x:.2f}s | 완료율: %{y:.2f}<extra></extra>',
        customdata: scatterT.map(t=>t.task_id||'?')
      }], { xaxis:{title:'지연(s)'}, yaxis:{title:'완료율',range:[0,1]} });
    },
    // ── Recommendation helpers ─────────────────────────────────────────────
    recTitle(r) {
      // r.title / r.message 가 객체이면 [object Object] 방지
      const str = v => (v && typeof v === 'string') ? v : null;
      return str(r.title) || str(r.message)
          || (typeof r === 'string' ? r : null)
          || str(r.issue)
          || '(항목)';
    },
    recIssue(r) {
      const str = v => (v && typeof v === 'string') ? v : null;
      // title이 객체여서 issue로 대체된 경우 중복 방지
      const title = str(r.title) || str(r.message);
      if (!title) return null; // issue가 이미 제목으로 사용됨
      return str(r.issue) || str(r.detail) || null;
    },
    // ── Markdown → HTML ────────────────────────────────────────────────────
    md2html(s) {
      if (!s) return '';
      s = s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
      s = s.replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>');
      s = s.replace(/\*(.+?)\*/g,'<em>$1</em>');
      s = s.replace(/`(.+?)`/g,'<code style="background:var(--bg3);padding:1px 4px;border-radius:3px;font-size:11px">$1</code>');
      // numbered list: 1. 2. 3. …
      s = s.replace(/(?:^|\n)(\d+)\.\s+/g,'\n<br><b>$1.</b>&nbsp;');
      // dash/bullet list: - item
      s = s.replace(/(?:^|\n)-\s+/g,'\n<br>• ');
      // bullet char
      s = s.replace(/•\s*/g,'<br>• ');
      // newlines
      s = s.replace(/\n/g,'<br>');
      s = s.replace(/^(<br>)+/,'');
      return s;
    },
  }; /* end app2() return */
} /* end app2() */
</script>
</body>
</html>
