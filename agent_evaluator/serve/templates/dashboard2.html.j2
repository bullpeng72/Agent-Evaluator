        <div class="kpi-val" style="color:var(--green)" x-text="($root.data.tasks||[]).filter(t=>t.completion_score>=1.0).length"></div>
        <div class="kpi-sub" x-text="$root.pct(($root.data.tasks||[]).filter(t=>t.completion_score>=1.0).length/($root.data.total_tasks||1)*100)"></div>
