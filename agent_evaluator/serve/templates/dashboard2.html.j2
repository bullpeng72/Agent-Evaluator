<!DOCTYPE html>
<html lang="ko" x-data="app2()" x-init="init()" :class="{'dark':dark}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>{{ title }} — Dev Dashboard</title>
{% if offline %}
<script defer src="/static/alpine.min.js"></script>
<script src="/static/plotly.min.js"></script>
{% else %}
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/plotly.js-dist@2.35.2/plotly.min.js"></script>
{% endif %}
<style>
:root{
  --bg:#0f1117;--bg2:#1a1d27;--bg3:#22263a;--border:#2d3148;
  --text:#e2e4f0;--text2:#8890b0;--accent:#6c8ef5;
  --green:#4ade80;--yellow:#facc15;--red:#f87171;--orange:#fb923c;--r:10px;
  --sp-1:4px;--sp-2:8px;--sp-3:12px;--sp-4:16px;--sp-5:24px;--sp-6:32px;
  --fs-xs:11px;--fs-sm:12px;--fs-md:13px;--fs-lg:15px;--fs-xl:22px;--fs-2xl:28px;
  --c-ok:var(--green);--c-warn:var(--yellow);--c-ng:var(--red);--c-info:var(--accent);
}
html:not(.dark){
  --bg:#f4f6fc;--bg2:#fff;--bg3:#eef0f8;--border:#d1d5e8;
  --text:#1a1d2e;--text2:#5a6080;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);font-size:14px}
.layout{display:grid;grid-template-rows:52px 1fr 28px;height:100vh}
.hdr{background:var(--bg2);border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;padding:0 14px;position:sticky;top:0;z-index:100}
.body{display:grid;grid-template-columns:190px 1fr;overflow:hidden}
.side{background:var(--bg2);border-right:1px solid var(--border);overflow-y:auto;padding:8px 0}
.main{overflow-y:auto;padding:16px}
.sbar{background:var(--bg2);border-top:1px solid var(--border);display:flex;align-items:center;gap:12px;padding:0 14px;font-size:13px;color:var(--text2)}
.logo{font-weight:700;font-size:16px;white-space:nowrap}.logo span{color:var(--accent)}
select{background:var(--bg3);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:3px 7px;font-size:13px;max-width:240px}
.btn{background:var(--bg3);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:4px 9px;font-size:13px;cursor:pointer;white-space:nowrap;text-decoration:none;display:inline-flex;align-items:center;gap:4px}
.btn:hover,.btn.active{background:var(--accent);color:#fff;border-color:var(--accent)}
.sp{flex:1}
.dot{width:7px;height:7px;border-radius:50%;background:var(--green);display:inline-block}
.dot.off{background:var(--text2)}.dot.live{animation:pulse 1.5s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
.nav{display:flex;align-items:center;gap:7px;padding:7px 13px;cursor:pointer;font-size:13px;color:var(--text2);border-left:3px solid transparent}
.nav:hover,.nav.on{background:var(--bg3);color:var(--text);border-left-color:var(--accent)}
.nav-badge{margin-left:auto;background:var(--bg);border-radius:99px;font-size:11px;padding:1px 5px;color:var(--text2)}
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-bottom:14px}
.kpi{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:12px 14px;transition:border-color .15s,background .15s}
.kpi:hover{border-color:var(--accent)}
.kpi.sel{border-color:var(--accent);background:var(--bg3)}
.kpi-act{cursor:pointer;border-left:3px solid var(--accent);padding-left:12px}
.kpi-act::after{content:'▾ 상세';display:block;font-size:10px;color:var(--accent);text-align:right;margin-top:4px;opacity:.45;transition:opacity .15s}
.kpi-act:hover::after,.kpi-act.sel::after{opacity:1}
.kpi-lbl{font-size:12px;color:var(--text2);text-transform:uppercase;letter-spacing:.04em}
.kpi-val{font-size:26px;font-weight:800;margin:3px 0}
.kpi-sub{font-size:12px}.kpi-sub.ok{color:var(--green)}.kpi-sub.warn{color:var(--yellow)}
.dgate{display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap}
.dgate-box{flex:1;min-width:150px;background:var(--bg2);border:2px solid var(--border);border-radius:var(--r);padding:12px;transition:border-color .15s}
.dgate-box.pass{border-color:var(--green)}.dgate-box.partial{border-color:var(--yellow)}.dgate-box.fail{border-color:var(--red)}
.dgate-title{font-size:14px;font-weight:700;margin-bottom:6px;display:flex;align-items:center;justify-content:space-between}
.dgate-badge{font-size:12px;padding:1px 6px;border-radius:99px;font-weight:600}
.dgate-box.pass .dgate-badge{background:#4ade8022;color:var(--green)}.dgate-box.partial .dgate-badge{background:#facc1522;color:var(--yellow)}.dgate-box.fail .dgate-badge{background:#f8717122;color:var(--red)}
.dgate-row{font-size:12px;color:var(--text2);display:flex;align-items:center;gap:5px;padding:2px 0}
.dgate-row .dv{margin-left:auto;font-size:11px;opacity:.7}
.sec{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:14px;margin-bottom:12px}
.sec-t{font-size:15px;font-weight:600;margin-bottom:10px;display:flex;align-items:center;gap:6px}
.cg{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.cg3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
.cg4{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:10px}
.cg>*,.cg3>*,.cg4>*{min-width:0;overflow:hidden}
.cbox{background:var(--bg3);border-radius:8px;padding:10px;overflow:hidden;min-width:0}
.plt-chart{height:200px;min-width:0;width:100%}
.ct{font-size:13px;color:var(--text2);margin-bottom:6px}
.alert{border-radius:8px;padding:10px 12px;margin-bottom:8px;border-left:3px solid;display:flex;align-items:center;justify-content:space-between;gap:10px}
.alert.critical{background:rgba(248,113,113,.1);border-color:var(--red)}
.alert.high{background:rgba(251,146,60,.1);border-color:var(--orange)}
.alert.medium{background:rgba(250,204,21,.1);border-color:var(--yellow)}
.alert.low{background:rgba(74,222,128,.1);border-color:var(--green)}
.alert-body{flex:1;min-width:0}
.alert-t{font-size:14px;font-weight:600;margin-bottom:3px}
.alert-b{font-size:13px;color:var(--text2)}
.alert-link{font-size:11px;color:var(--accent);white-space:nowrap;opacity:.8}
.alert.clickable{cursor:pointer;transition:opacity .15s}
.alert.clickable:hover{opacity:.8}
.alert.clickable:hover .alert-link{opacity:1;text-decoration:underline}
.rec{background:var(--bg3);border-radius:8px;padding:10px 12px;margin-bottom:8px}
.rec-t{font-size:14px;font-weight:600;margin-bottom:4px}
.rec-b{font-size:13px;color:var(--text2)}
.drow{display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid var(--border);font-size:14px}
.drow:last-child{border-bottom:none}
.dk{color:var(--text2)}
.slist{max-height:300px;overflow-y:auto}
.es{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:var(--sp-6);color:var(--text2);text-align:center;gap:var(--sp-2)}
.es-icon{font-size:28px}.es-title{font-size:var(--fs-md);font-weight:600}
.es-desc{font-size:var(--fs-sm)}.es-desc code{background:var(--bg3);padding:1px 5px;border-radius:4px;font-size:var(--fs-xs)}
.dtx{border:1px solid var(--border);border-radius:var(--r);overflow:hidden;font-size:var(--fs-sm)}
.dtx-row{display:grid;gap:0 8px;padding:5px var(--sp-3);border-bottom:1px solid var(--border);align-items:center}
.dtx-head{font-weight:600;color:var(--text2);background:var(--bg3);font-size:var(--fs-xs);text-transform:uppercase;letter-spacing:.05em}
.dtx-row:not(.dtx-head):hover{background:var(--bg3)}
.dtx-id{font-family:monospace;font-size:var(--fs-xs);color:var(--accent);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dtx-empty{padding:var(--sp-5);text-align:center;color:var(--text2);font-size:var(--fs-sm)}
.badge-ok{background:rgba(74,222,128,.12);color:var(--green);border-radius:99px;font-size:var(--fs-xs);font-weight:600;padding:1px 7px;display:inline-block}
.badge-warn{background:rgba(250,204,21,.12);color:var(--yellow);border-radius:99px;font-size:var(--fs-xs);font-weight:600;padding:1px 7px;display:inline-block}
.badge-ng{background:rgba(248,113,113,.12);color:var(--red);border-radius:99px;font-size:var(--fs-xs);font-weight:600;padding:1px 7px;display:inline-block}
.badge-info{background:rgba(108,142,245,.12);color:var(--accent);border-radius:99px;font-size:var(--fs-xs);font-weight:600;padding:1px 7px;display:inline-block}
.badge-gray{background:var(--bg3);color:var(--text2);border-radius:99px;font-size:var(--fs-xs);padding:1px 7px;display:inline-block}
.pill{display:inline-flex;align-items:center;gap:3px;font-size:var(--fs-xs);border-radius:99px;padding:2px 7px;font-weight:600}
.pg{background:rgba(74,222,128,.12);color:var(--green);border-radius:99px;font-size:var(--fs-xs);font-weight:600;padding:1px 7px;display:inline-flex;align-items:center;gap:3px}
.py{background:rgba(250,204,21,.12);color:var(--yellow);border-radius:99px;font-size:var(--fs-xs);font-weight:600;padding:1px 7px;display:inline-flex;align-items:center;gap:3px}
.pr{background:rgba(248,113,113,.12);color:var(--red);border-radius:99px;font-size:var(--fs-xs);font-weight:600;padding:1px 7px;display:inline-flex;align-items:center;gap:3px}
.rg{margin:8px 0}
.rgt{background:var(--bg3);border-radius:99px;height:14px;overflow:hidden;margin-bottom:3px}
.rgf{height:100%;border-radius:99px;transition:width .4s}
.pscore-bar{height:6px;border-radius:3px;background:var(--bg3);overflow:hidden;min-width:80px}
.pscore-fill{height:100%;border-radius:3px;background:var(--yellow);transition:width .3s}
.pscore-fill.strong{background:var(--green)}.pscore-fill.weak{background:var(--orange)}
.nav-grp{font-size:10px;font-weight:700;color:var(--text2);letter-spacing:.07em;padding:10px 13px 3px;text-transform:uppercase;user-select:none;display:flex;align-items:center;gap:6px}
.nav-grp::after{content:'';flex:1;height:1px;background:var(--border);margin-left:4px}
.sdiv{display:flex;align-items:center;gap:10px;margin:20px 0 14px;user-select:none}
.sdiv-line{flex:1;height:1px;background:var(--border)}
.sdiv-lbl{font-size:11px;font-weight:700;color:var(--text2);white-space:nowrap;letter-spacing:.06em;background:var(--bg3);border:1px solid var(--border);border-radius:99px;padding:2px 10px}
.fbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:10px}
.fbar label{font-size:13px;color:var(--text2)}
input[type=text],input[type=number]{background:var(--bg3);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:3px 7px;font-size:13px}
.dt-card{width:100%;border-collapse:collapse;font-size:13px}
.dt-card thead tr{background:var(--bg3);color:var(--text2);font-weight:600}
.dt-card th,.dt-card td{padding:6px 10px;border-bottom:1px solid var(--border);text-align:left}
.dt-card th:not(:first-child),.dt-card td:not(:first-child){text-align:right}
[x-cloak]{display:none!important}
@media(max-width:768px){.body{grid-template-columns:1fr}.side{display:none}.cg,.cg3,.cg4{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="layout">

<!-- HEADER -->
<header class="hdr">
  <div class="logo">🤖 <span>Agent</span> Evaluator <span style="font-size:11px;color:var(--text2);font-weight:400;margin-left:4px">Dev</span></div>
  <select x-model="selId" @change="loadFile(selId)" style="flex:0 1 260px">
    <option value="">— 파일 선택 —</option>
    <template x-for="f in files" :key="f.id">
      <option :value="f.id" x-text="`${f.name.substring(0,36)} (${f.total_tasks}t)`"></option>
    </template>
  </select>
  <button class="btn" @click="refresh()" title="새로고침">🔄</button>
  <button class="btn" @click="window.open('/slides'+(selId?'?id='+selId:''),'_blank')" title="프레젠테이션 슬라이드 열기">📊 Slide</button>
  <a class="btn" href="/api/docs" target="_blank">API</a>
  <a class="btn" href="/sdk-docs" target="_blank">SDK</a>
  <div class="sp"></div>
  {% if watch %}<span style="font-size:11px;color:var(--green);background:rgba(74,222,128,.1);padding:2px 8px;border-radius:99px;border:1px solid rgba(74,222,128,.3)">⚡ watch</span>{% endif %}
  <span class="dot" :class="{'live':connected,'off':!connected}"></span>
  <span x-text="connected?'Live':'Offline'" style="font-size:13px;color:var(--text2)"></span>
  <button class="btn" @click="dark=!dark" x-text="dark?'☀️':'🌙'"></button>
</header>

<!-- BODY -->
<div class="body">

<!-- Sidebar -->
<nav class="side">
  <template x-for="n in nav" :key="n.id">
    <div>
      <div x-show="n.group" class="nav-grp" x-text="n.label"></div>
      <div x-show="!n.group" class="nav" :class="{on:sec===n.id}" @click="!n.group&&(sec=n.id)">
        <span x-text="n.icon"></span>
        <span x-text="n.label" style="flex:1;font-size:13px"></span>
        <span class="nav-badge" x-show="data && n.badge" x-text="data && n.badge ? n.badge(data) : ''"></span>
      </div>
    </div>
  </template>
</nav>

<!-- Main -->
<main class="main">

<div x-show="!data && !loading" class="es">
  <div class="es-icon">📂</div>
  <div class="es-title">결과 파일을 선택하세요</div>
  <div class="es-desc" x-show="files.length===0" style="color:var(--red)">⚠️ 결과 디렉토리에 JSON 파일이 없습니다.</div>
  <div class="es-desc" x-show="files.length>0">상단 드롭다운에서 평가 결과 파일을 선택하세요.</div>
</div>
<div x-show="loading" class="es"><p>로딩 중…</p></div>

<!-- ══ SECTION 1: OVERVIEW ══ -->
<div x-show="data && sec==='overview'" x-cloak>

  <div x-data="{
    selK:null,
    /* ── local helpers: data is inherited from parent app2() scope ── */
    _tcr(){const t=data.tasks||[],n=t.length||1;const raw=data.accuracy_metrics?.tcr?.tcr??null;return raw!=null?raw:t.reduce((s,x)=>s+(x.completion_score||0),0)/n*100;},
    _acc(){const t=data.tasks||[],n=t.length||1;const raw=data.accuracy_metrics?.accuracy_scores?.overall_accuracy??null;return raw!=null?raw:t.reduce((s,x)=>s+(x.accuracy_score||0),0)/n*100;},
    _hall(){const dets=data.hallucination_detail?.detections||[];if(dets.length>0){const fl=dets.filter(x=>(x.hallucination_rate||0)>0).length;return(fl/dets.length)*100;}const am=data.accuracy_metrics?.hallucination||{};const raw=am.overall_rate??null;if(raw!=null)return raw;const ev=am.total_evaluated||0,fl=am.total_flagged||0;return ev>0?(fl/ev)*100:0;},
    _p95(){const em=data.efficiency_metrics||{};return em.latency?.p95??em.p95_latency??0;},
    _cost(){ return cTotal(data); },
    _pct(v){return v==null?0:Math.min(100,Math.max(0,v));},
    _col(v,hi,lo){return v>=hi?'var(--green)':v>=lo?'var(--yellow)':'var(--red)';},
    _colLat(v){return v<=2?'var(--green)':v<=5?'var(--yellow)':'var(--red)';},
    _fmtCost(v){return v==null?'—':'$'+Number(v).toFixed(4);},
    _fmtSec(v){return v==null?'—':Number(v).toFixed(2)+'s';},
    meta:{
      total_tasks:{label:'총 태스크',unit:'건',desc:'이번 평가 세션에서 실행된 전체 태스크 수입니다. 데이터셋 규모와 평가 범위를 나타내며, 모든 지표의 모수(분모)로 사용됩니다.',hint:'data.total_tasks'},
      tcr:{label:'TCR',unit:'%',desc:'AI 에이전트가 주어진 태스크를 얼마나 성공적으로 완료했는지를 나타내는 핵심 성능 지표입니다. 높을수록 안정적인 완료 능력을 의미하며, 프로덕션 배포 가능 여부를 판단하는 1차 기준입니다.',hint:'Σ completion_score / total × 100'},
      accuracy:{label:'정확도',unit:'%',desc:'에이전트 응답이 정답(ground truth)과 얼마나 일치하는지를 나타내는 사실적 정확성 지표입니다. QA·정보 검색·문서 생성 태스크에서 응답 품질을 객관적으로 평가하는 데 사용됩니다.',hint:'avg(accuracy_score) × 100'},
      hallucination:{label:'환각률',unit:'%',desc:'에이전트가 사실이 아니거나 근거 없는 정보를 생성하는 빈도를 측정하는 신뢰성 지표입니다. 낮을수록 신뢰할 수 있는 응답을 의미하며, 프로덕션 배포 전 반드시 낮게 유지해야 합니다.',hint:'avg(per-task hallucination_rate) × 100'},
      p95_latency:{label:'P95 지연',unit:'s',desc:'전체 요청의 95%가 완료되는 시간으로, SLA(서비스 수준 협약) 설계와 성능 병목 탐지에 가장 널리 사용됩니다. 단순 평균보다 실제 사용자 경험을 더 잘 반영합니다.',hint:'efficiency_metrics.latency.p95'},
      total_cost:{label:'총 비용',unit:'$',desc:'이번 평가에서 소비된 LLM API 호출의 추정 비용입니다. 운영 예산 계획과 모델별 비용-성능 트레이드오프 분석에 활용되며, 토큰 사용 효율성을 간접적으로 나타냅니다.',hint:'efficiency_metrics.tokens.total_cost'},
    },
    formula(k,d){
      const t=d.tasks||[],n=t.length||1;
      if(k==='total_tasks'){const ok=t.filter(b=>b.success).length;return `총 태스크 = ${d.total_tasks||0}건\n성공 ${ok}건 / 실패 ${n-ok}건`;}
      if(k==='tcr'){const s=t.reduce((a,b)=>a+(b.completion_score||0),0);const full=t.filter(b=>(b.completion_score||0)>=1).length;const partial=t.filter(b=>(b.completion_score||0)>=0.7&&(b.completion_score||0)<1).length;const fail=t.filter(b=>(b.completion_score||0)<0.7).length;return `TCR = Σ completion_score / total\n= ${s.toFixed(2)} / ${n} = ${(s/n*100).toFixed(1)}%\n완전 성공 ${full}건 / 부분 성공(0.7~1.0) ${partial}건 / 실패(<0.7) ${fail}건`;}
      if(k==='accuracy'){const s=t.reduce((a,b)=>a+(b.accuracy_score||0),0);return `Accuracy = avg(accuracy_score) × 100\n= ${s.toFixed(3)} / ${n} × 100 = ${(s/n*100).toFixed(1)}%`;}
      if(k==='hallucination'){const rate=d.accuracy_metrics?.hallucination?.overall_rate||0;const dets=d.hallucination_detail?.detections||[];const allU=new Set(dets.map(x=>x.task_id)).size;const flagU=new Set(dets.filter(x=>x.hallucination_rate>0).map(x=>x.task_id)).size;return `환각률 = avg(per-task hallucination_rate) × 100\n= ${rate.toFixed(1)}%\n탐지 태스크: ${flagU} / ${allU}건 (rate > 0)\n정상(미탐지): ${allU-flagU}건`;}
      if(k==='p95_latency'){const em=d.efficiency_metrics||{};const p95=em.latency?.p95||em.p95_latency||0;const p50=em.latency?.p50||0;const avg=em.latency?.mean||em.avg_latency||0;return `P95 = ${p95.toFixed(3)}s\nP50(중앙값) = ${p50.toFixed(3)}s\navg(평균) = ${avg.toFixed(3)}s`;}
      if(k==='total_cost'){const cost=cTotal(d);const toks=d.efficiency_metrics?.tokens?.total_tokens||0;const src=selModel?`적용 모델: ${selModel.model.split('/')[0].trim()}`:'JSON 저장값';return `${src}\n총비용 = $${cost.toFixed(4)}\n태스크당 = $${(cost/(d.total_tasks||1)).toFixed(5)}\n총 토큰 = ${toks.toLocaleString()}`;}
      return '';
    },
    items(k,d){
      const t=d.tasks||[];
      if(k==='total_tasks')return [...t].sort((a,b)=>(a.completion_score||0)-(b.completion_score||0));
      if(k==='tcr')return [...t].sort((a,b)=>(a.completion_score||0)-(b.completion_score||0));
      if(k==='accuracy')return [...t].sort((a,b)=>(a.accuracy_score||0)-(b.accuracy_score||0));
      if(k==='hallucination'){const dm={};(d.hallucination_detail?.detections||[]).filter(x=>x.hallucination_rate>0).forEach(x=>{dm[x.task_id]={hr:x.hallucination_rate,hc:(x.indicators||[]).length,sc:x.response_sentences||0};});return [...t].filter(x=>dm[x.task_id]).sort((a,b)=>(dm[b.task_id]?.hr||0)-(dm[a.task_id]?.hr||0)).map(x=>({...x,_hr:dm[x.task_id]?.hr||0,_hc:dm[x.task_id]?.hc||0,_sc:dm[x.task_id]?.sc||0}));}
      if(k==='p95_latency')return [...t].sort((a,b)=>(b.execution_time||0)-(a.execution_time||0)).slice(0,20);
      if(k==='total_cost')return [...t].sort((a,b)=>(b.tokens_used?.total||b.tokens_used||0)-(a.tokens_used?.total||a.tokens_used||0)).slice(0,20);
      return t;
    },
    col3Label(k){return {accuracy:'정확도',hallucination:'환각률',p95_latency:'응답시간',total_cost:'토큰 수'}[k]||'완료율';},
    col3Val(k,t){
      if(k==='accuracy')return ((t.accuracy_score||0)*100).toFixed(1)+'%';
      if(k==='hallucination'){const sc=t._sc>0?' /'+t._sc+'문':'';return ((t._hr||0)*100).toFixed(0)+'%'+sc;}
      if(k==='p95_latency')return (t.execution_time||0).toFixed(2)+'s';
      if(k==='total_cost')return (t.tokens_used?.total||t.tokens_used||0).toLocaleString();
      return ((t.completion_score||0)*100).toFixed(0)+'%';
    },
    col3Color(k,t){
      if(k==='accuracy')return _col((t.accuracy_score||0)*100,90,70);
      if(k==='hallucination')return (t._hr||0)>=0.5?'var(--red)':(t._hr||0)>=0.1?'var(--yellow)':'var(--green)';
      if(k==='p95_latency')return _colLat(t.execution_time||0);
      if(k==='total_cost')return 'var(--text2)';
      return (t.completion_score||0)>=1?'var(--green)':(t.completion_score||0)>=0.7?'var(--yellow)':'var(--red)';
    },
    filterLabel(k){return {total_tasks:'완료율 낮은 순',tcr:'완료율 낮은 순',accuracy:'정확도 낮은 순',hallucination:'환각률 높은 순',p95_latency:'느린 태스크 Top20',total_cost:'토큰 많은 태스크 Top20'}[k]||'전체';}
  }">
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">📊 핵심 지표</span><div class="sdiv-line"></div></div>
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='total_tasks'}" @click="selK=selK==='total_tasks'?null:'total_tasks'">
        <div class="kpi-lbl">Total Tasks</div>
        <div class="kpi-val" x-text="data.total_tasks||0"></div>
        <div class="kpi-sub" style="color:var(--text2)" x-text="(data.name||'').substring(0,20)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='tcr'}" @click="selK=selK==='tcr'?null:'tcr'">
        <div class="kpi-lbl">TCR</div>
        <div class="kpi-val" :style="`color:${_col(_tcr(),90,70)}`" x-text="_tcr().toFixed(1)+'%'"></div>
        <div class="kpi-sub" :class="_tcr()>=90?'ok':_tcr()>=70?'warn':''">
          <span x-text="_tcr()>=90?'Good':_tcr()>=70?'Fair':'Low'"></span>
        </div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='accuracy'}" @click="selK=selK==='accuracy'?null:'accuracy'">
        <div class="kpi-lbl">Accuracy</div>
        <div class="kpi-val" :style="`color:${_col(_acc(),90,70)}`" x-text="_acc().toFixed(1)+'%'"></div>
        <div class="kpi-sub" :class="_acc()>=90?'ok':_acc()>=70?'warn':''">
          <span x-text="_acc()>=90?'Good':_acc()>=70?'Fair':'Low'"></span>
        </div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='hallucination'}" @click="selK=selK==='hallucination'?null:'hallucination'">
        <div class="kpi-lbl">Hallucination</div>
        <div class="kpi-val" :style="`color:${_hall()===0?'var(--green)':_hall()<=thresholds.hall_max*100?'var(--yellow)':'var(--red)'}`"
             x-text="_hall().toFixed(1)+'%'"></div>
        <div class="kpi-sub" x-text="_hall()===0?'Safe':_hall()<=thresholds.hall_max*100?'Warn':'High'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='p95_latency'}" @click="selK=selK==='p95_latency'?null:'p95_latency'">
        <div class="kpi-lbl">P95 Latency</div>
        <div class="kpi-val" :style="`color:${_colLat(_p95())}`" x-text="_fmtSec(_p95())"></div>
        <div class="kpi-sub" style="color:var(--text2)" x-text="'avg: '+_fmtSec(data.efficiency_metrics?.latency?.mean||data.efficiency_metrics?.avg_latency||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='total_cost'}" @click="selK=selK==='total_cost'?null:'total_cost'">
        <div class="kpi-lbl">Total Cost</div>
        <div class="kpi-val" x-text="_fmtCost(_cost())"></div>
        <div class="kpi-sub" style="color:var(--text2)" x-text="'per task: '+_fmtCost(_cost()/(data.total_tasks||1))"></div>
        <div class="kpi-sub" x-show="selModel" style="color:var(--accent);font-size:10px" x-text="selModel?.model?.split('/')[0]?.trim()||''"></div>
      </div>
    </div>
    <!-- kpi-act detail panel -->
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="meta[selK]?.unit?'단위: '+meta[selK].unit:''"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
              <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <div style="padding:10px 14px;background:var(--bg)">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">관련 태스크</span>
              <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="filterLabel(selK)"></span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,data).length+'건'"></span>
            </div>
            <div class="dtx" style="max-height:220px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:170px minmax(0,1fr) 72px 60px;position:sticky;top:0;z-index:1">
                <span>태스크 ID</span><span>유형</span><span x-text="col3Label(selK)">완료율</span><span>완료 상태</span>
              </div>
              <template x-for="t in items(selK,data)" :key="t.task_id">
                <div class="dtx-row" style="grid-template-columns:170px minmax(0,1fr) 72px 60px">
                  <span class="dtx-id" x-text="t.task_id"></span>
                  <span style="font-size:11px;color:var(--text2)" x-text="t.task_type||'-'"></span>
                  <span :style="`color:${col3Color(selK,t)}`" x-text="col3Val(selK,t)"></span>
                  <span :class="(t.completion_score||0)>=1?'badge-ok':(t.completion_score||0)>=0.7?'badge-warn':'badge-ng'"
                        x-text="(t.completion_score||0)>=1?'완료':(t.completion_score||0)>=0.7?'부분':'실패'"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
  </div>

  <!-- Deploy Gates -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🚀 배포 준비도</span><span style="font-size:11px;color:var(--text2);margin-left:6px">— 환경별 배포 가능 기준 충족 여부</span><div class="sdiv-line"></div></div>
  <div class="dgate">
    <template x-for="g in deployGates()" :key="g.key">
      <div class="dgate-box" :class="g.cls">
        <div class="dgate-title">
          <span x-text="g.label"></span>
          <span class="dgate-badge" x-text="g.cls==='pass'?'PASS':g.cls==='fail'?'FAIL':`${g.passed}/${g.total}`"></span>
        </div>
        <template x-for="c in g.criteria" :key="c.name">
          <div class="dgate-row">
            <span x-text="c.pass?'✅':'❌'"></span>
            <span x-text="c.name"></span>
            <span class="dv" x-text="c.val"></span>
          </div>
        </template>
      </div>
    </template>
  </div>

  <!-- Charts: distribution only (2-col) -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">📈 분포 현황</span><div class="sdiv-line"></div></div>
  <div class="cg" style="margin-bottom:12px">
    <div class="cbox"><div class="ct">성공/실패 분포</div><div id="d2-ov-donut" class="plt-chart"></div></div>
    <div class="cbox"><div class="ct">TaskType별 태스크 수</div><div id="d2-ov-type" class="plt-chart"></div></div>
  </div>

  <!-- Perspective Radar: separate section -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🕸️ 관점별 종합 점수</span><div class="sdiv-line"></div></div>
  <div class="cg" style="margin-bottom:12px;align-items:stretch">
    <div class="cbox" style="display:flex;flex-direction:column">
      <div class="ct" style="flex-shrink:0">에이전트 역량 레이더 <span style="font-size:10px;color:var(--text2)">(6축 재설계 · 완료율·정확품질·운영효율·에이전틱역량·신뢰성·보안)</span></div>
      <div id="d2-ov-persp" style="flex:1;min-height:260px;width:100%"></div>
    </div>
    <div class="cbox" style="display:flex;flex-direction:column;gap:8px">
      <div class="ct">📐 각 축 정규화 기준</div>
      <p style="font-size:11px;color:var(--text2);margin:0;line-height:1.7">
        서로 다른 단위의 지표를 <b style="color:var(--text1)">0–1</b>로 정규화해 한 화면에 비교합니다.
        바깥쪽일수록 좋고, 모든 축이 1.0에 가까울수록 이상적인 에이전트입니다.
      </p>
      <dl style="margin:0;display:flex;flex-direction:column;gap:0">
        <div style="display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px solid var(--border)">
          <span style="width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;margin-top:5px"></span>
          <div>
            <dt style="font-size:12px;font-weight:600;color:var(--text1);display:inline">완료율</dt>
            <dd style="margin:0;font-size:11px;color:var(--text2);line-height:1.5">TCR. <code style="font-size:10px;background:var(--bg3);padding:1px 4px;border-radius:3px">completion_score 평균</code></dd>
          </div>
        </div>
        <div style="display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px solid var(--border)">
          <span style="width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;margin-top:5px"></span>
          <div>
            <dt style="font-size:12px;font-weight:600;color:var(--text1);display:inline">정확·품질</dt>
            <dd style="margin:0;font-size:11px;color:var(--text2);line-height:1.5">정확도·응답품질·환각 통합. <code style="font-size:10px;background:var(--bg3);padding:1px 4px;border-radius:3px">acc×0.4 + qual/5×0.4 + (1−hall)×0.2</code></dd>
          </div>
        </div>
        <div style="display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px solid var(--border)">
          <span style="width:6px;height:6px;border-radius:50%;background:#f59e0b;flex-shrink:0;margin-top:5px"></span>
          <div>
            <dt style="font-size:12px;font-weight:600;color:var(--text1);display:inline">운영 효율</dt>
            <dd style="margin:0;font-size:11px;color:var(--text2);line-height:1.5">속도+비용 통합. <code style="font-size:10px;background:var(--bg3);padding:1px 4px;border-radius:3px">(max(0,1−P95/10s) + max(0,1−비용/$0.05)) ÷ 2</code></dd>
          </div>
        </div>
        <div style="display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px solid var(--border)">
          <span style="width:6px;height:6px;border-radius:50%;background:#8b5cf6;flex-shrink:0;margin-top:5px"></span>
          <div>
            <dt style="font-size:12px;font-weight:600;color:var(--text1);display:inline">에이전틱 역량</dt>
            <span x-show="!data.has_agentic" style="font-size:10px;color:var(--text2)"> — 트래커 미활성화 (N/A)</span>
            <dd style="margin:0;font-size:11px;color:var(--text2);line-height:1.5"><code style="font-size:10px;background:var(--bg3);padding:1px 4px;border-radius:3px">Tool F1×0.5 + 협업성공률×0.25 + 워크플로우성공률×0.25</code></dd>
          </div>
        </div>
        <div style="display:flex;gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px solid var(--border)">
          <span style="width:6px;height:6px;border-radius:50%;background:#10b981;flex-shrink:0;margin-top:5px"></span>
          <div>
            <dt style="font-size:12px;font-weight:600;color:var(--text1);display:inline">신뢰성</dt>
            <dd style="margin:0;font-size:11px;color:var(--text2);line-height:1.5">오류·재시도 안정성. <code style="font-size:10px;background:var(--bg3);padding:1px 4px;border-radius:3px">오류없는태스크비율×0.6 + 재시도없는태스크비율×0.4</code></dd>
          </div>
        </div>
        <div style="display:flex;gap:8px;align-items:baseline;padding:5px 0">
          <span style="width:6px;height:6px;border-radius:50%;background:#ef4444;flex-shrink:0;margin-top:5px"></span>
          <div>
            <dt style="font-size:12px;font-weight:600;color:var(--text1);display:inline">보안</dt>
            <span x-show="!data.has_security" style="font-size:10px;color:var(--text2)"> — 트래커 미활성화 (N/A)</span>
            <dd style="margin:0;font-size:11px;color:var(--text2);line-height:1.5"><code style="font-size:10px;background:var(--bg3);padding:1px 4px;border-radius:3px">avg(입력보안, 1−출력유출, 권한준수)</code></dd>
          </div>
        </div>
      </dl>
    </div>
  </div>

  <!-- Anomalies Summary (aggregated from Insights) -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">⚠️ 이상 징후</span><div class="sdiv-line"></div></div>

  <!-- 이상 없음 -->
  <template x-if="autoAnomalies().length===0 && zScoreAnomalies().length===0 && !(data?.insights?.alerts?.length) && !(data?.insights?.recommendations?.length)">
    <div class="alert low">
      <div class="alert-body">
        <div class="alert-t">✅ 이상 없음</div>
        <div class="alert-b">모든 핵심 지표가 기준치 이내입니다.</div>
      </div>
    </div>
  </template>

  <!-- 카운트 요약 배지 -->
  <template x-if="autoAnomalies().length>0 || zScoreAnomalies().length>0 || (data?.insights?.alerts?.length) || (data?.insights?.recommendations?.length)">
    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px">
      <template x-if="autoAnomalies().length>0">
        <span class="badge-ng" style="cursor:pointer" @click="sec='insights'" x-text="'임계값 ' + autoAnomalies().length + '건'"></span>
      </template>
      <template x-if="zScoreAnomalies().length>0">
        <span class="badge-warn" style="cursor:pointer" @click="sec='insights'" x-text="'통계적 이상 ' + zScoreAnomalies().length + '건'"></span>
      </template>
      <template x-if="data?.insights?.alerts?.length">
        <span class="badge-info" style="cursor:pointer" @click="sec='insights'" x-text="'서버 알림 ' + data.insights.alerts.length + '건'"></span>
      </template>
      <template x-if="data?.insights?.recommendations?.length">
        <span class="badge-gray" style="cursor:pointer" @click="sec='insights'" x-text="'권고사항 ' + data.insights.recommendations.length + '건'"></span>
      </template>
    </div>
  </template>

  <!-- ① 임계값 기반 이상 (최대 3건) -->
  <template x-for="(a, i) in autoAnomalies().slice(0,3)" :key="'ta'+i">
    <div class="alert clickable" :class="a.level" @click="sec='insights'">
      <div class="alert-body">
        <div style="display:flex;align-items:center;gap:5px;margin-bottom:2px">
          <span style="font-size:10px;color:var(--text2)">임계값</span>
          <span class="alert-t" x-text="a.metric"></span>
        </div>
        <div class="alert-b" x-text="a.detail"></div>
      </div>
      <span class="alert-link">인사이트 →</span>
    </div>
  </template>
  <template x-if="autoAnomalies().length > 3">
    <div style="font-size:11px;color:var(--text2);padding:0 0 6px 4px;cursor:pointer" @click="sec='insights'"
         x-text="'… 외 ' + (autoAnomalies().length - 3) + '건 더'"></div>
  </template>

  <!-- ② Z-Score 통계 이상 (최대 3건) -->
  <template x-if="zScoreAnomalies().length > 0">
    <div>
      <template x-for="(z, i) in zScoreAnomalies().slice(0,3)" :key="'zs'+i">
        <div class="alert clickable medium" @click="sec='insights'">
          <div class="alert-body">
            <div style="display:flex;align-items:center;gap:5px;margin-bottom:2px">
              <span style="font-size:10px;color:var(--text2)">통계적 이상</span>
              <span class="alert-t" x-text="z.task_id"></span>
            </div>
            <div class="alert-b">
              <span x-show="z.zLat!=null && Math.abs(z.zLat)>2" x-text="'지연 z='+((z.zLat||0).toFixed(1))+'σ ('+((z.lat||0).toFixed(2))+'s)'"></span>
              <span x-show="z.zLat!=null&&Math.abs(z.zLat)>2&&z.zAcc!=null&&Math.abs(z.zAcc)>2"> · </span>
              <span x-show="z.zAcc!=null && Math.abs(z.zAcc)>2" x-text="'정확도 z='+((z.zAcc||0).toFixed(1))+'σ ('+(((z.acc||0)*100).toFixed(1))+'%)'"></span>
            </div>
          </div>
          <span class="alert-link">인사이트 →</span>
        </div>
      </template>
      <template x-if="zScoreAnomalies().length > 3">
        <div style="font-size:11px;color:var(--text2);padding:0 0 6px 4px;cursor:pointer" @click="sec='insights'"
             x-text="'… 외 ' + (zScoreAnomalies().length - 3) + '건 더'"></div>
      </template>
    </div>
  </template>

  <!-- ③ 서버 알림 (최대 2건) -->
  <template x-if="data?.insights?.alerts?.length">
    <div>
      <template x-for="(al, i) in (data.insights.alerts||[]).slice(0,2)" :key="'al'+i">
        <div class="alert clickable" :class="al.level==='error'?'critical':al.level==='warn'?'medium':'low'" @click="sec='insights'">
          <div class="alert-body">
            <div style="display:flex;align-items:center;gap:5px;margin-bottom:2px">
              <span style="font-size:10px;color:var(--text2)">서버 알림</span>
              <span :class="al.level==='error'?'badge-ng':al.level==='warn'?'badge-warn':'badge-info'" x-text="al.level||'info'"></span>
            </div>
            <div class="alert-b" x-text="al.message||al"></div>
          </div>
          <span class="alert-link">인사이트 →</span>
        </div>
      </template>
    </div>
  </template>

  <!-- ④ 권고사항 상위 2건 -->
  <template x-if="data?.insights?.recommendations?.length">
    <div>
      <template x-for="(r, i) in (data.insights.recommendations||[]).slice(0,2)" :key="'rc'+i">
        <div class="rec" style="cursor:pointer" @click="sec='insights'">
          <div class="rec-t" style="display:flex;align-items:center;gap:6px">
            <span style="font-size:10px;color:var(--text2)">권고</span>
            <span :class="(r.priority||r.level)==='high'?'badge-ng':(r.priority||r.level)==='medium'?'badge-warn':'badge-info'"
                  x-text="((r.priority||r.level||'low')).toUpperCase()"></span>
            <span style="font-size:12px" x-text="r.title||r.message||r"></span>
          </div>
          <div class="rec-b" x-text="r.detail||''"></div>
        </div>
      </template>
      <template x-if="(data.insights.recommendations||[]).length > 2">
        <div style="font-size:11px;color:var(--text2);padding:2px 0 4px 4px;cursor:pointer" @click="sec='insights'"
             x-text="'… 외 ' + ((data.insights.recommendations||[]).length - 2) + '건 더'"></div>
      </template>
    </div>
  </template>

  <!-- 전체 보기 -->
  <template x-if="autoAnomalies().length>0 || zScoreAnomalies().length>0 || (data?.insights?.alerts?.length) || (data?.insights?.recommendations?.length)">
    <div style="text-align:right;margin-top:6px">
      <button class="btn" @click="sec='insights'" style="font-size:11px">인사이트에서 전체 보기 →</button>
    </div>
  </template>

</div><!-- /overview -->

<!-- ══ SECTION 2: QUALITY ══ -->
<div x-show="data && sec==='quality'" x-cloak>

  <!-- TCR subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">✅ 태스크 완료율 (TCR)</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    expandedId:null,
    meta:{
      tcr:{label:'TCR',unit:'%',desc:'완전 성공과 부분 성공을 completion_score로 가중 합산한 에이전트의 전체 완료 능력입니다. 단순 성공/실패 이분법 대신 부분 완료를 인정해 보다 현실적인 성능을 측정합니다.',hint:'Σ completion_score / total × 100'},
      full_success:{label:'완전 성공',unit:'건',desc:'요청한 모든 요건을 충족하여 완벽하게 완료된 태스크입니다. 높을수록 에이전트의 안정적인 완전 수행 능력을 나타냅니다.',hint:'score ≥ 1.0'},
      partial_success:{label:'부분 성공',unit:'건',desc:'핵심 요건은 충족했지만 일부 세부 조건을 놓친 태스크입니다. 에이전트가 방향은 올바르게 이해했으나 정밀도가 부족한 경우로, 개선 여지를 파악하는 데 중요한 범주입니다.',hint:'0.7 ≤ score < 1.0'},
      failures:{label:'실패',unit:'건',desc:'기준 완료율을 충족하지 못한 태스크입니다. 실패 태스크의 유형과 패턴을 분석하면 에이전트의 약점과 개선이 필요한 태스크 유형을 식별할 수 있습니다.',hint:'score < 0.7'},
    },
    formula(k,d){
      const t=d.tasks||[],n=t.length||1;
      const fs=t.filter(x=>x.completion_score>=1.0).length;
      const ps=t.filter(x=>x.completion_score>=0.7&&x.completion_score<1.0).length;
      const fl=t.filter(x=>x.completion_score<0.7).length;
      const ws=t.reduce((a,b)=>a+(b.completion_score||0),0);
      if(k==='tcr')return `TCR = Σ completion_score / total\n= ${ws.toFixed(2)} / ${n} = ${(ws/n*100).toFixed(1)}%`;
      if(k==='full_success')return `완전 성공 = score ≥ 1.0\n${fs}건 / ${n}건 = ${(fs/n*100).toFixed(1)}%`;
      if(k==='partial_success')return `부분 성공 = 0.7 ≤ score < 1.0\n${ps}건 / ${n}건 = ${(ps/n*100).toFixed(1)}%`;
      if(k==='failures')return `실패 = score < 0.7\n${fl}건 / ${n}건 = ${(fl/n*100).toFixed(1)}%`;
      return '';
    },
    items(k,d){
      const t=d.tasks||[];
      if(k==='full_success')return t.filter(x=>x.completion_score>=1.0);
      if(k==='partial_success')return t.filter(x=>x.completion_score>=0.7&&x.completion_score<1.0);
      if(k==='failures')return t.filter(x=>x.completion_score<0.7);
      return t;
    },
    filterLabel(k){return {full_success:'score≥1.0',partial_success:'0.7≤score<1.0',failures:'score<0.7',tcr:'전체'}[k]||'전체';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='tcr'}" @click="selK=selK==='tcr'?null:'tcr'">
        <div class="kpi-lbl">TCR</div>
        <div class="kpi-val" :style="`color:${_bc(_tcrG(data),thresholds.tcr_min*100,Math.max(0,thresholds.tcr_min*100-20))}`" x-text="_tcrG(data).toFixed(1)+'%'"></div>
        <div class="kpi-sub" x-text="(()=>{const t=data.tasks||[];const fs=t.filter(x=>x.completion_score>=1.0).length;const ps=t.filter(x=>x.completion_score>=0.7&&x.completion_score<1.0).length;return `완전${fs}+부분${ps} / ${t.length}`;})()"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='full_success'}" @click="selK=selK==='full_success'?null:'full_success'">
        <div class="kpi-lbl">완전 성공</div>
        <div class="kpi-val" style="color:var(--green)" x-text="(data.tasks||[]).filter(t=>t.completion_score>=1.0).length"></div>
        <div class="kpi-sub" x-text="((data.tasks||[]).filter(t=>t.completion_score>=1.0).length/(data.total_tasks||1)*100).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='partial_success'}" @click="selK=selK==='partial_success'?null:'partial_success'">
        <div class="kpi-lbl">부분 성공</div>
        <div class="kpi-val" style="color:var(--yellow)" x-text="(data.tasks||[]).filter(t=>t.completion_score>=0.7&&t.completion_score<1.0).length"></div>
        <div class="kpi-sub" x-text="((data.tasks||[]).filter(t=>t.completion_score>=0.7&&t.completion_score<1.0).length/(data.total_tasks||1)*100).toFixed(1)+'%'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='failures'}" @click="selK=selK==='failures'?null:'failures'">
        <div class="kpi-lbl">실패</div>
        <div class="kpi-val" style="color:var(--red)" x-text="(data.tasks||[]).filter(t=>t.completion_score<0.7).length"></div>
        <div class="kpi-sub" x-text="((data.tasks||[]).filter(t=>t.completion_score<0.7).length/(data.total_tasks||1)*100).toFixed(1)+'%'"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <!-- Panel header -->
          <div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <span style="font-size:12px;color:var(--text2);background:var(--bg3);padding:1px 8px;border-radius:99px"
                  x-text="items(selK,data).length+'건'"></span>
            <!-- 부분 성공: 재시도 미달 배지 -->
            <template x-if="selK==='partial_success'">
              <span style="display:flex;gap:6px;flex-wrap:wrap">
                <span x-show="items(selK,data).filter(t=>(t.attempts||1)>1).length>0"
                      style="font-size:11px;background:rgba(245,158,11,.15);color:var(--yellow);padding:1px 8px;border-radius:99px;border:1px solid rgba(245,158,11,.3)"
                      x-text="'⚠ 재시도 후 미달 '+items(selK,data).filter(t=>(t.attempts||1)>1).length+'건'"></span>
                <span style="font-size:11px;background:rgba(239,68,68,.1);color:var(--red);padding:1px 8px;border-radius:99px;border:1px solid rgba(239,68,68,.25)"
                      x-text="'약한(70~84%): '+items(selK,data).filter(t=>(t.completion_score||0)<0.85&&(t.completion_score||0)>=0.7).length+'건'"></span>
                <span style="font-size:11px;background:rgba(245,158,11,.15);color:var(--yellow);padding:1px 8px;border-radius:99px;border:1px solid rgba(245,158,11,.3)"
                      x-text="'강한(85~99%): '+items(selK,data).filter(t=>(t.completion_score||0)>=0.85).length+'건'"></span>
              </span>
            </template>
            <!-- 실패: 오류 있는 태스크 배지 -->
            <template x-if="selK==='failures'">
              <span x-show="items(selK,data).filter(t=>t.errors&&t.errors.length).length>0"
                    style="font-size:11px;background:rgba(239,68,68,.1);color:var(--red);padding:1px 8px;border-radius:99px;border:1px solid rgba(239,68,68,.25)"
                    x-text="'오류 '+items(selK,data).filter(t=>t.errors&&t.errors.length).length+'건'"></span>
            </template>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null;expandedId=null">×</button>
          </div>
          <!-- 설명 + 산출방식 -->
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
              <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <!-- Task table -->
          <div style="padding:10px 14px;background:var(--bg)">
            <div class="dtx" style="max-height:360px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:minmax(120px,1fr) 90px 72px 40px 60px 52px;position:sticky;top:0;z-index:1">
                <span>태스크 ID</span><span>유형</span><span>완료율</span><span>시도</span><span>정확도</span><span></span>
              </div>
              <template x-for="(t,ti) in items(selK,data)" :key="t.task_id||ti">
                <div>
                  <!-- Main row -->
                  <div class="dtx-row"
                       :style="`grid-template-columns:minmax(120px,1fr) 90px 72px 40px 60px 52px;${expandedId===t.task_id?'background:rgba(99,102,241,.07);border-left:2px solid var(--accent)':''}`">
                    <span class="dtx-id" style="font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="t.task_id"></span>
                    <span style="font-size:11px;color:var(--text2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap" x-text="t.task_type||'—'"></span>
                    <span>
                      <div style="display:flex;align-items:center;gap:4px">
                        <div style="flex:1;height:4px;background:var(--bg3);border-radius:2px;overflow:hidden">
                          <div :style="`width:${Math.min(100,(t.completion_score||0)*100).toFixed(0)}%;height:100%;background:${(t.completion_score||0)>=1?'var(--green)':(t.completion_score||0)>=0.85?'var(--yellow)':'var(--orange)'};border-radius:2px`"></div>
                        </div>
                        <span style="font-size:10px;width:28px;text-align:right;color:var(--text2)"
                              :style="`color:${(t.completion_score||0)>=1?'var(--green)':(t.completion_score||0)>=0.7?'var(--yellow)':'var(--red)'}`"
                              x-text="((t.completion_score||0)*100).toFixed(0)+'%'"></span>
                      </div>
                    </span>
                    <span style="font-size:11px;color:var(--text2);text-align:center"
                          :style="`color:${(t.attempts||1)>1?'var(--yellow)':'var(--text2)'}`"
                          x-text="t.attempts||1"></span>
                    <span style="font-size:11px;text-align:center"
                          :style="`color:${t.accuracy_score!=null?(t.accuracy_score>=0.7?'var(--green)':t.accuracy_score>=0.4?'var(--yellow)':'var(--red)'):'var(--text2)'}`"
                          x-text="t.accuracy_score!=null?((t.accuracy_score||0)*100).toFixed(0)+'%':'—'"></span>
                    <button class="btn" style="padding:1px 8px;font-size:10px;min-width:0"
                            :style="`background:${expandedId===t.task_id?'var(--accent)':'transparent'};color:${expandedId===t.task_id?'#fff':'var(--accent)'};border-color:var(--accent)`"
                            @click.stop="expandedId=expandedId===t.task_id?null:t.task_id"
                            x-text="expandedId===t.task_id?'닫기':'상세'"></button>
                  </div>
                  <!-- Sub-info row (always visible) -->
                  <div style="padding:2px 8px 4px 8px;font-size:10px;color:var(--text2);display:flex;gap:12px;flex-wrap:wrap"
                       x-show="(t.errors&&t.errors.length)||(t.accuracy_score==null)">
                    <span x-show="t.accuracy_score==null" style="color:var(--text2)">🔍 accuracy 측정 없음 (ground_truth 미설정)</span>
                    <span x-show="t.errors&&t.errors.length" style="color:var(--red)"
                          x-text="'오류 발생: '+(t.errors||[]).slice(0,2).join(' · ')+(t.errors?.length>2?' 외 '+(t.errors.length-2)+'건':'')"></span>
                  </div>
                  <!-- Expanded detail row -->
                  <div x-show="expandedId===t.task_id"
                       style="background:rgba(99,102,241,.04);border-top:1px solid var(--border);border-left:2px solid var(--accent)">

                    <!-- ① 부분성공/실패: 원인 분석 패널 -->
                    <template x-if="(t.completion_score||0)<1.0">
                      <div style="border-bottom:1px solid var(--border)" :style="`background:${tcrSev(t).bg}`">
                        <div style="padding:10px 14px 0 14px">
                          <!-- 헤더: 심각도 라벨 + 점수 게이지 -->
                          <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap">
                            <span style="font-size:10px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.05em">🔍 미완료 원인 분석</span>
                            <span style="font-size:11px;padding:2px 8px;border-radius:99px;border:1px solid;font-weight:600"
                                  :style="`color:${tcrSev(t).color};border-color:${tcrSev(t).border};background:var(--bg2)`"
                                  x-text="tcrSev(t).label"></span>
                            <div style="flex:1;max-width:200px;display:flex;align-items:center;gap:5px">
                              <div style="flex:1;height:5px;background:var(--bg3);border-radius:3px;overflow:hidden">
                                <div :style="`width:${((t.completion_score||0)*100).toFixed(0)}%;height:100%;border-radius:3px;background:${(t.completion_score||0)>=0.9?'#f59e0b':(t.completion_score||0)>=0.7?'#f97316':'var(--red)'}`"></div>
                              </div>
                              <span style="font-size:11px;font-variant-numeric:tabular-nums;font-weight:700;flex-shrink:0"
                                    :style="`color:${tcrSev(t).color}`"
                                    x-text="((t.completion_score||0)*100).toFixed(0)+'%'"></span>
                            </div>
                          </div>

                          <!-- 패턴 해석 -->
                          <div style="font-size:12px;line-height:1.6;padding:6px 10px;border-radius:6px;border-left:3px solid;margin-bottom:10px;background:var(--bg2)"
                               :style="`border-color:${tcrSev(t).color}`"
                               x-text="tcrPattern(t)"></div>

                          <!-- 지표 교차 분석 카드 -->
                          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px">
                            <div style="flex:1;min-width:80px;padding:6px 10px;background:var(--bg2);border-radius:6px;border:1px solid var(--border)">
                              <div style="font-size:10px;color:var(--text2);margin-bottom:1px">완료율</div>
                              <div style="font-size:14px;font-weight:700"
                                   :style="`color:${(t.completion_score||0)>=0.9?'#f59e0b':(t.completion_score||0)>=0.7?'#f97316':'var(--red)'}`"
                                   x-text="((t.completion_score||0)*100).toFixed(0)+'%'"></div>
                              <div style="font-size:10px"
                                   :style="`color:${(t.completion_score||0)>=0.9?'var(--yellow)':'var(--red)'}`"
                                   x-text="(t.completion_score||0)>=0.9?'▲ 경미 부족':(t.completion_score||0)>=0.7?'⚠ 부분':'✕ 실패'"></div>
                            </div>
                            <div style="flex:1;min-width:80px;padding:6px 10px;background:var(--bg2);border-radius:6px;border:1px solid var(--border)">
                              <div style="font-size:10px;color:var(--text2);margin-bottom:1px">정확도</div>
                              <div style="font-size:14px;font-weight:700"
                                   :style="`color:${(t.accuracy_score||0)>=0.7?'var(--green)':(t.accuracy_score||0)>=0.4?'var(--yellow)':'var(--red)'}`"
                                   x-text="t.accuracy_score>0?((t.accuracy_score||0)*100).toFixed(0)+'%':'—'"></div>
                              <div style="font-size:10px;color:var(--text2)"
                                   x-text="t.accuracy_score>0?((t.accuracy_score||0)>=0.7?'✓ 양호':(t.accuracy_score||0)>=0.4?'⚠ 보통':'✕ 낮음'):'미측정'"></div>
                            </div>
                            <template x-if="(t.advanced_metrics||{}).g_eval_score!=null">
                              <div style="flex:1;min-width:80px;padding:6px 10px;background:var(--bg2);border-radius:6px;border:1px solid var(--border)">
                                <div style="font-size:10px;color:var(--text2);margin-bottom:1px">G-Eval</div>
                                <div style="font-size:14px;font-weight:700"
                                     :style="`color:${(t.advanced_metrics.g_eval_score||0)>=0.7?'var(--green)':(t.advanced_metrics.g_eval_score||0)>=0.4?'var(--yellow)':'var(--red)'}`"
                                     x-text="(t.advanced_metrics.g_eval_score||0).toFixed(3)"></div>
                                <div style="font-size:10px"
                                     :style="`color:${t.advanced_metrics.g_eval_passed===true||t.advanced_metrics.g_eval_passed==='true'?'var(--green)':'var(--red)'}`"
                                     x-text="t.advanced_metrics.g_eval_passed===true||t.advanced_metrics.g_eval_passed==='true'?'✓ 합격':'✕ 불합격'"></div>
                              </div>
                            </template>
                            <template x-if="(t.attempts||1)>1">
                              <div style="flex:1;min-width:80px;padding:6px 10px;background:var(--bg2);border-radius:6px;border:1px solid rgba(245,158,11,.3)">
                                <div style="font-size:10px;color:var(--text2);margin-bottom:1px">재시도</div>
                                <div style="font-size:14px;font-weight:700;color:var(--yellow)" x-text="(t.attempts||1)+'회'"></div>
                                <div style="font-size:10px;color:var(--yellow)">⚠ 불안정</div>
                              </div>
                            </template>
                            <template x-if="(t.errors||[]).length>0">
                              <div style="flex:1;min-width:80px;padding:6px 10px;background:var(--bg2);border-radius:6px;border:1px solid rgba(239,68,68,.3)">
                                <div style="font-size:10px;color:var(--text2);margin-bottom:1px">오류</div>
                                <div style="font-size:14px;font-weight:700;color:var(--red)" x-text="(t.errors||[]).length+'건'"></div>
                                <div style="font-size:10px;color:var(--red)">✕ 발생</div>
                              </div>
                            </template>
                          </div>

                          <!-- 정확도 성분 분석 -->
                          <template x-if="tcrAccComp(t).length>0">
                            <div style="margin-bottom:10px">
                              <div style="font-size:10px;font-weight:600;color:var(--text2);margin-bottom:4px">정확도 성분 분석 <span style="font-weight:400;color:var(--text2)">(낮은 순 · 가중치 포함)</span></div>
                              <template x-for="(c,ci) in tcrAccComp(t)" :key="ci">
                                <div style="display:flex;align-items:center;gap:5px;margin-bottom:3px">
                                  <span style="width:88px;flex-shrink:0;font-size:10px;color:var(--text2)" x-text="c.label"></span>
                                  <div style="flex:1;height:5px;background:var(--bg3);border-radius:3px;overflow:hidden">
                                    <div :style="`width:${(c.val*100).toFixed(0)}%;height:100%;border-radius:3px;background:${c.val>=0.7?'#10b981':c.val>=0.4?'#f59e0b':'#ef4444'}`"></div>
                                  </div>
                                  <span style="width:32px;text-align:right;font-size:10px;font-variant-numeric:tabular-nums"
                                        :style="`color:${c.val>=0.7?'var(--green)':c.val>=0.4?'var(--yellow)':'var(--red)'}`"
                                        x-text="(c.val*100).toFixed(0)+'%'"></span>
                                  <span style="width:28px;font-size:10px;color:var(--text2)" x-text="'w'+c.w+'%'"></span>
                                </div>
                              </template>
                              <div style="font-size:10px;color:var(--text2);margin-top:3px;padding-left:93px"
                                   x-text="tcrAccComp(t)[0]?'↑ '+tcrAccComp(t)[0].label+' 최하위 ('+((tcrAccComp(t)[0].val||0)*100).toFixed(0)+'%) — 이 성분이 정확도를 가장 많이 낮추고 있습니다':''"></div>
                            </div>
                          </template>

                          <!-- G-Eval 불합격 이유 -->
                          <template x-if="(t.advanced_metrics||{}).g_eval_reason&&(t.advanced_metrics.g_eval_passed===false||t.advanced_metrics.g_eval_passed==='false')">
                            <div style="margin-bottom:10px;padding:7px 10px;background:rgba(239,68,68,.06);border:1px solid rgba(239,68,68,.2);border-radius:6px">
                              <div style="font-size:10px;font-weight:600;color:var(--red);margin-bottom:3px">🤖 G-Eval 불합격 이유</div>
                              <div style="font-size:11px;color:var(--text);line-height:1.6" x-text="t.advanced_metrics.g_eval_reason"></div>
                            </div>
                          </template>

                          <!-- 개선 권고 -->
                          <template x-if="tcrRecs(t).length>0">
                            <div style="margin-bottom:12px">
                              <div style="font-size:10px;font-weight:600;color:var(--text2);margin-bottom:4px">💡 개선 권고</div>
                              <template x-for="(rc,ri) in tcrRecs(t)" :key="ri">
                                <div style="display:flex;gap:6px;align-items:flex-start;margin-bottom:4px;padding:5px 8px;background:var(--bg2);border-radius:5px">
                                  <span x-text="rc.icon" style="flex-shrink:0;font-size:13px;margin-top:1px"></span>
                                  <span style="flex:1;font-size:11px;color:var(--text);line-height:1.5" x-text="rc.text"></span>
                                  <span style="flex-shrink:0;font-size:10px;padding:1px 5px;border-radius:99px;margin-top:1px"
                                        :style="rc.pri==='high'?'background:rgba(239,68,68,.15);color:var(--red)':rc.pri==='med'?'background:rgba(245,158,11,.15);color:var(--yellow)':'background:var(--bg3);color:var(--text2)'"
                                        x-text="rc.pri==='high'?'우선':'참고'"></span>
                                </div>
                              </template>
                            </div>
                          </template>
                        </div>
                      </div>
                    </template>

                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;font-size:12px">
                      <!-- Left: 태스크 기본 정보 -->
                      <div style="padding:10px 14px;border-right:1px solid var(--border)">
                        <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px">태스크 정보</div>
                        <div class="drow"><span class="dk">ID</span><span style="font-family:monospace;font-size:11px" x-text="t.task_id"></span></div>
                        <div class="drow"><span class="dk">유형</span><span x-text="t.task_type||'—'"></span></div>
                        <div class="drow"><span class="dk">완료율</span>
                          <span :style="`color:${(t.completion_score||0)>=1?'var(--green)':(t.completion_score||0)>=0.7?'var(--yellow)':'var(--red)'};font-weight:700`"
                                x-text="((t.completion_score||0)*100).toFixed(1)+'%'"></span></div>
                        <div class="drow"><span class="dk">정확도</span>
                          <span :style="t.accuracy_score!=null?`color:${(t.accuracy_score||0)>=0.7?'var(--green)':(t.accuracy_score||0)>=0.4?'var(--yellow)':'var(--red)'}`:''"
                                x-text="t.accuracy_score!=null?((t.accuracy_score||0)*100).toFixed(1)+'%':'미측정'"></span></div>
                        <div class="drow"><span class="dk">응답시간</span><span x-text="t.execution_time!=null?t.execution_time.toFixed(3)+'s':'—'"></span></div>
                        <div class="drow"><span class="dk">토큰</span><span x-text="(t.tokens_used?.total||t.tokens_used||0).toLocaleString()"></span></div>
                        <div class="drow"><span class="dk">시도</span>
                          <span :style="`color:${(t.attempts||1)>1?'var(--yellow)':'var(--text)'}`"
                                x-text="t.attempts||1"></span></div>
                        <div class="drow"><span class="dk">도구 호출</span><span x-text="Array.isArray(t.tool_calls)?t.tool_calls.length:(t.tool_calls!=null?t.tool_calls:'0')"></span></div>
                        <div class="drow" x-show="t.framework"><span class="dk">프레임워크</span><span x-text="t.framework"></span></div>

                        <!-- accuracy_detail breakdown -->
                        <template x-if="t.accuracy_detail&&Object.keys(t.accuracy_detail).length">
                          <div style="margin-top:8px">
                            <div style="font-size:10px;font-weight:600;color:var(--text2);margin-bottom:3px">정확도 세부</div>
                            <template x-for="(v,k) in t.accuracy_detail" :key="k">
                              <div class="drow" style="font-size:10px">
                                <span class="dk" x-text="k"></span>
                                <span x-text="typeof v==='number'?(v*100).toFixed(1)+'%':String(v)"></span>
                              </div>
                            </template>
                          </div>
                        </template>
                      </div>

                      <!-- Right: 오류 + Q&A 비교 + Advanced Metrics -->
                      <div style="padding:10px 14px">
                        <!-- 오류 목록 -->
                        <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px">오류 및 기타</div>
                        <template x-if="t.errors&&t.errors.length">
                          <div>
                            <template x-for="(e,ei) in (t.errors||[])" :key="ei">
                              <div style="font-family:monospace;font-size:10px;color:var(--red);padding:3px 6px;background:rgba(239,68,68,.08);border-radius:4px;margin-bottom:3px;word-break:break-all" x-text="e"></div>
                            </template>
                          </div>
                        </template>
                        <template x-if="!(t.errors&&t.errors.length)">
                          <div style="color:var(--green);font-size:11px;margin-bottom:8px">✓ 오류 없음</div>
                        </template>

                        <!-- Q&A 비교 (부분성공/실패 시) -->
                        <template x-if="(t.completion_score||0)<1.0&&(t.question||t.response||t.ground_truth)">
                          <div style="margin-top:10px">
                            <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:5px">💬 Q&A 비교</div>
                            <template x-if="t.question">
                              <div style="margin-bottom:6px">
                                <div style="font-size:10px;color:var(--text2);margin-bottom:2px">질문 / 입력</div>
                                <div style="font-size:11px;background:var(--bg3);border-radius:5px;padding:5px 8px;border-left:2px solid var(--accent);max-height:70px;overflow-y:auto;line-height:1.5;word-break:break-all"
                                     x-text="t.question"></div>
                              </div>
                            </template>
                            <template x-if="t.response">
                              <div style="margin-bottom:6px">
                                <div style="font-size:10px;color:var(--text2);margin-bottom:2px">에이전트 응답</div>
                                <div style="font-size:11px;background:var(--bg3);border-radius:5px;padding:5px 8px;border-left:2px solid var(--yellow);max-height:80px;overflow-y:auto;line-height:1.5;word-break:break-all"
                                     x-text="t.response"></div>
                              </div>
                            </template>
                            <template x-if="t.ground_truth">
                              <div style="margin-bottom:6px">
                                <div style="font-size:10px;color:var(--text2);margin-bottom:2px">정답 (ground_truth)</div>
                                <div style="font-size:11px;background:rgba(16,185,129,.06);border-radius:5px;padding:5px 8px;border-left:2px solid var(--green);max-height:70px;overflow-y:auto;line-height:1.5;word-break:break-all"
                                     x-text="t.ground_truth"></div>
                              </div>
                            </template>
                          </div>
                        </template>

                        <!-- Advanced Metrics -->
                        <template x-if="t.advanced_metrics&&Object.keys(t.advanced_metrics).length">
                          <div style="margin-top:10px">
                            <div style="font-size:10px;font-weight:600;color:var(--text2);margin-bottom:3px">Advanced Metrics</div>
                            <template x-for="(v,k) in t.advanced_metrics" :key="k">
                              <div class="drow" style="font-size:10px">
                                <span class="dk" x-text="k"></span>
                                <span x-text="typeof v==='number'?v.toFixed(3):String(v)"></span>
                              </div>
                            </template>
                          </div>
                        </template>
                      </div>
                    </div>
                  </div>
                </div>
              </template>
            </div>
            <div style="margin-top:6px;font-size:10px;color:var(--text2)">
              <span x-text="filterLabel(selK)"></span> · [상세] 클릭 시 전체 정보 확인
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cg" style="margin-top:8px">
      <div class="cbox"><div class="ct">완료율 분포</div><div id="d2-q-donut" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">태스크 유형별 TCR</div><div id="d2-q-type-tcr" class="plt-chart"></div></div>
    </div>
  </div>

  <!-- Accuracy subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🎯 정확도</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      overall:{label:'전체 정확도',unit:'%',desc:'에이전트 응답이 정답과 얼마나 일치하는지를 나타내는 전체 정확도입니다. 단어·집합·문자 유사도 등 4가지 관점을 종합해 계산하므로 다양한 응답 형태를 공정하게 평가합니다.',hint:'avg(accuracy_score) × 100'},
      median:{label:'중앙값',unit:'%',desc:'정확도 분포의 중앙값으로, 특별히 높거나 낮은 이상치의 영향을 받지 않습니다. 에이전트의 일반적인 성능을 파악하는 데 유용하며, 평균과 크게 차이 나면 이상치 태스크가 많음을 의미합니다.',hint:'median(accuracy_scores) × 100'},
      minimum:{label:'최솟값',unit:'%',desc:'모든 태스크 중 가장 낮은 정확도 점수입니다. 에이전트가 특히 어려워하는 취약 케이스를 식별하고, 데이터셋에서 개선이 필요한 태스크 유형을 찾는 기준으로 활용됩니다.',hint:'min(accuracy_scores) × 100'},
      maximum:{label:'최댓값',unit:'%',desc:'모든 태스크 중 가장 높은 정확도 점수입니다. 에이전트가 가장 잘 수행하는 태스크 유형을 식별하는 데 도움이 되며, 강점 영역을 파악하는 기준이 됩니다.',hint:'max(accuracy_scores) × 100'},
      stddev:{label:'표준편차',unit:'%',desc:'정확도 점수들이 평균으로부터 얼마나 퍼져 있는지를 나타냅니다. 낮을수록 태스크 유형에 관계없이 일관된 성능을 발휘함을 의미하며, 예측 가능성과 신뢰성의 척도입니다.',hint:'std(accuracy_scores) × 100'},
    },
    formula(k,d){
      const t=d.tasks||[];
      const sc=t.map(x=>(x.accuracy_score||0)*100).filter(v=>v>0);
      const n=sc.length||1;
      const mean=sc.reduce((a,b)=>a+b,0)/n;
      const sorted=[...sc].sort((a,b)=>a-b);
      const med=n%2===0?(sorted[n/2-1]+sorted[n/2])/2:sorted[Math.floor(n/2)];
      const std=Math.sqrt(sc.reduce((a,b)=>a+(b-mean)**2,0)/n);
      if(k==='overall')return `평균 = Σ accuracy_score / n\n= ${mean.toFixed(1)}% (n=${n})\n가중: Token(40%)+Jaccard(30%)+LCS(20%)+Char(10%)`;
      if(k==='median')return `중앙값 = ${med.toFixed(1)}% (n=${n})\n이상치에 강건한 대표값`;
      if(k==='minimum')return `최솟값 = ${Math.min(...sc).toFixed(1)}%`;
      if(k==='maximum')return `최댓값 = ${Math.max(...sc).toFixed(1)}%`;
      if(k==='stddev')return `표준편차 = ${std.toFixed(1)}%\n변동계수(CV) = ${mean>0?(std/mean*100).toFixed(1):'-'}%`;
      return '';
    },
    items(k,d){
      const t=d.tasks||[];
      const sc=t.map(x=>(x.accuracy_score||0)*100).filter(v=>v>0);
      const mean=sc.reduce((a,b)=>a+b,0)/(sc.length||1);
      if(k==='minimum')return [...t].sort((a,b)=>(a.accuracy_score||0)-(b.accuracy_score||0)).slice(0,10);
      if(k==='maximum')return [...t].sort((a,b)=>(b.accuracy_score||0)-(a.accuracy_score||0)).slice(0,10);
      if(k==='stddev')return t.filter(x=>Math.abs((x.accuracy_score||0)*100-mean)>10);
      if(k==='median'){const srt=[...sc].sort((a,b)=>a-b);const nm=srt.length;const med=nm?(nm%2===0?(srt[nm/2-1]+srt[nm/2])/2:srt[Math.floor(nm/2)]):0;return [...t].filter(x=>(x.accuracy_score||0)*100>0).sort((a,b)=>Math.abs((a.accuracy_score||0)*100-med)-Math.abs((b.accuracy_score||0)*100-med));}
      return [...t].sort((a,b)=>(b.accuracy_score||0)-(a.accuracy_score||0));
    },
    filterLabel(k){return {overall:'정확도 내림차순',median:'전체',minimum:'하위 10개',maximum:'상위 10개',stddev:'평균 ±10% 벗어난 태스크'}[k]||'전체';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='overall'}" @click="selK=selK==='overall'?null:'overall'">
        <div class="kpi-lbl">전체 정확도</div>
        <div class="kpi-val" :style="`color:${_bc(_accG(data),thresholds.acc_min*100,Math.max(0,thresholds.acc_min*100-20))}`" x-text="_accG(data).toFixed(1)+'%'"></div>
        <div class="kpi-sub" x-text="(data.tasks||[]).filter(t=>(t.accuracy_score||0)>0).length+'건 평가'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='median'}" @click="selK=selK==='median'?null:'median'">
        <div class="kpi-lbl">중앙값</div>
        <div class="kpi-val" x-text="(()=>{const sc=(data.tasks||[]).map(t=>(t.accuracy_score||0)*100).filter(v=>v>0).sort((a,b)=>a-b);const n=sc.length;return n?((n%2===0?(sc[n/2-1]+sc[n/2])/2:sc[Math.floor(n/2)])||0).toFixed(1)+'%':'-';})()"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='minimum'}" @click="selK=selK==='minimum'?null:'minimum'">
        <div class="kpi-lbl">최솟값</div>
        <div class="kpi-val" style="color:var(--red)" x-text="(()=>{const sc=(data.tasks||[]).map(t=>(t.accuracy_score||0)*100).filter(v=>v>0);return sc.length?Math.min(...sc).toFixed(1)+'%':'-';})()"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='maximum'}" @click="selK=selK==='maximum'?null:'maximum'">
        <div class="kpi-lbl">최댓값</div>
        <div class="kpi-val" style="color:var(--green)" x-text="(()=>{const sc=(data.tasks||[]).map(t=>(t.accuracy_score||0)*100).filter(v=>v>0);return sc.length?Math.max(...sc).toFixed(1)+'%':'-';})()"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='stddev'}" @click="selK=selK==='stddev'?null:'stddev'">
        <div class="kpi-lbl">표준편차</div>
        <div class="kpi-val" x-text="(()=>{const sc=(data.tasks||[]).map(t=>(t.accuracy_score||0)*100).filter(v=>v>0);const n=sc.length;if(!n)return '-';const m=sc.reduce((a,b)=>a+b,0)/n;return Math.sqrt(sc.reduce((a,b)=>a+(b-m)**2,0)/n).toFixed(1)+'%';})()"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="meta[selK]?.unit?'단위: '+meta[selK].unit:''"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
              <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <div style="padding:10px 14px;background:var(--bg)">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">관련 태스크</span>
              <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="filterLabel(selK)"></span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,data).length+'건'"></span>
            </div>
            <div class="dtx" style="max-height:220px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:170px minmax(0,1fr) 68px 68px;position:sticky;top:0;z-index:1">
                <span>태스크 ID</span><span>유형</span><span>정확도</span><span>완료율</span>
              </div>
              <template x-for="t in items(selK,data)" :key="t.task_id">
                <div class="dtx-row" style="grid-template-columns:170px minmax(0,1fr) 68px 68px">
                  <span class="dtx-id" x-text="t.task_id"></span>
                  <span style="font-size:11px;color:var(--text2)" x-text="t.task_type||'-'"></span>
                  <span :style="`color:${_bc((t.accuracy_score||0)*100,70,50)}`" x-text="((t.accuracy_score||0)*100).toFixed(1)+'%'"></span>
                  <span :style="`color:${(t.completion_score||0)>=1?'var(--green)':(t.completion_score||0)>=0.7?'var(--yellow)':'var(--red)'}`"
                        x-text="((t.completion_score||0)*100).toFixed(0)+'%'"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cg" style="margin-top:8px">
      <div class="cbox">
        <div class="ct">정확도 분포 (태스크 유형별)</div>
        <div id="d2-q-acc-hist" class="plt-chart"></div>
      </div>
      <div class="cbox">
        <div class="ct">정확도 가중치 구성</div>
        <div id="d2-q-acc-weights" class="plt-chart" style="height:100px"></div>
        <div style="margin-top:8px;font-size:11px;color:var(--text2);line-height:1.8">
          <div>🔵 <b>Token Overlap (40%)</b> — 공통 토큰 F1 스코어</div>
          <div>🟣 <b>Jaccard (30%)</b> — 집합 교집합/합집합</div>
          <div>🟡 <b>LCS Ratio (20%)</b> — 최장 공통 부분 수열</div>
          <div>⚪ <b>Char Similarity (10%)</b> — 문자 수준 편집 유사도</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Response Quality subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">⭐ 응답 품질</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      avg_score:{label:'평균 품질 점수',unit:'/5',desc:'5개 품질 차원을 종합한 응답 품질의 대표값입니다. 단순한 정답 일치 여부를 넘어 응답의 실용적 가치를 평가하며, 사용자 만족도와 가장 상관관계가 높은 지표입니다.',hint:'avg(dimension_scores) / 5'},
      relevance:{label:'관련성',unit:'/5',desc:'응답이 질문의 핵심 의도에 얼마나 직접적으로 답하고 있는지를 나타냅니다. 질문과 무관한 정보를 늘어놓거나 핵심을 벗어난 응답을 탐지하는 데 유용합니다.',hint:'quality_detail.dimension_summary.relevance'},
      completeness:{label:'완전성',unit:'/5',desc:'질문에서 요구하는 모든 측면을 응답이 빠짐없이 다루고 있는지를 측정합니다. 불완전한 답변이나 일부 요건만 충족한 응답을 식별하며, 멀티-파트 질문 처리 능력을 평가합니다.',hint:'quality_detail.dimension_summary.completeness'},
      accuracy:{label:'정확성',unit:'/5',desc:'응답에 포함된 사실, 수치, 개념이 실제로 정확한지를 평가합니다. 잘못된 정보나 오류가 포함된 응답을 탐지하며, 사실 기반 QA·분석 태스크에서 특히 중요한 차원입니다.',hint:'quality_detail.dimension_summary.accuracy'},
      clarity:{label:'명확성',unit:'/5',desc:'응답이 명확하고 이해하기 쉽게 구성되어 있는지를 나타냅니다. 모호한 표현, 불명확한 구조, 과도한 복잡성을 가진 응답을 탐지하며, 사용자가 응답을 올바르게 이해하고 활용할 수 있는지와 관련됩니다.',hint:'quality_detail.dimension_summary.clarity'},
      usefulness:{label:'유용성',unit:'/5',desc:'응답이 실제 상황에서 얼마나 도움이 되는지를 평가합니다. 기술적으로 정확하더라도 실용적이지 않은 응답을 식별하며, 최종 사용자의 문제 해결에 직접 기여하는 가치를 측정합니다.',hint:'quality_detail.dimension_summary.usefulness'},
    },
    formula(k,d){
      const ds=d.quality_detail?.dimension_summary||{};
      const avg=d.quality_detail?.avg_score||0;
      if(k==='avg_score')return `평균 = (관련성+완전성+정확성+명확성+유용성)/5\n= ${avg.toFixed(2)}/5 = ${(avg*20).toFixed(1)}%`;
      return `${k} = ${(ds[k]||0).toFixed(2)}/5`;
    },
    items(k,d){
      const evs=d.quality_detail?.evaluations||[];
      if(k!=='avg_score'){
        return [...evs].sort((a,b)=>((b.dimension_scores?.[k]||b[k]||0))-(a.dimension_scores?.[k]||a[k]||0));
      }
      return [...evs].sort((a,b)=>(b.total_score||0)-(a.total_score||0));
    },
    filterLabel(k){return k==='avg_score'?'총점 내림차순':k+' 점수 내림차순';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='avg_score'}" @click="selK=selK==='avg_score'?null:'avg_score'">
        <div class="kpi-lbl">평균 품질 점수</div>
        <div class="kpi-val" x-text="(data.quality_detail?.avg_score||0).toFixed(2)+'/5'"></div>
        <div class="kpi-sub" x-text="(data.quality_detail?.evaluations||[]).length+'건 평가'"></div>
      </div>
      <template x-for="(dimLabel,dimKey) in {relevance:'관련성',completeness:'완전성',accuracy:'정확성',clarity:'명확성',usefulness:'유용성'}" :key="dimKey">
        <div class="kpi kpi-act" :class="{sel:selK===dimKey}" @click="selK=selK===dimKey?null:dimKey">
          <div class="kpi-lbl" x-text="dimLabel"></div>
          <div class="kpi-val" x-text="(data.quality_detail?.dimension_summary?.[dimKey]||0).toFixed(2)+'/5'"></div>
          <div class="kpi-sub" x-text="(()=>{const evs=data.quality_detail?.evaluations||[];const sc=evs.map(e=>(e.dimension_scores?.[dimKey]??0));if(!evs.length)return '데이터 없음';const mn=Math.min(...sc).toFixed(1);const mx=Math.max(...sc).toFixed(1);return evs.length+'건 · '+mn+'~'+mx;})()"></div>
        </div>
      </template>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="meta[selK]?.unit?'단위: '+meta[selK].unit:''"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
              <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <div style="padding:10px 14px;background:var(--bg)">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">평가 목록</span>
              <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="filterLabel(selK)"></span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,data).length+'건'"></span>
            </div>
            <div class="dtx" style="max-height:220px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:minmax(100px,1fr) 50px 36px 40px 40px 40px 40px 40px;position:sticky;top:0;z-index:1">
                <span>태스크 ID</span><span title="총점(0-5)">점수</span><span>등급</span>
                <span title="관련성(Relevance)">관련</span><span title="완전성(Completeness)">완전</span>
                <span title="정확성(Accuracy)">정확</span><span title="명확성(Clarity)">명확</span>
                <span title="유용성(Usefulness)">유용</span>
              </div>
              <template x-for="ev in items(selK,data)" :key="ev.task_id">
                <div class="dtx-row" style="grid-template-columns:minmax(100px,1fr) 50px 36px 40px 40px 40px 40px 40px">
                  <span class="dtx-id" x-text="ev.task_id"></span>
                  <span x-text="(ev.total_score||0).toFixed(2)"></span>
                  <span :class="{'badge-ok':ev.grade==='A','badge-info':ev.grade==='B','badge-warn':ev.grade==='C'||ev.grade==='D','badge-ng':ev.grade==='F'}" x-text="ev.grade||'-'"></span>
                  <span :style="`color:${_bc((ev.dimension_scores?.relevance||ev.relevance||0)*20,70,50)}`" x-text="(ev.dimension_scores?.relevance||ev.relevance||0).toFixed(1)"></span>
                  <span :style="`color:${_bc((ev.dimension_scores?.completeness||ev.completeness||0)*20,70,50)}`" x-text="(ev.dimension_scores?.completeness||ev.completeness||0).toFixed(1)"></span>
                  <span :style="`color:${_bc((ev.dimension_scores?.accuracy||ev.accuracy||0)*20,70,50)}`" x-text="(ev.dimension_scores?.accuracy||ev.accuracy||0).toFixed(1)"></span>
                  <span :style="`color:${_bc((ev.dimension_scores?.clarity||ev.clarity||0)*20,70,50)}`" x-text="(ev.dimension_scores?.clarity||ev.clarity||0).toFixed(1)"></span>
                  <span :style="`color:${_bc((ev.dimension_scores?.usefulness||ev.usefulness||0)*20,70,50)}`" x-text="(ev.dimension_scores?.usefulness||ev.usefulness||0).toFixed(1)"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cg" style="margin-top:8px">
      <div class="cbox"><div class="ct">품질 차원 레이더</div><div id="d2-q-radar" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">등급 분포</div><div id="d2-q-grade" class="plt-chart"></div></div>
    </div>
  </div>

  <!-- Hallucination subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔍 환각 탐지</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      hall_rate:{label:'환각률',unit:'%',desc:'환각 지표가 탐지된 태스크의 비율입니다. 에이전트가 사실과 다르거나 출처 없는 정보를 얼마나 자주 생성하는지를 나타내며, 신뢰성 있는 AI 서비스 운영의 핵심 리스크 지표입니다.',hint:'flagged / evaluated × 100'},
      evaluated:{label:'평가 건수',unit:'건',desc:'환각 탐지 분석이 실행된 태스크 수입니다 (Layer 1 전용). DeepEval 환각 평가는 외부 평가 탭에서 별도 확인하세요.',hint:'hallucination_detail.detections.length'},
      flagged:{label:'탐지 건수',unit:'건',desc:'하나 이상의 환각 지표가 탐지된 태스크 수입니다. 수치 불일치, 근거 없는 주장, 컨텍스트 불일치 등의 패턴이 발견된 응답으로, 사람이 직접 검토해야 할 후보 태스크입니다.',hint:'hallucination_detail.detections.filter(d=>d.hallucination_rate>0).length'},
      types:{label:'유형 수',unit:'종',desc:'이번 평가에서 실제로 관찰된 환각 지표의 종류 수입니다. 유형이 다양할수록 에이전트의 환각 문제가 특정 원인에 국한되지 않고 광범위함을 시사합니다.',hint:'hallucination_detail.indicator_types keys'},
    },
    formula(k,d){
      const dets=(d.hallucination_detail?.detections||[]).filter(x=>x.source!=='deepeval');
      const ev=dets.length;
      const fl=dets.filter(x=>(x.hallucination_rate||0)>0).length;
      if(k==='hall_rate')return `환각률 = 탐지 건 / 평가 건 × 100 (Layer 1 전용)\n= ${fl} / ${ev} = ${ev?((fl/ev)*100).toFixed(1):0}%`;
      if(k==='evaluated')return `평가 건수 = ${ev}건 (Layer 1 detections)\nDeepEval 기록은 외부 평가 탭에서 확인`;
      if(k==='flagged')return `탐지 건수 = ${fl}건 (hallucination_rate > 0)\n환각률 = ${ev?((fl/ev)*100).toFixed(1):0}%`;
      const typesSet={};dets.filter(x=>(x.hallucination_rate||0)>0).forEach(det=>{new Set((det.indicators||[]).map(i=>i.type||'unknown')).forEach(t=>{typesSet[t]=(typesSet[t]||0)+1;});});
      if(k==='types')return `유형 수 = ${Object.keys(typesSet).length}종\n(탐지 건 기준, indicator 유형별 탐지 태스크 수)`;
      return '';
    },
    items(k,d){
      const dets=(d.hallucination_detail?.detections||[]).filter(x=>x.source!=='deepeval');
      if(k==='types'){
        // detection 1건 = 1행 (indicator 여러 개는 배지 묶음으로 표시) → 탐지 건수와 동일
        const sevRank={high:3,medium:2,low:1};
        return dets.filter(det=>(det.hallucination_rate||0)>0).map((det,i)=>{
          const inds=det.indicators||[];
          const types=[...new Set(inds.map(x=>x.type||'unknown'))];
          const maxSev=inds.reduce((a,b)=>(sevRank[b.severity]||0)>(sevRank[a]||0)?b.severity:a,'low');
          return {_key:'t'+i,task_id:det.task_id,question:det.question||'(질문 없음)',indicator_types:types,severity:maxSev,hall_rate:det.hallucination_rate||0};
        });
      }
      const filtered=(k==='flagged'||k==='hall_rate')?dets.filter(det=>(det.hallucination_rate||0)>0):dets;
      // tasks에서 response/ground_truth cross-reference
      const taskMap={};(d.tasks||[]).forEach(t=>{taskMap[t.task_id]=t;});
      return filtered.map((det,i)=>{
        const tk=taskMap[det.task_id]||{};
        return {_key:'d'+i,task_id:det.task_id,question:det.question||tk.question||'(질문 없음)',hall_rate:det.hallucination_rate||0,ind_count:(det.indicators||[]).length,indicators:det.indicators||[],context:det.context||null,response_sentences:det.response_sentences||0,response:tk.response||null,ground_truth:tk.ground_truth||null};
      });
    },
    filterLabel(k){return {hall_rate:'탐지된 환각건',evaluated:'전체 태스크',flagged:'탐지 건',types:'탐지 건'}[k]||'전체';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='hall_rate'}" @click="selK=selK==='hall_rate'?null:'hall_rate'">
        <div class="kpi-lbl">환각률</div>
        <div class="kpi-val" :style="`color:${_hallG(data)===0?'var(--green)':_hallG(data)<=thresholds.hall_max*100?'var(--yellow)':'var(--red)'}`"
             x-text="_hallG(data).toFixed(1)+'%'"></div>
        <div class="kpi-sub" x-text="_hallG(data)===0?'✓ 안전':_hallG(data)<=thresholds.hall_max*100?'⚠ 주의':'🚨 위험'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='evaluated'}" @click="selK=selK==='evaluated'?null:'evaluated'">
        <div class="kpi-lbl">평가 건수</div>
        <div class="kpi-val" x-text="(data.hallucination_detail?.detections||[]).filter(d=>d.source!=='deepeval').length"></div>
        <div class="kpi-sub" style="color:var(--text2)">Layer 1</div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='flagged'}" @click="selK=selK==='flagged'?null:'flagged'">
        <div class="kpi-lbl">탐지 건수</div>
        <div class="kpi-val" style="color:var(--orange)" x-text="(data.hallucination_detail?.detections||[]).filter(d=>d.source!=='deepeval'&&(d.hallucination_rate||0)>0).length"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='types'}" @click="selK=selK==='types'?null:'types'">
        <div class="kpi-lbl">유형 수</div>
        <div class="kpi-val" x-text="(()=>{const s=new Set();(data.hallucination_detail?.detections||[]).filter(d=>d.source!=='deepeval'&&(d.hallucination_rate||0)>0).forEach(d=>(d.indicators||[]).forEach(i=>s.add(i.type||'unknown')));return s.size;})()"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="meta[selK]?.unit?'단위: '+meta[selK].unit:''"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
              <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <div style="padding:10px 14px;background:var(--bg)">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase" x-text="selK==='types'?'탐지 태스크 목록 (유형별)':selK==='evaluated'?'평가 기록':'탐지 목록'"></span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="selK==='types'?items(selK,data).length+'건 탐지 태스크':items(selK,data).length+'건'"></span>
            </div>
            <!-- types → per-detection card list (1건=1행, indicator 배지 묶음) -->
            <template x-if="selK==='types'">
              <div style="max-height:340px;overflow-y:auto;display:flex;flex-direction:column;gap:6px">
                <template x-for="det in items(selK,data)" :key="det._key">
                  <div style="border:1px solid var(--border);border-radius:6px;padding:8px 12px;background:var(--bg2)">
                    <div style="display:flex;align-items:center;gap:6px;margin-bottom:5px;flex-wrap:wrap">
                      <span class="dtx-id" x-text="det.task_id"></span>
                      <template x-for="tp in det.indicator_types" :key="tp">
                        <span style="font-size:10px;font-weight:600;background:rgba(239,68,68,0.1);color:var(--red);padding:1px 6px;border-radius:4px;border:1px solid rgba(239,68,68,0.25)" x-text="tp"></span>
                      </template>
                      <span :class="det.severity==='high'?'badge-ng':det.severity==='medium'?'badge-warn':'badge-gray'" style="margin-left:auto" x-text="det.severity"></span>
