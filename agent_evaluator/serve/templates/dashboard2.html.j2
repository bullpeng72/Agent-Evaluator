  </template>
</section>

    </main><!-- /main -->
  </div><!-- /layout -->

  <!-- Status Bar -->
  <div class="status-bar">
    <span x-text="data ? (data.title||'Evaluation Result') : '—'"></span>
    <span class="mx-2 opacity-40">|</span>
    <span x-text="data ? (data.total_tasks||0) + ' tasks' : '—'"></span>
    <span class="mx-2 opacity-40">|</span>
    <span x-text="data ? (data.generated_at||data.timestamp||'') : '—'"></span>
    <span class="flex-1"></span>
    <template x-if="connected">
      <span class="flex items-center gap-1.5 text-green-400"><span class="w-2 h-2 rounded-full bg-green-400 animate-pulse inline-block"></span>Live</span>
    </template>
    <template x-if="!connected">
      <span class="text-gray-400">Static</span>
    </template>
    <span class="mx-2 opacity-40">|</span>
    <span>Agent-Evaluator v{{ version }}</span>
  </div>

</div><!-- /x-data app2 -->
<script>
/* ── global display helpers: callable from any Alpine template ── */
function _bc(v, hi, lo) { if(hi===undefined)hi=90; if(lo===undefined)lo=70; return v==null?'var(--text2)':v>=hi?'var(--green)':v>=lo?'var(--yellow)':'var(--red)'; }
function _bc2lat(v) { return v==null?'var(--text2)':v<=2?'var(--green)':v<=5?'var(--yellow)':'var(--red)'; }
function _pct(v) { return v==null?'0%':Math.min(100,Math.max(0,v)).toFixed(1)+'%'; }
function _sec(v) { if(v==null)return '—'; const n=Number(v); if(n===0)return '0ms'; if(n<0.001)return '<1ms'; if(n<1)return Math.round(n*1000)+'ms'; return n.toFixed(2)+'s'; }
function _latPct(arr, p) {
  const a = (arr||[]).filter(v=>v!=null).map(Number).sort((a,b)=>a-b);
  if (!a.length) return 0;
  if (a.length === 1) return a[0];
  const idx = (p / 100) * (a.length - 1);
  const lo = Math.floor(idx), hi = Math.ceil(idx);
  return lo === hi ? a[lo] : a[lo] + (idx - lo) * (a[hi] - a[lo]);
}
function _fmtCostG(v) { return v==null?'—':'$'+Number(v).toFixed(4); }
function _fmtNumG(v) { if(v==null)return '—'; if(v>=1e6)return (v/1e6).toFixed(1)+'M'; if(v>=1e3)return (v/1e3).toFixed(1)+'K'; return String(v); }
function _tcrG(d) { if(!d)return 0; const t=d.tasks||[],n=t.length||1; const raw=d.accuracy_metrics?.tcr?.tcr??null; return raw!=null?raw:t.reduce((s,x)=>s+(x.completion_score||0),0)/n*100; }
function _accG(d) { if(!d)return 0; const t=d.tasks||[],n=t.length||1; const raw=d.accuracy_metrics?.accuracy_scores?.overall_accuracy??null; return raw!=null?raw:t.reduce((s,x)=>s+(x.accuracy_score||0),0)/n*100; }
/* ── TCR 미완료 원인 분석 헬퍼 (전역) ── */
function tcrSev(t){
  const sc=t.completion_score||0;
  if(sc<0.7) return {label:'❌ Failed',color:'var(--red)',bg:'rgba(239,68,68,.06)',border:'rgba(239,68,68,.3)'};
  if(sc<0.9) return {label:'⚠ Partial (Moderate)',color:'var(--yellow)',bg:'rgba(245,158,11,.06)',border:'rgba(245,158,11,.3)'};
  return {label:'▲ Partial (Minor)',color:'#f59e0b',bg:'rgba(245,158,11,.04)',border:'rgba(245,158,11,.2)'};
}
function tcrPattern(t){
  const sc=t.completion_score||0, ac=t.accuracy_score||0, e=(t.errors||[]).length, att=t.attempts||1, gt=t.ground_truth;
  if(e>0&&sc<0.7) return 'Task execution stopped due to an error. Check error messages and strengthen exception handling.';
  if(sc<0.7&&ac<0.5&&gt) return 'Response differs significantly from ground truth — consider improving the prompt or adding few-shot examples.';
  if(sc<0.7&&ac>=0.7) return 'Response content is similar but completion condition not met — check execution flow or completion_score logic.';
  if(sc>=0.9) return 'Close to goal but minor requirements unmet — fine-tune output format consistency and edge cases.';
  if(att>1) return att+' retries still resulted in partial completion — improve retry strategy or prompt stability.';
  if(ac>=0.6&&sc<0.9&&gt) return 'Completion rate is low relative to accuracy — check response completeness or output format.';
  if(!gt) return 'Accuracy cannot be measured without ground_truth — set evaluation criteria and re-evaluate.';
  return 'Partially completed. Refer to the sub-item detailed analysis below.';
}
function tcrRecs(t){
  const r=[],sc=t.completion_score||0,ac=t.accuracy_score||0,e=t.errors||[],att=t.attempts||1,gt=t.ground_truth,adv=t.advanced_metrics||{};
  if(e.length) r.push({icon:'🔧',pri:'high',text:'Analyze error cause and strengthen exception handling: '+e.slice(0,1).join('')});
  if(att>1) r.push({icon:'⏱',pri:'high',text:'All '+att+' attempts incomplete — extend timeout or redesign retry strategy'});
  if(!gt) r.push({icon:'📋',pri:'med',text:'Adding ground_truth enables automatic accuracy measurement and regression tracking'});
  if(gt&&ac<0.5) r.push({icon:'✏',pri:'high',text:'Accuracy '+Math.round(ac*100)+'% — add few-shot examples or strengthen output format specification'});
  else if(gt&&ac>=0.5&&ac<0.7) r.push({icon:'✏',pri:'med',text:'Accuracy '+Math.round(ac*100)+'% — check whether response includes key keywords from ground_truth'});
  if(sc<0.7&&ac>=0.7) r.push({icon:'🔍',pri:'med',text:'Accuracy OK but completion rate low — review completion_score logic or success criteria'});
  if(adv.g_eval_passed===false||adv.g_eval_passed==='false') r.push({icon:'🤖',pri:'med',text:'G-Eval failed — see judgment reason below and improve response structure and logic flow'});
  if(sc>=0.9&&!e.length) r.push({icon:'🎯',pri:'low',text:'Completion rate '+Math.round(sc*100)+'% — reach 100% by improving output format consistency and handling edge cases'});
  return r.slice(0,4);
}
function tcrAccComp(t){
  const acd=t.accuracy_detail;
  if(!acd||!Object.keys(acd).length) return [];
  const map={token_overlap:{label:'Token Overlap F1',w:40},jaccard_similarity:{label:'Jaccard',w:30},jaccard:{label:'Jaccard',w:30},lcs_ratio:{label:'LCS Ratio',w:20},lcs:{label:'LCS Ratio',w:20},char_similarity:{label:'CharSim/Levenshtein',w:10},char_sim:{label:'CharSim/Levenshtein',w:10}};
  return Object.entries(acd).filter(([k])=>map[k]).map(([k,v])=>({...map[k],val:Math.min(1,parseFloat(v)||0)})).sort((a,b)=>a.val-b.val);
}
// 레이더 6축 정규화 헬퍼 (drawCompareChart·drawCharts와 공유)
function _cmpLatNorm(d) { const p95=d?.efficiency_metrics?.latency?.p95??null; return p95!=null?Math.max(0,1-p95/10)*100:null; }
function _cmpCostNorm(d) { const c=d?.efficiency_metrics?.tokens?.avg_cost_per_task??null; return c!=null?Math.max(0,1-c/0.05)*100:null; }
function _cmpSecNorm(d) {
  if(!d?.has_security) return null;
  const sl1=d.security_l1||{};
  const inp =sl1.input_security !=null?(100-(sl1.input_security?.threat_rate ||0))/100:null;
  const leak=sl1.output_leakage !=null?(100-(sl1.output_leakage?.leakage_rate||0))/100:null;
  const auth=sl1.authorization  !=null?(sl1.authorization?.compliance_rate??100)/100:null;
  const sv=[inp,leak,auth].filter(v=>v!=null);
  return sv.length?sv.reduce((s,v)=>s+v,0)/sv.length*100:0;
}
function _hallG(d) {
  if(!d) return 0;
  // detections 기반 우선 계산 (loader에서 deepeval 필터링된 Layer 1 전용)
  const dets = d.hallucination_detail?.detections||[];
  if(dets.length>0){
    const flagged=dets.filter(x=>(x.hallucination_rate||0)>0).length;
    return (flagged/dets.length)*100;
  }
  // fallback: accuracy_metrics (구버전 JSON 호환)
  const am=d.accuracy_metrics?.hallucination||{};
  const raw=am.overall_rate??null; if(raw!=null)return raw;
  const ev=am.total_evaluated||0,fl=am.total_flagged||0;
  return ev>0?(fl/ev)*100:0;
}
// ── 신규 6축 통합 헬퍼 ──
// 정확·품질: accuracy×0.4 + quality/5×0.4 + (1-hallucination)×0.2 (hallucination 없으면 50:50)
function _cmpQualAccNorm(d) {
  const acc  = _accG(d) / 100;
  const qual = d?.quality_detail?.avg_score != null ? d.quality_detail.avg_score / 5 : null;
  const hall = _hallG(d); const hallNorm = hall != null ? Math.max(0, 1 - hall/100) : null;
  if (qual == null && hallNorm == null) return acc * 100;
  if (hallNorm == null) return (acc * 0.5 + qual * 0.5) * 100;
  return (acc * 0.4 + (qual ?? acc) * 0.4 + hallNorm * 0.2) * 100;
}
// 운영효율: (latNorm + costNorm) / 2 — 한쪽만 있으면 그 값 사용
function _cmpOpsNorm(d) {
  const lat = _cmpLatNorm(d), cost = _cmpCostNorm(d);
  if (lat == null && cost == null) return null;
  if (lat == null) return cost;
  if (cost == null) return lat;
  return (lat + cost) / 2;
}
// 에이전틱 역량: Tool F1×0.5 + 협업 성공률×0.25 + 워크플로우 성공률×0.25 (있는 컴포넌트만 재정규화)
function _cmpAgenticNorm(d) {
  if (!d?.has_agentic) return null;
  const ag = d.agentic || {};
  const ts = ag.tool_selection_summary || {}, cs = ag.coordination_summary || {}, ws = ag.workflow_summary || {};
  const toolF1  = ts.avg_f1_score   != null ? ts.avg_f1_score   / 100 : null;
  const coordSR = cs.success_rate   != null ? cs.success_rate   / 100 : null;
  const wfSR    = ws.task_success_rate != null ? ws.task_success_rate / 100 : null;
  const parts = [], wts = [];
  if (toolF1  != null) { parts.push(toolF1  * 0.5);  wts.push(0.5); }
  if (coordSR != null) { parts.push(coordSR * 0.25); wts.push(0.25); }
  if (wfSR    != null) { parts.push(wfSR    * 0.25); wts.push(0.25); }
  if (!parts.length) return 0;
  return parts.reduce((s,v)=>s+v, 0) / wts.reduce((s,v)=>s+v, 0) * 100;
}
// 신뢰성: (오류없는태스크비율×0.6 + 재시도없는태스크비율×0.4)
function _cmpReliabilityNorm(d) {
  const tasks = d?.tasks || [];
  if (!tasks.length) return null;
  const n = tasks.length;
  const noErrRate   = tasks.filter(t => !(t.errors && t.errors.length)).length / n;
  const noRetryRate = tasks.filter(t => (t.attempts || 1) <= 1).length / n;
  return (noErrRate * 0.6 + noRetryRate * 0.4) * 100;
}

/* ── standalone helper (used by both app2 and badge pre-render) ── */
function autoAnomalies_inner(data, thresholds, avgCostOverride) {
  if (!data) return [];
  const am = data.accuracy_metrics || {};
  const em = data.efficiency_metrics || {};
  const tasks = data.tasks || [];
  const n = tasks.length || 1;
  const out = [];

  // TCR: accuracy_metrics stores percentage (0-100); convert to fraction for threshold comparison
  const tcrRaw = am.tcr?.tcr ?? am.tcr?.task_completion_rate ?? null;
  const tcr = tcrRaw != null ? tcrRaw / 100 : tasks.reduce((s,t) => s+(t.completion_score||0), 0) / n;

  // Accuracy: same — stored as percentage (0-100)
  const accRaw = am.accuracy_scores?.overall_accuracy ?? am.accuracy_scores?.accuracy_rate ?? null;
  const acc = accRaw != null ? accRaw / 100 : tasks.reduce((s,t) => s+(t.accuracy_score||0), 0) / n;

  // Hallucination rate: stored as percentage (0-100); convert to fraction
  const hallRaw = am.hallucination?.overall_rate ?? am.hallucination?.hallucination_rate ?? null;
  const hallEv = am.hallucination?.total_evaluated || 0;
  const hallFl = am.hallucination?.total_flagged || 0;
  const hall = hallRaw != null ? hallRaw / 100 : (hallEv > 0 ? hallFl / hallEv : null);

  const p95 = em.latency?.p95 ?? em.p95_latency ?? null;
  /* avgCostOverride: selModel 기반 재산출값. 없으면 JSON 저장값 사용 */
  const avgCost = avgCostOverride !== undefined ? avgCostOverride
                : (em.tokens?.avg_cost_per_task ?? em.avg_cost_per_task ?? null);

  if (tcr < thresholds.tcr_min)
    out.push({ level: 'critical', metric: 'Task Completion Rate (TCR)', detail: `Current ${(tcr*100).toFixed(1)}% < Threshold ${(thresholds.tcr_min*100).toFixed(0)}%` });
  if (acc < thresholds.acc_min)
    out.push({ level: 'warn', metric: 'Accuracy', detail: `Current ${(acc*100).toFixed(1)}% < Threshold ${(thresholds.acc_min*100).toFixed(0)}%` });
  if (hall !== null && hall > thresholds.hall_max)
    out.push({ level: 'critical', metric: 'Hallucination Rate', detail: `Current ${(hall*100).toFixed(1)}% > Threshold ${(thresholds.hall_max*100).toFixed(0)}%` });
  if (p95 !== null && p95 > thresholds.p95_max)
    out.push({ level: 'warn', metric: 'P95 Latency', detail: `Current ${p95.toFixed(2)}s > Threshold ${thresholds.p95_max}s` });
  if (avgCost !== null && avgCost > thresholds.cost_max)
    out.push({ level: 'warn', metric: 'Avg Cost', detail: `Current $${avgCost.toFixed(4)} > Threshold $${thresholds.cost_max}` });
  return out;
}

