  </div>

  <!-- Token Economy subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🪙 토큰 경제</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      total:{label:'총 토큰',unit:'tokens',desc:'전체 태스크의 입출력 토큰 합계',hint:'Σ(input_tokens + output_tokens)'},
      input:{label:'Input 토큰',unit:'tokens',desc:'프롬프트·컨텍스트의 입력 토큰 합계',hint:'Σ input_tokens'},
      output:{label:'Output 토큰',unit:'tokens',desc:'생성된 응답의 출력 토큰 합계',hint:'Σ output_tokens'},
      avg_per_task:{label:'태스크당 평균',unit:'tokens',desc:'태스크 1건당 평균 토큰 사용량',hint:'total_tokens / total_tasks'},
      io_ratio:{label:'입출력 비율',unit:'%',desc:'출력 토큰 / 입력 토큰 비율 (높을수록 출력이 상대적으로 많음)',hint:'output_tokens / input_tokens × 100'},
    },
    formula(k,d){
      const em=d.efficiency_metrics||{};
      const tot=em.total_tokens||0;
      const inp=em.total_input_tokens||0;
      const out=em.total_output_tokens||0;
      const n=d.total_tasks||1;
      if(k==='total')return `총토큰 = ${$root.fmtNum(tot)}\n입력: ${$root.fmtNum(inp)} + 출력: ${$root.fmtNum(out)}`;
      if(k==='input')return `입력 토큰 = ${$root.fmtNum(inp)}\n비율: ${tot?((inp/tot)*100).toFixed(1):0}%`;
      if(k==='output')return `출력 토큰 = ${$root.fmtNum(out)}\n비율: ${tot?((out/tot)*100).toFixed(1):0}%`;
      if(k==='avg_per_task')return `태스크당 = ${$root.fmtNum(Math.round(tot/n))}\n= ${$root.fmtNum(tot)} / ${n}`;
      if(k==='io_ratio')return `입출력비율 = output/input×100\n= ${$root.fmtNum(out)}/${$root.fmtNum(inp)} = ${inp?((out/inp)*100).toFixed(1):0}%`;
      return '';
    },
    items(k,d){
      return [...(d.tasks||[])].sort((a,b)=>{
        const at=(a.tokens_used?.total||a.tokens_used||0);
        const bt=(b.tokens_used?.total||b.tokens_used||0);
        return bt-at;
      }).slice(0,20);
    },
    filterLabel(k){return '토큰 많은 태스크 Top20';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='total'}" @click="selK=selK==='total'?null:'total'">
        <div class="kpi-lbl">총 토큰</div>
        <div class="kpi-val" style="font-size:20px" x-text="$root.fmtNum(data.efficiency_metrics?.total_tokens||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='input'}" @click="selK=selK==='input'?null:'input'">
        <div class="kpi-lbl">Input 토큰</div>
        <div class="kpi-val" style="font-size:20px" x-text="$root.fmtNum(data.efficiency_metrics?.total_input_tokens||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='output'}" @click="selK=selK==='output'?null:'output'">
        <div class="kpi-lbl">Output 토큰</div>
