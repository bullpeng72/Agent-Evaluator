    /* ── lifecycle ── */
    async init() {
      this.dark = false;  // 기본 테마: 라이트 (리프레시 시 항상 라이트)
      this._applyDark();
      /* 이전에 선택한 모델 복원 (없으면 Claude Sonnet 4.5 기본 적용) */
      try {
        const sm = localStorage.getItem('ae-sel-model');
        if (sm) this.selModel = JSON.parse(sm);
        else {
          const def = this.pRows.find(r => r.model.includes('claude-sonnet-4-5'));
          if (def) { this.selModel = {...def}; localStorage.setItem('ae-sel-model', JSON.stringify(this.selModel)); }
        }
      } catch(e) {}
      // Nav parent map 사전 계산 (접기/펼치기용)
      let _curGroup = null;
      for (const n of this.nav) {
        if (n.group) _curGroup = n.id;
        else this._navParentMap[n.id] = _curGroup;
      }
      // Load server-persisted thresholds before refresh so anomaly detection uses saved values
      await this.loadSettings();
      await this.refresh();
      // 초기 로드 실패 시 1회 재시도 (서버 기동 직후 race condition 대비)
      if (!this.files.length) {
        await new Promise(r => setTimeout(r, 600));
        await this.refresh();
      }
      {% if watch %}
      this._connectSSE();
      // 폴링 백업: SSE 수신 실패 시에도 5초마다 파일 목록 자동 갱신 (silent=깜박거림 없음)
      setInterval(() => this.refresh(true), 5000);
      {% endif %}
      // 탭 전환 후 복귀 시 자동 갱신 (bfcache/탭 복원 대비)
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') this.refresh();
      });
      // Redraw charts whenever the active section changes (x-show containers
      // go display:none → block; Plotly needs a fresh render with correct size)
      this.$watch('sec', (newSec) => {
        this.$nextTick(() => requestAnimationFrame(() => this.drawCharts()));
        if (newSec === 'insights')    this.$nextTick(() => { this.loadPrevData(); });
        if (newSec === 'alerts')      this.loadAlerts();
        if (newSec === 'reliability') this.loadReliability();
        if (newSec === 'review' && !this.candidateFiles.length) this.loadCandidates();
        if (newSec === 'realtime') {
          this.loadRealtime();
          if (!this.realtimePolling)
            this.realtimePolling = setInterval(() => this.loadRealtime(), 15000);
        } else if (this.realtimePolling) {
          clearInterval(this.realtimePolling);
          this.realtimePolling = null;
        }
      });
    },
    _applyDark() {
      document.documentElement.classList.toggle('dark', this.dark);
    },
    toggleDark() { this.dark = !this.dark; this._applyDark(); },

    async refresh(silent = false) {
      // silent=true: 백그라운드 폴링용 — 로딩 스피너 없음, 실제 변경 시에만 UI 업데이트
      if (!silent) this.loading = true;
      try {
        const res = await fetch('/api/results', {cache: 'no-store'});
        const rd = await res.json();
        // /api/results returns { total, page, files: [...] } — extract the array
        const list = Array.isArray(rd) ? rd : (rd.files ?? []);

        // 파일 목록 변경 여부 확인 (id 서명 비교)
        const newSig = list.map(f => f.id).sort().join(',');
        const oldSig = this.files.map(f => f.id).sort().join(',');
        const filesChanged = newSig !== oldSig;

        // 현재 파일의 이전 태스크 수 저장 (files 교체 전)
        const prevTaskCount = this.selId
          ? (this.files.find(f => f.id === this.selId)?.total_tasks ?? -1) : -1;

        // 파일 목록이 바뀐 경우에만 dropdown 업데이트 (깜박거림 방지)
        if (filesChanged || !silent) {
          this.files = list;
          // x-for 옵션 렌더링이 완료된 후 selId 설정 (Alpine.js 타이밍 이슈 방지)
          await this.$nextTick();
          if (list.length && !this.selId) this.selId = list[0].id;
          await this.$nextTick();
        }

        // 현재 파일 데이터 리로드: 수동 새로고침이거나 파일/태스크 수 변경 시에만
        if (this.selId) {
          const curTaskCount = list.find(f => f.id === this.selId)?.total_tasks ?? -1;
          if (!silent || filesChanged || curTaskCount !== prevTaskCount) {
            await this.loadFile(this.selId);
          }
        }
      } catch(e) { console.warn('refresh error', e); }
      finally { if (!silent) this.loading = false; }
    },

    async loadFile(id) {
      this.selId = id;
      this.loading = true;
      try {
        const [res, rConv, rFb, rAnomaly, rCost, rAlertFile] = await Promise.all([
          fetch(`/api/results/${id}`),
          fetch(`/api/conversation/${id}`).catch(()=>null),
          fetch(`/api/feedback/${id}`).catch(()=>null),
          fetch(`/api/anomalies/${id}`).catch(()=>null),
          fetch(`/api/cost/${id}`).catch(()=>null),
          fetch(`/api/alerts/file/${encodeURIComponent(id)}`).catch(()=>null),
        ]);
        this.data         = await res.json();
        this.convData     = (rConv      && rConv.ok)      ? await rConv.json()      : null;
        this.feedbackData = (rFb        && rFb.ok)        ? await rFb.json()        : null;
        this.anomalyData  = (rAnomaly   && rAnomaly.ok)   ? await rAnomaly.json()   : null;
        this.costData     = (rCost      && rCost.ok)      ? await rCost.json()      : null;
        // 파일별 알림 히스토리 — today와 summary 구조로 통합하여 alertData를 덮어씀
        if (rAlertFile && rAlertFile.ok) {
          const fd = await rAlertFile.json();
          if (fd.total > 0) {
            this.alertData = { today: fd, summary: fd.summary || {} };
          }
        }
        this.convSelected = null;
        // Double rAF: wait for Alpine DOM update + browser layout before Plotly measures containers
        this.$nextTick(() => requestAnimationFrame(() => requestAnimationFrame(() => this.drawCharts())));
      } catch(e) { console.warn('loadFile error', e); }
      finally { this.loading = false; }
    },

    async loadAlerts() {
      try {
        const [rToday, rSummary] = await Promise.all([
          fetch('/api/alerts/today').catch(()=>null),
          fetch('/api/alerts/summary').catch(()=>null),
        ]);
        const today   = (rToday   && rToday.ok)   ? await rToday.json()   : {};
        const summary = (rSummary && rSummary.ok) ? await rSummary.json() : {};
        // 파일이 선택되어 있고 해당 파일의 알림이 이미 로드됐으면 덮어쓰지 않음
        if (!this.selId || !(this.alertData?.today?.total > 0)) {
          this.alertData = { today, summary };
        }
      } catch(e) { console.warn('loadAlerts error', e); }
    },

    async loadCandidates() {
      this.reviewLoading = true;
      try {
        const r = await fetch('/api/golden/candidates').catch(()=>null);
        this.candidateFiles = (r && r.ok) ? await r.json() : [];
      } catch(e) { this.candidateFiles = []; }
      finally { this.reviewLoading = false; }
    },

    async loadCandidateFile(name) {
      this.reviewFile = name;
      this.reviewLoading = true;
      try {
        const r = await fetch(`/api/golden/candidates/${encodeURIComponent(name)}`).catch(()=>null);
        this.candidateCases = (r && r.ok) ? await r.json() : [];
      } catch(e) { this.candidateCases = []; }
      finally { this.reviewLoading = false; }
    },

    async approveCase(name, idx) {
      const r = await fetch(`/api/golden/candidates/${encodeURIComponent(name)}/approve/${idx}`, {method:'POST'}).catch(()=>null);
      if (r && r.ok) { await this.loadCandidateFile(name); await this.loadCandidates(); }
    },

    async rejectCase(name, idx) {
      const r = await fetch(`/api/golden/candidates/${encodeURIComponent(name)}/reject/${idx}`, {method:'POST'}).catch(()=>null);
      if (r && r.ok) { await this.loadCandidateFile(name); await this.loadCandidates(); }
    },

    async mergeApproved(name) {
      const r = await fetch(`/api/golden/candidates/${encodeURIComponent(name)}/merge`, {method:'POST'}).catch(()=>null);
      if (r && r.ok) { const d = await r.json(); alert(`✅ ${d.merged} items merged into ${d.filename}.`); await this.loadCandidates(); }
    },

    async loadRealtime() {
      try {
        // 1순위: 라이브 StreamingEvaluator
        const r = await fetch(`/api/stream/live-stats?window=${this.realtimeWindow}`).catch(()=>null);
        if (r && r.ok) {
          const stats = await r.json();
          if (stats.available) {
            this.realtimeStats = { ...this.realtimeStats, [this.realtimeWindow]: stats };
            return;
          }
        }
        // 2순위: 선택된 파일의 저장된 스냅샷 (오프라인 히스토리)
        if (this.selId) {
          const r2 = await fetch(`/api/stream/snapshot/${encodeURIComponent(this.selId)}?window=${this.realtimeWindow}`).catch(()=>null);
          if (r2 && r2.ok) {
            const snap = await r2.json();
            if (snap.available) {
              // 모든 윈도우 데이터를 한 번에 채움
              const all = snap.all_windows || {};
              const merged = { ...this.realtimeStats };
              for (const [w, v] of Object.entries(all)) {
                merged[w] = { ...v, available: true, source: 'file_snapshot' };
              }
              this.realtimeStats = merged;
            }
          }
        }
      } catch(e) {}
    },

    {% if watch %}
    _connectSSE() {
      const es = new EventSource('/api/stream');
      // SSE 이벤트: silent refresh — 변경된 경우에만 UI 업데이트 (깜박거림 없음)
      const _onUpdate = async () => { await this.refresh(true); };
      es.addEventListener('update', _onUpdate);           // named event (server v0.7.4+)
      es.addEventListener('message', async (e) => {       // fallback: anonymous data:
        try { if (JSON.parse(e.data).type === 'update') await _onUpdate(); } catch(_) {}
      });
      es.addEventListener('open', () => { this.connected = true; });
      es.addEventListener('error', () => { this.connected = false; });
    },
    {% endif %}

    /* ── helper functions ── */
    pct(v, scale=1) { if (v==null) return 0; return Math.min(100, Math.max(0, (v/scale)*100)); },
    sec_(v) { if (v==null) return '—'; return v.toFixed(2)+'s'; },
    cost(v) { if (v==null) return '—'; return '$'+v.toFixed(4); },
    fmtNum(v) { if (v==null) return '—'; if (v>=1e6) return (v/1e6).toFixed(1)+'M'; if (v>=1e3) return (v/1e3).toFixed(1)+'K'; return v.toString(); },
    bc(v, hi=90, lo=70) {
      if (v==null) return 'var(--text2)';
      if (v>=hi) return 'var(--green)';
      if (v>=lo) return 'var(--yellow)';
      return 'var(--red)';
    },
    bc2lat(v) {
      if (v==null) return 'var(--text2)';
      if (v<=2) return 'var(--green)';
      if (v<=5) return 'var(--yellow)';
      return 'var(--red)';
    },
    hallRate() {
      const am = this.data?.accuracy_metrics || {};
      const hall = am.hallucination || {};
      const rate = hall.overall_rate ?? hall.hallucination_rate ?? null;
      if (rate != null) return rate;
      // fallback: compute from total_evaluated / total_flagged
      const tot = hall.total_evaluated || 0;
      const flagged = hall.total_flagged || 0;
      return tot > 0 ? (flagged / tot) * 100 : 0;
    },
    tcr_() {
      const am = this.data?.accuracy_metrics || {};
      const tcr = am.tcr || {};
      const v = tcr.tcr ?? tcr.task_completion_rate ?? null;
      if (v != null) return v;
      // fallback: compute from tasks
      const tasks = this.data?.tasks || [];
      if (!tasks.length) return 0;
      return tasks.reduce((s, t) => s + (t.completion_score || 0), 0) / tasks.length * 100;
    },
    acc_() {
      const am = this.data?.accuracy_metrics || {};
      const acc = am.accuracy_scores || {};
      const v = acc.overall_accuracy ?? acc.accuracy_rate ?? null;
      if (v != null) return v;
      // fallback: compute from tasks
      const tasks = this.data?.tasks || [];
      if (!tasks.length) return 0;
      return tasks.reduce((s, t) => s + (t.accuracy_score || 0), 0) / tasks.length * 100;
    },
    taskTypes() {
      const tasks = this.data?.tasks || [];
      return [...new Set(tasks.map(t => t.task_type).filter(Boolean))];
    },
    filteredTasks() {
      const tasks = this.data?.tasks || [];
      const { type, status, q } = this.taskFilter;
      return tasks.filter(t => {
        if (type && t.task_type !== type) return false;
        if (status === 'success' && !t.success) return false;
        if (status === 'fail' && t.success) return false;
        if (q) {
          const ql = q.toLowerCase();
          if (!(t.task_id||'').toLowerCase().includes(ql) &&
              !(t.errors||[]).join(' ').toLowerCase().includes(ql)) return false;
        }
        return true;
      });
    },
    slowTasks(n=5) {
      const tasks = this.data?.tasks || [];
      return [...tasks].sort((a,b) => (b.execution_time||0)-(a.execution_time||0)).slice(0,n);
    },
    deployGates() {
      if (!this.data) return [];
      const am = this.data?.accuracy_metrics || {};
      const em = this.data?.efficiency_metrics || {};
      const tasks = this.data?.tasks || [];
      const n = tasks.length || 1;
      const t = this.thresholds; // fraction-based: tcr_min=0.7, acc_min=0.7, hall_max=0.2, p95_max=5, cost_max=0.05

      // Actual values as fractions (0-1)
      const tcrRaw = am.tcr?.tcr ?? am.tcr?.task_completion_rate ?? null;
      const tcr = tcrRaw != null ? tcrRaw / 100 : tasks.reduce((s,x) => s+(x.completion_score||0), 0) / n;
      const accRaw = am.accuracy_scores?.overall_accuracy ?? am.accuracy_scores?.accuracy_rate ?? null;
      const acc = accRaw != null ? accRaw / 100 : tasks.reduce((s,x) => s+(x.accuracy_score||0), 0) / n;
      const hallRaw = am.hallucination?.overall_rate ?? am.hallucination?.hallucination_rate ?? null;
      const hallEv  = am.hallucination?.total_evaluated || 0;
      const hallFl  = am.hallucination?.total_flagged  || 0;
      const hall = hallRaw != null ? hallRaw / 100 : (hallEv > 0 ? hallFl / hallEv : null);
      const p95  = em.latency?.p95 ?? em.p95_latency ?? null;
      const cost = this.cAvg(this.data);  // 전역 selModel 반영

      // Stage thresholds derived from user settings (dev = relaxed, staging = target, prod = strict)
      const devTCR  = Math.max(0.5,  t.tcr_min  - 0.1);
      const devACC  = Math.max(0.3,  t.acc_min  - 0.15);
      const devHALL = +(t.hall_max * 2).toFixed(3);
      const stgTCR  = t.tcr_min;
      const stgACC  = Math.min(1.0,  t.acc_min  + 0.05);
      const stgHALL = t.hall_max;
      const stgP95  = t.p95_max;
      const prdTCR  = Math.min(1.0,  t.tcr_min  + 0.05);
      const prdACC  = Math.min(1.0,  t.acc_min  + 0.1);
      const prdHALL = +(t.hall_max * 0.6).toFixed(3);
      const prdP95  = +(t.p95_max  * 0.75).toFixed(1);
      const prdCOST = t.cost_max;

      const pct = v => (v * 100).toFixed(1) + '%';
      const gates = [
        {
          label: '🔬 Dev', key: 'dev',
          criteria: [
            { name: `TCR ≥ ${(devTCR*100).toFixed(0)}%`,      pass: tcr  >= devTCR,                        val: pct(tcr) },
            { name: `Accuracy ≥ ${(devACC*100).toFixed(0)}%`, pass: acc  >= devACC,                        val: pct(acc) },
            { name: `Hall ≤ ${(devHALL*100).toFixed(0)}%`,    pass: hall == null || hall <= devHALL,        val: hall != null ? pct(hall) : 'N/A' },
          ],
        },
        {
          label: '🚀 Staging', key: 'staging',
          criteria: [
            { name: `TCR ≥ ${(stgTCR*100).toFixed(0)}%`,      pass: tcr  >= stgTCR,                        val: pct(tcr) },
            { name: `Accuracy ≥ ${(stgACC*100).toFixed(0)}%`, pass: acc  >= stgACC,                        val: pct(acc) },
            { name: `Hall ≤ ${(stgHALL*100).toFixed(0)}%`,    pass: hall == null || hall <= stgHALL,        val: hall != null ? pct(hall) : 'N/A' },
            { name: `P95 ≤ ${stgP95}s`,                       pass: p95  == null || p95  <= stgP95,         val: p95 != null ? p95.toFixed(2) + 's' : 'N/A' },
          ],
        },
        {
          label: '🏭 Production', key: 'prod',
          criteria: [
            { name: `TCR ≥ ${(prdTCR*100).toFixed(0)}%`,                      pass: tcr  >= prdTCR,                   val: pct(tcr) },
            { name: `Accuracy ≥ ${(prdACC*100).toFixed(0)}%`,                 pass: acc  >= prdACC,                   val: pct(acc) },
            { name: `Hall ≤ ${(prdHALL*100).toFixed(0)}%`,                    pass: hall == null || hall <= prdHALL,  val: hall != null ? pct(hall) : 'N/A' },
            { name: `P95 ≤ ${prdP95}s`,                                        pass: p95  == null || p95  <= prdP95,  val: p95 != null ? p95.toFixed(2) + 's' : 'N/A' },
            { name: `Cost ≤ $${parseFloat(prdCOST.toFixed(3))}/task`,         pass: cost == null || cost <= prdCOST, val: cost != null ? '$' + cost.toFixed(4) : 'N/A' },
          ],
        },
      ];
      return gates.map(g => ({
        ...g,
        passed: g.criteria.filter(c => c.pass).length,
        total:  g.criteria.length,
        cls:    g.criteria.every(c => c.pass)  ? 'pass'
              : g.criteria.every(c => !c.pass) ? 'fail'
              : 'partial',
      }));
    },
    autoAnomalies() { return autoAnomalies_inner(this.data, this.thresholds, this.cAvg(this.data)); },
    _perspVal(key) {
      const adv = this.data?.advanced || {};
      return adv[key] ?? adv.summary?.[key] ?? null;
    },
    zScoreAnomalies() {
      const tasks = this.data?.tasks || [];
      if (tasks.length < 3) return [];
      const lats = tasks.map(t => t.execution_time).filter(v => v!=null);
      const accs = tasks.map(t => t.accuracy_score).filter(v => v!=null);
      const mean = arr => arr.reduce((a,b)=>a+b,0)/arr.length;
      const std = arr => { const m=mean(arr); return Math.sqrt(arr.reduce((a,b)=>a+(b-m)**2,0)/arr.length); };
      const mLat=mean(lats), sLat=std(lats)||1, mAcc=mean(accs), sAcc=std(accs)||1;
      const out = [];
      for (const t of tasks) {
        const zLat = t.execution_time!=null ? (t.execution_time-mLat)/sLat : null;
        const zAcc = t.accuracy_score!=null ? (t.accuracy_score-mAcc)/sAcc : null;
        if ((zLat!=null && Math.abs(zLat)>2) || (zAcc!=null && Math.abs(zAcc)>2))
          out.push({ task_id:t.task_id, task_type:t.task_type, lat:t.execution_time, zLat, acc:t.accuracy_score, zAcc });
      }
      return out.sort((a,b) => Math.max(Math.abs(b.zLat||0),Math.abs(b.zAcc||0)) - Math.max(Math.abs(a.zLat||0),Math.abs(a.zAcc||0)));
    },
    corrMatrix() {
      const tasks = this.data?.tasks || [];
      const keys = ['accuracy_score','execution_time','tokens_used','completion_score'];
      const labels = ['accuracy','latency','tokens','completion'];
      const pearson = (xs,ys) => {
        const n=xs.length; if(!n) return null;
        const mx=xs.reduce((a,b)=>a+b,0)/n, my=ys.reduce((a,b)=>a+b,0)/n;
        let num=0,dx=0,dy=0;
        for (let i=0;i<n;i++) { num+=(xs[i]-mx)*(ys[i]-my); dx+=(xs[i]-mx)**2; dy+=(ys[i]-my)**2; }
        if (!dx||!dy) return null;
        return num/Math.sqrt(dx*dy);
      };
      return keys.map((rk,ri) => ({
        label: labels[ri],
        vals: keys.map((ck,ci) => {
          if (ri===ci) return 1;
          const pairs = tasks.map(t => [t[rk],t[ck]]).filter(([a,b])=>a!=null&&b!=null);
          if (pairs.length<3) return null;
          return pearson(pairs.map(p=>p[0]), pairs.map(p=>p[1]));
        })
      }));
    },
    corrPairs() {
      const tasks = this.data?.tasks || [];
      if (tasks.length < 3) return [];
      const _tok = t => {
        const v=(t.tokens_used?.total)||(t.tokens_used?.input||0)+(t.tokens_used?.output||0);
        return (v>0)?v:null;
      };
      const pearsonPair = (keyA, keyB, getA, getB) => {
        const pairs = tasks.map(t=>[getA(t),getB(t)]).filter(([a,b])=>a!=null&&b!=null&&!isNaN(a)&&!isNaN(b));
        if (pairs.length < 3) return null;
        const xs=pairs.map(p=>p[0]), ys=pairs.map(p=>p[1]);
        const n=xs.length;
        const mx=xs.reduce((s,v)=>s+v,0)/n, my=ys.reduce((s,v)=>s+v,0)/n;
        const num=xs.reduce((s,x,i)=>s+(x-mx)*(ys[i]-my),0);
        const dx=Math.sqrt(xs.reduce((s,x)=>s+(x-mx)**2,0));
        const dy=Math.sqrt(ys.reduce((s,y)=>s+(y-my)**2,0));
        return (dx&&dy)?+(num/(dx*dy)).toFixed(3):null;
      };
      const defs = [
        { label:'Accuracy ↔ Latency',
          getA:t=>t.accuracy_score*100, getB:t=>t.execution_time||0,
          pos:'Longer latency tends to correlate with higher accuracy — complex tasks may require more processing time.',
          neg:'Longer latency tends to correlate with lower accuracy — suspect quality degradation due to timeouts or delays.',
          none:'No clear relationship between latency and accuracy — latency does not significantly affect current quality.',
          posAction:'Ensure timeout headroom for complex tasks and consider response caching.',
          negAction:'Analyze failure causes in high-latency tasks and consider prompt optimization or model upgrade.' },
        { label:'Accuracy ↔ Token Count',
          getA:t=>t.accuracy_score*100, getB:t=>_tok(t),
          pos:'Higher token usage tends to correlate with higher accuracy — detailed responses contribute to quality improvement.',
          neg:'Higher token usage tends to correlate with lower accuracy — verbose responses may actually hurt accuracy.',
          none:'No clear relationship between token count and accuracy — response length does not determine quality.',
          posAction:'Maintain appropriate context length while designing prompts to reduce unnecessary repetition.',
          negAction:'Set max_tokens limits and improve prompts to focus on core answers.' },
        { label:'Accuracy ↔ Completion Rate',
          getA:t=>t.accuracy_score*100, getB:t=>t.completion_score*100,
          pos:'Higher completion rate tends to correlate with higher accuracy — task success and accuracy are consistently linked.',
          neg:'Completion rate and accuracy are inversely related — may be complete but inaccurate, or failed but partially scored.',
          none:'No correlation between completion rate and accuracy — the two criteria operate independently.',
          posAction:'Maintain current evaluation criteria. Both metrics will improve together.',
          negAction:'Re-examine completion and quality criteria and refine partial completion handling logic.' },
        { label:'Latency ↔ Token Count',
          getA:t=>t.execution_time||0, getB:t=>_tok(t),
          pos:'Higher token usage tends to correlate with longer latency — this is the expected normal pattern.',
          neg:'High tokens but short latency or reverse pattern — may be influenced by caching or batch processing.',
          none:'No clear relationship between token count and latency — latency may be determined by other factors (network, queue).',
          posAction:'Batch high-token tasks or reduce perceived latency with streaming responses.',
          negAction:'Re-analyze the latency cause. Factors beyond tokens like network and error retries may be primary drivers.' },
      ];
      return defs.map(d => {
        const r = pearsonPair(null, null, d.getA, d.getB);
        if (r === null) return { label:d.label, r:0, interp:'Insufficient data (no token info or fewer than 3 measurements)', action:null, noData:true };
        const absR = Math.abs(r);
        let interpText, action;
        if (absR < 0.2) { interpText = d.none; action = null; }
        else if (r > 0) { interpText = d.pos; action = d.posAction; }
        else { interpText = d.neg; action = d.negAction; }
        return { label:d.label, r, interp:interpText, action, noData:false };
      });
    },
    bottleneckAnalysis() {
      const tasks = this.data?.tasks||[]; if (!tasks.length) return [];
      const results = [];
      const slowThreshold = (this.data?.efficiency_metrics?.latency?.p95 || 2);
      const slow = [...tasks].sort((a,b)=>(b.execution_time||0)-(a.execution_time||0))
                              .filter(t=>(t.execution_time||0)>slowThreshold);
      if (slow.length) {
        results.push({severity:'high',
          title:`Slow tasks: ${slow.length} (P95 exceeded)`,
          desc:`Found tasks exceeding P95 threshold (${slowThreshold.toFixed(2)}s)`,
          action:'Consider simplifying prompts, caching, or async processing for these tasks, or switch to a faster model.',
          tasks: slow.slice(0,5)});
      }
      const typeLatency={};
      tasks.forEach(t=>{ const k=t.task_type||'unknown'; (typeLatency[k]=typeLatency[k]||[]).push(t.execution_time||0); });
      const worstType = Object.entries(typeLatency)
        .map(([k,v])=>({type:k,avg:v.reduce((a,b)=>a+b,0)/v.length,n:v.length}))
        .sort((a,b)=>b.avg-a.avg)[0];
      if (worstType && worstType.avg > slowThreshold*0.7) {
        results.push({severity:'medium',
          title:`${worstType.type} type is the slowest`,
          desc:`Average ${worstType.avg.toFixed(2)}s (${worstType.n} tasks)`,
          action:`Intensively optimize prompts/logic for ${worstType.type} type tasks, or set up a dedicated serving path.`,
          tasks:[]});
      }
      const _tok = t => (t.tokens_used?.total)||(t.tokens_used?.input||0)+(t.tokens_used?.output||0);
      const avgTok = tasks.reduce((s,t)=>s+_tok(t),0)/tasks.length;
      const heavyTok = [...tasks].sort((a,b)=>_tok(b)-_tok(a)).filter(t=>_tok(t)>avgTok*2);
      if (heavyTok.length) {
        results.push({severity:'low',
          title:`High token usage tasks: ${heavyTok.length}`,
          desc:`Token usage more than 2x average (baseline: ${Math.round(avgTok)} tokens)`,
          action:'Set max_tokens limits and keep system prompts concise to reduce token costs.',
          tasks: heavyTok.slice(0,5)});
      }
      const failedAvgLat = tasks.filter(t=>!t.success).reduce((s,t,_,a)=>s+(t.execution_time||0)/a.length,0)||0;
      const successAvgLat = tasks.filter(t=>t.success).reduce((s,t,_,a)=>s+(t.execution_time||0)/a.length,0)||0;
      if (failedAvgLat>0 && successAvgLat>0 && failedAvgLat>successAvgLat*1.3) {
        results.push({severity:'medium',
          title:'Failed tasks are slower than successful tasks',
          desc:`Failed avg ${failedAvgLat.toFixed(2)}s vs Success avg ${successAvgLat.toFixed(2)}s`,
          action:'Lower timeout settings to encourage fail-fast behavior and review exponential backoff in retry logic.',
          tasks:[]});
      }
      return results;
    },
    ragKpis() {
      const ragM = this.data?.rag_metrics || {};
      const perTask = this.data?.advanced?.per_task || [];
      const ragPT = perTask.filter(t => t.ragas_faithfulness != null);
      const _avg = (arr) => Array.isArray(arr) && arr.length ? arr.reduce((a,b)=>a+b,0)/arr.length : null;
      const _ptAvg = (key) => {
        const vals = ragPT.map(t => t['ragas_'+key]).filter(v => v != null);
        return vals.length ? vals.reduce((a,b)=>a+b,0)/vals.length : null;
      };
      const avg = key => {
        const v = ragM[key];
        if (Array.isArray(v) && v.length) return _avg(v);
        if (v != null) return v;
        return _ptAvg(key);
      };
      const n = ragPT.length;
      const f=avg('faithfulness'), a=avg('answer_relevancy'), r=avg('context_recall'), p=avg('context_precision');
      const overallVals=[f,a,r,p].filter(v=>v!=null);
      const overall = overallVals.length ? overallVals.reduce((s,v)=>s+v,0)/overallVals.length : null;
      return {
        faithfulness: f,
        answer_relevancy: a,
        context_recall: r,
        context_precision: p,
        overall,
        n,
      };
    },
    deepevalKpis() {
      const adv = this.data?.advanced || {};
      // summary = advanced_metrics_summary: {g_eval_score:{mean,min,max}, ...}
      const summary = adv.summary || {};
      const deKeyList = ['g_eval_score','hallucination_score','toxicity_score','bias_score','answer_relevancy_score'];
      // Build metrics map: key -> mean value
      const metrics = {};
      deKeyList.forEach(k => { if (summary[k]?.mean != null) metrics[k] = summary[k].mean; });
      // Fallback: compute mean from per_task if summary missing
      const pt = adv.per_task || [];
      deKeyList.forEach(k => {
        if (metrics[k] == null) {
          const vals = pt.map(t => t[k]).filter(v => v != null && typeof v === 'number');
          if (vals.length) metrics[k] = vals.reduce((a,b)=>a+b,0)/vals.length;
        }
      });
      const dePT = pt.filter(t => deKeyList.some(k => t[k] != null));
      return {
        metrics,
        summary,
        n: dePT.length,
        keys: deKeyList.filter(k => metrics[k] != null),
      };
    },
    frameworkDist(data) {
      const tasks = (data||this.data)?.tasks || [];
      const cnt = {}, suc = {};
      for (const t of tasks) {
        const fw = t.framework || t.agent_framework || 'unknown';
        cnt[fw] = (cnt[fw]||0) + 1;
        if (t.success) suc[fw] = (suc[fw]||0) + 1;
      }
      const total = tasks.length || 1;
      return Object.entries(cnt).map(([name, count]) => ({
        name,
        count,
        rate: count > 0 ? (suc[name]||0) / count * 100 : 0,
        pct: count / total * 100,
      })).sort((a,b)=>b.count-a.count);
    },
    toolCallByTool(data) {
      const src = (data||this.data);
      const counts = {};

      // [1순위] tool_selections[].actual_tools — 실제 사용 도구 이름 배열 (JSON에 항상 존재)
      for (const s of (src?.agentic?.tool_selections || [])) {
        for (const name of (s.actual_tools || [])) {
          if (name) counts[name] = (counts[name]||0) + 1;
        }
      }
      if (Object.keys(counts).length > 0) {
        return Object.entries(counts).map(([name,calls])=>({name,calls,success_rate:null}))
          .sort((a,b)=>b.calls-a.calls);
      }

      // [2순위] tool_call_executions[].tool_call_counts (dict 또는 배열)
      for (const t of (src?.agentic?.tool_call_executions || [])) {
        const bt = t.tool_call_counts || {};
        if (Array.isArray(bt)) {
          for (const item of bt) {
            const n = item.tool_name||item.name||'?';
            counts[n] = (counts[n]||0) + (item.count||item.calls||1);
          }
        } else {
          for (const [n, v] of Object.entries(bt)) {
            counts[n] = (counts[n]||0) + (typeof v==='object'?(v.count||v.calls||0):Number(v)||0);
          }
        }
        // tool_names 배열 fallback
        if (!Object.keys(bt).length) {
          for (const n of (t.tool_names||[])) {
            counts[n] = (counts[n]||0) + 1;
          }
        }
      }
      if (Object.keys(counts).length > 0) {
        return Object.entries(counts).map(([name,calls])=>({name,calls,success_rate:null}))
          .sort((a,b)=>b.calls-a.calls);
      }

      // [3순위] data.advanced 경로 (legacy)
      const adv = src?.advanced || {};
      const tool = adv.tool_call || adv.tool_calls || {};
      const byTool = tool.by_tool || tool.tool_distribution || {};
      return Object.entries(byTool).map(([name,v])=>({
        name,
        calls: typeof v==='object'?(v.calls||v.count||0):v,
        success_rate: typeof v==='object'?(v.success_rate??null):null,
      })).sort((a,b)=>b.calls-a.calls);
    },
    /* ── compare ── */
    toggleCompare(id) {
      const idx = this.compareIds.indexOf(id);
      if (idx >= 0) this.compareIds.splice(idx, 1);
      else if (this.compareIds.length < 5) this.compareIds.push(id);
      this.compareGroupBy = '';
      this.compareGroupTotal = 0;
      this.comparePairwise = null;
    },
    async loadReliability() {
      if (!this.data) return;
      this.reliabilityLoading = true;
      try {
        const r = await fetch(`/api/results/${this.data.id}/reliability`);
        if (r.ok) this.reliabilityData = await r.json();
      } catch(e) { console.warn('[Phase2] reliability load error', e); }
      finally { this.reliabilityLoading = false; }
    },
    async loadCompareData() {
      this.comparePairwise = null;
      if (!this.compareIds.length) { this.compareData = []; return; }
      this.compareLoading = true;
      try {
        const results = await Promise.all(this.compareIds.map(id => fetch(`/api/results/${id}`).then(r => r.json())));
        this.compareData = results;
        this.$nextTick(() => this.drawCompareChart());
      } catch(e) { console.warn('compare error', e); }
      finally { this.compareLoading = false; }
    },
    /* SPEC-025: group_by로 프롬프트/에이전트 버전별 최신 파일을 자동 선택
       (compareIds를 재계산할 뿐 — 이후 렌더링은 기존 compareData 흐름을 그대로 재사용) */
    async applyCompareGroupBy(field) {
      this.compareGroupBy = field;
      this.compareGroupTotal = 0;
      if (!field) return;
      this.compareGroupLoading = true;
      try {
        const r = await fetch(`/api/compare?group_by=${encodeURIComponent(field)}`);
        if (!r.ok) { console.warn('group_by compare failed', r.status); return; }
        const j = await r.json();
        const found = (j.files || []).filter(f => f.found);
        this.compareGroupTotal = found.length;
        this.compareIds = found.map(f => f.file_id).slice(0, 5);
        await this.loadCompareData();
      } catch(e) { console.warn('group_by compare error', e); }
      finally { this.compareGroupLoading = false; }
    },
    /* SPEC-025: 페어와이즈 LLM Judge — 정확히 2개 파일 선택 시에만 의미가 있다 */
    async loadComparePairwise() {
      if (this.compareIds.length !== 2) { this.comparePairwise = null; return; }
      this.comparePairwiseLoading = true;
      try {
        const idsParam = this.compareIds.join(',');
        const r = await fetch(`/api/compare?ids=${encodeURIComponent(idsParam)}&detailed=true&pairwise=true`);
        if (!r.ok) { console.warn('pairwise compare failed', r.status); this.comparePairwise = null; return; }
        const j = await r.json();
        this.comparePairwise = j.pairwise || null;
      } catch(e) { console.warn('pairwise compare error', e); this.comparePairwise = null; }
      finally { this.comparePairwiseLoading = false; }
    },
    compareHtmlExportUrl() {
      const params = new URLSearchParams();
      if (this.compareGroupBy) params.set('group_by', this.compareGroupBy);
      else params.set('ids', this.compareIds.join(','));
      if (this.cmpTab === 'pairwise') params.set('pairwise', 'true');
      return `/api/export/html/compare?${params.toString()}`;
    },
    /* improve — Phase 8: agent_evaluator.rca.diagnose()를 대시보드에 노출 */
    async loadImproveDiagnosis() {
      if (!this.improveCurrentId) return;
      this.improveLoading = true;
      this.improveError = null;
      this.improveResult = null;
      try {
        const params = new URLSearchParams();
        if (this.improveBaselineId) params.set('baseline_id', this.improveBaselineId);
