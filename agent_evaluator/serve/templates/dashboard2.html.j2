</div><!-- /external -->

<!-- ══ SECTION 4: PERFORMANCE ══ -->
<div x-show="data && sec==='performance'" x-cloak>

  <!-- Latency subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">⏱ 지연 시간</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      mean:{label:'평균',unit:'s',desc:'전체 태스크의 평균 응답 시간',hint:'avg(execution_time)'},
      p50:{label:'P50 (중앙값)',unit:'s',desc:'50번째 백분위 지연 — 절반의 태스크가 이보다 빠름',hint:'median(execution_time)'},
      p90:{label:'P90',unit:'s',desc:'90번째 백분위 지연 — 90%의 태스크가 이보다 빠름',hint:'90th percentile(execution_time)'},
      p95:{label:'P95',unit:'s',desc:'95번째 백분위 지연 — SLA 기준으로 자주 사용',hint:'95th percentile(execution_time)'},
      p99:{label:'P99',unit:'s',desc:'99번째 백분위 지연 — 극단적 느린 케이스',hint:'99th percentile(execution_time)'},
      maximum:{label:'최대',unit:'s',desc:'가장 느린 태스크의 응답 시간',hint:'max(execution_time)'},
      stddev:{label:'표준편차',unit:'s',desc:'지연 시간의 분산 — 낮을수록 일정한 성능',hint:'std(execution_time)'},
    },
    formula(k,d){
      const em=d.efficiency_metrics||{};
      if(k==='mean')return `평균 지연 = ${$root.sec_(em.avg_latency||em.latency?.mean||0)}\n전체 태스크 평균`;
      if(k==='p50')return `P50 = ${$root.sec_(em.p50_latency||em.latency?.p50||0)}\n50번째 백분위`;
      if(k==='p90')return `P90 = ${$root.sec_(em.p90_latency||em.latency?.p90||0)}\n90번째 백분위`;
      if(k==='p95')return `P95 = ${$root.sec_(em.p95_latency||em.latency?.p95||0)}\n95번째 백분위 (SLA 기준)`;
      if(k==='p99')return `P99 = ${$root.sec_(em.p99_latency||em.latency?.p99||0)}\n99번째 백분위`;
      if(k==='maximum')return `최대 = ${$root.sec_(em.max_latency||em.latency?.max||0)}`;
      if(k==='stddev')return `표준편차 = ${$root.sec_(em.std_latency||em.latency?.std||0)}`;
      return '';
    },
    items(k,d){
      const t=d.tasks||[];
      if(k==='maximum'||k==='p99'||k==='p95'||k==='p90')return [...t].sort((a,b)=>(b.execution_time||0)-(a.execution_time||0)).slice(0,15);
      return [...t].sort((a,b)=>(a.execution_time||0)-(b.execution_time||0)).slice(0,15);
    },
    filterLabel(k){return ['maximum','p99','p95','p90'].includes(k)?'느린 태스크 Top15':'빠른 태스크 Top15';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='mean'}" @click="selK=selK==='mean'?null:'mean'">
        <div class="kpi-lbl">평균</div>
        <div class="kpi-val" x-text="$root.sec_(data.efficiency_metrics?.avg_latency||data.efficiency_metrics?.latency?.mean||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='p50'}" @click="selK=selK==='p50'?null:'p50'">
        <div class="kpi-lbl">P50</div>
        <div class="kpi-val" x-text="$root.sec_(data.efficiency_metrics?.p50_latency||data.efficiency_metrics?.latency?.p50||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='p90'}" @click="selK=selK==='p90'?null:'p90'">
        <div class="kpi-lbl">P90</div>
        <div class="kpi-val" :style="`color:${$root.bc2lat(data.efficiency_metrics?.p90_latency||data.efficiency_metrics?.latency?.p90||0)}`"
             x-text="$root.sec_(data.efficiency_metrics?.p90_latency||data.efficiency_metrics?.latency?.p90||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='p95'}" @click="selK=selK==='p95'?null:'p95'">
        <div class="kpi-lbl">P95</div>
        <div class="kpi-val" :style="`color:${$root.bc2lat(data.efficiency_metrics?.p95_latency||data.efficiency_metrics?.latency?.p95||0)}`"
             x-text="$root.sec_(data.efficiency_metrics?.p95_latency||data.efficiency_metrics?.latency?.p95||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='p99'}" @click="selK=selK==='p99'?null:'p99'">
        <div class="kpi-lbl">P99</div>
        <div class="kpi-val" :style="`color:${$root.bc2lat(data.efficiency_metrics?.p99_latency||data.efficiency_metrics?.latency?.p99||0)}`"
             x-text="$root.sec_(data.efficiency_metrics?.p99_latency||data.efficiency_metrics?.latency?.p99||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='maximum'}" @click="selK=selK==='maximum'?null:'maximum'">
        <div class="kpi-lbl">최대</div>
        <div class="kpi-val" x-text="$root.sec_(data.efficiency_metrics?.max_latency||data.efficiency_metrics?.latency?.max||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='stddev'}" @click="selK=selK==='stddev'?null:'stddev'">
        <div class="kpi-lbl">표준편차</div>
        <div class="kpi-val" x-text="$root.sec_(data.efficiency_metrics?.std_latency||data.efficiency_metrics?.latency?.std||0)"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="meta[selK]?.unit?'단위: '+meta[selK].unit:''"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
              <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,$root.data)"></div>
            </div>
          </div>
          <div style="padding:10px 14px;background:var(--bg)">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">관련 태스크</span>
              <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="filterLabel(selK)"></span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,$root.data).length+'건'"></span>
            </div>
            <div class="dtx" style="max-height:220px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:1fr 80px 80px 60px;position:sticky;top:0;z-index:1">
                <span>태스크 ID</span><span>유형</span><span>지연(s)</span><span>상태</span>
              </div>
              <template x-for="t in items(selK,$root.data)" :key="t.task_id">
                <div class="dtx-row" style="grid-template-columns:1fr 80px 80px 60px">
                  <span class="dtx-id" x-text="t.task_id"></span>
                  <span style="font-size:11px;color:var(--text2)" x-text="t.task_type||'-'"></span>
                  <span :style="`color:${$root.bc2lat(t.execution_time||0)}`" x-text="$root.sec_(t.execution_time||0)"></span>
                  <span :class="t.success?'badge-ok':'badge-ng'" x-text="t.success?'✓':'✗'"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cg3" style="margin-top:8px">
      <div class="cbox"><div class="ct">백분위 지연 시간</div><div id="d2-p-lat-bar" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">지연 분포 히스토그램</div><div id="d2-p-lat-hist" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">태스크별 지연</div><div id="d2-p-lat-task" class="plt-chart"></div></div>
    </div>
    <div class="sec" style="margin-top:12px">
      <div class="sec-t">느린 태스크 (상위 10)</div>
      <div class="dtx">
        <div class="dtx-row dtx-head" style="grid-template-columns:1fr 80px 80px 60px;position:sticky;top:0;z-index:1">
          <span>태스크</span><span>지연(s)</span><span>유형</span><span>상태</span>
        </div>
        <template x-for="t in slowTasks(data)" :key="t.task_id">
          <div class="dtx-row" style="grid-template-columns:1fr 80px 80px 60px">
            <span class="dtx-id" x-text="t.task_id"></span>
            <span :style="`color:${$root.bc2lat(t.execution_time||0)}`" x-text="$root.sec_(t.execution_time||0)"></span>
            <span style="font-size:11px;color:var(--text2)" x-text="t.task_type||'-'"></span>
            <span :class="t.success?'badge-ok':'badge-ng'" x-text="t.success?'✓':'✗'"></span>
          </div>
        </template>
      </div>
