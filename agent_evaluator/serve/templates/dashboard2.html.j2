<!-- ══ SECTION 2: QUALITY ══ -->
<div x-show="data && sec==='quality'" x-cloak>

  <!-- TCR subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">✅ 태스크 완료율 (TCR)</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      tcr:{label:'TCR',unit:'%',desc:'완전·부분 성공 가중 합산 태스크 완료율',hint:'Σ completion_score / total × 100'},
      full_success:{label:'완전 성공',unit:'건',desc:'completion_score ≥ 1.0인 태스크',hint:'score ≥ 1.0'},
      partial_success:{label:'부분 성공',unit:'건',desc:'0.7 ≤ completion_score < 1.0인 태스크',hint:'0.7 ≤ score < 1.0'},
      failures:{label:'실패',unit:'건',desc:'completion_score < 0.7인 태스크',hint:'score < 0.7'},
    },
    formula(k,d){
      const t=d.tasks||[],n=t.length||1;
      const fs=t.filter(x=>x.completion_score>=1.0).length;
      const ps=t.filter(x=>x.completion_score>=0.7&&x.completion_score<1.0).length;
      const fl=t.filter(x=>x.completion_score<0.7).length;
      const ws=t.reduce((a,b)=>a+(b.completion_score||0),0);
      if(k==='tcr')return `TCR = Σ completion_score / total\n= ${ws.toFixed(2)} / ${n} = ${(ws/n*100).toFixed(1)}%`;
      if(k==='full_success')return `완전 성공 = score ≥ 1.0\n${fs}건 / ${n}건 = ${(fs/n*100).toFixed(1)}%`;
      if(k==='partial_success')return `부분 성공 = 0.7 ≤ score < 1.0\n${ps}건 / ${n}건 = ${(ps/n*100).toFixed(1)}%`;
      if(k==='failures')return `실패 = score < 0.7\n${fl}건 / ${n}건 = ${(fl/n*100).toFixed(1)}%`;
      return '';
    },
    items(k,d){
      const t=d.tasks||[];
      if(k==='full_success')return t.filter(x=>x.completion_score>=1.0);
      if(k==='partial_success')return t.filter(x=>x.completion_score>=0.7&&x.completion_score<1.0);
      if(k==='failures')return t.filter(x=>x.completion_score<0.7);
      return t;
    },
    filterLabel(k){return {full_success:'score≥1.0',partial_success:'0.7≤score<1.0',failures:'score<0.7',tcr:'전체'}[k]||'전체';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='tcr'}" @click="selK=selK==='tcr'?null:'tcr'">
        <div class="kpi-lbl">TCR</div>
        <div class="kpi-val" :style="`color:${$root.bc(tcr_($root.data),90,70)}`" x-text="$root.pct(tcr_($root.data))"></div>
        <div class="kpi-sub" x-text="`${($root.data.tasks||[]).filter(t=>t.success).length} / ${$root.data.total_tasks} 성공`"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='full_success'}" @click="selK=selK==='full_success'?null:'full_success'">
