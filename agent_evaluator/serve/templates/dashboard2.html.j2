                      x-show="!c._rejected"
                      @click="rejectCase(reviewFile, c._idx)">Reject</button>
              <button class="btn" style="font-size:11px;padding:3px 8px"
                      x-show="c._approved||c._rejected"
                      @click="c._approved?rejectCase(reviewFile,c._idx):approveCase(reviewFile,c._idx)"
                      x-text="c._approved?'Undo':'Restore'"></button>
            </div>
