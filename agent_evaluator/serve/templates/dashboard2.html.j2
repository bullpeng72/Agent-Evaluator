  <!-- Phase 2: Harness Gate A — 목표 달성 (IFR + 세부 지표) -->
  <template x-if="data.harness_groups && data.harness_groups['A']">
    <div x-data="{
  gA: data.harness_groups['A'],
  selK:null,
  meta:{
    group_a:{label:'Gate A Overall',desc:'Weighted average gate of 7 Goal Achievement metrics (TCR·Accuracy·IFR·Goal Alignment·Plan Coherence·Subtask·Context·Knowledge Retention).',hint:'score = weighted average | gate: pass≥0.75, warn≥0.6, fail<0.6'},
    tcr:{label:'Task Completion Rate',desc:'Ratio of tasks completed by the agent. Uses granular continuous score (0-1) rather than binary pass/fail.',hint:'avg(completion_score) × 100 | 🟢 ≥85% 🟡 ≥70% 🔴 <70%'},
    avg_accuracy:{label:'Avg Accuracy',desc:'How well responses match Ground Truth. Weighted sum of 4 methods: TokenF1·Jaccard·LCS·Char.',hint:'TokenF1×0.4 + Jaccard×0.3 + LCS×0.2 + CharSim×0.1 | 🟢 ≥70% 🟡 ≥50% 🔴 <50%'},
    avg_instruction_adherence:{label:'Instruction Follow Rate (IFR)',desc:'When InstructionConfig is set, ratio of responses following required format, keywords, and length.',hint:'total - format violation count / total | 🟢 ≥80% 🟡 ≥60% 🔴 <60%'},
    avg_goal_alignment:{label:'Goal Alignment',desc:'Measured by GoalAlignmentConfig. Alignment score between question keywords and actual tool calls.',hint:'keyword↔tool mapping score | 🟢 ≥0.8 🟡 ≥0.6 🔴 <0.6'},
    avg_plan_coherence:{label:'Plan Coherence',desc:'When PlanConfig is set, verifies goal inclusion, step order, and executability of the response plan.',hint:'plan JSON parsing + keyword inclusion + tool executability | 🟢 ≥0.85 🟡 ≥0.6 🔴 <0.6'},
    avg_subtask_completion:{label:'Subtask Completion',desc:'When SubtaskConfig is set, actual completion rate vs expected subtask list.',hint:'completion markers detected / total subtasks | 🟢 ≥0.9 🟡 ≥0.7 🔴 <0.7'},
    avg_context_retention:{label:'Context Retention',desc:'When ContextRetentionConfig is set, ratio of key entities and goals preserved in responses.',hint:'entity 0.6 + goal 0.4 weighted sum | 🟢 ≥0.85 🟡 ≥0.6 🔴 <0.6'},
    avg_knowledge_retention:{label:'Knowledge Retention',desc:'When KnowledgeRetentionConfig is set, ratio of initial turn facts retained in later responses.',hint:'seed_turns facts → checked from check_from_turn responses | 🟢 ≥90% 🟡 ≥70% 🔴 <70%'},
  },
  formula(k,d){
    const g=d.harness_groups?.A||{};
    const dt=g.details||{};
    if(k==='group_a') return `Overall = weighted avg(TCR·accuracy·IFR·goal alignment…)\n= ${(g.score||0)*100 .toFixed(1)}%\nGate: ${(g.gate||'?').toUpperCase()}`;
    const v=dt[k];
    if(v==null) return 'No data';
    return `${this.meta[k]?.label} = ${(v*100).toFixed(1)}%\nTask count: ${dt.task_count||'—'}\nRaw value: ${v.toFixed(4)}`;
  }
}">
      <div id="s-instruction-adh" class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">📋 Harness Gate A — Goal Achievement</span><div class="sdiv-line"></div></div>
      <div class="kpi-grid">
        <!-- A 종합 게이트 -->
        <div class="kpi kpi-act" :class="{sel:selK==='group_a'}" @click="selK=selK==='group_a'?null:'group_a'">
          <div class="kpi-lbl">Gate A Overall</div>
          <div class="kpi-val"
               :style="`color:${gA.gate==='pass'?'var(--green)':gA.gate==='fail'?'var(--red)':'var(--yellow)'}`"
