                <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,data).length+'건'"></span>
              </div>
              <div class="dtx" style="max-height:220px;overflow-y:auto">
                <div class="dtx-row dtx-head" style="grid-template-columns:150px minmax(0,1fr) 72px 72px 72px 72px;position:sticky;top:0;z-index:1">
                  <span>태스크 ID</span><span x-text="selK==='overall_score'?'종합':'—'"></span><span>충실성</span><span>답변관련</span><span>문맥재현</span><span>문맥정밀</span>
                </div>
                <template x-for="t in items(selK,data)" :key="t.task_id">
                  <div class="dtx-row" style="grid-template-columns:150px minmax(0,1fr) 72px 72px 72px 72px">
