  <div x-data="{
    selK:null,
    meta:{
      mean:{label:'Mean',unit:'s',desc:'Average response time across all tasks. Indicates overall performance level, but can be skewed by extremely slow tasks (outliers); interpret alongside P50·P95.',hint:'avg(execution_time)'},
      p50:{label:'P50 (Median)',unit:'s',desc:'Median response time; half of tasks complete faster than this. Unaffected by extreme values; best indicator of typical agent response speed.',hint:'median(execution_time)'},
      p90:{label:'P90',unit:'s',desc:'90% of tasks complete within this time. Represents the response speed experienced by most users; frequently used as a general service SLA benchmark.',hint:'90th percentile(execution_time)'},
      p95:{label:'P95',unit:'s',desc:'95% of tasks complete within this time. Most widely used benchmark for SLA design; represents the practical worst-case response time excluding rare outliers.',hint:'95th percentile(execution_time)'},
      p99:{label:'P99',unit:'s',desc:'99% of tasks complete within this time. Represents the maximum response time experienced by almost all users; used as SLA benchmark for high-availability and high-reliability services.',hint:'99th percentile(execution_time)'},
      maximum:{label:'Maximum',unit:'s',desc:'Response time of the slowest recorded task. Used for timeout configuration and worst-case scenario design; abnormally high values suggest a performance bottleneck in certain task types.',hint:'max(execution_time)'},
      stddev:{label:'Std Dev',unit:'s',desc:'Degree of variation in response times. Lower values indicate consistent response speed across all tasks, representing UX predictability. High values indicate severe degradation only in specific tasks.',hint:'std(execution_time)'},
    },
    formula(k,d){
      const lat=(d.efficiency_metrics||{}).latency||{};
      const p90=_latPct((d.tasks||[]).map(t=>t.execution_time),90);
      if(k==='mean')return `avg(execution_time)\n= ${_sec(lat.mean||0)}\n\nArithmetic mean of all ${d.total_tasks||0} tasks`;
      if(k==='p50')return `median(execution_time)\n= ${_sec(lat.p50||0)}\n\n50th percentile of sorted array\nnp.percentile(times, 50, method='linear')`;
      if(k==='p90')return `np.percentile(times, 90, method='linear')\n= ${_sec(p90)}\n\n※ Items not collected by LatencyTracker\n  → calculated directly from tasks[].execution_time`;
      if(k==='p95')return `np.percentile(times, 95, method='linear')\n= ${_sec(lat.p95||0)}\n\nMost widely used for SLA design`;
      if(k==='p99')return `np.percentile(times, 99, method='linear')\n= ${_sec(lat.p99||0)}\n\nMax response time experienced by almost all users`;
      if(k==='maximum')return `max(execution_time)\n= ${_sec(lat.max||0)}\n\nSlowest single task recorded`;
      if(k==='stddev')return `std(execution_time)\n= ${_sec(lat.std||0)}\n\nConsistency indicator for response time\nLower = more predictable response speed`;
      return '';
    },
    items(k,d){
      const t=d.tasks||[];
      if(k==='maximum'||k==='p99'||k==='p95'||k==='p90')return [...t].sort((a,b)=>(b.execution_time||0)-(a.execution_time||0)).slice(0,15);
      return [...t].sort((a,b)=>(a.execution_time||0)-(b.execution_time||0)).slice(0,15);
    },
    filterLabel(k){return ['maximum','p99','p95','p90'].includes(k)?'Slowest Tasks Top15':'Fastest Tasks Top15';}
  }">
