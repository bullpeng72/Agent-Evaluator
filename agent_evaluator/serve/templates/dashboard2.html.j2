                <div class="dtx-row" :style="`grid-template-columns:1fr 70px 70px 70px 70px 70px 70px;${e.sanitization_needed?'background:rgba(220,50,50,0.06)':''}` ">
                  <span style="font-size:10px;word-break:break-all" x-text="e.task_id||'—'"></span>
