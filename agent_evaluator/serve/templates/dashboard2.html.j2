  <!-- Retry subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🔁 재시도 / 보정</span><div class="sdiv-line"></div></div>
  <div x-data="{
    selK:null,
    meta:{
      retry_rate:{label:'재시도율',unit:'%',desc:'전체 실행 시도 중 재시도가 차지하는 비율입니다. 높을수록 첫 시도 실패가 잦아 비용과 지연이 증가합니다. 일정 수준의 재시도는 자연스럽지만, 지나치게 높으면 도구 안정성 또는 프롬프트 품질 문제를 시사합니다.',hint:'(total_attempts − tasks) / total_attempts × 100'},
      first_success:{label:'첫 시도 성공률',unit:'%',desc:'추가 재시도 없이 첫 번째 시도에서 성공한 태스크의 비율입니다. 높을수록 에이전트의 계획·실행 능력이 안정적이며, 실제 운영 환경에서 비용과 응답 시간 절감으로 이어집니다.',hint:'first_attempt_success / total_tasks × 100'},
      eventual_success:{label:'최종 성공률',unit:'%',desc:'재시도를 포함해 결국 성공한 태스크의 비율입니다. 첫 시도 성공률과 비교해 재시도가 얼마나 효과적으로 실패를 만회하는지 파악하는 데 활용됩니다.',hint:'eventual_success_count / total_tasks × 100'},
      correction:{label:'보정 성공률',unit:'%',desc:'실패 후 재시도를 통해 성공으로 전환된 태스크의 비율입니다. 에이전트의 자기 교정 능력을 나타내며, 낮으면 재시도해도 같은 오류를 반복하는 경향이 있음을 의미합니다.',hint:'correction_success / retry_tasks × 100'},
      avg_attempts:{label:'평균 시도',unit:'회',desc:'태스크 1건을 완료하는 데 평균적으로 소요되는 시도 횟수입니다. 1에 가까울수록 효율적이며, 높을수록 에이전트가 반복 시도를 통해 작업을 완료하고 있어 비용과 지연이 증가합니다.',hint:'avg(total_attempts)'},
      avg_retry_time:{label:'평균 재시도 시간',unit:'s',desc:'재시도가 발생한 태스크에서 재시도에 소요된 평균 시간입니다. 이 값이 높으면 재시도 대기 시간이 길거나 복잡한 오류 처리가 발생하고 있음을 의미합니다.',hint:'avg(retry_time) 재시도 있는 태스크 한정'},
    },
    formula(k,d){
      const rs=d.agentic?.retry_summary||{};
      if(k==='retry_rate'){const ta=rs.total_tasks_with_retries||0;return `재시도율 = (총시도 − 태스크) / 총시도 × 100\n= ${rs.overall_retry_rate||0}%\n재시도 발생 태스크: ${ta}건 (retry_rate=${rs.retry_rate||0}%)`;}
      if(k==='first_success')return `첫 시도 성공 = ${rs.first_attempt_success_rate||0}%`;
      if(k==='eventual_success')return `최종 성공 = ${rs.eventual_success_rate||0}%`;
      if(k==='correction')return `보정 성공 = ${rs.correction_success_rate||0}%\n재시도 → 성공 전환 비율`;
      if(k==='avg_attempts')return `평균 시도 = ${(rs.avg_attempts_per_task||rs.avg_attempts||0).toFixed(2)}회`;
      if(k==='avg_retry_time')return `평균 재시도 시간 = ${(rs.avg_retry_time||0).toFixed(2)}s\n재시도 발생 태스크 한정`;
      return '';
    },
    items(k,d){
      const ra=d.agentic?.retry_attempts||[];
      if(k==='retry_rate'||k==='first_success')return ra.filter(r=>r.total_attempts>1);
      return ra;
    },
    filterLabel(k){return ['retry_rate','first_success'].includes(k)?'재시도 발생 태스크':'전체 재시도 기록';}
  }">
    <div class="kpi-grid">
      <div class="kpi kpi-act" :class="{sel:selK==='retry_rate'}" @click="selK=selK==='retry_rate'?null:'retry_rate'">
        <div class="kpi-lbl">재시도율</div>
        <div class="kpi-val" x-text="_pct(data.agentic?.retry_summary?.overall_retry_rate||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='first_success'}" @click="selK=selK==='first_success'?null:'first_success'">
        <div class="kpi-lbl">첫 시도 성공률</div>
        <div class="kpi-val" x-text="_pct(data.agentic?.retry_summary?.first_attempt_success_rate||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='eventual_success'}" @click="selK=selK==='eventual_success'?null:'eventual_success'">
        <div class="kpi-lbl">최종 성공률</div>
        <div class="kpi-val" :style="`color:${_bc(data.agentic?.retry_summary?.eventual_success_rate||0,90,70)}`"
             x-text="_pct(data.agentic?.retry_summary?.eventual_success_rate||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='correction'}" @click="selK=selK==='correction'?null:'correction'">
        <div class="kpi-lbl">보정 성공률</div>
        <div class="kpi-val" x-text="_pct(data.agentic?.retry_summary?.correction_success_rate||0)"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='avg_attempts'}" @click="selK=selK==='avg_attempts'?null:'avg_attempts'">
        <div class="kpi-lbl">평균 시도</div>
        <div class="kpi-val" x-text="(data.agentic?.retry_summary?.avg_attempts_per_task||data.agentic?.retry_summary?.avg_attempts||0).toFixed(1)+'회'"></div>
      </div>
      <div class="kpi kpi-act" :class="{sel:selK==='avg_retry_time'}" @click="selK=selK==='avg_retry_time'?null:'avg_retry_time'">
        <div class="kpi-lbl">평균 재시도 시간</div>
        <div class="kpi-val" x-text="_sec(data.agentic?.retry_summary?.avg_retry_time||0)"></div>
      </div>
    </div>
    <div x-show="selK" style="margin:8px 0 14px;border:1px solid var(--accent);border-radius:8px;overflow:hidden" x-cloak>
      <template x-if="selK">
        <div>
          <div style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--border)">
            <span style="font-weight:700;font-size:14px" x-text="meta[selK]?.label||selK"></span>
            <button style="margin-left:auto;background:transparent;border:none;color:var(--text2);cursor:pointer;font-size:18px" @click="selK=null">×</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid var(--border)">
            <div style="padding:10px 14px;background:var(--bg2);border-right:1px solid var(--border)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">설명</div>
              <div style="font-size:13px;line-height:1.7" x-text="meta[selK]?.desc||''"></div>
            </div>
            <div style="padding:10px 14px;background:var(--bg3)">
              <div style="font-size:11px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase">📐 산출 방식</div>
              <div style="font-size:12px;font-family:monospace;color:var(--accent);line-height:1.8;white-space:pre-line" x-text="formula(selK,data)"></div>
            </div>
          </div>
          <div style="padding:10px 14px;background:var(--bg)">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase">재시도 기록</span>
              <span style="font-size:11px;color:var(--text2);background:var(--bg3);padding:1px 7px;border-radius:99px" x-text="filterLabel(selK)"></span>
              <span style="font-size:11px;color:var(--text2);margin-left:auto" x-text="items(selK,data).length+'건'"></span>
            </div>
            <div class="dtx" style="max-height:200px;overflow-y:auto">
              <div class="dtx-row dtx-head" style="grid-template-columns:minmax(120px,1fr) 60px 68px 68px;position:sticky;top:0;z-index:1">
                <span>태스크 ID</span><span>시도</span><span>최종성공</span><span>소요시간</span>
              </div>
              <template x-for="r in items(selK,data)" :key="r.task_id">
                <div class="dtx-row" style="grid-template-columns:minmax(120px,1fr) 60px 68px 68px">
                  <span class="dtx-id" x-text="r.task_id"></span>
                  <span x-text="r.total_attempts||1"></span>
                  <span :class="r.final_success?'badge-ok':'badge-ng'" x-text="r.final_success?'✓':'✗'"></span>
                  <span x-text="_sec(r.total_time||r.total_retry_time||0)"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="cg" style="margin-top:8px">
      <div class="cbox"><div class="ct">시도 횟수 분포</div><div id="d2-ag-retry-hist" class="plt-chart"></div></div>
      <div class="cbox"><div class="ct">태스크 유형별 평균 시도</div><div id="d2-ag-retry-type" class="plt-chart"></div></div>
    </div>
  </div>

  <!-- Multi-Agent Coordination subsection -->
  <div class="sdiv"><div class="sdiv-line"></div><span class="sdiv-lbl">🤝 멀티에이전트 협업</span><div class="sdiv-line"></div></div>
  <div x-show="!data.has_coordination">
    <div class="badge-gray" style="display:inline-block;margin-bottom:12px">협업 데이터 없음 — AgentCoordinationTracker 미활성화</div>
  </div>
  <div x-show="data.has_coordination">
    <div x-data="{
      selK:null,
      meta:{
        total_interactions:{label:'총 인터랙션',unit:'건',desc:'에이전트 간에 발생한 전체 상호작용 수입니다. 멀티에이전트 시스템의 활동 수준을 나타내며, 워크플로우의 복잡성과 에이전트 간 의존도를 파악하는 데 활용됩니다.',hint:'agent_interactions.length'},
        success_interactions:{label:'성공 인터랙션',unit:'건',desc:'에이전트 간 상호작용 중 정상적으로 완료된 수입니다. 에이전트 간 메시지 전달의 적절성과 수신 에이전트의 처리 성공 여부를 반영하며, 협업 인터페이스 품질을 나타냅니다.',hint:'successful_interactions'},
        success_rate:{label:'협업 성공률',unit:'%',desc:'멀티에이전트 시스템에서 에이전트 간 협업이 성공적으로 이루어진 비율입니다. 낮으면 메시지 포맷 불일치, 역할 혼선, 또는 특정 에이전트의 처리 실패 등 협업 구조 문제를 시사합니다.',hint:'successful / total × 100'},
        unique_agents:{label:'참여 에이전트',unit:'명',desc:'이번 평가에서 상호작용에 참여한 고유한 에이전트 수입니다. 시스템 아키텍처의 복잡성을 나타내며, 참여 에이전트 수가 많을수록 협업 실패 가능 지점도 증가합니다.',hint:'unique_agents'},
      },
      formula(k,d){
        const cs=d.agentic?.coordination_summary||{};
        if(k==='total_interactions')return `총 인터랙션 = ${cs.total_interactions||0}건`;
        if(k==='success_interactions')return `성공 = ${cs.successful_interactions||0}건`;
        if(k==='success_rate')return `협업성공률 = successful/total×100\n= ${cs.success_rate||cs.collaboration_success_rate||0}%`;
        if(k==='unique_agents')return `참여 에이전트 = ${cs.unique_agents||0}명`;
        return '';
      },
      items(k,d){
        const ai=d.agentic?.agent_interactions||[];
        if(k==='success_interactions')return ai.filter(i=>i.success);
        return ai;
      },
      filterLabel(k){return k==='success_interactions'?'성공 인터랙션':'전체 인터랙션';}
    }">
      <div class="kpi-grid">
        <div class="kpi kpi-act" :class="{sel:selK==='total_interactions'}" @click="selK=selK==='total_interactions'?null:'total_interactions'">
          <div class="kpi-lbl">총 인터랙션</div>
          <div class="kpi-val" x-text="data.agentic?.coordination_summary?.total_interactions||0"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='success_interactions'}" @click="selK=selK==='success_interactions'?null:'success_interactions'">
          <div class="kpi-lbl">성공 인터랙션</div>
          <div class="kpi-val" style="color:var(--green)" x-text="data.agentic?.coordination_summary?.successful_interactions||0"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='success_rate'}" @click="selK=selK==='success_rate'?null:'success_rate'">
          <div class="kpi-lbl">협업 성공률</div>
          <div class="kpi-val" :style="`color:${_bc(data.agentic?.coordination_summary?.success_rate||data.agentic?.coordination_summary?.collaboration_success_rate||0,90,70)}`"
               x-text="_pct(data.agentic?.coordination_summary?.success_rate||data.agentic?.coordination_summary?.collaboration_success_rate||0)"></div>
        </div>
        <div class="kpi kpi-act" :class="{sel:selK==='unique_agents'}" @click="selK=selK==='unique_agents'?null:'unique_agents'">
          <div class="kpi-lbl">참여 에이전트</div>
          <div class="kpi-val" x-text="data.agentic?.coordination_summary?.unique_agents||0"></div>
