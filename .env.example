# ============================================================
# Agent Evaluator — 환경 변수 템플릿
# ============================================================
# 이 파일을 .env 로 복사하고 실제 값을 채우세요.
# .env 는 절대 버전 관리에 커밋하지 마세요.
#
# 빠른 설정:  agent-eval init
# 상태 확인:  agent-eval check
# ============================================================

# ------------------------------------------------------------
# OpenAI  (필수 — LLMHelper, DeepEval, Ragas 에서 사용)
# 키 발급: https://platform.openai.com/api-keys
# ------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# Anthropic / Claude  (선택 — ClaudeHelper 에서 사용)
# 키 발급: https://console.anthropic.com/settings/keys
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ------------------------------------------------------------
# LangSmith  (선택 — LangSmithAdapter, LangChain 트레이싱)
# 키 발급: https://smith.langchain.com/settings
# ------------------------------------------------------------
LANGSMITH_API_KEY=ls__...
# LANGCHAIN_API_KEY=ls__...    ← LANGSMITH_API_KEY 의 별칭 (둘 중 하나만)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=agent-evaluator

# ------------------------------------------------------------
# DeepEval  (선택 — Confident AI 대시보드 연동)
# OPENAI_API_KEY 가 있으면 없어도 동작함
# 키 발급: https://app.confident-ai.com/
# ------------------------------------------------------------
# DEEPEVAL_API_KEY=...

# ------------------------------------------------------------
# 출력 설정
# ------------------------------------------------------------
AGENT_EVALUATOR_OUTPUT_DIR=./results
