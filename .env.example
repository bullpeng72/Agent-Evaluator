# ============================================================
# Agent Evaluator — 환경 변수 템플릿
# ============================================================
# 이 파일을 .env 로 복사하고 실제 값을 채우세요.
# .env 는 절대 버전 관리에 커밋하지 마세요.
#
# Layer 1·2 지표 (16개) 는 API 키 없이 동작합니다.
# Layer 3 (DeepEval, Ragas, LLMHelper) 는 아래 키가 필요합니다.
#
# 빠른 설정:  agent-eval init
# 상태 확인:  agent-eval check
# ============================================================

# ------------------------------------------------------------
# OpenAI  (선택 — Layer 3: LLMHelper, DeepEval, Ragas)
# 키 발급: https://platform.openai.com/api-keys
# 패키지:  pip install "agent-evaluator[llm]"
# ------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-nano

# ------------------------------------------------------------
# Anthropic / Claude  (선택 — Layer 3: ClaudeHelper)
# 키 발급: https://console.anthropic.com/settings/keys
# 패키지:  pip install "agent-evaluator[llm]"
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ------------------------------------------------------------
# LangSmith  (선택 — LangSmithAdapter, LangChain 트레이싱 연동)
# 키 발급: https://smith.langchain.com/settings
# 패키지:  pip install "agent-evaluator[frameworks]"
# ------------------------------------------------------------
LANGSMITH_API_KEY=ls__...
# LANGCHAIN_API_KEY=ls__...    ← LANGSMITH_API_KEY 의 별칭 (둘 중 하나만)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=agent-evaluator

# ------------------------------------------------------------
# 출력 설정
# ------------------------------------------------------------
AGENT_EVALUATOR_OUTPUT_DIR=./results
