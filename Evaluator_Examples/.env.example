# ============================================================
# Agent Evaluator — 환경 변수 템플릿 (Evaluator_Examples)
# ============================================================
# 이 파일을 .env 로 복사하고 실제 값을 채우세요.
#   cp .env.example .env
#
# .env 는 절대 버전 관리에 커밋하지 마세요. (.gitignore 처리됨)
#
# 빠른 설정:  agent-eval init
# 상태 확인:  agent-eval check
# ============================================================
#
# ┌─────────────────────────────────────────────────────────┐
# │ 예제별 필요 환경 변수 요약                               │
# ├──────────────────────────┬──────────────────────────────┤
# │ 예제 파일                │ 필요 변수                    │
# ├──────────────────────────┼──────────────────────────────┤
# │ 01_quality_eval.py       │ OPENAI_API_KEY (선택)        │
# │ 02_performance_eval.py   │ 없음 (API 키 불필요)         │
# │ 03_agentic_eval.py       │ 없음                         │
# │ 04_security_eval.py      │ 없음                         │
# │ 05_hybrid_eval.py        │ OPENAI_API_KEY (필수)        │
# │                          │ LANGSMITH_API_KEY (선택)     │
# │ 06_langchain_eval.py     │ OPENAI_API_KEY (선택)        │
# │ 07_langgraph_eval.py     │ OPENAI_API_KEY (선택)        │
# │ 08_crewai_eval.py        │ 없음                         │
# │ 09_autogen_eval.py       │ 없음                         │
# │ 10_cross_framework_eval  │ 없음                         │
# │ 11_streaming_eval.py     │ 없음                         │
# │ 12_alerting_eval.py      │ 없음                         │
# │ 13_golden_set_build.py   │ 없음                         │
# │ 14_anomaly_cost_eval.py  │ 없음                         │
# │ 15_conversation_eval.py  │ 없음                         │
# │ 16_dashboard_demo.py     │ 없음                         │
# └──────────────────────────┴──────────────────────────────┘
#
# ※ "(선택)" — 없어도 실행됨. 있으면 LLM Judge 기능 활성화.
# ※ "(필수)" — 없으면 예제 실행 불가.
# ============================================================

# ------------------------------------------------------------
# OpenAI  (05_hybrid_eval.py 필수 / 01·06·07 LLM Judge 선택)
# 키 발급: https://platform.openai.com/api-keys
# 패키지:  pip install "agent-evaluator[llm]"
# ------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# Anthropic / Claude  (LLM Judge 대체 — OpenAI 대신 사용 가능)
# 키 발급: https://console.anthropic.com/settings/keys
# 패키지:  pip install "agent-evaluator[llm]"
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ------------------------------------------------------------
# LangSmith  (05_hybrid_eval.py — 선택)
# LANGSMITH_API_KEY 가 있으면 LangSmith 트레이싱 자동 활성화
# 키 발급: https://smith.langchain.com/settings
# 패키지:  pip install "agent-evaluator[langchain]"
# ------------------------------------------------------------
# LANGSMITH_API_KEY=ls__...
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=agent-evaluator

# ------------------------------------------------------------
# 출력 디렉토리 (기본값: ./results)
# ------------------------------------------------------------
AGENT_EVALUATOR_OUTPUT_DIR=./results
