# Agent Evaluator — Environment Variables
# Copy this file to .env and fill in your actual API keys

# ============================================
# OpenAI API (05_hybrid_metrics.py 필수)
# ============================================
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ============================================
# Anthropic Claude API (선택사항)
# ============================================
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ============================================
# DeepEval (선택사항 — Confident AI 대시보드 연동)
# ============================================
# https://app.confident-ai.com/
# DEEPEVAL_API_KEY=your-deepeval-api-key-here

# ============================================
# LangSmith (선택사항 — 트레이싱 연동)
# ============================================
# https://smith.langchain.com/settings
# LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=agent-evaluator

# ============================================
# 평가 결과 저장 경로
# ============================================
AGENT_EVALUATOR_OUTPUT_DIR=./results
