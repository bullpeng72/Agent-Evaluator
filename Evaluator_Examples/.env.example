# Agent Evaluator Examples - Environment Variables
# Copy this file to .env and fill in your actual API keys

# ============================================
# OpenAI API (Level 2, 3 필수)
# ============================================
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini  # 또는 gpt-3.5-turbo, gpt-4

# ============================================
# Anthropic Claude API (선택사항)
# ============================================
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# ============================================
# DeepEval 설정 (Level 2, 3 필수)
# ============================================
# DeepEval은 OpenAI API를 사용하므로 별도 키가 필요 없을 수 있음
# 또는 DeepEval 자체 키가 있다면:
# DEEPEVAL_API_KEY=your-deepeval-api-key-here

# ============================================
# Ragas 설정 (Level 2, 3)
# ============================================
# Ragas는 OpenAI API를 사용하므로 OPENAI_API_KEY 필요

# ============================================
# ChromaDB 설정 (Level 2, 3)
# ============================================
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=agent_evaluator

# ============================================
# 로깅 설정
# ============================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/evaluator.log

# ============================================
# Dashboard 설정 (Level 3)
# ============================================
ENABLE_DASHBOARD=true
DASHBOARD_PORT=8501
DASHBOARD_HOST=localhost

# ============================================
# 모니터링 설정 (Level 3)
# ============================================
MONITORING_INTERVAL=3600  # 초 단위 (3600 = 1시간)
ENABLE_ALERTS=true
ALERT_EMAIL=your-email@example.com

# ============================================
# 비용 최적화 설정 (Level 3)
# ============================================
COST_STRATEGY=stratified  # full, random, critical, stratified
COST_SAMPLE_RATE=0.20     # 20% sampling for Layer 3

# ============================================
# Threshold 설정
# ============================================
THRESHOLD_TCR=90.0        # Task Completion Rate (%)
THRESHOLD_ACCURACY=80.0   # Accuracy (%)
THRESHOLD_LATENCY=5.0     # Latency (seconds)
THRESHOLD_COST=1.0        # Cost per task ($)

# ============================================
# 데이터베이스 설정 (선택사항)
# ============================================
DATABASE_URL=sqlite:///./evaluator.db
# 또는 PostgreSQL: postgresql://user:password@localhost/evaluator

# ============================================
# CI/CD 설정 (Level 3)
# ============================================
ENABLE_CI_CD=false
CI_CD_PROVIDER=github  # github, gitlab, jenkins
CI_CD_WEBHOOK_URL=

# ============================================
# 개발 모드
# ============================================
DEBUG_MODE=false
ENABLE_PROFILING=false
CACHE_ENABLED=true

# ============================================
# 프레임워크별 설정
# ============================================
# CrewAI
CREWAI_VERBOSE=true
CREWAI_MAX_ITER=10

# LangChain
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here

# LangGraph
LANGGRAPH_MAX_ITERATIONS=50
LANGGRAPH_RECURSION_LIMIT=100
