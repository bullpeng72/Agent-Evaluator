# ============================================================
# Agent Evaluator — 환경 변수 템플릿 (Evaluator_Examples)
# ============================================================
# 이 파일을 .env 로 복사하고 실제 값을 채우세요.
#   cp .env.example .env
#
# .env 는 절대 버전 관리에 커밋하지 마세요. (.gitignore 처리됨)
#
# 빠른 설정:  agent-eval init
# 상태 확인:  agent-eval check
# ============================================================
#
# ┌─────────────────────────────────────────────────────────┐
# │ 예제별 필요 환경 변수 요약 (Book Chapters)               │
# ├──────────────────────────┬──────────────────────────────┤
# │ 예제 파일                │ 필요 변수                    │
# ├──────────────────────────┼──────────────────────────────┤
# │ ch01 ~ ch11 (Harness)    │ 없음 (API 키 불필요)         │
# │ ch12_decorators.py       │ OPENAI_API_KEY (선택)        │
# │ ch15_dashboard.py        │ OPENAI_API_KEY (선택)        │
# │ ch16_alerts.py           │ SLACK_WEBHOOK_URL (선택)     │
# │ ch19_phoenix.py          │ OPENAI_API_KEY (선택)        │
# │                          │ PHOENIX_URL (기본값 있음)    │
# │ ch26_cicd_weekly.py      │ OPENAI_API_KEY (선택)        │
# └──────────────────────────┴──────────────────────────────┘
#
# ※ "(선택)" — 없어도 실행됨. 설정 시 LLM Judge 또는 알림 기능 활성화.
# ============================================================

# ------------------------------------------------------------
# LLM Judge & 외부 평가 (DeepEval/Ragas)
# ------------------------------------------------------------
# OpenAI (기본 Judge)
# 키 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-nano

# Anthropic (OpenAI 대체 가능)
# 키 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Judge 제공자 명시 (선택: "openai", "anthropic", "auto")
# AGENT_EVALUATOR_JUDGE_PROVIDER=auto

# ------------------------------------------------------------
# 모니터링 & 관측성 (Phoenix / LangSmith)
# ------------------------------------------------------------
# Phoenix OTEL 서버 주소 (기본값: http://localhost:6006)
# 실행: agent-eval monitor
PHOENIX_URL=http://localhost:6006

# LangSmith (선택)
# LANGSMITH_API_KEY 가 있으면 LangSmith 트레이싱 자동 활성화
# 키 발급: https://smith.langchain.com/settings
# LANGSMITH_API_KEY=ls__...
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=agent-evaluator

# ------------------------------------------------------------
# 알림 (Alerting)
# ------------------------------------------------------------
# Slack 수신 웹훅 URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# 일반 웹훅 엔드포인트
ALERT_WEBHOOK_URL=http://your-webhook-endpoint.com/alert

# ------------------------------------------------------------
# 경로 설정
# ------------------------------------------------------------
# 결과물 저장 디렉토리 (기본값: ./results)
AGENT_EVALUATOR_OUTPUT_DIR=./results
