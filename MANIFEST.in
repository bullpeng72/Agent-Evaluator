# Core files
include README.md
include LICENSE
include pyproject.toml

# Python source
recursive-include agent_evaluator *.py

# Template & static assets bundled in the package
recursive-include agent_evaluator *.html
recursive-include agent_evaluator *.html.j2
recursive-include agent_evaluator *.json
recursive-include agent_evaluator *.yaml
recursive-include agent_evaluator *.yml
recursive-include agent_evaluator *.css
recursive-include agent_evaluator *.js

# Exclude dev/test/build artifacts
exclude .gitignore
exclude .env
exclude .env.local
exclude *.zip

prune .git
prune __pycache__
prune *.egg-info
prune .pytest_cache
prune .mypy_cache
prune .deepeval
prune .ruff_cache
prune Docs
prune Evaluator_Examples
prune results
prune golden_datasets
prune dist
prune build
